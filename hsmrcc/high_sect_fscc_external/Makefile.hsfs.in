#
#
#

# relative position of files
srcdir_hsfs=hsmrcc/high_sect_fscc_external


## default executables to be compiled (more to be added)...
hsfs: hsfs_csd hsfs_csu hsfs_csv

#

touch_all:
	@echo "toching source files with main program"
	touch main/main.F90  $(srcdir_hsfs)/csd.F $(srcdir_hsfs)/csu.F $(srcdir_hsfs)/csv.F

main_as_subr:
	$(F90) -DFORTRAN_MAIN_AS_SUBROUTINE $(F90FLAGS) -c -o main/main.o  main/main.F90
	

hsfs_csd : $(srcdir_hsfs)/bin/csd.x
$(srcdir_hsfs)/bin/csd.x : $(OBJ)
	make touch_all
	make main_as_subr
	$(F77) -DSTANDALONE_HSFS  $(F77FLAGS) -c -o $(srcdir_hsfs)/csd.o  $(srcdir_hsfs)/csd.F
	$(LD)  -o $@ $(OBJ) $(LIBS) 
	rm $(srcdir_hsfs)/csd.o
	make touch_all
	@echo -e "\n Independent executable "$(srcdir_hsfs)/bin/csd.x" is ready." 

hsfs_csu : $(srcdir_hsfs)/bin/csu.x
$(srcdir_hsfs)/bin/csu.x : $(OBJ)
	make touch_all
	make main_as_subr
	$(F77) -DSTANDALONE_HSFS  $(F77FLAGS) -c -o $(srcdir_hsfs)/csu.o  $(srcdir_hsfs)/csu.F
	$(LD)  -o $@ $(OBJ) $(LIBS) 
	rm $(srcdir_hsfs)/csu.o
	make touch_all
	@echo -e "\n Independent executable "$(srcdir_hsfs)/bin/csu.x" is ready." 

