$(srcdir_hsfs)/bin/csv.x : $(OBJ)
	make touch_all
	make main_as_subr
	$(F77) -DSTANDALONE_HSFS  $(F77FLAGS) -c -o $(srcdir_hsfs)/csv.o  $(srcdir_hsfs)/csv.F
