#
#
#

# relative position of files
srcdir_hsfs=hsmrcc/high_sect_fscc_external

hsfs_csd=$(srcdir_hsfs)/bin/csd.x
hsfs_csu=$(srcdir_hsfs)/bin/csu.x
#hsfs_chu=$(srcdir_hsfs)/bin/chu.x

all_hsfs_execs=$(hsfs_csd) $(hsfs_csu) $(hsfs_chu)
hsfs_execs=$(all_hsfs_execs)

## default - all executables ...
hsfs: $(hsfs_execs) $(OBJS)

hsfs_csd : $(hsfs_csd)
hsfs_csu : $(hsfs_csu)
#hsfs_chu : $(hsfs_chu)

HSFS_LIBS=pdpack/gpblas.o pdpack/gp_dlapack.o pdpack/dsp.o pdpack/eispack.o pdpack/dge.o \
          pdpack/dlamch.o pdpack/gp_auxlapack.o

#
# need for AMD64 when static data exceed 2GB, ccsd.o is among DIRAC objects/dependencies
#

$(srcdir_hsfs)/ccsd.o : $(srcdir_hsfs)/ccsd.F
	$(F77) $(MCMODEL_MEDIUM) $(F77FLAGS) -c -o $(srcdir_hsfs)/ccsd.o  $(srcdir_hsfs)/ccsd.F
	@echo "ccsd.F compiled..."

### standalone codes can ne be linked against all object files due to memory model...

$(hsfs_csd) : $(srcdir_hsfs)/csd.o $(OBJ)
	$(F77) -DSTANDALONE_HSFS $(F77FLAGS) -c -o $(srcdir_hsfs)/csd.o  $(srcdir_hsfs)/csd.F
	$(LD) -o $@  $(srcdir_hsfs)/csd.o $(srcdir_hsfs)/ccsd.o $(LIBS) $(HSFS_LIBS)
	@echo -e "csd.x ready" 
#	touch $(srcdir_hsfs)/csd.F


$(hsfs_csu) : $(srcdir_hsfs)/csu.o 
	$(F77) -DSTANDALONE_HSFS $(F77FLAGS) -c -o $(srcdir_hsfs)/csu.o $(srcdir_hsfs)/csu.F
	$(LD) -o $@ $(srcdir_hsfs)/csu.o $(srcdir_hsfs)/ccsd.o $(LIBS)  $(HSFS_LIBS)
	@echo -e "csu.x ready" 
#	touch $(srcdir_hsfs)/csu.F


# cleaning #
hsfs_clean :
	@rm -f $(srcdir_hsfs)/*.o
	@rm -f $(srcdir_hsfs)/bin/*.x
	@echo "cleaning of hsfs directory done"

