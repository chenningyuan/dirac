#
#
#

# relative position of files
srcdir_hsfs=hsmrcc/high_sect_fscc_external


## default executables to be compiled (more to be added)...
hsfs: hsfs_csd hsfs_csv hsfs_csu hsfs_csw hsfs_csx hsfs_csy hsfs_csz \
               hsfs_chv hsfs_chu hsfs_chw hsfs_chx hsfs_chy hsfs_chz

touch_all:
	@echo "touching source files with main program"
	@touch main/main.F90    $(srcdir_hsfs)/csd.F $(srcdir_hsfs)/csu.F $(srcdir_hsfs)/csv.F \
                                $(srcdir_hsfs)/csw.F $(srcdir_hsfs)/csx.F $(srcdir_hsfs)/csy.F \
           $(srcdir_hsfs)/csz.F $(srcdir_hsfs)/chv.F $(srcdir_hsfs)/chu.F $(srcdir_hsfs)/chw.F \
           $(srcdir_hsfs)/chx.F $(srcdir_hsfs)/chy.F $(srcdir_hsfs)/chz.F  

### compile main program as SUBROUTINE
main_as_subr:
	$(F90) -DFORTRAN_MAIN_AS_SUBROUTINE $(F90FLAGS) -c -o main/main.o  main/main.F90

hsfsOBJ:  $(srcdir_hsfs)/csd.o $(srcdir_hsfs)/csu.o $(srcdir_hsfs)/csv.o \
                               $(srcdir_hsfs)/csw.o $(srcdir_hsfs)/csx.o $(srcdir_hsfs)/csy.o \
          $(srcdir_hsfs)/csz.o $(srcdir_hsfs)/chv.o $(srcdir_hsfs)/chu.o $(srcdir_hsfs)/chw.o \
          $(srcdir_hsfs)/chx.o $(srcdir_hsfs)/chy.o $(srcdir_hsfs)/chz.o

	
# basic CCSD, (0,0) sector
hsfs_csd : $(srcdir_hsfs)/bin/csd.x 
$(srcdir_hsfs)/bin/csd.x : $(OBJ)
	make main_as_subr
	make touch_all
	$(F77) -DSTANDALONE_HSFS  $(F77FLAGS) -c -o $(srcdir_hsfs)/csd.o  $(srcdir_hsfs)/csd.F
	make hsfsOBJ
	$(LD) $(LDFLAGS)  -o $@ $(OBJ) $(LIBS) 
#	touch $(srcdir_hsfs)/csd.F
#	rm $(srcdir_hsfs)/csd.o
#	make touch_all
	@echo -e "\n Independent executable "$(srcdir_hsfs)/bin/csd.x" is ready.\n" 

