############
# cleaning #
############
hsfs_clean :
	@rm -f $(srcdir_hsfs)/*.o 
	@rm -f $(srcdir_hsfs)/bin/*.x
	@echo "Cleaning of the " $(srcdir_hsfs) "  directory done"

