##  dwell on 
include ../../Makefile.config

default: secquant

F77_OBJS =

C_OBJS   = 

F90_OBJS = indxquant_mod.o kron_delta.o operstr_mod.o sq_oper.o test.o

F90_MODS = indexed_quantities.mod kroneckerdelta.mod secquantoperator.mod operators_string.mod 

F_CPPS = $(F77_OBJS:.o=.i)

pre:     $(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:  $(F90_MODS) $(F77_OBJS) $(F90_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod
	$(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

##
##  compile Fortran90 module source files and make symbolic links
## of resulting *.mod files into common linked directory modules
##
mod : $(F90_MODS) ;\
$(foreach module_file, $(F90_MODS), ln -sf $(PWD)/$(module_file)  modules/. ;)
##ln -sf $(PWD)/*.mod ../modules/. 

FLAGS=$(DEPEND_FLAGS) $(MODS) $(OPTFLAGS)

#### object files from DIRAC ####
dirac_objs :=  ../../gp/qpack.o ../../gp/gptrygve.o  ../../gp/gphjj.o

## dummy entry to handle the "default:" in Makefile.config:
dirac.x dirmpi.x:

secquant:  $(F90_OBJS) $(F90_MODS)
	$(F77) $(LDFLAGS) -o SecQuant.x $(F90_OBJS) $(dirac_objs)

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90)

f90dep: ;\
       ../../utils/sfmakedepend.pl -I include $(F90_OBJS:.o=.F90) $(F77_OBJS:.o=.F)
 
# DO NOT DELETE
