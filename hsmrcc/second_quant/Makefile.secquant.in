#
#
#   This file is included from the main makefile, and
#  make has to be run from the top level directory.
#
#

##################################################################
#
#        Executable name with its relative position
#
# otherwise you would have to specify paths with $(INSTALL_DIR)
#
##################################################################

sq_dir=hsmrcc/second_quant
sq_exec=$(sq_dir)/SecQuant.x

#main_as_subr:
#	$(F90) -DFORTRAN_MAIN_AS_SUBROUTINE $(F90FLAGS) -c -o main/main.o  main/main.F90

sq: $(sq_exec) 
	@echo -e "\nIndependent executable file "$(INSTALL_DIR)/$(sq_exec)" is ready."

$(sq_exec) : $(OBJ)
	make main_as_subr
	$(F90) $(LDFLAGS) -DSTANDALONE_SECQUANT $(F90FLAGS) -c -o $(sq_dir)/test.o $(sq_dir)/test.F90
	@echo -e "\nGoing to link Dirac-compiled objects (sec.quantiz. sources, modules): " 
	$(LD) $(LDFLAGS) -o $@ $(OBJ) $(LIBS)
	rm $(sq_dir)/test.o
	touch main/main.F90 $(sq_dir)/test.F90

sq_clean:
	@rm -f $(sq_dir)/*.o  $(sq_dir)/*.x
	@echo -e "Cleaning of " $(sq_dir) " directory done."
