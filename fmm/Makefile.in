include ../Makefile.config

F77_OBJS = fmmdrv.o \
           mm_io_int.o \
           mm_standalone_aux.o

F90_OBJS = mm_box_builder.o \
           mm_global_paras.o \
           mm_memory_manager.o \
           mm_T_contractors.o \
           mm_Vff_driver.o \
           mm_box_processor.o \
           mm_grid_searcher.o \
           mm_overlap_tree.o \
           mm_T_pair_builder.o \
           mm_Vff_processor.o \
           mm_buffers.o \
           mm_input.o \
           mm_sort.o \
           mm_T_pair_tests.o \
           mm_W_contractors.o \
           mm_densfit.o \
           mm_interface.o \
           mm_standalone_drv.o \
           mm_tree_T_buffer.o \
           mm_W_pair_builder.o \
           mm_driver.o \
           mm_map_builder.o \
           mm_stats.o \
           mm_T_worker.o \
           mm_W_worker.o

F90_MODS =

C_OBJS = mm_proc_selector.o

F77_CPPS = $(F77_OBJS:.o=.i)

pre:       $(F77_CPPS)

ftnchek:   pre
	   ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:       $(F90_MODS) $(F90_OBJS) $(F77_OBJS) $(C_OBJS)

clean:
	   $(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod  ;\
	   $(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

mod:       $(F90_MODS)

dirac.x:
	   cd .. ; $(MAKE) dirac.x

dirmpi.x:
	   cd .. ; $(MAKE) dirmpi.x

include ../Makefile.depend

