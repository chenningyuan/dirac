include ../Makefile.config

F_OBJS = cidirr.o cigenp.o cigosc.o

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

all:	$(F_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i


depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F_OBJS:.o=.F) 
# DO NOT DELETE THIS LINE -- make depend depends on it.

