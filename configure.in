#
# VERSION : $Revision$
# DATE    : $Date$
# FILE    : configure.in
# SOURCE  : $Source$
#
#
# Shell script for configuring Makefile.config needed to build
# the DIRAC relativistic molecular code.
# The shell script is a modified version of the script used for DALTON
#
# It tries to determine what platform we are on (although allowing builds
# for other platforms, as needed for crosscompiling), as well as detect any
# interesting mathematical libraries on the present computer.
#
#
# Known problems: The parallelization installation is rudimentary
#                 The checks for compilers and libraries hopefully works
#
# Written by K.Ruud, Dec-1 1996
# Revised 970401 hjaaj
# Linux support added 970414 by Konrad Hinsen.
# HP revisions 970505-ekd/Konrad Hinsen. Combined by kr 080597
# Adapted for DIRAC 970910 - tsaue
# Polish by Thomas Enevoldsen Oct 2 1997
# Guess machine automatic by Joern Thyssen Nov 11 1997
# Remember last config by Joern Thyssen - Jan 28 1998
#

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Does 'echo' understand escapes?
#
#
if [ "	" = "`echo '\t'`" ]; then
   echo="echo"
else
   echo="echo -e"
fi
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# CHECK OPTIONS
#
#
quick=0
usage='Usage: '$0'\n'\
'--help\n'\
'\tPrint this\n'\
'--quick\n'\
'\tDo not prompt user\n'\
'--version\n'\
'\tPrint version of configure\n'\
'--system=SYSTEM-ID\n'\
'\tSet system to SYSTEM-id\n'\
'--parallel[=(yes|no)]\n'\
'\tParallel version of Dirac\n'\
'--parallel-message=(mpi|pvm)\n'\
'\tParallel message passing\n'\
'--mathematical-libraries=MATH-LIB\n'\
'\tChoose the math. lib. MATH-LIB\n'\
'--memory-size=MEM-SIZE\n'\
'\tSet memory size to MEM-SIZE words\n'\
'--install-directory=INST-DIR\n'\
'\tSet install directory to INST-DIR\n'\
'--scratch-directory=SCR-DIR\n'\
'\tSet work directory to SCR-DIR\n'\
'--f77=F77\n'\
'\tSet fortran compiler to F77\n'

while [ $# != 0 ]; do
   arg="$1"; shift
   case "${arg}" in
      -*=*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\([^=]*\)=.*$:\1:'`
         val=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*[^=]*=\(.*\)$:\1:'`
         valomitted=no
         ;;
      -*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\(.*\)$:\1:'`
         val="yes"
         valomitted=yes
         ;;
      *)
         $echo $usage
         exit 
   esac
   optname="${opt}"
   opt="`echo '' ${opt} | sed -e 's:^ ::' | tr - _`"
   case "${opt}" in
      "help")
         $echo $usage
         exit
         ;;
      "quick")
         quick=1
         ;;
      "version")
         echo $0
         echo '$Revision$'
         echo '$Date$'
         exit 
         ;;
      "system")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         guess="$val"
         ;;
      "parallel" | "par")
         case "$val" in
         "no" | "yes" )
            par="$val"
            ;;
         *)
            echo 'Syntax error: Value "'${val}'" is not allowed to option' \
                 '"-'${optname}'"'
            echo 'Legal values: [yes,no]'
            exit 1
            ;;
         esac
         ;;
      "parallel_message" | "par_mesg")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         mesp="$val"
         ;;
      "mathematical_libraries" | "math_lib" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         LIB="$val"
         ;;
      "memory_size" | "memory" | "mem" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         memdef="$val"
         ;;
      "install_dir" | "inst_dir" | "install" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         INSTALL_DIR="$val"
         ;;
      "scratch_directory" | "scr_dir" | "scratch_dir" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         worksp="$val"
         ;;
      "f77" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         F77="$val"
         ;;
      *)
         echo  'Unknown option: '$opt''
         $echo $usage
         exit 1
         ;;
   esac
done
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# GUESS SYSTEM
#
#
echo
echo '   Configuring the DIRAC Makefile.config and dhf run script'
echo
echo '   configure $Revision$'
#
#
#
dirlist='/lib /usr/lib /usr/local/lib'
#
# GUESS SYSTEM
#
echo
echo 'SYSTEM'
echo
if [ -z "${guess}" ]; then
   guess=`./config.guess`
   if [ "$guess" = "" ]; then
      guess=`./config.status ARCH`
   fi
   if [ $quick = 0 ]; then
      $echo "System [$guess]: \c"
      read answer
   else
      answer=
   fi

   if [ "$answer" != "" ]; then
      guess=$answer
   fi
fi

guess=`./config.sub $guess 2>/dev/null` 

$echo "Configuring $guess..."
machine=`echo $guess | sed 's/-[^-]*$//'`
if [ "$machine" != "$guess" ]; then 
   os=`echo $guess | sed 's/.*-//'`
else 
   os=
fi

$echo "Machine\t\t\t: $machine"
$echo "Operating system\t: $os"

case $machine in

   rs6000-ibm)
      liblist='libesslp2 libessl libblas'
      complist='xlf f77 f90';;

   mips*-sgi) 
# libcomplib.sgimath.so removed since it is slow /tec
      liblist='libblas'
      complist='f77 f90';;

   i[3-6]86-*)
      liblist='libblas'
      complist='g77';;

   sparc-sun|m68k-sun)  
      liblist='libblas'
      complist='f77 f90';;

   c*-convex)
      liblist='libveclib libblas'
      complist='fc f77 f90';;

   *-hp)
      liblist='libblas'
      complist='f77 fort77 f90';;

   i860-intel-osf1)
      liblist='libmath libblas'
      complist='if77 if90 f77 f90';;

   alpha-dec|mips-dec|vax-dec)
      liblist='libdxml libblas'
      complist='f77 f90';;

   *-cray)
      liblist=''
      complist='cf77 f77 cf90 f90';;

   t3e-cray)
      liblist=''
      complist='f90 cf90 cf77 f77';;

   *)
      echo "System $guess is currently .NOT. supported"
      echo "Please report the following to jth@chem.ou.dk:"
      $echo "\t\`uname -m\` , \`uname -r\` , \`uname -s\` and \`uname -v\` "
      $echo "\tYou may also recommend compilerflags," 
      $echo "\tpreferred fortran compiler and mathematical libraries" \
            "available."
      exit 1

esac
echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# PARALLEL
#
#
if [ -z "$PARFLG" ]; then
   PARFLG=0
fi
if [ $PARFLG = 0 ]; then
   par="no"
fi
echo
echo 'PARALLEL'
echo
if [ -z "${par}" ]; then
   ok=
   while [ -z "$ok" ]; do
      ok=1
      if [ $quick = 0 ]; then
	 $echo 'Do you want to install the program'\
	       'in a parallel version? y/[n] \c'
	 read par
      else
	 par=no
      fi
      case "$par" in
      "yes" | "y" )
         par="yes"
         ;;
      "no" | "n" | "" )
         par="no"
         ;;
      *)
         ok=
         ;;
      esac
   done
fi
echo 'Parallel version: '${par}''

if [ "$par" = "yes" ]; then
#
#  Parallel architectures are difficult, better warn the user
#
   echo 
   echo  "Makefiles for parallel architecture are defficult to guess"
   $echo "Please always compare the generated Makefile.config with" \
         "local documentation.\n"

#
#  Determine message passing protocol to be used
#
   if [ -z "${mesp}" ]; then
      ok=
      while [ -z "$ok" ]; do
         ok=1
	 if [ $quick = 0 ]; then
	    $echo 'Message passing [mpi]/pvm: \c'
	    read mesp
	 else
	    mesp=mpi
	 fi
         case "$mesp" in
         "mpi" | "pvm" )
            ;;
         "" )
            mesp="mpi"
            ;;
         *)
            ok=
            ;;
         esac
      done
   fi
   echo 'Parallel message passing: '$mesp
#
#  Abort if PVM
#
   if [ "$mesp" = "pvm" ]; then
      echo "I don't think PVM is working..."
      echo "configure aborted..."
      exit 1
   fi
#
#  The only computer I can think of with a separate compiler for parallel
#  MPI code is IBMs xlf
#
   if [ "$mesp" = "mpi" -a "$machine" = "rs6000-ibm" ]; then
      complist='mpxlf'
      parlib='no'
   elif [ "$mesp" = "mpi" -a "$machine" = "t3e-cray" ]; then
      parlib='no'
   else
      parlib='yes'
   fi

   pardir=dirlist
   incdir='/usr/include /usr/local/include /local/include'
#
#  Modify for SGI that may have both 32 and 64 bit architectures
#
   if [ "$machine" = "mips64-sgi" ]; then
      pardir="$dirlist /usr/lib64"
   elif [ "$machine" = "mips-sgi" ]; then
      pardir="$dirlist /usr/lib32"
   fi
   parinc=
   parlibp=
#
#  MPI settings, first we do the mpi-library
#
   if [ "$parlib" = "yes" -a "$mesp" = "mpi" ]; then
      parlib=
      tmplib='libmpi.a libmpi.so'
      for testdir in $pardir; do
         for testlib in $tmplib; do
            if test -f $testdir/$testlib; then
               parlib='-lmpi'
               parlibp=$testdir
               break
            fi
         done
         test -n "$parlib" && break
      done
      if [ -z "$parlib" ]; then
         echo 'Parallel library: none'
      else
         echo 'Parallel library: '$parlib
      fi
#
#     Now we try to find an include directory
#
      incfile='mpif.h'
      for testdir in $incdir; do
         if test -f $testdir/$incfile; then
            parinc=-I$testdir
            break
         fi
      done
      if [ "$parinc" = "-I" ]; then
         parinc=
      fi
      if [ -z "$parinc" ]; then
         echo 'Parallel include: none'
      else
         echo 'Parallel include:'$parinc
      fi
#
#     PVM settings, we need two PVM library files
#
      elif [ $parlib = 'yes' -a $mesp = 'pvm' ]; then
         parlib=
         tmplib='libpvm3.a libfpvm3.a'
         for testdir in $pardir; do
            for testlib in $tmplib; do
               if test -f $testdir/$parlib; then
                  if [ $parlib = 'libpvm3.a']; then
                     parlib="$parlib -lpvm3"
                  else
                     parlib="$parlib -lfpvm3"
                  fi
                fi
             done
          done
       fi
       if [ "$parlib" = "no" ]; then
            parlib=
       fi
else
   mesp='dummy'
fi
echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Test for the existence of the compiler
#
#
echo
echo 'COMPILER'
echo
$echo "\nChecking for compiler ...\c"
if [ ! -z "$F77" ]; then
   complist=$F77
   F77=
fi

#if [ "$mesp" = "mpi" -a "$machine" = "rs6000-ibm" ]; then
#    set dummy $comp; ac_word=$2
#    $echo " $comp\c"
#    IFS="${IFS=   }"; ac_save_ifs="$IFS"; IFS="${IFS}:"
#    for ac_dir in $PATH; do
#        test -z "$ac_dir" && ac_dir=.
#        if test -f $ac_dir/$ac_word; then
#            ac_cv_prog_F77=$ac_word
#            break
#        fi
#    done
#    IFS="$ac_save_ifs"
#    test -z "$ac_cv_prog_F77" && ac_cv_prog_F77=""
#    F77="$ac_cv_prog_F77"
#    if test -n "$F77"; then
#        echo
#        $echo "Fortran compiler: $F77"
#        break
#    fi
#fi
if test -z "$F77"; then
for comp in $complist; do
    set dummy $comp; ac_word=$2
    $echo " $comp\c"
    IFS="${IFS=   }"; ac_save_ifs="$IFS"; IFS="${IFS}:"
    for ac_dir in $PATH; do
        test -z "$ac_dir" && ac_dir=.
        if test -f $ac_dir/$ac_word; then
            ac_cv_prog_F77=$ac_word
            break
        fi
    done
    IFS="$ac_save_ifs"
    test -z "$ac_cv_prog_F77" && ac_cv_prog_F77=""
    F77="$ac_cv_prog_F77"
    if test -n "$F77"; then
        echo
        $echo "Fortran compiler: $F77"
        break
    fi
done
fi
if test -z "$F77"; then
    $echo "\n   No compiler found on this computer"
    echo  "   Cannot proceed without a Fortran compiler in path"
    exit
fi
echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Mathematical libraries
#
#
# Check out mathematical libraries. May have to expand library list?
#
# For rs6000 we first try ESSL, then BLAS
#
echo
echo 'MATHEMATICAL LIBRARIES'
echo

#
#  Modify for SGI that may have both 32 and 64 bit architectures
#
if [ "$machine" = "mips64-sgi" ]; then
   dirlist="/usr/lib64 $dirlist"
elif [ "$machine" = "mips-sgi" ]; then
   dirlist="/usr/lib32 $dirlist"
fi

nolib () 
{
   echo  $LIB' is not a legal library.'
   rm -f gnyf.F gnyf.x gnyf.o 
   exit 1;
}
if [ ! -z "$LIB" ]; then
   rm -f gnyf.F
   echo '      PROGRAM GNYF' >  gnyf.F
   echo '      END         ' >> gnyf.F
   $F77 gnyf.F -o gnyf.x -l$LIB 2> /dev/null || nolib
   rm -f gnyf.F gnyf.x gnyf.o
   if [ ! -z "$LIB" ]; then
      LIB="-l$LIB"
   fi
fi
extlist='.so .a'
for testdir in $dirlist; do
  if [ -n "$liblist" ]; then
    for testlib in $liblist; do
       for ext in $extlist; do
         if test -f $testdir/$testlib$ext; then
            echo "Library found  $testdir/$testlib$ext"
            case $testlib in
               libesslp2) LIB="$LIB -lesslp2";;
               libessl) LIB="$LIB -lessl";;
               libblas) LIB="$LIB -lblas";;
               libdxml) LIB="$LIB -ldxml";;
               libcomplib.sgimath) LIB="$LIB -lcomplib.sgimath";;
               libveclib) LIB="$LIB -lveclib";;
               libmath) LIB="$LIB -lmath -lm -nx";;
            esac
            break
         fi
      done
    done
    test -n "$LIB" && break
  fi
done

if [ -z "$LIB" -a -n "$liblist" ]; then
    echo 'Mathematical libraries: none'
elif [ -n "$LIB" ]; then
    echo 'Mathematical libraries: '$LIB
fi
echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# DETERMINE MEMORY SIZE
#
echo
echo 'MEMORY SIZE'
echo
if [ -z "$memdef" ]; then
   memdef=`./config.status WRKMEM`
   if [ -z "$memdef" ]; then
      memdef=10000000
   fi
   echo 'DIRAC uses approximately 800000 words of static allocations'
   echo 'How many words to use as default for scratch memory ?'
   echo '(we do not recommend going below 1000000 words)'
   $echo 'Note that scratch memory can be changed' \
         'through the shell variable WRKMEM\n'
   if [ $quick = 0 ]; then
      $echo 'Memory size ['$memdef'] \c'
      read memsiz
   else
      memsiz=
   fi
   if [ -z "$memsiz" ]; then
      memsiz=$memdef
   fi
else
   memsiz=$memdef
fi
$echo 'Default memory size: '$memsiz
echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# Determine location for executable and run script
#
echo 
echo 'INSTALL DIRECTORY'
echo
if [ -z "$INSTALL_DIR" ]; then
   INSTALL_DIR=
   while [ -z "$INSTALL_DIR" ]
   do
      curr=`./config.status INSTALLDIR`
      if [ -z "$curr" ]; then
         curr=`pwd`
      fi
      if [ ! -d "$curr" ]; then
         curr=`pwd`
      fi
      if [ $quick = 0 ]; then
	 $echo 'Directory for installation of' \
	       'binaries and scripts ['$curr'] \c'
	 read INSTALL_DIR
      else
	 INSTALL_DIR=
      fi
      if [ -z "$INSTALL_DIR" ]; then
         INSTALL_DIR=$curr
      fi
      if [ ! -d "$INSTALL_DIR" ]; then
         echo "ERROR: $INSTALL_DIR does not exist"
         INSTALL_DIR=
      fi
   done
else
   if [ ! -d "$INSTALL_DIR" ]; then
      echo "ERROR: $INSTALL_DIR does not exist"
      exit 1
   fi
fi
$echo 'Install directory for executable and script: '$INSTALL_DIR
echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Determine default scratch disk space for calculations
#
#
echo 
echo 'SCRATCH DIRECTORY'
echo
if [ -z "$worksp" ]; then
   worksp=
   while [ -z "$worksp" ]
   do
      if [ -d '/work' ]; then
         worksp='/work'
      elif [ -d '/scratch' ]; then
         worksp='/scratch'
      elif [ -d '/scr' ]; then
         worksp='/scr'
      elif [ -d '/temp' ]; then
         worksp='/temp'
      elif [ -d '/tmp' ]; then
         worksp='/tmp'
      else
         worksp=
      fi
      if [ $guess = 0 ]; then
         $echo 'Default scratch space in script ['$worksp'] \c'
         read answer
      else
         answer=
      fi
      if [ ! -z "$answer" ]; then
         worksp=$answer
      fi
      if [ ! -d $worksp ]; then
         echo 'Scratch directory '$worksp' does not exist!'
         worksp=
      fi
   done
else
   if [ ! -d $worksp ]; then
      echo 'Scratch directory '$worksp' does not exist!'
      exit 1
   fi
fi
echo 'Scratch directory: '$worksp'/$USER$'
echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# We are beginning to see the end of the installation requirements
#
# We will now dump machine specific things to Makefile.config
#
echo
echo 'MAKING MAKEFILE.CONFIG'
echo
if [ -f Makefile.config ]; then
   echo 'Makefile.config exists. I will take a backup as Makefile.config.orig'
   if [ -f Makefile.config.orig -a ! -w Makefile.config.orig ]; then
      echo 'Makefile.config.orig is write-protetcted.'
      answer=
      while [ "$answer" != "y" -a "$answer" != "n" ]
      do
	 if [ $quick = 0 ]; then
	    $echo 'Do you want me to overwrite' \
		  'Makefile.config.orig anyway? [y]/n \c'
	    read answer
	 else
	    answer=
	 fi
         if [ -z "$answer" ]; then
            answer="y"
         fi
      done
      if [ "$answer" = "n" ];  then
         echo 'I do not take a backup of Makefile.config.' \
              'This file will be overwritten'
      else
         exec `chmod u+w Makefile.config.orig`
         exec `mv Makefile.config Makefile.config.orig`
         exec `chmod u-w Makefile.config.orig`
      fi
   else
      exec `mv Makefile.config Makefile.config.orig`
      exec `chmod u-w Makefile.config.orig`
   fi
fi
#
# Parallel preprocessor directive need to be set
#

if [ "$mesp" = "mpi" ]; then
    parop='VAR_MPI'
elif [ "$mesp" = "pvm" ]; then
    parop='VAR_PVM'
else
    parop=
fi

opsys=
if [ "$machine" = "rs6000-ibm" ]; then
   opsys=`uname -v`
   echo 'The version of the AIX operating system found is '$opsys'\n'
   echo '\n NOTE: There appears to be a bug in the newest compiler of IBM'
   echo '       If the code does not perform correctly on your system'
   echo '       either reinstall an older compiler or turn off all optimization'
fi


INCLUDE_DIR=include
case $machine in
#
#  HEWLETT - PACKARD
#
    *-hp) 
       echo "hp"
       if [ "$mesp" = "dummy" ]; then
          cpp="-DPRG_DIRAC -DSYS_HPUX -D'INSTALL_WRKMEM=\${WRKMEM}' "
          ccp="-DSYS_HPUX"
          for mod in $MODS; do
             cpp=`echo $cpp $mod`
          done
          def='dirac.x'
       else
          cpp="-DPRG_DIRAC -DSYS_HPUX -D'INSTALL_WRKMEM=\${WRKMEM}' -D$parop"
          ccp="-DSYS_HPUX"
          for mod in $MODS; do
             cpp=`echo $cpp $mod`
          done
          if [ "$mesp" = "mpi" ]; then
             def='dirmpi.x'
          else
             def='dirpvm.x'
          fi
       fi
       opt='+O3 +U77 +E4 +E5'
       inc="-I$INCLUDE_DIR"
       LIB="-lV7 $LIB";;
#
#   PARAGON
#
    860-intel-osf1) 
       if [ "$mesp" = "dummy" ]; then
          cpp="-DPRG_DIRAC -DSYS_PARAGON -D'INSTALL_WRKMEM=\${WRKMEM}' "
          ccp="-DSYS_PARAGON"
          for mod in $MODS; do
            cpp=`echo $cpp $mod`
          done
          def='dirmpi.x'
       else
          cpp="-DPRG_DIRAC -DSYS_PARAGON -D'INSTALL_WRKMEM=\${WRKMEM}' -D$parop"
          ccp="-DSYS_PARAGON"
          for mod in $MODS; do
             cpp=`echo $cpp $mod`
          done
          if [ "$mesp" = "mpi" ]; then
             def='dirmpi.x'
          else
             def='dirpvm.x'
          fi
       fi
       opt='-O3 -Mvect'
       inc="-I$INCLUDE_DIR";;
#
#   ALPHA
#
    alpha-dec|mips-dec|vax-dec)
       if [ "$mesp" = "dummy" ]; then
          cpp="-DPRG_DIRAC -DSYS_DEC -D'INSTALL_WRKMEM=\${WRKMEM}' "
          ccp="-DSYS_DEC"
          for mod in $MODS; do
            cpp=`echo $cpp $mod`
          done
          def='dirac.x'
       else
          cpp="-DPRG_DIRAC -DSYS_DEC -D'INSTALL_WRKMEM=\${WRKMEM}' -D$parop"
          ccp="-DSYS_DEC"
          for mod in $MODS; do
             cpp=`echo $cpp $mod`
          done
          if [ "$mesp" = "mpi" ]; then
             def='dirmpi.x'
          else
             def='dirpvm.x'
          fi
          parlib="$parlib -lfmpi -lrt -pthread"
       fi
       opt='-O5 -fast'
       inc="-I$INCLUDE_DIR";;
#
#   CRAY T3E
#
    t3e-cray) 
       if [ "$mesp" = "dummy" ]; then
          cpp="-DPRG_DIRAC -DSYS_T3D -DVAR_NONAMELIST"
          ccp="-DSYS_T3D"
       else
          cpp="-DPRG_DIRAC -DSYS_T3D -DVAR_NONAMELIST -D$parop"
          ccp="-DSYS_T3D"
       fi
       for mod in $MODS; do
          cpp=`echo $cpp $mod`
       done
#       opt="-Oaggress,scalar3"
       opt="-dp -F -O3,unroll2,msgs,negmsgs -R nb -Wl,-Dstreams=on"
       inc="-I$INCLUDE_DIR"
       def='dirac.x';;
       LIB="crilib.cld $LIB"
#
#   CRAY
#
    *-cray)
      if [ "$mesp" = "dummy" ]; then
         cpp="-DPRG_DIRAC -DSYS_CRAY, -D'INSTALL_WRKMEM=\${WRKMEM}' "
         ccp="-DSYS_CRAY"
      else
         cpp="-DPRG_DIRAC -DSYS_CRAY,-D'INSTALL_WRKMEM=\${WRKMEM}' ,$parop"
         ccp="-DSYS_CRAY"
      fi
      for mod in $MODS; do
         cpp=`echo $cpp,$mod`
      done
      opt="-Wf\"-i 64 -a stack -dp\" -Wl\"-i ./equivalences\" -Wp\"-F\""
      inc="-I$INCLUDE_DIR"
      def='dirac.x';;
      LIB="crilib.cld $LIB"
#
#  CONVEX
#
   c*-convex)
      if [ "$mesp" = "dummy" ]; then
         cpp="-P -DPRG_DIRAC -DSYS_CONVEX -D'INSTALL_WRKMEM=\${WRKMEM}' "
         ccp="-DSYS_CONVEX"
         for mod in $MODS; do
            cpp=`echo $cpp $mod`
         done
         def='dirac.x'
      else
         cpp="-P -DPRG_DIRAC -DSYS_CONVEX -D'INSTALL_WRKMEM=\${WRKMEM}' -D$parop"
         ccp="-DSYS_CONVEX"
         for mod in $MODS; do
            cpp=`echo $cpp $mod`
         done
         def='dirmpi.x'
      fi
      opt="-O2 -link \"-W\""
      inc="-I$INCLUDE_DIR";;
#
#  SUN
#
   sparc-sun|m68k-sun)  
      if [ "$mesp" = "dummy" ]; then
         cpp="-DPRG_DIRAC -DSYS_SUN -DVAR_MFDS -D'INSTALL_WRKMEM=\${WRKMEM}'"
         ccp="-DSYS_SUN"
         for mod in $MODS; do
            cpp=`echo $cpp $mod`
         done
         def='dirac.x'
      else
         cpp="-DPRG_DIRAC -DSYS_SUN -DVAR_MFDS -D'INSTALL_WRKMEM=\${WRKMEM}' -D$parop"
         ccp="-DSYS_SUN"
         for mod in $MODS; do
            cpp=`echo $cpp $mod`
         done
         if [ "$mesp" = "mpi" ]; then
            def='dirmpi.x'
         else
            def='dirpvm.x'
         fi
      fi
      opt='-O2 -Nc50'
      inc="-I$INCLUDE_DIR" ;;
#
#   RS6000
#
   rs6000-ibm) 
      case $os in
         aix2*) 
            if [ "$mesp" = "dummy" ]; then
               cpp="-w -P -DPRG_DIRAC -DSYS_AIX -DSYS_AIX23 -D'INSTALL_WRKMEM=\${WRKMEM}' "
               ccp="-DSYS_AIX -DSYS_AIX23"
               for mod in $MODS; do
                  cpp=`echo $cpp $mod`
               done
               def='dirac.x'
            else
               cpp="-w -P -DPRG_DIRAC -DSYS_AIX -DSYS_AIX23 -D'INSTALL_WRKMEM=\${WRKMEM}' -D$parop"
               ccp="-DSYS_AIX -DSYS_AIX23"
               for mod in $MODS; do
                  cpp=`echo $cpp $mod`
               done
               if [ "$mesp" = "mpi" ]; then
                  def='dirmpi.x'
               else
                  def='dirpvm.x'
               fi
            fi
            inc="-I$INCLUDE_DIR";;
         *)
            if [ "$mesp" = "dummy" ]; then
               cpp="-WF,-DPRG_DIRAC,-DSYS_AIX,-DVAR_MFDS,-D'INSTALL_WRKMEM=\${WRKMEM}'"
               ccp="-DSYS_AIX"
               for mod in $MODS; do
                  cpp=`echo $cpp,$mod`
               done
               def='dirac.x'
            else
               cpp="-WF,-DPRG_DIRAC,-DSYS_AIX,-DVAR_MFDS,-D'INSTALL_WRKMEM=\${WRKMEM}',-D$parop"
               ccp="-DSYS_AIX"
               for mod in $MODS; do
                  cpp=`echo $cpp,$mod`
               done
               if [ "$mesp" = "mpi" ]; then
                  def='dirmpi.x'
               else
                  def='dirpvm.x'
               fi
            fi
            inc="-WF,-I$INCLUDE_DIR";;
         esac
         opt='-O3 -qstrict';;
#
#  IRIX
#
   mips*-sgi)
      case $machine in
         mips64-sgi) 
            prc=`hinv -t cpu | egrep ' R5| R8| R10' > /dev/null` || \
                    prc="non-10000"
            if [ "$prc" = "non-10000" ]; then
               echo "Non R10000 IRIX64"
               opt='-O2 -n32 -mips3 -G 0 -woff 2290'
            else
               echo "R10000 IRIX64"
               opt='-O2 -64 -mips4 -G 0 -woff 2290'
            fi;;
         *)          
            case $os in
               irix6.4)
                  opt='-O2 -64 -mips4 -G 0 -woff 2290';;
               irix6.[2-3])
                  opt='-O2 -n32 -mips3 -G 0 -woff 2290';;
               *)
                  opt='-O2 -32 -mips2 -G 0 -woff 2290';;
            esac
         esac
         if [ "$mesp" = "dummy" ]; then
            cpp="-DPRG_DIRAC -DSYS_IRIX -D'INSTALL_WRKMEM=\${WRKMEM}'"
            ccp="-DSYS_IRIX"
            for mod in $MODS; do
               cpp=`echo $cpp $mod`
            done
            def='dirac.x'
         else
            cpp="-DPRG_DIRAC -DSYS_IRIX -D'INSTALL_WRKMEM=\${WRKMEM}' -D$parop"
            ccp="-DSYS_IRIX"
            for mod in $MODS; do
               cpp=`echo $cpp $mod`
            done
            if [ "$mesp" = "mpi" ]; then
               def='dirmpi.x'
            else
               def='dirpvm.x'
            fi
         fi
         inc="-I$INCLUDE_DIR";;
#
#   Linux
#
   i[3-6]86-*)
      echo 
      echo "Get the BLAS routines. See 'Known issues and problems' at"
      echo "http://dirac.chem.ou.dk"
      if [ "$mesp" = "dummy" ]; then
         cpp="-DPRG_DIRAC -DSYS_LINUX -DVAR_MFDS -D'INSTALL_WRKMEM=\${WRKMEM}' "
         ccp="-DSYS_LINUX -D'INSTALL_WRKMEM=\${WRKMEM}'"
         def='dirac.x'
      else
         cpp="-DPRG_DIRAC -DSYS_LINUX -DVAR_MFDS -D'INSTALL_WRKMEM=\${WRKMEM}' -D$parop"
         ccp="-DSYS_LINUX"
         if [ "$mesp" = "mpi" ]; then
            def='dirmpi.x'
         else
            def='dirpvm.x'
         fi
      fi
      for mod in $MODS; do
         cpp=`echo $cpp $mod`
      done
      opt='-O3 -ffast-math -fautomatic -fno-f2c -fno-globals -Wno-globals'
      inc="-I$INCLUDE_DIR";;
   
   *)
      echo "aaarggh"
      exit 1
esac
#
#  Add VAR_G77 is compiler is g77
#  and add INSTALL_WRKMEM to the ccp-flags.
#
if [ "$F77" = "g77" ]; then
   cpp="$cpp -DVAR_G77"
   ccp="$ccp -DVAR_G77 -D'INSTALL_WRKMEM=\${WRKMEM}'"
fi
# 
#  Make Makefile.config
#
#  To avoid problems with make depend, substitute all , with spaces
#
if [ "$mesp" != "dummy" ]; then 
   depend_flags=`echo $cpp $inc | sed -e 's/,/\ /g'`
else
   depend_flags=`echo $cpp $inc $parinc | sed -e 's/,/\ /g'`
fi
cat <<EOF > Makefile.config
ARCH        = $guess
#
#
WRKMEM      = $memsiz
DEPEND_FLAGS= $depend_flags
CPP_FLAGS   = $cpp
CCP_FLAGS   = $ccp
F77         = $F77
CC          = cc
RM          = -rm
AR          = ar
OPTFLAGS    = $opt
INCLUDE_DIR = $inc
LIB_LIST    = $LIB
INSTALLDIR  = $INSTALL_DIR
#
default : $def
EOF

#
# Insert necessary additional features for parallel calculations
#

#jth: parlib=-mpi 
#if [ "$mesp" = "mpi" -a "$parlib" = "yes" ]; then
if [ "$mesp" = "mpi" ]; then
   if [ ! -z "$parlibp" ]; then
      parlibp=-L$parlibp
   fi
    cat <<EOF >> Makefile.config
#
# Parallel initialization
#
MPI_INCLUDE_DIR = $parinc
MPI_LIB_PATH    = $parlibp
MPI_LIB         = $parlib
INCLUDE_DIR     = $inc \$(MPI_INCLUDE_DIR)
#
EOF
#elif [ "$mesp" = "pvm" -a "$parlib" = "yes" ]; then
elif [ "$mesp" = "pvm" ]; then
    cat <<EOF >> Makefile.config
#
# Parallel initialization
#
PVM_LIB_PATH    = $parinc
PVM_LIB_LIST    = $parlib
#
EOF
fi
#
# Include the rule for building the object files
#
cppuse=
case $machine in 
   c*-convex)
    cpptry='cpp'
#
#  On the Convex accesible to us, cpp is very oddly placed. If we can't
#  find cpp, we try to see if this is a general Convex installation
#
    set dummy $cpptry; ac_word=$2
    echo "checking for preprocessor... $cpptry\c"
    IFS="${IFS=   }"; ac_save_ifs="$IFS"; IFS="${IFS}:"
    for ac_dir in $PATH; do
        test -z "$ac_dir" && ac_dir=.
        if test -f $ac_dir/$ac_word; then
            ac_cv_prog_cpp=$ac_word
            break
        fi
    done
    IFS="$ac_save_ifs"
    test -z "$ac_cv_prog_cpp" && ac_cv_prog_cpp=""
    cppuse="$ac_cv_prog_cpp"
    echo "cppuse $cppuse cpptry $cpptry"
    if test -z "$cppuse"; then
#
#
#   Try /usr/lib/cc as a last resort
#
        if [ -x /usr/lib/cc/cpp ]; then
           cppuse='/usr/lib/cc/cpp'
        fi
    fi
    if test -n "$cppuse"; then
       echo "Preprocessor $cppuse found"
    else
       echo "Preprocessor $cpptry not found"
    fi
esac
if [ "$machine" = "rs6000-ibm" -a "$os" = "aix2" ]; then
    cppuse='cc'
fi


tab=`$echo "\t"`

case $machine in
#
#  CONVEX
#
   c*-convex)
   cat <<EOF >> Makefile.config
CPP         = $cppuse
#
# Suffix rules
#
.SUFFIXES : .F .f .c .o .a

.F.o:
$tab\$(CPP) \$(INCLUDE_DIR) \$(CPP_FLAGS) \$*.F > \$*.f
$tab\$(F77) \$(OPTFLAGS) -c \$*.f
$tab\$(RM) \$*.f

.c.o:
$tab\$(CC) \$(INCLUDE_DIR) \$(CCP_FLAGS) \$(OPTFLAGS) -c \$*.c
EOF
esac

case $machine in
#
#  RS6000
#
   rs6000-ibm)
#
#     RS6000 and aix2
#
   if [ $os = 'aix2' ]; then
cat <<EOF>> Makefile.config
CPP        = $cppuse
#
# Suffix rules
#
.SUFFIXES : .F .c .o .a

.F.o:
$tab\$(CPP) \$(INCLUDE_DIR) \$(CPP_FLAGS) \$*.F
$tab mv \$*.i \$*.f
$tab\$(F77) \$(OPTFLAGS) -c \$*.f
$tab\$(RM) \$*.f
.c.o:
$tab\$(CC) \$(INCLUDE_DIR) \$(CCP_FLAGS) \$(OPTFLAGS) -c \$*.c

EOF
#
#     RS6000 and !aix2
#
    else cat <<EOF>> Makefile.config
#
# Suffix rules
#
.SUFFIXES : .F .c .o .a

.F.o:
$tab\$(F77) \$(INCLUDE_DIR) \$(CPP_FLAGS) \$(OPTFLAGS) -c \$*.F
.c.o:
$tab\$(CC) \$(INCLUDE_DIR) \$(CCP_FLAGS) \$(OPTFLAGS) -c \$*.c
EOF
    fi
esac


case $machine in
#
#  OTHER SYSTEMS
#
   rs6000-ibm|c*-convex)
# allready taken care of
     ;;
   *) 
cat <<EOF>> Makefile.config
#
# Suffix rules
#
.SUFFIXES : .F .c .o .a

.F.o:
$tab\$(F77) \$(INCLUDE_DIR) \$(CPP_FLAGS) \$(OPTFLAGS) -c \$*.F
.c.o:
$tab\$(CC) \$(INCLUDE_DIR) \$(CCP_FLAGS) \$(OPTFLAGS) -c \$*.c
EOF
esac
#
# Suffix rule for archive files
#
cat <<EOF>> Makefile.config
.F.a:
$tab\$(F77) \$(INCLUDE_DIR) \$(CPP_FLAGS) \$(OPTFLAGS) -c \$*.F
$tab\$(AR) \$(ARFLAGS) \$@ \$*.o
$tab@ rm -f \$*.o
EOF
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Make dhf shell script
#
#
$echo 'Copying dhf shell script to '$INSTALL_DIR' : \c'
cat <<EOF > $INSTALL_DIR/dhf
#!/bin/csh -f
#
set SCR_DEFAULT = $worksp
set BIN_DIR     = $INSTALL_DIR
set SRC_DIR     = `pwd`
EOF
cat ./dhf.in >> $INSTALL_DIR/dhf
chmod a+rx $INSTALL_DIR/dhf
echo "ok"
echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Make makefile in all directories
#
#
echo
echo "Making Makefiles..."
dirs="dirac prp abacus gp pdpack"
if [ -z "$ERIFLG" ] ; then
   ERIFLG=0
fi
if [ -z "$CCFLG" ] ; then
   CCFLG=0
fi
if [ -z "$RSPFLG" ] ; then
   RSPFLG=0
fi
if [ -z "$TRAFLG" ] ; then
   TRAFLG=0
fi
if [ -z "$PARFLG" ] ; then
   PARFLG=0
fi
if [ -z "$OPENFLG" ] ; then
   OPENFLG=0
fi
if [ -z "$CIFLG" ] ; then
   CIFLG=0
fi
if [ $ERIFLG != 0 ]; then
   dirs="$dirs eri"
fi
if [ $CCFLG != 0 ]; then
   dirs="$dirs relccsd"
fi
if [ $RSPFLG != 0 ]; then
   dirs="$dirs prp/rsp"
fi
if [ $TRAFLG != 0 ]; then
   dirs="$dirs moltra"
fi
if [ $PARFLG != 0 ]; then
   dirs="$dirs abacus/par"
fi
if [ $OPENFLG != 0 ]; then
   dirs="$dirs dirac/open"
fi
if [ $CIFLG != 0 ]; then
   dirs="$dirs dirrci"
fi
for makefile in $dirs; do
   echo "Making $makefile/Makefile from $makefile/Makefile.in"
   if [ -f $makefile/Makefile ]; then
      rm -f $makefile/Makefile
   fi
   cp $makefile/Makefile.in $makefile/Makefile
done
echo
#
#  Make links to include
#
for link in $dirs; do
   echo "Making link from include to $link/include"
   if [ -d $link/include ]; then
      rm -f $link/include
   fi
   ln -sf ../include $link/include
done
#
#  Move write-protection if super-user (pamadm)
#
#if [ $PAMADM = 1 ]; then
#   echo "You're a Dirac superuser, so I'll remove write proctection..."
#   chmod -R u+w *
#fi
echo


echo "Before you run make, please check Makefile.config and edit"
echo "it if you wish."
echo
echo "Please check 'Known issues and problems' at"
echo "   http://dirac.chem.ou.dk"
echo "to see hints or/and problems concerning your platform."
echo
echo "Then run "
echo "   make depend (not necesary)"
echo "   make"
echo "Then Dirac should be ready to run..."
