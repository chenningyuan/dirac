#!/bin/sh

#Defaults
SYSTEM=`./config.guess`
FCOMP=f95 # Fortran compile
CCOMP=cc # C compiler
WORKMEM=100 #static memory allocation in MB
PARTYPE= # can be mpi, mpi2 or empty.
MPIRUN='mpirun -np $MPI_NPROC'
SCRATCH=/tmp
LIBFLAGS= # How to link external libraries
INCFLAGS= # Include directories for mpi
BUILTIN_BLAS= # Search for external blas later on if not defined.
BUILTIN_LAPACK= #the same for lapack
SKIP_TESTS= # skip test builds
# Set by scripts below
NRBITS= # 32 or 64
CPPFLAGS=-Iinclude # Cppflags common to both C and Fortran
FPPFLAGS=-Iinclude # pp flags for Fortran
FFLAGS=
FFLAGS_SAFE=
CFLAGS=
CFLAGS_SAFE=

print_usage_and_exit()
{
    echo "Usage: --configure [OPTIONS]"
    echo " OPTIONS:"
    echo " --fc=<Fortran compiler>"
    echo " --cc=<C compiler>"
    echo " --mem=<memory size (MB)>"
    echo " --scratch=<scratch directory>"
    echo " --parallel=<mpi or mpi2>"
    echo " --mpirun=<mpirun command line>"
    echo " --libs=<library flags>"
    echo " --inc=<include directory flags>"
    echo " --builtin-blas"
    echo " --builtin-lapack"
    echo " --system=<system id tuple>"
    echo " --skip-tests"
    exit
}

parse_args()
{
    while [ ! -z "$1" ]; do
	arg=`echo "$1" | cut -d = -f 1 2>/dev/null`
	val=`echo "$1" | cut -s -d = -f 2- 2>/dev/null`
	case "$arg" in
	    --help|-h) print_usage_and_exit;;
	    --fc) FCOMP="$val";;
	    --cc) CCOMP="$val";;
	    --mem) WORKMEM="$val";;
	    --scratch) SCRATCH="$val";;
	    --parallel) PARTYPE="$val";;
            --mpirun) MPIRUN="$val";;
	    --libs) LIBFLAGS="$val";;
	    --inc) INCFLAGS="$val";;
	    --builtin-blas) BUILTIN_BLAS=yes; BUILTIN_LAPACK=yes;;
	    --builtin-lapack) BUILTIN_LAPACK=yes;;
	    --system) SYSTEM="$val";;
	    --skip-tests) SKIP_TESTS=y;;
	    *) echo "Invalid option '$1', try --help."; exit 1;;
	esac
	shift
    done
}

test_libs()
{
    echo "Testing compilers and external libraries (disable with --skip-tests)"
    if [ -z "$BUILTIN_BLAS" ]; then
# Test Fortran compiler and blas
	cat > blastest.F<<EOF
      program test
      call dgemm
      end program
EOF
	echo " Building a test Fortran program with BLAS"
	rm -f blastest
	$FCOMP -o blastest blastest.F $LIBFLAGS 2>/dev/null 1>/dev/null
	if [ ! -r blastest ]; then
	    echo $FCOMP -o blastest blastest.F $LIBFLAGS
	    $FCOMP -o blastest blastest.F $LIBFLAGS
	    echo
	    echo " Compilation failed, check the --fc and --libs arguments. If you do"
	    echo " not have a working blas installation consider --builtin-blas."
	    echo " The test program blastest.F will be left in the current directory."
	    exit 1
	fi
	rm -f blastest blastest.F
    fi
    if [ -z "$BUILTIN_LAPACK" -a -z "$BUILTIN_BLAS" ]; then
# Test Fortran compiler and lapack
	cat > lapacktest.F<<EOF
      program test
      call zstegr
      end program
EOF
	echo " Building a test Fortran program with LAPACK"
	rm -f lapacktest
	$FCOMP -o lapacktest lapacktest.F $LIBFLAGS 2>/dev/null 1>/dev/null
	if [ ! -r lapacktest ]; then
	    echo $FCOMP -o lapacktest lapacktest.F $LIBFLAGS
	    $FCOMP -o lapacktest lapacktest.F $LIBFLAGS
	    echo
	    echo " Compilation failed, check the --fc and --libs arguments. If you do"
	    echo " not have a working LAPACK installation consider --builtin-lapack."
	    echo " The test program lapacktest.F will be left in the current directory."
	    exit 1
	fi
	rm -f lapacktest lapacktest.F
    fi
# Test mpi if relevant
    if [ -n "$PARTYPE" ]; then
	if [ $PARTYPE = mpi ]; then
	    cat > mpitest.F<<EOF
      program test
      include "mpif.h"
      call MPI_RECV
      end program
EOF
	else # mpi2
	    cat > mpitest.F<<EOF
      program test
      implicit none
      include "mpif.h"
      call MPI_FILE_CLOSE(MPI_MODE_WRONLY)
      end program
EOF
	fi
	echo " Building a test Fortran program with MPI"
	rm -f mpitest
	$FCOMP -o mpitest mpitest.F $INCFLAGS $LIBFLAGS 2>/dev/null 1>/dev/null
	if [ ! -r mpitest ]; then
	    echo $FCOMP -o mpitest mpitest.F $INCFLAGS $LIBFLAGS
	    $FCOMP -o mpitest mpitest.F $INCFLAGS $LIBFLAGS
	    echo
	    echo " Compilation failed, check the --fc, --libs and --inc arguments."
	    echo " The test program mpitest.F will be left in the current directory."
	    exit 1
	fi
	rm -f mpitest mpitest.F
# C program test
	cat > mpitest.c<<EOF
#include <mpi.h>
int main(void)
{ MPI_Comm comm;
  MPI_Bcast( 0, 100, MPI_INT, 0, comm);
  return 0;
}
EOF
	echo " Building a test C program with MPI"
	rm -f mpitest
	$CCOMP -o mpitest mpitest.c $INCFLAGS $LIBFLAGS 2>/dev/null 1>/dev/null
	if [ ! -r mpitest ]; then
	    echo $CCOMP -o mpitest mpitest.c $INCFLAGS $LIBFLAGS
	    $CCOMP -o mpitest mpitest.c $INCFLAGS $LIBFLAGS
	    echo
	    echo " Compilation failed, check the --cc, --libs and --inc arguments."
	    echo " The test program mpitest.c will be left in the current directory."
	    exit 1
	fi
	rm -f mpitest mpitest.c
    fi
}

# if $1 matches any of $2 .. echo the first matching token
match_keyword()
{
    nn="$1"
    shift
    while [ -n "$1" ]; do
	if echo "$nn" | grep -q "$1"; then
	    echo "$1"
	    break
	fi
	shift
    done
}

set_fflags()
{
    COMPLIST="mpif openmpif ifc ifort gfortran pathf90 pgf90 lfc g95 xlf"
    comp=`match_keyword "$FCOMP" $COMPPLIST`
    echo comp:$comp
    if [ "$comp" = mpif -o "$comp" = openmpif ]; then
	show=`$FCOMP -show 2> /dev/null || $FCOMP -showme 2> /dev/null`
	echo here
	comp=`match_keyword "$show" $COMPLIST`
    fi
    if [ -z "$comp" ]; then
	echo "Warning: could not determine Fortran compiler type, assuming gfortran"
	comp=gfortran
    fi
    echo "I think fc=$comp"
    case $comp in
	g95)
	    FFLAGS="-g -O3 -ffast-math -Wno=155"
	    FFLAGS_SAFE="-g -Wno=155"
	    FPPFLAGS="-fmod=modules"
	    ;;
	gfortran)
	    FFLAGS="-g -O3 -ffast-math -funroll-loops -ftree-vectorize -Jmodules"
	    FFLAGS_SAFE="-g -Jmodules"
	    FPPFLAGS="-DVAR_G77 -DGFORTRAN -Jmodules"
	    ;;
	pgf90)
	    FFLAGS="-g -fastsse"
	    FFLAGS_SAFE="-g"
	    FPPFLAGS="-module modules -DVAR_PGCC"
	    ;;
	lfc)
	    FFLAGS="-g --fast"
	    FFLAGS_SAFE="-g"
	    FPPFLAGS=" -Mmodules"
	    ;;
	ifort)
	    FFLAGS="-g -O3 -ip -w -assume byterecl"
	    FFLAGS_SAFE="-g -w -assume byterecl"
	    FPPFLAGS="-DVAR_IFC -module modules"
	    ;;
	xlf)
	    FPPFLAGS="-qmoddir=modules"
# see what to do about this
#	    f90_extraflags="-qfree=f90 -qsuffix=cpp=F90"
	    ;;
	pathf90)
	    FPPFLAGS="-DVAR_EKO -module modules"
	    ;;
	*) echo "Unknown compiler???(bite me)"; exit 1;;
    esac
}

set_cflags()
{
    COMPLIST="icc gcc pgcc pathcc cc ecc xlc_r xlc xlc"
    comp=`match_keyword "$CCOMP" $COMPPLIST`
    if [ "$comp" = mpicc -o "$comp" = openmpicc ]; then
	show=`$CCOMP -show 2> /dev/null || $CCOMP -showme 2> /dev/null`
	comp=`match_keyword "$show" $COMPLIST`
    fi
    if [ -z "$comp" ]; then
	echo "Warning: could not determine C compiler type, assuming gcc"
	comp=gcc
    fi
    echo "I think cc=$comp"

}

set_nrbits()
{
    case $SYSTEM in
	*-ibm | powerpc64-unknown-linux* | ppc64*| mips*-sgi | i[3-6]86-* | *apple* | sparc-sun| m68k-sun | *-hp | alpha-dec|mips-dec|alphaev6-dec)
NRBITS=32;;
x86_64-* | ia64-unknown-linux | *-cray )
NRBITS=64;;
*) echo "WARNING: Cannot determine if you have a 32 or 64 bit machine, will assume 32 bits";
NRBITS=32;;
esac
}

setup_compiler_options()
{
    set_nrbits
    set_fflags
    set_cflags
}

parse_args "$@"
echo "Configuring Dirac for $SYSTEM"
    echo " Dirac will use ${WORKMEM}MB of memory (change with --mem)"
    echo " Default scratch directory is $SCRATCH (change with --scratch)"
if [ -z "$PARTYPE" ]; then
    echo " Serial version will be built (change with --parallel)"
else
    echo " Parallel ($PARTYPE) version will be built"
    echo "   and started with $MPIRUN (change with --mpirun)"
fi
test -n "$BUILTIN_BLAS" && echo " Built-in (slow) BLAS library will be used"
test -n "$BUILTIN_LAPACK" && echo " Built-in (slow) LAPACK library will be used"
# setup_compiler_options
echo " Fortran compiler options: $FCOMP $FFLAGS $CPPFLAGS $INCFLAGS $LIBS"
echo " C compiler options:       $CCOMP $CFLAGS $CPPFLAGS $INCFLAGS $LIBS"
test -z "$SKIP_TESTS" && test_libs
echo "Makefile.config created, now compile Dirac by running"
echo " make depend"
echo " make"
