#! /usr/bin/env python

import os
import sys
import string
from optparse import OptionParser, OptionGroup

# define example usage

usage = './%prog --all [--mpi=4]'

# initialize parser

parser = OptionParser(usage)

# define options

group = OptionGroup(parser, 'Select the test set')
group.add_option('--short',
                 action='store_true',
                 dest='short',
                 default=False,
                 help='run the short test set [default: %default]')
group.add_option('--all',
                 action='store_true',
                 dest='all',
                 default=False,
                 help='run all tests [default: %default]')
group.add_option('--individual',
                 type='string',
                 action='store',
                 dest='individual',
                 default=None,
                 help='select individual test(s)',
                 metavar='\"test1 test2 anothertest\"')
group.add_option('--keywords',
                 type='string',
                 action='store',
                 dest='keywords',
                 default=None,
                 help='select tests according to keywords',
                 metavar='\"dft response\"')
parser.add_option_group(group)

group = OptionGroup(parser, 'MPI parallelization')
group.add_option('--mpi',
                 type='int',
                 action='store',
                 dest='mpi',
                 default=None,
                 help='set number of cores [default: %default]',
                 metavar='INTEGER')
parser.add_option_group(group)

group = OptionGroup(parser, 'Development options')
group.add_option('--giveup',
                 action='store_true',
                 dest='short',
                 default=False,
                 help='give up after first failing test [default: %default]')
group.add_option('--timeout',
                 type='int',
                 action='store',
                 dest='timeout',
                 default=None,
                 help='set time limit for hanging tests in seconds [default: %default]',
                 metavar='INTEGER')
parser.add_option_group(group)

# process input

(options, args) = parser.parse_args()

# user has given no arguments: print help and exit

if len(sys.argv) == 1:
    print parser.format_help().strip()
    sys.exit()

# get a list of tests to run according to input

list_of_tests_to_run = []

if options.individual != None:
    for test in options.individual.split():
        list_of_tests_to_run.append(test)

# at this stage we know which tests we want to run
# let's run them

for test in list_of_tests_to_run:
    directory = 'test/%s' % test
    menu_file = '%s/menu' % directory
    f = open(menu_file, 'r')
    for line in f.readlines():
        inp = line.split()[0]
        mol = line.split()[1]
        inp_file = '%s/%s' % (directory, inp)
        mol_file = '%s/%s' % (directory, mol)
        pam_flags = ''
        if len(line.split()) > 2:
           for i in range(2, len(line.split())):
               pam_flags += line.split()[i] + ' '
        os.system('./pam --inp=%s --mol=%s %s' % (inp_file, mol_file, pam_flags))
    f.close()
