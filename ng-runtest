#! /usr/bin/env python

# notes: 1. requires a file called menu
#           see for instance test/visual_general/menu
#           this file is in "free format" and can have 
#           empty lines
#           lines contain: input file, molecule file[, pam flags]
#        2. --quick, --keywords, --timeout
#           not programmed yet
#        3. the good old html output not programmed yet but will come
#        4. overwrite feature to be programmed
#        5. --et (calling home) email feature to be programmed

import os
import sys
import string
import subprocess
from optparse import OptionParser, OptionGroup

root_directory = os.path.realpath(__file__)[:-11]

# define example usage

usage = '''
  typically ./%prog --all [--mpi=4]
         or ./%prog --tests="some_test another_test"
         or ./%prog --tests=visual*'''

# initialize parser

parser = OptionParser(usage)

# define options

group = OptionGroup(parser, 'Select the test set')
group.add_option('--all',
                 action='store_true',
                 dest='all',
                 default=False,
                 help='run all tests [default: %default]')
group.add_option('--tests',
                 type='string',
                 action='store',
                 dest='individual',
                 default=None,
                 help='select individual test(s)',
                 metavar='\"test1 test2 anothertest\"')
group.add_option('--quick',
                 action='store_true',
                 dest='quick',
                 default=False,
                 help='run only a subset that is quick but has less coverage [default: %default]')
group.add_option('--benchmark',
                 action='store_true',
                 dest='benchmark',
                 default=False,
                 help='run only benchmark runs [default: %default]')
group.add_option('--keywords',
                 type='string',
                 action='store',
                 dest='keywords',
                 default=None,
                 help='select tests according to keywords (not programmed yet)',
                 metavar='\"dft response\"')
parser.add_option_group(group)

group = OptionGroup(parser, 'MPI parallelization')
group.add_option('--mpi',
                 type='int',
                 action='store',
                 dest='mpi',
                 default=0,
                 help='set number of cores [default: %default]',
                 metavar='INTEGER')
parser.add_option_group(group)

group = OptionGroup(parser, 'Development options')
group.add_option('--giveup',
                 action='store_true',
                 dest='giveup',
                 default=False,
                 help='give up after first failing test [default: %default]')
group.add_option('--timeout',
                 type='int',
                 action='store',
                 dest='timeout',
                 default=None,
                 help='set time limit for hanging tests in minutes [default: %default]',
                 metavar='INTEGER')
parser.add_option_group(group)

# process input

(options, args) = parser.parse_args()

# user has given no arguments: print help and exit

if len(sys.argv) == 1:
    print parser.format_help().strip()
    sys.exit()

# get a list of tests to run according to input

list_of_tests_to_run = []

if options.all:
    file = root_directory + '/test/list_of_tests'
    if os.path.isfile(file):
        f = open(file, 'r')
        for line in f.readlines():
            list_of_tests_to_run.append(root_directory + '/test/' + line.strip('\n'))
        f.close()
    else:
        print 'file %s does not exist, run pamadm first' % file
        sys.exit()

if options.individual != None:
    s = options.individual.split()
    l = ''
    for w in s:
        l += root_directory + '/test/' + w + ' '
#   this complicated code is to allow --tests="foo* *bar* *oof"
    command = 'find %s -type d -maxdepth 0' % l
    p = subprocess.Popen(command,
                         shell=True,
                         stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE)
    for test in p.communicate()[0].split('\n'):
        if test != '':
            list_of_tests_to_run.append(test)

# get total number of tests to run
# also verify that the tests have menu files
# remove those that don't

list_of_tests_with_menu = []

total_nr_of_tests = 0
for test in list_of_tests_to_run:
    os.chdir(test)
    file = 'menu'
    if os.path.isfile(file):
        list_of_tests_with_menu.append(test)
        f = open(file, 'r')
        for line in f.readlines():
            total_nr_of_tests += 1
        f.close()
list_of_tests_to_run = list_of_tests_with_menu[:]

# print header

print
print '%8s %6s %25s %30s %15s' % ('progress', 'result', 'test', 'inp', 'mol')
print '----------------------------------------------------------------------------------------'

# run the tests

nr_of_tests_done = 0
nr_ok            = 0
nr_crashed       = 0
nr_failed        = 0
nr_without_ref   = 0
for test in list_of_tests_to_run:
    os.chdir(test)
    f = open('menu', 'r')
    for line in f.readlines():
        if len(line.split()) > 0:
            # consider only non-empty lines
            if line[0:2] == 'sh':
                # run shell command
                os.system(line[2:])
            else:
                # run test
                nr_of_tests_done += 1
                inp_file = line.split()[0]
                mol_file = line.split()[1]
                pam_flags = ''
                if len(line.split()) > 2:
                   for i in range(2, len(line.split())):
                       pam_flags += line.split()[i] + ' '
                pam_flags += '--silent '
                pam_flags += '--nobackup '
                pam_flags += '--noarch '
                if options.mpi > 1:
                    pam_flags += '--mpi=%i ' % options.mpi
                
                # run pam
                command = '%s/pam --inp=%s --mol=%s %s' \
                    % (root_directory, inp_file, mol_file, pam_flags)
                p = subprocess.Popen(command,
                                     shell=True,
                                     stdin=subprocess.PIPE,
                                     stdout=subprocess.PIPE)
                
                # check whether DIRAC terminated normally
                pam_output = p.communicate()[0]
                if 'exit           : normal' in pam_output:
                    output_file = string.replace(inp_file, '.inp', '') \
                                + '_'                                  \
                                + string.replace(mol_file, '.mol', '') \
                                + '.out'
                    if os.path.isfile('result/%s' % output_file):
                      
                        # create directory where outputs are compared
                        if not os.path.isdir('compare'):
                            os.mkdir('compare')

                        # apply the filter on output
                        os.system('../SCRIPTS/crep %s        result/filter > compare/%s.own' \
                                  % (output_file, output_file))
                        # apply the filter on reference output
                        os.system('../SCRIPTS/crep result/%s result/filter > compare/%s.ref' \
                                  % (output_file, output_file))
                        # compare filtered result with reference
                        os.system('../SCRIPTS/bdrep compare/%s.own compare/%s.ref > compare/%s.txt' \
                                  % (output_file, output_file, output_file))
                        
                        if os.path.getsize('compare/%s.txt' % output_file) == 0:
                            result_text = 'OK'
                            nr_ok += 1
                        else:
                            result_text = 'FAIL'
                            nr_failed += 1
                    else:
                        result_text = ' '
                        nr_without_ref += 1
                else:
                    result_text = 'CRASH'
                    nr_crashed += 1
                
                progress = '[%3i%s]' % (100.0*float(nr_of_tests_done)/float(total_nr_of_tests), r'%')

                test_short = string.split(test, '/')[-1]
                inp_short  = string.replace(inp_file, '.inp', '')
                mol_short  = string.replace(mol_file, '.mol', '')

                print '%8s %6s %25s %30s %15s' % \
                    (progress, result_text, test_short, inp_short, mol_short)

                if ((nr_crashed > 0) or (nr_failed > 0)) and options.giveup:
                    print
                    print 'cowardly gave up after the first problem'
                    print '(fix your code or remove --giveup to continue)'
                    sys.exit()

    f.close()

print
print 'summary: %5i ok'                % nr_ok
print '         %5i failed'            % nr_failed
print '         %5i crashed'           % nr_crashed
print '         %5i without reference' % nr_without_ref

print
