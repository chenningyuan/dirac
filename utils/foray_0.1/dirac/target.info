#
###############################################################################
#
# Setting up the targets for dirac 
#

#
# function to create the structure of the target dictionary
#
def newtarget(name, sdirs):
    target = \
        {
            'name'          : name,
            'rootdirs'      : sdirs,
            'buildsubdir'   : name,
            'libraryname'   : name,
            'skipdirs'      : ['CVS', '.svn'],
            'skipfiles'     : ['.DS_Store'],
            'dependson'     : [],
            'compilegroups' : {
            }
        }
    return target

#
# proper target definition now
#
# targets that will not have their dirctory composition changed with MOD are first
#

general_code  = newtarget('general',['gp','visual','pdpack'])
general_code['compilegroups']['safe'] = ['']
general_code['skipfiles'] = ['graphic.F']

if config_options['libs'] != "":
   general_code['skipfiles'] = general_code['skipfiles'] + ['gpblas.F','gp_dlapack.F'] 

moltra_code   = newtarget('moltra', ['moltra'] )
moltra_code['compilegroups']['safe'] = ['']
moltra_code['dependson'] = ['integrals','general']

prp_dirs = ['prp/xqr','prp/xpp','prp/esr','prp']
if add_aoresp:
   prp_dirs = prp_dirs + ['aoresponse']

prp_code      = newtarget('prp', prp_dirs)
prp_code['compilegroups']['safe'] = [''] 
prp_code['dependson'] = ['integrals','general'] 

if add_aoresp:
	prp_code['dependson'] = prp_code['dependson'] + ['dft']
prp_code['skipfiles'] = ['oldrvc.F', 'mp2lag_a.F'] 


# now the targets will change depending of the MOD flags used
 
#
# integral evaluation codes
#
integrals_dirs = ['abacus','amfi']
integrals_skip = []

if add_fmm: 
   integrals_dirs = integrals_dirs + ['fmm']
   integrals_skip = integrals_skip
if add_dnf:
   integrals_dirs = integrals_dirs + ['densfit','eri']
   integrals_skip = integrals_skip + ['eri2par.F','eriprg.F','denfit_noddy.F','df_dofit.F90']
if add_argosecp:
   integrals_dirs = integrals_dirs + ['argosecp']
   integrals_skip = integrals_skip
if add_eri and not add_dnf:
   integrals_dirs = integrals_dirs + ['eri']
   integrals_skip = integrals_skip + ['eri2par.F','eriprg.F']
   
integral_code = newtarget( 'integrals', integrals_dirs)
integral_code['compilegroups']['safe'] = ['']
if integrals_skip != []:
   integral_code['skipfiles'] = integrals_skip

integral_code['dependson'] = ['general']

#
# ci-related codes
#
ci_dirs = ['dirrci']
ci_skip = ['cimain.F']

ci_code       = newtarget( 'dirrci', ci_dirs)
ci_code['compilegroups']['safe'] = ['']
ci_code['skipfiles'] = ci_skip 
ci_code['dependson'] = ['integrals','moltra','general']

if add_lucis:
   lucita_code = newtarget( 'lucita', ['lucita'] )
   lucita_skip = ['']
   lucita_code['compilegroups']['safe'] = ['']
   lucita_code['dependson'] = ['integrals','general','moltra']

   luciarel_code = newtarget( 'luciarel', ['luciarel'] )
   luciarel_skip = ['']
   luciarel_code['compilegroups']['safe'] = ['']
   luciarel_code['dependson'] = ['integrals','general','moltra']


#
# dft-related code
# 
dft_dirs = ['dft']
dft_skip = ['fun-pw92.c','fun-tester.c']

if add_cdft:
   dft_dirs = dft_dirs + ['cdft']
   dft_skip = dft_skip 
if add_emb:
   dft_dirs = dft_dirs + ['embedding']
   dft_skip = dft_skip 

dft_code      = newtarget('dft', dft_dirs)
dft_code['compilegroups']['safe'] = ['']
dft_code['skipfiles'] = dft_skip 
dft_code['dependson'] = ['general']

if add_dnf:
   dft_code['dependson'] = dft_code['dependson'] + ['integrals']

#
# coupled-cluster related codes
#
cc_dirs = ['relccsd']
cc_skip = ['ccmain.F','ccunix.c','ccdriv_nomemget.F','ccints_nomemget.F','ccdriv_original.F','ccints_original.F','cc_lowmem.F90', 'quit.F']

if add_adc:
   cc_dirs = cc_dirs + ['reladc']
   cc_skip = cc_skip + ['adcmain.F']

cc_code       = newtarget('cc', cc_dirs)
cc_code['compilegroups']['safe'] = ['']
cc_code['skipfiles'] = cc_skip
cc_code['dependson'] = ['moltra','integrals','dft','general', 'prp']

if add_hsmrcc:
   hsmrcc_code = newtarget( 'hsmrcc', ['hsmrcc','hsmrcc/second_quant'] )
   hsmrcc_code['compilegroups']['safe'] = ['']
   hsmrcc_code['skipfiles'] = ['']
   hsmrcc_code['dependson'] = ['moltra','integrals','general']

#
# scf- and hamiltonian-related code
#
scf_dirs = ['dirac']
scf_skip = []

if add_krmc:
   scf_dirs = scf_dirs + ['krmc']
   scf_skip = scf_skip

if add_cap:
   scf_dirs = scf_dirs + ['cap']
   scf_skip = scf_skip

scf_code      = newtarget( 'scf', scf_dirs)
scf_code['compilegroups']['safe'] = ['']
scf_code['dependson'] = ['integrals','dft','general']

if add_cap:
   scf_code['dependson'] = scf_code['dependson'] + ['moltra']



#
# main program
# 
# the other here is important! this is the order the linker will use. 
# this is becaus names on the left call code in the names to the right. 
# if a name appears more than once it means also that the partition
# into these "libraries" is not really clean...

main_program = newtarget('main', ['main'])

main_program['dependson'] = ['scf','cc','dirrci','dft','moltra','prp','scf','integrals','general']

if add_lucis:
   main_program['dependson'] = main_program['dependson'] + ['lucita','luciarel']

if add_hsmrcc:
   main_program['dependson'] = main_program['dependson'] + ['hsmrcc']

main_program['exename'] = 'dirac.x'
main_program['mainprogramfile'] = 'main.F90'

#
# and the final list of targets is assembled!
#
targets = [ moltra_code, prp_code, general_code, integral_code, dft_code, scf_code, cc_code, ci_code, main_program ]

if add_lucis:
   targets.append(lucita_code)
   targets.append(luciarel_code)

if add_hsmrcc:
   targets.append(hsmrcc_code)

#
# end of target definition
#
