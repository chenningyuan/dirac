###############################################################################
#   
# Setting up the targets for dirac #                
# active_dirac_modules information comes from a simplified pamamd-like program
import compflags 

#
#
# Build configs
#

if compflags.config_options['def'] == "dirac.x":
   dirac_mode = 'serial'
else:
   dirac_mode = 'parallel'

defaultconfig = \
{
    'name' : 'default',
    'buildsubdir' : 'default',
    'compileroptions[' : {
        'archivecommand'    :    compflags.config_options['arch_command'],        # 'ar -r',
        'unarchivecommand'  :  compflags.config_options['unarch_command'],        # 'ar -d',
        'ranlibcommand'     :  compflags.config_options['ranlib_command'],        # 'ranlib -s',
        'f77compiler'       :         compflags.config_options['f77comp'],        #'mpif90',
        'f90compiler'       :         compflags.config_options['f90comp'],        # 'mpif90',
        'f77flags'          :        compflags.config_options['f77flags'],        # '-c -g -O3 -ip -w -assume byterecl', 
        'f90flags'          :        compflags.config_options['f90flags'],        # '-c -g -O3 -ip -w -assume byterecl', 
        'modpathoption'     :    compflags.config_options['mod_inc_flag'],        # '-module ',
        'ccompiler'         :           compflags.config_options['ccomp'],        # 'mpicc',
        'cflags'            : compflags.config_options['cflags+ccpflags'],        #"-c -g -O3 -ip -DSYS_LINUX -DSYS_FLAVOR=LINUX -I$FORAY_PROJECT_ROOT/include -I$FORAY_PROJECT_ROOT/modules -I/usr/include -I/usr/local/include -I./ ",
        'link'              :          compflags.config_options['linker'],        # 'mpif90',
        'linkflags'         :      compflags.config_options['link_flags'],        # '-nofor_main -Wl,-E',
        'prioritylibs'      :            compflags.config_options['libs'],        # '-L/usr/local/Cluster-Apps/intel/mkl/8.0/lib/32/ -lmkl',
        'otherlibs'         : '',
        'compilegroupflags' : {
            'default'       : "",
            'safe'          : '-O0 -g'
        }
    }
}

diracconfig = \
{
    'name'                  : dirac_mode,
    'inherits'              : 'default',
    'buildsubdir'           : dirac_mode,
    'installdir'            : '$FORAY_PROJECT_ROOT/bin'+dirac_mode,
}

debugconfig = \
{
    'name'                  : 'debug',
    'inherits'              : 'default',
    'buildsubdir'           : 'debug',
    'installdir'            : '$FORAY_PROJECT_ROOT/bin.debug',
}

configs = [defaultconfig, debugconfig,diracconfig]


# Combine everything in buildinfo dictionary   
buildinfo = \
{
    'builddir'      : '$FORAY_PROJECT_ROOT/build',
    'fortranfiles'  : active_targets.fortranfiles,
    'targets'       : active_targets.targets,
    'defaultconfig' : 'debug',
    'configs'       : configs
}
