# Below is the crontab script that I use to test Dirac. In order to use it on your machine, you should
# of course adapt the MAILTO, possibly the SHELL variable, and insert the proper directories and queues. 
# Luuk Visscher, 3-9-2003.
#
# use /bin/csh to run commands, overriding the default set by cron
SHELL=/bin/csh
MAILTO=visscher@chem.vu.nl
#
#----------------------------------------------------------------------------------------
# we alternate between the serial (mo,we,fr,su) and parallel (tu,th,sa) versions
# run the DIRAC medium testset exactly at midnight, every day
# the output is checked after six hours. By definition it should be after an hour, but we allow for queue delays.
0 0 * * 1,3,5,7 cd $HOME/sources/Dirac.latest; testlast -tests=medium -queue=chemd -cvs=yes
0 6 * * 1,3,5,7 cat $HOME/sources/Dirac.latest/test/logs/lastrun
0 0 * * 2,4,6   cd $HOME/sources/Dirac.latest.par; testlast -mpi=3 -tests=medium -queue=chema -cvs=yes
0 6 * * 2,4,6   cat $HOME/sources/Dirac.latest.par/test/logs/lastrun
#----------------------------------------------------------------------------------------
# run the DIRAC long testset with the parallel code in serial mode seven hours after midnight, sunday
0 7 * * 7       cd $HOME/sources/Dirac.latest.par; testlast -mpi=1 -queue=chema -tests=long -cvs=yes
# check the output an hour before the next medium run starts
0 23 * * 7       cat $HOME/sources/Dirac.latest.par/test/logs/lastrun
#----------------------------------------------------------------------------------------

