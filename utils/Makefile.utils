#
# This file gets included from the main makefile, and
# make has to be run from the top level directory.

utils: $(INSTALL_DIR)/labread.x \
       $(INSTALL_DIR)/twofit.x
##  TODO:   $(INSTALL_DIR)/twofit.x ,  $(INSTALL_DIR)/rspread.x ...

$(INSTALL_DIR)/labread.x: utils/labread.o
	$(LD) -o $@ utils/labread.o

$(INSTALL_DIR)/twofit.x: utils/twofit.o gp/gpsaue.o  gp/gptrygve.o  gp/gphjj.o  gp/qpack.o \
                    gp/mempkg.o  pdpack/linextra.o  pdpack/printpkg.o  \
                    abacus/hergp.o pdpack/eispack.o gp/gpjeppe.o pdpack/arhpack.o \
                    pdpack/dsp.o gp/tracing.o
	$(LD) -o $@ utils/twofit.o  gp/gpsaue.o  gp/gptrygve.o  gp/gphjj.o  gp/qpack.o \
                    gp/mempkg.o  pdpack/linextra.o  pdpack/printpkg.o  \
                    abacus/hergp.o pdpack/eispack.o gp/gpjeppe.o pdpack/arhpack.o \
                    pdpack/dsp.o gp/tracing.o $(LIBS)

