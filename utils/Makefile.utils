	$(LD) -o $@ utils/cfread.o  gp/gpsaue.o  gp/gptrygve.o  gp/gphjj.o  gp/qpack.o \
                    gp/mempkg.o  pdpack/linextra.o  pdpack/printpkg.o  \
                    abacus/hergp.o pdpack/eispack.o gp/gpjeppe.o pdpack/arhpack.o \
                    pdpack/dsp.o gp/tracing.o \
                    pdpack/dge.o \
                    gp/memory_allocator.o gp/memory_tracker.o gp/tracker_util.o \
                    gp/gpc.o $(LIBS)

