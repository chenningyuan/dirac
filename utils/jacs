command_line_compiler['c++']     = options.cpp


# define classes
# ==============

class Compiler:
      def __init__(self, name):
          self.name          = name
          self.path          = ''
          self.flags_cpp     = ''
          self.flags_opt1    = ''
          self.flags_opt2    = ''
          self.flags_opt3    = ''
          self.flags_safe    = ''
          self.flags_extra   = ''
          self.flags_module  = ''
          self.flags_include = ''
          self.flags_check   = ''
          self.flags_profile = ''
      def set_path(self, path):
          self.path = path
      def set_flags_cpp(self, s):
          self.flags_cpp = s
      def set_flags_opt1(self, s):
          self.flags_opt1 = s
      def set_flags_opt2(self, s):
          self.flags_opt2 = s
      def set_flags_opt3(self, s):
          self.flags_opt3 = s
      def set_flags_safe(self, s):
          self.flags_safe = s
      def set_flags_extra(self, s):
          self.flags_extra = s
      def set_flags_module(self, s):
          self.flags_module = s
      def set_flags_include(self, s):
          self.flags_include = s
      def set_flags_check(self, s):
          self.flags_check = s
      def set_flags_profile(self, s):
          self.flags_profile = s

class FortranCompiler(Compiler):
      def get_kind(self):
          return 'fortran'

class CCompiler(Compiler):
      def get_kind(self):
          return 'c'

class Library:
      def __init__(self, name, flags):
          self.name  = name
          self.flags = flags
          self.path  = ''
      def set_path(self, path):
          self.path = path


