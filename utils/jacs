# define functions
# ================

def select_exclusive(l, default = 1):

    d = {}

    print '\noption default'
    i = 0
    for s in l:
        i += 1
        d[str(i)] = i
        s_default = ' '
        if i == default:
           s_default = '*'
        print '%4i %6s    %s' % (i, s_default, s)

    question = '\npress [1]-[%i] or [enter] for the default (*): ' % i
    while True:
          user_input = raw_input(question)
          if user_input == '':
#            enter (default)
             return default
          elif user_input in d.keys():
#            valid answer
             return d[user_input]
          else:
#            invalid answer
             print 'invalid answer, try again'


# select compilers
# =======================

selected_compiler_d = {}

kind = 'fortran'

if command_line_compiler[kind] == None:
   l = []
   for compiler in available_compiler_d[kind]:
       l.append('%s (%s)' % (compiler.name, compiler.path))
   j = select_exclusive(l)
   selected_compiler_d[kind] = available_compiler_d[kind][j - 1]
else:
#  user selects by command line
   is_avaliable = False
   for compiler in available_compiler_d[kind]:
       if compiler.name == command_line_compiler[kind]:
          is_avaliable = True
   if not is_avaliable:
      selected_compiler_d[kind] = available_compiler_d[kind][j - 1]
   else:
      print '%s compiler %s is not available' % (kind, command_line_compiler[kind])
      sys.exit()
sys.exit()












