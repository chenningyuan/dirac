                  action='store',
                  help='Fortran compiler')

parser.add_option('--cc',
                  dest='cc', 
                  action='store',
                  help='C compiler')

parser.add_option('--cpp',
                  dest='cpp', 
                  action='store',
                  help='C++ compiler')

