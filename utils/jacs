# find compilers
# ==============

# list contains all directories in $PATH
directory_l = string.split(os.getenv('PATH'), ':')

available_compiler_d = {}

# these 3 lists will hold all compilers found on this machine
available_compiler_d['fortran'] = []
available_compiler_d['c']       = []
available_compiler_d['c++']     = []

for directory in directory_l:
    for compiler in compiler_l:
        path = directory + '/' + compiler.name
        if os.path.isfile(path):
           compiler.set_path(path)
           available_compiler_d[compiler.get_kind()].append(compiler)


# find libraries
# ==============

current_directory = os.getenv('PWD')

# extend list of directories with usual suspects
directory_l.append(current_directory + '/' + 'xcfun/lib')
directory_l.append('/usr/lib')
directory_l.append('/opt/intel/mkl/10.2.5.035/lib/32')

available_library_l = []

for directory in directory_l:
    for library in library_l:
        nr_found = 0
        for flag in library.flags:
            if os.path.isfile(directory + '/' + string.replace(flag, '-l', 'lib') + '.a') \
            or os.path.isfile(directory + '/' + string.replace(flag, '-l', 'lib') + '.so'):
               nr_found += 1
        if nr_found == len(library.flags):
           library.set_path(directory)
           available_library_l.append(library)


