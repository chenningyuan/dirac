include ../Makefile.config

F_OBJS = twofit.o labread.o rspread.o polfit.o

F_CPPS = $(F_OBJS:.o=.i)

pre:	$(F_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F_CPPS) > ftnchek.out

all: $(F_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F_OBJS:.o=.F)
# DO NOT DELETE THIS LINE -- make depend depends on it.

