#
# VERSION : $Revision$
# DATE    : $Date$
# FILE    : utils/Makefile.in
#

default: utils

include ../Makefile.config

#F77_OBJS = twofit.o labread.o rspread.o polfit.o
F77_OBJS = twofit.o labread.o rspread.o polfit.o qjaco.o mx2fit.o vibcal.o

F90_OBJS =

F90_MODS =

F77_CPPS = $(F77_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all: $(F77_OBJS) $(F90_OBJS)

utils:
	cd .. ; $(MAKE) utils

# dummy entry to handle the "default:" in ../Makefile.config:
dirac.x dirmpi.x:
	

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i

mod: $(F90_MODS)

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90)

f90dep: ;\
       ../utils/sfmakedepend.pl -I include -M $(INSTALLDIR)/modules $(F90_OBJS:.o=.F90) $(F90_OBJS:.o=.F) $(F77_OBJS:.o=.F)


# DO NOT DELETE THIS LINE -- make depend depends on it.

