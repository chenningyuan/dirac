# Extra targets that are rarely used.

#############################################
#########  CODATA sets of constants  ########
#############################################
codata86: dirac/codata.F90 
	@echo -e "\n\t **** Set CODATA-1986 ****"
	$(F77) -DCODATA86 $(F77FLAGS_SAFE) -c dirac/codata.F90

codata98: dirac/codata.F90 
	@echo -e "\n\t **** Set CODATA-1998 ****"
	$(F77) -DCODATA98 $(F77FLAGS_SAFE) -c dirac/codata.F90

codata02: dirac/codata.F90 
	@echo -e "\n\t **** Set CODATA-2002 ****"
	$(F77) -DCODATA02 $(F77FLAGS_SAFE) -c dirac/codata.F90

codata06: dirac/codata.F90 
	@echo -e "\n\t **** Set CODATA-2006 ****"
	$(F77) -DCODATA06 $(F77FLAGS_SAFE) -c dirac/codata.F90

#  Conditional include to check whether we have the (optional) HSMRCC module active
hscc_make = hsmrcc/hsmrcc_external/Makefile.hsmrcc
is_hscc = $(wildcard $(hscc_make))
ifneq ($(strip $(is_hscc)),)
include $(hscc_make)
else
hs: # for compilation of the standalone external code
	@echo "The hsmrcc/hsmrcc_external/Makefile.hsmrcc file does not exist."
	@echo "The hsmrcc external code is not active (exported)."
endif

#secquant_make=hsmrcc/second_quant/Makefile.secquant
#is_secquant=$(wildcard $(secquant_make))
#ifneq ($(strip $(is_secquant)),)
#include $(secquant_make)
#else
#sq:
#	@echo "Sec.quantization module not active (not exported)"
#endif

#
#  Conditional include for higher sector FSCC codes
#
hsfs_make := hsmrcc/high_sect_fscc_external/Makefile.hsfs
is_hsfs := $(wildcard $(hsfs_make))
ifneq ($(strip $(is_hsfs)),)
include $(hsfs_make)
else
hsfs: # for compilation of the standalone external code
	@echo "External higher sectors FSCC methods not activated !"
endif


#
#  Implicit rules
#  for extra compilation with safe-flags, index-range-check + other checks flags,
#

# flags for the ftnchek,  F77 source code verifying utility
FTNCHEK_FLAGS=-nopure -nopretty -nocommon -nousage -noarray -notruncation -quiet -noarguments -arguments=number -usage=var-unitialized

.F.s:
	$(F77) $(F77FLAGS_SAFE) -c -o $*.o $*.F > $*.s
.F.r:
	$(F77) $(FFLAGS_CHECK) $(F77FLAGS_SAFE) -c -o $*.o $*.F   > $*.r

#
#miro: -DNO_SF_QUIT is only for file gp/gptrygve.F
#
gp/gptrygve.p : gp/gptrygve.F
	$(F77) -DNO_SF_QUIT $(FFLAG_PROFILE) $(F77FLAGS_SAFE) -c -o gp/gptrygve.o gp/gptrygve.F > gp/gptrygve.p
.F.p:
	$(F77) $(FFLAG_PROFILE) $(F77FLAGS_SAFE) -c -o $*.o $*.F > $*.p
.F.i:
	$(F77) $(FPP_FLAGS) -E $*.F > $*.i

.i.fc:
	ftnchek $(FTNCHEK_FLAGS) $*.i > $*.fc

.F90.s:
	$(F90) $(F90FLAGS_SAFE) -c -o $*.o $*.F90  > $*.s
.F90.r:
	$(F90) $(FFLAGS_CHECK) $(F90FLAGS_SAFE) -c -o $*.o $*.F90  > $*.r
.F90.p:
	$(F90) $(FFLAG_PROFILE) $(F90FLAGS_SAFE) -c -o $*.o $*.F90  > $*.p
.F90.i:
	$(F90) $(FPP_FLAGS) -E $*.F90 > $*.i

.f90.s:
	$(F90) $(F90FLAGS_SAFE) -c -o $*.o $*.f90  > $*.s
.f90.r:
	$(F90) $(FFLAGS_CHECK) $(F90FLAGS_SAFE) -c -o $*.o $*.f90  > $*.r
.f90.p:
	$(F90) $(FFLAG_PROFILE) $(FFLAGS_SAFE) -c -o $*.o $*.f90  > $*.p
.f90.i:
	$(F90) $(FPP_FLAGS) -E $*.f90  > $*.i

.c.s:
	$(CC) $(CFLAGS_SAFE) -c -o $*.o $*.c > $*.s
.c.r:
	$(CC) $(CFLAGS_CHECK) $(CFLAGS_SAFE) -c -o $*.o $*.c > $*.r
.c.p:
	$(CC) $(CFLAG_PROFILE) $(CFLAGS_SAFE) -c -o $*.o $*.c > $*.p
.c.i:
	$(CC) $(CPP_FLAGS) -E $*.c > $*.i

obj: $(OBJ) 
	@echo -e "\nDIRAC source files (at least these recently modifies) are recompiled\n\
	(with dependencies)  using standard flags (without linking).\n"

safe: $(OBJ:.o=.s) $(TARGET)
	@echo
	@echo "Executable $(TARGET) is ready with safe compiler flags."

check: $(OBJ:.o=.r) $(TARGET)
	@echo
	@echo "Executable $(TARGET) is ready with run-time checking."

preprocess: $(OBJ:.o=.i)
	@echo
	@echo "All DIRAC source files preprocessed into *.i files."
	@echo

#
# own target for profiling due to linker need for profiling flag
#

prof: $(OBJ:.o=.p) 
	$(LD) $(LDFLAGS) $(FFLAG_PROFILE) -o $(TARGET) $(OBJ) $(LIBS)
	@echo
	@echo "Executable $(TARGET) with profiling info is ready."
	@echo

#
# mi: added target for analyzing executable
#
diag: 
	@echo -e "\tAnalyzing the dirac.x executable "
	@echo -e "Size of all static allocations: \c "; \
	  size $(TARGET) 2> /dev/null | grep $(TARGET) | awk '{printf $$3/(1024*1024)}'; \
	  echo ' MB' || echo 'can not be determined'
	@echo -e "Sorted list of all object sizes (patience please):"
# ... miro: some awk's are not recognizing '--non-decimal-data' ! todo: try to make it universal for all architectures
	@readelf -s $(TARGET) 2> /dev/null | awk --non-decimal-data '{printf "%12.3f %s    %s\n",(($$3)+0)/(1024),"kB",$$8}' | sort -n -r -u || \
	echo 'can not be determined, readelf not present'
	
