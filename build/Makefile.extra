# Extra targets that are rarely used.

#############################################
#########  CODATA sets of constants  ########
#############################################
codata86: dirac/codata.F90 
	@echo -e "\n\t **** Set CODATA-1986 ****"
	$(F77) -DCODATA86 $(F90FLAGS_SAFE) -c dirac/codata.F90

codata98: dirac/codata.F90 
	@echo -e "\n\t **** Set CODATA-1998 ****"
	$(F77) -DCODATA98 $(F90FLAGS_SAFE) -c dirac/codata.F90

codata02: dirac/codata.F90 
	@echo -e "\n\t **** Set CODATA-2002 ****"
	$(F77) -DCODATA02 $(F90FLAGS_SAFE) -c dirac/codata.F90

codata06: dirac/codata.F90 
	@echo -e "\n\t **** Set CODATA-2006 ****"
	$(F77) -DCODATA06 $(F90FLAGS_SAFE) -c dirac/codata.F90

### compile main program as SUBROUTINE ###
main_as_subr:
	$(F90) -DFORTRAN_MAIN_AS_SUBROUTINE $(F90FLAGS) -c -o main/main.o  main/main.F90
        
#  Conditional include to check whether we have the (optional) HSMRCC module active
hscc_make = hsmrcc/hsmrcc_external/Makefile.hsmrcc
is_hscc = $(wildcard $(hscc_make))
ifneq ($(strip $(is_hscc)),)
include $(hscc_make)
else
hs: # for compilation of the standalone external code
	@echo "The hsmrcc/hsmrcc_external/Makefile.hsmrcc file does not exist."
	@echo "The hsmrcc external code is not active (exported)."
endif

# Conditional include for second.quantization external module
secquant_make=hsmrcc/second_quant/Makefile.secquant
is_secquant=$(wildcard $(secquant_make))
ifneq ($(strip $(is_secquant)),)
include $(secquant_make)
else
sq:
	@echo "Sec.quantization module not active (not exported)"
endif

#
#  Conditional include for higher sector FSCC codes
#
hsfs_make := hsmrcc/high_sect_fscc_external/Makefile.hsfs
is_hsfs := $(wildcard $(hsfs_make))
ifneq ($(strip $(is_hsfs)),)
include $(hsfs_make)
else
hsfs: # for compilation of the standalone external code
	@echo "External higher sectors FSCC methods not activated !"
endif


################################################################################################
#
#  Implicit rules
#  for extra compilation with safe-flags, index-range-check + other checks flags
#
################################################################################################

# flags for the ftnchek,  F77 source code verifying utility
FTNCHEK_FLAGS=-nopure -nopretty -nocommon -nousage -noarray -notruncation -quiet -noarguments -arguments=number -usage=var-unitialized

.F.opt:
	$(F77) $(F77FLAGS_OPT_3) $(F77FLAGS_SAFE) -c -o $*.o $*.F > $*.opt
.F.s:
	$(F77) $(F77FLAGS_SAFE) -c -o $*.o $*.F > $*.s
.F.r:
	$(F77) $(FFLAGS_CHECK) $(F77FLAGS_SAFE) -c -o $*.o $*.F   > $*.r
.F.p:
	$(F77) $(FFLAG_PROFILE) $(F77FLAGS_SAFE) -c -o $*.o $*.F > $*.p
.F.i:
	$(F77) $(FPP_FLAGS) -E $*.F > $*.i

.i.fc:
	ftnchek $(FTNCHEK_FLAGS) $*.i > $*.fc

.F90.opt:
	$(F90) $(F77FLAGS_OPT_3)  $(F90FLAGS_SAFE) -c -o $*.o $*.F90  > $*.opt
.F90.s:
	$(F90) $(F90FLAGS_SAFE) -c -o $*.o $*.F90  > $*.s
.F90.r:
	$(F90) $(FFLAGS_CHECK) $(F90FLAGS_SAFE) -c -o $*.o $*.F90  > $*.r
.F90.p:
	$(F90) $(FFLAG_PROFILE) $(F90FLAGS_SAFE) -c -o $*.o $*.F90  > $*.p
.F90.i:
	$(F90) $(FPP_FLAGS) -E $*.F90 > $*.i

.f90.opt:
	$(F90) $(F77FLAGS_OPT_3)  $(F90FLAGS_SAFE) -c -o $*.o $*.f90  > $*.opt
.f90.s:
	$(F90) $(F90FLAGS_SAFE) -c -o $*.o $*.f90  > $*.s
.f90.r:
	$(F90) $(FFLAGS_CHECK) $(F90FLAGS_SAFE) -c -o $*.o $*.f90  > $*.r
.f90.p:
	$(F90) $(FFLAG_PROFILE) $(FFLAGS_SAFE) -c -o $*.o $*.f90  > $*.p
.f90.i:
	$(F90) $(FPP_FLAGS) -E $*.f90  > $*.i

.c.opt:
	$(CC) $(CFLAGS_OPT_3) $(CFLAGS_SAFE) -c -o $*.o $*.c > $*.opt
.c.s:
	$(CC) $(CFLAGS_SAFE) -c -o $*.o $*.c > $*.s
.c.r:
	$(CC) $(CFLAGS_CHECK) $(CFLAGS_SAFE) -c -o $*.o $*.c > $*.r
.c.p:
	$(CC) $(CFLAG_PROFILE) $(CFLAGS_SAFE) -c -o $*.o $*.c > $*.p
.c.i:
	$(CC) $(CPP_FLAGS) -E $*.c > $*.i

obj: $(OBJ) 
	@echo -e "\nDIRAC source files (at least these recently modifies) are recompiled\n\
	(with dependencies)  using standard flags (without linking).\n"

opt: $(OBJ:.o=.opt) $(TARGET)
	@echo
	@echo "Executable $(TARGET) is ready with optimization compiler flags."

safe: $(OBJ:.o=.s) $(TARGET)
	@echo
	@echo "Executable $(TARGET) is ready with safe compiler flags."

check: $(OBJ:.o=.r) $(TARGET)
	@echo
	@echo "Executable $(TARGET) is ready with run-time checking."

preprocess: $(OBJ:.o=.i)
	@echo
	@echo "All DIRAC source files preprocessed into *.i files."
	@echo

#
# own target for profiling due to linker need for profiling flag
#

prof: $(OBJ:.o=.p) 
	$(LD) $(LDFLAGS) $(FFLAG_PROFILE) -o $(TARGET) $(OBJ) $(LIBS)
	@echo
	@echo "Executable $(TARGET) with profiling info is ready."
	@echo

###############################################################################
#
#         target for analyzing static allocations of the executable
#
###############################################################################
dgn:
	@utils/diagn.py
diagnostic:
	@utils/diagn.py

#miro: -DNO_SF_QUIT is only for gp/gptrygve.F to ensure no segm.fault quitting
gp/gptrygve.p : gp/gptrygve.F
	$(F77) -DNO_SF_QUIT $(FFLAG_PROFILE) $(F77FLAGS) -c -o gp/gptrygve.o gp/gptrygve.F > gp/gptrygve.p

################################################################################################
#                                                                                              #
#           'safe'  compilation of individual files with conditional directives                #
#                                                                                              #
#    Smart substitution for the "build/safebuild" list of source files designed 
# for safe compilation   
#                                                                                              #
# Note: for --noopt configure flag optimization flags are empty                                #
#                                                                                              #
################################################################################################

ifeq ($(SAFE_FLAGS_MODE),NO) # check only if no safe-flags compilation

ifeq (-DVAR_GFORTRAN, $(findstring -DVAR_GFORTRAN, $(FPP_FLAGS) ))

#miro: I checked it with gfortran 4.4, we need to avoid optimization
prp/pamrvc.o : prp/pamrvc.F
	@echo " ----  gfortran compiler, prp/pamrvc.F with no level of optimization :"
	$(F77) $(F77FLAGS_SAFE) -c -o $*.o $<
gp/gpsaue.o : gp/gpsaue.F
	@echo " ----  gfortran compiler,  gp/gpsaue.F with no level of optimization :"
#	$(F77) $(F77FLAGS_OPT_1) $(F77FLAGS_SAFE) -c -o $*.o $<
	$(F77) $(F77FLAGS_SAFE) -c -o $*.o $<
endif

### TODO: these individual files have to be supplied with make-if-directives to specify on which 
### compilers/architectures there is a need of the lower/no level of optimization

pdpack/dlamch.o: pdpack/dlamch.F
	@echo " pdpack/dlamch.F compilation with 1st level (of 3) optimization"
	$(F77) $(F77FLAGS_OPT_1) $(F77FLAGS_SAFE) -c -o $*.o $<

amfi/amfi.o: amfi/amfi.F
	@echo "amfi/amfi.F compilation with 2nd level (of 3) optimization"
	$(F77) $(F77FLAGS_OPT_2) $(F77FLAGS_SAFE) -c -o $*.o $<

amfi/amfi1.o: amfi/amfi1.F
	@echo "amfi/amfi1.F compilation with 1st level (of 3) optimization"
	$(F77) $(F77FLAGS_OPT_1) $(F77FLAGS_SAFE) -c -o $*.o $<

abacus/hermodules.o: abacus/hermodules.F
	@echo "abacus/hermodules.F compilation with 1st level (of 3) optimization"
	$(F77) $(F77FLAGS_OPT_1) $(F77FLAGS_SAFE) -c -o $*.o $<

matrix_operations/matrix_defop.o: matrix_operations/matrix_defop.f90
	@echo "matrix_operations/matrix_defop.f90 compilation with 1st level (of 3) optimization"
	$(F90) $(F77FLAGS_OPT_1) $(F90FLAGS_SAFE) -c -o $*.o $<

endif
