#This is a makefile than can be used from subdirectories to
#do some tasks useful for developers. Most things are done
#through the main makefile in the end.

# Find out the relative path back to the Dirac root
BACK:=$(shell x=""; while [ ! -r "$${x}pamadm" ];\
	do x="../$$x"; done; echo "$$x")
ROOT:=$(shell cd $(BACK); pwd)
# Path from the root to $PWD
HERE:=$(subst $(ROOT)/,,$(PWD))

#Collect local file names
F77FILES:=$(wildcard *.F)
ALLFILES:=$(wildcard *.F *.f90 *.F90 *.c)
SRC:=$(addprefix $(HERE)/,$(ALLFILES))
F77SRC:=$(addprefix $(HERE)/,$(F77FILES))
# strip out files in "dontbuild"
SRC:=$(foreach FILE,$(SRC),$(shell echo $(FILE) | egrep -v -f $(BACK)/build/dontbuild && echo $(FILE)))
F77SRC:=$(foreach FILE,$(F77SRC),$(shell echo $(FILE) | egrep -v -f $(BACK)/build/dontbuild && echo $(FILE)))

default:
	@make -C$(BACK)

depend:
	@make -C$(BACK) depend

obj:
	@make -C$(BACK) $(addsuffix .o,$(basename $(SRC)))
	@echo -e "\n  At least recently modified local source files (with all dependencies)\
	 compiled with standard flags.\n"

allobj:
	@make -C$(BACK) obj
	@echo -e "\n  At least recently modified  source files (with all dependencies)\
	 compiled with standard flags.\n"

safe:
	@make -C$(BACK) $(addsuffix .s,$(basename $(SRC)))
	@echo -e "\n  At least recently modified local source files (with all dependencies)\
	 compiled with safe flags.\n"

allsafe:
	@make -C$(BACK) safe


check:
	@make -C$(BACK) $(addsuffix .r,$(basename $(SRC)))
	@echo -e "\n  At least recently modified local source files (with all dependencies)\
	compiled with run-time checking flags.\n"

allcheck:
	@make -C$(BACK) check
	@echo -e "\n  At least recently modified source files (with all dependencies)\
	compiled with run-time checking flags.\n"


prof:
	@make -C$(BACK) $(addsuffix .p,$(basename $(SRC)))
	@echo -e "\n At least recently modified local source files (with all dependencies)\
	 compiled with profiling flags.\n"

allprof:
	@make -C$(BACK) prof

preprocess:
	make -C$(BACK) $(addsuffix .i,$(basename $(SRC)))
	@echo -e "\n All local source files \
	 preprocessed into *.i files.\n"

ftnchek:
	$(if $(F77SRC),,$(error No F77 source files for ftnchek in this directory !))
	@make -C$(BACK) $(addsuffix .fc,$(basename $(F77SRC)))
	@echo
	@echo -e "Individual F77 ftnchek-resulting *.fc files\
	 (at least of recently modified source files)\
	 are ready,\n\
	collecting them into into one summary file - dirac.ftnchek. \n"
	@cat `ls *.fc` > dirac.ftnchek

clean:
	@echo -e "\nCleaning (nonrecursive) the local directory:"
	rm -f *.o *.mod *.gc*  *.s *.r *.i *.fc *.p
	@echo

touch:
	@echo -e "\n Touching source files (*.F,*.F90,*.c) in the local directory"
	touch `ls *.F *.F90 *.c 2> /dev/null`


# clean the whole DIRAC from local directory
allclean:
	@echo
	@make -C$(BACK) clean

# miro's 'external' HSMRCC / HighSect FSCC stuff
hs:
	@make -C$(BACK) hs

hs_clean:
	@make -C$(BACK) hs_clean

# all higher sectors executables
hsfs:
	@make -C$(BACK) hsfs

# individual executables
hsfs_csd:
	@make -C$(BACK) hsfs_csd
hsfs_csv:
	@make -C$(BACK) hsfs_csv
hsfs_csu:
	@make -C$(BACK) hsfs_csu
hsfs_csw:
	@make -C$(BACK) hsfs_csw
hsfs_csx:
	@make -C$(BACK) hsfs_csx
hsfs_csy:
	@make -C$(BACK) hsfs_csy
hsfs_csz:
	@make -C$(BACK) hsfs_csz
hsfs_chv:
	@make -C$(BACK) hsfs_chv
hsfs_chu:
	@make -C$(BACK) hsfs_chu
hsfs_chw:
	@make -C$(BACK) hsfs_chw
hsfs_chx:
	@make -C$(BACK) hsfs_chx
hsfs_chy:
	@make -C$(BACK) hsfs_chy
hsfs_chz:
	@make -C$(BACK) hsfs_chz

hsfs_clean:
	@make -C$(BACK) hsfs_clean

