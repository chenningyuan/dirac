# function definitions
def get_original_molfile_content(orig_mol_file, orig_mol_file_lines):

    mol_file_strip     = string.replace(orig_mol_file,  '.mol', '')
    mol_file_strip     = string.replace(mol_file_strip, '.xyz', '')
    molecule_file_full = mol_file_strip + '.mol'
    if os.path.isfile(molecule_file_full):
        mol_file_lines = []
        f = open(molecule_file_full, 'r')
        for line in f.readlines():
            mol_file_lines.append(line.strip('\n'))
        f.close()
    else:
        print 'molecular input file for the full system %s does not exist, please check your input'\
             % molecule_file_full
        sys.exit()
    return mol_file_lines

def check_original_molfile_content_and_get_num_fragments(mol_file_lines, num_fragments):

    if mol_file_lines[3].split()[0] != 'C':
        print ' *** error in reading the molecular basis set input: the file has a wrong format. ***'
        print '     please consult the Dirac-Wiki (http://wiki.chem.vu.nl/dirac/index.php/Manual:Basis:MOL) for more help.'
        print '     the first character in line 4 is %s rather than C'\
                    % mol_file_lines[3].split()[0]
        sys.exit()
    num_fragments = int(mol_file_lines[3].split()[1])
    return num_fragments

