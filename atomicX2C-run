# x2c fragment input
class x2c_fragment_dirac_input(object):
    """
    class for fragment-x2c dirac input
    """

    def __init__ (self):
        pass

    def set_dirac_init_section(self) :
        text  = "**DIRAC\n"
        return text

    def set_dirac_title_section(self) :
        text  = ".TITLE\n"
        text += " automatized fragment x2c run.\n"
        return text

    def set_dirac_integral_section(self) :
        text  = "**INTEGRALS\n"
        text += "*READIN\n"
        text += ".UNCONTRACT\n"
        return text

    def set_dirac_hamiltonian_section(self) :
        text  = "**HAMILTONIAN\n"
        text += ".X2C\n"
        text += ".NOAMFI\n"
        return text

    def set_dirac_x2c_section(self) :
        text  = "*X2C\n"
        text += ".FGMx2c\n"
        return text

    def set_dirac_wavefunction_section(self) :
        text  = "**WAVE FUNCTIONS\n"
        text += "*DHFCAL\n"
        text += ".FOCC\n"
        return text

    def set_dirac_end_section(self) :
        text  = "**END OF\n"
        return text

    def assemble_dirac_fragment_input(self) :
        dirac_fragment_input  = self.set_dirac_init_section()
        dirac_fragment_input += self.set_dirac_title_section()
        dirac_fragment_input += self.set_dirac_integral_section()
        dirac_fragment_input += self.set_dirac_hamiltonian_section()
        dirac_fragment_input += self.set_dirac_x2c_section()
        dirac_fragment_input += self.set_dirac_wavefunction_section()
        dirac_fragment_input += self.set_dirac_end_section()

        print "start of generated input file"
        print dirac_fragment_input,
        print "end of generated input file"
        return dirac_fragment_input

