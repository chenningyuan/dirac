# set useful pam flags in case user has none provided

pam_flags_tmp  = options.pam_argument_list
pam_flags      = ''

if pam_flags_tmp == None:
    if not options.being_verbose:
        pam_flags += '--nobackup --silent '
    else:
        pam_flags += '--nobackup '
else:
    pam_flags += pam_flags_tmp

