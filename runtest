class run:
     def __init__(self, test, line, kind):
         self.test = test
         self.inp  = line.split()[0]
         self.mol  = line.split()[1]
         self.kind = kind
         pam_flags = ''
         if len(line.split()) > 2:
             for i in range(2, len(line.split())):
                 pam_flags += line.split()[i] + ' '
         if not options.verbose:
             pam_flags += '--silent '
         pam_flags += '--nobackup '
         pam_flags += '--noarch '
         if options.mpi > 1:
             pam_flags += '--mpi=%i ' % options.mpi
         self.pam_flags = pam_flags
     def get_output_name(self):
         inp_file_strip = string.replace(self.inp,       '.inp', '')
         mol_file_strip = string.replace(self.mol,       '.mol', '')
         mol_file_strip = string.replace(mol_file_strip, '.xyz', '')
         return '%s_%s.out' % (inp_file_strip, mol_file_strip)
     def get_test_name(self):
         return string.split(self.test, '/')[-1]
     def run_and_normal_exit(self):
         os.chdir(self.test)
         # run pam
         command = '%s/pam --inp=%s --mol=%s %s' \
             % (root_directory, self.inp, self.mol, self.pam_flags)
         p = subprocess.Popen(command,
                              shell=True,
                              stdin=subprocess.PIPE,
                              stdout=subprocess.PIPE)
         
         pam_output = p.communicate()[0]
         pam_output_file.write(pam_output) 
         # check whether DIRAC terminated normally
         if 'exit           : normal' in pam_output:
             return True
         else:
             return False
     def print_result(self, progress, result_text, elapsed, global_elapsed):
         """
          print result of the test
         """
         inp_file_strip = string.replace(self.inp,       '.inp', '')
         mol_file_strip = string.replace(self.mol,       '.mol', '')
         mol_file_strip = string.replace(mol_file_strip, '.xyz', '')

         global_elapsed_str=time.strftime('%Hh%Mm%Ss', time.gmtime(global_elapsed))
         elapsed_str=time.strftime('%Mm%Ss', time.gmtime(elapsed))

         print '%6s %5s %30s %30s %25s %s (%s)  %s' % \
             (progress, result_text, self.get_test_name(),        \
              inp_file_strip, mol_file_strip, elapsed_str, global_elapsed_str, self.kind)

     def apply_filter(self):
         # apply the filter on output; TODO: replace crep, bdrep
         os.system('../../utils/crep %s        result/filter > compare/%s.own' \
                   % (self.get_output_name(), self.get_output_name()))
         # apply the filter on reference output
         os.system('../../utils/crep result/%s result/filter > compare/%s.ref' \
                   % (self.get_output_name(), self.get_output_name()))
         # compare filtered result with reference
         os.system('../../utils/bdrep compare/%s.own compare/%s.ref > compare/%s.txt' \
                   % (self.get_output_name(), self.get_output_name(), self.get_output_name()))
         # generate individual html
         os.system('../../utils/drep compare/%s.own compare/%s.ref > compare/%s.htm' \
                   % (self.get_output_name(), self.get_output_name(), self.get_output_name()))
         # generate the one big html
         os.system('../../utils/hdrep compare/%s.own compare/%s.ref >> ../LOGS/runtest.htm' \
                   % (self.get_output_name(), self.get_output_name()))
     def is_shell_command(self):
         return False
     def is_run(self):
         return True

class shell_command:
     def __init__(self, test, line):
         self.test    = test
         self.command = line[2:]
     def execute(self):
         os.chdir(self.test)
         os.system(self.command)
     def is_shell_command(self):
         return True
     def is_run(self):
         return False

def use_this_line(current_section):
    if options.quick:
        if current_section == 'quick':
            return True
    elif options.benchmark:
        if current_section == 'benchmark':
            return True
    else:
        if current_section == 'quick':
            return True
        if current_section == 'regular':
            return True
    return False

def get_current_section(line, current_section):
    if line.split()[0] == 'quick':
        return 'quick'
    if line.split()[0] == 'regular':
        return 'regular'
    if line.split()[0] == 'benchmark':
        return 'benchmark'
    return current_section

def line_is_keyword(line):
    if line.split()[0] == 'sh':
        return True
    if line.split()[0] == 'quick':
        return True
    if line.split()[0] == 'regular':
        return True
    if line.split()[0] == 'benchmark':
        return True
    return False

# main function
def main(*args):

#  get list of tasks
    l = []
    for test in list_of_tests_to_run:
        os.chdir(test)
        file = 'menu'
        if os.path.isfile(file):
            f = open(file, 'r')
            current_section = 'regular'
            for line in f.readlines():
                if len(line.split()) > 0:
                    if line.split()[0] != '#':
                        current_section = get_current_section(line, current_section)
                        if use_this_line(current_section):
                            if line[0:2] == 'sh':
                                l.append(shell_command(test, line))
                            else:
                                if not line_is_keyword(line):
                                    l.append(run(test, line, current_section[0]))
            f.close()

    # get number of actual runs

    total_nr_of_tests = 0
    for task in l:
        if task.is_run():
            total_nr_of_tests += 1

    # print screen header

    print
    print '%12s %30s %30s %25s %7s' % ('result', 'test', 'inp', 'mol/xyz', 'time  (total)')
    print

    # run the tests

    nr_of_tests_done = 0
    nr_ok            = 0
    nr_crashed       = 0
    nr_failed        = 0
    nr_without_ref   = 0
    global_start = time.time()

    for task in l:
        if task.is_shell_command():
            task.execute()
        else:
            nr_of_tests_done += 1
            start = time.time()
            if task.run_and_normal_exit():
                if os.path.isfile('result/%s' % task.get_output_name()):
                    # overwrite reference files
                    if options.overwrite:
                        os.system('cp %s result/%s' % (task.get_output_name(), task.get_output_name()))
                
                    # create directory where outputs are compared
                    if not os.path.isdir('compare'):
                        os.mkdir('compare')
               
                    task.apply_filter() 
                
                    if os.path.getsize('compare/%s.txt' % task.get_output_name()) == 0:
                        result_text = 'OK'
                        nr_ok += 1
                    else:
                        result_text = 'FAIL'
                        nr_failed += 1
                else:
                    result_text = ' '
                    nr_without_ref += 1
            else:
                result_text = 'CRASH'
                nr_crashed += 1

            elapsed = (time.time() - start)
            global_elapsed = (time.time() - global_start)

            progress = '[%3i%s]' % (100.0*float(nr_of_tests_done)/float(total_nr_of_tests), r'%')
            task.print_result(progress, result_text, elapsed, global_elapsed) 
        
            if ((nr_crashed > 0) or (nr_failed > 0)) and options.giveup:
                #miro: wouldn't we have to have it red (ie in stderr stream) ?
                print
                print 'cowardly gave up after the first problem'
                print '(fix your code or remove --giveup to continue)'
                sys.exit(1)

            if (timegiveup_set):
                if (global_elapsed > timegiveup):  
                #miro: wouldn't we have to have it red (ie in stderr stream) ?
                    print ''
                    print 'Giving up. Time exceeded ! '
                    print ''
                    sys.exit(2)

    print
    print 'summary: %5i ok'                % nr_ok
    if nr_failed > 0:
         print '         %5i failed'            % nr_failed
    if nr_crashed > 0:
         print '         %5i crashed'           % nr_crashed
    if nr_without_ref > 0:
         print '         %5i without reference' % nr_without_ref
    print

    pam_output_file.close()

    # return code (for trac-bitten to get label of the failed test)
    if   nr_failed > 0 :
        return 2
    elif nr_crashed > 0:
        return 3
    else:
        return 0

# launch the main function
if __name__ == '__main__':
    sys.exit(main(*sys.argv))
