import os
import sys
import string
import subprocess
from optparse import OptionParser, OptionGroup

root_directory = os.path.realpath(__file__)[:-8]

# define example usage

usage = '''
  typically ./%prog --all [--mpi=4]
         or ./%prog --tests="some_test another_test"
         or ./%prog --tests=visual*'''

# initialize parser

parser = OptionParser(usage)

# define options

group = OptionGroup(parser, 'Select the test set')
group.add_option('--all',
                 action='store_true',
                 dest='all',
                 default=False,
                 help='run all tests [default: %default]')
group.add_option('--tests',
                 type='string',
                 action='store',
                 dest='individual',
                 default=None,
                 help='select individual test(s)',
                 metavar='\"test1 test2 anothertest\"')
group.add_option('--quick',
                 action='store_true',
                 dest='quick',
                 default=False,
                 help='run only a subset that is quick but has less coverage [default: %default]')
group.add_option('--benchmark',
                 action='store_true',
                 dest='benchmark',
                 default=False,
                 help='run only benchmark runs [default: %default]')
group.add_option('--keywords',
                 type='string',
                 action='store',
                 dest='keywords',
                 default=None,
                 help='select tests according to keywords (not programmed yet)',
                 metavar='\"dft response\"')
parser.add_option_group(group)

group = OptionGroup(parser, 'MPI parallelization')
group.add_option('--mpi',
                 type='int',
                 action='store',
                 dest='mpi',
                 default=0,
                 help='set number of cores [default: %default]',
                 metavar='INTEGER')
parser.add_option_group(group)

group = OptionGroup(parser, 'Development options')
group.add_option('--giveup',
                 action='store_true',
                 dest='giveup',
                 default=False,
                 help='give up after first failing test [default: %default]')
group.add_option('--overwrite',
                 action='store_true',
                 dest='overwrite',
                 default=False,
                 help='overwrite reference files [default: %default]')
group.add_option('--verbose',
                 action='store_true',
                 dest='verbose',
                 default=False,
                 help='verbose output [default: %default]')
parser.add_option_group(group)

# process input

(options, args) = parser.parse_args()

# user has given no arguments: print help and exit

if len(sys.argv) == 1:
    print parser.format_help().strip()
    sys.exit()

# get a list of tests to run according to input

list_of_tests_to_run = []

if options.all:
    file = root_directory + '/test/list_of_tests'
    if os.path.isfile(file):
        f = open(file, 'r')
        for line in f.readlines():
            list_of_tests_to_run.append(root_directory + '/test/' + line.strip('\n'))
        f.close()
    else:
        print 'file %s does not exist, run pamadm first' % file
        sys.exit()

if options.individual != None:
    s = options.individual.split()
    l = ''
    for w in s:
        l += root_directory + '/test/' + w + ' '
#   this complicated code is to allow --tests="foo* *bar* *oof"
    command = 'find %s -type d -maxdepth 0' % l
    p = subprocess.Popen(command,
                         shell=True,
                         stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE)
    for test in p.communicate()[0].split('\n'):
        if test != '':
            list_of_tests_to_run.append(test)

# write the html header

os.chdir(root_directory)
html_header = '''
<HTML>
<TITLE> Error report for DIRAC test runs </TITLE>
<BODY TEXT="#FFFFFF" BGCOLOR="#000000">
<PRE>
<H1>drep output by color</H1>

<p>The colors are determined using relative errors for numbers larger than 0.001,
and absolute errors otherwise.</p>
<p>Only those digits that actually differ are yellow or red, the others are white.</p>
<p>The coloring scheme used:</p>
1.23456789  white: difference can be neglected (less than 1e-12)
1.23456<FONT COLOR="#FFFF00">789</FONT> yellow: difference probably neglegible (less than 0.001)
1.2<FONT COLOR="#FF0000">3456789</FONT>    red: probably significant difference (more than 0.001)
<p> </p><hr><p> </p>'''

f = open('test/LOGS/report.htm', 'w')
f.write(html_header)
f.close()

#miro: do backup first ?
pam_output_file = open('test/LOGS/runtest.log','w', 0)
pam_output_file.write(" runtest pam outputs \n\n ") 

class run:
     def __init__(self, test, line):
         self.test = test
         self.inp  = line.split()[0]
         self.mol  = line.split()[1]
         pam_flags = ''
         if len(line.split()) > 2:
             for i in range(2, len(line.split())):
                 pam_flags += line.split()[i] + ' '
         if not options.verbose:
             pam_flags += '--silent '
         pam_flags += '--nobackup '
         pam_flags += '--noarch '
         if options.mpi > 1:
             pam_flags += '--mpi=%i ' % options.mpi
         self.pam_flags = pam_flags
     def get_output_name(self):
         inp_file_strip = string.replace(self.inp,       '.inp', '')
         mol_file_strip = string.replace(self.mol,       '.mol', '')
         mol_file_strip = string.replace(mol_file_strip, '.xyz', '')
         return '%s_%s.out' % (inp_file_strip, mol_file_strip)
     def get_test_name(self):
         return string.split(self.test, '/')[-1]
     def run_and_normal_exit(self):
         os.chdir(self.test)
         # run pam
         command = '%s/pam --inp=%s --mol=%s %s' \
             % (root_directory, self.inp, self.mol, self.pam_flags)
         p = subprocess.Popen(command,
                              shell=True,
                              stdin=subprocess.PIPE,
                              stdout=subprocess.PIPE)
         
         pam_output = p.communicate()[0]
         pam_output_file.write(pam_output) 
         # check whether DIRAC terminated normally
         if 'exit           : normal' in pam_output:
             return True
         else:
             return False
     def print_result(self, progress, result_text, into_stderr):
         """
          print result of the test, flush out stdout/stderr buffers
         """
         inp_file_strip = string.replace(self.inp,       '.inp', '')
         mol_file_strip = string.replace(self.mol,       '.mol', '')
         mol_file_strip = string.replace(mol_file_strip, '.xyz', '')
         if into_stderr:
             print >> sys.stderr,'%8s %6s %30s %30s %25s' % \
                 (progress, result_text, self.get_test_name(), inp_file_strip, mol_file_strip)
             sys.stderr.flush()
         else:
             print >> sys.stdout,'%8s %6s %30s %30s %25s' % \
                 (progress, result_text, self.get_test_name(), inp_file_strip, mol_file_strip)
             sys.stdout.flush()

     def apply_filter(self):
         # apply the filter on output; TODO: replace crep, bdrep
         os.system('../../utils/crep %s        result/filter > compare/%s.own' \
                   % (self.get_output_name(), self.get_output_name()))
         # apply the filter on reference output
         os.system('../../utils/crep result/%s result/filter > compare/%s.ref' \
                   % (self.get_output_name(), self.get_output_name()))
         # compare filtered result with reference
         os.system('../../utils/bdrep compare/%s.own compare/%s.ref > compare/%s.txt' \
                   % (self.get_output_name(), self.get_output_name(), self.get_output_name()))
         # generate individual html
         os.system('../../utils/drep compare/%s.own compare/%s.ref > compare/%s.htm' \
                   % (self.get_output_name(), self.get_output_name(), self.get_output_name()))
         # generate the one big html
         os.system('../../utils/hdrep compare/%s.own compare/%s.ref >> ../../report.htm' \
                   % (self.get_output_name(), self.get_output_name()))
     def is_shell_command(self):
         return False
     def is_run(self):
         return True

class shell_command:
     def __init__(self, test, line):
         self.test    = test
         self.command = line[2:]
     def execute(self):
         os.chdir(self.test)
         os.system(self.command)
     def is_shell_command(self):
         return True
     def is_run(self):
         return False

def use_this_line(current_section):
    if options.quick:
        if current_section == 'quick':
            return True
    elif options.benchmark:
        if current_section == 'benchmark':
            return True
    else:
        if current_section == 'quick':
            return True
        if current_section == 'regular':
            return True
    return False

def get_current_section(line, current_section):
    if line.split()[0] == 'quick':
        return 'quick'
    if line.split()[0] == 'regular':
        return 'regular'
    if line.split()[0] == 'benchmark':
        return 'benchmark'
    return current_section

def line_is_keyword(line):
    if line.split()[0] == 'sh':
        return True
    if line.split()[0] == 'quick':
        return True
    if line.split()[0] == 'regular':
        return True
    if line.split()[0] == 'benchmark':
        return True
    return False

# main function
def main(*args):

#  get list of tasks
    l = []
    for test in list_of_tests_to_run:
        os.chdir(test)
        file = 'menu'
        if os.path.isfile(file):
            f = open(file, 'r')
            current_section = 'regular'
            for line in f.readlines():
                if len(line.split()) > 0:
                    if line.split()[0] != '#':
                        current_section = get_current_section(line, current_section)
                        if use_this_line(current_section):
                            if line[0:2] == 'sh':
                                l.append(shell_command(test, line))
                            else:
                                if not line_is_keyword(line):
                                    l.append(run(test, line))
            f.close()

    # get number of actual runs

    total_nr_of_tests = 0
    for task in l:
        if task.is_run():
            total_nr_of_tests += 1

    # print screen header

    print
    print '%8s %6s %30s %30s %25s' % ('progress', 'result', 'test', 'inp', 'mol/xyz')
    print

    # run the tests

    nr_of_tests_done = 0
    nr_ok            = 0
    nr_crashed       = 0
    nr_failed        = 0
    nr_without_ref   = 0

    for task in l:
        if task.is_shell_command():
            task.execute()
        else:
            nr_of_tests_done += 1
            if task.run_and_normal_exit():
                if os.path.isfile('result/%s' % task.get_output_name()):
                    # overwrite reference files
                    if options.overwrite:
                        os.system('cp %s result/%s' % (task.get_output_name(), task.get_output_name()))
                
                    # create directory where outputs are compared
                    if not os.path.isdir('compare'):
                        os.mkdir('compare')
               
                    task.apply_filter() 
                
                    if os.path.getsize('compare/%s.txt' % task.get_output_name()) == 0:
                        result_text = 'OK'; into_stderr=False
                        nr_ok += 1
                    else:
                        result_text = 'FAIL'; into_stderr=True
                        nr_failed += 1
                else:
                    result_text = ' '
                    nr_without_ref += 1;  into_stderr=False
            else:
                result_text = 'CRASH';  into_stderr=True
                nr_crashed += 1

            progress = '[%3i%s]' % (100.0*float(nr_of_tests_done)/float(total_nr_of_tests), r'%')
            task.print_result(progress, result_text, into_stderr) 
        
            if ((nr_crashed > 0) or (nr_failed > 0)) and options.giveup:
                print
                print 'cowardly gave up after the first problem'
                print '(fix your code or remove --giveup to continue)'
                sys.exit(1)

    print
    print 'summary: %5i ok'                % nr_ok
    if nr_failed > 0:
         print >> sys.stderr,'         %5i failed'            % nr_failed
    else:
         print >> sys.stdout,'         %5i failed'            % nr_failed
    if nr_crashed > 0:
         print >> sys.stderr,'         %5i crashed'           % nr_crashed
    else:
         print >> sys.stdout,'         %5i crashed'           % nr_crashed
    print '         %5i without reference' % nr_without_ref
    print
    sys.stdout.flush(); sys.stderr.flush()
    pam_output_file.close()

    # return code (for trac-bitten to get label of the failed buildup)
    if   nr_failed > 0 :
        return 2
    elif nr_crashed > 0:
        return 3
    else:
        return 0

# launch the main function
if __name__ == '__main__':
    sys.exit(main(*sys.argv))

