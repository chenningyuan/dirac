MODULE RECP_ONEINT_CSO

  IMPLICIT NONE

CONTAINS

SUBROUTINE RECP_ONEINT_CSO_BESSEL
! From qbess in argos_ecpint.F 

! compute type 2 radial integrals, scaled by exp(-arc2)/sqrt(pi),
! using the bessel function formula for
! lama=max(l,nu) to lmahi, lamb=max(l,nu) to lmbhi, n=lama+lamb-l-l

  IMPLICIT NONE

! variables : global
! variables : local
  INTEGER  :: I

      num1=nu-1
      lmaphi=lmahi-num1
      lmbphi=lmbhi-num1
      fcta=rka/(alpha+alpha)
      fct=rka*fcta
      fctb=rkb/(alpha+alpha)
      bpref(1)=fctb**num1

  do lambp=2,lmbphi
    bpref(lambp)=fctb*bpref(lambp-1)
  enddo
  apwr(1)=1.0d0
  apwr(2)=fct
  do lambp=3,lmbphi
    apwr(lambp)=fct*apwr(lambp-1)
  enddo
  fct=rkb*fctb
  bpwr(1)=1.0d0
  bpwr(2)=fct
  do lamap=3,lmaphi
    bpwr(lamap)=fct*bpwr(lamap-1)
  enddo

  lmihi=lmaphi+lmbphi+(nu-2)

! scaled spherical i bessel functions
  call ssibfn(lmihi-1,rka*fctb,ssi)
  do I=1,lmihi
    ssi(I)=ssi(I)/dfac(I+I-1)
  enddo

      lmplo=max(l,nu)-num1
      fctra=(alpha+alpha)**(nu-2)*fcta**(max(l,nu)-1)*prd/sqrt(4.0d0*alpha)*
     &  ((dfac(2*(2*lmplo+num1)-1)/dfac(2*(lmplo+num1)+1))*
     &  dfac(2*num1+1))/dfac(2*(lmplo+num1)+1)
      fctran=(2*(2*lmplo+num1)-1)
      fctrad=(2*(lmplo+num1)+1)


     do lamap=lmplo,lmaphi
        fctru=1.0d0
        fctrun=(nu+num1)
        fctrud=(2*(lamap+num1)+1)
        do iu=1,lmbphi
           aterm1(iu)=fctru*apwr(iu)
           fctru=fctru*fctrun/fctrud
           fctrun=fctrun+2.0d0
           fctrud=fctrud+2.0d0
        enddo
        do it=1,lamap
           bterm1(it)=binom((lamap*(lamap-1))/2+it)*bpwr(it)
        enddo
        fctrb=fctra
        fctrbn=(2*(lamap+lmplo+num1)-1)
        fctrbd=(2*(lmplo+num1)+1)
        do lambp=lmplo,lmbphi
           n=((2*(nu-l)-1)+lamap)+lambp
           do iu=1,lambp
              aterm2(iu)=binom((lambp*(lambp-1))/2+iu)*aterm1(iu)
           enddo
           sum=0.0d0
           fctrt=1.0d0
           fctrtn=(nu+num1)
           fctrtd=(2*(lambp+num1)+1)
           do it=1,lamap
              do iu=1,lambp
                 sum=sum+aterm2(iu)*(fctrt*bterm1(it))* ssi((it+(nu-2))+iu)
              enddo
              fctrt=fctrt*fctrtn/fctrtd
              fctrtn=fctrtn+2.0d0
              fctrtd=fctrtd+2.0d0
           enddo
           qsum(n,lambp+num1,lamap+num1) = qsum(n,lambp+num1,lamap+num1) + fctrb*bpref(lambp)*sum
           fctrb=fctrb*fctrbn/fctrbd
           fctrbn=fctrbn+2.0d0
           fctrbd=fctrbd+2.0d0
        enddo
        fctra=fcta*fctra*fctran/fctrad
        fctran=fctran+2.0d0
        fctrad=fctrad+2.0d0
     enddo

END SUBROUTINE RECP_ONEINT_CSO_BESSEL

END MODULE RECP_ONEINT_CSO
