# This is a generic makefile, please see Makefile.config for compilation settings.
# Files matching lines in the file dontbuild will not be compiled, while files
# listed in safebuild will be built with "safe" flags.
# This files might require GNU make

include Makefile.config

TARGET=$(INSTALL_DIR)/dirac.x
SOURCE_DIRS=.

$(TARGET):

depend:
	@echo Forcing a rebuild of Makefile.obj and Makefile.dep
	@rm Makefile.obj
	@rm Makefile.dep
# Make empty old files that can be included but will trigger a remake
# This is needed because some make versions stop if an include file is
# not found.
	@touch -t 198001010000 Makefile.obj
	@touch -t 198001010000 Makefile.dep
	$(MAKE) Makefile.dep

# Make a list of objects to build, and exceptions for files that need
# different compilation options ("safe" flags)
# It is a bit messy because we repeat the same code for .F .f90 .F90 .c
Makefile.obj: safebuild dontbuild
	@echo "Collecting source files for build into Makefile.obj"
	@echo "#Automatically generated file, do not edit" > $@
	@echo "OBJ=\\" >> $@
	@(find $(SOURCE_DIRS) -name '*.F' -o -name '*.F90' -o -name '*.f90' -o -name '*.c' \
	| egrep -v -f dontbuild|sed 's/\.[cfF90]*$$/.o \\/g' >> $@)
	@echo >> $@
# safe .F files
# The true command is needed on certain systems (AIX on Jump) where the
# exit code of the whole for statement is the same as that of grep.
	@(for f in `grep '\.F$$' safebuild; true`; do \
	echo "`echo $$f | sed 's/.F$$/.o/'`: $$f" >> $@;  \
	echo '	$$(F77) $$(F77FLAGS_SAFE) -c -o $$*.o $$<'>> $@; \
	done)
# safe .c files
	@(for f in `grep '\.c$$' safebuild; true`; do \
	echo "`echo $$f | sed 's/.c$$/.o/'`: $$f" >> $@;  \
	echo '	$$(CC) $$(CFLAGS_SAFE) -c -o $$*.o $$<'>> $@; \
	done)
# safe .F90 files
	@(for f in `grep '\.F90$$' safebuild; true`; do \
	echo  "`echo $$f | sed 's/.F90$$/.o/'`: $$f" >> $@;  \
	echo '	$$(F90) $$(F90FLAGS_SAFE) -c -o $$*.o $$<'>> $@; \
	done)
# safe .f90 files
	@(for f in `grep '\.f90$$' safebuild; true`; do \
	echo "`echo $$f | sed 's/.f90$$/.o/'`: $$f" >> $@;  \
	echo '	$$(F90) $$(F90FLAGS_SAFE) -c -o $$*.o $$<'>> $@; \
	done)

Makefile.dep: Makefile.obj Makefile.moddef
	@echo "Collecting dependencies into Makefile.dep"
	@echo "# This file is automatically generated, do not edit" > $@
# Not printing errors from mkdep.py since it warns spuriously about mpif.h
# You will find out at compile time anyway.
	@find $(SOURCE_DIRS) -name '*.F' -o -name '*.F90' -o -name '*.f90' \
	| egrep -v -f dontbuild | ./utils/mkdep.py $(DEPFPP) >> $@ 2>/dev/null
	@find $(SOURCE_DIRS) -name '*.c' \
	| egrep -v -f dontbuild | ./utils/mkdep.py $(DEPCPP) >> $@ 2>/dev/null
# Add extra dependency for gpc.c on fortran_interface.h, since this file will not 
# exist when we generate dependencies.
	echo "gp/gpc.o: include/fortran_interface.h" >> Makefile.dep


dontbuild:dontbuild.in
	@echo "The file 'dontbuild.in' is newer than 'dontbuild'. Run pamadm to correct this."; false

.PHONY:gp/compinfo.h
gp/compinfo.h:
	@echo "#define WHO_COMPILED \"${LOGNAME}\"" > $@
	@echo "#define WHERE_COMPILED \"${HOSTNAME}\"" >> $@
	@echo "#define ILP_DATA_MODEL \"${ILP_DATATYPE}\"" >> $@
	@echo "#define FCOMP \"${F77} ${F77FLAGS}\"" >> $@
	@echo "#define CCOMP \"${CC} ${CFLAGS}\"" >> $@
	@echo "#define LIBRARIES \"${LIBS}\"" >> $@
	@echo "#define VERSION \"${DIRAC_SNAP}\"" >> $@

gp/gpc.o: gp/compinfo.h

build/gen_fortran_interface_h: build/gen_fortran_interface_h.c
	$(CC) $(CFLAGS) -o build/gen_fortran_interface_h $<

include/fortran_interface.h: build/gen_fortran_interface_h
	./build/gen_fortran_interface_h > include/fortran_interface.h

include Makefile.obj
include Makefile.dep

$(TARGET): $(OBJ)
	$(LD) $(LDFLAGS) -o $@ $(OBJ) $(LIBS)
	@echo -e "\nExecutable $(TARGET) is ready."

clean:
	rm -f `find . -name '*.o' -o -name '*.mod' -o -name '*~' -o -name '*.gc*'`

# miro: deactivated ...
#ftnchek:  
#	ftnchek $(CHEKFLAGS) $(TARGET) $(CPPFLAGS)

# ... for the compilation of the (optional) standalone HSMRCC code
is_hscc := $(wildcard hsmrcc/hsmrcc_external/Makefile.hsmrcc)
ifneq ($(strip $(is_hscc)),)
include hsmrcc/hsmrcc_external/Makefile.hsmrcc
else
hs: # for compilation of the standalone external code
	@echo "The hsmrcc/hsmrcc_external/Makefile.hsmrcc file does not exist."
	@echo "The hsmrcc_external code is not active (exported)."
endif

gcov:
	find . -name '*.o' | xargs -iobj -n1 gcov -b -o obj obj

# Main target here is utils, which buils all utilities and
# puts them in $(INSTALL_DIR/bin)
include utils/Makefile.utils

##########################################################################                    
#
#                    Implicit rules 
#  
#  for extra compilation with safe-flags, index-range-check + other checks flags,
#  
#  TODO: add ftnchek for F77 files
#
##########################################################################                    

.SUFFIXES :
.SUFFIXES : .F .F90 .f90 .c .s .r .o

.F.o:
	$(F77) $(F77FLAGS) -c -o $*.o $*.F
.F.s:
	@echo "Compiling with Fortran safe flags:"
	$(F77) $(F77FLAGS_SAFE) -c -o $*.o $*.F
.F.r:
	@echo "Compiling with Fortran safe & checking flags:"
	$(F77) $(FFLAGS_CHECK) $(F77FLAGS_SAFE) -c -o $*.o $*.F
.F90.o:
	$(F90) $(F90FLAGS) -c -o $*.o $*.F90
.F90.s:
	@echo "Compiling with Fortran safe flags:"
	$(F90) $(F90FLAGS_SAFE) -c -o $*.o $*.F90
.F90.r:
	@echo "Compiling with Fortran safe & other checking flags:"
	$(F90) $(FFLAGS_CHECK) $(F90FLAGS_SAFE) -c -o $*.o $*.F90
.f90.o:
	$(F90) $(F90FLAGS) -c -o $*.o $*.f90
.f90.s:
	@echo "Compiling with Fortran safe flags:"
	$(F90) $(F90FLAGS_SAFE) -c -o $*.o $*.f90
.f90.r:
	@echo "Compiling with Fortran safe & other checking flags:"
	$(F90) $(FFLAGS_CHECK) $(F90FLAGS_SAFE) -c -o $*.o $*.f90
.c.o:
	$(CC) $(CFLAGS) -c -o $*.o $*.c
.c.s:
	@echo "Compiling with C safe flags:"
	$(CC) $(CFLAGS_SAFE) -c -o $*.o $*.c
.c.r:
	@echo "Compiling with C safe & other checking flags:"
	$(CC) $(CFLAGS_CHECK) $(CFLAGS_SAFE) -c -o $*.o $*.c

