# This is a generic makefile, please see Makefile.config for compilation settings.
# Files matching lines in the file dontbuild will not be compiled, while files
# listed in safebuild will be built with "safe" flags.
# This files might require GNU make
#
#TODO: replace all linux commands with system independent python equivalents


include build/Makefile.moddef
include Makefile.config

TARGET=$(INSTALL_DIR)/dirac.x

$(TARGET):

Makefile.config:configure
	@echo
	@echo "Configure is newer than Makefile.config, please rerun configure"
	@echo "Run 'touch Makefile.config' to compile anyway"
	@echo
	false

depend: gp/compinfo.h include/fortran_interface.h
	@echo Forcing a rebuild of Makefile.obj and Makefile.dep
	@rm -f Makefile.obj
	@rm -f Makefile.dep
# Make empty old files that can be included but will trigger a remake
# This is needed because some make versions stop if an include file is
# not found.
	@touch -t 198001010000 build/Makefile.obj
	@touch -t 198001010000 build/Makefile.dep
	$(MAKE) build/Makefile.dep

# Make a list of objects to build, and exceptions for files that need
# different compilation options ("safe" flags)
# It is a bit messy because we repeat the same code for .F .f90 .F90 .c
build/Makefile.obj: build/safebuild build/dontbuild
	@echo "Collecting all source files for build into :  build/Makefile.obj"
	@echo "#Automatically generated file, do not edit" > $@
	@echo "OBJ=\\" >> $@
	@(find . -name '*.cpp' -o -name '*.F' -o -name '*.F90' -o -name '*.f90' -o -name '*.c' \
	| egrep -v -f build/dontbuild|sed 's/\.[cfF90p]*$$/.o \\/g' >> $@)
	@echo >> $@
# safe .F files
# The true command is needed on certain systems (AIX on Jump) where the
# exit code of the whole for statement is the same as that of grep.
	@(for f in `grep '\.F$$' build/safebuild; true`; do \
	echo "`echo $$f | sed 's/.F$$/.o/'`: $$f" >> $@;  \
	echo '	$$(F77) $$(F77FLAGS_SAFE) -c -o $$*.o $$<'>> $@; \
	done)
# safe .c files
	@(for f in `grep '\.c$$' build/safebuild; true`; do \
	echo "`echo $$f | sed 's/.c$$/.o/'`: $$f" >> $@;  \
	echo '	$$(CC) $$(CFLAGS_SAFE) -c -o $$*.o $$<'>> $@; \
	done)
# safe .F90 files
	@(for f in `grep '\.F90$$' build/safebuild; true`; do \
	echo  "`echo $$f | sed 's/.F90$$/.o/'`: $$f" >> $@;  \
	echo '	$$(F90) $$(F90FLAGS_SAFE) -c -o $$*.o $$<'>> $@; \
	done)
# safe .f90 files
	@(for f in `grep '\.f90$$' build/safebuild; true`; do \
	echo "`echo $$f | sed 's/.f90$$/.o/'`: $$f" >> $@;  \
	echo '	$$(F90) $$(F90FLAGS_SAFE) -c -o $$*.o $$<'>> $@; \
	done)

build/Makefile.dep: build/Makefile.obj build/Makefile.moddef
	@echo "Collecting all DIRAC interfile dependencies into :  build/Makefile.dep"
	@echo "# This file is automatically generated, do not edit" > $@
# Filter out warnings about mpi header files below
	@find . -name '*.F' -o -name '*.F90' -o -name '*.f90' \
	| egrep -v -f build/dontbuild | ./utils/mkdep.py $(DEPFPP) \
	2>&1 >> $@  | egrep -v "mpi[f]*\.h"; true
	@find . -name '*.c' -o -name '*.cpp'\
	| egrep -v -f build/dontbuild | ./utils/mkdep.py $(DEPCPP) \
	2>&1 >> $@ | egrep -v "mpi[f]*\.h"; true
# Add extra dependency for gpc.c on fortran_interface.h, since
# this file will not exist when we generate dependencies.
	@echo "gp/gpc.o: include/fortran_interface.h" >> build/Makefile.dep
	@echo "gp/gpc.s: include/fortran_interface.h" >> build/Makefile.dep
	@echo "gp/gpc.r: include/fortran_interface.h" >> build/Makefile.dep
	@echo "gp/gpc.p: include/fortran_interface.h" >> build/Makefile.dep

.PHONY:gp/compinfo.h
gp/compinfo.h:
	@echo "#define WHO_COMPILED \"${LOGNAME}\"" > $@
#	@echo "#define WHERE_COMPILED \"${HOSTNAME}\"" >> $@
	@echo "#define WHERE_COMPILED \"`hostname -f`\"" >> $@
	@echo "#define COMPILED_DIRAC_DIR \"${PWD}\"" >> $@
	@echo "#define ILP_DATA_MODEL \"${ILP_DATATYPE}\"" >> $@
	@echo "#define FCOMP \"${F77} ${F77FLAGS}\"" >> $@
	@echo "#define CCOMP \"${CC} ${CFLAGS}\"" >> $@
	@echo "#define LIBRARIES \"${LIBS}\"" >> $@
	@echo "#define DIRAC_BLAS \"${USED_DIRAC_BLAS}\"" >> $@
	@echo "#define DIRAC_LAPACK \"${USED_DIRAC_LAPACK}\"" >> $@
	@echo "#define DIRAC_SVN_URL \"${DIRAC_SVN_URL}\"" >> $@
	@echo "#define DIRAC_SVN_REVISION \"${DIRAC_SVN_REVISION}\"" >> $@

gp/gpc.o: gp/compinfo.h

build/gen_fortran_interface_h: build/gen_fortran_interface_h.c
	$(CC) $(CFLAGS) -o build/gen_fortran_interface_h $<

include/fortran_interface.h: build/gen_fortran_interface_h
	./build/gen_fortran_interface_h > include/fortran_interface.h

include build/Makefile.obj
include build/Makefile.dep
include build/Makefile.extobj
include build/Makefile.lib

$(TARGET): $(OBJ) $(EXT_OBJ)
	$(LD) $(LDFLAGS) -o $@ $(OBJ) $(EXT_OBJ) $(LIBS)
	@echo
	@echo "Executable $(TARGET) is ready."

clean:
	@echo "Cleaning the entire DIRAC (recursively) of *.o,*.mod,... files"
	rm -f `find . -name '*.o' -o -name '*.mod' -o -name '*~' -o -name '*.gcov' -o -name '*.s' -o -name '*.r' -o -name '*.i' -o -name '*.fc'  -o -name '*.p' | grep -v '\.svn'`

# Main target here is utils, which builds all utilities and
# puts them in $(INSTALL_DIR/bin)
include utils/Makefile.utils

.SUFFIXES :
.SUFFIXES : .F .F90 .f90 .c .cpp .s .r .o .i .fc .p .opt

.F.o:
	$(F77) $(F77FLAGS) -c -o $*.o $*.F

.F90.o:
	$(F90) $(F90FLAGS) -c -o $*.o $*.F90

.f90.o:
	$(F90) $(F90FLAGS) -c -o $*.o $*.f90

.c.o:
	$(CC) $(CFLAGS) -c -o $*.o $*.c

.cpp.o:
	$(CC) $(CFLAGS) -c -o $*.o $*.cpp

# Include rules for targets that are mainly used for developers 
# (like safe-flags, flags for profiling etc).
# This include can be omitted in case you use a non-gnu make.
include build/Makefile.extra

