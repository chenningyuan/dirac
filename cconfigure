#! /bin/bash

echo 
echo '   You are not running autoconf/automake tools!'
echo '   DIRAC is built using cmake'
echo '   check http://wiki.chem.vu.nl/dirac/'
echo 

tcmake=`which cmake`
if test $tcmake; then
   cd cbuild; cmake ..
   echo
   echo '   to compile DIRAC with modified parameters:'
   echo '   $ cd cbuild'
   echo '   $ ccmake ..'
   echo '   $ make'
   echo
   echo '   to compile DIRAC with default parameters:'
   echo '   $ cd cbuild'
   echo '   $ make'
else       
   echo    
   echo '   cmake is not found'
   echo '   get cmake at http://www.cmake.org/'
fi

exit 0
