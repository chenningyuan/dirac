#
# VERSION : $Revision$
# DATE    : $Date$
# FILE    : Makefile.in
# SOURCE  : $Source$
#

include ../Makefile.config

F77_OBJS =  gphjj.o    gpjeppe.o     gptrygve.o     mempkg.o \
	    qpack.o    vcraypack.o   gpsaue.o       gpluuk.o \
	    gpjth.o    gplucia.o     gpkrmc.o       gpbast.o \
	    gplupar.o  global_file.o   mpi2macro.o

F90_OBJS = osutils.o

F90_MODS = os_utils.mod

C_OBJS = gpc.o

MXM_OBJS = mxmpack.o

F77_CPPS = $(F77_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek: pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	setcomp $(F77_OBJS) $(F90_OBJS) $(C_OBJS)

setcomp:
	( \
	   rm -f gpc.o; \
	   rm -f compinfo.h ; \
	   echo "#define WHO_COMPILED \"${LOGNAME}\"" > compinfo.h ; \
	   echo "#define WHERE_COMPILED \"${HOST}\"" >> compinfo.h ; \
           echo "#define FCOMP \"${F77} ${OPTFLAGS}\"" >> compinfo.h ; \
           echo "#define CCOMP \"${CC} ${C_OPTFLAGS}\"" >> compinfo.h ; \
	)

mxm:	$(MXM_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i

mod: $(F90_MODS)

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x


depend: setcomp
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90) $(C_OBJS:.o=.c)

f90dep: ;\
       ../utils/sfmakedepend.pl -I $(SOURCEDIR)/include -M $(SOURCEDIR)/modules $(F90_OBJS:.o=.F90) $(F90_OBJS:.o=.F) $(F77_OBJS:.o=.F)
 
# DO NOT DELETE THIS LINE -- make depend depends on it.

