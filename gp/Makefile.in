#
# VERSION : $Revision$
# DATE    : $Date$
# FILE    : Makefile.in
# SOURCE  : $Source$
#

include ../Makefile.config

OBJS =  gphjj.o    gpjeppe.o     gptrygve.o     mempkg.o \
	qpack.o    vcraypack.o   gpsaue.o       gpluuk.o \
	gpjth.o

C_OBJS = gpjth_c.o

MXM_OBJS = mxmpack.o

all:	setcomp $(OBJS) $(C_OBJS)

setcomp:
	( \
	   rm -f gpjth_c.o; \
	   cd include ; \
	   rm -f compinfo.h ; \
	   echo "#define WHO_COMPILED \"${LOGNAME}\"" > compinfo.h ; \
	   echo "#define WHERE_COMPILED \"`hostname`\"" >> compinfo.h ; \
	)

mxm:	$(MXM_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i


dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(OBJS:.o=.F) $(C_OBJS:.o=.c)
# DO NOT DELETE THIS LINE -- make depend depends on it.

