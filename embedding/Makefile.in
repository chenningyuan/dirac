include ../Makefile.config

F77_OBJS =

F90_OBJS = embedding.o emb_settings.o emb_frozen_orbitals.o

F90_MODS = emb_settings.mod  emb_frozen_orbitals.mod  embedding.mod

F_CPPS = $(F77_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F77_OBJS) $(F90_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod
	$(RM) -f ../modules/*.mod

mod : $(F90_MODS)

emb_settings.mod: emb_settings.F90 ;\
$(F77) $(DEPEND_FLAGS) $(MODS) -c emb_settings.F90  ;\
ln -sf $(PWD)/emb_settings.mod ../modules/.

emb_frozen_orbitals.mod: emb_frozen_orbitals.F90 ;\
$(F77) $(DEPEND_FLAGS) $(MODS) -c emb_frozen_orbitals.F90 ;\
ln -sf $(PWD)/emb_frozen_orbitals.mod  ../modules/.

embedding.mod: emb_frozen_orbitals.F90 emb_settings.F90 embedding.F90 ;\
$(F77) $(DEPEND_FLAGS) $(MODS) -c embedding.F90 ;\
ln -sf $(PWD)/embedding.mod  ../modules/.

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90)

embedding.o: emb_frozen_orbitals.o emb_settings.o
 
# DO NOT DELETE

