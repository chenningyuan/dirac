# VERSION : $Revision$
# DATE    : $Date$
# FILE    : moltra/Makefile.in
#

include ../Makefile.config

F77_OBJS =  trainp.o trapam.o tradr1.o tradr2.o tradr3.o traone.o \
            traout.o traprp.o tradr4.o tradr5.o tradr6.o

C_OBJS   =

F90_OBJS =

F90_MODS =

F77_CPPS = $(F77_OBJS:.o=.i)

ftnchek: $(F77_CPPS)
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F77_OBJS) $(F90_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod  ;\
        $(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)
##
##  compile Fortran90 module source files and make symbolic links
## of resulting *.mod files into common linked directory modules
##
mod:
	$(MAKE) f90dep  # create list of which file to compile to get the .mod files
	$(MAKE) module_files

module_files: $(F90_MODS)

FLAGS=$(DEPEND_FLAGS) $(MODS) $(OPTFLAGS)

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJ:.o=.F90)

f90dep: ;\
       ../utils/sfmakedepend.pl -I $(SOURCEDIR)/include -M $(SOURCEDIR)/modules $(F90_OBJS:.o=.F90) $(F90_OBJS:.o=.F) $(F77_OBJS:.o=.F)
 
# DO NOT DELETE THIS LINE -- make depend depends on it.

