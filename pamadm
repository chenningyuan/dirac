#! /bin/csh -f
#
# VERSION : $Revision$
# DATE    : $Date$
# FILE    : pamadm
# SOURCE  : $Source$
#
#
#   $Id$
#
#   Master script for administrator of DIRAC
#   Written by Trond Saue Oct 1 1997
#   Polish by Thomas Enevoldsen Oct 2 1997
#
if ($#argv == 0) then
      echo 'Usage: pamadm [flags] tarfile'
      echo '   Flags:'
      echo '     -adm          : Include ALL modules (administrator)'
      echo '     -eri          : Include ERI integral routines'
      echo '     -par          : include parallell version'
      echo '     -rsp          : Include response module'
      echo '     -cc           : Include CCSD module'
      echo '     -tra          : Include 4-index transformation module'
      echo '     -open         : Include open shell module'
      echo '     tarfile=make  : only generate new Makefile'
      exit 0
endif
unset noclobber
unalias rm
set GENTAR = 1
set PAMADM = 0
#
# Initialization of active modules
#
# Parallell version
set PARMOD  = 0
set PARTAR  = 0
set PARFLG  =
set PAROBJ  =
set PARMAK  =
# RELCCSD-module (MOLFDIR)
set CCMOD  = 0
set CCTAR  = 0
set CCFLG  =
set CCOBJ  =
set CCMAK  =
# Response module
set RSPMOD = 0
set RSPTAR = 0
set RSPFLG = 
set RSPOBJ =
set RSPMAK =
# 4-index transformation module
set TRAMOD = 0
set TRATAR = 0
set TRAFLG =
set TRAOBJ =
set TRAMAK =
# ERI integral module
set ERIMOD = 0
set ERITAR = 0
set ERIFLG =
set ERIOBJ =
set ERIMAK =
# Open shell module
set OPENMOD = 0
set OPENTAR = 0
set OPENFLG =
set OPENOBJ =
set OPENMAK =
#
while($#argv)
   switch($argv[1])
     case -adm:
        set PAMADM = 1
     case -cc:
        set CCMOD = 1
        breaksw
     case -par:
        set PARMOD = 1
        set PARTAR = 1
        breaksw
     case -rsp:
        set RSPMOD = 1
        breaksw
     case -tra:
        set TRAMOD = 1
        breaksw
     case -eri:
#        set ERIMOD = 1
        set ERIMOD = 0
        breaksw
     case -*:
        echo $argv[1] 'not recognized'
        exit 1
        breaksw
     case  *:
        set TARFIL = $argv[1]
        breaksw
   endsw
   shift
end
#
if ($TARFIL == 'make') then
  set GENTAR = 0
endif
#
#  Administrator needs everything.....
#
if($PAMADM) then
  set CCMOD  = 1
  set RSPMOD = 1
  set TRAMOD = 1
  set ERITAR = 1
  set PARMOD = 1
  set PARTAR = 1
  set OPENMOD = 1
endif
#
#  RELCCSD-module
#
if($CCMOD) then
        set CCFLG = '-DMOD_CC'
        set CCOBJ = '$(CCOBJS)'
        set CCMAK = CCM_OBJ
        set CCTAR = 1
endif
#
#  Responsemodule
#
if($RSPMOD) then
        set RSPFLG = '-DMOD_RSP'
        set RSPOBJ = '$(RSPOBJS)'
        set RSPMAK = RSP_OBJ
        set RSPTAR = 1
endif
#
#  4index transformation module
#
if($TRAMOD) then
        set TRAFLG = '-DMOD_TRA'
        set TRAOBJ = '$(TRAOBJS)'
        set TRAMAK = TRA_OBJ
        set TRATAR = 1
endif
#
#  ERI two-electron integral module
#
if($ERIMOD) then
        set ERIFLG = '-DMOD_ERI'
        set ERIOBJ = '$(ERIOBJS)'
        set ERIMAK = ERI_OBJ
        set ERITAR = 1
endif
#
if($OPENMOD) then
        set OPENFLG = '-DMOD_OPEN'
        set OPENOBJ = '$(OPENOBJS)'
        set OPENMAK = OPEN_OBJ
        set OPENTAR = 1
endif
#
#  Safeguard files
#
if($GENTAR) then
  mv Makefile Makefile.buf
  mv DIRAC.new.tar.gz tarbuf.gz 
endif
#
#  Write active modules
#
echo "#\!/bin/sh" > configure
echo MODS=\" $ERIFLG $CCFLG $RSPFLG $TRAFLG \" >> configure
echo ERIFLG=$ERITAR >> configure
echo CCFLG=$CCTAR   >> configure
echo RSPFLG=$RSPTAR >> configure
echo TRAFLG=$TRATAR >> configure
echo PARFLG=$PARTAR >> configure
echo OPENFLG=$OPENTAR >> configure
#
#
cat configure.in >> configure
chmod +x configure
set AUXOBJ = "$CCOBJ $RSPOBJ $TRAOBJ $ERIOBJ $OPENOBJ"
set AUXMAK = "$CCMAK $RSPMAK $TRAMAK $ERIMAK $OPENMAK"
#
#  Write current Makefile
#
cat <<EOF > Makefile
include ./Makefile.config

OBJS = \
dirac/dirac.o  dirac/dircnv.o dirac/dirgp.o  dirac/dirone.o \
dirac/dirout.o dirac/dirana.o dirac/dirrdn.o dirac/dirscf.o \
dirac/dirset.o dirac/dirtra.o dirac/dirtwo.o dirac/dirden.o \
dirac/dirgeo.o dirac/dirgrd.o dirac/dirac_linux.o \
abacus/her1ave.o    abacus/her1car.o    abacus/her1drv.o    abacus/her1int.o\
abacus/her1odc.o    abacus/her1out.o    abacus/her1pro.o    abacus/her1sym.o\
abacus/her2ave.o    abacus/her2dir.o    abacus/her2drv.o    abacus/her2el1.o\
abacus/her2el2.o    abacus/her2fck.o    abacus/her2her.o    abacus/her2odc.o\
abacus/her2out.o    abacus/her2sup.o    abacus/her2sym.o    abacus/herbas.o\
abacus/herdirect.o  abacus/herdrv.o     abacus/hergam.o     abacus/hergeo.o\
abacus/hergp.o      abacus/herrdn.o     abacus/hersol.o\
abacus/hersym.o     abacus/hertst.o     abacus/her2gab.o    abacus/hermem.o\
abacus/abanuc.o abacus/abaopt.o abacus/abaortvec.o abacus/abarint.o\
abacus/abatro.o abacus/abavrml.o abacus/abawalk.o\
gp/gphjj.o          gp/gpjeppe.o        gp/gptrygve.o       gp/mempkg.o\
gp/qpack.o          gp/vcraypack.o      gp/gpsaue.o         gp/gpluuk.o \
gp/gpjth.o \
prp/paminp.o        prp/pamexp.o        prp/pamprp.o        prp/pamset.o \
prp/pamgrd.o 

PDLIB = pdpack/pdlib.a
EOF
#
#  Object-files for RSP-module
#
if($RSPMOD) then
cat <<EOF>> Makefile

RSPOBJS = \
prp/rsp/pamxlr.o   prp/rsp/pamrsp.o   prp/rsp/pamrvc.o 
EOF
endif
#
#  Object-files for 4index-trasnformation module
#
if($TRAMOD) then
cat <<EOF>> Makefile

TRAOBJS = \
moltra/tradr1.o moltra/tradr2.o moltra/tradr3.o moltra/tradr4.o  \
moltra/trainp.o moltra/traone.o moltra/trapam.o moltra/traout.o  \
moltra/traprp.o
EOF
endif
#
# Object files for CCSD - module
#
if($CCMOD) then
cat <<EOF>> Makefile

CCOBJS = \
relccsd/ccpam.o  relccsd/ccdriv.o \
relccsd/cceqns.o relccsd/ccints.o \
relccsd/ccsort.o relccsd/ccgenp.o \
relccsd/ccgetv.o relccsd/ccintm.o \
relccsd/ccrpa.o  relccsd/ccxblas.o \
relccsd/ccunix.o relccsd/ccgrad.o
EOF
endif
#
#  Object-files for ERI module
#
if($ERIMOD) then
cat <<EOF>> Makefile

ERIOBJS = \
eri/eri2cft.o       eri/eri2her.o       eri/eri2sym.o \
eri/eri2aob.o       eri/eri2dis.o       eri/eri2odb.o     eri/eri2vec.o \
eri/eri2car1.o      eri/eri2drv.o       eri/eri2out.o \
eri/eri2car2.o      eri/eri2fck.o       eri/eri2sph.o    
EOF
endif
#
#  Object files for Open shells module
#
if ($OPENMOD) then
cat <<EOF>> Makefile

OPENOBJS = \
dirac/open/gpjth_c.o        dirac/open/diropen.o
EOF
endif
#
#
#
if($PARMOD) then
cat <<EOF>> Makefile

OBJSLAVE = abacus/par/herpar.o

OBJSPVM = abacus/par/dumpvm.o
EOF
endif
cat <<EOF>> Makefile

OBJSMXM = gp/mxmpack.o

dirac.x: DIR_OBJ PRP_OBJ HER_OBJ GP_OBJ MXM_OBJ PD_OBJ  $AUXMAK
	\$(F77) \$(OPTFLAGS) -o \$(INSTALLDIR)/dirac.x \$(OBJS)  $AUXOBJ\
        \$(OBJSMXM) \$(LIB_LIST) \$(PDLIB)

EOF
if($PARMOD) then
cat <<EOF>> Makefile
dirmpi.x: DIR_OBJ PRP_OBJ HER_OBJ GP_OBJ MXM_OBJ PD_OBJ  SLAVE_OBJ $AUXMAK
	\$(F77) \$(OPTFLAGS) -o \$(INSTALLDIR)/dirmpi.x \$(OBJS)  \$(OBJSLAVE) $AUXOBJ\
	\$(OBJSMXM) \$(LIB_LIST) \$(PDLIB) \$(MPI_LIB_PATH) \$(MPI_LIB)

dirpvm.x: DIR_OBJ PRP_OBJ HER_OBJ PVM_OBJ  $AUXMAK\
	GP_OBJ MXM_OBJ PD_OBJ    
	\$(F77) \$(OPTFLAGS) -o \$(INSTALLDIR)/dirpvm.x \$(OBJS)  \$(OBJSLAVE) $AUXOBJ\
	\$(OBJSMXM) \$(LIB_LIST) \$(PDLIB) \$(PVM_LIB_PATH) \$(PVM_LIB_LIST)
	\$(F77) \$(OPTFLAGS) -o \$(INSTALLDIR)/node.x \$(OBJSLAVE) \$(OBJS) \
	\$(OBJSMXM) \$(LIB_LIST) \$(PDLIB) \$(PVM_LIB_PATH) \$(PVM_LIB_LIST)
EOF
endif
cat <<EOF>> Makefile

clean   :
	cd dirac    ; \$(MAKE) clean
	cd abacus   ; \$(MAKE) clean
	cd prp      ; \$(MAKE) clean
EOF
if($ERIMOD) then
echo '	cd eri      ; $(MAKE) clean' >> Makefile
endif
if($RSPMOD) then
echo '	cd prp/rsp  ; $(MAKE) clean' >> Makefile
endif
if($TRAMOD) then
echo '	cd moltra   ; $(MAKE) clean' >> Makefile
endif
if($CCMOD) then
echo '	cd relccsd  ; $(MAKE) clean' >> Makefile
endif
if($PARMOD) then
echo '	cd abacus/par  ; $(MAKE) clean' >> Makefile
endif
cat <<EOF>> Makefile
	cd gp       ; \$(MAKE) clean
	cd pdpack   ; \$(MAKE) clean
	\$(RM) -f *~

export:
	-rm -f DIRAC.new.tar.gz
	tar cvf DIRAC.new.tar \
	configure config.sub config.guess config.status doc/doc.html \
	include/*.h Makefile Makefile.config \
	dirac/*.F dirac/*.c dirac/Makefile.in \
	prp/*.F prp/Makefile.in \
	abacus/*.F abacus/Makefile.in \
	gp/Makefile.in gp/*.F \
	pdpack/Makefile.in pdpack/*.F 
EOF
if($ERITAR) then
echo '	tar rvf DIRAC.new.tar eri/*.F eri/Makefile.in ' >> Makefile
endif
if($CCTAR) then
echo '	tar rvf DIRAC.new.tar relccsd/*.F relccsd/Makefile.in relccsd/*.inc relccsd/*.c ' >> Makefile
endif
if($RSPTAR) then
echo '	tar rvf DIRAC.new.tar prp/rsp/*.F prp/rsp/Makefile.in ' >> Makefile
endif
if($OPENTAR) then
echo '	tar rvf DIRAC.new.tar dirac/open/*.F dirac/open/Makefile.in dirac/open/*.c ' >> Makefile
endif
if($TRATAR) then
echo '	tar rvf DIRAC.new.tar moltra/*.F moltra/Makefile.in ' >> Makefile
endif
if($PARTAR) then
echo '	tar rvf DIRAC.new.tar abacus/par/*.F abacus/par/Makefile.in ' >> Makefile
endif
if($PAMADM) then
echo '	tar rvf DIRAC.new.tar configure.in pamadm' >> Makefile
endif
cat <<EOF>> Makefile
	gzip -9 DIRAC.new.tar

veryclean :
	\$(RM) -r dirac include abacus prp gp pdpack doc
EOF
if($TRAMOD) then
echo '	$(RM) -r moltra' >> Makefile
endif
if($CCMOD) then
echo '	$(RM) -r relccsd' >> Makefile
endif
if($ERIMOD) then
echo '	$(RM) -r eri' >> Makefile
endif
cat <<EOF>> Makefile

DIR_OBJ :
	cd dirac ; \$(MAKE) all

PRP_OBJ :
	cd prp; \$(MAKE) all
EOF
if($RSPMOD) then
cat <<EOF>> Makefile

RSP_OBJ :
	cd prp/rsp; \$(MAKE) all
EOF
endif
if($TRAMOD) then
cat <<EOF>> Makefile

TRA_OBJ :
	cd moltra ; \$(MAKE) all
EOF
endif
if($CCMOD) then
cat <<EOF>> Makefile

CCM_OBJ :
	cd relccsd ; \$(MAKE) all
EOF
endif
if($ERIMOD) then
cat <<EOF>> Makefile

ERI_OBJ :
	cd eri; \$(MAKE) all
EOF
endif
cat <<EOF>> Makefile

HER_OBJ :
	cd abacus ; \$(MAKE) all

GP_OBJ :
	cd gp ; \$(MAKE) all

MXM_OBJ :
	cd gp ; \$(MAKE) mxm

EOF
if($PARMOD) then
cat <<EOF>> Makefile
PVM_OBJ :
	cd abacus/par ; \$(MAKE) pvm 

SLAVE_OBJ :
	cd abacus/par  ; \$(MAKE) slave
EOF
endif
#
if ($OPENMOD) then
cat <<EOF>> Makefile
OPEN_OBJ:
	cd dirac/open ; \$(MAKE) all
EOF
endif
#if($ERIMOD) then
#cat <<EOF>> Makefile
#       cd eri/par ; \$(MAKE) slave
#EOF
#endif
cat <<EOF>> Makefile

PD_OBJ:
	cd pdpack ; \$(MAKE) all
EOF
#
#  Add makedepend target
#
set TEMP = ('dirac' 'prp' 'abacus' 'gp' 'pdpack')
if ($PARMOD) then
   set TEMP = ($TEMP 'abacus/par')
endif
if ($CCMOD) then
   set TEMP = ($TEMP 'relccsd')
endif
if ($RSPMOD) then
   set TEMP = ($TEMP 'prp/rsp')
endif
if ($TRAMOD) then
   set TEMP = ($TEMP 'moltra')
endif
if ($ERIMOD) then
   set TEMP = ($TEMP 'eri')
endif
if ($OPENMOD) then
   set TEMP = ($TEMP 'dirac/open')
endif

cat <<EOF>> Makefile
depend:
EOF
foreach ff ( $TEMP )
   cat <<EOF>> Makefile
	cd $ff; \$(MAKE) depend
EOF
end
#
#
#
if($GENTAR) then
#
#  make tarfile
#
  make export
  mv -f DIRAC.new.tar.gz $TARFIL.tar.gz
#
#  Retrieve original files
#
  mv -f Makefile.buf Makefile
  mv -f tarbuf.gz DIRAC.new.tar.gz 
endif
exit 0 




