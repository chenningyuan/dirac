#
#
# USAGE
#
#
usage()
{
   echo 'Usage: pamadm [flags] tarfile'
   echo '   Flags:'
   echo '     -adm          : Include ALL modules (administrator)'
   echo '     -eri          : Include ERI integral routines'
   echo '     -esr          : Include ESR property module'
   echo '     -xpp          : Include PP excitation energy module'
   echo '     -ccfocksp     : Include Fock space CC module'
   echo '     -xqr          : Include quadratic response module'
   echo '     tarfile=make  : only generate new Makefile'
   echo '     tarfile=export: Make DIRAC.new.tar.gz'
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SETUP ALL VARIABLES
#
#
setup()
{
#
#  Administrator needs everything.....
#
   echo
   echo "*** Active modules:"
   echo
   echo_style=sysv
   noclobber=
   EXPORTTAR=1
   if [ -n "$PAMADM" ]; then
      CCFOCKSPMOD=1
      ERITAR=1
      ESRMOD=1
      XQRMOD=1
      XPPMOD=1
      echo " - DIRAC administrator ..."
   fi
   if [ -n "$CCFOCKSPMOD" ]; then
      CCFOCKSPFLG='-DMOD_CCFOCKSP'
      CCFOCKSPOBJ='$(CCFOCKSPOBJS)'
      CCFOCKSPMAK=CCFOCKSP_OBJ
      CCFOCKSPTAR=1
      echo " - Fock space CC module (CCFOCKSP)"
   fi
   #
   #  ESR
   #
   if [ -n "$ESRMOD" ]; then
      ESRFLG='-DMOD_ESR'
      ESROBJ='$(ESROBJS)'
      ESRMAK=ESR_OBJ
      ESRTAR=1
      echo " - ESR property module (ESR)"
   fi
   #
   #  XQR
   #
   if [ -n "$XQRMOD" ]; then
      XQRFLG='-DMOD_XQR'
      XQROBJ='$(XQROBJS)'
      XQRMAK=XQR_OBJ
      XQRTAR=1
      echo " - Quadratic reponse module (XQR)"
   fi
   #
   #  XPP
   #
   if [ -n "$XPPMOD" ]; then
      XPPFLG='-DMOD_XPP'
      XPPOBJ='$(XPPOBJS)'
      XPPMAK=XPP_OBJ
      XPPTAR=1
      echo " - Excitation energy module (XPP)"
   fi
   #
   #  ERI two-electron integral module
   #
   if [ -n "$ERIMOD" ]; then
      ERIFLG='-DMOD_ERI'
      ERIOBJ='$(ERIOBJS)'
      ERIMAK=ERI_OBJ
      ERITAR=1
      echo " - ERI two-electron integral module"
   fi
   #
   #
   #
   if [ "$TARFIL" = "make" ]; then
      GENTAR=
   fi
   if [ "$TARFIL" = "export" ]; then
      if [ -a DIRAC.new.tar.gz ]; then
         rm DIRAC.new.tar.gz
      fi
      TARFIL=DIRAC.new
   fi
   echo
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# BACKUP OLD FILES
#
#
backup()
{
   if [ -n "$GENTAR" ]; then
      echo "*** Backing up old files ..." 
      echo
      temp=
      if [ -a DIRAC.new.tar.gz ]; then
         temp="$temp DIRAC.new.tar.gz"
      fi
      if [ -a configure ]; then
         temp="$temp configure"
      fi
      if [ -a export ]; then
         temp="$temp export"
      fi
      if [ -a Makefile ]; then
         temp="$temp Makefile"
      fi
      for file in $temp; do
         echo " - $file --> $file.buf"
         mv $file $file.buf 
      done
   fi
   echo
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# RESTORE AND MAKE TAR
#
#
restore()
{
   make_export
   if [ -n "$GENTAR" ]; then
      #
      # Make tar-file
      #
      echo "*** Making tar-file ..."
      echo
      ./export
      if [ -a DIRAC.new.tar.gz ]; then
         if [ "$TARFIL" != "DIRAC.new" ]; then
            mv DIRAC.new.tar.gz $TARFIL.tar.gz
         fi
      else
         echo "Fatal error: No DIRAC.new.tar.gz"
      fi
      #
      #
      #
      echo "*** Restoring old files ..." 
      echo
      temp=
      if [ -a DIRAC.new.tar.gz.buf ]; then
         temp="$temp DIRAC.new.tar.gz"
      fi
      if [ -a configure.buf ]; then
         temp="$temp configure"
      fi
      if [ -a export.buf ]; then
         temp="$temp export"
      fi
      if [ -a Makefile.buf ]; then
         temp="$temp Makefile"
      fi
      for file in $temp; do
         echo " - $file.buf --> $file"
         mv $file.buf $file
      done
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# MAKE CONFIGURE
#
#
make_configure()
{
   echo "*** Making ./configure"
   echo 
   echo "#!/bin/sh" > configure
   echo "MODS=\" $ERIFLG $CCFOCKSPFLG $ESRFLG $XQRFLG $XPPFLG\"" >> configure
   echo ERIFLG=$ERITAR >> configure
   echo CCFOCKSPFLG=$CCFOCKSPTAR   >> configure
   echo ESRFLG=$ESRTAR >> configure
   echo XQRFLG=$XQRTAR >> configure
   echo XPPFLG=$XPPTAR >> configure
   cat ./configure.in >> configure
   chmod +x configure
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# MAKE EXPORT SHELL SCRIPT
#
#
make_export()
{
   echo "*** Making ./export"
   echo
   #
   # Basis files
   #
   cat <<EOF> ./export
#!/bin/sh
   echo " - adding files to tar-achive..."
   echo
   tar cvf DIRAC.new.tar \\
      configure config.sub config.guess config.status doc/doc.html \\
      C90lib.cld crilib.cld \\
      include/*.h Makefile \\
      dirac/*.F   dirac/Makefile.in \\
      prp/*.F     prp/Makefile.in \\
      abacus/*.F  abacus/Makefile.in \\
      gp/*.F gp/*.c gp/Makefile.in \\
      pdpack/Makefile.in pdpack/*.F \\
      dirac/main/Makefile.in dirac/main/*.c dirac/main/*.F \\
      dirac/main/*.h dirac/main/*.head dirac/main/*.struct \\
      relccsd/*.F relccsd/*.inc relccsd/*.c relccsd/Makefile.in \\
      moltra/*.F moltra/Makefile.in \\
      pam.in pam.1 test 2> export.log
EOF
   #
   # Active modules
   #
   if [ "$ERITAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar eri/*.F eri/Makefile.in 2>> export.log
EOF
   fi
   if [ "$CCFOCKSPTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar relccsd/ccfocksp/*.F \\
              relccsd/ccfocksp/Makefile.in 2>> export.log
EOF
   fi
   if [ "$ESRTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar prp/esr/*.F prp/esr/Makefile.in 2>> export.log
EOF
   fi
   if [ "$XPPTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar prp/xpp/*.F prp/xpp/Makefile.in 2>> export.log
EOF
   fi
   if [ "$XQRTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar prp/xqr/*.F prp/xqr/Makefile.in 2>> export.log
EOF
   fi
   if [ "$PAMADM" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar configure.in pamadm WHATSNEW 2>> export.log
EOF
   fi
   if [ "$EXPORTTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar export 2>> export.log
EOF
   fi
   cat <<EOF>> ./export
      echo " - gzip'ing archive..."
      echo
      gzip -9v DIRAC.new.tar
EOF
   chmod +x ./export
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# MAKE MAKEFILE
#
#
make_makefile()
{
   echo "*** Making Makefile"
   echo
   AUXOBJ="$CCFOCKSPOBJ $ESROBJ $XQROBJ $ERIOBJ $XPPOBJ"
   AUXMAK="$CCFOCKSPMAK $ESRMAK $XQRMAK $ERIMAK $XPPMAK"
   #
   # Write current Makefile
   #
   cat <<EOF> Makefile
include ./Makefile.config

OBJS = \\
dirac/dircnv.o dirac/dirgp.o  dirac/dirone.o \\
dirac/dirout.o dirac/dirana.o dirac/dirrdn.o dirac/dirscf.o \\
dirac/dirset.o dirac/dirtra.o dirac/dirtwo.o dirac/dirden.o \\
dirac/dirgrd.o dirac/dirsol.o dirac/dirgeo.o dirac/dirspf.o \\
dirac/diropen.o \\
main/dirac.o \\
abacus/her1ave.o    abacus/her1car.o    abacus/her1drv.o    abacus/her1int.o\\
abacus/her1odc.o    abacus/her1out.o    abacus/her1pro.o    abacus/her1sym.o\\
abacus/her2ave.o    abacus/her2dir.o    abacus/her2drv.o    abacus/her2el1.o\\
abacus/her2el2.o    abacus/her2fck.o    abacus/her2her.o    abacus/her2odc.o\\
abacus/her2out.o    abacus/her2sup.o    abacus/her2sym.o    abacus/herbas.o\\
abacus/herdirect.o  abacus/herdrv.o     abacus/hergam.o     abacus/hergeo.o\\
abacus/hergp.o      abacus/herrdn.o     abacus/hersol.o\\
abacus/hersym.o     abacus/hertst.o     abacus/her2gab.o    abacus/hermem.o\\
abacus/abanuc.o     abacus/abatro.o     abacus/abaortvec.o abacus/abarint.o \\
abacus/abaopt.o     abacus/abavrml.o abacus/abawalk.o abacus/abaop2.o \\
gp/gphjj.o          gp/gpjeppe.o        gp/gptrygve.o       gp/mempkg.o\\
gp/qpack.o          gp/vcraypack.o      gp/gpsaue.o         gp/gpluuk.o \\
gp/gpjth.o \\
prp/paminp.o        prp/pamexp.o        prp/pamprp.o        prp/pamset.o \\
prp/pamgrd.o        prp/pamogrd.o       prp/pamfck.o        \\
prp/pamxlr.o        prp/pamrsp.o        prp/pamrvc.o \\
moltra/tradr1.o moltra/tradr2.o moltra/tradr3.o moltra/tradr4.o \\
moltra/trainp.o moltra/traone.o moltra/traout.o moltra/trapam.o \\
moltra/traprp.o \\
relccsd/ccpam.o  relccsd/ccdriv.o relccsd/cceqns.o relccsd/ccints.o \\
relccsd/ccsort.o relccsd/ccgenp.o relccsd/ccgetv.o relccsd/ccintm.o \\
relccsd/ccrpa.o  relccsd/ccxblas.o relccsd/ccgrad.o \\
dirrci/cidirr.o dirrci/cigenp.o dirrci/cigosc.o 
C_OBJS = \\
main/alloc_mem.o    main/csectid.o \\
main/diracmalloc.o  main/end_mpi.o    main/exec_dirac.o \\
main/get_memsize.o  main/ini_mpi.o    main/main.o \\
main/mpi_errtrap.o  main/pr_timing.o  main/print_logo.o \\
main/get_time.o \\
gp/gpjth_c.o \\
relccsd/ccunix.o


PDLIB = pdpack/pdlib.a
EOF
#
#  Object-files for ESR-module
#
if [ -n "$ESRMOD" ]; then
cat <<EOF>> Makefile

ESROBJS = \\
prp/esr/pamesr.o
EOF
fi
#
#  Object-files for XQR module
#
if [ -n "$XQRMOD" ]; then
cat <<EOF>> Makefile

XQROBJS = \\
prp/xqr/pamxqr.o
EOF
fi
#
#  Object-files for XPP module
#
if [ -n "$XPPMOD" ]; then
cat <<EOF>> Makefile

XPPOBJS = \\
prp/xpp/pamxpp.o
EOF
fi
#
# Object files for CC Fock space
#
if [ -n "$CCFOCKSPMOD" ]; then
cat <<EOF>> Makefile

CCFOCKSPOBJS = \\
relccsd/ccfocksp/ccfspc.o
EOF
fi
#
#  Object-files for ERI module
#
if [ -n "$ERIMOD" ]; then
cat <<EOF>> Makefile

ERIOBJS = \\
eri/eri2cft.o       eri/eri2her.o       eri/eri2sym.o \\
eri/eri2aob.o       eri/eri2dis.o       eri/eri2odb.o     eri/eri2vec.o \\
eri/eri2car1.o      eri/eri2drv.o       eri/eri2out.o \\
eri/eri2car2.o      eri/eri2fck.o       eri/eri2sph.o
EOF
fi
#
#  The targets
#
cat <<EOF>> Makefile

OBJSMXM = gp/mxmpack.o

TOTOBJS = \$(OBJS) \$(ESROBJS) \$(XQROBJS) \$(CCFOCKSPOBJS) \$(ERIOBJS) \$(XPPOBJS)

NOCPPFS = \$(TOTOBJS:.o=.i)

dirac.x: MAIN_OBJ DIR_OBJ PRP_OBJ HER_OBJ GP_OBJ MXM_OBJ PD_OBJ \\
	TRA_OBJ CCM_OBJ CI_OBJ $AUXMAK 
	\$(F77) \$(LDFLAGS) -o \$(INSTALLDIR)/dirac.x \\
	\$(OBJS) \$(C_OBJS) \$(C_CCOBJS) \\
	$AUXOBJ \\
	\$(OBJSMXM) \$(LIB_LIST) \$(PDLIB)
#
# Run ftnchek on Dirac
#
dirac.pre: \$(NOCPPFS)

dirac.ftnchek: dirac.pre
	ftnchek \$(CHEKFLAGS) \$(NOCPPFS) > dirac.ftnchek
EOF
#
# Parallel targets
#
cat <<EOF>> Makefile
dirmpi.x: MAIN_OBJ DIR_OBJ PRP_OBJ HER_OBJ GP_OBJ MXM_OBJ PD_OBJ \\
	TRA_OBJ CCM_OBJ CI_OBJ $AUXMAK  SLAVE_OBJ
	\$(F77) \$(LDFLAGS) -o \$(INSTALLDIR)/dirac.x \\
	\$(OBJS) \$(C_OBJS) \$(C_CCOBJS) \\
	\$(OBJSLAVE) $AUXOBJ \\
	\$(OBJSMXM) \$(LIB_LIST) \$(PDLIB) \\
 	\$(MPI_LIB_PATH) \$(MPI_LIB)

EOF
#
# Clean targets
#
cat <<EOF>> Makefile

clean   :
	cd dirac    ; \$(MAKE) clean
	cd abacus   ; \$(MAKE) clean
	cd prp      ; \$(MAKE) clean
	cd main ; \$(MAKE) clean
	cd moltra   ; \$(MAKE) clean
	cd relccsd  ; \$(MAKE) clean
EOF
if [ -n "$ERIMOD" ]; then
   echo '	cd eri      ; $(MAKE) clean' >> Makefile
fi
if [ -n "$ESRMOD" ]; then
   echo '	cd prp/esr  ; $(MAKE) clean' >> Makefile
fi
if [ -n "$XPPMOD" ]; then
   echo '	cd prp/xpp   ; $(MAKE) clean' >> Makefile
fi
if [ -n "$XQRMOD" ]; then
   echo '	cd prp/xqr   ; $(MAKE) clean' >> Makefile
fi
if [ -n "$CCFOCKSPMOD" ]; then
   echo '	cd relccsd/ccfocksp  ; $(MAKE) clean' >> Makefile
fi
cat <<EOF>> Makefile
	cd gp       ; \$(MAKE) clean
	cd pdpack   ; \$(MAKE) clean
	\$(RM) -f *~
#
#  Export target
#
export:
	-rm -f DIRAC.new.tar.gz
	./export
#
#  Objects
#

MAIN_OBJ:
	cd main ; \$(MAKE) all

DIR_OBJ :
	cd dirac ; \$(MAKE) all

PRP_OBJ :
	cd prp; \$(MAKE) all

TRA_OBJ :
	cd moltra; \$(MAKE) all

CCM_OBJ :
	cd relccsd ; \$(MAKE) all

SLAVE_OBJ :
	cd abacus/par  ; \$(MAKE) slave

CI_OBJ:
	cd dirrci ; \$(MAKE) all

EOF
if [ -n "$ESRMOD" ]; then
cat <<EOF>> Makefile

ESR_OBJ :
	cd prp/esr; \$(MAKE) all
EOF
fi
if [ -n "$XQRMOD" ]; then
cat <<EOF>> Makefile

XQR_OBJ :
	cd prp/xqr ; \$(MAKE) all
EOF
fi
if [ -n "$XPPMOD" ]; then
cat <<EOF>> Makefile

XPP_OBJ :
	cd prp/xpp ; \$(MAKE) all
EOF
fi
if [ -n "$CCFOCKSPMOD" ]; then
cat <<EOF>> Makefile

CCFOCKSP_OBJ :
	cd relccsd/ccfocksp ; \$(MAKE) all
EOF
fi
if [ -n "$ERIMOD" ]; then
cat <<EOF>> Makefile

ERI_OBJ :
	cd eri; \$(MAKE) all
EOF
fi
cat <<EOF>> Makefile

HER_OBJ :
	cd abacus ; \$(MAKE) all

GP_OBJ :
	cd gp ; \$(MAKE) all

MXM_OBJ :
	cd gp ; \$(MAKE) mxm

EOF

cat <<EOF>> Makefile

PD_OBJ:
	cd pdpack ; \$(MAKE) all
EOF
#
#  Add makedepend targets
#
TEMP="dirac prp abacus gp pdpack main relccsd moltra dirrci"
if [ -n "$CCFOCKSPMOD" ]; then
   TEMP="$TEMP relccsd/ccfocksp"
fi
if [ -n "$ESRMOD" ]; then
   TEMP="$TEMP prp/esr"
fi
if [ -n "$XPPMOD" ]; then
   TEMP="$TEMP prp/xpp"
fi
if [ -n "$XQRMOD" ]; then
   TEMP="$TEMP prp/xqr"
fi
if [ -n "$ERIMOD" ]; then
   TEMP="$TEMP eri"
fi

cat <<EOF>> Makefile
depend:
EOF
for ff in $TEMP; do
   cat <<EOF>> Makefile
	cd $ff; \$(MAKE) depend
EOF
done
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# MAIN SCRIPT
#
#
#
# Parse arguments
#
if [ -z "$1" ]; then
   usage
   exit 1
fi
GENTAR=1
while [ -n "$1" ]; do
   case "$1" in
      -adm|-ad|-a)
         PAMADM=1
         ;;
      -ccfocksp|-c)
         CCFOCKSPMOD=1
         ;;
      -esr|-es)
         ESRMOD=1
         ;;
      -xpp|-xp)
         XPPMOD=1
         ;;
      -xqr|-xq|-x)
         XQRMOD=1
         ;;
      -eri|-er|-e)
         ERIMOD=0
         ;;
      -*)
         echo "Option \"$1\" not recognized."
         usage
         exit 1
         ;;
      *)
         TARFIL=$1
         ;;
   esac
   shift
done
unset noclobber
#
# Setup variables
#
setup
#
# Backup old files
#
backup
#
#
#
make_configure
#
# Make makefile
#
make_makefile
#
# Make distribution and restore old files
#
restore
#
#
#
exit 0
