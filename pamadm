#
#
# SETUP ALL VARIABLES
#
#
setup()
{
#
#  Administrator needs everything.....
#
   echo
   echo "*** Active modules:"
   echo
   echo_style=sysv
   unset noclobber
   EXPORTTAR=1
   if [ -n "$PAMADM" ]; then
      ERIMOD=1
      DNFMOD=1
      ESRMOD=1
      XPPMOD=1
      DFTMOD=1
      KRMCMOD=1
      VISUALMOD=1
      IHFSCCMOD=1
      # by deactivating AMFI you save cca 17MB of static alloc (with ILP64)
      AMFIMOD=1
      LONDONMOD=1
      IHFSCCMOD=1
      ADCMOD=1
#     MATRIX_OPERATIONS_MOD=1
#     AORESPONSEMOD=1
# MI  - needs to be fixed for gfortran !!!
#      EMBMOD=1
#      ECPMOD=1
      echo " - DIRAC administrator ..."
   fi
   #
   #  DFT
   #
   if [ -n "$DFTMOD" ]; then
      DFTFLG='-DMOD_DFT'
      DFTTAR=1
      echo " - DFT module (DFT)"
   fi
   #
   #  ESR
   #
   if [ -n "$ESRMOD" ]; then
      ESRFLG='-DMOD_ESR'
      ESRTAR=1
      echo " - ESR property module (ESR)"
   fi
   #
   #  XPP and STEX
   #
   if [ -n "$XPPMOD" ]; then
      XPPFLG='-DMOD_XPP -DMOD_STEX'
      XPPTAR=1
      echo " - Excitation energy module (XPP and STEX)"
   fi
   #
   #  KRMC and LUCIAREL
   #
   if [ -n "$KRMCMOD" ]; then
      KRMCFLG='-DMOD_KRMC'
      KRMCTAR=1
      echo " - KR-MCSCF and LUCIAREL modules (KRMC)"
   fi
   #
   #  Increase common block sizes to handle more centers and basis sets
   #
   if [ -n "$LARGEMOL" ]; then
      LRGMOLFLG='-DLARGE_MOLECULES'
      echo " - Increasing common block sizes to handle larger systems"
   fi
   #
   #  ERI two-electron integral module
   #
   if [ -n "$ERIMOD" ]; then
      ERIFLG='-DMOD_ERI'
      ERITAR=1
      echo " - ERI two-electron integral module"
   fi
   #
   #  DNF density fitting module
   #
   if [ -n "$DNFMOD" ]; then
      DNFFLG='-DMOD_DNF'
      DNFTAR=1
      echo " - DNF density fitting module"
   fi
   #
   #  FMM  module
   #
   if [ -n "$FMMMOD" ]; then
      FMMFLG='-DMOD_FMM'
      FMMTAR=1
      echo " - Fast Multipole Method (fmm) module"
   fi
   #
   #  ab initio/DFT embedding module
   #
   if [ -n "$EMBMOD" ]; then
      if [ -n "$DFTMOD" ]; then
         EMBFLG='-DMOD_EMB'
         EMBTAR=1
         echo " - ab initio/DFT embedding module (with Fortran90/95 modules)"
      else
         echo "ab initio/DFT embedding module not included - depends on DFT module "
      fi
   fi
   #
   #  XML
   #
   if [ -n "$XMLMOD" ]; then
      XMLFLG='-DMOD_XML'
      XMLTAR=1
      echo " - XML input/output module (with Fortran90/95 modules)"
   fi
   #
   #  ADC electron propagator module
   #
   if [ -n "$ADCMOD" ]; then
      ADCFLG='-DMOD_ADC'
      ADCTAR=1
      echo " - ADC electron propagator module"
   fi
   #
   #  ECP module
   #
   if [ -n "$ECPMOD" ]; then
      ECPFLG='-DMOD_ECP'
      ECPTAR=1
      echo " - ECP argos module"
   fi
   #
   #  visualization module
   #
   if [ -n "$VISUALMOD" ]; then
      VISUALFLG='-DMOD_VISUAL'
      VISUALTAR=1
      echo " - visualization module"
   fi
   #
   #  AO response module
   #
   if [ -n "$AORESPONSEMOD" ]; then
      AORESPONSEFLG='-DMOD_AORESPONSE'
      AORESPONSETAR=1
      echo " - AO response module"
   fi

#  matrix operations
   if [ -n "$MATRIX_OPERATIONS_MOD" ]; then
      MATRIX_OPERATIONS_FLG='-DMOD_MATRIX_OPERATIONS'
      MATRIX_OPERATIONS_TAR=1
      echo " - matrix operations module"
   fi

#  autodiff
   if [ -n "$AUTODIFFMOD" ]; then
      AUTODIFFFLG='-DMOD_AUTODIFF'
      echo " - autodiff module"
   fi

   #
   #      CAP module
   #
   if [ -n "$CAPMOD" ]; then
         CAPFLG='-DMOD_CAP'
         CAPTAR=1
         echo " - CAP module"
  # else
      #  echo "CAP module is not included "
      #  echo 
    fi
   #
   #   IHFSCCSD functionality
   #
   if [ -n "$IHFSCCMOD" ]; then
         IHFSCCFLG='-DMOD_IHFSCC'
         echo " - IHFSCC code enabled"
  # else
      #  echo "HSMRCC interface module is not included "
      #  echo 
    fi

   #
   #  AMFI functionality
   #
   if [ -n "$AMFIMOD" ]; then
         AMFIFLG='-DMOD_AMFI'
         echo " - AMFI functionality enabled"
   fi
   #
   # London orbitals 
   #
   if [ -n "$LONDONMOD" ]; then
         LONDONFLG='-DMOD_LONDON'
         echo " - London atomic orbitals enabled"
   fi
   #
   #   HSMRCC Dirac-interface module
   #
   if [ -n "$HSCCMOD" ]; then
         HSCCFLG='-DMOD_HSCC'
         HSCCTAR=1
	 # delet old file
	 if [ -f hsmrcc/hsmrcc_external/Makefile.hsmrcc ]; then
	   /bin/rm -r hsmrcc/hsmrcc_external/Makefile.hsmrcc
	 fi
         cp hsmrcc/hsmrcc_external/Makefile.hsmrcc.in  hsmrcc/hsmrcc_external/Makefile.hsmrcc || \
         (echo "Error exit: hsmrcc/hsmrcc_external/Makefile.hsmrcc not activated !"; exit 1)
         echo " - HSMRCC interface module, plus own HSMRCC routines, active Makefile.hsmrcc."

       #  cp hsmrcc/second_quant/Makefile.secquant.in  hsmrcc/second_quant/Makefile.secquant || \
       #  (echo "Error exit:  !"; exit 1)
       #  echo " - second quantization module active"
   fi
   #
   #  Higher Sector Fock-space (HSFS) Coupled Cluster module 
   #
   if [ -n "$HSFSMOD" ]; then
         HSFSFLG='-DMOD_HSFS'
         HSFSTAR=1
	 # delet old file
	 if [ -f hsmrcc/high_sect_fscc_external/Makefile.hsfs ]; then
            /bin/rm -r hsmrcc/high_sect_fscc_external/Makefile.hsfs
	 fi
         cp hsmrcc/high_sect_fscc_external/Makefile.hsfs.in  hsmrcc/high_sect_fscc_external/Makefile.hsfs || \
         (echo "Error exit: hsmrcc/high_sect_fscc/Makefile.hsfs not activated !"; exit 1)
         echo " - HS FS CC mode active with own HSFS routines, active Makefile.hsfs."
   fi
   #
   #  Dirac Quantum Dots modification
   #
   if [ -n "$QDOTSMOD" ]; then
         QDOTSFLG='-DMOD_QDOTS'
        # QDOTSTAR=1
         echo " - Quantum Dots (artificial atom) enabled"
   fi
   #
   # Object oriented fortran90/95 mocularity module
   #
   if [ -n "$OOFMOD" ]; then
         OOF_FLG='-DMOD_OOF'
         OOF_TAR=1
         echo " - OOF module"
      else
       #  echo "OOF module not included"
       echo 
   fi
   if [ -n "$LOGMOD" ]; then
       LOG_FLG=-DMOD_LOG
       echo ' - Will log interesting matrices in matlab format (very verbose!)'
   fi
#  exit
   #
   # Defining the tarfile that is used for export
   #
   if [ "$TARFIL" = "make" -o -z "$TARFIL" ]; then
      GENTAR=
   fi
   if [ "$TARFIL" = "export" ]; then
      szCurrDir=`pwd`
      szCurrDir=${szCurrDir##*/}
      TARFIL=$szCurrDir.tar
   fi
   echo
}
