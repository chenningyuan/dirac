#
#
# MAKE CONFIGURE
#
#
make_configure()
{
   echo "*** Making ./configure"
   echo 
   echo "#!/bin/sh" > configure
   echo "MODS=\" $ERIFLG $CCFLG $RSPFLG $TRAFLG $OPENFLG" \
        "$SPFFLG $CIFLG $GEOFLG\"" >> configure
   echo ERIFLG=$ERITAR >> configure
   echo CCFLG=$CCTAR   >> configure
   echo RSPFLG=$RSPTAR >> configure
   echo TRAFLG=$TRATAR >> configure
   echo PARFLG=$PARTAR >> configure
   echo OPENFLG=$OPENTAR >> configure
   echo SPFFLG=$SPFTAR >> configure
   echo PAMADM=$PAMADM >> configure
   echo CIFLG=$CITAR >> configure
   echo GEOFLG=$GEOTAR >> configure
   cat ./configure.in >> configure
   chmod +x configure
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# MAKE EXPORT SHELL SCRIPT
#
#
make_export()
{
   echo "*** Making ./export"
   echo
   #
   # Basis files
   #
   cat <<EOF> ./export
#!/bin/sh
   echo " - adding files to tar-achive..."
   echo
   tar cvf DIRAC.new.tar \\
      configure config.sub config.guess config.status doc/doc.html \\
      C90lib.cld crilib.cld \\
      include/*.h Makefile \\
      dirac/*.F   dirac/Makefile.in \\
      prp/*.F     prp/Makefile.in \\
      abacus/*.F  abacus/Makefile.in \\
      gp/*.F gp/*.c gp/Makefile.in \\
      pdpack/Makefile.in pdpack/*.F \\
      dirac/main/Makefile.in dirac/main/*.c dirac/main/*.F \\
      dirac/main/*.h dirac/main/*.head dirac/main/*.struct \\
      pam.in pam.1 2> export.log
EOF
   #
   # Active modules
   #
   if [ "$ERITAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar eri/*.F eri/Makefile.in 2>> export.log
EOF
   fi
   if [ "$CCTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar relccsd/*.F relccsd/*.inc \\
              relccsd/*.c relccsd/Makefile.in 2>> export.log
EOF
   fi
   if [ "$RSPTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar prp/rsp/*.F prp/rsp/Makefile.in 2>> export.log
EOF
   fi
   if [ "$OPENTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar  dirac/open/*.F dirac/open/Makefile.in \\
              2>> export.log
EOF
   fi
   if [ "$SPFTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar dirac/spinfree/*.F dirac/spinfree/Makefile.in \\
              2>> export.log
EOF
   fi
   if [ "$TRATAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar moltra/*.F moltra/Makefile.in 2>> export.log
EOF
   fi
   if [ "$GEOTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar dirac/geom/*.F dirac/geom/Makefile.in \\
              2>> export.log
      tar rvf DIRAC.new.tar abacus/geom/*.F abacus/geom/Makefile.in \\
              2>> export.log
EOF
   fi
   if [ "$PARTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar abacus/par/*.F abacus/par/Makefile.in \\
              2>> export.log
EOF
   fi
   if [ "$CITAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar dirrci/*.F dirrci/*.inc dirrci/Makefile.in \\
              2>> export.log
EOF
   fi
   if [ "$PAMADM" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar configure.in pamadm 2>> export.log
EOF
   fi
   if [ "$EXPORTTAR" ]; then
      cat <<EOF>> ./export
      tar rvf DIRAC.new.tar export 2>> export.log
EOF
   fi
   cat <<EOF>> ./export
      echo " - gzip'ing archive..."
      echo
      gzip -9v DIRAC.new.tar
EOF
   chmod +x ./export
}
