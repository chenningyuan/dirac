#
#
# SETUP ALL VARIABLES
#
#
setup()
{
#
#  Administrator needs everything.....
#
   echo
   echo "*** Active modules:"
   echo
   echo_style=sysv
   unset noclobber
   EXPORTTAR=1
   if [ -n "$PAMADM" ]; then
      ERITAR=1
      ESRMOD=1
      XPPMOD=1
      DFTMOD=1
      KRMCMOD=1
      CDFTMOD=1
      VISUALMOD=1
      echo " - DIRAC administrator ..."
   fi
   #
   #  DFT
   #
   if [ -n "$DFTMOD" ]; then
      DFTFLG='-DMOD_DFT'
      DFTOBJ='$(DFTOBJS) $(DFTOBJS_C)'
      DFTMAK=DFT_OBJ
      DFTTAR=1
      echo " - DFT module (DFT)"
   fi
   #
   #  ESR
   #
   if [ -n "$ESRMOD" ]; then
      ESRFLG='-DMOD_ESR'
      ESROBJ='$(ESROBJS)'
      ESRMAK=ESR_OBJ
      ESRTAR=1
      echo " - ESR property module (ESR)"
   fi
   #
   #  XPP
   #
   if [ -n "$XPPMOD" ]; then
      XPPFLG='-DMOD_XPP'
      XPPOBJ='$(XPPOBJS)'
      XPPMAK=XPP_OBJ
      XPPTAR=1
      echo " - Excitation energy module (XPP)"
   fi
   #
   #  KRMC and LUCIAREL
   #
   if [ -n "$KRMCMOD" ]; then
      KRMCFLG='-DMOD_KRMC'
      KRMCOBJ='$(KRMC_FOBJS) $(KRMC_COBJS)'
      KRMCMAK=KRMC_OBJ
      LUCIARELOBJ='$(LUCIARELOBJS)'
      LUCIARELMAK=LUCIAREL_OBJ
      KRMCTAR=1
      echo " - KR-MCSCF and LUCIAREL modules (KRMC)"
   fi
   #
   #  Increase common block sizes to handle more centers and basis sets
   #
   if [ -n "$LARGEMOL" ]; then
      LRGMOLFLG='-DLARGE_MOLECULES'
      echo " - Increasing common block sizes to handle larger systems"
   fi
   #
   #  ERI two-electron integral module
   #
   if [ -n "$ERIMOD" ]; then
      ERIFLG='-DMOD_ERI'
      ERIOBJ='$(ERIOBJS)'
      ERIMAK=ERI_OBJ
      ERITAR=1
      echo " - ERI two-electron integral module"
   fi
   #
   #  DNF density fitting module
   #
   if [ -n "$DNFMOD" ]; then
      if [ -n "$ERIMOD" ]; then
         ERIFLG='-DMOD_ERI'
         ERIOBJ='$(ERIOBJS)'
         ERIMAK=ERI_OBJ
         ERITAR=1
         echo " - ERI two-electron integral module"
      else
         echo "density fitting module not included - depends on ERI module "
      fi
      DNFFLG='-DMOD_DNF'
      DNFOBJ='$(DNFOBJS)'
      DNFMAK=DNF_OBJ
      DNFTAR=1
      echo " - DNF density fitting module"
   fi
   #
   #  FMM  module
   #
   if [ -n "$FMMMOD" ]; then
      FMMFLG='-DMOD_FMM'
      FMMOBJ='$(FMMOBJS)'
      FMMMAK=FMM_OBJ
      FMMTAR=1
      echo " - Fast Multipole Method (fmm) module"
   fi
   #
   #  ab initio/DFT embedding module
   #
   if [ -n "$EMBMOD" ]; then
      if [ -n "$DFTMOD" ]; then
         EMBFLG='-DMOD_EMB'
         EMBOBJ='$(EMBOBJS)'
         EMBMAK=EMB_OBJ
         EMBTAR=1
	 F90MODS=ALL_F90MODS
         echo " - ab initio/DFT embedding module (with Fortran90/95 modules)"
      else
         echo "ab initio/DFT embedding module not included - depends on DFT module "
      fi
   fi
   #
   #  SDFT/CDFT module
   #
   if [ -n "$CDFTMOD" ]; then
      if [ -n "$DFTMOD" ]; then
         CDFTFLG='-DMOD_CDFT'
         CDFTOBJ='$(CDFTOBJS)'
         CDFTMAK=CDFT_OBJ
         CDFTTAR=1
         echo " - SDFT/CDFT module"
      else
         echo "SDFT/CDFT module not included - depends on DFT module "
      fi
   fi
   #
   #  visualization module
   #
   if [ -n "$VISUALMOD" ]; then
      VISUALFLG='-DMOD_VISUAL'
      VISUALOBJ='$(VISUALOBJS)'
      VISUALMAK=VISUAL_OBJ
      VISUALTAR=1
      echo " - visualization module"
   fi
   #
   #         CAP module
   #
   if [ -n "$CAPMOD" ]; then
         CAPFLG='-DMOD_CAP'
         CAPOBJ='$(CAPOBJS)'
         CAPMAK=CAP_OBJ
         CAPTAR=1
	 F90MODS=ALL_F90MODS
         echo " - CAP module"
    else
        echo "CAP module not is included "
    fi
   #
   # Object oriented fortran90/95 mocularity module
   #
   if [ -n "$OOFMOD" ]; then
         OOF_FLG='-DMOD_OOF'
         OOF_OBJ='$(OOF_OBJS)'
         OOF_MAK=OOF_OBJ
         OOF_TAR=1
	 F90MODS=ALL_F90MODS
         echo " - OOF module - requires Fotran 90/95 compiler"
      else
       #  echo "OOF module not included"
       echo 
   fi
############################################################################
#
#        Add info on (in-)/active Fotran90/95 modularity model
#
############################################################################
  if [ -n "$MODULES" ]; then
     echo "***    Fortran90/95 modules mode is active !   ****"
  fi
#  exit
   #
   # Defining the tarfile that is used for export
   #
   if [ "$TARFIL" = "make" ]; then
      GENTAR=
   fi
   if [ "$TARFIL" = "export" ]; then
      szCurrDir=`pwd`
      szCurrDir=${szCurrDir##*/}
      TARFIL=$szCurrDir.tar
   fi
   echo
}
