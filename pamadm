class dirac_module:
     def __init__(self, flag, message):
         self.flag            = flag
         self.message         = message
         self.is_included     = False
         self.depends_on      = []
         self.directories     = []
         self.files           = []
         self.cppflags        = []
         self.tests           = []
         self.part_of_adm     = True
         self.part_of_release = True
     def add_directory(self, x):
         self.directories.append(x)
     def add_file(self, x):
         self.files.append(x)
     def add_dependency(self, x):
         self.depends_on.append(x)
     def add_cppflag(self, x):
         self.cppflags.append(x)
     def add_test(self, x):
         self.tests.append(x)
     def include(self):
         self.is_included = True
     def exclude(self):
         self.is_included = False
     def take_out_of_adm(self):
         self.part_of_adm = False
     def take_out_of_release(self):
         self.part_of_release = False

