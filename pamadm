# USAGE
#
#
usage()
{
   echo 'Usage: pamadm [flags] tarfile'
   echo '   Flags:'
   echo '     -adm          : Include ALL modules (administrator)'
   echo '     -eri          : Include ERI integral routines'
   echo '     -par          : include parallell version'
   echo '     -rsp          : Include response module'
   echo '     -cc           : Include CCSD module'
   echo '     -tra          : Include 4-index transformation module'
   echo '     -open         : Include open shell module'
   echo '     -spinfree     : Include spinfree modifications'
   echo '     -ci           : Include DIRRCI module'
   echo '     -geo          : Include geometry optimization module'
   echo '     -3.1          : Include DIRAC 3.1 modules'
   echo '     tarfile=make  : only generate new Makefile'
   echo '     tarfile=export: Make DIRAC.new.tar.gz'
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SETUP ALL VARIABLES
#
#
setup()
{
#
#  Administrator needs everything.....
#
   echo
   echo "*** Active modules:"
   echo
   echo_style=sysv
   noclobber=
   EXPORTTAR=1
   if [ -n "$PAMADM" ]; then
      CCMOD=1
      RSPMOD=1
      TRAMOD=1
      ERITAR=1
      PARMOD=1
      PARTAR=1
      OPENMOD=1
      SPFMOD=1
      CIMOD=1
      GEOMOD=1
      echo " - DIRAC administrator ..."
   fi
   #
   #  Release 3.1
   #
   if [ -n "$REL3_1" ]; then
      CCMOD=1
      TRAMOD=1
      CIMOD=1
      PARMOD=1
      PARTAR=1
      OPENMOD=1
      EXPORTTAR=0
      echo " - Release 3.1 ..."
   fi
   #
   #  RELCCSD-module
   #
   if [ -n "$CCMOD" ]; then
      CCFLG='-DMOD_CC'
      CCOBJ='$(CCOBJS)'
      CCMAK=CCM_OBJ
      CCTAR=1
      echo " - Relativistic coupled cluster (RELCCSD)"
   fi
   #
   #  Responsemodule
   #
   if [ -n "$RSPMOD" ]; then
      RSPFLG='-DMOD_RSP'
      RSPOBJ='$(RSPOBJS)'
      RSPMAK=RSP_OBJ
      RSPTAR=1
      echo " - Linear response module (RSP)"
   fi
   #
   #  4index transformation module
   #
   if [ -n "$TRAMOD" ]; then
      TRAFLG='-DMOD_TRA'
      TRAOBJ='$(TRAOBJS)'
      TRAMAK=TRA_OBJ
      TRATAR=1
      echo " - 4-index transformation module (MOLTRA)"
   fi
   #
   #  ERI two-electron integral module
   #
   if [ -n "$ERIMOD" ]; then
      ERIFLG='-DMOD_ERI'
      ERIOBJ='$(ERIOBJS)'
      ERIMAK=ERI_OBJ
      ERITAR=1
      echo " - ERI two-electron integral module"
   fi
   #
   # Open shell module
   #
   if [ -n "$OPENMOD" ]; then
      OPENFLG='-DMOD_OPEN'
      OPENOBJ='$(OPENOBJS)'
      OPENMAK=OPEN_OBJ
      OPENTAR=1
      echo " - Open-shell Dirac-Hartree-Fock module"
   fi
   #
   # Spinfree modifications
   #
   if [ -n "$SPFMOD" ]; then
      SPFFLG='-DMOD_SPF'
      SPFOBJ='$(SPFOBJS)'
      SPFMAK=SPF_OBJ
      SPFTAR=1
      echo " - Spin-free modifications"
   fi
   #
   # DIRRCI Module
   #
   if [ -n "$CIMOD" ]; then
      CIFLG='-DMOD_CI'
      CIOBJ='$(CIOBJS)'
      CIMAK=CI_OBJ
      CITAR=1
      echo " - Relativistic CISD and COSCI (DIRRCI)"
   fi
   #
   # Geometry optimization
   #
   if [ -n "$GEOMOD" ]; then
      GEOFLG='-DMOD_GEO'
      GEOOBJ='$(GEOOBJS)'
      GEOMAK=GEO_OBJ
      GEOTAR=1
      echo " - Geometry optimization module"
   fi
   #
   #
   #
   if [ "$TARFIL" = "make" ]; then
      GENTAR=
   fi
   if [ "$TARFIL" = "export" ]; then
      if [ -e DIRAC.new.tar.gz ]; then
         rm DIRAC.new.tar.gz
      fi
      TARFIL=DIRAC.new
   fi
   echo
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# BACKUP OLD FILES
#
#
backup()
{
   if [ -n "$GENTAR" ]; then
      echo "*** Backing up old files ..." 
      echo
      temp=
      if [ -e DIRAC.new.tar.gz ]; then
         temp="$temp DIRAC.new.tar.gz"
      fi
      if [ -e configure ]; then
         temp="$temp configure"
      fi
      if [ -e export ]; then
         temp="$temp export"
      fi
      if [ -e Makefile ]; then
         temp="$temp Makefile"
      fi
      for file in $temp; do
         echo " - $file --> $file.buf"
         mv $file $file.buf 
      done
   fi
   echo
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# RESTORE AND MAKE TAR
#
#
restore()
{
   make_export
   if [ -n "$GENTAR" ]; then
      #
      # Make tar-file
      #
      echo "*** Making tar-file ..."
      echo
      ./export
      if [ -e DIRAC.new.tar.gz ]; then
         if [ "$TARFIL" != "DIRAC.new" ]; then
            mv DIRAC.new.tar.gz $TARFIL.tar.gz
         fi
      else
         echo "Fatal error: No DIRAC.new.tar.gz"
      fi
      #
      #
      #
      echo "*** Restoring old files ..." 
      echo
      temp=
      if [ -e DIRAC.new.tar.gz.buf ]; then
         temp="$temp DIRAC.new.tar.gz"
      fi
      if [ -e configure.buf ]; then
         temp="$temp configure"
      fi
      if [ -e export.buf ]; then
         temp="$temp export"
      fi
      if [ -e Makefile.buf ]; then
         temp="$temp Makefile"
      fi
      for file in $temp; do
         echo " - $file.buf --> $file"
         mv $file.buf $file
      done
   fi
}
