#
#
# BACKUP OLD FILES
#
#
backup()
{
   if [ -n "$GENTAR" ]; then
      echo "*** Backing up old files ..." 
      echo
      if [  ! -d backup ]; then
         mkdir backup
      fi
#     Take three backup copies of the derived files and the tarfile. This should be sufficient.
      for i in $TARFIL.gz configure export Makefile ; do
          if [ -f "${i}" ]; then
              cd backup
              if [ -f "${i}.1" ]; then mv -f "${i}.1" "${i}.2"; fi
              if [ -f "${i}.0" ]; then mv -f "${i}.0" "${i}.1"; fi
              if [ -f ../"${i}" ]; then cp -f ../"${i}" "${i}.0" ; fi
              cd ..
          fi
      done
      echo
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# RESTORE AND MAKE TAR
#
#
restore()
{
   make_export
   if [ -n "$GENTAR" ]; then
      #
      # Make tar-file
      #
      echo "*** Making tar-file ..."
      echo
      ./export
      #
#     In case that a file is missing or has zero length : restore the old file.
      for i in $TARFIL.gz configure export Makefile ; do
          if [ ! -s "${i}" ]; then
              echo "Warning : Restoring old file ${i} ..." 
              cd backup
              if [ -f "${i}.0" ]; then mv -f "${i}.0" ../"${i}" ; fi
              if [ -f "${i}.1" ]; then mv -f "${i}.1" "${i}.0"; fi
              if [ -f "${i}.2" ]; then mv -f "${i}.2" "${i}.1"; fi
              cd ..
          fi
      done
      echo
   fi
}
