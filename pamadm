class dirac_test:
     def __init__(self, directory, fine_with_mpi = True):
         self.directory     = directory
         self.fine_with_mpi = fine_with_mpi
     def print_directory(self):
         print self.directory

class short_test(dirac_test):
      """
      short test
      """
      def type(self):
          return 'short'

class medium_test(dirac_test):
      """
      medium test
      """
      def type(self):
          return 'medium'

class long_test(dirac_test):
      """
      long test
      """
      def type(self):
          return 'long'

class dirac_module:
     def __init__(self, flag, message):
         self.flag            = flag
         self.message         = message
         self.is_included     = False
         self.depends_on      = []
         self.directories     = []
         self.files           = []
         self.cppflags        = []
         self.tests           = []
         self.part_of_adm     = True
         self.part_of_release = True
     def add_directory(self, x):
         self.directories.append(x)
     def add_file(self, x):
         self.files.append(x)
     def add_dependency(self, x):
         self.depends_on.append(x)
     def add_cppflag(self, x):
         self.cppflags.append(x)
     def add_test(self, x):
         self.tests.append(x)
     def include(self):
         self.is_included = True
     def exclude(self):
         self.is_included = False
     def take_out_of_adm(self):
         self.part_of_adm = False
     def take_out_of_release(self):
         self.part_of_release = False

def callback_include(option, opt, value, parser):
    dirac_modules[str(option)[2:]].include()

