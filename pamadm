# based on: old pamadm written by Trond Saue, Thomas Enevoldsen, Joern Thyssen, and others
#           and prepare_release.sh written by Ulf Ekstrom
#
# examples: print available options
#           ./pamadm -h
#
#           select all modules that are part of adm
#           ./pamadm --adm
#
#           select all modules that are part of adm except modules foo and bar
#           ./pamadm --adm --minus --foo --bar
#
#           select some modules
#           ./pamadm --foo --bar
#
#           select modules for release and export
#           ./pamadm --release --export=DIRAC10
#
#           select modules for release without exporting them
#           ./pamadm --release

