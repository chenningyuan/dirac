#
# Parse arguments
#
if [ -z "$1" ]; then
   usage
   exit 1
fi
####
GENTAR=1
while [ -n "$1" ]; do
   case "$1" in
      -adm|-ad|-a)
         PAMADM=1
         ;;
      -dft)
         DFTMOD=1
         ;;
      -esr|-es)
         ESRMOD=1
         ;;
      -xpp|-xp)
         XPPMOD=1
         ;;
      -fmm|-fm)
         ERIMOD=1
         DNFMOD=1
         FMMMOD=1
	 MODULES=1
         ;;
      -densfit|-dnf)
         DNFMOD=1
         ERIMOD=1
         ;;
      -largemolecules|-lm|-l)
         LARGEMOL=1
         ;;
      -eri|-er|-e)
         ERIMOD=1
         ;;
      -krmc|-krm|-kr|-k)
         KRMCMOD=1
         ;;
      -emb|-embedding)
         EMBMOD=1
         # echo "embedding with fortran90/95 modules is on !!!"
	 MODULES=1
         ;;
      -cdft)
         CDFTMOD=1
         ;;
      -visual)
         VISUALMOD=1
         ;;
      -cap)
         CAPMOD=1
#      ... now in Fotran 90 !
         OOFMOD=1
	 MODULES=1
         ;;
      -oof)
         OOFMOD=1
	 MODULES=1
         ;;
      -*)
         echo "Option \"$1\" not recognized."
         usage
         exit 1
         ;;
      *)
         TARFIL=$1
         ;;
   esac
   shift
done
