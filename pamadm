#
#
# USAGE
#
#
usage()
{
   echo 'Usage: pamadm [flags] tarfile'
   echo '   Flags:'
   echo '     -adm          : Include ALL modules (administrator)'
   echo '     -dft          : Include DFT module'
   echo '     -eri          : Include ERI integral routines'
   echo '     -densfit      : Include density fitting module'
   echo '     -esr          : Include ESR property module'
   echo '     -xpp          : Include PP excitation energy module'
   echo '     -xqr          : Include quadratic response module'
   echo '     -dft          : Include DFT module'
   echo '     -krmc         : Include KR-MCSCF and LUCIAREL modules'
   echo '     tarfile=make  : only generate new Makefile'
   echo '     tarfile=export: Make DIRAC.new.tar.gz'
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SETUP ALL VARIABLES
#
#
setup()
{
#
#  Administrator needs everything.....
#
   echo
   echo "*** Active modules:"
   echo
   echo_style=sysv
   unset noclobber
   EXPORTTAR=1
   if [ -n "$PAMADM" ]; then
      ERITAR=1
      ESRMOD=1
      XQRMOD=1
      XPPMOD=1
      DFTMOD=1
      KRMCMOD=1
      echo " - DIRAC administrator ..."
   fi
   #
   #  DFT
   #
   if [ -n "$DFTMOD" ]; then
      DFTFLG='-DMOD_DFT'
      DFTOBJ='$(DFTOBJS) $(DFTOBJS_C)'
      DFTMAK=DFT_OBJ
      DFTTAR=1
      echo " - DFT module (DFT)"
   fi
   #
   #  ESR
   #
   if [ -n "$ESRMOD" ]; then
      ESRFLG='-DMOD_ESR'
      ESROBJ='$(ESROBJS)'
      ESRMAK=ESR_OBJ
      ESRTAR=1
      echo " - ESR property module (ESR)"
   fi
   #
   #  XQR
   #
   if [ -n "$XQRMOD" ]; then
      XQRFLG='-DMOD_XQR'
      XQROBJ='$(XQROBJS)'
      XQRMAK=XQR_OBJ
      XQRTAR=1
      echo " - Quadratic reponse module (XQR)"
   fi
   #
   #  XPP
   #
   if [ -n "$XPPMOD" ]; then
      XPPFLG='-DMOD_XPP'
      XPPOBJ='$(XPPOBJS)'
      XPPMAK=XPP_OBJ
      XPPTAR=1
      echo " - Excitation energy module (XPP)"
   fi
   #
   #  KRMC and LUCIAREL
   #
   if [ -n "$KRMCMOD" ]; then
      KRMCFLG='-DMOD_KRMC'
      KRMCOBJ='$(KRMC_FOBJS) $(KRMC_COBJS)'
      KRMCMAK=KRMC_OBJ
      LUCIARELOBJ='$(LUCIARELOBJS)'
      LUCIARELMAK=LUCIAREL_OBJ
      KRMCTAR=1
      echo " - KR-MCSCF and LUCIAREL modules (KRMC)"
   fi
   #
   #  ERI two-electron integral module
   #
   if [ -n "$ERIMOD" ]; then
      ERIFLG='-DMOD_ERI'
      ERIOBJ='$(ERIOBJS)'
      ERIMAK=ERI_OBJ
      ERITAR=1
      echo " - ERI two-electron integral module"
   fi
   #
   #  DNF density fitting module
   #
   if [ -n "$DNFMOD" ]; then
      DNFFLG='-DMOD_DNF'
      DNFOBJ='$(DNFOBJS)'
      DNFMAK=DNF_OBJ
      DNFTAR=1
      echo " - DNF density fitting module"
   fi
   #
   # Defining the tarfile that is used for export
   #
   if [ "$TARFIL" = "make" ]; then
      GENTAR=
   fi
   if [ "$TARFIL" = "export" ]; then
      szCurrDir=`pwd`
      szCurrDir=${szCurrDir##*/}
      TARFIL=$szCurrDir.tar
   fi
   echo
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# BACKUP OLD FILES
#
#
backup()
{
   if [ -n "$GENTAR" ]; then
      echo "*** Backing up old files ..." 
      echo
      if [  ! -d backup ]; then
         mkdir backup
      fi
#     Take three backup copies of the derived files and the tarfile. This should be sufficient.
      for i in $TARFIL.gz configure export Makefile ; do
          if [ -f "${i}" ]; then
              cd backup
              if [ -f "${i}.1" ]; then mv -f "${i}.1" "${i}.2"; fi
              if [ -f "${i}.0" ]; then mv -f "${i}.0" "${i}.1"; fi
              if [ -f ../"${i}" ]; then cp -f ../"${i}" "${i}.0" ; fi
              cd ..
          fi
      done
      echo
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# RESTORE AND MAKE TAR
#
#
restore()
{
   make_export
   if [ -n "$GENTAR" ]; then
      #
      # Make tar-file
      #
      echo "*** Making tar-file ..."
      echo
      ./export
      #
#     In case that a file is missing or has zero length : restore the old file.
      for i in $TARFIL.gz configure export Makefile ; do
          if [ ! -s "${i}" ]; then
              echo "Warning : Restoring old file ${i} ..." 
              cd backup
              if [ -f "${i}.0" ]; then mv -f "${i}.0" ../"${i}" ; fi
              if [ -f "${i}.1" ]; then mv -f "${i}.1" "${i}.0"; fi
              if [ -f "${i}.2" ]; then mv -f "${i}.2" "${i}.1"; fi
              cd ..
          fi
      done
      echo
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# MAKE EXPORT SHELL SCRIPT
#
#
make_export()
{
   echo "*** Making ./export"
   echo
   #
   # Basis files
   #
   cat <<EOF> ./export
#!/bin/sh
   szCurrDir=\`pwd\`
   szCurrDir=\${szCurrDir##*/}
   cd ..
   echo " - adding files to tar-achive..."
   echo
# First add the files that are at the main level or are special.
   tar cvf \$szCurrDir.tar \\
     \$szCurrDir/configure \\
     \$szCurrDir/config.sub \\
     \$szCurrDir/config.guess \\
     \$szCurrDir/config.status \\
     \$szCurrDir/C90lib.cld \\
     \$szCurrDir/crilib.cld \\
     \$szCurrDir/pam.in \\
     \$szCurrDir/pam.1 \\
     \$szCurrDir/Makefile \\
     \$szCurrDir/doc/doc.html \\
     \$szCurrDir/include/*.h \\
     \$szCurrDir/main/*.h \\
     \$szCurrDir/main/*.head \\
     \$szCurrDir/main/*.struct \\
     \$szCurrDir/test \\
     \$szCurrDir/testlast \\
     \$szCurrDir/basis \\
     \$szCurrDir/utils 2> export.log
# Now add the standard files from each active directory (module).
   for module in $dirs; do
      MDir=\$szCurrDir/\$module
      tar rvf \$szCurrDir.tar \$MDir/*.c \$MDir/*.F \$MDir/*.f90 \$MDir/*.inc \$MDir/*.h \$MDir/Makefile \$MDir/include 2>> export.log
      rm export.log
   done
EOF
   #
   # Active modules
   #
   if [ "$DFTTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/dft/{*.c,*.F,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$DNFTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/densfit/{*.F,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$ERITAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/eri/{*.F,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$ESRTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/prp/esr/{*.F,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$XPPTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/prp/xpp/{*.F,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$KRMCTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/krmc/{*.F,Makefile.in} 2>> export.log
      tar rvf \$szCurrDir.tar \$szCurrDir/luciarel/{*.c,*.f,*.F,Makefile.in,*.inc,*.c} 2>> export.log
EOF
   fi
   if [ "$XQRTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/prp/xqr/{*.F,*.h,Makefile,include} 2>> export.log
EOF
   fi
# A DIRAC administrator should have everything
   if [ "$PAMADM" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/pamadm \$szCurrDir/WHATSNEW 2>> export.log
EOF
   fi
   if [ "$EXPORTTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/export 2>> export.log
EOF
   fi
   cat <<EOF>> ./export
      echo " - gzip'ing archive..."
      echo
      gzip -9v \$szCurrDir.tar
      mv \$szCurrDir.tar.gz \$szCurrDir/\$szCurrDir.tar.gz
EOF
   chmod +x ./export
}
