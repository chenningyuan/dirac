class dirac_module:
     def __init__(self, flag, message):
         self.flag            = flag
         self.message         = message
         self.is_included     = False
         self.depends_on      = []
         self.directories     = []
         self.files           = []
         self.cppflags        = []
         self.tests           = []
         self.part_of_adm     = True
         self.part_of_release = True
     def add_directory(self, x):
         self.directories.append(x)
     def add_file(self, x):
         self.files.append(x)
     def add_dependency(self, x):
         self.depends_on.append(x)
     def add_cppflag(self, x):
         self.cppflags.append(x)
     def add_test(self, x):
         self.tests.append(x)
     def include(self):
         self.is_included = True
     def exclude(self):
         self.is_included = False
     def take_out_of_adm(self):
         self.part_of_adm = False
     def take_out_of_release(self):
         self.part_of_release = False

def callback_include(option, opt, value, parser):
    dirac_modules[str(option)[2:]].include()

def provide_star_basisfile_names():
    '''
    Restore basis set files with "*" in name
    (this is to be done on non-Windows machines)
    '''
    # : ls basis_dalton/*star
    basfile={   \
       '3-21++G-star':'3-21++G*',\
       '3-21G-star':'3-21G*',\
       '6-311+G-star':'6-311+G*',\
       '6-311G-star':'6-311G*', \
       '6-311++G-star-star':'6-311++G**',\
       '6-311G-star-star':'6-311G**',\
       '6-31++G-star':'6-31++G*', \
       '6-31+G-star':'6-31+G*',\
       '6-31G-star':'6-31G*',\
       '6-31++G-star-star':'6-31++G**',\
       '6-31G-star-star':'6-31G**' \
       }
    basdir="basis_dalton"+"/" # basis set directory
    for basfilename in basfile:
        src=basdir+basfilename
        dest=basdir+basfile[basfilename]
        shutil.copy(src,dest)

