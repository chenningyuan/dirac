      tar rvf \$szCurrDir.tar \$szCurrDir/luciarel/{*.c,*.F,*.F90,*.f90,Makefile.in,*.inc,*.c} 2>> export.log
EOF
   fi
   if [ "$OOF_TAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/oof/{*.F,*.F90,*.f90,Makefile.in} 2>> export.log
      tar rvf \$szCurrDir.tar \$szCurrDir/oof/{*.c,*.F,*.F90,*.f90,Makefile.in,*.inc,*.c} 2>> export.log
EOF
   fi
# A DIRAC administrator should have everything
   if [ "$PAMADM" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/pamadm \$szCurrDir/WHATSNEW 2>> export.log
EOF
   fi
   if [ "$EXPORTTAR" ]; then
      cat <<EOF>> ./export
EOF
   fi
   cat <<EOF >> ./export
      echo " - gzip'ing archive..."
      echo
      gzip -9v \$szCurrDir.tar
      mv \$szCurrDir.tar.gz \$szCurrDir/\$szCurrDir.tar.gz
EOF
   chmod +x ./export
}

rmline()
{
    #Remove the line $2 from file $1
    grep -v -- "$2" <"$1" >"$1.tmp"
    mv "$1.tmp" "$1"
}

