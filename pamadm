#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# MAIN SCRIPT
#
#
#
# Parse arguments
#
if [ -z "$1" ]; then
   usage
   exit 1
fi
GENTAR=1
while [ -n "$1" ]; do
   case "$1" in
      -adm|-ad)
         PAMADM=1
         ;;
      -cc)
         CCMOD=1
         ;;
      -par|-pa|-p)
         PARMOD=1
         PARTAR=1
         ;;
      -rsp|-rs|-r)
         RSPMOD=1
         ;;
      -tra|-tr)
         TRAMOD=1
         ;;
      -eri|-er|-e)
         ERIMOD=0
         ;;
      -open|-ope|-op)
         OPENMOD=1
         ;;
      -spinfree|-spinfre|-spinfr|-spinf|-spin|-spi|-sp|-s)
         SPFMOD=1
         ;;
      -ci)
         CIMOD=1
         ;;
      -geo|-ge)
         GEOMOD=1
         ;;
      -3.1)
         REL3_1=1
         ;;
      -*)
         echo "Option \"$1\" not recognized."
         usage
         exit 1
         ;;
      *)
         TARFIL=$1
         ;;
   esac
   shift
done
