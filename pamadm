usage()
{
   echo 'Usage: pamadm [flags] [tarfile]'
   echo '   Flags:'
   echo '     -adm             : Include ALL modules (administrator)'
   echo '     -dft             : Include DFT module'
   echo '     -eri             : Include ERI integral routines'
   echo '     -densfit         : Include density fitting module'
   echo '     -largemolecules  : Increases commom blocks to handle more atoms and basis sets'
   echo '     -fmm             : Include fast multipole method'
   echo '     -esr             : Include ESR property module'
   echo '     -xpp             : Include PP excitation energy and STEX modules'
   echo '     -xml             : Include XML input/output module'
   echo '     -krmc            : Include KR-MCSCF and LUCIAREL modules'
   echo '     -emb             : Include ab initio/DFT-embedding module (with the F90/95 modularity feature)'
   echo '     -visual          : Include visualization module'
   echo '     -aoresponse      : Include AO response module'
   echo '     -matrixop        : Include matrix operations module'
   echo '     -autodiff        : Include autodiff module'
   echo '     -cap             : Include CAP module'
   echo '     -hscc            : Include interface for the (external) HSMRCC code together with its objects'
   echo '     -hsfs            : Include higher external Higher sector FSCC codes together with objects'
   echo '     -qdots           : Include Quantum Dots functionality (artificial atom)'
   echo '     -ihfscc          : Include Intermediate Hamiltonian functionality to FSCC code'
   echo '     -amfi            : Include the AMFI functionality into DIRAC'
   echo '     -london          : Include London orbitals functionality for magnetic properties'
   echo '     -oof             : Include object oriented modularity of Fotran 90/95'
   echo '     -adc             : Include ADC electron propagator module'
   echo '     -ecp             : Include ARGOS ECP module'
   echo '     -log             : Enable matrix logging in Matlab format'
   echo '     tarfile          : Name of export archive to create (if any)'
   echo '     tarfile=export   : Make DIRAC.new.tar.gz'
}
