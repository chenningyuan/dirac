        list_of_free_fortran_sources.append(source)
    for source in glob.glob('%s/*.c' % directory):
        source = string.replace(source, '\\', '/')  # fix cmake on Windows
        list_of_c_sources.append(source)
    for source in glob.glob('%s/*.h' % directory):
        # this is only important for "make release" it does not have to work on windows
        list_of_include_files.append(source)
    for source in glob.glob('%s/*.inc' % directory):
