# package tests
# =============

f = open('test/runtest', 'w')

s = '''
################################################
# file is automatically generated by pamadm #
################################################
'''
f.write(s)

for type in ['short', 'medium', 'long']:
    s = ''
    for test in vital_tests:
        if test.type() == type and test.fine_with_mpi:
           s += ' %s' % test.directory
    for module in dirac_modules:
        if dirac_modules[module].is_included:
           for test in dirac_modules[module].tests:
               if test.type() == type and test.fine_with_mpi:
                  s += ' %s' % test.directory
    f.write('%s_parallel="%s"\n' % (type, s))
    s = ''
    for test in vital_tests:
        if test.type() == type and not test.fine_with_mpi:
           s += ' %s' % test.directory
    for module in dirac_modules:
        if dirac_modules[module].is_included:
           for test in dirac_modules[module].tests:
               if test.type() == type and not test.fine_with_mpi:
                  s += ' %s' % test.directory
    f.write('%s_onlyseq="%s"\n' % (type, s))

s = '''
long_test="      $short_parallel $short_onlyseq   $medium_parallel $medium_onlyseq $long_parallel $long_onlyseq"
long_partest="   $short_parallel                  $medium_parallel                 $long_parallel"
medium_test="    $short_parallel $short_onlyseq   $medium_parallel $medium_onlyseq"
medium_partest=" $short_parallel                  $medium_parallel"
short_test="     $short_parallel $short_onlyseq"
short_partest="  $short_parallel"
'''
f.write(s)

f.close()

os.system("cat test/runtest.in >> test/runtest")
os.system("chmod 700 test/runtest")


# export dirac to tar.gz file
# ===========================

if options.tarfile != None:
   scratch_dir = 'DIRAC10'

#  create scratch dir
   os.mkdir(scratch_dir)

#  copy all vital directories and files to scratch dir
   for directory in vital_directories:
       shutil.copytree(directory, scratch_dir + '/' + directory)
   for file in vital_files:
#      need to copy with parent, don't know how to do it in python
       command = 'cp --parent %s %s' % (file, scratch_dir)
       os.system(command)

#  preventively remove all module directories in scratch dir (example is prp/esr which is copied along with prp and maybe not wanted)
   for module in dirac_modules:
       for directory in dirac_modules[module].directories:
           shutil.rmtree(scratch_dir + '/' + directory, True)

#  copy active module directories to scratch dir
   for module in dirac_modules:
       if dirac_modules[module].is_included:
          for directory in dirac_modules[module].directories:
              shutil.copytree(directory, scratch_dir + '/' + directory)

#  remove all code that is not supposed to be shipped
   delete_flags = ''
   for module in dirac_modules:
       if not dirac_modules[module].is_included:
          for cppflag in dirac_modules[module].cppflags:
              delete_flags += '-U%s ' % cppflag
   if delete_flags != '':
      find_command = "find %s -name '*.F' -o -name '*.f90' -o -name '*.F90' -o -name '*.c'" % scratch_dir
      command = "./utils/cppp.py %s `%s`" % (delete_flags, find_command)
      os.system(command)

#  remove reference files that can be fetched from the dirac website
   shutil.rmtree(scratch_dir + '/basis/reference_unedited')

#  copy tests to scratch dir
   for test in vital_tests:
       d = 'test/' + test.directory
       shutil.copytree(d, scratch_dir + '/' + d)
   for module in dirac_modules:
       if dirac_modules[module].is_included:
          for test in dirac_modules[module].tests:
              d = 'test/' + test.directory
              shutil.copytree(d, scratch_dir + '/' + d)

#  run the vacuum cleaner: remove all junk files in exporter DIRAC
   os.system("rm -f  `find %s -name '*.o'`"   % scratch_dir)
   os.system("rm -f  `find %s -name '*.r'`"   % scratch_dir)
   os.system("rm -f  `find %s -name '*.i'`"   % scratch_dir)
   os.system("rm -f  `find %s -name '*.opt'`" % scratch_dir)
   os.system("rm -f  `find %s -name '*.s'`"   % scratch_dir)
   os.system("rm -f  `find %s -name '*.p'`"   % scratch_dir)
   os.system("rm -f  `find %s -name '*.fc'`"  % scratch_dir)
   os.system("rm -f  `find %s -name '*~'`"    % scratch_dir)
   os.system("rm -rf `find %s -name '.svn'`"  % scratch_dir)

#  remove files that are not supposed to be shipped
   for x in do_not_release:
       os.system("rm -rf %s/%s"  % (scratch_dir, x))

#  create tar.gz
   command = 'tar -czf %s %s' % (options.tarfile, scratch_dir)
   os.system(command)

#  remove scratch dir
   shutil.rmtree(scratch_dir)
