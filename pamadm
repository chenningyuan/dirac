usage()
{
   echo 'Usage: pamadm [flags] [tarfile]'
   echo '   Flags:'
   echo '     -adm             : Include ALL modules (administrator)'
   echo '     -dft             : Include DFT module'
   echo '     -eri             : Include ERI integral routines'
   echo '     -densfit         : Include density fitting module'
   echo '     -largemolecules  : Increases commom blocks to handle more atoms and basis sets'
   echo '     -fmm             : Include fast multipole method'
   echo '     -esr             : Include ESR property module'
   echo '     -xpp             : Include PP excitation energy and STEX modules'
   echo '     -xml             : Include XML input/output module'
   echo '     -krmc            : Include KR-MCSCF and LUCIAREL modules'
   echo '     -emb             : Include ab initio/DFT-embedding module'
   echo '     -visual          : Include visualization module'
   echo '     -aoresponse      : Include AO response module'
   echo '     -matrixop        : Include matrix operations module'
   echo '     -xcfun           : Include xcfun module'
   echo '     -cap             : Include CAP module'
   echo '     -hscc            : Include interface for the (external) HSMRCC code together with its objects'
   echo '     -hsfs            : Include higher external Higher sector FSCC code'
   echo '     -hsfsdyn         : Include higher external Higher sector FSCC code - dynamic allocation version.'
   echo '     -qdots           : Include Quantum Dots functionality (artificial atom)'
   echo '     -ihfscc          : Include Intermediate Hamiltonian functionality to FSCC code'
   echo '     -amfi            : Include the AMFI functionality into DIRAC'
   echo '     -london          : Include London orbitals functionality for magnetic properties'
   echo '     -oof             : Include object oriented modularity of Fotran 90/95'
   echo '     -adc             : Include ADC electron propagator module'
   echo '     -ecp             : Include ARGOS ECP module'
   echo '     -srdft           : Include srDFT module'
   echo '     -log             : Enable matrix logging in Matlab format'
   echo '     tarfile          : Name of export archive to create (if any)'
   echo '     tarfile=export   : Make DIRAC.new.tar.gz'
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SETUP ALL VARIABLES
#
#
setup()
{

#set $install_dir
install_dir=`pwd`

#
#  Administrator needs everything.....
#
MODS_MESSAGE=
   echo
   echo "Active modules:"
   echo
   echo_style=sysv
   unset noclobber
   EXPORTTAR=1
   if [ -n "$PAMADM" ]; then
      ERIMOD=1
      DNFMOD=1
      ESRMOD=1
      XPPMOD=1
      DFTMOD=1
      KRMCMOD=1
      VISUALMOD=1
      IHFSCCMOD=1
      # by deactivating AMFI you save cca 17MB of static alloc (with ILP64)
      AMFIMOD=1
      LONDONMOD=1
      IHFSCCMOD=1
      ADCMOD=1
      MATRIX_OPERATIONS_MOD=1
      AORESPONSEMOD=1
      EMBMOD=1
# LV: inform me before taking EMBMOD out of the -adm options !!!
# MI  - needs to be fixed for gfortran !!!
#      ECPMOD=1
       THIS_MOD_MESSAGE=" - DIRAC administrator ..."
       echo $THIS_MOD_MESSAGE
       MODS_MESSAGE=$MODS_MESSAGE"# "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  DFT
   #
   if [ -n "$DFTMOD" ]; then
      DFTFLG='-DMOD_DFT'
      DFTTAR=1
      THIS_MOD_MESSAGE=" - DFT module (DFT), $DFTFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  ESR
   #
   if [ -n "$ESRMOD" ]; then
      ESRFLG='-DMOD_ESR'
      ESRTAR=1
      THIS_MOD_MESSAGE=" - ESR property module (ESR), $ESRFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  XPP and STEX
   #
   if [ -n "$XPPMOD" ]; then
      XPPFLG='-DMOD_XPP -DMOD_STEX'
      XPPTAR=1
      THIS_MOD_MESSAGE=" - Excitation energy module (XPP and STEX), $XPPFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  KRMC and LUCIAREL
   #
   if [ -n "$KRMCMOD" ]; then
      KRMCFLG='-DMOD_KRMC'
      KRMCTAR=1
      THIS_MOD_MESSAGE=" - KR-MCSCF and LUCIAREL modules (KRMC), $KRMCFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  Increase common block sizes to handle more centers and basis sets
   #
   if [ -n "$LARGEMOL" ]; then
      LRGMOLFLG='-DLARGE_MOLECULES'
      THIS_MOD_MESSAGE=" - Increasing common block sizes to handle larger systems, $LRGMOLFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  ERI two-electron integral module
   #
   if [ -n "$ERIMOD" ]; then
      ERIFLG='-DMOD_ERI'
      ERITAR=1
      THIS_MOD_MESSAGE=" - ERI two-electron integral module, $ERIFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  DNF density fitting module
   #
   if [ -n "$DNFMOD" ]; then
      DNFFLG='-DMOD_DNF'
      DNFTAR=1
      THIS_MOD_MESSAGE=" - DNF density fitting module, $DNFFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  FMM  module
   #
   if [ -n "$FMMMOD" ]; then
      FMMFLG='-DMOD_FMM'
      FMMTAR=1
      THIS_MOD_MESSAGE=" - Fast Multipole Method (fmm) module, $FMMFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  ab initio/DFT embedding module
   #
   if [ -n "$EMBMOD" ]; then
      EMBFLG='-DMOD_EMB'
      EMBTAR=1
      THIS_MOD_MESSAGE=" - ab initio/DFT embedding module, $EMBFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  XML
   #
   if [ -n "$XMLMOD" ]; then
      XMLFLG='-DMOD_XML'
      XMLTAR=1
      THIS_MOD_MESSAGE=" - XML input/output module, $XMLFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  ADC electron propagator module
   #
   if [ -n "$ADCMOD" ]; then
      ADCFLG='-DMOD_ADC'
      ADCTAR=1
      THIS_MOD_MESSAGE=" - ADC electron propagator module, $ADCFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  ECP module
   #
   if [ -n "$ECPMOD" ]; then
      ECPFLG='-DMOD_ECP'
      ECPTAR=1
      THIS_MOD_MESSAGE=" - ECP argos module, $ECPFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  visualization module
   #
   if [ -n "$VISUALMOD" ]; then
      VISUALFLG='-DMOD_VISUAL'
      VISUALTAR=1
      THIS_MOD_MESSAGE=" - visualization module, $VISUALFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  AO response module
   #
   if [ -n "$AORESPONSEMOD" ]; then
      AORESPONSEFLG='-DMOD_AORESPONSE'
      AORESPONSETAR=1
      THIS_MOD_MESSAGE=" - AO response module, $AORESPONSEFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi

#  matrix operations
   if [ -n "$MATRIX_OPERATIONS_MOD" ]; then
      MATRIX_OPERATIONS_FLG='-DMOD_MATRIX_OPERATIONS'
      MATRIX_OPERATIONS_TAR=1
      THIS_MOD_MESSAGE=" - matrix operations module, $MATRIX_OPERATIONS_FLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi

#  xcfun
   if [ -n "$XCFUN_MOD" ]; then
      XCFUN_FLG='-DMOD_XCFUN'
      THIS_MOD_MESSAGE=" - xcfun module, $XCFUN_FLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi

#
#      CAP module
#
   if [ -n "$CAPMOD" ]; then
      CAPFLG='-DMOD_CAP'
      CAPTAR=1
      THIS_MOD_MESSAGE=" - CAP module, $CAPFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
    fi
   #
   #   IHFSCCSD functionality
   #
   if [ -n "$IHFSCCMOD" ]; then
      IHFSCCFLG='-DMOD_IHFSCC'
      THIS_MOD_MESSAGE=" - IHFSCC code enabled, $IHFSCCFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
    fi

   #
   #  AMFI functionality
   #
   if [ -n "$AMFIMOD" ]; then
      AMFIFLG='-DMOD_AMFI'
      THIS_MOD_MESSAGE=" - AMFI functionality enabled, $AMFIFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   # London orbitals 
   #
   if [ -n "$LONDONMOD" ]; then
      LONDONFLG='-DMOD_LONDON'
      THIS_MOD_MESSAGE=" - London atomic orbitals enabled, $LONDONFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #   HSMRCC Dirac-interface module
   #
   # delete the old file
   if [ -f hsmrcc/hsmrcc_external/Makefile.hsmrcc ]; then
    /bin/rm -r hsmrcc/hsmrcc_external/Makefile.hsmrcc
   fi
   if [ -n "$HSCCMOD" ]; then
      HSCCFLG='-DMOD_HSCC'
      HSCCTAR=1
     # delete the old file
     # if [ -f hsmrcc/hsmrcc_external/Makefile.hsmrcc ]; then
     #  /bin/rm -r hsmrcc/hsmrcc_external/Makefile.hsmrcc
     # fi
      cp hsmrcc/hsmrcc_external/Makefile.hsmrcc.in  hsmrcc/hsmrcc_external/Makefile.hsmrcc || \
      (echo "Error exit: hsmrcc/hsmrcc_external/Makefile.hsmrcc not activated !"; exit 1)

      # take care of the second quantization module
      if [ -f hsmrcc/second_quant/Makefile.secquant ]; then
	   /bin/rm -r hsmrcc/second_quant/Makefile.secquant
      fi
      cp hsmrcc/second_quant/Makefile.secquant.in  hsmrcc/second_quant/Makefile.secquant || \
      (echo "Error exit: hsmrcc/second_quant/Makefile.secquant not activated !"; exit 1)

      THIS_MOD_MESSAGE=" - HSMRCC interface module, plus own HSMRCC+sec.quantiz. routines, active Makefile.hsmrcc, $HSCCFLG "
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   #  Higher Sector Fock-space (HSFS) Coupled Cluster module 
   #
   #        delete first the old file
   if [ -f hsmrcc/high_sect_fscc_external/Makefile.hsfs ]; then
     /bin/rm -r hsmrcc/high_sect_fscc_external/Makefile.hsfs
   fi
   if [ -n "$HSFSMOD" ]; then
         HSFSFLG='-DMOD_HSFS'
         HSFSTAR=1
         if [ -n "$HSFSDYNMOD" ]; then
            # add important preprocessor flag
            HSFSFLG=$HSFSFLG' -DHSFS_DYN_ALLOC'
         fi
         cp hsmrcc/high_sect_fscc_external/Makefile.hsfs.in  hsmrcc/high_sect_fscc_external/Makefile.hsfs || \
         (echo "Error exit: hsmrcc/high_sect_fscc/Makefile.hsfs not activated !"; exit 1)

         if [ -n "$HSFSDYNMOD" ]; then
           THIS_MOD_MESSAGE=" - HS FS CC mode with dynamic allocations active, actived Makefile.hsfs, $HSFSFLG "
           echo $THIS_MOD_MESSAGE
           MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
         else
           THIS_MOD_MESSAGE=" - HS FS CC mode with static allocations active, actived Makefile.hsfs, $HSFSFLG"
           echo $THIS_MOD_MESSAGE
           MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
         fi
   fi  
   #
   #  Dirac Quantum Dots modification
   #
   if [ -n "$QDOTSMOD" ]; then
         QDOTSFLG='-DMOD_QDOTS'
        # QDOTSTAR=1
         THIS_MOD_MESSAGE=" - Quantum Dots (artificial atom) enabled"
         echo $THIS_MOD_MESSAGE
         MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   # Object oriented fortran90/95 mocularity module
   #
   if [ -n "$OOFMOD" ]; then
         OOF_FLG='-DMOD_OOF'
         OOF_TAR=1
         THIS_MOD_MESSAGE=" - OOF module"
         echo $THIS_MOD_MESSAGE
         MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
      else
       #  echo "OOF module not included"
       echo 
   fi
#  srDFT
   if [ -n "$SRDFTMOD" ]; then
      SRDFT_FLG='-DMOD_SRDFT'
      SRDFT_TAR=1
      DFTFLG='-DMOD_DFT'
      DFTTAR=1
      KRMCFLG='-DMOD_KRMC'
      KRMCTAR=1
      THIS_MOD_MESSAGE=" - srDFT module (implies DFT and KRMC),$SRDFT_FLG, $DFTFLG, $KRMCFLG"
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi

   if [ -n "$LOGMOD" ]; then
      LOG_FLG=-DMOD_LOG
      THIS_MOD_MESSAGE=' - Will log interesting matrices in matlab format (very verbose!), $LOG_FLG '
      echo $THIS_MOD_MESSAGE
      MODS_MESSAGE=$MODS_MESSAGE"#   "$THIS_MOD_MESSAGE"\n"
   fi
   #
   # Defining the tarfile that is used for export
   #
   if [ "$TARFIL" = "make" -o -z "$TARFIL" ]; then
      GENTAR=
   fi
   if [ "$TARFIL" = "export" ]; then
      szCurrDir=`pwd`
      szCurrDir=${szCurrDir##*/}
      TARFIL=$szCurrDir.tar
   fi
   echo
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# BACKUP OLD FILES
#
#
backup()
{
   if [ -n "$GENTAR" ]; then
      echo "*** Backing up old files ..." 
      echo
      if [  ! -d backup ]; then
         mkdir backup
      fi
#     Take three backup copies of the derived files and the tarfile. This should be sufficient.
      for i in $TARFIL.gz configure export Makefile ; do
          if [ -f "${i}" ]; then
              cd backup
              if [ -f "${i}.1" ]; then mv -f "${i}.1" "${i}.2"; fi
              if [ -f "${i}.0" ]; then mv -f "${i}.0" "${i}.1"; fi
              if [ -f ../"${i}" ]; then cp -f ../"${i}" "${i}.0" ; fi
              cd ..
          fi
      done
      echo
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# RESTORE AND MAKE TAR
#
#
restore()
{
   make_export
   if [ -n "$GENTAR" ]; then
      #
      # Make tar-file
      #
      echo "*** Making tar-file ..."
      echo
      ./export
      #
#     In case that a file is missing or has zero length : restore the old file.
      for i in $TARFIL.gz configure export Makefile ; do
          if [ ! -s "${i}" ]; then
              echo "Warning : Restoring old file ${i} ..." 
              cd backup
              if [ -f "${i}.0" ]; then mv -f "${i}.0" ../"${i}" ; fi
              if [ -f "${i}.1" ]; then mv -f "${i}.1" "${i}.0"; fi
              if [ -f "${i}.2" ]; then mv -f "${i}.2" "${i}.1"; fi
              cd ..
          fi
      done
      echo
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# MAKE EXPORT SHELL SCRIPT
#
#
make_export()
{
   echo "*** Making ./export"
   echo
   #
   # Basis files
   #
   cat <<EOF> ./export
#!/bin/sh
   szCurrDir=\`pwd\`
   szCurrDir=\${szCurrDir##*/}
   cd ..
   echo " - adding files to tar-achive..."
   echo
# First add the files that are at the main level or are special.
   tar cvf \$szCurrDir.tar \\
     \$szCurrDir/README \\
     \$szCurrDir/configure \\
     \$szCurrDir/config.sub \\
     \$szCurrDir/config.guess \\
     \$szCurrDir/config.status \\
     \$szCurrDir/C90lib.cld \\
     \$szCurrDir/crilib.cld \\
     \$szCurrDir/pam.in \\
     \$szCurrDir/pamq \\
     \$szCurrDir/Makefile \\
     \$szCurrDir/build/Makefile.obj \\
     \$szCurrDir/build/Makefile.dep \\
     \$szCurrDir/build/Makefile.moddef \\
     \$szCurrDir/build/dontbuild \\
     \$szCurrDir/build/dontbuild.in \\
     \$szCurrDir/build/safebuild \\
     \$szCurrDir/doc/doc.html \\
     \$szCurrDir/doc/pam.1 \\
     \$szCurrDir/doc/Makefile.config.example \\
     \$szCurrDir/include/*.h \\
     \$szCurrDir/main/*.h \\
     \$szCurrDir/main/*.head \\
     \$szCurrDir/main/*.struct \\
     \$szCurrDir/modules/README \\
     \$szCurrDir/test \\
     \$szCurrDir/testlast \\
     \$szCurrDir/basis \\
     \$szCurrDir/basis_dalton \\
     \$szCurrDir/build \\
     \$szCurrDir/utils 2> export.log
echo $dirs
# Now add the standard files from each active directory (module).
   for module in $dirs; do
      MDir=\$szCurrDir/\$module
      tar rvf \$szCurrDir.tar \$MDir/*.c \$MDir/*.F \$MDir/*.F90 \$Mdir/*.f90 \$MDir/*.inc \$MDir/*.h \$MDir/Makefile \$MDir/include 2>> export.log
   done
EOF
   cat <<EOF >> ./export
      echo " - gzip'ing archive..."
      echo
      gzip -9v \$szCurrDir.tar
      mv \$szCurrDir.tar.gz \$szCurrDir/\$szCurrDir.tar.gz
EOF
   chmod +x ./export
}

rmline()
{
    #Remove the line $2 from file $1
    grep -v -- "$2" <"$1" >"$1.tmp"
    mv "$1.tmp" "$1"
}

#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Determine the active modules (directories)
#
#
#
which_modules()
{
for mod in $ERIFLG $DNFFLG $FMMFLG $DFTFLG $KRMCFLG $ESRFLG $XPPFLG $EMBFLG \
$ADCFLG $VISUALFLG $AORESPONSEFLG $MATRIX_OPERATIONS_FLG $XCFUN_FLG \
$CAPFLG $HSCCFLG $HSFSFLG $QDOTSFLG $LRGMOLFLG $OOF_FLG $XMLFLG $IHFSCCFLG \
$AMFIFLG $LONDONFLG $SRDFT_FLG $ECPFLG $LOG_FLG
do
  if [ -n "$MODS" ]; then
    MODS="$MODS $mod"
  else
    MODS="$mod"
  fi
done

cp build/dontbuild.in build/dontbuild
echo "# Extra (externally compiled) objects to use with Dirac" > build/Makefile.extobj
# Some makes cannot cope with nonexisting include files,
# we therefore make dummy includes so that make depend can
# run properly.
if [ ! -r "Makefile.dep" ]; then
    touch -t 198001010000 build/Makefile.dep
fi
if [ ! -r "Makefile.obj" ]; then
    touch -t 198001010000 build/Makefile.obj
fi

dirs="dirac prp abacus gp pdpack main relccsd moltra dirrci lucita utils argosecp"
if [ -n "$ERIFLG" ]; then
    dirs="$dirs eri"
    rmline build/dontbuild "eri/\.\*"
fi
if [ -n "$DNFFLG" ]; then
   dirs="$dirs densfit"
    rmline build/dontbuild "densfit/\.\*"
fi
if [ -n "$FMMFLG" ]; then
   dirs="$dirs fmm"
   rmline build/dontbuild "fmm/\.\*"
fi
if [ -n "$DFTFLG" ]; then
   dirs="$dirs dft"
