   szCurrDir=\`pwd\`
   szCurrDir=\${szCurrDir##*/}
   cd ..
   echo " - adding files to tar-achive..."
   echo
# First add the files that are at the main level or are special.
   tar cvf \$szCurrDir.tar \\
     \$szCurrDir/README \\
     \$szCurrDir/configure \\
     \$szCurrDir/config.sub \\
     \$szCurrDir/config.guess \\
     \$szCurrDir/config.status \\
     \$szCurrDir/C90lib.cld \\
     \$szCurrDir/crilib.cld \\
     \$szCurrDir/pam.in \\
     \$szCurrDir/pam.1 \\
     \$szCurrDir/pamq \\
     \$szCurrDir/Makefile \\
     \$szCurrDir/doc/doc.html \\
     \$szCurrDir/include/*.h \\
     \$szCurrDir/main/*.h \\
     \$szCurrDir/main/*.head \\
     \$szCurrDir/main/*.struct \\
     \$szCurrDir/test \\
     \$szCurrDir/testlast \\
     \$szCurrDir/basis \\
     \$szCurrDir/basis_dalton \\
     \$szCurrDir/utils 2> export.log
# Now add the standard files from each active directory (module).
   for module in $dirs; do
      MDir=\$szCurrDir/\$module
      tar rvf \$szCurrDir.tar \$MDir/*.c \$MDir/*.F \$MDir/*.F90 \$Mdir/*.f90 \$MDir/*.inc \$MDir/*.h \$MDir/Makefile \$MDir/include 2>> export.log
   done
EOF
   #
   # Active modules
   #
   if [ "$DFTTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/dft/{*.c,*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$DNFTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/densfit/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$FMMTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/fmm/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$EMBTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/embedding/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$CDFTTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/cdft/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$VISUALTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/visual/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$CAPTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/cap/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$ERITAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/eri/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$ESRTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/prp/esr/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$XPPTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/prp/xpp/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$KRMCTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/krmc/{*.F,*.F90,*.f90,Makefile.in} 2>> export.log
      tar rvf \$szCurrDir.tar \$szCurrDir/luciarel/{*.c,*.F,*.F90,*.f90,Makefile.in,*.inc,*.c} 2>> export.log
EOF
   fi
   if [ "$OOF_TAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/oof/{*.F,*.F90,*.f90,Makefile.in} 2>> export.log
      tar rvf \$szCurrDir.tar \$szCurrDir/oof/{*.c,*.F,*.F90,*.f90,Makefile.in,*.inc,*.c} 2>> export.log
EOF
   fi
# A DIRAC administrator should have everything
   if [ "$PAMADM" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/pamadm \$szCurrDir/WHATSNEW 2>> export.log
EOF
   fi
   if [ "$EXPORTTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/export 2>> export.log
EOF
   fi
   cat <<EOF>> ./export
      echo " - gzip'ing archive..."
      echo
      gzip -9v \$szCurrDir.tar
      mv \$szCurrDir.tar.gz \$szCurrDir/\$szCurrDir.tar.gz
EOF
   chmod +x ./export
}
