        for source in glob.glob('%s/*.inc' % directory):
            source = string.replace(source, '\\', '/')
            list_of_include_files.append(source)

    list_of_c_sources = set(list_of_c_sources)
    list_of_c_sources = list_of_c_sources.difference(set(files_never_compiled))
    list_of_free_fortran_sources = set(list_of_free_fortran_sources)
    list_of_free_fortran_sources = list_of_free_fortran_sources.difference(set(files_never_compiled))
    list_of_fixed_fortran_sources = set(list_of_fixed_fortran_sources)
    list_of_fixed_fortran_sources = list_of_fixed_fortran_sources.difference(set(files_never_compiled))

    s_c = ''
    for f in list_of_c_sources:
        s_c += '    %s\n' % f
    s_free_fortran = ''
    for f in list_of_free_fortran_sources:
        s_free_fortran += '    %s\n' % f
    s_fixed_fortran = ''
    for f in list_of_fixed_fortran_sources:
        s_fixed_fortran += '    %s\n' % f
    s_include_files = ''
    for f in list_of_include_files:
        s_include_files += '    %s\n' % f

    s  = '# file generated by the minions of DIRAC - DO NOT EDIT!\n'
    s += '\nset(C_SOURCES\n%s    )' % s_c
    s += '\nset(FREE_FORTRAN_SOURCES\n%s    )' % s_free_fortran
    s += '\nset(FIXED_FORTRAN_SOURCES\n%s    )' % s_fixed_fortran

    f = open(os.path.join(options.builddir, 'pamadm-generated', 'Sources.cmake'), 'w')
    f.write(s)
    f.close()

    s  = '# file generated by the minions of DIRAC - this is not important for compilation, only for the "make release" target\n'
    s += '\nset(INCLUDE_FILES\n%s    )' % s_include_files

    f = open(os.path.join(options.builddir, 'pamadm-generated', 'IncludeFiles.cmake'), 'w')
    f.write(s)
    f.close()

    s = ''
    for module in dirac_modules:
        if dirac_modules[module].is_included:
            for cppflag in dirac_modules[module].cppflags:
                s += '-D%s ' % cppflag

    f = open(os.path.join(options.builddir, 'pamadm-generated', 'Definitions.cmake'), 'w')
    f.write('# file generated by the minions of DIRAC - DO NOT EDIT!\n')
    f.write('add_definitions(%s)' % s)
    f.close()

    # package tests

    for module in dirac_modules:
        if dirac_modules[module].is_included:
            for test in dirac_modules[module].tests:
                list_of_tests.append(test)

    f = open(os.path.join(options.builddir, 'pamadm-generated', 'Tests.cmake'), 'w')
    f.write('# file generated by the minions of DIRAC - DO NOT EDIT!\n')

    # long tests
    for test in list_of_tests:
        if 'long' in test[1]:
            f.write('dirac_test(%s "%s")\n' % (test[0], test[1]))
    # tests that are neither short nor long
    for test in list_of_tests:
        if not 'long' in test[1] and \
           not 'short' in test[1] and \
           not 'benchmark' in test[1] and \
           not 'tutorial' in test[1] and \
           not 'openrsp' in test[1] and \
           not 'pcm' in test[1]:
            f.write('dirac_test(%s "%s")\n' % (test[0], test[1]))
    # short tests
    for test in list_of_tests:
        if 'short' in test[1] and \
            not 'pcm' in test[1]:
            f.write('dirac_test(%s "%s")\n' % (test[0], test[1]))

    # openrsp tests
    f.write('if(ENABLE_OPENRSP_TESTS)\n')
    for test in list_of_tests:
        if 'openrsp' in test[1]:
            f.write('    dirac_test(%s "%s")\n' % (test[0], test[1]))
    f.write('endif()\n')

    # benchmark tests
    f.write('if(ENABLE_BENCHMARKS)\n')
    for test in list_of_tests:
        if 'benchmark' in test[1]:
            f.write('    dirac_test(%s "%s")\n' % (test[0], test[1]))
    f.write('endif()\n')

    # tutorial tests
    f.write('if(ENABLE_TUTORIALS)\n')
    for test in list_of_tests:
        if 'tutorial' in test[1]:
            f.write('    dirac_test(%s "%s")\n' % (test[0], test[1]))
    f.write('endif()\n')
    
    # pcm tests
    f.write('if(ENABLE_PCMSOLVER)\n')
    for test in list_of_tests:
        if 'pcm' in test[1]:
            f.write('    dirac_test(%s "%s")\n' % (test[0], test[1]))
    f.write('endif()\n')

    f.close()

    # create list of tests, this is needed for "make release"
    f = open(os.path.join(options.builddir, 'pamadm-generated', 'list_of_tests'), 'w')
    for test in list_of_tests:
        f.write(test[0] + '\n')
    f.close()

    # write pamadm flags to file
    f = open(os.path.join(options.builddir, 'pamadm-generated', 'pamadm-flags'), 'w')
    f.write(string.join(sys.argv[1:]))
    f.close()

    # get delete flags (used by make release)
    delete_flags = ''
    for module in dirac_modules:
        if not dirac_modules[module].is_included:
           for cppflag in dirac_modules[module].cppflags:
               delete_flags += '-U%s ' % cppflag
    # another exception: sometimes modules have overlapping MODs
    # now remove some -UMODs again from delete_flags
    for module in dirac_modules:
        if dirac_modules[module].is_included:
           for cppflag in dirac_modules[module].cppflags:
               delete_flags = string.replace(delete_flags, '-U%s' % cppflag, '')
    f = open(os.path.join(options.builddir, 'pamadm-generated', 'delete_flags'), 'w')
    f.write(delete_flags)
    f.close()


if __name__ == '__main__':
    main()
    sys.exit(0)
