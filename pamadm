   rmline build/dontbuild "cap/\.\*"
fi
if [ -n "$AMFIFLG" ]; then
   dirs="$dirs amfi"
   rmline build/dontbuild "amfi/\.\*"
fi
if [ -n "$HSCCFLG" ]; then
   dirs="$dirs hsmrcc/interface"
   dirs="$dirs hsmrcc/second_quant"

# miro: added Sham's HSMRCC modules 
   dirs="$dirs hsmrcc/hsmrcc_external"
   dirs="$dirs hsmrcc/hsmrcc_external/modules"
   dirs="$dirs hsmrcc/hsmrcc_external/source"
   rmline build/dontbuild "hsmrcc/\.\*"
   rmline build/dontbuild "hsmrcc/interface/\.\*"
  # miro: this line is causing strange ifort problem(file hsmrcc/second_quant/operstr_mod.F90): 
   rmline build/dontbuild "hsmrcc/second_quant/\.\*" 
   rmline build/dontbuild "hsmrcc/hsmrcc_external/\.\*"
   rmline build/dontbuild "hsmrcc/hsmrcc_external/modules/\.\*"
   rmline build/dontbuild "hsmrcc/hsmrcc_external/source/\.\*"
