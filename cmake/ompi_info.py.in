#!/usr/bin/env python

# determine and check OpenMPI integer setting - important if ILP64 mode set

import sys

if sys.version >= '2.4':
    import string
    import os

    mpi_path=os.path.dirname('@CMAKE_Fortran_COMPILER@'); 
    ompi_info=os.path.join(mpi_path,'ompi_info'); 
    if os.path.isfile(ompi_info):
        # Linux command
        command=ompi_info+' -a | grep \"Fort integer size\" '
        print 'python script check:'
        print command
        sys.stdout.flush()
        os.system(command)
        sys.exit(0)
    else:
        print >> stderr,'can not determine ompi_info !'
        sys.exit(-1)

    
