#set header for unit testing
if(ENABLE_TESTS)
  execute_process(COMMAND python ${CMAKE_SOURCE_DIR}/cmake/unit-testing/unit-test-header.py --variable=CREATE_UNIT_TESTS --build=${CMAKE_SOURCE_DIR} --enable)
else()
  execute_process(COMMAND python ${CMAKE_SOURCE_DIR}/cmake/unit-testing/unit-test-header.py --variable=CREATE_UNIT_TESTS --build=${CMAKE_SOURCE_DIR})
endif()

add_custom_command(
    OUTPUT  ${CMAKE_SOURCE_DIR}/cmake/unit-testing/autogenerated/unit-test-gather-done
    DEPENDS ${CMAKE_SOURCE_DIR}/cmake/unit-testing/unit-test-gather.py
    COMMAND python ${CMAKE_SOURCE_DIR}/cmake/unit-testing/unit-test-gather.py
    )

add_custom_target(
    generate_unit_tests
    ALL DEPENDS ${CMAKE_SOURCE_DIR}/cmake/unit-testing/autogenerated/unit-test-gather-done
    )

execute_process(
    COMMAND python ${CMAKE_SOURCE_DIR}/cmake/unit-testing/unit-test-gather.py
    )

# set cdash buildname
set(BUILDNAME
    "BUILDNAME-not-set"
    CACHE STRING
    "Name of build on the dashboard"
    )

# set ctest's own timeout in secs
set(DART_TESTING_TIMEOUT
    "600"
    CACHE STRING
    "Set default timeout in seconds for every single test"
    )

include(CTest)
enable_testing()

macro(add_unit_test _path _dir _name)
    add_custom_target(
        ${_dir}_${_name}_files_copied
        COMMAND cp ${_path}/${_dir}/${_name}/* ${PROJECT_BINARY_DIR}/unit-tests/${_dir}_${_name}
        WORKING_DIRECTORY ${PROJECT_SOURCE_DIR}
        )
    add_executable(
        ${_dir}_${_name}.x
        ${_path}/${_dir}/${_name}/test.F90
        )
    set_target_properties(
        ${_dir}_${_name}.x
        PROPERTIES
        RUNTIME_OUTPUT_DIRECTORY
        "unit-tests/${_dir}_${_name}"
        )
    target_link_libraries(
        ${_dir}_${_name}.x
        ${UNIT_TEST_LIBS}
        )
    add_dependencies(
        ${_dir}_${_name}.x
        ${_dir}_${_name}_files_copied
        )
    add_test(
        ${_dir}_${_name}
        python ${PROJECT_SOURCE_DIR}/cmake/unit-testing/unit-test-wrap.py --build-dir=${PROJECT_BINARY_DIR} --name=${_dir}_${_name}
        )
endmacro()

include(Tests)
