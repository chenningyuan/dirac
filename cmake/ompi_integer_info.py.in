#!/usr/bin/env python
# determine OpenMPI integer setting for user info
import sys
if sys.version >= '2.4':
    import string
    import os
    import subprocess
    mpi_path=os.path.dirname('@CMAKE_Fortran_COMPILER@'); 
    # extract ompi_info as part of OpenMPI compiler set
    ompi_info=os.path.join(mpi_path,'ompi_info'); 
    if os.path.isfile(ompi_info):
        # Linux command
        command=ompi_info+' -a | grep \"Fort integer size\" '
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,shell=True)
        out,err = process.communicate()
        print >> sys.stdout,out[12:]
        if err:
            print  >> sys.stderr,err
        sys.exit(0)
    else:
        print >> stderr,'can not determine ompi_info for OpenMPI compilers, check your OpenMPI installation'
        sys.exit(-1)
