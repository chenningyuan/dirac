 % triggers a bug in ps2pdf
 xll yll translate
 xur xll sub yur yll sub scale
 /do cl string def
 cl rw 8 [cl 0 0 rw neg 0 rw]
 {currentfile do readhexstring pop
  dup length 1 sub 0 1 3 -1 roll
    { 1 index exch
      2 copy get imagemap exch get 255 mul cvi put
    }
  for
 }image
 Q
 end
} bind def
