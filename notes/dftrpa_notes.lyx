\begin_inset Formula \begin{eqnarray*}
\frac{\partial^{2}e_{xc}}{\partial\kappa_{pq}\partial\kappa_{rs}}\frac{\partial\kappa_{pq}}{\partial\varepsilon_{A}}\frac{\partial\kappa_{rs}}{\partial\varepsilon_{B}} & = & \left\{ \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho_{A}^{(1)}\rho_{B}^{(1)}+2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\left[P_{AB}\rho_{A}^{(1)}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{B}^{(1)}\right)\right]+\right.\\
