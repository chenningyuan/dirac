\begin_inset Formula \[
e_{x}^{B88}=e_{x}^{LDA}+\Delta e_{x}^{B88}\]

\end_inset 

 The B88 correction to the LSDA exchange energy density is
\begin_inset Formula \begin{eqnarray*}
\Delta e_{x}^{B88} & = & -\D\sum_{s}\rho_{s}^{4/3}\frac{\beta x_{s}^{2}}{1+\beta x_{s}\sinh^{-1}\left(x_{s}\right)}\\
 & = & -\D\sum_{s}\left|\boldsymbol{\nabla}\rho_{s}\right|\frac{\beta x_{s}}{1+\beta x_{s}\sinh^{-1}\left(x_{s}\right)}\end{eqnarray*}

\end_inset 


\layout Standard
\noindent 
where
\begin_inset Formula \[
x_{s}=\D\frac{\left|\boldsymbol{\nabla}\rho_{s}\right|}{\rho^{4/3}};\quad\D\frac{\partial x_{s}}{\partial\rho_{s}}=-\frac{4}{3}\frac{x_{s}}{\rho_{s}};\quad\D\frac{\partial x_{s}}{\partial\left|\boldsymbol{\nabla}\rho_{s}\right|}=\D\frac{1}{\rho^{4/3}}.\]

\end_inset 

 First derivatives:
\begin_inset Formula \begin{eqnarray*}
\D\frac{\partial e_{x}^{B88}}{\partial x_{s}} & = & \beta\left|\boldsymbol{\nabla}\rho_{s}\right|\frac{6\beta x_{s}^{2}-\sqrt{1+x_{s}^{2}}}{\left[1+\beta x_{s}\sinh^{-1}\left(x_{s}\right)\right]^{2}\sqrt{1+x_{s}^{2}}}\end{eqnarray*}

\end_inset 


\layout Section

Spin-polarized theory
\layout Subsection

Definitions
\layout Standard

In non-relativistic theory the spin and spatial degrees of freedom are completel
y decoupled and the z-axis is chosen as the quantization axis for spin.
 The magnetization vector is accordingly given as
\begin_inset Formula \[
\mathbf{m}=\sum_{is}\left\langle \psi_{is}^{\dagger}\left|{\mb\sigma}\right|\psi_{is}\right\rangle =(0,0,\rho^{\alpha}-\rho^{\beta})\]

\end_inset 

 It can be seen that the 
\begin_inset Formula $m_{z}$
\end_inset 

 -component equals the spin density 
\begin_inset Formula $Q(\mathbf{r})=\rho^{\alpha}-\rho^{\beta}$
\end_inset 


\begin_inset LatexCommand \cite{parr}

\end_inset 

.
 The spin polarization can be defined as
\begin_inset Formula \[
\zeta=\frac{Q}{\rho},\quad-1<\zeta<1\]

\end_inset 

 based on an undirected z-magnetization axis.
 A more general definition is
\begin_inset LatexCommand \cite{Eschrig}

\end_inset 


\begin_inset Formula \[
\zeta=\frac{\left|\mathbf{m}\right|}{\rho};\quad0<\zeta<1\]

\end_inset 

 that allows extension to non-collinear approaches.
 We note the useful relations
\begin_inset Formula \[
\rho^{\alpha}=\frac{1}{2}\left[\rho+Q\right]=\frac{1}{2}\rho\left[1+\zeta\right];\quad\rho^{\alpha}=\frac{1}{2}\left[\rho-Q\right]=\frac{1}{2}\rho\left[1-\zeta\right]\]

\end_inset 


\layout Standard

In the follwing we will develop non-collinear theory using the variable
\begin_inset Formula \[
M=\mathbf{m}\cdot\mathbf{m}\]

\end_inset 

The 
\begin_inset Formula $M$
\end_inset 

-variable can be expanded as
\begin_inset Formula \[
M(\mathbf{r},\boldsymbol{\kappa})=\mathbf{m}\cdot\mathbf{m}=\sum_{n=0}^{\infty}M^{(n)}\]

\end_inset 

 in which appears
\begin_inset Formula \begin{eqnarray*}
M^{(0)} & = & \mathbf{m}_{0}\cdot\mathbf{m}_{0}\\
M^{(1)} & = & 2\left(\mathbf{m}_{0}\cdot\mathbf{m}^{(1)}\right)\\
M^{(2)} & = & 2\left(\mathbf{m}_{0}\cdot\mathbf{m}^{(2)}\right)+\left(\mathbf{m}^{(1)}\cdot\mathbf{m}^{(1)}\right)\\
M^{(3)} & = & 2\left(\mathbf{m}_{0}\cdot\mathbf{m}^{(3)}\right)+2\left(\mathbf{m}^{(1)}\cdot\mathbf{m}^{(2)}\right)\end{eqnarray*}

\end_inset 


\layout Subsection

Gradient
\layout Standard

We need
\begin_inset Formula \[
\left.\frac{\partial E_{xc}}{\partial\kappa_{ai}^{*}}\right|_{\boldsymbol{\kappa}=\mathbf{0}}=\int\left[\frac{\partial e_{xc}}{\partial\rho}\frac{\partial\rho}{\partial\kappa_{ai}^{*}}+\frac{\partial e_{xc}}{\partial M}\frac{\partial M}{\partial\kappa_{ai}^{*}}\right]_{\boldsymbol{\kappa}=\mathbf{0}}d\tau=-F_{xc;ai}\]

\end_inset 

 in which appears the xc-part of the Kohn-Sham matrix
\begin_inset Formula \[
F_{xc;pq}=\int\left[\frac{\partial e_{xc}}{\partial\rho}\Omega_{pq}+2\frac{\partial e_{xc}}{\partial M}\left(\mathbf{m}_{0}\cdot\boldsymbol{\mu}{}_{pq}\right)\right]d\tau\]

\end_inset 

 In the closed shell case 
\begin_inset Formula $\mathbf{m}_{0}=\mathbf{0}$
\end_inset 

 and so the spin contribution disappears.
\layout Subsection

Linear response
\layout Standard

We need
\begin_inset Formula \begin{eqnarray*}
\left.\frac{d}{d\varepsilon_{B}}\left[\frac{\partial E_{xc}}{\partial\kappa_{ai}^{*}}\right]\right|_{\boldsymbol{\kappa}=\mathbf{0}} & = & \int\left[\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\frac{\partial\rho}{\partial\kappa_{ai}^{*}}\frac{d\rho}{d\varepsilon_{B}}+\frac{\partial e_{xc}}{\partial\rho}\frac{d}{d\varepsilon_{B}}\left(\frac{\partial\rho}{\partial\kappa_{ai}^{*}}\right)+\frac{\partial^{2}e_{xc}}{\partial\rho\partial M}\frac{\partial\rho}{\partial\kappa_{ai}^{*}}\frac{dM}{d\varepsilon_{B}}\right.\\
 & + & \left.\frac{\partial^{2}e_{xc}}{\partial\rho\partial M}\frac{\partial M}{\partial\kappa_{ai}^{*}}\frac{d\rho}{d\varepsilon_{B}}+\frac{\partial e_{xc}}{\partial\zeta}\frac{d}{d\varepsilon_{B}}\left(\frac{\partial M}{\partial\kappa_{ai}^{*}}\right)+\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\frac{\partial M}{\partial\kappa_{ai}^{*}}\frac{dM}{d\varepsilon_{B}}\right]d\tau\\
 & = & -F_{xc;ai}^{B}-G_{xc;ai}\end{eqnarray*}

\end_inset 

 in which appears the one-index transformed Kohn-Sham matrix (xc part)
\begin_inset Formula \[
F_{xc;pq}^{B}=\int\left[\frac{\partial e_{xc}}{\partial\rho}\Omega_{pq}^{B}+2\frac{\partial e_{xc}}{\partial M}\left(\mathbf{m}_{0}\cdot\boldsymbol{\mu}_{pq}^{B}\right)\right]d\tau\]

\end_inset 

 and the matrix
\begin_inset Formula \begin{eqnarray*}
G_{xc;pq} & = & \int\left[\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho^{B}\Omega_{pq}+2\frac{\partial^{2}e_{xc}}{\partial\rho\partial M}\left\{ \left(\mathbf{m}_{0}\cdot\mathbf{m}^{B}\right)\Omega_{pq}+\rho^{B}\left(\mathbf{m}_{0}\cdot\boldsymbol{\mu}_{pq}\right)\right\} \right.\\
 & + & \left.2\frac{\partial e_{xc}}{\partial M}\left(\mathbf{m}^{B}\cdot\boldsymbol{\mu}_{pq}\right)+4\frac{\partial^{2}e_{xc}}{\partial M^{2}}\left(\mathbf{m}_{0}\cdot\mathbf{m}^{B}\right)\left(\mathbf{m}_{0}\cdot\boldsymbol{\mu}_{pq}\right)\right]d\tau\end{eqnarray*}

\end_inset 

 In the closed-shell case these expressions reduce to
\begin_inset Formula \begin{eqnarray*}
F_{xc;pq}^{B} & = & \int\frac{\partial e_{xc}}{\partial\rho}\Omega_{pq}^{B}d\tau\\
G_{xc;pq} & = & \int\left[\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho^{B}\Omega_{pq}+\frac{\partial^{2}e_{xc}}{\partial s^{2}}\left(\mathbf{m}^{B}\cdot\boldsymbol{\mu}_{pq}\right)\right]d\tau\end{eqnarray*}

\end_inset 

 where we have used the relation
\begin_inset Formula \[
\frac{\partial e_{xc}}{\partial M}=\frac{1}{2s}\frac{\partial e_{xc}}{\partial s}\quad\begin{array}{c}
s=0\\
\rightarrow\\
\end{array}\quad\frac{1}{2}\frac{\partial^{2}e_{xc}}{\partial s^{2}};\quad s=\left|\mathbf{m}\right|\]

\end_inset 

 
\layout Section

Subroutines for functionals.old
\layout Subsection

Dirac exchange
\layout Standard

The general form of the exhange functional in the local-spin density approximati
on is
\begin_inset Formula \[
E_{X}^{LSDA}\left[\rho_{\alpha},\rho_{\beta}\right]=\int\rho\varepsilon_{X}^{LSDA}(\rho_{\alpha},\rho_{\alpha})d\mathbf{r};\quad C_{X}=\frac{3}{4}\left(\frac{3}{\pi}\right)^{1/3}\]

\end_inset 

 with
\begin_inset LatexCommand \cite{F.Jensen}

\end_inset 


\begin_inset Formula \[
\varepsilon_{X}^{LSDA}=-\frac{1}{2}C_{X}\rho^{1/3}\left[\left(1+\zeta\right)^{4/3}+\left(1-\zeta\right)^{4/3}\right]\]

\end_inset 

 Observe that with no spin polarization we obtain
\begin_inset Formula \begin{equation}
E_{X}^{LSDA}\quad\rightarrow\quad E_{X}^{LDA}=-C_{X}\int\rho^{4/3}d\mathbf{r}\label{eq:LDAx}\end{equation}

\end_inset 

 
\layout Subsubsection

Subroutine EDRC
\layout Standard

The subroutine EDRC calculates the integrand of 
\begin_inset Formula $E_{X}^{LDA}$
\end_inset 

 as given in Eq.(
\begin_inset LatexCommand \ref{eq:LDAx}

\end_inset 

).
\layout Subsection

Becke exchange (B88)
\layout Standard

The exchange part of 
\begin_inset Formula $E_{XC}^{GGA}$
\end_inset 

 can be written as
\begin_inset Formula \[
E_{X}^{GGA}=E_{X}^{LSDA}-\sum_{\sigma}\int F(s_{\sigma})\rho_{\sigma}^{4/3}(\mathbf{r})d\mathbf{r}\]

\end_inset 

 where we have introduced the reduced density gradient for spin 
\begin_inset Formula $\sigma$
\end_inset 


\begin_inset Formula \[
s_{\sigma}(\mathbf{r})=\frac{\left|{\nabla}\rho_{\sigma}(\mathbf{r})\right|}{\rho_{\sigma}^{4/3}(\mathbf{r})}\]

\end_inset 

 The Becke exchange functional B88 is given by
\begin_inset Formula \[
F^{B88}(s_{\sigma})=\frac{\beta s_{\sigma}^{2}}{1+6\beta s_{\sigma}\sinh^{-1}s_{\sigma}}\]

\end_inset 

 with 
\begin_inset Formula $\beta$
\end_inset 

 an empirical parameter fitted to 0.0042.
 In the case of no spin polarization the GGA exchange reduces to
\begin_inset Formula \begin{equation}
E_{X}^{GGA}=E_{X}^{LDA}-\int\left(\frac{1}{3}\right)^{1/3}F^{B88}(x)\rho^{4/3}d\mathbf{r};\quad x=\frac{\left|{\nabla}\rho(\mathbf{r})\right|}{\left(\frac{1}{2}\right)^{1/3}\rho^{4/3}(\mathbf{r})}\label{eq:B88spf}\end{equation}

\end_inset 


\layout Subsubsection

Subroutine EBCK 
\layout Standard

Remembering that
\begin_inset Formula \[
\sinh x=\frac{1}{2}\left(e^{x}-e^{-x}\right);\quad\sinh^{-1}y=\ln\left(y+\sqrt{y^{2}+1}\right)\]

\end_inset 

 the subroutine EBCK calculates the (negative) integrand of Eq.(
\begin_inset LatexCommand \ref{eq:B88spf}

\end_inset 

).
\layout Subsubsection

Subroutine GBCK
\layout Standard

Remembering that
\begin_inset Formula \[
f(y)=\sinh y\quad\Rightarrow\quad f'(y)=\frac{1}{\sqrt{1+y^{2}}}\]

\end_inset 

 we find that
\begin_inset Formula \[
\frac{\partial F(s_{\sigma})}{\partial s_{\sigma}}=\frac{2\beta s_{\sigma}}{1+6\beta s_{\sigma}\sinh^{-1}s_{\sigma}}-\frac{6\beta^{2}s_{\sigma}^{2}(\sinh^{-1}s_{\sigma}+\frac{s}{\sqrt{1+s_{\sigma}^{2}}})}{\left(1+6\beta s_{\sigma}\sinh^{-1}s_{\sigma}\right)^{2}}\]

\end_inset 


