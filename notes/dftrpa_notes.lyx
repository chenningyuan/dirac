from which one obtains
\begin_inset Formula \begin{eqnarray*}
\frac{\partial^{2}e_{xc}}{\partial\kappa_{ai}^{*}\partial\kappa_{bj}} & = & \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\Omega_{ai}\Omega_{jb}+\frac{\partial e_{xc}}{\partial\rho}\left[\delta_{ij}\Omega_{ab}-\delta_{ab}\Omega_{ji}\right]\\
 & + & 2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\left[\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{ai}\right)\Omega_{jb}+\Omega_{ai}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{jb}\right)\right]\\
 & + & 4\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{ai}\right)\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{jb}\right)+2\frac{\partial e_{xc}}{\partial\zeta}\left[\boldsymbol{\nabla}\Omega_{ai}\cdot\boldsymbol{\nabla}\Omega_{jb}+\boldsymbol{\nabla}\rho_{0}\cdot\left(\delta_{ij}\boldsymbol{\nabla}\Omega_{ab}-\delta_{ab}\boldsymbol{\nabla}\Omega_{ji}\right)\right]\\
\frac{\partial^{2}e_{xc}}{\partial\kappa_{ai}^{*}\partial\kappa_{bj}^{*}} & = & \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\Omega_{ai}\Omega_{bj}\\
 & + & 2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\left[\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{ai}\right)\Omega_{bj}+\Omega_{ai}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{bj}\right)\right]\\
 &  & 4\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{ai}\right)\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{bj}\right)+2\frac{\partial e_{xc}}{\partial\zeta}\left[\boldsymbol{\nabla}\Omega_{ai}\cdot\boldsymbol{\nabla}\Omega_{bj}\right]\end{eqnarray*}

\end_inset 


