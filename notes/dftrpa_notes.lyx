\layout Title

DFT response
\layout Author

T.Saue and T.Helgaker
\layout Section

First approach
\layout Standard

We write the parametrized exchange-correlation functional 
\begin_inset Formula $E_{XC}[\rho,\kappa]$
\end_inset 

 as
\begin_inset Formula \begin{equation}
E_{XC}[\rho,\kappa]=\int F(\rho(\mathbf{r},\kappa))d\mathbf{r}\label{eq:Exc_1}\end{equation}

\end_inset 

 where the integrand 
\begin_inset Formula $F(\rho)$
\end_inset 

 is a function of the density 
\begin_inset Formula $\rho$
\end_inset 

.The parametrized electron density 
\begin_inset Formula $\rho$
\end_inset 

 can in the second quantization formalism be expressed as
\begin_inset Formula \begin{equation}
\rho(\mathbf{r},\kappa)=\phi_{n}^{\dagger}\phi_{m}D_{nm};\quad D_{nm}=\left\langle \tilde{0}\left|n^{\dagger}m\right|\tilde{0}\right\rangle ;\quad\left|\tilde{0}\right\rangle =\exp[-\hat{\kappa}]\left|0\right\rangle \label{eq:rho_1}\end{equation}

\end_inset 

 The integrand 
\begin_inset Formula $F(\rho)$
\end_inset 

 can be Taylor expanded in terms of the variational parameters 
\begin_inset Formula $\kappa$
\end_inset 

 
\begin_inset Formula \begin{equation}
F(\rho(\mathbf{r},\kappa))=\left.F\right|_{\kappa=0}+\left.\frac{\partial F}{\partial\rho}\frac{\partial\rho}{\partial\kappa_{pq}}\right|_{\kappa=0}\kappa_{pq}+\frac{1}{2}\left[\frac{\partial^{2}F}{\partial\rho^{2}}\frac{\partial\rho}{\partial\kappa_{pq}}\frac{\partial\rho}{\partial\kappa_{rs}}+\frac{\partial F}{\partial\rho}\frac{\partial^{2}\rho}{\partial\kappa_{pq}\partial\kappa_{rs}}\right]_{\kappa=0}\kappa_{pq}\kappa_{rs}+O(\kappa^{3})\label{eq:Fxc_1}\end{equation}

\end_inset 

 where implicit summation is employed.
 Inserted into Eq.(
\begin_inset LatexCommand \ref{eq:Exc_1}

\end_inset 

), we obtain a similar expansion of the exchange-correlation functional
 which allows us to define its contribution to the gradient, Hessian and
 higher derivatives.
 
\layout Standard

The density of Eq.(
\begin_inset LatexCommand \ref{eq:rho_1}

\end_inset 

) can be BCH-expanded as
\begin_inset Formula \[
\rho=\phi_{m}\phi_{n}^{*}\left\{ \left\langle 0\left|n^{\dagger}m\right|0\right\rangle +\left\langle 0\left|\left[p^{\dagger}q,n^{\dagger}m\right]\right|0\right\rangle \kappa_{pq}+\frac{1}{2}\left\langle 0\left|\left[p^{\dagger}q,\left[r^{\dagger}s,n^{\dagger}m\right]\right]\right|0\right\rangle \kappa_{pq}\kappa_{rs}+O(\kappa^{3})\right\} \]

\end_inset 

 Insertion into Eq.(
\begin_inset LatexCommand \ref{eq:Fxc_1}

\end_inset 

) then gives
\begin_inset Formula \begin{eqnarray*}
F(\kappa) & = & F[\rho_{0}]+\left.\frac{\partial F}{\partial\rho}\right|_{\kappa=0}\phi_{n}^{\dagger}\phi_{m}\left\langle 0\left|\left[p^{\dagger}q,n^{\dagger}m\right]\right|0\right\rangle \kappa_{pq}\\
 & + & \frac{1}{2}\left.\frac{\partial F}{\partial\rho}\right|_{\kappa=0}\phi_{n}^{\dagger}\phi_{m}\left\langle 0\left|\left[p^{\dagger}q,\left[r^{\dagger}s,n^{\dagger}m\right]\right]\right|0\right\rangle \kappa_{pq}\kappa_{rs}\\
 & + & \frac{1}{2}\left.\frac{\partial^{2}F}{\partial\rho^{2}}\right|_{\kappa=0}\phi_{n}^{\dagger}\phi_{m}\phi_{u}^{\dagger}\phi_{t}\left\langle 0\left|\left[p^{\dagger}q,n^{\dagger}m\right]\right|0\right\rangle \left\langle 0\left|\left[r^{\dagger}s,u^{\dagger}t\right]\right|0\right\rangle \kappa_{pq}\kappa_{rs}+O(\kappa^{3})\end{eqnarray*}

\end_inset 

 and the exchange-correlation functional is accordingly expanded as
\begin_inset Formula \[
E_{XC}(\kappa)=E_{XC}^{[0]}+E_{XC;pq}^{[1]}\kappa_{pq}+\frac{1}{2}E_{XC;pq,rs}^{[2]}\kappa_{pq}\kappa_{rs}+O(\kappa^{3})\]

\end_inset 

 where we have introduced
\begin_inset Formula \begin{eqnarray*}
E_{XC}^{[0]} & = & \int F[\rho_{0}]d\mathbf{r}\\
\\E_{XC;pq}^{[1]} & = & \left\langle 0\left|\left[p^{\dagger}q,\hat{V}_{XC}\right]\right|0\right\rangle \\
\\E_{XC;pq,rs}^{[2]} & = & E_{XC1;pq,rs}^{[2]}+E_{XC2;pq,rs}^{[2]}\\
\\E_{XC1;pq,rs}^{[2]} & = & \left\langle 0\left|\left[p^{\dagger}q,\left[r^{\dagger}s,\hat{V}_{XC}\right]\right]\right|0\right\rangle \\
\\E_{XC2;pq,rs}^{[2]} & = & W_{XC;nm,ut}\left\langle 0\left|\left[p^{\dagger}q,n^{\dagger}m\right]\right|0\right\rangle \left\langle 0\left|\left[r^{\dagger}s,u^{\dagger}t\right]\right|0\right\rangle \end{eqnarray*}

\end_inset 

 We have furthermore introduced the operator
\begin_inset Formula \[
\hat{V}_{XC}=\sum_{nm}V_{XC;nm}n^{\dagger}m\]

\end_inset 

and the integrals
\begin_inset Formula \[
V_{XC;mn}=\int\left.\frac{\partial F}{\partial\rho}\right|_{\kappa=0}\phi_{n}^{\dagger}\phi_{m}d\mathbf{r};\quad W_{XC;nm,ut}=\int\left.\frac{\partial^{2}F}{\partial\rho^{2}}\right|_{\kappa=0}\phi_{n}^{\dagger}\phi_{m}\phi_{u}^{\dagger}\phi_{t}d\mathbf{r}\]

\end_inset 

 (they can be seen to be members of a general moment expansion of the integrand
 F).
 The contribution of the exchange-correlation energy to the Hessian splits
 into two contributions.
 The first constribution has the following structure
\begin_inset Formula \[
E_{XC1}^{[2]}=\left[\begin{array}{cc}
\mathbf{A} & \mathbf{B}\\
\mathbf{B}^{*} & \mathbf{A}^{*}\end{array}\right];\quad\begin{array}{lcl}
A_{ai,bj} & = & \left\langle 0\left|\left[-i^{\dagger}a,\left[b^{\dagger}j,\hat{V}_{XC}\right]\right]\right|0\right\rangle \\
\\B_{ai,bj} & = & \left\langle 0\left|\left[i^{\dagger}a,\left[j^{\dagger}b\hat{,}\hat{V}_{XC}\right]\right]\right|0\right\rangle \end{array}\]

\end_inset 

 For a closed-shell Hartree-Fock wave function we find
\begin_inset Formula \begin{eqnarray*}
A_{ai,bj} & =\sum_{nm}V_{XC;nm}\left\{ \delta_{bm}(\delta_{na}D_{ij}-\delta_{ij}D_{na})-\delta_{nj}(\delta_{ba}D_{im}-\delta_{im}D_{ba})\right\}  & =\delta_{ij}V_{XC;ab}-\delta_{ab}V_{XC;ij}^{*}\\
\\B_{ai,bj} & =\sum_{nm}V_{XC;nm}\left\{ \delta_{nb}(\delta_{ja}D_{im}-\delta_{im}D_{ja})-\delta_{jm}(\delta_{na}D_{ib}-\delta_{ib}D_{na})\right\}  & =0\end{eqnarray*}

\end_inset 

 The second contribution to the Hessian has the idebtical matrix structure.
 In the case of a closed-shell Hartree-Fock wave function we now find
\begin_inset Formula \begin{eqnarray*}
A_{ai,bj} & =\sum_{nm,ut}W_{XC;nm,ut}(\delta_{im}D_{na}-\delta_{na}D_{im})(\delta_{uj}D_{bt}-\delta_{bt}D_{uj}) & =-W_{ai,jb}\\
\\B_{ai,bj} & =\sum_{nm,ut}W_{XC;nm,ut}(\delta_{na}D_{im}-\delta_{im}D_{na})(\delta_{ub}D_{jt}-\delta_{jt}D_{ub}) & =W_{ai,bj}\end{eqnarray*}

\end_inset 


\begin_inset Formula \[
\]

\end_inset 

We now consider the construction of the sigma-vector
\begin_inset Formula \[
\sigma_{i}=\mathbf{E}^{[2]}\mathbf{b}_{i}(h)\]

\end_inset 

 We focus on the construction of the upper segment
\begin_inset Formula \[
\sigma_{ai}=\sum_{bj}(A_{ai,bj}b_{bj}+hB_{ai,bj}b_{bj}^{*})=\sum_{bj}(A_{ai,bj}b_{bj}+B_{ai,bj}b_{jb})\]

\end_inset 

 where we have used the relation 
\begin_inset Formula $b_{jb}=hb_{bj}^{*}$
\end_inset 

 .
 From the first exchange-correlation contribution to the Hessian we obtain
\begin_inset Formula \[
\sigma_{XC1;ai}=\left\langle 0\left|\left[-q_{ai},\tilde{V}_{XC}\right]\right|0\right\rangle =-\tilde{F}_{XC;ai}=-\tilde{v}_{XC;ai}\]

\end_inset 

 where we have introduced the one-index transformed operator
\begin_inset Formula \[
\tilde{V}_{XC}=\sum_{nm}\tilde{v}_{XC;nm}n^{\dagger}m;\quad\tilde{v}_{XC;pq}=\sum_{t}\left(W_{pt}v_{XC;tq}-v_{XC;pt}W_{tq}\right)\]

\end_inset 

The matrix 
\begin_inset Formula $W$
\end_inset 

 has elements
\begin_inset Formula \[
W_{ii}=W_{ss}=0;\quad W_{ai}=b_{ai};\quad W_{ia}=-b_{ia};\quad W^{\dagger}=-hW\]

\end_inset 

 From the second exchange-correlation contribution to the Hessian we obtain
\begin_inset Formula \[
\sigma_{XC2;ai}=-\sum_{nm,bj}\left\langle 0\left|\left[-i^{\dagger}a,n^{\dagger}m\right]\right|0\right\rangle (W_{XC;nm,jb}b_{bj}+W_{XC;nm,bj}b_{jb})=\sum_{bj}\left(W_{ai,jb}b_{bj}+W_{ai,bj}b_{jb}\right)\]

\end_inset 

 This latter expression can be reformulated in terms of a modified AO density
 matrix
\begin_inset Formula \[
\sigma_{XC2;ai}=\tilde{G}_{XC:ai}=\sum_{\kappa\lambda}W_{ai,\kappa\lambda}\tilde{D}_{\lambda\kappa};\quad\tilde{D}_{\lambda\kappa}=\sum_{rs}c_{\lambda r}b_{rs}c_{\kappa s}^{*};\quad\tilde{\mathbf{D}}^{\dagger}=h\tilde{\mathbf{D}}\]

\end_inset 

 In conclusion we can write the exchange-correlation contribution to the
 sigma-vector as
\begin_inset Formula \[
\sigma_{XC;ai}=-(\tilde{F}_{XC;ai}-\tilde{G}_{XC;ai})\]

\end_inset 

 The first part is straightforward since it is added to the regular Fock-matrix.
 The second part can be calculated in AO-basis
\begin_inset Formula \[
\tilde{G}_{\textrm{XC};ai}=\sum_{\mu\nu}c_{\mu a}^{*}\tilde{G}_{\textrm{XC};\mu\nu}c_{\nu i};\quad\tilde{G}_{\textrm{XC};\mu\nu}=\int\chi_{\mu}w(\mathbf{r})\chi_{\nu}d\mathbf{r};\quad w(\mathbf{r})=\left.\frac{\partial^{2}F(\mathbf{r})}{\partial\rho^{2}}\right|_{\kappa=0}\sum_{\kappa\lambda}\chi_{\kappa}\tilde{D}_{\kappa\lambda}\chi_{\lambda}\]

\end_inset 

 
\layout Section

GGA
\layout Standard

We write the parametrized exchange-correlation functional 
\begin_inset Formula $E_{XC}[\rho,\grho,\kappa]$
\end_inset 

 as
\begin_inset Formula \begin{equation}
E_{XC}[\rho,\grho,\kappa]=\int F(\rho(\mathbf{r},\kappa),\grho(\mathbf{r},\kappa))d\mathbf{r}\label{eq:Exc}\end{equation}

\end_inset 

 where the integrand 
\begin_inset Formula $F(\rho,\grho)$
\end_inset 

 is a function of the density 
\begin_inset Formula $\rho$
\end_inset 

 and the square of its gradient 
\begin_inset Formula $\grho$
\end_inset 

.The parametrized electron density 
\begin_inset Formula $\rho$
\end_inset 

 can in the second quantization formalism be expressed as
\begin_inset Formula \begin{equation}
\rho(\mathbf{r},\kappa)=\phi_{e}^{\dagger}\phi_{f}D_{ef};\quad D_{ef}=\left\langle \tilde{0}\left|e^{\dagger}f\right|\tilde{0}\right\rangle ;\quad\left|\tilde{0}\right\rangle =\exp[-\hat{\kappa}]\left|0\right\rangle \label{eq:rho}\end{equation}

\end_inset 

 Likewise, the square of the gradient of the density can be expressed as
\begin_inset Formula \[
\grho(\mathbf{r},\kappa)={\mb\grho}_{ef}\cdot{\mb\grho}_{gh}D_{ef}D_{gh};\quad{\mb\grho}_{ef}={\mb\nabla}\left(\phi_{e}^{\dagger}\phi_{f}\right)\]

\end_inset 

 The integrand 
\begin_inset Formula $F(\rho,\grho)$
\end_inset 

 can be Taylor expanded to second order in terms of the variational parameters
 
\begin_inset Formula $\kappa$
\end_inset 

 
\begin_inset Formula \begin{eqnarray}
F(\rho,\grho) & = & \left.F\right|_{\kappa=0}+\left.\frac{\partial F}{\partial\rho}\frac{\partial\rho}{\partial\kappa_{pq}}+\frac{\partial F}{\partial\grho}\frac{\partial\grho}{\partial\kappa_{pq}}\right|_{\kappa=0}\kappa_{pq}\\
 & + & \frac{1}{2}\left.\frac{\partial^{2}F}{\partial\rho^{2}}\frac{\partial\rho}{\partial\kappa_{pq}}\frac{\partial\rho}{\partial\kappa_{rs}}+\frac{\partial F}{\partial\rho}\frac{\partial^{2}\rho}{\partial\kappa_{pq}\partial\kappa_{rs}}+\frac{\partial^{2}F}{\partial\grho^{2}}\frac{\partial\grho}{\partial\kappa_{pq}}\frac{\partial\grho}{\partial\kappa_{rs}}+\frac{\partial F}{\partial\grho}\frac{\partial^{2}\grho}{\partial\kappa_{pq}\partial\kappa_{rs}}+2\frac{\partial^{2}F}{\partial\rho\partial\grho}\frac{\partial\rho}{\partial\kappa_{pq}}\frac{\partial\grho}{\partial\kappa_{rs}}\right|_{\kappa=0}\kappa_{pq}\kappa_{rs}\label{eq:Fxc}\end{eqnarray}

\end_inset 

 where implicit summation is employed.
 Inserted into Eq.(
\begin_inset LatexCommand \ref{eq:Exc}

\end_inset 

), we obtain a similar expansion of the exchange-correlation functional
 which allows us to define its contribution to the gradient, Hessian and
 higher derivatives.
 
\layout Standard

The density of Eq.(
\begin_inset LatexCommand \ref{eq:rho}

\end_inset 

) can be BCH-expanded as
\begin_inset Formula \[
\rho=\phi_{e}^{\dagger}\phi_{f}\left\{ \left\langle 0\left|e^{\dagger}f\right|0\right\rangle +\left\langle 0\left|\left[p^{\dagger}q,e^{\dagger}f\right]\right|0\right\rangle \kappa_{pq}+\frac{1}{2}\left\langle 0\left|\left[p^{\dagger}q,\left[r^{\dagger}s,e^{\dagger}f\right]\right]\right|0\right\rangle \kappa_{pq}\kappa_{rs}+O(\kappa^{3})\right\} \]

\end_inset 

 Likewise, the gradient can be BCH-expanded as
\begin_inset Formula \begin{eqnarray*}
\grho & = & \left({\mb\grho}_{ef}\cdot{\mb\grho}_{gh}\right)\left\{ \left\langle 0\left|e^{\dagger}f\right|0\right\rangle \left\langle 0\left|g^{\dagger}h\right|0\right\rangle +2\left\langle 0\left|\left[p^{\dagger}q,e^{\dagger}f\right]\right|0\right\rangle \left\langle 0\left|g^{\dagger}h\right|0\right\rangle \kappa_{pq}\right|\\
 & + & \left.\left(\left\langle 0\left|\left[p^{\dagger}q,\left[r^{\dagger}s,e^{\dagger}f\right]\right]\right|0\right\rangle \left\langle 0\left|g^{\dagger}h\right|0\right\rangle +\left\langle 0\left|\left[p^{\dagger}q,e^{\dagger}f\right]\right|0\right\rangle \left\langle 0\left|\left[r^{\dagger}s,g^{\dagger}h\right]\right|0\right\rangle \right)\kappa_{pq}\kappa_{rs}+O(\kappa^{3})\right\} \end{eqnarray*}

\end_inset 

 Insertion into Eq.(
\begin_inset LatexCommand \ref{eq:Fxc}

\end_inset 

) then gives
\begin_inset Formula \begin{eqnarray*}
F(\kappa) & = & F[\rho_{0}]+\left.\frac{\partial F}{\partial\rho}\right|_{\kappa=0}\phi_{n}^{\dagger}\phi_{m}\left\langle 0\left|\left[p^{\dagger}q,n^{\dagger}m\right]\right|0\right\rangle \kappa_{pq}\\
 & + & \frac{1}{2}\left.\frac{\partial F}{\partial\rho}\right|_{\kappa=0}\phi_{n}^{\dagger}\phi_{m}\left\langle 0\left|\left[p^{\dagger}q,\left[r^{\dagger}s,n^{\dagger}m\right]\right]\right|0\right\rangle \kappa_{pq}\kappa_{rs}\\
 & + & \frac{1}{2}\left.\frac{\partial^{2}F}{\partial\rho^{2}}\right|_{\kappa=0}\phi_{n}^{\dagger}\phi_{m}\phi_{u}^{\dagger}\phi_{t}\left\langle 0\left|\left[p^{\dagger}q,n^{\dagger}m\right]\right|0\right\rangle \left\langle 0\left|\left[r^{\dagger}s,u^{\dagger}t\right]\right|0\right\rangle \kappa_{pq}\kappa_{rs}+O(\kappa^{3})\end{eqnarray*}

\end_inset 

 and the exchange-correlation functional is accordingly expanded as
\begin_inset Formula \[
E_{XC}(\kappa)=E_{XC}^{[0]}+E_{XC;pq}^{[1]}\kappa_{pq}+\frac{1}{2}E_{XC;pq,rs}^{[2]}\kappa_{pq}\kappa_{rs}+O(\kappa^{3})\]

\end_inset 


\layout Standard

For a closed-shell Hartree-Fock wave function the gradient is given as
\begin_inset Formula \begin{eqnarray*}
E_{ia}^{[1]} & = & \int\left.\frac{\partial F}{\partial\rho}\right|_{\kappa=0}\phi_{e}^{\dagger}\phi_{f}d\mathbf{r}\left\langle 0\left|\left[-i^{\dagger}a,e^{\dagger}f\right]\right|0\right\rangle \\
 & + & 2\int\left.\frac{\partial F}{\partial\grho}\right|_{\kappa=0}{\mb\grho}_{ef}\cdot{\mb\nabla}\rho_{0}d\mathbf{r}\left\langle 0\left|\left[-i^{\dagger}a,e^{\dagger}f\right]\right|0\right\rangle \\
 & = & -\left\langle \phi_{a}\left|\left.\frac{\partial F}{\partial\rho}\right|_{\kappa=0}\right|\phi_{i}\right\rangle -2\left\langle \phi_{a}\left|\left.\frac{\partial F}{\partial\grho}\right|_{\kappa=0}\right|{\mb\nabla}\rho_{0}\cdot{\mb\nabla}\phi_{i}\right\rangle \end{eqnarray*}

\end_inset 

 
\layout Section

Spin-polarized theory
\layout Subsection

Collinear approach
\layout Standard

In non-relativistic theory the spin and spatial degrees of freedom are completel
y decoupled and the z-axis is chosen as the quantization axis for spin.
 The magnetization vector is accordingly given as
\begin_inset Formula \[
\mathbf{m}=\sum_{is}\left\langle \psi_{is}^{\dagger}\left|{\mb\sigma}\right|\psi_{is}\right\rangle =(0,0,\rho^{\alpha}-\rho^{\beta})\]

\end_inset 

 It can be seen that the 
\begin_inset Formula $m_{z}$
\end_inset 

 -component equals the spin density 
\begin_inset Formula $Q(\mathbf{r})=\rho^{\alpha}-\rho^{\beta}$
\end_inset 


\begin_inset LatexCommand \cite{parr}

\end_inset 

.
 The spin polarization can be defined as
\begin_inset Formula \[
\zeta=\frac{Q}{\rho},\quad-1<\zeta<1\]

\end_inset 

 based on an undirected z-magnetization axis.
 A more general definition is
\begin_inset LatexCommand \cite{Eschrig}

\end_inset 


\begin_inset Formula \[
\zeta=\frac{\left|\mathbf{m}\right|}{\rho};\quad0<\zeta<1\]

\end_inset 

 that allows extension to non-collinear approaches.
 We note the useful relations
\begin_inset Formula \[
\rho^{\alpha}=\frac{1}{2}\left[\rho+Q\right]=\frac{1}{2}\rho\left[1+\zeta\right];\quad\rho^{\alpha}=\frac{1}{2}\left[\rho-Q\right]=\frac{1}{2}\rho\left[1-\zeta\right]\]

\end_inset 

 
\layout Section

Final approach ?
\layout Subsection

Expansion of density
\layout Standard

We write the density as
\begin_inset Formula \[
\rho(\mathbf{r},\boldsymbol{\kappa})=\left\langle \tilde{0}(\boldsymbol{\kappa})\left|a_{p}^{\dagger}a_{q}\right|\tilde{0}(\boldsymbol{\kappa})\right\rangle \Omega_{pq}(\mathbf{r})\]

\end_inset 

 which can then be expanded in the variational parameters 
\begin_inset Formula $\boldsymbol{\kappa}$
\end_inset 


\begin_inset Formula \[
\rho(\mathbf{r},\boldsymbol{\kappa})=\rho_{0}+\widetilde{\Omega}_{ii}+\frac{1}{2}\widetilde{\widetilde{\Omega}}_{ii}+\ldots\]

\end_inset 

.
 The zeroth order term is
\begin_inset Formula \[
\rho(\mathbf{r},\mathbf{0})=\left\langle 0\left|a_{p}^{\dagger}a_{q}\right|0\right\rangle \Omega_{pq}(\mathbf{r})=\Omega_{ii}.\]

\end_inset 

The first order term is
\begin_inset Formula \[
\left\langle 0\left|\left[\widehat{\kappa},\widehat{\rho}\right]\right|0\right\rangle =\left\langle 0\left|\widetilde{\rho}\right|0\right\rangle =\widetilde{\Omega}_{ii};\quad\widetilde{\rho}=\widetilde{\Omega}_{pq}a_{p}^{\dagger}a_{q};\quad\widetilde{\Omega}_{pq}=\kappa_{pt}\Omega_{tq}-\Omega_{pt}\kappa_{tq}\]

\end_inset 

 from which we obtain
\begin_inset Formula \[
\D\left.\frac{\partial\rho}{\partial\kappa_{ai}^{*}}\right|_{\boldsymbol{\kappa}=0}=-\D\left.\frac{\partial\rho}{\partial\kappa_{ia}}\right|_{\boldsymbol{\kappa}=0}=-\Omega_{ai}.\]

\end_inset 

 From the second order term we obtain
\begin_inset Formula \begin{eqnarray*}
A_{ai,bj} & = & \D\frac{\partial}{\partial\kappa_{bj}}\left[-\widetilde{\Omega}_{ai}\right]=-\left[\delta_{ab}\Omega_{ji}-\delta_{ji}\Omega_{ab}\right]\\
B_{ai,bj} & = & \D\frac{\partial}{\partial\kappa_{jb}}\left[-\widetilde{\Omega}_{ai}\right]=0\end{eqnarray*}

\end_inset 


\layout Subsection

Expansion of gradient of density
\layout Standard

The 
\begin_inset Formula $\zeta$
\end_inset 

-variable can be expanded as
\begin_inset Formula \begin{eqnarray*}
\zeta(\mathbf{r},\boldsymbol{\kappa}) & = & \mathbf{q}_{pq}\cdot\mathbf{q}_{rs}\left\langle \tilde{0}(\boldsymbol{\kappa})\left|a_{p}^{\dagger}a_{q}\right|\tilde{0}(\boldsymbol{\kappa})\right\rangle \left\langle \tilde{0}(\boldsymbol{\kappa})\left|a_{r}^{\dagger}a_{s}\right|\tilde{0}(\boldsymbol{\kappa})\right\rangle \\
 & = & \boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho_{0}+2\boldsymbol{\nabla}\rho_{0}\cdot\widetilde{\mathbf{q}}_{ii}+\widetilde{\mathbf{q}}_{ii}\cdot\widetilde{\mathbf{q}}_{jj}+\boldsymbol{\nabla}\rho_{0}\cdot\widetilde{\widetilde{\mathbf{q}}}_{ii}+\ldots\end{eqnarray*}

\end_inset 


\layout Subsection

Gradient
\layout Standard

We need
\begin_inset Formula \[
\D\frac{de_{xc}}{d\kappa_{pq}}=\frac{\partial e_{xc}}{\partial\rho}\frac{\partial\rho}{\partial\kappa_{pq}}+\frac{\partial e_{xc}}{\partial\zeta}\frac{\partial\zeta}{\partial\kappa_{pq}}\]

\end_inset 

The gradient vector is given by
\begin_inset Formula \[
\mathbf{E}_{X}^{[1]}=\left[\begin{array}{l}
\mathbf{g}\\
\mathbf{g}^{*}\end{array}\right];\quad g_{ai}=\left.\frac{\partial E_{X}}{\partial\kappa_{ai}^{*}}\right|_{{\mb\kappa}=0}=\left\langle 0\left|\left[-i^{\dagger}a,\hat{H}_{X}\right]\right|0\right\rangle =-F_{ai}\]

\end_inset 

 with
\begin_inset Formula \[
F_{pq}=h_{pq}+\D\sum\left[\left(pq\left|\right.jj\right)-\gamma\left(pj\left|\right.jq\right)\right]+\int\left(\left.\frac{\partial e_{xc}}{\partial\rho}\right|_{0}\Omega_{pq}+2\left.\frac{\partial e_{xc}}{\partial\zeta}\right|_{0}\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{pq}\right)d\mathbf{r}\]

\end_inset 


\layout Standard
\noindent 
We furthermore have
\begin_inset Formula \[
\D\frac{\partial e_{xc}}{\partial\zeta}=\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho\right|}\frac{\partial\left|\boldsymbol{\nabla}\rho\right|}{\partial\zeta}=\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho\right|}\frac{1}{2\left|\boldsymbol{\nabla}\rho\right|}\]

\end_inset 

In 
\shape smallcaps 
dirac
\shape default 
 the routine 
\shape smallcaps 
dftpot1
\shape default 
 returns 
\begin_inset Formula \[
\textrm{vx(fr0)}=\D\frac{\partial e_{xc}}{\partial\rho};\quad\textrm{vx(fz0)$=\D\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho\right|}$}\]

\end_inset 

The latter quantity is then modified to
\begin_inset Formula \[
\textrm{vx(fz0)}=\D\frac{2}{\left|\boldsymbol{\nabla}\rho\right|}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho\right|}=4\frac{\partial e_{xc}}{\partial\zeta}\]

\end_inset 

The routine 
\shape smallcaps 
doexc2
\shape default 
 next constructs the matrix
\begin_inset Formula \[
F_{pq}=\int\left(\phi_{p}\left.\frac{\partial e_{xc}}{\partial\rho}\right|_{0}\phi_{q}+4\phi_{p}\left.\frac{\partial e_{xc}}{\partial\zeta}\right|_{0}\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\phi_{q}\right)d\mathbf{r}\]

\end_inset 

 which is then symmetrized to give the desired
\begin_inset Formula \[
F_{pq}=\frac{1}{2}\left(F_{pq}+F_{qp}\right)=\int\left(\left.\frac{\partial e_{xc}}{\partial\rho}\right|_{0}\Omega_{pq}+4\left.\frac{\partial e_{xc}}{\partial\zeta}\right|_{0}\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{pq}\right)d\mathbf{r}\]

\end_inset 


\layout Subsection

Hessian
\layout Standard

We have
\begin_inset Formula \begin{eqnarray*}
\D\frac{\partial e_{xc}^{2}}{\partial\kappa_{pq}\partial\kappa_{rs}} & = & \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\frac{\partial\rho}{\partial\kappa_{pq}}\frac{\partial\rho}{\partial\kappa_{rs}}+\frac{\partial e_{xc}}{\partial\rho}\frac{\partial^{2}\rho}{\partial\kappa_{pq}\partial\kappa_{rs}}\\
 & + & \frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\left(\frac{\partial\rho}{\partial\kappa_{pq}}\frac{\partial\zeta}{\partial\kappa_{rs}}+\frac{\partial\zeta}{\partial\kappa_{pq}}\frac{\partial\rho}{\partial\kappa_{rs}}\right)+\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\frac{\partial\zeta}{\partial\kappa_{pq}}\frac{\partial\zeta}{\partial\kappa_{rs}}+\frac{\partial e_{xc}}{\partial\zeta}\frac{\partial^{2}\zeta}{\partial\kappa_{pq}\partial\kappa_{rs}}\end{eqnarray*}

