Spin-orbital basis
\layout Standard

In the functional routines of 
\shape smallcaps 
dirac
\shape default 
 the various derivatives are expressed as
\begin_inset Formula \[
\textrm{dPQRST}=\D\left(\frac{\partial}{\partial\rho^{\alpha}}\right)^{P}\left(\frac{\partial}{\partial\rho^{\beta}}\right)^{Q}\left(\frac{\partial}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\right)^{R}\left(\frac{\partial}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\right)^{S}\left(\frac{\partial}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\right)^{T}e_{xc}\]

\end_inset 

In this section we develop rules for expressing derivatives of variables
 
\begin_inset Formula $\rho$
\end_inset 

and 
\begin_inset Formula $\left|\boldsymbol{\rho}\right|$
\end_inset 

 in terms of quantities dPQRST.
 Consider the quantities
\begin_inset Formula \begin{eqnarray*}
\boldsymbol{\nabla}\rho & = & \boldsymbol{\nabla}\rho^{\alpha}+\boldsymbol{\nabla}\rho^{\beta}\\
\boldsymbol{\nabla}s & = & \boldsymbol{\nabla}\rho^{\alpha}-\boldsymbol{\nabla}\rho^{\beta}\end{eqnarray*}

\end_inset 

from which we obtain
\begin_inset Formula \begin{eqnarray*}
\left|\boldsymbol{\nabla}\rho\right|^{2} & = & \left|\boldsymbol{\nabla}\rho^{\alpha}\right|^{2}+\left|\boldsymbol{\nabla}\rho^{\beta}\right|^{2}+2\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\\
\left|\boldsymbol{\nabla}s\right|^{2} & = & \left|\boldsymbol{\nabla}\rho^{\alpha}\right|^{2}+\left|\boldsymbol{\nabla}\rho^{\beta}\right|^{2}-2\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\\
2\boldsymbol{\nabla}\rho\cdot\boldsymbol{\nabla}s & = & 2\left(\left|\boldsymbol{\nabla}\rho^{\alpha}\right|^{2}-\left|\boldsymbol{\nabla}\rho^{\beta}\right|^{2}\right)\end{eqnarray*}

\end_inset 

We invert the equations 
\begin_inset Formula \begin{eqnarray*}
\left|\boldsymbol{\nabla}\rho^{\alpha}\right| & = & \frac{1}{2}\sqrt{\left|\boldsymbol{\nabla}\rho\right|^{2}+\left|\boldsymbol{\nabla}s\right|^{2}+2\boldsymbol{\nabla}\rho\cdot\boldsymbol{\nabla}s}\\
\left|\boldsymbol{\nabla}\rho^{\beta}\right| & = & \frac{1}{2}\sqrt{\left|\boldsymbol{\nabla}\rho\right|^{2}+\left|\boldsymbol{\nabla}s\right|^{2}-2\boldsymbol{\nabla}\rho\cdot\boldsymbol{\nabla}s}\\
\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta} & = & \frac{1}{4}\left(\left|\boldsymbol{\nabla}\rho\right|^{2}-\left|\boldsymbol{\nabla}s\right|^{2}\right)\end{eqnarray*}

\end_inset 


\series bold 
First derivatives
\series default 
 are now given by
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\D\frac{\partial e_{xc}}{\partial\rho} & = & \frac{\partial e_{xc}}{\partial\rho^{\alpha}}\frac{\partial\rho^{\alpha}}{\partial\rho}+\frac{\partial e_{xc}}{\partial\rho^{\beta}}\frac{\partial\rho^{\beta}}{\partial\rho}=\frac{1}{2}\frac{\partial e_{xc}}{\partial\rho^{\alpha}}+\frac{1}{2}\frac{\partial e_{xc}}{\partial\rho^{\beta}}\\
\D\frac{\partial e_{xc}}{\partial\left|\nabla\rho\right|} & = & \frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\frac{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}{\partial\left|\boldsymbol{\nabla}\rho\right|}+\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\frac{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}{\partial\left|\boldsymbol{\nabla}\rho\right|}+\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\frac{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}{\partial\left|\boldsymbol{\nabla}\rho\right|}\\
 & = & \frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\frac{\left|\boldsymbol{\nabla}\rho\right|}{\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}+\frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\frac{\left|\boldsymbol{\nabla}\rho\right|}{\left|\boldsymbol{\nabla}\rho^{\beta}\right|}+\frac{1}{2}\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\left|\boldsymbol{\nabla}\rho\right|\\
\D\frac{\partial e_{xc}}{\partial\left|\nabla s\right|} & = & \frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\frac{\left|\boldsymbol{\nabla}s\right|}{\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}+\frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\frac{\left|\boldsymbol{\nabla}s\right|}{\left|\boldsymbol{\nabla}\rho^{\beta}\right|}-\frac{1}{2}\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\left|\boldsymbol{\nabla}s\right|\end{eqnarray*}

\end_inset 

In the closed-shell case this reduces to
\begin_inset Formula \begin{eqnarray*}
\D\frac{\partial e_{xc}}{\partial\rho} & = & \frac{\partial e_{xc}}{\partial\rho^{\alpha}}\\
\frac{\partial e_{xc}}{\partial\left|\nabla\rho\right|} & = & \frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}+\frac{1}{2}\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\left|\boldsymbol{\nabla}\rho\right|\\
\frac{\partial e_{xc}}{\partial\left|\nabla s\right|} & = & \frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}-\frac{1}{2}\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\left|\boldsymbol{\nabla}s\right|\end{eqnarray*}

\end_inset 


