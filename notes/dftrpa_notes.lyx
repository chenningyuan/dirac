\layout Section

Final approach ?
\layout Subsection

Expansion of density
\layout Standard

We write the density as
\begin_inset Formula \[
\rho(\mathbf{r},\boldsymbol{\kappa})=\left\langle \tilde{0}(\boldsymbol{\kappa})\left|a_{p}^{\dagger}a_{q}\right|\tilde{0}(\boldsymbol{\kappa})\right\rangle \Omega_{pq}(\mathbf{r})\]

\end_inset 

 which can then be expanded in the variational parameters 
\begin_inset Formula $\boldsymbol{\kappa}$
\end_inset 


\begin_inset Formula \[
\rho(\mathbf{r},\boldsymbol{\kappa})=\sum_{n=0}^{\infty}\rho^{(n)},\quad\rho^{(n)}=\frac{1}{n!}\Omega_{ii}^{\{ n\}};\quad\Omega_{pq}^{\{ n\}}=\kappa_{pt}\Omega_{tq}^{\{ n-1\}}-\Omega_{pt}^{\{ n-1\}}\kappa_{tq}\]

\end_inset 

 We will need the following derivatives
\begin_inset Formula \begin{eqnarray*}
\left.\frac{\partial\rho}{\partial\kappa_{ai}^{*}}\right|_{\boldsymbol{\kappa}=\mathbf{0}} & = & -\left.\frac{\partial\rho^{(1)}}{\partial\kappa_{ia}}\right|_{\boldsymbol{\kappa}=\mathbf{0}}=-\Omega_{ai}\\
\left.\frac{d}{d\varepsilon_{B}}\left[\frac{\partial\rho}{\partial\kappa_{ai}^{*}}\right]\right|_{\boldsymbol{\kappa}=\mathbf{0}} & = & -\left.\frac{d}{d\varepsilon_{B}}\left[\frac{\partial\rho^{(2)}}{\partial\kappa_{ia}}\right]\right|_{\boldsymbol{\kappa}=\mathbf{0}}=\frac{d}{d\varepsilon_{B}}\Omega_{ai}^{\{1\}}\equiv\Omega_{ai}^{B}\end{eqnarray*}

\end_inset 


\layout Subsection

Expansion of gradient of density
\layout Standard

The 
\begin_inset Formula $\zeta$
\end_inset 

-variable can be expanded as
\begin_inset Formula \[
\zeta(\mathbf{r},\boldsymbol{\kappa})=\boldsymbol{\nabla}\rho\cdot\boldsymbol{\nabla}\rho=\sum_{n=0}^{\infty}\zeta^{(n)}\]

\end_inset 

 in which appears
\begin_inset Formula \begin{eqnarray*}
\zeta^{(0)} & = & \boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho_{0}\\
\zeta^{(1)} & = & 2\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{(1)}\right)\\
\zeta^{(2)} & = & 2\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{(2)}\right)+\left(\boldsymbol{\nabla}\rho^{(1)}\cdot\boldsymbol{\nabla}\rho^{(1)}\right)\\
\zeta^{(3)} & = & 2\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{(3)}\right)+2\left(\boldsymbol{\nabla}\rho^{(1)}\cdot\boldsymbol{\nabla}\rho^{(2)}\right)\end{eqnarray*}

\end_inset 

 We will need the following derivatives
\begin_inset Formula \begin{eqnarray*}
\left.\frac{\partial\zeta}{\partial\kappa_{ai}^{*}}\right|_{\boldsymbol{\kappa}=\mathbf{0}} & = & -2\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{ai}\right)\\
\left.\frac{d}{d\varepsilon_{B}}\left(\frac{\partial\zeta}{\partial\kappa_{ai}^{*}}\right)\right|_{\boldsymbol{\kappa}=\mathbf{0}} & = & -\left[2\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{ai}^{B}\right)+2\left(\boldsymbol{\nabla}\rho^{B}\cdot\boldsymbol{\nabla}\Omega_{ai}\right)\right]\end{eqnarray*}

\end_inset 

 as well as
\begin_inset Formula \begin{eqnarray*}
\D\frac{\partial e_{xc}}{\partial\zeta} & = & \frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho\right|}\frac{1}{2\left|\boldsymbol{\nabla}\rho\right|}\\
\D\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}} & = & \frac{1}{4\left|\boldsymbol{\nabla}\rho\right|^{2}}\left[\frac{\partial^{2}e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho\right|^{2}}-\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho\right|}\frac{1}{\left|\boldsymbol{\nabla}\rho\right|}\right]\end{eqnarray*}

\end_inset 


\layout Subsection

The routine 
\shape smallcaps 
doexc2
\layout Standard

The routine 
\shape smallcaps 
doexc2
\shape default 
 will construct matrices
\begin_inset Formula \begin{equation}
F_{pq}=\int s\Omega_{pq}+\mathbf{v}\cdot\boldsymbol{\nabla}\Omega_{pq}d\tau\label{eq:doexc2}\end{equation}

\end_inset 

 In the case of a symmetric operator (and matrix) the routine will construct
 an intermediate 
\emph on 
non-symmetric
\emph default 
 matrix
\begin_inset Formula \[
H_{pq}=\int\left(\chi_{p}s\chi_{q}+2\chi_{p}\mathbf{v}\cdot\boldsymbol{\nabla}\chi_{q}\right)d\tau\]

\end_inset 

 The final desired matrix is then obtained by symmetrization
\begin_inset Formula \[
F_{pq}=\frac{1}{2}\left(H_{pq}+H_{qp}\right)\]

\end_inset 


\layout Subsection

Gradient
\layout Standard

We need
\begin_inset Formula \[
\left.\frac{\partial E_{xc}}{\partial\kappa_{ai}^{*}}\right|_{\boldsymbol{\kappa}=\mathbf{0}}=\int\left[\frac{\partial e_{xc}}{\partial\rho}\frac{\partial\rho}{\partial\kappa_{ai}^{*}}+\frac{\partial e_{xc}}{\partial\zeta}\frac{\partial\zeta}{\partial\kappa_{ai}^{*}}\right]d\tau=-F_{xc;ai}\]

\end_inset 

 in which appears the xc-part of the Kohn-Sham matrix
\begin_inset Formula \[
F_{xc;pq}=\int\left[\frac{\partial e_{xc}}{\partial\rho}\Omega_{pq}+2\frac{\partial e_{xc}}{\partial\zeta}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{pq}\right)\right]d\tau\]

\end_inset 

 The matrix has the form (
\begin_inset LatexCommand \ref{eq:doexc2}

\end_inset 

) in which appears
\begin_inset Formula \begin{equation}
\begin{array}{lclcl}
s & = & \D\left.\frac{\partial e_{xc}}{\partial\rho}\right|_{0}\\
\\\mathbf{v} & = & \D2\frac{\partial e_{xc}}{\partial\zeta}\boldsymbol{{\nabla}}\rho_{0} & = & \D\frac{\partial e_{\textrm{xc}}}{\partial\left|\boldsymbol{{\nabla}}\rho\right|}\frac{1}{\left|\boldsymbol{{\nabla}}\rho\right|}\end{array}\label{eq:Vxc-1order}\end{equation}

\end_inset 


\layout Subsection

Linear response
\layout Standard

We need
\begin_inset Formula \begin{eqnarray*}
\left.\frac{d}{d\varepsilon_{B}}\left[\frac{\partial E_{xc}}{\partial\kappa_{ai}^{*}}\right]\right|_{\boldsymbol{\kappa}=\mathbf{0}} & = & -\int\left[\frac{\partial e_{xc}}{\partial\rho}\frac{d}{d\varepsilon_{B}}\left(\frac{\partial\rho}{\partial\kappa_{ia}}\right)+\frac{\partial e_{xc}}{\partial\zeta}\frac{d}{d\varepsilon_{B}}\left(\frac{\partial\zeta}{\partial\kappa_{ia}}\right)\right.\\
 & + & \left.\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\frac{\partial\rho}{\partial\kappa_{ia}}\frac{d\rho}{d\varepsilon_{B}}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\frac{\partial\zeta}{\partial\kappa_{ia}}\frac{d\rho}{d\varepsilon_{B}}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\frac{\partial\rho}{\partial\kappa_{ia}}\frac{d\zeta}{d\varepsilon_{B}}+\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\frac{\partial\zeta}{\partial\kappa_{ia}}\frac{d\zeta}{d\varepsilon_{B}}\right]d\tau\\
 & = & -\int\left[\frac{\partial e_{xc}}{\partial\rho}\rho_{ia}^{B}+\frac{\partial e_{xc}}{\partial\zeta}\zeta_{ia}^{B}\right.\\
 & + & \left.\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho_{ia}\rho^{B}++\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\rho_{ia}\zeta^{B}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\zeta_{ia}\rho^{B}+\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\zeta_{ia}\zeta^{B}\right]d\tau\\
 & = & -\left(F_{xc;ai}^{B}+G_{xc;ai}\right)\end{eqnarray*}

\end_inset 

 in which appears the one-index transformed Kohn-Sham matrix (xc part)
\begin_inset Formula \[
F_{xc;pq}^{B}=\int\left[\frac{\partial e_{xc}}{\partial\rho}\Omega_{pq}^{B}+2\frac{\partial e_{xc}}{\partial\zeta}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{pq}^{B}\right)\right]d\tau\]

\end_inset 

 and the matrix
\begin_inset Formula \begin{eqnarray*}
G_{xc;pq} & = & \int\left[\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho^{B}\Omega_{pq}+2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\left\{ \left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)\Omega_{pq}+\rho^{B}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{pq}\right)\right\} \right.\\
 & + & \left.2\frac{\partial e_{xc}}{\partial\zeta}\left(\boldsymbol{\nabla}\rho^{B}\cdot\boldsymbol{\nabla}\Omega_{pq}\right)+4\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\Omega_{pq}\right)\right]d\tau\end{eqnarray*}

\end_inset 

 The matrix has the form (
\begin_inset LatexCommand \ref{eq:doexc2}

\end_inset 

) in which appears
\begin_inset Formula \begin{eqnarray*}
s & = & \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho^{B}+2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)=\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho^{B}+\frac{\partial e_{xc}}{\partial\rho\partial\left|\boldsymbol{\nabla}\rho\right|}\frac{\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)}{\left|\boldsymbol{\nabla}\rho\right|}\\
\mathbf{v} & = & 2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\rho^{B}\boldsymbol{\nabla}\rho_{0}+2\frac{\partial e_{xc}}{\partial\zeta}\boldsymbol{\nabla}\rho^{B}+4\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)\boldsymbol{\nabla}\rho_{0}\\
 & = & \left\{ \frac{\partial e_{\textrm{xc}}}{\partial\left|\boldsymbol{{\nabla}}\rho\right|}\boldsymbol{\nabla}\rho^{B}+\left(\frac{\partial e_{xc}}{\partial\rho\partial\left|\boldsymbol{\nabla}\rho\right|}\rho^{B}+\left[\frac{\partial^{2}e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho\right|^{2}}-\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho\right|}\frac{1}{\left|\boldsymbol{\nabla}\rho\right|}\right]\frac{\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)}{\left|\boldsymbol{\nabla}\rho\right|}\right)\boldsymbol{\nabla}\rho_{0}\right\} \frac{1}{\left|\boldsymbol{\nabla}\rho\right|}\end{eqnarray*}

\end_inset 


\layout Subsection

Quadratic reponse
\layout Standard

We need
\begin_inset Formula \begin{eqnarray*}
\left.\frac{d^{2}}{d\varepsilon_{B}d\varepsilon_{C}}\left[\frac{\partial E_{xc}}{\partial\kappa_{ai}^{*}}\right]\right|_{\boldsymbol{\kappa}=\mathbf{0}} & = & -\int\left[\frac{\partial e_{xc}}{\partial\rho}\rho_{ia}^{BC}+\frac{\partial e_{xc}}{\partial\zeta}\zeta_{ia}^{BC}\right.\\
 & + & \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho_{ia}^{B}\rho^{C}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\rho_{ia}^{B}\zeta^{C}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\zeta_{ia}^{B}\rho^{C}+\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\zeta_{ia}^{B}\zeta^{C}\\
 & + & \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho_{ia}^{C}\rho^{B}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\rho_{ia}^{C}\zeta^{B}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\zeta_{ia}^{C}\rho^{B}+\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\zeta_{ia}^{C}\zeta^{B}\\
 & + & \frac{\partial^{3}e_{xc}}{\partial\rho^{3}}\rho_{ia}\rho^{B}\rho^{C}+\frac{\partial^{3}e_{xc}}{\partial\rho^{2}\partial\zeta}\rho_{ia}\rho^{B}\zeta^{C}+\frac{\partial^{3}e_{xc}}{\partial\rho^{2}\partial\zeta}\rho_{ia}\zeta^{B}\rho^{C}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta^{2}}\rho_{ia}\zeta^{B}\zeta^{C}\\
 & + & \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho_{ai}\rho^{BC}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\rho_{ai}\zeta^{BC}+\frac{\partial^{3}e_{xc}}{\partial\zeta^{3}}\zeta_{ia}\zeta^{B}\zeta^{C}+\frac{\partial^{3}e_{xc}}{\partial\rho\partial\zeta^{2}}\zeta_{ia}\rho^{B}\zeta^{C}\\
 & + & \left.\frac{\partial^{3}e_{xc}}{\partial\rho\partial\zeta^{2}}\zeta_{ia}\zeta^{B}\rho^{C}+\frac{\partial^{3}e_{xc}}{\partial\rho^{2}\partial\zeta}\zeta_{ia}\rho^{B}\rho^{C}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\zeta_{ai}\rho^{BC}+\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\zeta_{ia}\zeta^{BC}\right|d\tau\\
 & = & -\left(F_{xc;ai}^{BC}+G_{xc;ai}^{B}+G_{xc;ai}^{C}+H_{xc;ai}\right)\end{eqnarray*}

\end_inset 

 where appears the two-index transformed Kohn-Sham matrix 
\begin_inset Formula $F_{xc;ai}^{BC}$
\end_inset 

 , the one-index transformed 
\begin_inset Formula $G$
\end_inset 

 matrix (with respect to B and C separately) and a new quantity 
\begin_inset Formula $H_{xc;pq}$
\end_inset 

.
 The matrix has the form
\begin_inset Formula \[
H_{xc;pq}=\int s\Omega_{pq}+\mathbf{v}\cdot\boldsymbol{\nabla}\Omega_{pq}d\tau\]

\end_inset 

 with
\begin_inset Formula \begin{eqnarray*}
s & = & \frac{\partial^{3}e_{xc}}{\partial\rho^{3}}\rho^{B}\rho^{C}+\frac{\partial^{3}e_{xc}}{\partial\rho^{2}\partial\zeta}\rho^{B}\zeta^{C}+\frac{\partial^{3}e_{xc}}{\partial\rho^{2}\partial\zeta}\zeta^{B}\rho^{C}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta^{2}}\zeta^{B}\zeta^{C}+\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho^{BC}+\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\zeta^{BC}\\
 & = & \frac{\partial^{3}e_{xc}}{\partial\rho^{3}}\rho^{B}\rho^{C}+2\frac{\partial^{3}e_{xc}}{\partial\rho^{2}\partial\zeta}\left\{ \rho^{B}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{C}\right)+\rho^{C}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)\right\} +4\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta^{2}}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{C}\right)\\
 & + & \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho^{BC}+2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\left\{ \left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{BC}\right)+\left(\boldsymbol{\nabla}\rho^{B}\cdot\boldsymbol{\nabla}\rho^{C}\right)\right\} \\
\mathbf{v} & = & 8\frac{\partial^{3}e_{xc}}{\partial\zeta^{3}}\boldsymbol{\nabla}\rho_{0}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{C}\right)+4\frac{\partial^{3}e_{xc}}{\partial\rho\partial\zeta^{2}}\boldsymbol{\nabla}\rho_{0}\left\{ \rho^{B}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{C}\right)+\rho^{C}\left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{B}\right)\right\} \\
 & + & 2\frac{\partial^{3}e_{xc}}{\partial\rho^{2}\partial\zeta}\boldsymbol{\nabla}\rho_{0}\rho^{B}\rho^{C}+2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\boldsymbol{\nabla}\rho_{0}\rho^{BC}+4\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\boldsymbol{\nabla}\rho_{0}\left\{ \left(\boldsymbol{\nabla}\rho_{0}\cdot\boldsymbol{\nabla}\rho^{BC}\right)+\left(\boldsymbol{\nabla}\rho^{B}\cdot\boldsymbol{\nabla}\rho^{C}\right)\right\} \end{eqnarray*}

\end_inset 

 
\layout Subsection

Spin-orbital basis
\layout Standard

In the functional routines of 
\shape smallcaps 
dirac
\shape default 
 the various derivatives are expressed as
\begin_inset Formula \[
\textrm{dPQRST}=\D\left(\frac{\partial}{\partial\rho^{\alpha}}\right)^{P}\left(\frac{\partial}{\partial\rho^{\beta}}\right)^{Q}\left(\frac{\partial}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\right)^{R}\left(\frac{\partial}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\right)^{S}\left(\frac{\partial}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\right)^{T}e_{xc}\]

\end_inset 

In this section we develop rules for expressing derivatives of variables
 
\begin_inset Formula $\rho$
\end_inset 

 and 
\begin_inset Formula $\left|\boldsymbol{\rho}\right|$
\end_inset 

 in terms of quantities dPQRST.
 Consider the quantities
\begin_inset Formula \begin{eqnarray*}
\boldsymbol{\nabla}\rho & = & \boldsymbol{\nabla}\rho^{\alpha}+\boldsymbol{\nabla}\rho^{\beta}\\
\boldsymbol{\nabla}s & = & \boldsymbol{\nabla}\rho^{\alpha}-\boldsymbol{\nabla}\rho^{\beta}\end{eqnarray*}

\end_inset 

from which we obtain
\begin_inset Formula \begin{eqnarray*}
\left|\boldsymbol{\nabla}\rho\right|^{2} & = & \left|\boldsymbol{\nabla}\rho^{\alpha}\right|^{2}+\left|\boldsymbol{\nabla}\rho^{\beta}\right|^{2}+2\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\\
\left|\boldsymbol{\nabla}s\right|^{2} & = & \left|\boldsymbol{\nabla}\rho^{\alpha}\right|^{2}+\left|\boldsymbol{\nabla}\rho^{\beta}\right|^{2}-2\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\\
2\boldsymbol{\nabla}\rho\cdot\boldsymbol{\nabla}s & = & 2\left(\left|\boldsymbol{\nabla}\rho^{\alpha}\right|^{2}-\left|\boldsymbol{\nabla}\rho^{\beta}\right|^{2}\right)\end{eqnarray*}

\end_inset 

We invert the equations 
\begin_inset Formula \begin{eqnarray*}
\left|\boldsymbol{\nabla}\rho^{\alpha}\right| & = & \frac{1}{2}\sqrt{\left|\boldsymbol{\nabla}\rho\right|^{2}+\left|\boldsymbol{\nabla}s\right|^{2}+2\boldsymbol{\nabla}\rho\cdot\boldsymbol{\nabla}s}\\
\left|\boldsymbol{\nabla}\rho^{\beta}\right| & = & \frac{1}{2}\sqrt{\left|\boldsymbol{\nabla}\rho\right|^{2}+\left|\boldsymbol{\nabla}s\right|^{2}-2\boldsymbol{\nabla}\rho\cdot\boldsymbol{\nabla}s}\\
\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta} & = & \frac{1}{4}\left(\left|\boldsymbol{\nabla}\rho\right|^{2}-\left|\boldsymbol{\nabla}s\right|^{2}\right)\end{eqnarray*}

\end_inset 


\series bold 
First derivatives
\series default 
 are now given by
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\D\frac{\partial e_{xc}}{\partial\rho} & = & \frac{\partial e_{xc}}{\partial\rho^{\alpha}}\frac{\partial\rho^{\alpha}}{\partial\rho}+\frac{\partial e_{xc}}{\partial\rho^{\beta}}\frac{\partial\rho^{\beta}}{\partial\rho}=\frac{1}{2}\frac{\partial e_{xc}}{\partial\rho^{\alpha}}+\frac{1}{2}\frac{\partial e_{xc}}{\partial\rho^{\beta}}\\
\D\frac{\partial e_{xc}}{\partial\left|\nabla\rho\right|} & = & \frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\frac{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}{\partial\left|\boldsymbol{\nabla}\rho\right|}+\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\frac{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}{\partial\left|\boldsymbol{\nabla}\rho\right|}+\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\frac{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}{\partial\left|\boldsymbol{\nabla}\rho\right|}\\
 & = & \frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\frac{\left|\boldsymbol{\nabla}\rho\right|}{\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}+\frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\frac{\left|\boldsymbol{\nabla}\rho\right|}{\left|\boldsymbol{\nabla}\rho^{\beta}\right|}+\frac{1}{2}\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\left|\boldsymbol{\nabla}\rho\right|\\
\D\frac{\partial e_{xc}}{\partial\left|\nabla s\right|} & = & \frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\frac{\left|\boldsymbol{\nabla}s\right|}{\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}+\frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\frac{\left|\boldsymbol{\nabla}s\right|}{\left|\boldsymbol{\nabla}\rho^{\beta}\right|}-\frac{1}{2}\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\left|\boldsymbol{\nabla}s\right|\end{eqnarray*}

\end_inset 

In the closed-shell case this reduces to
\begin_inset Formula \begin{eqnarray*}
\D\frac{\partial e_{xc}}{\partial\rho} & = & \frac{\partial e_{xc}}{\partial\rho^{\alpha}}=vxc(fr0)\\
\frac{\partial e_{xc}}{\partial\left|\nabla\rho\right|} & = & \frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}+\frac{1}{2}\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\left|\boldsymbol{\nabla}\rho\right|=vxc(fz0)+vxc(fg0)\left|\boldsymbol{\nabla}\rho\right|\\
\frac{\partial e_{xc}}{\partial\left|\nabla s\right|} & = & \frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}-\frac{1}{2}\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\left|\boldsymbol{\nabla}s\right|\end{eqnarray*}

\end_inset 


\layout Standard

The simplest 
\series bold 
second-derivative
\series default 
 is
\begin_inset Formula \begin{equation}
\D\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}=\frac{1}{4}\frac{\partial^{2}e_{xc}}{\partial\rho^{\alpha2}}+\frac{1}{2}\frac{\partial^{2}e_{xc}}{\partial\rho^{\alpha}\partial\rho^{\beta}}+\frac{1}{4}\frac{\partial^{2}e_{xc}}{\partial\rho^{\beta2}}\label{eq:d2exc_drho2}\end{equation}

\end_inset 

 In the closed-shell case this reduces to
\begin_inset Formula \begin{equation}
\D\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}=\frac{1}{2}\frac{\partial^{2}e_{xc}}{\partial\rho^{\alpha2}}+\frac{1}{2}\frac{\partial^{2}e_{xc}}{\partial\rho^{\alpha}\partial\rho^{\beta}}=vxc(frr)\label{eq:d2exc_drho2_closed}\end{equation}

\end_inset 


\layout Standard

Then comes
\begin_inset Formula \begin{eqnarray*}
\D\frac{\partial^{2}e_{xc}}{\partial\left|\nabla\rho\right|^{2}} & = & \frac{1}{16}\frac{\partial^{2}e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|^{2}}\left(\frac{\left|\boldsymbol{\nabla}\rho\right|}{\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\right)^{2}+\frac{1}{16}\frac{\partial^{2}e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|^{2}}\left(\frac{\left|\boldsymbol{\nabla}\rho\right|}{\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\right)^{2}+\frac{1}{8}\frac{\partial^{2}e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\frac{\left|\boldsymbol{\nabla}\rho\right|}{\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\frac{\left|\boldsymbol{\nabla}\rho\right|}{\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\\
 & + & \frac{1}{4}\frac{\partial^{2}e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\frac{\left|\boldsymbol{\nabla}\rho\right|^{2}}{\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}+\frac{1}{4}\frac{\partial^{2}e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\frac{\left|\boldsymbol{\nabla}\rho\right|^{2}}{\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\\
 & + & \frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}\left(\frac{1}{\left|\boldsymbol{\nabla}\rho^{\alpha}\right|}-\frac{1}{4}\frac{\left|\boldsymbol{\nabla}\rho\right|^{2}}{\left|\boldsymbol{\nabla}\rho^{\alpha}\right|^{3}}\right)+\frac{1}{4}\frac{\partial e_{xc}}{\partial\left|\boldsymbol{\nabla}\rho^{\beta}\right|}\left(\frac{1}{\left|\boldsymbol{\nabla}\rho^{\beta}\right|}-\frac{1}{4}\frac{\left|\boldsymbol{\nabla}\rho\right|^{2}}{\left|\boldsymbol{\nabla}\rho^{\beta}\right|^{3}}\right)\\
 & + & \frac{1}{4}\frac{\partial^{2}e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)^{2}}\left|\boldsymbol{\nabla}\rho\right|^{2}+\frac{1}{2}\frac{\partial e_{xc}}{\partial\left(\boldsymbol{\nabla}\rho^{\alpha}\cdot\boldsymbol{\nabla}\rho^{\beta}\right)}\end{eqnarray*}

\end_inset 


\layout Standard

In the closed-shell case this reduces to
\begin_inset Formula \begin{align}
