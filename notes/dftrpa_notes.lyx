\D\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta} & = & \frac{\partial e_{xc}}{\partial\rho\partial\left|\boldsymbol{\nabla}\rho\right|}\frac{1}{2\left|\boldsymbol{\nabla}\rho\right|}\end{eqnarray*}

