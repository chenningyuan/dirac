\begin_inset Formula \begin{align*}
\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho\right|^{3}}= & \frac{1}{2^{6}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|^{3}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|^{3}}+\frac{1}{2^{6}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\beta}\right|^{3}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\beta}\right|^{3}}\\
 & +\frac{3}{2^{6}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|^{2}\partial\left|\nabla\rho^{\beta}\right|}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|^{2}\left|\nabla\rho^{\beta}\right|}+\frac{3}{2^{6}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|\partial\left|\nabla\rho^{\beta}\right|^{2}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|\left|\nabla\rho^{\beta}\right|^{2}}\\
 & +\frac{3}{2^{5}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|^{2}\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|^{2}}+\frac{3}{2^{5}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\beta}\right|^{2}\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\beta}\right|^{2}}\\
 & +\frac{3}{2^{4}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|\partial\left|\nabla\rho^{\beta}\right|\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|\left|\nabla\rho^{\beta}\right|}\\
 & +\frac{3}{2^{4}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)^{2}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|}+\frac{3}{2^{4}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\beta}\right|\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)^{2}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\beta}\right|}\\
 & +\frac{1}{2^{3}}\frac{\partial^{3}e_{xc}}{\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)^{3}}\left|\nabla\rho\right|^{3}\\
 & +\frac{3}{2^{4}}\frac{\partial^{2}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|^{2}}\left[\frac{\left|\nabla\rho\right|}{\left|\nabla\rho^{\alpha}\right|^{2}}-\frac{1}{2^{2}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|^{4}}\right]+\frac{3}{2^{4}}\frac{\partial^{2}e_{xc}}{\partial\left|\nabla\rho^{\beta}\right|^{2}}\left[\frac{\left|\nabla\rho\right|}{\left|\nabla\rho^{\beta}\right|^{2}}-\frac{1}{2^{2}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\beta}\right|^{4}}\right]\\
 & +\frac{3}{2^{3}}\frac{\partial^{2}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|\partial\left|\nabla\rho^{\beta}\right|}\left[\frac{\left|\nabla\rho\right|}{\left|\nabla\rho^{\alpha}\right|\left|\nabla\rho^{\beta}\right|}-\frac{1}{2^{3}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|^{3}\left|\nabla\rho^{\beta}\right|}-\frac{1}{2^{3}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|\left|\nabla\rho^{\beta}\right|^{3}}\right]\\
 & +\frac{3}{2^{2}}\frac{\partial^{2}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)}\left[\frac{\left|\nabla\rho\right|}{\left|\nabla\rho^{\alpha}\right|}-\frac{1}{2^{3}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|^{3}}\right]\\
 & +\frac{3}{2^{2}}\frac{\partial^{2}e_{xc}}{\partial\left|\nabla\rho^{\beta}\right|\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)}\left[\frac{\left|\nabla\rho\right|}{\left|\nabla\rho^{\beta}\right|}-\frac{1}{2^{3}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\beta}\right|^{3}}\right]\\
 & +\frac{3}{2^{2}}\frac{\partial^{2}e_{xc}}{\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)^{2}}\left|\nabla\rho\right|\\
 & +\frac{3}{2^{4}}\frac{\partial e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|}\left[-\frac{\left|\nabla\rho\right|}{\left|\nabla\rho^{\alpha}\right|^{3}}+\frac{1}{2^{2}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\alpha}\right|^{5}}\right]+\frac{3}{2^{4}}\frac{\partial e_{xc}}{\partial\left|\nabla\rho^{\beta}\right|}\left[-\frac{\left|\nabla\rho\right|}{\left|\nabla\rho^{\beta}\right|^{3}}+\frac{1}{2^{2}}\frac{\left|\nabla\rho\right|^{3}}{\left|\nabla\rho^{\beta}\right|^{5}}\right]\end{align*}

\end_inset 

 which in the closed-shell case reduces to
\layout Standard


\begin_inset Formula \begin{align*}
\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho\right|^{3}}= & \frac{1}{2^{2}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|^{3}}+\frac{3}{2^{2}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|^{2}\partial\left|\nabla\rho^{\beta}\right|}+\frac{3}{2^{2}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|^{2}\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)}\left|\nabla\rho\right|\\
 & +\frac{3}{2^{2}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|\partial\left|\nabla\rho^{\beta}\right|\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)}\left|\nabla\rho\right|+\frac{3}{2^{2}}\frac{\partial^{3}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)^{2}}\left|\nabla\rho\right|^{2}\\
 & +\frac{1}{2^{3}}\frac{\partial^{3}e_{xc}}{\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)^{3}}\left|\nabla\rho\right|^{3}+\frac{3}{2}\frac{\partial^{2}e_{xc}}{\partial\left|\nabla\rho^{\alpha}\right|\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)}+\frac{3}{2^{2}}\frac{\partial^{2}e_{xc}}{\partial\left(\nabla\rho^{\alpha}\cdot\nabla\rho^{\beta}\right)^{2}}\left|\nabla\rho\right|\end{align*}

\end_inset 


\layout Subsection
\pagebreak_top 
Expansion of xc energy
\layout Standard

The third-order contribution to the exchange-correlation energy is formally
 
\layout Itemize

1st order term:
\begin_inset Formula \[
\frac{\partial e_{xc}}{\partial\kappa_{pq}}\frac{\partial\kappa_{pq}}{\partial\varepsilon_{A}}=\left(\frac{\partial e_{xc}}{\partial\rho}\frac{\partial\rho}{\partial\kappa_{pq}}+\frac{\delta e_{xc}}{\partial\zeta}\frac{\partial\zeta}{\partial\kappa_{pq}}\right)\kappa_{A;pq}^{(1)}=\frac{\partial e_{xc}}{\partial\rho}\rho_{A}^{(1)}+2\frac{\delta e_{xc}}{\partial\zeta}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{A}^{(1)}\right)\]

\end_inset 

 
\layout Itemize

2nd order term:
\begin_inset Formula \begin{eqnarray*}
\frac{\partial^{2}e_{xc}}{\partial\kappa_{pq}\partial\kappa_{rs}}\frac{\partial\kappa_{pq}}{\partial\varepsilon_{A}}\frac{\partial\kappa_{rs}}{\partial\varepsilon_{B}} & = & \left\{ \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho_{A}^{(1)}\rho_{B}^{(1)}+2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\left[P_{AB}\rho_{A}^{(1)}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{B}^{(1)}\right)\right]+\right.\\
 & + & \left.4\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{A}^{(1)}\right)\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{B}^{(1)}\right)+\frac{\partial e_{xc}}{\partial\zeta}\left(\boldsymbol{{\nabla}}\rho_{A}^{(1)}\cdot\boldsymbol{{\nabla}}\rho_{B}^{(1)}\right)\right\} \\
 & + & \left\{ \frac{\partial e_{xc}}{\partial\rho}\rho_{AB}^{(2)}+2\frac{\partial e_{xc}}{\partial\zeta}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{AB}^{(2)}\right)\right\} \end{eqnarray*}

\end_inset 


\layout Itemize

3rd order term:
\begin_inset Formula \begin{eqnarray*}
\frac{\partial^{3}e_{xc}}{\partial\kappa_{pq}\partial\kappa_{rs}\partial\kappa_{tu}}\frac{\partial\kappa_{pq}}{\partial\varepsilon_{A}}\frac{\partial\kappa_{rs}}{\partial\varepsilon_{B}}\frac{\partial\kappa_{tu}}{\partial\varepsilon_{C}} & = & \left\{ \frac{\partial^{3}e_{xc}}{\partial\rho^{3}}\rho_{A}^{(1)}\rho_{B}^{(1)}\rho_{C}^{(1)}+2\frac{\partial^{3}e_{xc}}{\partial\rho^{2}\partial\zeta}P_{ABC}\left[\rho_{A}^{(1)}\rho_{B}^{(1)}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{C}^{(1)}\right)\right]\right.\\
 & + & 4\frac{\partial^{3}e_{xc}}{\partial\rho\partial\zeta^{2}}P_{ABC}\left[\rho_{A}^{(1)}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{B}^{(1)}\right)\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{C}^{(1)}\right)\right]\\
 & + & 8\frac{\partial^{3}e_{xc}}{\partial\zeta^{3}}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{A}^{(1)}\right)\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{B}^{(1)}\right)\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{C}^{(1)}\right)\\
 & + & \frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}P_{ABC}\left[\rho_{A}^{(1)}\left(\boldsymbol{{\nabla}}\rho_{B}^{(1)}\cdot\boldsymbol{{\nabla}}\rho_{C}^{(1)}\right)\right.\\
 & + & 2\frac{\partial e_{xc}}{\partial\zeta^{2}}P_{ABC}\left[\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{A}^{(1)}\right)\left(\boldsymbol{{\nabla}}\rho_{B}^{(1)}\cdot\boldsymbol{{\nabla}}\rho_{C}^{(1)}\right)\right]\\
 & + & \left.2\frac{\partial e_{xc}}{\partial\zeta^{2}}P_{ABC}\left[\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{A}^{(1)}\right)\left(\boldsymbol{{\nabla}}\rho_{B}^{(1)}\cdot\boldsymbol{{\nabla}}\rho_{C}^{(1)}\right)\right]\right\} \\
 & + & \left\{ \frac{\partial^{2}e_{xc}}{\partial\rho^{2}}P_{ABC}\rho_{A}^{(1)}\rho_{BC}^{(2)}\right.\\
 & + & 2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}P_{ABC}\left[\rho_{AB}^{(2)}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{C}^{(1)}\right)+\rho_{A}^{(1)}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{BC}^{(2)}\right)\right.\\
 & + & 4\frac{\partial e_{xc}}{\partial\zeta^{2}}P_{ABC}\left[\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{A}^{(1)}\right)\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{BC}^{(2)}\right)\right]\\
 & + & \left.2\frac{\partial e_{xc}}{\partial\zeta}P_{ABC}\left(\boldsymbol{{\nabla}}\rho_{A}^{(1)}\cdot\boldsymbol{{\nabla}}\rho_{BC}^{(2)}\right)\right\} \\
 & + & \left\{ \frac{\partial e_{xc}}{\partial\rho}\rho_{ABC}^{(3)}+2\frac{\partial e_{xc}}{\partial\zeta}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho_{ABC}^{(3)}\right)\right\} \end{eqnarray*}

\end_inset 


\layout Standard

The contributions have been ordered according to the number of perturbed
 densities involved.
 The first-order contribution can be writtten as
\begin_inset Formula \[
V_{xc;pq}=\int s\Omega_{pq}+\mathbf{v}\cdot\boldsymbol{\nabla}\Omega_{pq}d\tau;\quad s=\left.\frac{\partial e_{xc}}{\partial\rho}\right|_{0};\quad\mathbf{v}=2\frac{\partial e_{xc}}{\partial\zeta}\boldsymbol{{\nabla}}\rho_{0}\]

\end_inset 

 The second-order contribution splits into two terms.
 The first term may be written
\begin_inset Formula \[
V_{xc;pq}^{B}=\int s\Omega_{pq}+\mathbf{v}\cdot\boldsymbol{\nabla}\Omega_{pq}d\tau;\quad\begin{array}{c}
s=\frac{\partial^{2}e_{xc}}{\partial\rho^{2}}\rho^{B}+2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho^{B}\right)\\
\\\mathbf{v}=2\frac{\partial^{2}e_{xc}}{\partial\rho\partial\zeta}\rho^{B}\boldsymbol{{\nabla}}\rho_{0}+4\frac{\partial^{2}e_{xc}}{\partial\zeta^{2}}\left(\boldsymbol{{\nabla}}\rho_{0}\cdot\boldsymbol{{\nabla}}\rho^{B}\right)\boldsymbol{{\nabla}}\rho_{0}+\frac{\partial e_{xc}}{\partial\zeta}\boldsymbol{{\nabla}}\rho^{B}\end{array}\]

\end_inset 


\layout Section
\pagebreak_top 
Subroutines for functionals
\layout Subsection

B88 exchange
\layout Standard


\begin_inset Formula \[
e_{x}^{B88}=e_{x}^{LDA}+\Delta e_{x}^{B88}\]

\end_inset 

 The B88 correction to the LSDA exchange energy density is
\begin_inset Formula \begin{eqnarray*}
\Delta e_{x}^{B88} & = & -\D\sum_{s}\rho_{s}^{4/3}\frac{\beta x_{s}^{2}}{1+\beta x_{s}\sinh^{-1}\left(x_{s}\right)}\\
 & = & -\D\sum_{s}\left|\boldsymbol{\nabla}\rho_{s}\right|\frac{\beta x_{s}}{1+\beta x_{s}\sinh^{-1}\left(x_{s}\right)}\end{eqnarray*}

\end_inset 


\layout Standard
\noindent 
where
\begin_inset Formula \[
x_{s}=\D\frac{\left|\boldsymbol{\nabla}\rho_{s}\right|}{\rho^{4/3}};\quad\D\frac{\partial x_{s}}{\partial\rho_{s}}=-\frac{4}{3}\frac{x_{s}}{\rho_{s}};\quad\D\frac{\partial x_{s}}{\partial\left|\boldsymbol{\nabla}\rho_{s}\right|}=\D\frac{1}{\rho^{4/3}}.\]

\end_inset 

 First derivatives:
\begin_inset Formula \begin{eqnarray*}
\D\frac{\partial e_{x}^{B88}}{\partial x_{s}} & = & \beta\left|\boldsymbol{\nabla}\rho_{s}\right|\frac{6\beta x_{s}^{2}-\sqrt{1+x_{s}^{2}}}{\left[1+\beta x_{s}\sinh^{-1}\left(x_{s}\right)\right]^{2}\sqrt{1+x_{s}^{2}}}\end{eqnarray*}

\end_inset 


\layout Section

Subroutines for functionals.old
\layout Subsection

Dirac exchange
\layout Standard

The general form of the exhange functional in the local-spin density approximati
on is
\begin_inset Formula \[
E_{X}^{LSDA}\left[\rho_{\alpha},\rho_{\beta}\right]=\int\rho\varepsilon_{X}^{LSDA}(\rho_{\alpha},\rho_{\alpha})d\mathbf{r};\quad C_{X}=\frac{3}{4}\left(\frac{3}{\pi}\right)^{1/3}\]

\end_inset 

 with
\begin_inset LatexCommand \cite{F.Jensen}

\end_inset 


\begin_inset Formula \[
\varepsilon_{X}^{LSDA}=-\frac{1}{2}C_{X}\rho^{1/3}\left[\left(1+\zeta\right)^{4/3}+\left(1-\zeta\right)^{4/3}\right]\]

\end_inset 

 Observe that with no spin polarization we obtain
\begin_inset Formula \begin{equation}
E_{X}^{LSDA}\quad\rightarrow\quad E_{X}^{LDA}=-C_{X}\int\rho^{4/3}d\mathbf{r}\label{eq:LDAx}\end{equation}

\end_inset 

 
\layout Subsubsection

Subroutine EDRC
\layout Standard

The subroutine EDRC calculates the integrand of 
\begin_inset Formula $E_{X}^{LDA}$
\end_inset 

 as given in Eq.(
\begin_inset LatexCommand \ref{eq:LDAx}

\end_inset 

).
\layout Subsection

Becke exchange (B88)
\layout Standard

The exchange part of 
\begin_inset Formula $E_{XC}^{GGA}$
\end_inset 

 can be written as
\begin_inset Formula \[
E_{X}^{GGA}=E_{X}^{LSDA}-\sum_{\sigma}\int F(s_{\sigma})\rho_{\sigma}^{4/3}(\mathbf{r})d\mathbf{r}\]

\end_inset 

 where we have introduced the reduced density gradient for spin 
\begin_inset Formula $\sigma$
\end_inset 


\begin_inset Formula \[
s_{\sigma}(\mathbf{r})=\frac{\left|{\nabla}\rho_{\sigma}(\mathbf{r})\right|}{\rho_{\sigma}^{4/3}(\mathbf{r})}\]

\end_inset 

 The Becke exchange functional B88 is given by
\begin_inset Formula \[
F^{B88}(s_{\sigma})=\frac{\beta s_{\sigma}^{2}}{1+6\beta s_{\sigma}\sinh^{-1}s_{\sigma}}\]

\end_inset 

 with 
\begin_inset Formula $\beta$
\end_inset 

 an empirical parameter fitted to 0.0042.
 In the case of no spin polarization the GGA exchange reduces to
\begin_inset Formula \begin{equation}
E_{X}^{GGA}=E_{X}^{LDA}-\int\left(\frac{1}{3}\right)^{1/3}F^{B88}(x)\rho^{4/3}d\mathbf{r};\quad x=\frac{\left|{\nabla}\rho(\mathbf{r})\right|}{\left(\frac{1}{2}\right)^{1/3}\rho^{4/3}(\mathbf{r})}\label{eq:B88spf}\end{equation}

\end_inset 


\layout Subsubsection

Subroutine EBCK 
\layout Standard

Remembering that
\begin_inset Formula \[
\sinh x=\frac{1}{2}\left(e^{x}-e^{-x}\right);\quad\sinh^{-1}y=\ln\left(y+\sqrt{y^{2}+1}\right)\]

\end_inset 

 the subroutine EBCK calculates the (negative) integrand of Eq.(
\begin_inset LatexCommand \ref{eq:B88spf}

\end_inset 

).
\layout Subsubsection

Subroutine GBCK
\layout Standard

Remembering that
\begin_inset Formula \[
f(y)=\sinh y\quad\Rightarrow\quad f'(y)=\frac{1}{\sqrt{1+y^{2}}}\]

\end_inset 

 we find that
\begin_inset Formula \[
\frac{\partial F(s_{\sigma})}{\partial s_{\sigma}}=\frac{2\beta s_{\sigma}}{1+6\beta s_{\sigma}\sinh^{-1}s_{\sigma}}-\frac{6\beta^{2}s_{\sigma}^{2}(\sinh^{-1}s_{\sigma}+\frac{s}{\sqrt{1+s_{\sigma}^{2}}})}{\left(1+6\beta s_{\sigma}\sinh^{-1}s_{\sigma}\right)^{2}}\]

\end_inset 


