#!/bin/sh
#
# Test latest version of DIRAC by updating the working copy and
# running the standard testset.
#
# Written by Luuk Visscher - May 15 2002
#
# Set defaults
pampath=`pwd`
dirac=`pwd`/dirac.x
testdir=`pwd`/test
cvs="yes"
queue="none"
# Define exit procedure
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Does 'echo' understand escapes?
#
#
echo_style=sysv
if [ "	" = "`echo '\t'`" ]; then
   echo="echo"
else
   echo="echo -e"
fi
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# CHECK OPTIONS
#
#
usage='Usage: '$0'\n'\
'--help\n'\
'\tPrint this\n'\
'--branch=BRANCH\n'\
'\tBranch that is to be tested (default: current branch)\n'\
'--tests=TESTS\n'\
'\tThe tests that should be run\n'\
'--testdir=TESTDIR\n'\
'\tDirectory in which the tests should be run (default: -testdir=test)\n'\
'--cvs=yes/no\n'\
'\tRun cvs prior to compilation (default: -cvs=yes)\n'\
'--queue=QUEUE\n'\
'\tQueue to be used in qsub (default: -queue=none meaning run interactively)\n'

while [ $# != 0 ]; do
   arg="$1"; shift
   case "${arg}" in
      -*=*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\([^=]*\)=.*$:\1:'`
         val=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*[^=]*=\(.*\)$:\1:'`
         valomitted=no
         ;;
      -*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\(.*\)$:\1:'`
         val="yes"
         valomitted=yes
         ;;
      *)
         $echo $usage
         exit 
   esac
   optname="${opt}"
   opt="`echo '' ${opt} | sed -e 's:^ ::' | tr - _`"
   case "${opt}" in
      "help")
         $echo $usage
         exit
         ;;
      "testdir")
         if [ "${valomitted}" = "no" ]; then
            testdir="$val"
         fi
         ;;
      "branch")
         if [ "${valomitted}" = "no" ]; then
            branch="$val"
         fi
         ;;
      "tests")
         if [ "${valomitted}" = "no" ]; then
            tests="$val"
         fi
         ;;
      "cvs")
         if [ "${valomitted}" = "no" ]; then
            cvs="$val"
         fi
         ;;
      "queue")
         if [ "${valomitted}" = "no" ]; then
            queue="$val"
         fi
         ;;
      *)
         echo  'Unknown option: '$opt''
         $echo $usage
         exit 1
         ;;
   esac
done
#
# Define the output and log files
#
if [  -z "$tests" ]; then
   run=default_test;
   tests=short;
else
   run=user_test;
fi
#
cvslog=cvs_log;
makelog=make_log;
runlog=run_log;
txtlog=${run}_dif.txt;
htmlog=${run}_dif.htm;
#
if [ ! -z "$branch" ]; then
   for i in $makelog $cvslog $txtlog $htmlog ; do
   i=${i}_$branch ;
   done
fi
#
# Make sure that we do not overwrite recent logfiles
#
echo " Saving old log files ..." 
if [ ! -e "${testdir}/logs" ]; then
   mkdir ${testdir}/logs;
fi
cd ${testdir}/logs;
for i in $makelog $cvslog $runlog $txtlog $htmlog ; do
    if [ -f "${i}" ]; then
        if [ -f "${i}.6" ]; then mv -f "${i}.6" "${i}.7"; fi
        if [ -f "${i}.5" ]; then mv -f "${i}.5" "${i}.6"; fi
        if [ -f "${i}.4" ]; then mv -f "${i}.4" "${i}.5"; fi
        if [ -f "${i}.3" ]; then mv -f "${i}.3" "${i}.4"; fi
        if [ -f "${i}.2" ]; then mv -f "${i}.2" "${i}.3"; fi
        if [ -f "${i}.1" ]; then mv -f "${i}.1" "${i}.2"; fi
        if [ -f "${i}.0" ]; then mv -f "${i}.0" "${i}.1"; fi
        if [ -f "${i}" ]; then mv -f "${i}" "${i}.0" ; fi
    fi
done
cd ${pampath};
#
if [ "${cvs}" = "yes" ]; then
  if [  -z "$branch" ]; then 
     echo ' Starting CVS Update ... ' ;
     cvs update -P -d > ${testdir}/logs/$cvslog 2>&1 || \
  { echo " CVS update failed" ; \
    echo " now we are here" ; \
    exit 1 ;\
  }
  else
     echo " Switching working copy to branch $branch and updating ..."
     cvs update -P -d -r $branch > ${testdir}/logs/$cvslog 2>&1 || \
  { echo " CVS update failed" ; \
    echo " Please check the logfile ${testdir}/logs/$cvslog" ; \
    exit 1 ;\
  }
  fi
fi
#
#
echo ' Checking dependencies ... '
make depend > ${testdir}/logs/$makelog 2>&1 || \
{ echo " Make depend failed" ; \
  echo " Please check the logfile ${testdir}/logs/$makelog" ; \
  exit 1 ;\
}
echo ' Recompiling ... '
make >> ${testdir}/logs/$makelog 2>&1 || \
{ echo " Make failed" ; \
  echo " Please check the logfile ${testdir}/logs/$makelog" ; \
  exit 1 ;\
}
if [ "${queue}" = "none" ]; then
echo ' Starting test calculations interactively ... '
cd ${testdir};
./runtest --tests=$tests --pampath=$pampath --dirac=$dirac --run=$run > ${testdir}/logs/$runlog 2>&1 || \
{ echo " runtest failed" ; \
  echo " Please check the logfile ${testdir}/logs/$runlog" ; \
  exit 1 ;\
}
else
#
# The tests are default run interactively on the same machine as the cvs and make command is run.
# Below is also a script that works with the pbs (qsub) batch environment that we use on our
# Linux cluster. It should be relatively easy to adapt this to other queue systems.
# (LV, June 04, 2002)
#
echo " Submitting test calculations to queue $queue ... "
echo " When they are done please check the results in the directory ${testdir}/logs. "
errfile=das500:${testdir}/logs/$runlog
cat <<EOF >job
cd ${testdir};
./runtest --tests=$tests --pampath=$pampath --dirac=$dirac --run=$run ;
EOF
qsub -j oe -o $errfile -l walltime=24:00:00,nodes=1:$queue -q ${queue}q -V job
rm job
fi
#
