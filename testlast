#!/bin/bash
#. /etc/profile  # profile is not executed by cron (uncomment this line if you use testlast with cron)
#
# Test latest version of DIRAC by updating the working copy and
# running the standard testset.
#
# Written by Luuk Visscher - May 15 2002
#
# Set defaults
testlastpath=`pwd`
# --------------------------------------
# Use pam and dirac.x defined in $testdir/runtest.
pampath=' '
diracexe=' '
# You can override this by uncommeting the next two lines and modify them appropriately.
#pampath="--pampath=`pwd`"
#diracexe="--dirac=`pwd`/dirac.x"
# --------------------------------------
testdir=`pwd`/test
RUNTYPE="undefined"
TIMEOUT=''
svn="no"
mpi=" "
parallel=" "
nodes=1
queue="none"
time="4:00:00"
OVERWRITE_REFERENCE="undefined"
# Define exit procedure
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Does 'echo' understand escapes?
#
#
echo_style=sysv
if [ "	" = "`echo '\t'`" ]; then
   echo="echo"
else
   echo="echo -e"
fi
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# Define backup function /hjaaj
#
backup () {
  if [ "$1" = "-v" ]; then ekko=1; shift
  else ekko=0;
  fi
  for i in $* ; do
     if [ -f "${i}" ]; then
        for j in 6 5 4 3 2 1 0 ; do
           let jp=$j+1
           if [ -f "${i}.${j}" ]; then 
              [ $ekko -eq 1 ] && echo "Backup: renaming ${i}.${j} to ${i}.${jp}"
              mv -f "${i}.${j}" "${i}.${jp}"
           fi
        done
        if [ $ekko -eq 1 ]; then echo "Backup: renaming ${i} to ${i}.0"; fi
        mv -f "${i}" "${i}.0"
     fi
  done
}
#
#
# CHECK OPTIONS
#
#
usage='Usage: '$0'\n'\
'--help\n'\
'\tPrint this\n'\
'\tA common error is to forget the = character, e.g. -q long instead of the correct -q=long\n'\
'--tests=TESTS\n'\
'\tThe tests that should be run (default: --tests=short)\n'\
'\tKnown tests: "short", "medium", "long", "all", or the number(s) of some specific tests\n'\
'--runtype=RUNTYPE\n'\
'\tshort, medium, etc. (default: undefined)\n'\
'--testdir=TESTDIR\n'\
'\tDirectory in which the tests should be run (default: --testdir=test)\n'\
'--svn=yes/no\n'\
'\tRun svn prior to compilation (default: --svn=no)\n'\
'--mpi=MPI\n'\
'\tNumber of nodes to be used (default: run serial job)\n'\
'--time=TIME\n'\
"\tRuntime (for the queueing system) (default: $time)\n"\
'--timeout=TIMEOUT\n'\
'\ttime for allowing dirac run (killed afterwards) \n'\
'--overwrite=yes\n'\
'\toverwrite reference outputs (this is for updating tests, use with care)\n'\
'--q=QUEUE\n'\
'\tQueue to be used in qsub (default: -q=none meaning run interactively)\n'

while [ $# != 0 ]; do
   arg="$1"; shift
   case "${arg}" in
      -*=*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\([^=]*\)=.*$:\1:'`
         val=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*[^=]*=\(.*\)$:\1:'`
         valomitted=no
         ;;
      -*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\(.*\)$:\1:'`
         val="yes"
         valomitted=yes
         ;;
      *)
         $echo "Invalid argument: ${arg}"
         $echo "NOTE: $0 does not accept any arguments, only options!"
         $echo $usage
         exit 
   esac
   optname="${opt}"
   opt="`echo '' ${opt} | sed -e 's:^ ::' | tr - _`"
   case "${opt}" in
      "help")
         $echo $usage
         exit
         ;;
      "testdir")
         if [ "${valomitted}" = "no" ]; then
            testdir="$val"
         fi
         ;;
      "tests")
         if [ "${valomitted}" = "no" ]; then
            tests="$val"
         fi
         ;;
      "runtype")
         if [ "${valomitted}" = "no" ]; then
            RUNTYPE="$val"
         fi
         ;;
      "svn")
         if [ "${valomitted}" = "no" ]; then
            svn="$val"
         fi
         ;;
      "mpi")
         if [ "${valomitted}" = "no" ]; then
            nodes=$val
            mpi="--mpi=$nodes"
            parallel="-pe mpich $nodes"
         fi
         ;;
      "q")
         if [ "${valomitted}" = "no" ]; then
            queue="$val"
         fi
         ;;
      "queue")
         if [ "${valomitted}" = "no" ]; then
            queue="$val"
         fi
         ;;
      "time")
         if [ "${valomitted}" = "no" ]; then
            time="$val"
         fi
         ;;
      "timeout")
         if [ "${valomitted}" = "no" ]; then
            TIMEOUT="$val"
         fi
         ;;
      "overwrite")
         if [ "${valomitted}" = "no" ]; then
            OVERWRITE_REFERENCE="$val"
         fi
         ;;
      *)
         echo  'Unknown option: '$opt''
         $echo $usage
         exit 1
         ;;
   esac
done
#
# Define the output and log files
#
errfile=${testdir}/logs/lastrun
if [ -f $errfile ]; then
   backup -v $errfile
fi
if [  -z "$tests" ]; then
   run=default_test;
   tests=short;
   echo ' Will do default tests : ' $tests ;
else
   case "${tests}" in
      "short")
      run=short_test;
      echo ' Will do preselected test set : ' $tests ;
      ;;
      "medium")
      run=medium_test;
      echo ' Will do preselected test set : ' $tests ;
      ;;
      "long")
      run=long_test;
      echo ' Will do preselected test set : ' $tests ;
      ;;
      "all")
      run=all_test;
      echo ' Will do preselected test set : ' $tests ;
      ;;
      *)
      run=user_test;
      echo ' Will do (in runtime "'$RUNTYPE'" mode) user selected tests : ' $tests ;
      ;;
   esac
fi

#

svnlog=svn_log;
makelog=make_log;
runlog=${run}_run.log;
txtlog=${run}_dif.txt;
htmlog=${run}_dif.htm;
#
# Make sure that we do not overwrite recent logfiles
#
echo " Saving old log files ..." 
if [ ! -d "${testdir}/logs" ]; then
   mkdir ${testdir}/logs;
fi
cd ${testdir}/logs;
backup $makelog
backup $svnlog
backup $runlog
backup $txtlog
backup $htmlog

# >>-*-*-*-*> do svn update and make if $svn is yes

cd ${testlastpath};
#
if [ "${svn}" = "yes" ]; then
  echo ' Starting SVN Update ... ' ;
 # cvs update -P -d > ${testdir}/logs/$cvslog 2>&1 || \
  svn up > ${testdir}/logs/$svnlog 2>&1 || \
  { echo " SVN update failed" ; \
    echo " Here is the logfile ${testdir}/logs/$svnlog" ; \
    cat ${testdir}/logs/$svnlog ; \
    exit 1 ;\
  }
#
#
  echo ' Making the Makefiles (running ./pamadm --adm) - basic set of modules ...'
  ./pamadm --adm  > ${testdir}/logs/$makelog 2>&1 || \
  { echo " Running pamadm failed" ; \
    echo " Here is the logfile ${testdir}/logs/$makelog" ; \
    cat ${testdir}/logs/$makelog ; \
    exit 1 ;\
  }
  echo ' Cleaning (and checking dependencies...) '
  #make depend >> ${testdir}/logs/$makelog 2>&1 || \
  make clean >> ${testdir}/logs/$makelog 2>&1 || \
  { echo " Make clean/depend failed" ; \
    echo " Here is the logfile ${testdir}/logs/$makelog" ; \
    cat ${testdir}/logs/$makelog ; \
    exit 1 ;\
  }
  echo ' Recompiling ... '
  make >> ${testdir}/logs/$makelog 2>&1 || \
  { echo " Make failed" ; \
    echo " Here is the logfile ${testdir}/logs/$makelog" ; \
    cat ${testdir}/logs/$makelog ; \
    exit 1 ;\
  }
fi

# >>-*-*-*-*> Create job script "job_testlast.sh"

cat <<EOF >job_testlast.sh
#!/bin/bash
#
# This file is a test job script created by the 'testlast' script
#
echo " Starting runtest to run tests at \`date\`"
cd ${testdir};



#radovan: why this doubling of code? can the value of timeout not be checked inside?
if [ -n "$TIMEOUT" ]; then
#  ... include TIMEOUT flag
./runtest --tests="$tests" --runtype="$RUNTYPE" $pampath $mpi $diracexe --run=$run --timeout=$TIMEOUT --overwrite=$OVERWRITE_REFERENCE> ./logs/$runlog || \
{ echo " runtest failed" ; \
  echo " Here is the logfile ${testdir}/logs/$runlog" ; \
  cat ${testdir}/logs/$runlog ; \
  exit 1 ;\
}
else
# no TIMEOUT flag ...
./runtest --tests="$tests" --runtype="$RUNTYPE" $pampath $mpi $diracexe --run=$run                    --overwrite=$OVERWRITE_REFERENCE> ./logs/$runlog || \
{ echo " runtest failed" ; \
  echo " Here is the logfile ${testdir}/logs/$runlog" ; \
  cat ${testdir}/logs/$runlog ; \
  exit 1 ;\
}
fi

if [ -f logs/$txtlog ]; then
   echo " =============================================================================="
   echo "           Final summary from $0"
   echo " =============================================================================="
   if [ -s logs/$txtlog ]; then
      echo " Calculations completed at \`date\` with one or more errors"
      echo " Below follows the list of tests that failed :"
      cat logs/$txtlog
      exit \`sed -n '\$=' logs/$txtlog\`
    else
      echo " Calculations completed at \`date\` : no errors were detected"
    fi
else
    echo ' Calculations were not completed : the run log logs/$runlog follows'
    cat logs/$runlog
fi
EOF

# ... decide whether it is serial or parallel according to mpi parameter
if [ -z $mpi ]; then
 echo ' Tests in serial mode '
else
 echo ' Tests in parallel mode (mpi='$nodes')'
fi

# ... printout on "timeout"
if [ -n "$TIMEOUT" ]; then
 echo ' Forced stop of all test processes after time of '$TIMEOUT''
fi

# >>-*-*-*-*> Run job script interactively or batch, depending on $queue
if [ "${queue}" = "none" ]; then
  # The tests are default run interactively on the same machine as the svn and make command is run.
  echo ' Starting test calculations interactively ... '
  chmod u+x job_testlast.sh
  ./job_testlast.sh
  RT=$? 
  echo " job_testlash.sh finished with code $RT"
  exit $RT
else
  echo " Submitting test calculations to queue $queue ... "
  echo " When they are done please check the results in the directory ${testdir}/logs. "
  #
  # This is a script that works with the pbs (qsub) batch environment
  #
  # qsub -j oe -o $errfile -l walltime=$time,nodes=$nodes -q ${queue} -V job_testlast.sh
  #
  # Other queue systems used in Amsterdam. Add you own as new comment line if you like
  #
  #tc: tcsub wrapper from tctools module
   chmod a+x job_testlast.sh; tcsub -a generic -n 1 -q $queue -p mpich job_testlast.sh $time
  #oldtc: qsub -e $errfile -o $errfile -l s_cpu=$time -cwd -V $parallel -l queue=$queue -N testlast job_testlast.sh
  #das:  /usr/local/bin/qsub -j oe -o fs0.das2.cs.vu.nl:$errfile -l walltime=$time,nodes=$nodes:$queue -q ${queue} -V job_testlast.sh
  #solo:  qstc -n $nodes -m -q power4 job_testlast.sh 1h
  #teras: bsub <job_testlast.sh
fi

