#
# VERSION : $Revision$
# DATE    : $Date$
# FILE    : Makefile.in
# SOURCE  : $Source$
#

include ../Makefile.config

F77_OBJS = paminp.o pamprp.o pamexp.o pamgrd.o pamogrd.o pamfck.o pamset.o \
	   pamxlr.o pamrvc.o pamrsp.o rspmpg.o mp2lag.o pamxqr.o pamtpa.o \
           pammag.o excprp.o pamstex.o

F90_OBJS =

F90_MODS =

F77_CPPS = $(F77_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > prp.ftnchek

calltree:pre
	ftnchek $(CHEKFLAGS) -calltree=tree -nocheck -mkhtml *.i > prp.calltree

all:	$(F77_OBJS) $(F90_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i

mod:
	$(MAKE) f90dep  # create list of which file to compile to get the .mod files
	$(MAKE) module_files

module_files: $(F90_MODS)

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90)

f90dep: ;\
       ../utils/sfmakedepend.pl -I $(SOURCEDIR)/include -M $(SOURCEDIR)/modules $(F90_OBJS:.o=.F90) $(F90_OBJS:.o=.F) $(F77_OBJS:.o=.F)


# DO NOT DELETE THIS LINE -- make depend depends on it.

