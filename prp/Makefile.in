include ../Makefile.config

F77_OBJS = paminp.o \
           pamprp.o \
           pamexp.o \
           pamgrd.o \
           pamogrd.o \
           pamfck.o \
           pamset.o \
           pamxlr.o \
           pamrvc.o \
           pamrsp.o \
           rspmpg.o \
           mp2lag.o \
           pamxqr.o \
           pamtpa.o \
           pammag.o \
           excprp.o \
           pamstex.o

F90_OBJS =

F90_MODS =

C_OBJS =

F77_CPPS = $(F77_OBJS:.o=.i)

pre:       $(F77_CPPS)

ftnchek:   pre
	   ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:       $(F90_MODS) $(F90_OBJS) $(F77_OBJS) $(C_OBJS)

clean:
	   $(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod  ;\
	   $(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

mod:       $(F90_MODS)

dirac.x:
	   cd .. ; $(MAKE) dirac.x

dirmpi.x:
	   cd .. ; $(MAKE) dirmpi.x

include ../Makefile.depend

