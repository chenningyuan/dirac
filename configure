if [ $shmem_par = 1 ]; then
  $echo "\nIncluding the shared-memory parallelization routines in KR-MCSCF/KR-CI, .... \c"
  cpp_f90="-DVAR_SHMEM $cpp_f90"
fi
echo
}

set_memsize ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# Determine memory size
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo 'MEMORY SIZE'
echo
if [ -z "$memdef" ]; then
   #  ... extract from Makefile.config
   memdef=`./config.status WRKMEM`

   if [ $IPRINT -ge "8" ]; then
    echo 'set_memsize: from Makefile.config extracted memdef='$memdef
   fi

   if [ -z "$memdef" ]; then
      memdef=64000000
   fi

   if [ $IPRINT -ge "8" ]; then
    echo 'set_memsize:  assigned memdef='$memdef
   fi

   echo 'How many MB RAM should Dirac use as default?'
   echo ' -this is the maximum memory available to older parts of the program'
   echo ' -we do not recommend going below 64 MB'
   echo ' -note that memory use can be changed' \
        'through the shell variable DIRWRK'

   if [ $quick = 0 ]; then
      let "tmp=$memdef * 8/1048576"
      $echo "Memory size (in MB, default: $tmp MB) \c"
      read memsiz
   else
      memsiz=
   fi
   if [ -z "$memsiz" ]; then
      memsiz=$memdef
   else
      let "memsiz=$memsiz * 1048576 / 8"
   fi
else
   memsiz=$memdef
fi
}

set_installdir ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   set installdir
#   Determine location for executable and run script
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo 'INSTALLATION DIRECTORY for binaries and scripts (dirac.x and pam + any of the optional)'
echo

if [ $IPRINT -ge "7" ];  then
   echo 'set_installdir: variable INSTALL_DIR='$INSTALL_DIR
   echo 'set_installdir: variable quick='$quick
fi

if [ -z "$INSTALL_DIR" ]; then
     set_install_directory
else
   # verify entered (as parameter) installation directory
   if [ ! -d "$INSTALL_DIR" ]; then
     $echo "ERROR: $INSTALL_DIR (you typed as the parameter) does not exist \n "
     # no exit, rather repeat searching for the directory
     set_install_directory
   fi
fi

if [ $IPRINT -ge "2" ];  then
#-------------------------------------------------------------------
#     ... finally print-out the verified installation directory
#-------------------------------------------------------------------
$echo 'Installation directory for DIRAC executable "dirac.x" and "pam" script: '
$echo "$INSTALL_DIR\n"
fi

}

set_install_directory () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#  Determines the installation directory for pam, pam.py, pamq.py, dirac.x
#
#  Always called when INSTALL_DIR (might come in as the parameter)
#  is not a valid directory
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

   INSTALL_DIR=

   # ... find the INSTALLDIR variable in the old Makefile.config file (if there is any)
   curr=`./config.status INSTALLDIR`
   # ... if $curr not empty AND is valid directory
   if [ ! -z "$curr" -a -d "$curr" ]; then

      $echo 'Found (in Makefile.config) a directory for installation of' \
         'binaries and scripts:'
      $echo $curr
      if ask_yesno y "Do you want me to use it again ?"; then
	 INSTALL_DIR=$curr
         # verify installation directory
         if [ ! -d "$INSTALL_DIR" ]; then
            echo "ERROR: $INSTALL_DIR does not exist. Please specify a valid directory for installation."
            INSTALL_DIR=
         fi
         # hjaaj: we could also test if the INSTALL_DIR is writable ... (e.g. with touch)
      fi
   fi

   curr=`pwd`
   if ask_yesno y "Do you want to use current directory $curr?"; then
      INSTALL_DIR=$curr
   else
      $echo "OK. \c"
   fi

   # repeat until a directory is found - test on empty
   while [ -z "$INSTALL_DIR" ]; do

      $echo "Now type your choice for the installation directory (full path, not relative path): \c"
      read INSTALL_DIR

      # verify installation directory
      if [ ! -d "$INSTALL_DIR" ]; then
         echo "ERROR: $INSTALL_DIR does not exist. Please specify a valid directory for installation."
         INSTALL_DIR=
         # ... continue within the "while" cycle
      fi

   done

   $echo '... directory to be used for DIRAC installation:'
   $echo $INSTALL_DIR
   echo
}

get_cpp_flags(){

  if [ "$mesp" = "mpi" ]; then
    parop="-DVAR_MPI"

    append cpp_f90 "-DPRG_DIRAC -DSYS_$sys_name -DINSTALL_WRKMEM=\${WRKMEM} $parop"
    append cpp_cc "-DSYS_$sys_name -DINSTALL_WRKMEM=\${WRKMEM} $parop"
    def="dirmpi.x"
  else
    append cpp_f90 "-DPRG_DIRAC -DSYS_$sys_name -DINSTALL_WRKMEM=\${WRKMEM}"
    append cpp_cc "-DSYS_$sys_name -DINSTALL_WRKMEM=\${WRKMEM}"
    def="dirac.x"
  fi
  if [ ! -z "`echo $LIB | grep 'mkl'`" ]; then
    append cpp_f90 "-DVAR_MKL"
  fi
 
  set_bit_arch
}

set_bit_arch(){
# Special flags for 64 bit machines
  if [ "$bit_set" = "64" ]; then
    cpp_f90="-DINT_STAR8 $cpp_f90"
    cpp_cc="-DINT_STAR8 $cpp_cc"
# provide specific compiler with the appropriate integer flag
    case "$F90real" in
#
      g95|pgf95|pgf90|ifc|ifort|pathf90)
         opt="$opt -i8"
         safe="$safe -i8" 
         mcmodel_medium="-mcmodel=medium -shared-intel" # mi: check if it is for all these compilers !
      ;;
#
#   ... take care of gfortran, gfortran-4.2, gfortran-4.3 etc...
      gfortran-*|gfortran)
         opt="$opt -fdefault-integer-8"
         safe="$safe -fdefault-integer-8"
         mcmodel_medium="-mcmodel=medium"
      ;;
#
#   .... take care of Lahey fortran
      lfc)
         opt="$opt --long"
         safe="$safe --long"
	 # ... to add..
         mcmodel_medium=" " 
         ;;
    esac
    case "$F90real" in
      pgf95|pgf90)
         opt="$opt -m64"
         safe="$safe -m64" 
         ;;
    esac
  else  
    if [ "$IsLP64" != "1" ]; then # we are on truly 32-bit architectures 
      cpp_f90="-DARCH32BIT $cpp_f90"
      cpp_cc="-DARCH32BIT $cpp_cc"
    fi
    case "$F90real" in
      pgf95|pgf90)
         opt="$opt -m32"
         safe="$safe -m32"
        ;;
    esac
  fi

if [ $IPRINT -ge "5" ];  then
 echo 'set_bit_arch: set opt='$opt
 echo 'set_bit_arch: set safe='$safe
fi

}

get_f90_flags(){
#
# according to $F90real assign flags
#
  check_array_bounds=""
  case "$F90real" in
    g95)
      cpp_f90="$cpp_f90 -DVAR_G95"
      #opt="-g -O3 -ffast-math -Wno=155 -fsloppy-char"
      opt="-g -O3 -ffast-math -fsloppy-char"
      f90_extraflags="-cpp"
      safe="-g -fsloppy-char -ftrace=full"
      opt_1="-O1"
      opt_2="-O2 -ffast-math"
      opt_3="-O3 -ffast-math"
      mod="-fmod=$MODULE_DIR"
      noformain="" # please add it
      F_check_flags="-Wall -fbounds-check " # please add more
      F_profile="-pg" # 
      ldflag="" # mi: "-lstdc++" must be omitted
      ;;
    gfortran*)
     # to determine version you need the compiler with its full path 
      gfver=`$F90_COMP -v 2>&1 | awk '/^gcc version/{gsub("[^0-9]","", $3);print $3}'`
      cpp_f90="$cpp_f90 -DVAR_GFORTRAN -DGFORTRAN=$gfver"
      case $prc in
      i[0-9]86) grep -qw sse2 /proc/cpuinfo 2> /dev/null && prc=pentium4
                march="-march=$prc -malign-double";;
      x86_64) march="-march=x86-64";;
      *) march="";;
      esac
      # mi: -fno-range-check is for DATA i/Z'FFFFFFFF'/ style of variables (in higher sector FSCC stuff)
      c_opt="-g -O3 -ffast-math -funroll-loops -std=c99 -DRESTRICT=restrict -DFUNDERSCORE=1 $march"
      opt="-g -fno-range-check -O3 -ffast-math -funroll-loops -fbacktrace $march"
#     gfortran needs flag -fcray-pointer if MPI-2 is enabled.
      if [ "$mpi2version" = "yes" ]; then
        $opt="$opt -fcray-pointer"
      fi
      f90_extraflags="-x f95-cpp-input"
      safe="-g -fbacktrace -fno-range-check $march"
      opt_1="-O1"
      opt_2="-O2 -ffast-math -funroll-loops"
      opt_3="-O3 -ffast-math -funroll-loops"
      mod="-J$MODULE_DIR"
      noformain="" # does not exist ?
      F_check_flags="-fbounds-check" 
      F_profile="-pg"
      ldflag="-lstdc++"
      ;;
    pgf95|pgf90)
      opt="-g -Mpreprocess"
      safe="-g -Mframe"
      opt_1="-O1"
      opt_2="-fast"
      opt_3="-fast -Munroll"
      cpp_f90="$cpp_f90"
      cpp_cc="$cpp_cc"
      mod="-module $MODULE_DIR"
      noformain="-Mnomain"
      F_check_flags="-Mbounds" # please add more 
      F_profile="-pg"
      ;;
    lfc)
      opt="-g --fast"
      safe="-g"
      opt_1="-O1"
      opt_2="--fast"
      opt_3="--fast"
      cpp_f90="$cpp_f90 -DVAR_LFC"
      cpp_cc="$cpp_cc"
      mod="-M $MODULE_DIR"
      noformain="" # please add
      F_check_flags="" # please add more
      F_profile="" # please add
      ;;
    ifort)
      opt="-g -fpp1 -O3 -ip -w -assume byterecl -vec-report0"
      safe="-g -fpp1 -w -assume byterecl -traceback"
      opt_1="-O1 -ip"
      opt_2="-O2 -ip"
      opt_3="-O3 -ip "
      cpp_f90="$cpp_f90 -DVAR_IFC"
      cpp_cc="$cpp_cc -DVAR_IFC"
      mod="-module $MODULE_DIR"
      if [ "$par" = "yes" ]; then
       ldflag="-i_dynamic" # activate it only for ifort-parallel 
      fi
      ldflag="$ldflag -cxxlib -lstdc++"
      noformain="-nofor_main"
      F_check_flags="-check bounds -fpstkchk -check pointers -check uninit -check output_conversion " 
      F_profile="-p" 
      # work-around for incompatibility ifort and Xcode 3.2.2
      if [[ "$machine" == *apple* ]]; then
       safe="$safe -use-asm"
      fi
      ;;
    xlf|xlf_r)
      cpp_f90="$cpp_f90 -DVAR_XLF"
      opt="-qsuppress=cmpmsg"
      safe="-qsuppress=cmpmsg"
      opt_1=" "
      opt_2=" "
      opt_3=" "
      mod="-qmoddir=$MODULE_DIR -I$MODULE_DIR"
     # .... extra flags for *.F90 files !
      f90_extraflags="-qfree=f90 -qsuffix=cpp=F90"
      noformain="" # please add
      F_check_flags="" # please add more...
      F_profile="" # please add
      ;;
    pathf90)
      ldflag="-g -O2 -m64 -march=athlon64 -mcpu=athlon64 -msse -msse2 -mtune=athlon64 -mcmodel=medium"
      cpp_f90="$cpp_f90 -DVAR_PATHF90"
      cpp_cc="$cpp_cc -DVAR_EKO"
      mod="-module $MODULE_DIR"
      noformain="" # please add
      F_check_flags="" # please add 
      F_profile="" # please add
       ;;
    *)
       $echo "\nget_f90_flags: Flags undetermined for the Fortran compiler $F90real !"
       $echo "Error exit 1!\n"
       exit 1
       ;;
  esac

  if [ $IPRINT -ge "5" ];  then
    echo '***  get_f90_flags ***'
    echo ' F90real  ='$F90real
    echo '     opt  ='$opt
    echo '     opt_1='$opt_1
    echo '     opt_2='$opt_2
    echo '     opt_3='$opt_3
    echo '     safe ='$safe
    echo '     mod  ='$mod
  fi
}

get_cc_flags(){
#
# determine 'safe' and optimization flags for the C-compiler 
# according to $CCreal
#
  case "$CCreal" in
  gcc|cc)
    c_opt="-g -O3 -ffast-math"
    c_safe="-g"
    c_opt_1="-O1"
    c_opt_2="-O2 -ffast-math"
    c_opt_3="-O3 -ffast-math"
    C_check_flags="-fbounds-check -Wall" # please check/add more  ?
    C_profile="-pg" 
    ;;
  mpicc)
    c_opt="-g -O3 -ffast-math"
    c_safe="-g"
    c_opt_1="-O1"
    c_opt_2="-O2 -ffast-math"
    c_opt_3="-O3 -ffast-math"
    C_check_flags="" # please add
    C_profile="" # please add
    echo
    echo WARNING:
    echo   Could not determine which compiler mpicc is using, assuming it is gcc
    echo
    ;;
  pgcc)
    c_opt="-g -fastsse"
    c_safe="-g"
    c_opt_1="-O1"
    c_opt_2="-fast"
    c_opt_3="-fastsse"
    C_check_flags="-Mbounds -Mchkstk" # please check/add more
    C_profile="-pg" 
    ;;
  icc)
    c_opt="-g -O3 -ip -w"
    c_safe="-g -w"
    c_opt_1="-O1 -ip"
    c_opt_2="-O2 -ip"
    c_opt_3="-O3 -ip"
    C_check_flags="-Wcheck -fpstkchk -fstack-security-check" # 
    C_profile="-pg" 
    ;;
  pathcc)
    c_opt=$opt
    c_safe=$safe
    c_opt_1=""
    c_opt_2=""
    c_opt_3=""
    C_check_flags="" # please add
    C_profile="" # please add
    ;;
  esac

# jhs some strange fortran dependent options:
  case "$F90real" in
  xlf)
    c_opt='-g -O2 -qcpluscmt'
    c_safe='-g -qcpluscmt'
    c_opt_1="-O1"
    c_opt_2="-O1"
    c_opt_3="-O2"
    C_profile="" # please add
    ;;
  esac

  if [ $IPRINT -ge "5" ];  then
   echo 'get_cc_flags: used CCreal='$CCreal
   echo 'get_cc_flags: got c_opt  ='$c_opt
   echo 'get_cc_flags: got c_opt_1='$c_opt_1
   echo 'get_cc_flags: got c_opt_2='$c_opt_2
   echo 'get_cc_flags: got c_opt_3='$c_opt_3
   echo 'get_cc_flags: got c_safe ='$c_safe
  fi

}

get_largefiles(){
    case $machine in
	i?86-* | x86_64-* | ia64-unknown-linux)
	    if [[ -z "$NO_LARGEFILE" ]]; then
		cpp_cc="-D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE  -D_LARGEFILE64_SOURCE $cpp_cc"
	    fi
    esac
}

checkmods()
{
    if [ ! -r cbuild/Makefile.moddef ]; then
	echo "Error, cannot find the file: cbuild/Makefile.moddef" >&2
	echo 'You must run "pamadm" before "configure" to correct this problem. Quitting.' >&2
	kill $$ # Suicide is painless, it brings on many changes
    fi
}

set_compile_flags(){
#
# Find and assign proper compiler flags
#

  if [ $IPRINT -ge "7" ];  then 
    $echo "\n in set_compile_flags \n"
  fi

f90_inc="-I$INCLUDE_DIR"
cc_inc="-I$INCLUDE_DIR"

find_real_f90
get_f90_flags
cpp_cc="\$(MODS)"

#if [ "$localdisks" = "no" ]; then
#  cpp_f90="$cpp_f90 -DVAR_PFS"
#fi

case $machine in
#
#  HEWLETT - PACKARD
#
    *-hp)
       sys_name="HPUX"
       get_cpp_flags
       arflag='rv'
       c_opt='-g +DA2.0W +O3 +Onolimit +Ofastaccess -AC99'
       c_safe='+DA2.0W -g -AC99'
       c_opt_1="+O1 +Onolimit "
       c_opt_2="+O2 +Onolimit +Ofastaccess"
       c_opt_3="+O3 +Onolimit +Ofastaccess"
       opt='-g +DA2.0W +O2 +U77 +Onolimit +Ofastaccess +ppu'
       safe='+DA2.0W  +U77 -g'
       opt_1="+O1"
       opt_2="+O1 +Onolimit"
       opt_3="+O2 +Onolimit +Ofastaccess +ppu"
       LIB="-llapack +U77 +DA2.0W -lm $LIB"
       if [ ! -z "`echo $LIB | grep 'veclib'`" ]; then
          cpp_f90="$cpp_f90 -DVAR_LIBVECLIB"
       fi
       ;;
#
#   ALPHA
#
    alpha-dec|mips-dec|vax-dec|alphaev6-dec)
       sys_name="DEC"
       get_cpp_flags

       if [ ! -z "`echo $LIB | grep 'dxml'`" ]; then
          cpp_f90="$cpp_f90 -DVAR_DXML"
       fi
       opt='-g -fast'
       safe='-g'
       opt_1=" "
       opt_2="-fast"
       opt_3="-fast"
       ;;
#
#   CRAY
#
    *-cray)
       sys_name="CRAY"
       get_cpp_flags

       opt="-g -Wf\"-i 64 -a stack -dp\" -Wp\"-F\""
       safe="-Wf\"-i 64 -a stack -Wp\"-F\"-g\""
       opt_1=""
       opt_2=""
       opt_3="-dp\""
       c_opt="-g -i 64 -a stack -dp"
       c_safe="-i 64 -a stack -g"
       c_opt_1=""
       c_opt_2=""
       c_opt_3=""
       LIB="C90lib.cld $LIB"
       ;;
#
#  SUN
#
   sparc-sun|m68k-sun)
      sys_name="SUN"
      get_cpp_flags
      cpp_f90="$cpp_f90 -DVAR_MFDS"
      opt='-g -fast # updated 28.Aug.04'
      safe='-g'
      opt_1=""
      opt_2="-fast"
      opt_3="-fast"
      c_opt='-g -fast # updated 28.Aug.04'
      c_safe='-g'
      c_opt_1=""
      c_opt_1=""
      c_opt_1="-fast"
      ;;
#
#   IBM
#
   *-ibm | powerpc64-unknown-linux* | ppc64* )
      case $os in
        aix2*)
          sys_name="AIX"
	  get_cpp_flags
	  cpp_f90="-w -P -DSYS_AIX23 $cpp_f90"
	  cpp_cc="-DSYS_AIX23 $cpp_cc" ;;
	gnu*)
          sys_name="LINUX"
	  get_cpp_flags
	  cpp_f90="-DVAR_MFDS $cpp_f90"
          ;;
         *)
          sys_name="AIX"
	  get_cpp_flags
	  cpp_f90="-DVAR_MFDS $cpp_f90"
         esac

         if [ "$localdisks" = "no" ]; then
            cpp_f90="$cpp_f90 -DVAR_PFS"
         fi
      case $os in
         gnu* )
            opt='-g -O3 -qstrict -qextname -q64'
            safe='-g -qextname -q64'
            opt_1="-O1"
            opt_2="-O2 -qstrict"
            opt_3="-O3 -qstrict"
   	    c_opt='-g -O3 -qstrict -q64'
   	    c_safe='-g -q64'
          c_opt_1="-O1 "
          c_opt_2="-O2 -qstrict "
          c_opt_3="-O3 -qstrict "
            ldflag='-q64 '
            arflag='rv'
            ;;
         *)
            opt='-g -O3 -qstrict -qextname -qzerosize -q64'
            safe='-g -qextname -qzerosize -q64'
            opt_1="-O1"
            opt_2="-O2 -qstrict"
            opt_3="-O3 -qstrict"
   	    c_opt='-g -O3 -qstrict -qcpluscmt -q64'
   	    c_safe='-g -qcpluscmt -q64'
          c_opt_1="-O1"
          c_opt_2="-O2 -qstrict"
          c_opt_3="-O3 -qstrict"
            ldflag='-q64 -bmaxdata:0x8000000000'
            arflag='-X64 rv'
            ;;
         esac

         if [ "$mod" = "" ]; then
	    mod="-qmoddir=$MODULE_DIR"
         fi
         f90_extraflags="-qfree=f90"
         ;;
#
#  IRIX
#
   mips*-sgi)
      sys_name="IRIX"
      get_cpp_flags
      opt='-g -O2 -G 0 -woff 2290'
      safe='-g -G 0 -woff 2290'
      opt_1="-O1"
      opt_2="-O2"
      opt_3="-O2"
      c_opt='-g -O2 -G 0'
      c_safe='-g -G 0'
      c_opt_1="-O1"
      c_opt_2="-O2"
      c_opt_3="-O2"
      ;;
#
#   Linux on 32 bit machines
#
   i[3-6]86-*)
      sys_name="LINUX"
      get_cpp_flags
      cpp_f90="$cpp_f90 -DVAR_MFDS"
#
# In case we are using mpif*/mpicc check which compiler it uses to make
# sure we use the correct flags
#
      case "$F90real" in
        g95)
         opt="$opt -fno-second-underscore"
         safe="$safe -fno-second-underscore" ;;
      esac

      find_real_cc

      get_cc_flags
      ;;
#
#   Linux on 64 bit machines
#
   x86_64-*)
      sys_name="LINUX"
      get_cpp_flags
      cpp_f90="$cpp_f90 -DVAR_MFDS"
#
# In case we are using mpif*/mpicc check which compiler it uses to make
# sure we use the correct flags
#
      case "$F90real" in
        g95)
         opt="$opt -fno-second-underscore"
         safe="$safe -fno-second-underscore" ;;
      esac

      find_real_cc

      get_cc_flags
      ;;
#
#   Linux on 64 bit Itanium
#
   ia64-unknown-linux)
      sys_name="LINUX"

      get_cpp_flags
      cpp_f90="$cpp_f90 -DVAR_MFDS"

#
# If we are using mpif77/mpif90/mpicc check which compiler it uses to make
# sure we use the correct flags
#

      case "$F90real" in
      pathf90)
         ldflag="$ldflag -i8" ;;
      esac

      find_real_cc
      get_cc_flags

   ;;

#
#   Darwin
#
   *apple*)
      sys_name="DARWIN"
      get_cpp_flags
      cpp_f90="-DVAR_MFDS $cpp_f90"

      F90real="$F90_COMP_NAME"
      get_f90_flags
      get_cc_flags

esac

} # END set_compile_flags()

xlfify()
{
    if [ "$IBMMOD" = 1 ]; then
	echo "$@" | sed 's/-D/-WF,-D/g'
    else
	echo "$@"
    fi
}

cpp_is_gcc()
{
     (echo xxx | cpp --version 2>&1 )| grep 'Free Software Foundation' > /dev/null
}

make_Makefile.config ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# We are beginning to see the end of the installation requirements
# We will now dump machine specific things to Makefile.config
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
if [ -f Makefile.config ]; then
   echo 'Makefile.config exists. I will take a backup.'
   backup -v Makefile.config
fi

# ... special care of include, modules directories - dealt in Makefile.config 
# either relative path (when in main dirac directory), or absolute (when in local directories)
INCLUDE_DIR=include
MODULE_DIR=modules

# miro: what's that ?
arflag= 

# Parallel preprocessor directive need to be set
set_compile_flags
mpi2check
get_largefiles

# given that all unix clones like linux, *bsd and mac osx have no
# specific preprocessor directives, what comes below allows one
# to fine-tune functionality. for instance, in the code under gp/
# to get traceback and memory information one needs to differentiate
# the os. also, if the gnu loader is used, the -E flag has to be
# passed on to allow the symbols to be generated

case $flavor in
   *linux*)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=LINUX"
      ldflag="$ldflag -Wl,-E"
   ;;
   *darwin*)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=DARWIN"
   ;;
   *freebsd*)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=FREEBSD"
      ldflag="$ldflag -Wl,-E"
   ;;
   *netbsd*|*openbsd)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=OPENBSD"
      ldflag="$ldflag -Wl,-E"
   ;;
   *)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=UNKNOWN"
   ;;
esac


###############################################################################
#
#  Make Makefile.config
#
#  To avoid problems with make depend, substitute all , with spaces
#
##############################################################################
if [ "$mesp" != "dummy" ]; then
   depend_flags=`echo $cpp_f90 $f90_inc | sed -e 's/,/\ /g'`
else
   depend_flags=`echo $cpp_f90 $f90_inc $parinc | sed -e 's/,/\ /g'`
fi
#
#  Check for special C-directives
#
if [ "$c_opt" = "" ]; then
   c_opt="\$(OPTFLAGS)"
   c_safe="\$(SAFEFLAGS)"
fi
if [ "$ldflag" = "" ]; then
   ldflag="\$(OPTFLAGS)"
# mi: linking can be with optimization
fi
#
# Add the modifications that concern the module preprocessor statements
#
case $F90_COMP_NAME in
   xlf*|mpfort|mpxlf_r)
# IBM's xlf should be comma delimited, the others take spaces
     IBMMOD=1
     cpp_f90="utils/replace_args_and_execute.sh s/^-D/-WF,D/g $cpp_f90 \$(MODS)"
     ;;
   *)
     cpp_f90="$cpp_f90 \$(MODS)"
esac

##################################################
#  Make Makefile.config
#################################################

#first define the preprocessing flags for the active modules

cat <<EOF > Makefile.config
# installation directory
INSTALL_DIR=$INSTALL_DIR
SRC_DIR=$SRC_DIR
# preprocessor flags for active modules, svn snapshot variable
include \$(SRC_DIR)/cbuild/Makefile.moddef
# default memory (in 8 byte words)
WRKMEM=$memsiz
# 
# For passing files to local disks; if empty, no copying to local disks of nodes
#
RCP=$rcp
RSH=$rsh
LOCALDISKS=$localdisks
# default machine file - either for mpirun or for copying files onto local disks or for both
MACH_FILE=$mach_file
EOF

if [ "$mesp" = "mpi" ]; then
   if [ -n "$parinc" ]; then
      f90_inc="$f90_inc $parinc"
   fi
fi

CPP=cpp
# Find out how to preprocess fortran
if cpp_is_gcc; then
    FPP="cpp -traditional"
else
    FPP="cpp"
fi

# determine whether we add Fortran flag for checking array boundaries or not
if [ $checkbounds = 1 ]; then
#  ... Fortran flag ...
  safe="$F_check_flags $safe"
  opt="$F_check_flags $opt"
  if [ -n "$F_check_flags" ]; then
   $echo "\nFortran flag '"$F_check_flags"' for checking array bounds & other run-time parameters included."
   $echo "WARNING: DIRAC is not yet debugged for this programming feature!"
  else
   $echo "\nNo Fortran flag for checking array bounds included for compiler $F9Oreal."
   $echo "Though requested. Please edit the 'configure' script."
  fi
#   ... C flag ...
  c_safe="$C_check_flags $c_safe"
  c_opt="$C_check_flags $c_opt"
  if [ -n "$C_check_flags" ]; then
   $echo "\nC flag '"$C_check_flags"' for checking array bounds & other run-time parameters included."
   $echo "WARNING: DIRAC is not yet debugged for this programming feature!"
  else
   $echo "\nNo C flag for checking array bounds is included for compiler $CCreal."
   $echo "Though requested. Please edit the 'configure' script."
  fi
fi

# determine whether we add profiling flag to compilers/linker
if [ $doprofile = 1 ]; then 

  safe="$F_profile $safe"
  opt="$F_profile $opt"
  ldflag="$F_profile $ldflag"

  if [ -n "$F_profile" ]; then
   $echo "\nFortran flag '"$F_profile"' for profiling/linking included."
  else
   $echo "\nNo flag for profiling/linking for Fortran compiler $F90real."
   $echo "Though requested. Please edit the script.\n"
  fi

  c_safe="$C_profile $c_safe"
  c_opt="$C_profile $c_opt"
  if [ -n "$C_profile" ]; then
   $echo "\nC flag '"$C_profile"' for profiling included."
  else
   $echo "\nNo C flag for profiling is included for compiler $CCreal."
   $echo "Though requested. Please edit the script.\n"
  fi
fi

# determine what flags to be flushed into Makefile.config:  SAFE or OPTIMIZED flags

if [ $nooptim = 1 ]; then # ... employ flags with no optimization
  F77FLAGS_USE="\${F77FLAGS_SAFE}"
  F90FLAGS_USE="\${F90FLAGS_SAFE}"
  CFLAGS_USE="\${CFLAGS_SAFE}"
else # ... employ flags with the optimization
  F77FLAGS_USE="\${F77FLAGS_OPT_3} \${F77FLAGS_SAFE} "
  F90FLAGS_USE="\${F77FLAGS_OPT_3} \${F90FLAGS_SAFE}"
  CFLAGS_USE="\${CFLAGS_OPT_3} \${CFLAGS_SAFE}"
fi

cat <<EOF >> Makefile.config

# Fortran and C compilers
F77=$F90_COMP
F90=$F90_COMP
CC =$CC_COMP
EOF

if [ "$par" = "yes" ]; then
cat <<EOF >> Makefile.config
#
# mpi launcher, the same as in "pam" (there it is to be checked !)
# has to be the same kind (same directory) as mpif90/mpif77/mpicc compilers
#
MPIRUN=$mpirun
EOF
fi

cat <<EOF >> Makefile.config

# Flag mainly for separate no-Fortran-main function executables build of DIRAC generated objects
NO_FORTRAN_MAIN=$noformain

# Fortran flag for the medium memory model (needed for some x86_64)
MCMODEL_MEDIUM=$mcmodel_medium

# Libraries - check them according to your server equipment !
# You may need blas and lapack (if not using the builtin) and
# mpi (if parallel). For mpi you also need the correct -I flag
# in F77FLAGS, CFLAGS and F90FLAGS (and their safe versions).
LIBS      = $LIB

# specify which DIRAC internal libraries are included
USED_DIRAC_BLAS   = $is_dirac_blas
USED_DIRAC_LAPACK = $is_dirac_lapack

# preprocessing of Fortran source files
FPP_FLAGS=$cpp_f90 $depend_flags $parinc
DEPFPP=$FPP \${FPP_FLAGS}
# preprocessing of C source files
CPP_FLAGS=$cpp_cc $parinc $depend_flags
DEPCPP=$CPP \${CPP_FLAGS}

# Fortran/C flags for array bounds & other possible run-time checks
FFLAGS_CHECK=$F_check_flags
CFLAGS_CHECK=$C_check_flags

# Fortran/C flags for code profiling
FFLAG_PROFILE=$F_profile
CFLAG_PROFILE=$C_profile

# linker
LD=\$(F90)
LDFLAGS=$ldflag

EOF

##########################################################################
#
#  dump compiler flags into Makefile.config, where you can edit them
#
##########################################################################

#F77FLAGS_OPT=`xlfify $opt $f90_inc $mod $cpp_f90`
#F90FLAGS_OPT=`xlfify $opt $f90_inc $mod $f90_extraflags $cpp_f90`
#CFLAGS_OPT=$c_opt $cc_inc $cpp_cc

cat <<EOF >> Makefile.config

# compiler flags, safe (without optimization flags)
F77FLAGS_SAFE=`xlfify $safe $f90_inc $mod $cpp_f90`
F90FLAGS_SAFE=`xlfify $safe $f90_inc $mod $f90_extraflags $cpp_f90`
CFLAGS_SAFE=$c_safe $cc_inc $cpp_cc

# sole Fortran/C compilers optimization flags
F77FLAGS_OPT_1=$opt_1
F77FLAGS_OPT_2=$opt_2
F77FLAGS_OPT_3=$opt_3
CFLAGS_OPT_1=$c_opt_1
CFLAGS_OPT_2=$c_opt_2
CFLAGS_OPT_3=$c_opt_3

# safe flags mode ?
SAFE_FLAGS_MODE=$safe_flags_mode

# employed compiler flags (safe or standard, see above)
F77FLAGS=$F77FLAGS_USE
F90FLAGS=$F90FLAGS_USE
CFLAGS=$CFLAGS_USE

# ILP data type mode (to be passed to dirac.x)
ILP_DATATYPE=$ilp_datatype

EOF

#
# Insert necessary additional features for parallel calculations
#
if [ "$mesp" = "mpi" ]; then
      write_mpi_ini=""
   if [ "$parlib_pwd" != "" ]; then
      write_mpi_ini="yes"
   fi
   if [ "$parinc" != "" ]; then
      write_mpi_ini="yes"
   fi
   if [ "$write_mpi_ini" = "yes" ]; then
      cat <<EOF >> Makefile.config
#
# Parallel initialization
#
EOF
   fi
   if [ ! -z "$parlib_pwd" ]; then
      parlib_pwd=-L$parlib_pwd
   fi
   if [ "$parinc" != "" ]; then
      cat <<EOF >> Makefile.config
MPI_INCLUDE_DIR=$parinc
EOF
   fi 
   if [ "$parlib_pwd" != "" ]; then
      cat <<EOF >> Makefile.config
MPI_LIB_PATH=$parlib_pwd
EOF
   fi 
   if [ "$parlib" != "" ]; then
      cat <<EOF >> Makefile.config
MPI_LIB=$parlib
EOF
   fi 
fi
} # END make_Makefile.config ()





final_words () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Final instructions to user
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo "============== configure completed - final words: ==============="
echo
echo "Please check http://dirac.chem.vu.nl"
echo "to see hints or/and problems concerning your platform."

if [ "$par" = "yes" ]; then
  echo
  echo "pam script has been configured for your MPI version."
  echo "If you change the MPI library, please reconfigure the pam script."
  if [ "$bit_set" = "64" ]; then
    echo "If you use 64 bit integers make sure that MPI libraries and"
    echo "your math libraries are of the ILP64 type!"
  fi
else
  if [ "$bit_set" = "64" ]; then
    echo
    echo "Dirac is configured to use 64 bit integers. Make sure that"
    echo "your math libraries are of the ILP64 type!"
  fi
fi

echo
echo "Before you run make, you may check and edit Makefile.config."
echo
echo "Then run"
echo "$ make"
echo
echo '( or e.g. "make -j 8" if you have 8 CPU cores available and want to finish quicker )'
echo
}

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# THIS FINISHED THE DEFINITIONS OF FUNCTIONS
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# MAIN SCRIPT
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
initialize
opt=
echo
echo '   Generating files Makefile.config and pam'
echo
echo '   To see all available options run'
echo '   $ ./configure --help'

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#                        Parse arguments
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo ''
while [ $# != 0 ]; do
   arg="$1"; shift
   echo "Argument: $arg"
   case "${arg}" in
      -*=*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\([^=]*\)=.*$:\1:'`
         val=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*[^=]*=\(.*\)$:\1:'`
         valomitted=no
         ;;
      -*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\(.*\)$:\1:'`
         val="yes"
         valomitted=yes
         ;;
      *)
         usage
         exit
   esac
   optname="${opt}"
   opt="`echo '' ${opt} | sed -e 's:^ ::' | tr - _`"
   case "${opt}" in
      "help")
        usage
         exit
         ;;
      "quick")
         quick=1
         ;;
      "system")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         guess="$val"
         ;;
      "parallel" | "par")
         case "$val" in
         "no" | "yes" )
            par="$val"
            ;;
         *)
            echo 'Syntax error: Value "'${val}'" is not allowed to option' \
                 '"-'${optname}'"'
            echo 'Legal values: [yes,no]'
            exit 1
            ;;
         esac
         ;;
      "noopt")
	 nooptim=1
         ;;
      "check")
	 checkbounds=1
         ;;
      "profile")
	 doprofile=1
         ;;
      "nolibtest")
	 testlibs=0
         ;;
      "libdir" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
	 # extend the list of directories
         dir_list="$val $dir_list"
         ;;
      "mathematical_libraries" | "math_lib" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         userlib="$val"
         ;;
      "dir_blas")
	 dirac_blas=1
         ;;
      "dir_lapack")
	 dirac_lapack=1
         ;;
      "all_math_lib" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         LIB="$val"
         ;;
      "memory_size" | "memory" | "mem" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         memdef="$val"
         ;;
      "install_dir" | "inst_dir" | "install" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         INSTALL_DIR="$val"
         ;;
      "queuing_system" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         queuesys="$val"
         ;;
      "cc" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         CC_COMP_NAME="$val"
         ;;
      "f90" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         F90_COMP_NAME="$val"
         ;;
      "mpirun" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         MPIRUN_NAME="$val"
         ;;
      "i"  )
         IPRINT=$val
         ;;
      "sharedmem_par"  )
         shmem_par=1
         ;;
      *)
         echo  'Unknown option: '$opt''
         usage
         exit 1
         ;;
   esac
done

if [ $IPRINT -gt "0" ];  then
  echo 'configure print level set to '$IPRINT
fi

checkmods # Make sure that pamadm was run before configure
guess_system
parallel_stuff
safeflags_stuff
find_compilers
if [ "$mesp" = "mpi" ]; then
  find_mpi_path
fi
find_mathlib
deal_testlib
deal_sharedmemory
set_memsize
set_installdir
make_Makefile.config
final_words

