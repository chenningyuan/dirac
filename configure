initialize ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Initialize script
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
quick=0 # otherwise 1 if "--quick" parameter is in the list
nooptim=0 # otherwise 1 if "--noopt" parameter is in the list
checkbounds=0 # or 1 if "--check" parameter is in the list
doprofile=0 # or 1 if "--profile" is in the parameter list
testlibs=1 # always include libraries testing on I*4/I*8 problem
shmem_par=0 # include shared-memory parallelization routines (KR-MCSCF,KR-CI,more to come at one day...)
dirac_blas=0   # do not use dirac blas builtin, 1 if "--dir_blas" parameter in the list
is_dirac_blas="NO"
dirac_lapack=0 # do not use dirac lapack builtin, 1 if "--dir_lapack" parameter is in the list
is_dirac_lapack="NO"
mcmodel_medium="" # filled later
LIB="" # initialize, because it's used as parameter in the list
SRC_DIR=`pwd`
dir_list="/lib /usr/lib /usr/local/lib /usr/lib64 /sw/lib"

# Set NO_LARGEFILE to something to disable large file support on Linux
NO_LARGEFILE=

# default - no IBM mode
IBMMOD=0

# default print level
IPRINT=0

#
# Does 'echo' understand escapes?
#
echo_style=sysv
if [ "	" = "`echo '\t'`" ]; then
   echo="echo"
else
   echo="echo -e"
fi
#
# Layout
col_spacing=4
col_sep=","
row_sep=";"

}

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#              General purpose functions (MAINLY LAYOUT)
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

#
# Define backup function /hjaaj
#   -v : verbose
#   -k : keep original file
#   -l 4 : backup 4 levels
#
backup () {
  ekko=0
  keep=0
  max_level=-1
  while [ -n "$1" ]; do
     case $1 in
       -v) shift; ekko=1 ;;
       -k) shift; keep=1 ;;
       -l) shift; max_level=$1; shift ;;
        *) break ;;
     esac
  done
#
  if [ $max_level -lt 0 ]; then
#    Test if default to be used. This test also catches non-numeric "-l" specifications
     max_level=4
  fi
#
  for i in $* ; do
     if [ -f "${i}" ]; then
        j=$max_level
        while [ $j -gt 0 ]; do
           jp=$j
           j=`expr $j - 1`
           if [ -f "${i}.${j}" ]; then
              [ $ekko -eq 1 ] && echo "Backup: renaming ${i}.${j} to ${i}.${jp}"
              mv -f "${i}.${j}" "${i}.${jp}"
           fi
        done
        if [ $keep -eq 1 ]; then
           [ $ekko -eq 1 ] && echo "Backup: copying ${i} to ${i}.0"
           cp -f --preserve="mode,timestamps" "${i}" "${i}.0"
        else
           [ $ekko -eq 1 ] && echo "Backup: renaming ${i} to ${i}.0"
           mv -f "${i}" "${i}.0"
        fi
     fi
  done
} # END backup ()

append () {
# Append $2 to the variable with the name $1
# TODO: Should also escape single quotes in input
  if [ -z "$1" ]; then
    eval "$1='$2'"
  else
    eval "headval=\$$1"
    eval "$1='$headval $2'"
  fi
}

str_len () {
# Determines the length of the longest string in a list
  local max_len=0
  local item=
  local var_name=
  local list=
  local OLD_IFS=$IFS

  IFS=$row_sep
  if [ -z $2 ]; then
    var_name="1"
  else
    var_name=$2
  fi

  for list in $1; do
    IFS=$col_sep
    set -- $list
    eval "item=\$$var_name"
    if [ ${#item} -gt $max_len ]; then
      max_len=${#item}
    fi
  done
  IFS=$OLD_IFS
  return $max_len
}

list_len () {
# returns the length of a list
  local counter=0
  local OLD_IFS=$IFS
  if [ -z $2 ]; then
    local counter=0
  else
    local counter=$2
  fi
  IFS=$row_sep
  for item in $1; do
    let "counter=$counter + 1"
  done
  IFS=$OLD_IFS
  return $counter
}

blank () {
# Adds $1 blanks to a line.
  local counter=0
  local tmp=""
  while [ $counter -lt $1 ]; do
    let "counter=$counter+1"
    tmp="$tmp "
  done
# Adds all blanks at the same time for performance
# Is there a way to suppress immediate refresh of the terminal window?
#   One solution is to build a complete string of every line
#   and print it only to screen when it's completely finished.
  $echo "$tmp\c"
}

get_item (){
# gets an item from a list
# Arguments 1. The list
#           2. Variable in which the arguments are space delimited put.
#           3. The index to be found
#           4. (Optional) the index of the first item.


  local OLD_IFS=$IFS
  local item=
  local list=

  if [ -z $4 ]; then
    local counter=1
  else 
    local counter=$4
  fi
  
  eval "$2=\"\""
  IFS=$row_sep
  for list in $1; do
    if [ $counter -eq $3 ]; then
      IFS=$col_sep
      for item in $list; do
        eval "$2=\"\$$2 $item\""
      done
      break
    fi
    let "counter=$counter+1"
  done
  IFS=$OLD_IFS
}

remove_item() {
# 1. List
# 2. Item

local list_name="$1"
local old_list=
eval "old_list=\"\$$1\""
local new_list=
local del_list="$2"
local OLD_IFS="$IFS"

IFS="$row_sep"
for item in $old_list; do 
  keep_item=1
  IFS="$row_sep"
  for rm_item in $del_list; do
    IFS="$col_sep"
    set -- $rm_item
    item_1=${item%%$col_sep*}
    item_2=${item#$item_1*$col_sep}
    item_2=${item_2%%$col_sep*}
    if [ "$item_1" = "$1" -a "$item_2" = "$2" ]; then 
      keep_item=0
    fi
  done
  if [ $keep_item -eq 1 ]; then
    new_list="$new_list $item$row_sep"
  fi
done
eval "$list_name=\"$new_list\""
IFS="$OLD_IFS"
}

add_item() {
# 1. List
# 2. Item
# 3. Indices
local old_list=
eval "old_list=\"\$$1\""

local new_list="$old_list"
list_len "$old_list" 
local counter=$?
local add_default=
eval "add_default=\"\$$3\""
local OLD_IFS="$IFS"

IFS="$row_sep"
for item in $2; do
  let "counter=$counter+1"
  new_list="$new_list $item$row_sep"
  add_default="$add_default $counter"
done
eval "$1=\"$new_list\""
IFS="$OLD_IFS"
eval "$3=\"$add_default\""
}

print_list() {
# Prints an array delimited by $row_sep and $col_sep.
# Arguments: 1. The list
#            2. (Optional) starting index.
# Make local copies of the lists
  local list="$1"
  local OLD_IFS=$IFS

# Get the widths of both columns
  str_len "$list" 1
  local size=$?
  str_len "$list" 2
  local size_2=$?

  let "size=$size+$col_spacing"
  let "size_2=$size_2+$col_spacing"
  
# Set the first index of the list
  if [ -z "$2" ]; then
    local counter=0
  else
    local counter=$2
  fi

# The actual printing...
# (Here we have the possibility to make the layout terminal size dependent.
#  The system variable $COLUMNS needs to be queried to do this.)
  IFS=$row_sep
  for item in $list; do
    let "counter=$counter + 1"
    IFS=$col_sep
    set -- $item
    IFS=$OLD_IFS
    tmp=`echo $1 | sed "/^ /d"`
    if [ "$counter" -lt 10 ]; then 
      $echo "$counter)  $tmp\c"
    else
      $echo "$counter) $tmp\c"
    fi

    index=${#1}
    let "index=$size - $index"
# Add blanks till we are aligned at the second column
    blank $index
# Get the corresponding item in the second list
# Print the item in the second list
    tmp=${2:1}
    $echo "($tmp)\c"

    if [ -n "$3" ]; then
      index=${#2}
      let "index=$size_2 - $index"
      blank $index
      tmp=${3:1}
      $echo "--> $tmp <--\c"
    fi
    $echo ""
  done
  IFS=$OLD_IFS
}

search_libs() {
#
# Searches for libraries in the directories of dirlist
# Arguments: 1. variable to store found libraries in. 
#            2. List of directories to search in.
#            3. List of library names.
#            4. (Optional) list of extensions
#
  local tmp_libs=
  eval "tmp_libs=\"\$$1\""
  
  if [ $IPRINT -ge "8" ]; then
      echo 'search_libs:  dir_list=' $2
      echo 'search_libs:  lib_list=' $3
      echo 'search_libs:  ext_list=' $4
  fi
  
  if [ -z "$4" ]; then
    local ext_list=".a .so"
  else
    local ext_list="$4"
  fi

  for test_lib in $3; do
    for test_dir in $2; do
      for ext in $ext_list; do
        if test -f $test_dir/$test_lib$ext; then
	  tmp_libs="$tmp_libs $test_lib$col_sep $test_dir$row_sep"
	  break
        fi
      done
    done
  done
  eval "$1=\"$tmp_libs\""
if [ $IPRINT -ge "8" ];  then
 echo 'search_libs: accumulated lib_names='$tmp_libs
fi
}

# Usage: ask_yesno y|n QUESTION
# Ask a yes/no question and return true if the answer was
# the same as the default. QUESTION should not include (y/N).
ask_yesno ()
{
    ask_yesno_default="$1"
    shift
    while true; do
	if [[ "$ask_yesno_default" = "y" ]]; then
	    $echo "$*"' (Y/n) \c'
	else
	    $echo "$*"' (y/N) \c'
	fi
	read ask_yesno_answer
	case "$ask_yesno_answer" in
	    y|Y|yes)
		[[ y = "$ask_yesno_default" ]]
		return;;
	    n|N|no)
		[[ n = "$ask_yesno_default" ]]
		return;;
	    "")
		return;;
	    *)
		echo "Please answer yes or no or hit return for default.";;
	esac
    done
}

question () {
# Wondering whether this is useful to generalize...
# Arguments
# 1 answer
# 2 What
# 3 list
# 4 extra options
# 5 default value
# 6 (optional) multiple return values
# 7 (optional) text before question
  
  local OLD_IFS=$IFS
  list_len "$4" 
  local start_n=$?
  let "start_n=$start_n-1"
  local default=""
  local answer=

  if [ -n "$3" ]; then 
    $echo "The following $2 were detected on your system: \n"
  else
    $echo "\nNo $2 were detected on your system: \n"
  fi
  print_list "$3" $start_n
  IFS=$row_sep
  local index=$start_n
  for item in $4; do
    IFS=" "
    $echo "$index) $item\t\c"
    let "index=$index - 1"
  done
  $echo "\n"
  if [ -n "$7" ]; then 
    $echo "$7"
    $echo ""
  fi
  $echo "Which one do you want to use? \c"
  list_len "$3"
  let "max_item=$?+$start_n"
  for item in $5; do
    let "item=$item+$start_n"
    if [ 0 -le $item -a $item -le $max_item ]; then
      default="$default $item"
    fi
  done
  if [ -z "$default" ]; then
    if [ -n "$6" ]; then
      local tmp_n
      let "tmp_n=$start_n+1"
      default=" $tmp_n"
      let "tmp_n=$tmp_n+1"
      default="$default $tmp_n"
    else 
      local tmp_n
      let "tmp_n=$start_n+1"
      default=" $tmp_n"
    fi
  fi
  if [ -n "$6" ]; then
    $echo "(More than one possible. Default:$default)\t\c"
  else
    $echo "(Default:$default)\t\c"
  fi
  read answer
  if [ -z "$answer" ]; then
    answer="$default"
  fi
  for item in $answer; do
    if [ 0 -gt $item -o $item -gt $max_item ]; then
      $echo "$item is not a valid choice for $2. Please pick another."
      question "$1" "$2" "$3" "$4" "$5" "$6" "$7"
    fi
  done
  eval "$1=\"$answer\""
  IFS=$OLD_IFS
}

usage ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Give usage of script
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
   echo 'Usage: '$0' [Flags]'
   echo ' Flags:'
   echo '   --help                       : Print this'
   echo '   --quick                      : Do not prompt user (WARNING: might prepare wrong Makefile.config!)'
   echo '   --noopt                      : Use compilers flags without optimization for the compilation of Dirac'
   echo '   --check                      : Add compilers flags for run-time checking array boundaries & other '
   echo '   --profile                    : Add compilers/linker flags for code profiling'
   echo '   --nolibtest                  : Do not include testing of libraries on integer*4/8 problem at DIRAC start' 
   echo '   --sharedmem_par              : Include the shared-memory-like parallelization routines in KR-MCSCF/KR-CI' 
   echo '   --system=SYSTEM-ID           : Set system to SYSTEM-id'
   echo '   --f90=F90                    : Set fortran compiler to F90 (with full path)'
   echo '   --cc=CC                      : Set C compiler to CC (with full path)'
   echo '   --parallel(par)[=(yes|no)]   : Parallel version of Dirac'
   echo '   --mpirun=MPIRUN              : Set mpi-launcher for parallel runs (with full path)'
   echo '   --libdir=DIR                 : Add directory DIR to the search list for mathematical libraries'
   echo '   --math_lib=MATH_LIB          : Choose the mathematical library MATH_LIB'
   echo '   --dir_blas                   : Employ Dirac BLAS builtin library'
   echo '   --dir_lapack                 : Employ Dirac LAPACK builtin library'
   echo '   --all_math_lib=LIB           : Choose the mathematical libraries with full paths, LIB'
   echo '   --memory-size=MEM-SIZE       : Set memory size to MEM-SIZE words'
   echo '   --install-directory=INST-DIR : Set install directory to INST-DIR'
   echo '   --i=PRINT-LEVEL              : Set the print (verbose) level for the script to PRINT-LEVEL (default 0)'
   echo '   --pam                        : Prepares the intall-dir module for  pam(.py)/pamq(.py) dirac.x launching scripts'
}

guess_system ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#  GUESS SYSTEM
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
if [ -z "$guess" ]; then
   guess=`./config.guess`
   if [ "$guess" = "" ]; then
      guess=`./config.status ARCH`
   fi
fi

IsLP64=""
ilp_datatype="ILP32" # by default assume 32-bit system (with no 8-byte integer)
guess=`./config.sub $guess 2>/dev/null`
echo

# miro : this checks only for the  x86_64 architecture, not  for other 64-bit architectures (ia64-unknown-linux | *-cray) !
if echo "$guess" | grep -q x86_64; then
    echo "Your are compiling on a x86_64 system. Do you want to use 64 bit"
    echo "integers inside Dirac? This is only useful if you need more than"
    echo "16 GB of memory in your calculations, and requires 64 bit integer"
    echo "(ILP64) versions of your MPI, BLAS and LAPACK libraries."
    echo "Running large-scale MCSCF/CI calculations using the LUCI* "
    echo "modules, however, requires 64 bit integers on a x86_64 system."
    echo
    if ask_yesno n "Use 64 bit integers in Dirac?"; then
        guess=`echo "$guess"|sed s/x86_64/i686/` # as it is 32-bit system
	echo "Configuring Dirac to use 32 bit integers (I32LP64)."
	echo "NB: LUCI* modules cannot be used."
        IsLP64=1
        ilp_datatype="I32LP64" # assign ILP-data type
    else
	echo " Configuring Dirac to use 64 bit integers (ILP64)."
	echo " NB: Be aware that your external libraries _must_ also use"
	echo " 64 bit integers, which is typically not the default"
        ilp_datatype="ILP64"  # assign ILP-data type
    fi
    echo
fi
$echo "Configuring for $guess (can be changed with --system)"
flavor=$guess
machine=`echo $guess | sed 's/-[^-]*$//'`
if [ "$machine" != "$guess" ]; then 
   os=`echo $guess | sed 's/.*-//'`
else 
   os=
fi

$echo "=> Machine             : $machine"
$echo "=> Operating system    : $os"
#
#  Set search list for libraries,
#  always libatlas first and libblas last.
#  In the middle machine specific optimized libraries are included.
#  Also make search lists for fortran and C compilers.
#  Define default C compiler.
#

case $machine in
   *-ibm | powerpc64-unknown-linux* | ppc64*| mips*-sgi | i[3-6]86-* | *apple* | sparc-sun| m68k-sun | *-hp | alpha-dec|mips-dec|alphaev6-dec ) 
     bit_set="32";;
   x86_64-* | ia64-unknown-linux | *-cray )
     bit_set="64";;
   *)
      echo "System $guess is currently .NOT. supported"
      echo "First try to update config.guess and config.sub "
      echo "  check libtools at http://www.gnu.org"
      echo "Then please report to dirac-admin@chem.sdu.dk"
      echo "Also include the command: "
      $echo "\t\`uname -m\` , \`uname -r\` , \`uname -s\` and \`uname -v\` "
      $echo "\tYou may also recommend compiler flags," 
      $echo "\tpreferred fortran compiler and mathematical libraries" \
            "available."
      exit 1
esac

#
#  Modify for SGI that may have both 32 and 64 bit architectures
#
if [ "$machine" = "mips64-sgi" ]; then
   dir_list="/usr/lib64 $dir_list"
elif [ "$machine" = "mips-sgi" ]; then
   dir_list="/usr/lib64 /usr/lib32 $dir_list"
fi

if [ $IPRINT -ge "5" ];  then
    echo
    echo 'guess_system: variable dir_list=' $dir_list
fi

}

#
parallel_stuff ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#       Set parallel environment
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo 'PARALLEL'
echo
if [ -z "${par}" ]; then
  if [ $quick = 0 ]; then
      if ask_yesno n "Do you want to install the program in a parallel version, using MPI?"; then
	  par=no
      else
	  par=yes
      fi
  else
    par=no
  fi
fi

# initialize for asking for machinefile
read_mach_file=

echo '=> Parallel version: '${par}''
if [ "$par" = "yes" ]; then
    if ask_yesno y "Will your nodes use local disks?"; then
	localdisks="yes"
        read_mach_file=1
	echo '=> Node list will be taken from MPI machine file,'
	echo '   input files will be distributed with rsh or ssh.'
    else
	localdisks="no"
    fi

#
#  Parallel architectures are difficult, better warn the user
#
   echo
   echo "Makefiles for parallel architecture are difficult to guess"
   echo "Please always compare the generated Makefile.config with local documentation."

#
#  Determine message passing protocol to be used
#
   if [ -z "${mesp}" ]; then
      mesp="mpi"
   fi
   echo '=> Parallel message passing: '$mesp
#
#  Check whether we have a parallel launcher/compiler available
#
   if [ "$mesp" = "mpi" ]; then
      case $machine in
         *-ibm | powerpc64-unknown-linux* | ppc64* )
            parlib='no'
            parinc='yes'
            mpirun=`which poe 2>/dev/null`
            ;;
         *-hp)
            parlib='no'
            parinc='yes'
            mpirun=`which mpirun 2>/dev/null`
            ;;
         *-dec)
            parlib='yes'
            parinc='yes'
            mpirun=`which dmpirun 2>/dev/null`
            ;;
         i[3-6]86-* | x86_64-* | ia64-unknown-linux)
            parlib='yes'
            parinc='yes'
            mpirun=`which mpirun 2>/dev/null`
            ;;
         *)
            parlib='yes'
            parinc='yes'
            mpirun=`which mpirun 2>/dev/null`
            ;;
      esac

      ### control  printout of the found (default) MPI launcher ###
      if [ $IPRINT -ge "7" ];  then
        if [ -n "$mpirun" ]; then
          $echo "control print: Found MPI launcher (check it in pam script!): $mpirun"
        else
          $echo "control print: MPI launcher NOT found! Assuming 'mpirun', correct this manually."
        fi
      fi
   fi
#
# MPI questions after we fixed the compiler
#
#  Ask for the necessity of machine file and in the case of positive response (for some MPI libs)
#  continue with querying for nodefile
#
   if [ $quick = 0 ]; then
       if ! ask_yesno n "Does your MPI setting require machinefile for MPI launcher (like mpich2)?"; then
          mach_file_mpirun="yes"
          read_mach_file=1
       else
          mach_file_mpirun="no"
       fi

       if [ "$localdisks"="yes" -a "$mach_file_mpirun"="no"  ]; then
         $echo '\nUsing local disks - default machinefile for distribution of files\n among nodes needed!'
       elif [ "$localdisks"="yes" -a "$mach_file_mpirun"="yes"  ]; then
         $echo '\nBoth local disks & MPI launcher need default machinefile!'
       elif [ "$localdisks"="no" -a "$mach_file_mpirun"="yes"  ]; then
         $echo '\nMPI launcher needs default machinefile! '
       fi 

       # miro: please add machinefile variable for other batch systems as well
       if [ -n "$read_mach_file" ]; then
         $echo 'Each queuing system has its own variable for the file '
         $echo 'with reserved nodes (machinefile). For instance, $HOSTNAME for SGE,'
         $echo '$LSB_HOSTS for LSF, $XXX for IBM LoadLeveler...'
         $echo 'As the default, we offer $PBS_NODEFILE of the OpenPBS batch system.'
         $echo 'Specify the machinefile (filename/variable; default:$PBS_NODEFILE): \c'
         read mach_file
         if [ -z "$mach_file" ]; then
            mach_file='$PBS_NODEFILE'
         fi
       fi

   else # if quick setting, no machinefile for MPI
      mach_file=
      $echo '\n No machinefile assigned in the quick setting mode.'
   fi

#
#  With local disks set remote copy/shell:
#
#   rsh=rsh
   rsh=""
#   rcp=rcp
   rcp=""
   if [ "$localdisks" = "yes" ]; then
     if [ $quick = 0 ]; then
       $echo '\nRemote shell/copy for passing files to local disks (rsh/ssh) (default: rsh): \c'
       read rsh
       case "$rsh" in
	 "ssh")
            rsh=`which ssh 2>/dev/null`
            rcp=`which scp 2>/dev/null`
            echo 'Note that ssh/scp requires use of ssh keys without password!'
	    ;;
	 *)
            rsh=`which rsh 2>/dev/null`
            rcp=`which rcp 2>/dev/null`
	    ;;
       esac
     fi
   fi
else
   mesp='dummy'
   mach_file=
   #rsh=rsh
   rsh=`which rsh 2>/dev/null`
   #rcp=rcp
   rcp=`which rcp 2>/dev/null`
fi
echo
}

safeflags_stuff() {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#  Take care of safe flags (i.e. no optimization) if set up in the
#  'configure' argument list
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
safe_flags_mode="NO"
if [ $nooptim = 1 ]; then
  safe_flags_mode="YES"
  echo
  echo  'COMPILERS FLAGS set without the optimization => quick compilation of the DIRAC code.'
  echo
fi
}

mpi2check () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#  Check if MPI-2 is installed and modify flags accordingly
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
if [ "$mesp" = "mpi" ]; then
  mpi2version="yes"

  if [ $IPRINT -ge "7" ];  then 
    echo 'mpi2check: F90_COMP_NAME='$F90_COMP_NAME
    echo 'mpi2check: F90real='$F90real
  fi

  case $F90_COMP_NAME in
    xlf*|mpfort|mpxlf_r) comptst="$F90_COMP -WF,-DSYS_$sys_name" ;;
    *) comptst="$F90_COMP -DSYS_$sys_name" ;;
  esac
# gfortran needs -fcray-pointer flag for POINTER statements in MPI2_test.F !
  case $F90real in
    gfortran|gfortran-*|gfortran*)
    #*/gfortran|*/gfortran-*)
        comptst="$comptst -fcray-pointer"
        opt="$opt -fcray-pointer"
        safe="$safe -fcray-pointer"
        if [ $IPRINT -ge "7" ];  then 
          echo 'mpi2check:   comptst='$comptst
          echo 'mpi2check: opt='$opt
          echo 'mpi2check: safe='$safe
        fi
    ;;
  esac

 $echo "\nChecking if a MPI-2 version is installed:"
  echo "   $comptst ./cbuild/MPI2_test.F"
  mpi2version="yes"
  $comptst ./cbuild/MPI2_test.F 2>/dev/null || mpi2version="no"
  rm -f a.out
  if [ "$mpi2version" = "no" ]; then
    echo  " "
    echo  "Hmm. Failed to find support for MPI-2 in your installation.  "
    echo  " "
    echo  "If you think this is incorrect, in the following question    "
    echo  "press 'n' to configure with MPI-2 support, and add manually  "
    echo  "any missing paths to your MPI-2 installation."
    echo  " "
    echo  "Please note that the functionality from the following DIRAC "
    echo  "modules will NOT be available without MPI-2 support: "
    echo  " "
    echo  "    - LUCITA                   "
    echo  "    - LUCIAREL                 "
    echo  "    - KR-MCSCF using LUCIAREL  "
    echo  "    - MOLTRA with parallel I/O (helpful for global/shared scratch spaces)"
    echo  " "
    if ask_yesno y "Disable MPI-2 support and continue?"; then
	echo " - MPI-2 functionality disabled"
    else
	mpi2version=yes
	echo "OK. Remember to add MPI2 paths to Makefile.config if necessary!"
    fi;
  fi
  if [ "$mpi2version" = "yes" ]; then
    echo "=> MPI-2 is available."
    cpp_cc="$cpp_cc -DVAR_MPI2"
    cpp_f90="$cpp_f90 -DVAR_MPI2"
  fi
fi

if [ $IPRINT -ge "7" ];  then 
  echo '... after mpi stuff' 
fi
} # END mpi2check ()


find_mpi_path () {
$echo "\nDETECTION OF MPI LIBRARIES.\n"
case $F90_COMP in
  *mp*) 
    echo "Found a mpi compiler. No further searching for mpi libraries."
    parlib=""
    parinc=""
    return 0;;
esac

pardir=$dir_list
incdir='/usr/include /usr/local/include /local/include'
#  Modify for RS6000K where mpi.h is placed in some obscure directory
if [ "$machine" = "*-ibm" ]; then
  incdir="$incdir /usr/lpp/ppe.poe/include"
fi
parlib_pwd=
#
#  MPI settings, first we do the mpi-library
#
if [ "$parlib" = "yes" -a "$mesp" = "mpi" ]; then
  parlib=""
  search_libs parlib "$pardir" "libmpi libmpich" ".a .so .so.0" 
  if [ -n "$parlib" ]; then
    question lib_index "mpi_libraries" "$parlib" " Specify the root of the mpi directory. $row_sep Configure libraries manually."

    if [ $lib_index -eq 0 ]; then
      $echo "No mpi libraries are included at this moment."
      $echo "To add the libraries yourself edit Makefile.config manually!"
      return 0
    elif [ $lib_index -eq 1 ]; then
      $echo ""
    elif [ -n $lib_index ]; then
      get_item "$parlib" parlib $lib_index 2
      set -- $parlib
      parlib_pwd=$2
      parlib='-lmpi'
    fi
  fi
 
# jhs could be changed in a while loop in case of typo's
  if [ -z "$parlib" ]; then
    echo "Please enter the path to your mpi libraries:"
    read mpi_lib
    search_libs parlib "$mpi_lib $mpi_lib/lib" "libmpi libmpich" ".a .so .so.0" 
    if [ -n "$parlib" ]; then
      get_item "$parlib" parlib 1
      set -- $parlib
      parlib=-lmpi
      parlib_pwd=$2
    else 
      $echo "No valid mpi library found. Please edit Makefile.config manually!"
      parlib=""
      parlib_pwd=""
    fi
  fi
  if [ -z "$parlib" ]; then
    echo 'Parallel library: none'
  else
    echo "Parallel library: $parlib ($parlib_pwd)"
  fi
  echo
fi
if [ "$parinc" = "yes" -a "$mesp" = "mpi" ]; then
#
#     Now we try to find an include directory
#
  parinc=""
  if [ -n "$parlib" ]; then
    tmp_dir=${parlib_pwd%/*}
    if [ -f $tmp_dir/include/mpif.h ]; then
      echo "Included mpif.h file: $tmp_dir/mpif.h"
      parinc="-I$tmp_dir/include/mpif.h"
    fi
    tmp_dir=${tmp_dir%/*}
    if [ -f $tmp_dir/include/mpif.h ]; then
      echo "Included mpif.h file: $tmp_dir/mpif.h"
      parinc="-I$tmp_dir/include/mpif.h"
    fi
    if [ -z "$parinc" ]; then
      echo "Please enter the directory containing your mpi include file (mpif.h):"
      read parinc
      if [ -f "$parinc/mpif.h" ]; then
        parinc="-I$parinc/mpif.h"
      else
        parinc=""
      fi
    fi
  fi

  if [ -z "$parinc" ]; then
    echo "Include file 'mpif.h' not found. Please edit Makefile.config manually!."
    echo 'Parallel include: none'
  else
    echo 'Parallel include:'$parinc
  fi
fi
if [ "$parlib" = "no" ]; then
  parlib=
fi
#
echo ""
}  # end of "find_mpi_path ()"


find_compilers () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Find compilers
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo 'COMPILER'
echo

compiler_fortran
compiler_c

# check the assigned mpirun against parallel compilers
if [ "$mesp" = "mpi" ]; then
  check_mpirun
fi

}

check_mpirun(){
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#  checks whether mpi assigned binaries have the same path
#
#  This 'routine' is called solely in parallel mode
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

if [ -n "$MPIRUN_NAME" ] ; then
 if [ -e "$MPIRUN_NAME" ] ; then
  if [ "$MPIRUN_NAME" != "$mpirun" ]; then
    $echo 'Assigned mpirun ' $MPIRUN_NAME ' instead of the default ' $mpirun
  else
    $echo 'Assigned mpirun from the configure flag :' $MPIRUN_NAME 
  fi
  mpirun=$MPIRUN_NAME
 else
   echo 'assigned ' $MPIRUN_NAME ' is not proper file !'
   echo 'instead using the default ' $mpirun
 fi
else
   if [ -n "$mpirun" ]; then
        $echo "\nFound MPI launcher : $mpirun"
#ulfek: why? It just has to be correct. $echo "The MPI launcher must come from the same directory as assigned mpi-compilers (mpif90, mpicc...)!\n"
#miro: ulf, you're right.
   else
        $echo "MPI launcher NOT found! Assuming 'mpirun', correct this manually."
   fi
fi 

# extract directories of mpi-compilers/mpi-launcher
F90_COMP_DIR=`dirname $F90_COMP 2>/dev/null`
CC_COMP_DIR=`dirname $CC_COMP 2>/dev/null`
MPIRUN_DIR=`dirname $mpirun 2>/dev/null`

if [ "$MPIRUN_DIR" != "$F90_COMP_DIR" -a "$MPIRUN_DIR" != "$CC_COMP_DIR" ]; then
 if ask_yesno n "WARNING: mpirun sits in different directory than mpif90/mpicc. Is it correct ?" ; then
  # find the mpi-launcher as is looking for compilers
   comp_list="mpirun poe dmpirun" # list of all possible mpi-launchers
   find_compiler "MPIRUN" $MPI_NAME
   mpirun=${comp_pwd}${comp_found}
   $echo "Assigned MPI launcher (also placed into \"pam\" script) : $mpirun"
 else # yes, correct
   $echo "Good. "
 fi
else
 $echo "(Note: mpirun is in the same directory as mpif90/mpicc. Good.)"
fi

if [ $IPRINT -ge "7" ];  then
 echo
 echo 'check_mpirun: assigned F90 compiler: ' $F90_COMP
 echo 'check_mpirun: assigned  CC compiler: ' $CC_COMP
 echo '          ... assigned     mpirun  : ' $mpirun
 echo
fi

}

compiler_fortran(){
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#            Sets up the fortran compiler
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
# all supported fortran compilers
comp_list='ifort ifc g95 g90 gfortran gfortran44 gfortran-4.2 gfortran-4.3 pgf95 pgf90 lfc f90 xlf_r xlf efc cf90 pathf90'
# Prefer "parallel" compilers if mpi
if [ "$mesp" = "mpi" ]; then
  comp_list="mpfort_r mpfort mpxlf_r mpxlf mpiifort openmpif90 mpif90 mpif77 $comp_list"
fi
find_compiler "Fortran" $F90_COMP_NAME
F90_COMP_NAME=$comp_found
F90_COMP=${comp_pwd}${comp_found}

if [ $IPRINT -ge "5" ];  then
 echo 'compiler_fortran: found F90 compiler ' $F90_COMP
fi

}

compiler_c(){
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Set up the c compiler
#
# In the case of GNU gfortran the gcc has to be of the same development serie
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

# (Almost) all supported C compilers; gcc-*.* serie has to be continuosly updated
comp_list='icc gcc gcc44 gcc-3.3 gcc-4.3 pgcc pathcc cc ecc xlc_r xlc xlc'
if [ "$mesp" = "mpi" ]; then
  comp_list="mpcc_r mpcc openmpicc mpicc mpiicc $comp_list" 
fi
find_compiler "C" $CC_COMP_NAME
CC_COMP_NAME=$comp_found
CC_COMP=${comp_pwd}${comp_found}

if [ $IPRINT -ge "5" ];  then
  echo ''
  echo 'compiler_c: comp_found='$comp_found
  echo 'compiler_c:   comp_pwd='$comp_pwd
  echo 'compiler_c: got CC_COMP='$CC_COMP
fi

}

old_compiler () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#     Find out compiler in old Makefile.config (ie previous installation)
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
case "$2" in
  "Fortran")
    old_comp=`./config.status "F90"` ;;
  "C")
    old_comp=`./config.status "CC"` ;;
  "MPIRUN")
    old_comp=`./config.status "MPIRUN"` ;;
esac

if [ $IPRINT -ge "7" ];  then
  echo ' '
  echo 'old_compiler: for '$2' got old_comp='$old_comp
fi

# miro: this assumes compiler with the full path !
old_pwd=${old_comp%/*}
old_comp=${old_comp##*/}

if [ $IPRINT -ge "7" ];  then
  echo 'old_compiler: set old_comp='$old_comp
  echo 'old_compiler: set  old_pwd='$old_pwd
fi

if [ -n "$old_comp" ]; then 
  eval "$1=\" $old_comp$col_sep $old_pwd$col_sep Previous installation$row_sep\"" 
fi
}

find_compiler ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Finds compilers from a list 
#   Argument $1 : The name of the compiler to be found
#                (for messages to the user)
#   Argument $2 : User preferred compiler
#   comp_list   : Contains the compilers
#   Here we return comp_set
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
local to_find=$1
local default=
comp_found=""
comp_pwd=""

old_compiler old_comp "$to_find"
search_dirs=`echo "$PATH"|sed 's/:/ /g'`
# BASH: search_dirs=${PATH//:/ }
# Which doesn't work on mac!
if [ ! -z "$2" ]; then
  local tmp_list=$comp_list
  if [ -f "$2" ]; then # checks the presence of file (with full path)
    comp_found=$2
    comp_pwd=""
    echo "Compiler for $to_find: $comp_found"
    return 0
  else
    echo "Compiler specified with --f90/--cc not found (you must also provide full path)."
    echo "Compiler: $2"
    echo "Checking for the standard compilers."
  fi
fi

for comp in $comp_list; do
# Only search in $PATH
  for cur_dir in $search_dirs; do
    if [ -f $cur_dir/$comp ]; then
      comp_found="$comp_found $comp$col_sep $cur_dir$row_sep"
    fi
  done
done

if [ -n "$old_comp" ]; then
  remove_item comp_found "$old_comp"
  add_item comp_found "$old_comp" default
fi

if [ -z "$comp_found" ]; then
  $echo "\n   No $to_find compiler found on this computer"
  echo  "   Cannot proceed without a Fortran compiler in path"
  echo  "   Please check your path! "
  echo  " Or specify a compiler manually: "
fi

question comp_index "$to_find compilers" "$comp_found" " Specify compiler manually" "$default"

if [ $comp_index -eq 0 ]; then
    echo ""
    echo "Note that compiler flags may not be set correctly."
    echo "Check Makefile.config afterwards!"
    echo ""
    $echo "Enter your compiler:\c"
    read comp_found
    comp_pwd=`dirname $comp_found`
    comp_found=`basename $comp_found`
else
    get_item "$comp_found" comp_found $comp_index 1
    set -- $comp_found
    comp_found=$1
    comp_pwd=$2
fi

if [ ! -z "$comp_pwd" ]; then
  if [ "$comp_pwd" != "/" ]; then
    comp_pwd="$comp_pwd/"
  fi
fi
$echo "Compiler for $to_find: $comp_pwd$comp_found\n"
}

find_real_f90(){
#
# Find the underlying compiler for fortran compilers
#

if [ $IPRINT -ge "8" ]; then
 $echo "\n ===  find_real_f90 ===="
 $echo "   F90_COMP_NAME=$F90_COMP_NAME"
 $echo "        F90_COMP=$F90_COMP"
 $echo " current F90real=$F90_real"
fi

case "$F90_COMP_NAME" in

*/openmpif*|*/mpif*|*/mpii*|openmpif*|mpif*|mpii*) # must consider a full path !
   if    "$F90_COMP" -show   > /dev/null; then
      # MPICH, OpenMPI
      mpishowopt="-show"
   elif  "$F90_COMP" -showme > /dev/null; then
      # LAM MPI
      mpishowopt="-showme"
   else
      $echo "\nNo Fortran parallel mpishowopt assigned. Configure might not be able to determine compiler flags.\n"
   fi
   if [ $IPRINT -ge "8" ]; then
     $echo "assigned mpishowopt=$mpishowopt"
   fi

   my_mpi_include_path=`$F90_COMP $mpishowopt | grep mpif.h | sed -e 's/ln -s //' | sed -e 's/mpif.h//g'|grep include`
   if   "$F90_COMP" $mpishowopt | grep -q ifc      > /dev/null; then
      F90real=ifc
   elif "$F90_COMP" $mpishowopt | grep -q ifort    > /dev/null; then
      F90real=ifort
   elif "$F90_COMP" $mpishowopt | grep -q gfortran > /dev/null; then
      F90real=gfortran
   elif "$F90_COMP" $mpishowopt | grep -q pathf90  > /dev/null; then
      F90real=pathf90
   elif "$F90_COMP" $mpishowopt | grep -q pgf95    > /dev/null; then
      F90real=pgf95
   elif "$F90_COMP" $mpishowopt | grep -q pgf90    > /dev/null; then
      F90real=pgf90
   elif "$F90_COMP" $mpishowopt | grep -q lfc      > /dev/null; then
      F90real=lfc
   elif "$F90_COMP" $mpishowopt | grep -q g95      > /dev/null; then
      F90real=g95
   else
      F90real=$F90_COMP
   fi
   echo "Fortran compiler in $F90_COMP found to be: $F90real"
   ;;
mpxlf|*/mpxlf|mpxlf_r|*/mpxlf_r) # must consider full path !
   F90real=xlf
   echo "Fortran compiler in $F90_COMP found to be: $F90real"
   ;;

*)
# compiler could be hidden in its full path
   if  [[ "$F90_COMP"  == *"g95"* ]]; then
      F90real=g95
   elif [[ "$F90_COMP"  == *"ifc"* ]]; then
      F90real=ifc
   elif [[ "$F90_COMP"  == *"ifort"* ]]; then
      F90real=ifort
   elif [[ "$F90_COMP"  == *"gfortran"* ]]; then
      F90real=gfortran
   elif [[ "$F90_COMP"  == *"pgf95"* ]]; then
      F90real=pgf95
   elif [[ "$F90_COMP"  == *"pgf90"* ]]; then
      F90real=pgf90
   fi

   if [ "$par" = "yes" ]; then
     F90real=$F90_COMP_NAME # 'error' default for parallel branch
     $echo "\nNo specific Fortran-compiler found in parallel $F90_COMP. Can not assign proper flags!"
     $echo "find_real_f90:  assigned F90real=$F90real"
   fi
   ;;
esac

if [ $IPRINT -ge "8" ]; then
 $echo "find_real_f90:  assigned F90real=$F90real"
fi
}

find_real_cc(){
#
#  Find the underlying compiler for C-mpi compiler
#
if [ $IPRINT -ge "8" ]; then
 $echo "\n ====  find_real_cc: ===="
 $echo "   CC_COMP_NAME=$CC_COMP_NAME"
 $echo "        CC_COMP=$CC_COMP"
 $echo " current CCreal=$CCreal"
fi

case "$CC_COMP_NAME" in
openmpicc|mpicc|mpii*|*/openmpicc|*/mpicc|*/mpii*) # must consider a full path !
   if    "$CC_COMP"  -show   > /dev/null; then
      # MPICH etc
      mpishowopt="-show"
   elif  "$CC_COMP"  -showme > /dev/null; then
      # LAM MPI etc
      mpishowopt="-showme"
   else
      $echo "\nNo C-parallel mpishowopt assigned. Configure might not be able to determine C-compiler flags.\n"
   fi

   if [ $IPRINT -ge "8" ]; then
     $echo "assigned mpishowopt=$mpishowopt"
   fi

   if   $CC_COMP_NAME $mpishowopt | grep -q icc    > /dev/null; then
      CCreal=icc
   elif $CC_COMP_NAME $mpishowopt | grep -q pathcc > /dev/null; then
      CCreal=pathcc
   elif $CC_COMP_NAME $mpishowopt | grep -q pgcc   > /dev/null; then
      CCreal=pgcc
   elif $CC_COMP_NAME $mpishowopt | grep -q gcc    > /dev/null; then
      CCreal=gcc
   else
      CCreal=$CC_COMP_NAME
   fi
   $echo "C compiler in $CC_COMP_NAME found to be: $CCreal."
   ;;
*)
  CCreal=$CC_COMP_NAME
  if [ "$par" = "yes" ]; then
    $echo "No specific C-compiler found in parallel $CC_COMP_NAME. Configure might not assign proper flags!"
  fi
  ;;
esac
echo

if [ $IPRINT -ge "8" ]; then
 $echo "find_real_CC: assigned CC_real=$CCreal"
fi

}

setup_math_lib(){
#
#
#
  if [ $IPRINT -ge "5" ];  then
    echo 'setup_math_lib: entering param lib, 1='$1
    echo 'setup_math_lib: entering param dir, 2='$2
  fi

  case "$1" in
    libesslp2) append LIB "-L$2 -lesslp2";;
    libessl) append LIB "-L$2 -lessl";;
    libblas) append LIB "-L$2 -lblas" ;;
    liblapack) append LIB "-L$2 -llapack" ;;
    libatlas) append LIB "-L$2 -llapack -lcblas -lf77blas -latlas";;
    libdxml) append LIB "-L$2 -ldxml";;
    libcomplib.sgimath) append LIB "-L$2 -lcomplib.sgimath";;
    libveclib) append LIB "-L$2 -lveclib";;
    libmath) append LIB "-L$2 -lmath -lm -nx";;
    libmkl) append LIB "-L$2 -lmkl_lapack -lguide -lpthread -lmkl"
            optblas=$2;;
    libmkl_ipf) append LIB "-L$2 -lmkl_lapack -lmkl_ipf -lguide -ldl "
                      optblas=$2;;
    libmkl_itp) append LIB "-L$2 -lguide -lpthread -lmkl_itp"
                      optblas=$2;;
    libmkl_intel_lp64) append LIB "-L$2 -lmkl_lapack -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -lguide -lpthread"
                       optblas=$2;;
    libmkl_intel) append LIB "-L$2 -lmkl_lapack -lmkl_intel -lmkl_intel_thread -lmkl_core -lguide -lpthread"
                       optblas=$2;;

    # miro: this is the only ILP64 library we offer
    libmkl_ilp64)
        append LIB "-L$2 -lmkl_lapack -lguide -lpthread -lmkl_intel_ilp64 -lmkl"
        optblas=$2
        if [ "$ilp_datatype" != "ILP64" ]; then
          $echo "\nYour data type model $ilp_datatype does not correspond with the selected ILP64 library $LIB!\n"
          $echo "Error exit 1!\n"
          exit 1
        fi
        ;;
    apple*)
       append LIB "-framework $2"
    ;;
    user-defined) 
       libprev=$2
       libli $libprev $my_old_libs
       append LIB "-L$libline"
    ;;
  esac

  if [ $IPRINT -ge "5" ];  then
    $echo 'setup_math_lib: finally setup variable LIB='$LIB
  fi

  test_lib_arch $2
  if [ 0 -eq $? ]; then
    echo "System is $bit_set-bit, but the mathematical libraries are probably not."
    echo "Libraries: $2/$1"
    if ask_yesno n " Do you still want to use these libraries?"; then
	$echo "Please specify the libraries again."
        lib_names=""
        lib_dirs=""
        get_math_lib
    fi
  fi
}

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
get_math_lib(){
# Try different versions and see how fast they are.

# 1. Get a list of directories
#    Test for every directory whether a library exists.

# 2. Get list of libraries.
#    Grep for the mathematical library names.
#    Split the found libs into a directory path, and a name.

# Initialize global variables
LIB=""

libs=" dirac blas$col_sep builtin$row_sep"
libs="$libs dirac lapack$col_sep builtin$row_sep"

old_lib lib_guess

if [ $IPRINT -ge "5" ];  then
  echo 'get_math_lib: lib_guess='$lib_guess
fi

search_libs libs "$math_dirs" "$lib_list"
list_len "$libs"
max_lib=$?

default=""
if [ -n "$lib_guess" ]; then
  remove_item libs "$lib_guess"

  if [ $IPRINT -ge "5" ];  then
    echo 'get_math_lib: after remove_item, lib_guess='$lib_guess
  fi

  add_item libs "$lib_guess" default
fi

if [ $IPRINT -ge "5" ];  then
 $echo '\n get_math_lib: lib_names='$lib_names
 $echo '  get_math_lib: libs='$libs
fi

question lib_index "mathematical libraries" "$libs" " Specify a library path to search $row_sep Configure libraries manually." "$default" "y" "You need to specify a BLAS AND a LAPACK libraries routines.\nThere are blas and lapack implementations shipped with dirac.\nHowever they are VERY SLOW compared to optimized libraries."

for index in $lib_index; do
  if [ $index -eq 0 ]; then
    $echo "No libraries are included at this moment."
    $echo "To add the libraries yourself edit Makefile.config manually!"
    break
  elif [ $index -eq 1 ]; then
    $echo "Enter a directory to search: \c"
    read math_dirs
    $echo "Also search its subdirectories? (y/N) \c"
    read rec_search

    echo
    echo "Building a list of subdirectories of: $math_dirs ... "
    if [ ! -z "$math_dirs" ]; then
      case $rec_search in
      "yes" | "y" | "Y" )
        math_dirs=`find $math_dirs -type d -print`;;
      esac
    fi
    get_math_lib
  elif [ $index -eq 2 ]; then
    is_dirac_blas="YES"
    $echo "Default (internal) BLAS used."
    append cpp_f90 "-DUSE_DIRAC_BLAS"
  elif [ $index -eq 3 ]; then
    is_dirac_lapack="YES"
    $echo "Default (internal) LAPACK used."
    append cpp_f90 "-DUSE_DIRAC_DLAMCH -DUSE_DIRAC_DLAPACK -DUSE_DIRAC_ZLAPACK"
  elif [ ! -z $index ]; then
       get_item "$libs" lib_name $index 2
       set -- $lib_name
       setup_math_lib $1 $2
  fi
done

}

test_lib_arch() {
#
# Check whether the libraries are 32/64 bit
#

if [ $bit_set -eq 32 ]; then
 # if [ -z `echo $1 |  grep "64"` ]; then
  if [ -z `echo $1 |  grep "64"` ]  || [ -n $IsLP64 ]; then
    return 1
  else
    return 0
  fi
fi

if [ $bit_set -eq 64 ]; then
  if [ -n `echo $1 |  grep "64"` ]; then
    return 1
  else
    return 0
  fi
fi

}

nolib () {
   echo  Sorry, linking test program to $LIB failed.
   LIB=
}

########
# aspg: helper to sort out the mess of old libs

libli () {

libline=''
linelib=`./config.status "LIBS"`
linelib=${linelib#*-L}
linelib="$linelib -L"

 while [ -n "$linelib" ]; do
  tmp2libs=${linelib%%-L*}
  tmp2libs=${tmp2libs## }
  tmp2libs=${tmp2libs%% }
  llinelib=${linelib%% *}

  if [ "$1" == "$llinelib"  ]; then
    libline=$tmp2libs
  fi

  linelib=${linelib#*-L}

 done

}
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
old_lib () {
# Gets old libraries from Makefile.config
return_libs=""
old_libs=`./config.status "LIBS"`
my_old_libs=$old_libs

if [ $IPRINT -ge "5" ];  then
 echo 'old_lib: from Makefile.config extracted old_libs='$old_libs
fi

#throw away junk and front junk
if [ -z "$old_libs" ]; then return 0; fi
old_libs=${old_libs#*-L}
old_libs="$old_libs -L"

while [ -n "$old_libs" ]; do
  tmp_libs=${old_libs%%-L*}
  tmp_libs=${tmp_libs##-framework}
  tmp_libs=${tmp_libs## }
  tmp_libs=${tmp_libs%% }
  old_libs=${old_libs#*-L}

  lib_pwd=${tmp_libs%% *}
  tmp_libs=${tmp_libs#$lib_pwd }

# Undo setup_math_lib routine
  case "$tmp_libs" in
    "veclib") lib_name="veclib";;
    "-lesslp2") lib_name="libesslp2" ;;
    "-lessl") lib_name="libessl" ;;
    "-lblas") lib_name="libblas" ;;
    "-llapack") lib_name="liblapack" ;;
    "-llapack -lcblas -lf77blas -latlas") lib_name="libatlas" ;;
    "-ldxml") lib_name="libdxml";;
    "-lcomplib.sgimath") lib_name="libcomplib.sgimath" ;;
    "-lveclib") lib_name="libveclib" ;;
    "-lmath -lm -nx") lib_name="libmath";;
    "-lmkl_lapack -lguide -lpthread -lmkl") lib_name="libmkl";;
    "-lmkl_lapack -lmkl_ipf -lguide -ldl") lib_name="libmkl_ipf";;
    "-lmkl_lapack -lguide -lpthread -lmkl_intel_ilp64 -lmkl") lib_name="libmkl_ilp64";;
    "-lmkl_lapack -lmkl_intel -lmkl_intel_thread -lmkl_core -lguide -lpthread") lib_name="libmkl_intel";;
    "-lmkl_lapack -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -lguide -lpthread") lib_name="libmkl_intel_lp64";;
    "-lguide -lpthread -lmkl_itp") lib_name="libmkl_itp" ;;
    *) lib_name="user-defined" ;;
  esac
  return_libs="$return_libs $lib_name$col_sep $lib_pwd$col_sep Previous installation$row_sep"
done
eval "$1=\"$return_libs\""

old_libs=$my_old_libs
if [ $IPRINT -ge "5" ];  then
    echo 'old_lib: old_libs='$old_libs
    echo 'old_lib: tmp_libs='$tmp_libs
    echo 'old_lib: lib_name='$lib_name
    echo 'old_lib: return_libs='$return_libs
fi
}

find_mathlib ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Find mathematical libraries
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
$echo
$echo 'MATHEMATICAL LIBRARIES'
$echo
$echo 'The use of optimized BLAS and LAPACK routines implementation'
$echo 'is very important, especially for the performance of MOLTRA and RELCCSD.'
$echo

#
# if mathematical libraries(with path) are given in the flag, accept them 
#
# likewise check whether user wants builtin BLAS, LAPACK dirac defaults
#
if [ -n "$LIB" ]; then
  $echo "Mathematical library(-ies) chosen in configure flag (to appear as \"LIBS\" in Makefile.config):"
  $echo "      $LIB"
  if [ $dirac_blas = 1 ]; then
    $echo "\nEmployed default BLAS builtin library (through preprocessor flag) "
    append cpp_f90 "-DUSE_DIRAC_BLAS"
    is_dirac_blas="YES"
  fi
  if [ $dirac_lapack = 1 ]; then
    $echo "\nEmployed default LAPACK builtin library (through preprocessor flag) "
    append cpp_f90 "-DUSE_DIRAC_DLAMCH -DUSE_DIRAC_DLAPACK -DUSE_DIRAC_ZLAPACK"
    is_dirac_lapack="YES"
  fi
  return 0 # leave subroutine - do not query anymore
fi


#
#  Check if use LIB_LIST from old Makefile.config
#
# libraries
ext_list='.so .a'
       #  $userlib comes from the parameter list
lib_list="$userlib libblas libatlas libesslp2 libessl libcomplib.sgimath \ 
    libmkl libmkl_ipf libmkl_itp libmkl_intel libmkl_intel_lp64 libmkl_ilp64 sunperf libveclib libdxml liblapack"
LIB=""
math_dirs=$dir_list

if [ $IPRINT -ge "5" ];  then
  $echo 'find_math_lib: setup math_dirs='$math_dirs
fi

if [ -z "$LIB" ]; then
  get_math_lib
fi

if [ -z "$LIB" -a -n "$lib_list" ]; then

    if [ $IPRINT -ge "4" ];  then
      echo 'find_math_lib: none lib found,      LIB='$LIB
      echo 'find_math_lib: none lib found, lib_list='$lib_list
    fi

    echo 'Mathematical libraries: none found'
elif [ -n "$LIB" ]; then
    echo 'Mathematical libraries: '$LIB
fi
}

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
deal_testlib () {
#
#  deal with testing of libraries ...
#

if [ $testlibs = 1 ]; then
  $echo "\nTesting of used mathematic(/parallel) libraries for integer data type compatibility enabled. \c"
else
  $echo
  $echo " Testing of mathematical libraries DISABLED!"
  $echo " Make sure you know _exactly_ why you are doing this, and consider"
  $echo " using the built-in reference libraries if you have problems with"
  $echo " your optimized system libraries. One common problem is integer"
  $echo " size mismatch between Dirac and BLAS/LAPACK/(system MPI libs)."
  $echo " Hit return to continue.."
  $read
  cpp_f90="-DNO_SELFTEST $cpp_f90"
fi
echo
}

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
