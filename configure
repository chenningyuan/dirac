#!/bin/bash
#
# FILE    : configure
#
# NOTE: THIS SCRIPT IS MORE THAN 2000 LINES. 
#       FIRST A LOT OF SCRIPT FUNCTIONS ARE DEFINED.
#       THE ACTUAL SCRIPT IS AT THE BOTTOM, SEARCH FOR "MAIN SCRIPT" TO FIND IT.
#
# Shell script for configuring Makefile.config needed to build
# the DIRAC relativistic molecular code, the pam and runtest script.
# The shell script is a heavily modified version of the script used for DALTON
#
# It tries to determine what platform we are on (although allowing builds
# for other platforms, as needed for crosscompiling), as well as detect any
# interesting mathematical libraries on the present computer.
#
#
# Known problems: The parallelization installation is rudimentary
#                 The checks for compilers and libraries hopefully works
#
# Written by K.Ruud, Dec-1 1996
# Revised 970401 hjaaj
# Linux support added 970414 by Konrad Hinsen.
# HP revisions 970505-ekd/Konrad Hinsen. Combined by kr 080597
# Adapted for DIRAC 970910 - tsaue
# Polish by Thomas Enevoldsen Oct 2 1997
# Guess machine automatic by Joern Thyssen Nov 11 1997
# Remember last config by Joern Thyssen - Jan 28 1998
# INTEGER*8 as default on 64-bit machines by Stefan Knecht - Jul 15 2007
# Rewritten to modular form Trond Saue, Jetze Sikkema - June 2008
# Use bash instead of sh, Jetze Sikkema - September 2008
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# TODO
# Large molecule flag -> out (takes lot of memory)?
#
# miro: Still place for further improvements,  modularisation etc
#
# Clean code
#

initialize ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Initialize script
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
quick=0 # otherwise 1 if "--quick" parameter is in the list
nooptim=0 # otherwise 1 of "--noopt" parameter is in the list
SRC_DIR=`pwd`
dir_list="/lib /usr/lib /usr/local/lib /usr/lib64 /sw/lib"

# default - no IBM mode
IBMMOD=0

# default print level
IPRINT=0

#
# Does 'echo' understand escapes?
#
echo_style=sysv
if [ "	" = "`echo '\t'`" ]; then
   echo="echo"
else
   echo="echo -e"
fi
#
# Layout
col_spacing=4
col_sep=","
row_sep=";"

}

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   General purpose functions (MAINLY LAYOUT)
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

append () {
# Append $2 to the variable with the name $1
# TODO: Should also escape single quotes in input
  if [ -z "$1" ]; then
    eval "$1='$2'"
  else
    eval "headval=\$$1"
    eval "$1='$headval $2'"
  fi
}

str_len () {
# Determines the length of the longest string in a list
  local max_len=0
  local item=
  local var_name=
  local list=
  local OLD_IFS=$IFS

  IFS=$row_sep
  if [ -z $2 ]; then
    var_name="1"
  else
    var_name=$2
  fi

  for list in $1; do
    IFS=$col_sep
    set -- $list
    eval "item=\$$var_name"
    if [ ${#item} -gt $max_len ]; then
      max_len=${#item}
    fi
  done
  IFS=$OLD_IFS
  return $max_len
}

list_len () {
# returns the length of a list
  local counter=0
  local OLD_IFS=$IFS
  if [ -z $2 ]; then
    local counter=0
  else
    local counter=$2
  fi
  IFS=$row_sep
  for item in $1; do
    let "counter=$counter + 1"
  done
  IFS=$OLD_IFS
  return $counter
}

blank () {
# Adds $1 blanks to a line.
  local counter=0
  local tmp=""
  while [ $counter -lt $1 ]; do
    let "counter=$counter+1"
    tmp="$tmp "
  done
# Adds all blanks at the same time for performance
# Is there a way to surpress immediate refresh of the terminal window?
#   One solution is to build a complete string of every line
#   and print it only to screen when it's completely finished.
  $echo "$tmp\c"
}

get_item (){
# gets an item from a list
# Arguments 1. The list
#           2. Variable in which the arguments are space delimited put.
#           3. The index to be found
#           4. (Optional) the index of the first item.


  local OLD_IFS=$IFS
  local item=
  local list=

  if [ -z $4 ]; then
    local counter=1
  else 
    local counter=$4
  fi
  
  eval "$2=\"\""
  IFS=$row_sep
  for list in $1; do
    if [ $counter -eq $3 ]; then
      IFS=$col_sep
      for item in $list; do
        eval "$2=\"\$$2 $item\""
      done
      break
    fi
    let "counter=$counter+1"
  done
  IFS=$OLD_IFS
}

remove_item() {
# 1. List
# 2. Item

local list_name="$1"
local old_list=
eval "old_list=\"\$$1\""
local new_list=
local del_list="$2"
local OLD_IFS="$IFS"

IFS="$row_sep"
for item in $old_list; do 
  keep_item=1
  IFS="$row_sep"
  for rm_item in $del_list; do
    IFS="$col_sep"
    set -- $rm_item
    item_1=${item%%$col_sep*}
    item_2=${item#$item_1*$col_sep}
    item_2=${item_2%%$col_sep*}
    if [ "$item_1" = "$1" -a "$item_2" = "$2" ]; then 
      keep_item=0
    fi
  done
  if [ $keep_item -eq 1 ]; then
    new_list="$new_list $item$row_sep"
  fi
done
eval "$list_name=\"$new_list\""
IFS="$OLD_IFS"
}

add_item() {
# 1. List
# 2. Item
# 3. Indices
local old_list=
eval "old_list=\"\$$1\""

local new_list="$old_list"
list_len "$old_list" 
local counter=$?
local add_default=
eval "add_default=\"\$$3\""
local OLD_IFS="$IFS"

IFS="$row_sep"
for item in $2; do
  let "counter=$counter+1"
  new_list="$new_list $item$row_sep"
  add_default="$add_default $counter"
done
eval "$1=\"$new_list\""
IFS="$OLD_IFS"
eval "$3=\"$add_default\""
}

print_list() {
# Prints an array delimited by $row_sep and $col_sep.
# Arguments: 1. The list
#            2. (Optional) starting index.
# Make local copies of the lists
  local list="$1"
  local OLD_IFS=$IFS

# Get the widths of both columns
  str_len "$list" 1
  local size=$?
  str_len "$list" 2
  local size_2=$?

  let "size=$size+$col_spacing"
  let "size_2=$size_2+$col_spacing"
  
# Set the first index of the list
  if [ -z "$2" ]; then
    local counter=0
  else
    local counter=$2
  fi

# The actual printing...
# (Here we have the possibility to make the layout terminalsize dependent.
#  The system variable $COLUMNS needs to be queried to do this.)
  IFS=$row_sep
  for item in $list; do
    let "counter=$counter + 1"
    IFS=$col_sep
    set -- $item
    IFS=$OLD_IFS
    tmp=`echo $1 | sed "/^ /d"`
    if [ "$counter" -lt 10 ]; then 
      $echo "$counter)  $tmp\c"
    else
      $echo "$counter) $tmp\c"
    fi

    index=${#1}
    let "index=$size - $index"
# Add blanks till we are aligned at the second column
    blank $index
# Get the corresponding item in the second list
# Print the item in the second list
    tmp=${2:1}
    $echo "($tmp)\c"

    if [ -n "$3" ]; then
      index=${#2}
      let "index=$size_2 - $index"
      blank $index
      tmp=${3:1}
      $echo "--> $tmp <--\c"
    fi
    $echo ""
  done
  IFS=$OLD_IFS
}

search_libs() {
#
# Searches for libraries in the directories of dirlist
# Arguments: 1. variable to store found libraries in. 
#            2. List of directories to search in.
#            3. List of library names.
#            4. (Optional) list of extensions
#
  local tmp_libs=
  eval "tmp_libs=\"\$$1\""
  
  if [ $IPRINT -ge "8" ]; then
      echo 'search_libs:  dir_list=' $2
      echo 'search_libs:  lib_list=' $3
      echo 'search_libs:  ext_list=' $4
  fi
  
  if [ -z "$4" ]; then
    local ext_list=".a .so"
  else
    local ext_list="$4"
  fi

  for test_lib in $3; do
    for test_dir in $2; do
      for ext in $ext_list; do
        if test -f $test_dir/$test_lib$ext; then
	  tmp_libs="$tmp_libs $test_lib$col_sep $test_dir$row_sep"
	  break
        fi
      done
    done
  done
  eval "$1=\"$tmp_libs\""
if [ $IPRINT -ge "8" ];  then
 echo 'search_libs: accumulated lib_names='$tmp_libs
fi
}

question () {
# Wondering whether this is usefull to generalize...
# Arguments
# 1 answer
# 2 What
# 3 list
# 4 extra options
# 5 default value
# 6 (optional) multiple returnvalues
# 7 (optional) text before question
  
  local OLD_IFS=$IFS
  list_len "$4" 
  local start_n=$?
  let "start_n=$start_n-1"
  local default=""
  local answer=

  if [ -n "$3" ]; then 
    $echo "The following $2 were detected on your system: \n"
  else
    $echo "\nNo $2 were detected on your system: \n"
  fi
  print_list "$3" $start_n
  IFS=$row_sep
  local index=$start_n
  for item in $4; do
    IFS=" "
    $echo "$index) $item\t\c"
    let "index=$index - 1"
  done
  $echo "\n"
  if [ -n "$7" ]; then 
    $echo "$7"
    $echo ""
  fi
  $echo "Which one do you want to use? \c"
  list_len "$3"
  let "max_item=$?+$start_n"
  for item in $5; do
    let "item=$item+$start_n"
    if [ 0 -le $item -a $item -le $max_item ]; then
      default="$default $item"
    fi
  done
  if [ -z "$default" ]; then
    if [ -n "$6" ]; then
      local tmp_n
      let "tmp_n=$start_n+1"
      default=" $tmp_n"
      let "tmp_n=$tmp_n+1"
      default="$default $tmp_n"
    else 
      local tmp_n
      let "tmp_n=$start_n+1"
      default=" $tmp_n"
    fi
  fi
  if [ -n "$6" ]; then
    $echo "(More than one possible. Default:$default)\t\c"
  else
    $echo "(Default:$default)\t\c"
  fi
  read answer
  if [ -z "$answer" ]; then
    answer="$default"
  fi
  for item in $answer; do
    if [ 0 -gt $item -o $item -gt $max_item ]; then
      $echo "$item is not a valid choice for $2. Please pick another."
      question "$1" "$2" "$3" "$4" "$5" "$6" "$7"
    fi
  done
  eval "$1=\"$answer\""
  IFS=$OLD_IFS
}

usage ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Give usage of script
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
   echo 'Usage: '$0' [Flags]'
   echo ' Flags:'
   echo '   --help                       : Print this'
   echo '   --quick                      : Do not prompt user (WARNING: might prepare wrong Makefile.config!)'
   echo '   --noopt                      : Use compilers flags without optimization for the compilation of Dirac'
   echo '   --system=SYSTEM-ID           : Set system to SYSTEM-id'
   echo '   --f90=F90                    : Set fortran compiler to F90'
   echo '   --cc=CC                      : Set C compiler to CC'
   echo '   --parallel(par)[=(yes|no)]   : Parallel version of Dirac'
   echo '   --libdir=DIR                 : Add directory DIR to the search list for mathematical libraries'
   echo '   --math_lib=MATH_LIB          : Choose the mathematical library MATH_LIB'
   echo '   --memory-size=MEM-SIZE       : Set memory size to MEM-SIZE words'
   echo '   --install-directory=INST-DIR : Set install directory to INST-DIR'
   echo '   --scratch-directory=SCR-DIR  : Set work directory to SCR-DIR'
   echo '   --i=PRINT-LEVEL              : Set the print (verbose) level for the script to PRINT-LEVEL (default 0)'
}

guess_system ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#  GUESS SYSTEM
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
if [ -z "$guess" ]; then
   guess=`./config.guess`
   if [ "$guess" = "" ]; then
      guess=`./config.status ARCH`
   fi
fi

guess=`./config.sub $guess 2>/dev/null`

echo
$echo "Configuring for $guess (can be changed with --system)"
if echo "$guess" | grep -q x86_64; then
    echo "Note: For 32 bit code generation use --system="`echo "$guess"|sed s/x86_64/i686/`
fi
flavor=$guess
machine=`echo $guess | sed 's/-[^-]*$//'`
if [ "$machine" != "$guess" ]; then 
   os=`echo $guess | sed 's/.*-//'`
else 
   os=
fi

$echo "=> Machine             : $machine"
$echo "=> Operating system    : $os"
#
#  Set search list for libraries,
#  always libatlas first and libblas last.
#  In the middle machine specific optimized libraries are included.
#  Also make search lists for fortran and C compilers.
#  Define default C compiler.
#

case $machine in
   *-ibm | powerpc64-unknown-linux* | ppc64*| mips*-sgi | i[3-6]86-* | *apple* | sparc-sun| m68k-sun | *-hp | alpha-dec|mips-dec|alphaev6-dec ) 
     bit_set="32";;
   x86_64-* | ia64-unknown-linux | *-cray )
     bit_set="64";;
   *)
      echo "System $guess is currently .NOT. supported"
      echo "First try to update config.guess and config.sub "
      echo "  check libtools at http://www.gnu.org"
      echo "Then please report to dirac-admin@chem.sdu.dk"
      echo "Also include the command: "
      $echo "\t\`uname -m\` , \`uname -r\` , \`uname -s\` and \`uname -v\` "
      $echo "\tYou may also recommend compilerflags," 
      $echo "\tpreferred fortran compiler and mathematical libraries" \
            "available."
      exit 1

esac

#
#  Modify for SGI that may have both 32 and 64 bit architectures
#
if [ "$machine" = "mips64-sgi" ]; then
   dir_list="/usr/lib64 $dir_list"
elif [ "$machine" = "mips-sgi" ]; then
   dir_list="/usr/lib64 /usr/lib32 $dir_list"
fi

if [ $IPRINT -ge "5" ];  then 
    echo
    echo 'guess_system: variable dir_list=' $dir_list
fi
echo
}


parallel_stuff ()  {
echo
echo 'PARALLEL'
echo
if [ -z "${par}" ]; then
  if [ $quick = 0 ]; then
    $echo 'Do you want to install the program'\
    'in a parallel version, using MPI? (y/N) \c'
    read par
  else
    par=no
  fi
  case "$par" in
  "yes" | "y" | "Y" )
    par="yes" ;;
  "no" | "n" | "" )
    par="no" ;;
  *)
    parallel_stuff ;;
  esac
fi

echo '=> Parallel version: '${par}''
if [ "$par" = "yes" ]; then

  $echo 'Will your nodes use local disks? (y/N) \c'
  read localdisks
  case "$localdisks" in
  "yes" | "y" | "Y" )
    localdisks="yes"
    ;;
  *)
    localdisks="no"
    ;;
  esac

  echo '=> - with local disks for each node: '${localdisks}''

#
#  Parallel architectures are difficult, better warn the user
#
   echo
   echo "Makefiles for parallel architecture are difficult to guess"
   echo "Please always compare the generated Makefile.config with local documentation."

#
#  Determine message passing protocol to be used
#
   if [ -z "${mesp}" ]; then
      mesp="mpi"
   fi
   echo '=> Parallel message passing: '$mesp
#
#  Check whether we have a parallel compiler available
#
   if [ "$mesp" = "mpi" ]; then
      case $machine in
         *-ibm | powerpc64-unknown-linux* | ppc64* )
            parlib='no'
            parinc='yes'
            mpirun='poe'
            ;;
         *-hp)
            parlib='no'
            parinc='yes'
            mpirun='mpirun'
            ;;
         *-dec)
            parlib='yes'
            parinc='yes'
            mpirun='dmpirun'
            ;;
         i[3-6]86-* | x86_64-* | ia64-unknown-linux)
            parlib='yes'
            parinc='yes'
            mpirun='mpirun'
            ;;
         *)
            parlib='yes'
            parinc='yes'
            mpirun='mpirun'
            ;;
      esac

   fi
#
# MPI questions after we fixed the compiler
#
#  Ask for machine file
#
   if [ $quick = 0 ]; then
      $echo 'Specify default machinefile for MPI runs: (filename) (default: $PBS_NODEFILE): \c'
      read mach_file
      if [ -z "$mach_file" ]; then
         mach_file='$PBS_NODEFILE'
      fi
   else
      mach_file=
   fi
#
#  With local disks set remote copy/shell:
#
   rsh=rsh
   rcp=rcp
   if [ "$localdisks" = "yes" ]; then
     if [ $quick = 0 ]; then
       $echo 'Remote shell/copy for passing files to local disks (rsh/ssh) (default: rsh): \c'
       read rsh
       case "$rsh" in
	 "ssh")
            rsh=ssh
            rcp=scp
            echo 'Note that ssh/scp requires use of ssh-keygen without password !'
	    ;;
	 *)
            rsh=rsh
            rcp=rcp
	    ;;
       esac
     fi
   fi
else
   mesp='dummy'
   mach_file=
   rsh=rsh
   rcp=rcp
fi
echo
}

safeflags_stuff() {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#       Take care of safe flags (ie no optimization) if set up in the
#  'configure' argument list
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
if [ $nooptim = 1 ]; then
  echo
  echo  'COMPILERS FLAGS set without the optimization => quick compilation of the DIRAC code.'
  echo
fi
}

mpi2check () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#  Check if MPI-2 is installed
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
if [ "$mesp" = "mpi" ]; then
  mpi2version="yes"
  case $F90_COMP_NAME in
    xlf*|mpfort|mpxlf_r) comptst="$F90_COMP -WF,-DSYS_$sys_name" ;;
    *) comptst="$F90_COMP -DSYS_$sys_name" ;;
  esac
# gfortran needs -fcray-pointer flag for POINTER statements in MPI2_test.F
  case $F90real in
    gfortran) comptst="$comptst -fcray-pointer" ;;
  esac

 $echo "\nChecking if a MPI-2 version is installed:"
  echo "   $comptst ./test/MPI2_test.F"
  mpi2version="yes"
  $comptst ./test/MPI2_test.F 2>/dev/null || mpi2version="no"
  rm -f a.out
  if [ "$mpi2version" = "no" ]; then
    echo  " "
    echo  "Hmm. Failed to find support for MPI-2 in your installation.  "
    echo  " "
    echo  "If you think this is incorrect, in the following question    "
    echo  "press 'y' to configure with MPI-2 support, and add manually  "
    echo  "any missing paths to your MPI-2 installation."
    echo  " "
    echo  "Please note that the functionality from the following DIRAC "
    echo  "modules will NOT be available without MPI-2 support: "
    echo  " "
    echo  "    - LUCITA                   "
    echo  "    - LUCIAREL                 "
    echo  "    - KR-MCSCF using LUCIAREL  "
    echo  "    - MOLTRA with parallel I/O (helpful for global/shared scratch spaces)"
    echo  " "
    $echo "Configure with MPI-2 support anyway? (y/N) \c"
    read mpi2version
    if [ "$mpi2version" = "y" ]; then
	mpi2version=yes
	echo "OK. Remember to add MPI2 paths to Makefile.config if necessary !!!"
    fi;
  fi
  if [ "$mpi2version" = "yes" ]; then
    echo "=> MPI-2 is available."
    cpp_cc="$cpp_cc -DVAR_MPI2"
    cpp_f90="$cpp_f90 -DVAR_MPI2"
  fi
fi

if [ $IPRINT -ge "7" ];  then 
  echo '... after mpi stuff' 
fi
} # END mpi2check ()


find_mpi_path () {
$echo "\nDETECTION OF MPI LIBRARIES.\n"
case $F90_COMP in
  *mp*) 
    echo "Found a mpi compiler. No further searching for mpi libraries."
    parlib=""
    parinc=""
    return 0;;
esac

pardir=$dir_list
incdir='/usr/include /usr/local/include /local/include'
#  Modify for RS6000K where mpi.h is placed in some obscure directory
if [ "$machine" = "*-ibm" ]; then
  incdir="$incdir /usr/lpp/ppe.poe/include"
fi
parlib_pwd=
#
#  MPI settings, first we do the mpi-library
#
if [ "$parlib" = "yes" -a "$mesp" = "mpi" ]; then
  parlib=""
  search_libs parlib "$pardir" "libmpi libmpich" ".a .so .so.0" 
  if [ -n "$parlib" ]; then
    question lib_index "mpi_libraries" "$parlib" " Specify the root of the mpi directory. $row_sep Configure libraries manually."

    if [ $lib_index -eq 0 ]; then
      $echo "No mpi libraries are included at this moment."
      $echo "To add the libraries yourself edit Makefile.config manually!"
      return 0
    elif [ $lib_index -eq 1 ]; then
      $echo ""
    elif [ -n $lib_index ]; then
      get_item "$parlib" parlib $lib_index 2
      set -- $parlib
      parlib_pwd=$2
      parlib='-lmpi'
    fi
  fi
 
# jhs could be changed in a while loop in case of typo's
  if [ -z "$parlib" ]; then
    echo "Please enter the directory containing your mpi libraries:"
    read mpi_lib
    search_libs parlib "$mpi_lib $mpi_lib/lib" "libmpi libmpich" ".a .so .so.0" 
    if [ -n "$parlib" ]; then
      get_item "$parlib" parlib 1
      set -- $parlib
      parlib=-lmpi
      parlib_pwd=$2
    else 
      $echo "Not a valid mpi library found. Please edit Makefile.config manually!"
      parlib=""
      parlib_pwd=""
    fi
  fi
  if [ -z "$parlib" ]; then
    echo 'Parallel library: none'
  else
    echo "Parallel library: $parlib ($parlib_pwd)"
  fi
  echo
fi
if [ "$parinc" = "yes" -a "$mesp" = "mpi" ]; then
#
#     Now we try to find an include directory
#
  parinc=""
  if [ -n "$parlib" ]; then
    tmp_dir=${parlib_pwd%/*}
    if [ -f $tmp_dir/include/mpif.h ]; then
      echo "Included mpif.h file: $tmp_dir/mpif.h"
      parinc="-I$tmp_dir/include/mpif.h"
    fi
    tmp_dir=${tmp_dir%/*}
    if [ -f $tmp_dir/include/mpif.h ]; then
      echo "Included mpif.h file: $tmp_dir/mpif.h"
      parinc="-I$tmp_dir/include/mpif.h"
    fi
    if [ -z "$parinc" ]; then
      echo "Please enter the directory containing your mpi include file (mpif.h):"
      read parinc
      if [ -f "$parinc/mpif.h" ]; then
        parinc="-I$parinc/mpif.h"
      else
        parinc=""
      fi
    fi
  fi

  if [ -z "$parinc" ]; then
    echo "Include file 'mpif.h' not found. Please edit Makefile.config manually!."
    echo 'Parallel include: none'
  else
    echo 'Parallel include:'$parinc
  fi
fi
if [ "$parlib" = "no" ]; then
  parlib=
fi
#
echo ""
}  # end of "find_mpi_path ()"


find_compilers () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Find compilers
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo 'COMPILER'
echo

compiler_fortran
compiler_c

}

compiler_fortran(){
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#            Sets up the fortran compiler
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
# all supported fortran compilers
comp_list='ifort ifc g95 g90 gfortran gfortran-4.2 gfortran-4.3 pgf90 lfc f90 xlf_r xlf efc cf90 pathf90'
# Prefer "parallel" compilers if mpi
if [ "$mesp" = "mpi" ]; then
  comp_list="mpfort_r mpfort mpxlf_r mpxlf openmpif90 mpif90 mpif77 $comp_list"
fi
find_compiler "Fortran" $F90_COMP_NAME
F90_COMP_NAME=$comp_found
F90_COMP=${comp_pwd}${comp_found}

if [ $IPRINT -ge "5" ];  then
 echo 'compiler_fortran: found F90 compiler ' $F90_COMP
fi

}

compiler_c(){
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Set up the c compiler
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

# All supported C compilers
comp_list='icc gcc gcc-3.3 pgcc pathcc cc ecc xlc_r xlc xlc'
if [ "$mesp" = "mpi" ]; then
  comp_list="mpcc_r mpcc openmpicc mpicc $comp_list" 
fi
find_compiler "C" $CC_COMP
CC_COMP_NAME=$comp_found
CC_COMP=${comp_pwd}${comp_found}

if [ $IPRINT -ge "5" ];  then
  echo ''
  echo 'compiler_c: comp_found='$comp_found
  echo 'compiler_c:   comp_pwd='$comp_pwd
  echo 'compiler_c: got CC_COMP='$CC_COMP
fi

}

old_compiler () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#     Find out compiler in old Makefile.config (ie previous installation)
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
case "$2" in
  "Fortran")
    old_comp=`./config.status "F90"` ;;
  "C")
    old_comp=`./config.status "CC"` ;;
esac

if [ $IPRINT -ge "7" ];  then
  echo ' '
  echo 'old_compiler: for '$2' got old_comp='$old_comp
fi

# miro: this assumes compiler with the full path !
old_pwd=${old_comp%/*}
old_comp=${old_comp##*/}

if [ $IPRINT -ge "7" ];  then
  echo 'old_compiler: set old_comp='$old_comp
  echo 'old_compiler: set  old_pwd='$old_pwd
fi


if [ -n "$old_comp" ]; then 
  eval "$1=\" $old_comp$col_sep $old_pwd$col_sep Previous installation$row_sep\"" 
fi
}

find_compiler ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Finds compilers from a list 
#   Argument $1 : The name of the compiler to be found
#                (for messages to the user)
#   Argument $2 : User preferred compiler
#   comp_list   : Contains the compilers
#   Here we return comp_set
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
local to_find=$1
local default=
comp_found=""
comp_pwd=""


old_compiler old_comp "$to_find"
search_dirs=`echo "$PATH"|sed 's/:/ /g'`
# BASH: search_dirs=${PATH//:/ }
# Which doesn't work on mac!
if [ ! -z "$2" ]; then
  local tmp_list=$comp_list
  if [ -f "$2" ]; then
    comp_found=$2
    comp_pwd=""
    echo "Compiler for $to_find: $comp_found"
    return 0
  else
    echo "Compiler specified with --f90 not found"
    echo "Compiler: $2"
    echo "Checking for the standard compilers."
  fi
fi

for comp in $comp_list; do
# Only search in $PATH
  for cur_dir in $search_dirs; do
    if [ -f $cur_dir/$comp ]; then
      comp_found="$comp_found $comp$col_sep $cur_dir$row_sep"
    fi
  done
done

if [ -n "$old_comp" ]; then
  remove_item comp_found "$old_comp"
  add_item comp_found "$old_comp" default
fi

if [ -z "$comp_found" ]; then
  $echo "\n   No $to_find compiler found on this computer"
  echo  "   Cannot proceed without a Fortran compiler in path"
  echo  "   Please check your path! "
  echo  " Or specify a compiler manually: "
#  exit 
fi

question comp_index "$to_find compilers" "$comp_found" " Specify compiler manually" "$default"

if [ $comp_index -eq 0 ]; then
    echo ""
    echo "Note that compiler flags may not be set correctly."
    echo "Check Makefile.config afterwards !"
    echo ""
    $echo "Enter your compiler:\c"
    read comp_found
    # jhs userinput instead of exit?    echo 'jhs Userinput here?'
else
    get_item "$comp_found" comp_found $comp_index 1
    set -- $comp_found
    comp_found=$1
    comp_pwd=$2
fi

if [ ! -z "$comp_pwd" ]; then
  if [ "$comp_pwd" != "/" ]; then
    comp_pwd="$comp_pwd/"
  fi
fi 
$echo "Compiler for $to_find: $comp_found\n"
}

find_real_f90(){
#
# Find the underlying compiler for fortran mpi compilers
#
case "$F90_COMP_NAME" in
openmpif*|mpif*)
   if "$F90_COMP" -show > /dev/null; then
      # MPICH
      mpishowopt="-show"
   else
      # LAM MPI
      mpishowopt="-showme" 
   fi
   my_mpi_include_path=`$F90_COMP $mpishowopt | grep mpif.h | sed -e 's/ln -s //' | sed -e 's/mpif.h//g'|grep include`
   if "$F90_COMP" $mpishowopt | grep -q ifc; then
      F90real=ifc
   elif "$F90_COMP" $mpishowopt | grep -q ifort; then
      F90real=ifort
   elif "$F90_COMP" $mpishowopt | grep -q gfortran; then
      F90real=gfortran
   elif "$F90_COMP" $mpishowopt | grep -q pathf90; then
      F90real=pathf90
   elif "$F90_COMP" $mpishowopt | grep -q pgf90; then
      F90real=pgf90
   elif "$F90_COMP" $mpishowopt | grep -q lfc; then
      F90real=lfc
   elif "$F90_COMP" $mpishowopt | grep -q g95; then
      F90real=g95
   else 
      F90real=$F90_COMP
   fi
   echo "Compiler in $F90_COMP found to be $F90real ..."
   ;;
mpxlf|mpxlf_r)
   F90real=xlf
   echo "Compiler in $F90_COMP found to be $F90real ..."
   ;;
*)
   F90real=$F90_COMP_NAME;;
esac   
}

find_real_cc(){
case "$CC_COMP_NAME" in
openmpicc| mpicc)
   if $CC_COMP -show 2>&1 /dev/null; then
      # MPICH
      mpishowopt="-show"
   else
      # LAM MPI
      mpishowopt="-showme" 
   fi
    if $CC_COMP_NAME $mpishowopt | grep -q icc; then
      CCreal=icc
   elif $CC_COMP_NAME $mpishowopt | grep -q pathcc; then
      CCreal=pathcc
   elif $CC_COMP_NAME $mpishowopt | grep -q pgcc; then
      CCreal=pgcc
   elif $CC_COMP_NAME $mpishowopt | grep -q gcc; then
      CCreal=gcc
   else 
      CCreal=$CC_COMP_NAME
   fi
   echo "Compiler in $CC_COMP_NAME found to be $CCreal ..."
   ;;
*)
  CCreal=$CC_COMP_NAME
  ;;
esac   
echo
}


find_debugger(){
###############################################################
#
#   search for debugger and put "the best" into pam
#
###############################################################

if [ $IPRINT -ge "8" ]; then
   echo ''
   echo 'find_debugger...looking for debuggers'
fi

debug='dbx'
which_debug=''
# jhs Tmpfix for non-unix sytems

a=`which which 2>&1`
if [ $IPRINT -ge "8" ]; then
  echo 'find_debugger: variable a='$a
fi


if [ ! -z "$a" ]; then

  if [ $IPRINT -ge "8" ]; then
    echo 'find_debugger - priority look for present debuggers'
  fi

  ### looking priority: idb, pgdbg, dbx, gdb ....
  if [ ! -z `which idb 2>/dev/null` ]; then
    which_debug="idb"
  elif [ ! -z `which pgdbg 2>/dev/null` ]; then 
    which_debug="pgdbg"
  elif [ ! -z `which dbx 2>/dev/null` ]; then 
    which_debug="dbx"
  elif [ ! -z `which gdb 2>/dev/null` ]; then 
    which_debug="gdb"
  fi
fi

if [ $IPRINT -ge "8" ]; then
  echo 'find_debugger: which_debug='$which_debug
fi

if [ -z $which_debug ]; then
  case $machine in
     i[3-6]86-*|x86_64-*|ia64-unknown-linux|*apple*)
        debug="gdb"
     ;;
  esac
else
  debug=$which_debug
fi

if [ -z "$debug" ]; then
   $echo "\nDebugger not set ! Add it into pam manually"
else
   $echo "\nAssigned DEBUGGER (check it in the pam script): "$debug
fi
echo

}

setup_math_lib(){

  if [ $IPRINT -ge "5" ];  then
    echo 'setup_math_lib: entering param lib, 1='$1
    echo 'setup_math_lib: entering param dir, 2='$2
  fi

  case "$1" in
    libesslp2) append LIB "-L$2 -lesslp2";;
    libessl) append LIB "-L$2 -lessl";;
    libblas) append LIB "-L$2 -lblas" ;;
    liblapack) append LIB "-L$2 -llapack" ;;
    libatlas) append LIB "-L$2 -llapack -lcblas -lf77blas -latlas";;
    libdxml) append LIB "-L$2 -ldxml";;
    libcomplib.sgimath) append LIB "-L$2 -lcomplib.sgimath";;
    libveclib) append LIB "-L$2 -lveclib";;
    libmath) append LIB "-L$2 -lmath -lm -nx";;
    libmkl) append LIB "-L$2 -lmkl_lapack -lguide -lpthread -lmkl"
            optblas=$2;;
    libmkl_ipf) append LIB "-L$2 -lmkl_lapack -lmkl_ipf -lguide -ldl "
                      optblas=$2;;
    libmkl_itp) append LIB "-L$2 -lguide -lpthread -lmkl_itp"
                      optblas=$2;;
  esac

  if [ $IPRINT -ge "5" ];  then
    echo 'setup_math_lib: setup variable LIB='$LIB
  fi
  
  test_lib_arch $2
  if [ 0 -eq $? ]; then
    echo "System is $bit_set-bit, but the mathematical libraries are probably not." 
    echo "Libraries: $2/$1"
    $echo " Do you still want to use these libraries (y/N)?"
    read use_blas
    case "$use_blas" in
      "yes" | "y" | "Y" ) ;;
      *)
        $echo "Please specify the libraries again."
        lib_names=""
        lib_dirs=""
        get_math_lib ;;
    esac
  fi
}

get_math_lib(){
# Try different versions and see how fast they are.

# 1. Get a list of directories
#    Test for every directory whether a library exists.

# 2. Get list of libraries.
#    Grep for the mathematical library names.
#    Split the found libs into a directory path, and a name.

# Initialize global variables
LIB=""

libs=" dirac blas$col_sep builtin$row_sep"
libs="$libs dirac lapack$col_sep builtin$row_sep"

old_lib lib_guess
search_libs libs "$math_dirs" "$lib_list"
list_len "$libs"
max_lib=$?

default=""
if [ -n "$lib_guess" ]; then
  remove_item libs "$lib_guess"
  add_item libs "$lib_guess" default
fi
# If there is found more than one compiler let the user pick it.


if [ $IPRINT -ge "5" ];  then
 echo '\n get_math_lib: lib_names='$lib_names
fi

question lib_index "mathematical libraries" "$libs" " Specify a library path to search $row_sep Configure libaries manually." "$default" "y" "You need to specify a BLAS AND a LAPACK routine.\nThere are blas and lapack implementations shipped with dirac.\nHowever they are VERY SLOW compared to optimized libraries."

for index in $lib_index; do 
  if [ $index -eq 0 ]; then
    $echo "No libraries are included at this moment."
    $echo "To add the libraries yourself edit Makefile.config manually!"
    break
  elif [ $index -eq 1 ]; then
    $echo "Enter a directory to search: \c"
    read math_dirs
    $echo "Also search it's subdirectories? (y/N) \c"
    read rec_search

    echo
    echo "Building a list of subdirectories of: $math_dirs ... "
    if [ ! -z "$math_dirs" ]; then
      case $rec_search in
      "yes" | "y" | "Y" )
        math_dirs=`find $math_dirs -type d -print`;;
      esac
    fi
    get_math_lib
  elif [ $index -eq 2 ]; then
    $echo "Default BLAS used."
    append cpp_f90 "-DUSE_DIRAC_BLAS"
  elif [ $index -eq 3 ]; then
    $echo "Default LAPACK used."
    append cpp_f90 "-DUSE_DIRAC_DLAMCH -DUSE_DIRAC_DLAPACK -DUSE_DIRAC_ZLAPACK"
  elif [ ! -z $index ]; then
    get_item "$libs" lib_name $index 2
    set -- $lib_name
    setup_math_lib $1 $2
  fi
done
}

test_lib_arch() {
#
# Check whether the libraries are 32/64 bit
#

if [ $bit_set -eq 32 ]; then
  if [ -z `echo $1 |  grep "64"` ]; then
    return 1
  else
    return 0
  fi
fi

if [ $bit_set -eq 64 ]; then
  if [ -n `echo $1 |  grep "64"` ]; then
    return 1
  else
    return 0
  fi
fi

}

nolib () {
   echo  Sorry, linking test program to $LIB failed.
   LIB=
}

old_lib () {
# Gets old libraries from Makefile.confi
return_libs=""
old_libs=`./config.status "LIBS"`
#throw away junk and front junk
if [ -z "$old_libs" ]; then return 0; fi
old_libs=${old_libs#*-L}
old_libs="$old_libs -L"

while [ -n "$old_libs" ]; do
  tmp_libs=${old_libs%%-L*}
  tmp_libs=${tmp_libs## }
  tmp_libs=${tmp_libs%% }
  old_libs=${old_libs#*-L}

  lib_pwd=${tmp_libs%% *}
  tmp_libs=${tmp_libs#$lib_pwd }

# Undo setup_math_lib routine
  case "$tmp_libs" in
    "-lesslp2") lib_name="libesslp2" ;;
    "-lessl") lib_name="libessl" ;;
    "-lblas") lib_name="libblas" ;;
    "-llapack") lib_name="liblapack" ;;
    "-llapack -lcblas -lf77blas -latlas") lib_name="libatlas" ;;
    "-ldxml") lib_name="libdxml";;
    "-lcomplib.sgimath") lib_name="libcomplib.sgimath" ;;
    "-lveclib") lib_name="libveclib" ;;
    "-lmath -lm -nx") lib_name="libmath";;
    "-lmkl_lapack -lguide -lpthread -lmkl") lib_name="libmkl";;
    "-lmkl_lapack -lmkl_ipf -lguide -ldl") lib_name="libmkl_ipf";;
    "-lguide -lpthread -lmkl_itp") lib_name="libmkl_itp" ;;
  esac
  return_libs="$return_libs $lib_name$col_sep $lib_pwd$col_sep Previous installation$row_sep"
done
eval "$1=\"$return_libs\""
}

find_mathlib ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Find mathematical libraries
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
$echo
$echo 'MATHEMATICAL LIBRARIES'
$echo
$echo 'The use of optimized BLAS and LAPACK routines implementation'
$echo 'is very important, especially for the performance of MOLTRA and RELCCSD.'
$echo
#
#  Check if use LIB_LIST from old Makefile.config
#
# libraries
ext_list='.so .a'
lib_list="$userlib libblas libatlas libesslp2 libessl libcomplib.sgimath libmkl libmkl_ipf libmkl_itp sunperf libveclib libdxml liblapack"
LIB=""
math_dirs=$dir_list

if [ $IPRINT -ge "5" ];  then
    echo 'find_math_lib: setup math_dirs='$math_dirs
fi

# variable telling that there are both lapack and blas libraries
# both_blas_lapack=


if [ -z "$LIB" ]; then
  get_math_lib
fi

if [ -z "$LIB" -a -n "$lib_list" ]; then
    echo 'Mathematical libraries: none found'
elif [ -n "$LIB" ]; then
    echo 'Mathematical libraries: '$LIB
fi
echo
}

set_memsize ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# Determine memory size
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo 'MEMORY SIZE'
echo
if [ -z "$memdef" ]; then
   #  ... extract from Makefile.config
   memdef=`./config.status WRKMEM`

   if [ $IPRINT -ge "8" ]; then
    echo 'set_memsize: from Makefile.config extracted memdef='$memdef
   fi

   if [ -z "$memdef" ]; then
      memdef=64000000
   fi

   if [ $IPRINT -ge "8" ]; then
    echo 'set_memsize:  assigned memdef='$memdef
   fi

   echo 'DIRAC uses approximately 6.4 MB for static allocations.'
   echo 'How many MB RAM to use as default?'
   echo ' -we do not recommend going below 64 MB'
   echo ' -note that memory use can be changed' \
        'through the shell variable DIRWRK'

   if [ $quick = 0 ]; then
      let "tmp=$memdef * 8/1048576"
      $echo "Memory size (in MB, default: $tmp MB) \c"
      read memsiz
   else
      memsiz=
   fi
   if [ -z "$memsiz" ]; then
      memsiz=$memdef
   else
      let "memsiz=$memsiz * 1048576 / 8"
   fi
else
   memsiz=$memdef
fi
}

set_installdir ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   set installdir
#   Determine location for executable and run script
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo 'INSTALL DIRECTORY'
echo

if [ $IPRINT -ge "7" ];  then
   echo 'set_installdir: variable INSTALL_DIR='$INSTALL_DIR
   echo 'set_installdir: variable quick='$quick
fi

if [ -z "$INSTALL_DIR" ]; then
     set_install_directory
else
   # verify entered (as parameter) installation directory
   if [ ! -d "$INSTALL_DIR" ]; then
     $echo "ERROR: $INSTALL_DIR (you typed as the paramater) does not exist \n "
     # no exit, rather repeat searching for the directory
     set_install_directory
   fi
fi

#-------------------------------------------------------------------
#     ... finally print-out the veryfied installation directory
#-------------------------------------------------------------------
$echo 'Install directory for DIRAC executable and script: '
$echo "$INSTALL_DIR\n"
}

set_install_directory () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#                     Determines the proper installation directory
#
#  always called when INSTALL_DIR(might come in as the parameter) is
#  not functional
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

   # first null the variable
   INSTALL_DIR=

   # repeat until directory found - test on empty
   while [ -z "$INSTALL_DIR" ]
   do
      # ... find out the variable which is in the Makefile.config file (if there is any)
      curr=`./config.status INSTALLDIR`
      if [ "$curr" = "$PWD" ]; then
	  curr=
      fi
      # ... if $curr not empty AND is valid directory
      if [ ! -z "$curr" -a -d "$curr" ]; then

         $echo 'Found (in Makefile.config) proper directory for installation of' \
         'binaries and scripts:'
	 $echo $curr
	 $echo 'Do you want me to use it ? (Y/n) \c'

	 default_answer="y"
         get_answer

	 if [ "$answer" = "n" ] ; then
            curr=`pwd`
	    $echo 'Do you want me to use current directory '$curr' ? (Y/n) \c'
	    default_answer="y"
            get_answer
	    if [ "$answer" = "n" ] ; then
	       $echo "Well, your choice, now type the directory:\c"
               read INSTALL_DIR
	    else
               INSTALL_DIR=$curr
	    fi
	 else
            INSTALL_DIR=$curr
         fi
      else
      # when the previously used directory "$curr" is no longer valid
         curr=`pwd`
         INSTALL_DIR=$curr
         $echo '...using the current directory (pwd) for DIRAC installation:'
         $echo $curr
      fi

      # verify install directory
      if [ ! -d "$INSTALL_DIR" ]; then
         echo "ERROR: $INSTALL_DIR does not exist, repeat getting it once again !"
         INSTALL_DIR=
         # ... continues within the "while" cycle
      fi

   done
echo
}

get_answer() {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#  usefull procedure to get (typed) the answer - yes or no
#
#  uses the variable "default_answer" which has to be "y" or "n" or empty
#
#  exports the "answer" variable cotaining "y" or "n"
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
# "global" variable
answer=
# ... local variable
this_answer=
# ... to check whether the answer was proper
answered=
while [ -z "$answered" ]
do
     read this_answer

     if [ $IPRINT -ge "12" ];  then
        echo 'get_answer: read variable this_answer='$this_answer
        echo 'get_answer: while variable default_answer='$default_answer
     fi

     # if answer empty and default_answer set
     if [ -z "$this_answer" -a "$default_answer" = "y" ]; then
        answer="y"
	answered="good"
     fi
     if [ -z "$this_answer" -a "$default_answer" = "n" ]; then
        answer="n"
	answered="good"
     fi

     if [ -z $answered ]; then
        case "$this_answer" in
         "yes" | "y" | "Y"  )
           answered="good"
           answer="y"      ;;
         "no"  | "n" | "N"  )
           answered="good"
           answer="n"      ;;
         *)
           answered=
           $echo '  please type the proper answer - yes/y/Y or no/n/N \c'
        ;;
        esac
     fi
done

 if [ $IPRINT -ge "12" ];  then
     echo 'get_answer: ASSIGNED variable answer='$answer
  fi
}

set_scratchdir ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#                   SET SCRATCHDIR
#
#   Determine the default scratch disk space for calculations
#
#   The "worksp" variable could come in within argument list
#
#   Likewise it can be extracted from the "Makefile.config" file
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo 'SCRATCH DIRECTORY'
echo

if [ -z "$worksp" ]; then
       get_worksp
else
   if [ ! -d $worksp -a $quick=0]; then
       echo 'Scratch directory '$worksp' you does not exist! Repeat !'
       get_worksp
   fi
fi

$echo 'Scratch directory: '$worksp'/$USER'
}


get_worksp ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#      get the 'worksp' variable
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

   scr_quick=$quick

   while [ -z "$worksp" ]
   do

      # first extract from Makefile.config
      scratchguess=`./config.status SCRATCH_DIR`
      if [ $IPRINT -ge "5" ];  then
         echo 'get_worksp: from Makefile.config extracted scratchguess='$scratchguess
      fi

      if [ ! -z "$scratchguess" ]; then
         worksp=$scratchguess # just assign, do not verify yet...
      elif [ -d '/work' ]; then
         worksp='/work'
      elif [ -d '/scratch' ]; then
         worksp='/scratch'
      elif [ -d '/scr' ]; then
         worksp='/scr'
      elif [ -d '/temp' ]; then
         worksp='/temp'
      elif [ -d '/tmp' ]; then
         worksp='/tmp'
      elif [ -d '/var/tmp' ]; then
         worksp='/var/tmp'
      else
         worksp=
         scr_quick=0 # nothing assigned, switch to PROMPT mode
      fi

      if [ $scr_quick = 0 ]; then # in the prompt mode

         if [ ! -z "$worksp" ]; then
           if [ ! -z "$scratchguess" ]; then
             $echo 'Found scratch space in the old Makefile.config: ' $worksp
           else
             $echo 'Found scratch space among the system directories: ' $worksp
           fi
           $echo 'Press ENTER to use this path, or type a new directory for the scratch: \c'
         else
           $echo 'No default directory found - type a new directory for the scratch: \c'
         fi

         read answer
      else
         answer=
      fi
      if [ ! -z "$answer" ]; then
         worksp=$answer
      fi

      # verify the work-directory, and/or confirm
      if [ ! -d $worksp ]; then
         echo 'WARNING: Scratch directory '$worksp' does not exist!'
         if [ $quick = 0 ]; then
            ok=
            while [ -z "$ok" ]; do
               $echo "- Are you sure that you want $worksp ? (Y/n) \c"
               read answer
               case "$answer" in
               "y" | "Y" | "yes" | "")
                  ok=xxx
                  ;;
               "n" | "N" | "no")
                  worksp=
                  ok=xxx
                  ;;
               esac
            done
         else
         # ... no prompt mode - check if worksp is empty...
            if [ -z $worksp ]; then
               worksp="ASSIGN ME"
               $echo "...you need to fix the scratch directory in Makefile.config..."
            fi
         fi
      fi
   done
}

get_cpp_flags(){

  if [ "$mesp" = "mpi" ]; then
    parop="-DVAR_MPI"
    if [ "$localdisks" = "yes" ]; then
       parop="$parop -DSYS_LOCALDISKS"
    fi

    append cpp_f90 "-DPRG_DIRAC -DSYS_$sys_name -DINSTALL_WRKMEM=\${WRKMEM} $parop"
    append cpp_cc "-DSYS_$sys_name -DINSTALL_WRKMEM=\${WRKMEM} $parop"
    def="dirmpi.x"
  else
    append cpp_f90 "-DPRG_DIRAC -DSYS_$sys_name -DINSTALL_WRKMEM=\${WRKMEM}"
    append cpp_cc "-DSYS_$sys_name -DINSTALL_WRKMEM=\${WRKMEM}"
    def="dirac.x"
  fi
  if [ ! -z "`echo $LIB | grep 'mkl'`" ]; then
    append cpp_f90 "-DVAR_MKL"
  fi
 
  set_bit_arch
}

set_bit_arch(){
# Special flags for 64 bit machines
  if [ "$bit_set" = "64" ]; then
    cpp_f90="-DINT_STAR8 $cpp_f90"
    cpp_cc="-DINT_STAR8 $cpp_cc"
# provide specific compiler with the appropriate integer flag
    case "$F90real" in
#
      g95|pgf90|ifc|ifort|pathf90)
         opt="$opt -i8"
         safe="$safe -i8" ;;
#
#   ... take care of gfortran, gfortran-4.2, gfortran-4.3 etc...
      gfortran-*|gfortran)
         opt="$opt -fdefault-integer-8"
         safe="$safe -fdefault-integer-8" ;;
#
#   .... take care of Lahey fortran
      lfc)
         opt="$opt --long"
         safe="$safe --long" ;;
    esac
  fi

if [ $IPRINT -ge "5" ];  then
 echo 'set_bit_arch: set opt='$opt
 echo 'set_bit_arch: set safe='$safe
fi

}

get_f90_flags(){
  case "$F90real" in
    g95)
      opt="-g -O3 -ffast-math -Wno=155"
      safe="-g -Wno=155"
      mod="-fmod=$MODULE_DIR"
      ;;
    gfortran*)
      gfver=`$F90real -v 2>&1 | awk '/^gcc version/{gsub("[^0-9]","", $3);print $3}'`
      cpp_f90="$cpp_f90 -DGFORTRAN=$gfver"
      case $prc in
      i[0-9]86) grep -qw sse2 /proc/cpuinfo 2> /dev/null && prc=pentium4
                march="-march=$prc -malign-double";;
      x86_64) march="-march=x86-64";;
      *) march="";;
      esac
      c_opt="-g -O3 -ffast-math -funroll-loops -ftree-vectorize -std=c99 -DRESTRICT=restrict -DFUNDERSCORE=1 $march"
      opt="-g -O3 -ffast-math -funroll-loops -ftree-vectorize $march"
#     gfortran needs flag -fcray-pointer if MPI-2 is enabled.
      if [ "$mpi2version" = "yes" ]; then
        $opt="$opt -fcray-pointer"
      fi
      safe="-g $march"
      mod="-J$MODULE_DIR"
      ;;
    pgf90)
      opt="-g -fastsse"
      safe="-g"
      cpp_cc="$cpp_cc -DVAR_PGCC"
      mod="-module $MODULE_DIR"
      ;;
    lfc)
      opt="-g --fast"
      safe="-g"
      cpp_cc="$cpp_cc"
      mod="-M $MODULE_DIR"
      ;;
    ifort)
      opt="-g -O3 -ip -w -assume byterecl"
      safe="-g -w -assume byterecl"
      cpp_cc="$cpp_cc -DVAR_IFC"
      mod="-module $MODULE_DIR"
      ;;
    xlf|xlf_r)
      mod="-qmoddir=$MODULE_DIR -I$MODULE_DIR"
     # .... extra flags for *.F90 files !
      f90_extraflags="-qfree=f90 -qsuffix=cpp=F90"
      ;;
    pathf90)
       ldflag="-g -O2 -m64 -march=athlon64 -mcpu=athlon64 -msse -msse2 -mtune=athlon64 -mcmodel=medium"
       cpp_cc="$cpp_cc -DVAR_EKO"
       mod="-module $MODULE_DIR"
       ;;
  esac

if [ $IPRINT -ge "5" ];  then
 echo 'get_f90_flags: got opt='$opt
fi

}

get_cc_flags(){
  case "$CCreal" in
  gcc|cc)
    c_opt="-g -O3 -ffast-math"
    c_safe="-g"
    ;;
  mpicc)
    c_opt="-g -O3 -ffast-math"
    c_safe="-g"
    echo
    echo WARNING:
    echo   Could not determine which compiler mpicc is using, assuming it is gcc
    echo
    ;;
  pgcc)
    c_opt="-g -fastsse"
    c_safe="-g"
    ;;
  icc)
    c_opt="-g -O3 -ip -w"
    c_safe="-g -w"
    ;;
  pathcc)
    c_opt=$opt
    c_safe=$safe
    ;;
  esac

# jhs some strange fortran dependent options:
  case "$F90real" in
  xlf)
    c_opt='-g -O2 -qcpluscmt'
    c_safe='-g -qcpluscmt'
    ;;
  esac

if [ $IPRINT -ge "5" ];  then
 echo 'get_cc_flags: got c_opt='$c_opt
 echo 'get_cc_flags: got c_safe='$c_safe
fi

}

get_largefiles(){
#
# Ask user whether the large file option can be set
#
  case $machine in
    i[3-6]86-* | x86_64-* | ia64-unknown-linux)
      if [ $quick = 0 ]; then
        $echo '\nCan your Linux/BSD system handle files longer than 2 GB ? (Y/n) \c'
        read largefiles
      else
        largefiles=Y
      fi
      case "$largefiles" in
      "yes" | "y" | "Y"|"" )
        cpp_cc="-D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE  -D_LARGEFILE64_SOURCE $cpp_cc"
      ;;
      esac ;;
    esac
}

getmods()
{
    if [ -r Makefile.moddef ]; then
	egrep '^MODS=' Makefile.moddef | cut -c 6-
    else
	echo "Error, cannot find Makefile.moddef." >&2
	echo "Run pamadm to correct this problem. Quitting." >&2
	# Suicide is painless, it brings on many changes
	kill $$
    fi
}

set_compile_flags(){
echo

f90_inc="-I$INCLUDE_DIR"
cc_inc="-I$INCLUDE_DIR"
find_real_f90
get_f90_flags
cpp_cc=`getmods`

case $machine in
#
#  HEWLETT - PACKARD
#
    *-hp)
       sys_name="HPUX"
       get_cpp_flags
       arflag='rv'
       c_opt='-g +DA2.0W +O3 +Onolimit +Ofastaccess -AC99'
       c_safe='+DA2.0W -g -AC99'
       opt='-g +DA2.0W +O2 +U77 +Onolimit +Ofastaccess +ppu'
       safe='+DA2.0W  +U77 -g'
       LIB="-llapack +U77 +DA2.0W -lm $LIB"
       if [ ! -z "`echo $LIB | grep 'veclib'`" ]; then
          cpp_f90="$cpp_f90 -DVAR_LIBVECLIB"
       fi
       ;;
#
#   ALPHA
#
    alpha-dec|mips-dec|vax-dec|alphaev6-dec)
       sys_name="DEC"
       get_cpp_flags

       if [ ! -z "echo $LIB | grep 'dxml'" ]; then
          cpp_f90="$cpp_f90 -DVAR_DXML"
       fi
       opt='-g -fast'
       safe='-g'
       ;;
#
#   CRAY
#
    *-cray)
       sys_name="CRAY"
       get_cpp_flags

       opt="-g -Wf\"-i 64 -a stack -dp\" -Wp\"-F\""
       safe="-Wf\"-i 64 -a stack -Wp\"-F\"-g\""
       c_opt="-g -i 64 -a stack -dp"
       c_safe="-i 64 -a stack -g"
       LIB="C90lib.cld $LIB"
       ;;
#
#  SUN
#
   sparc-sun|m68k-sun)
      sys_name="SUN"
      get_cpp_flags
      cpp_f90="$cpp_f90 -DVAR_MFDS"
      opt='-g -fast # updated 28.Aug.04'
      safe='-g'
      c_opt='-g -fast # updated 28.Aug.04'
      c_safe='-g'
      ;;
#
#   IBM
#
   *-ibm | powerpc64-unknown-linux* | ppc64* )
      case $os in
        aix2*)
          sys_name="AIX"
	  get_cpp_flags
	  cpp_f90="-w -P -DSYS_AIX23 $cpp_f90"
	  cpp_cc="-DSYS_AIX23 $cpp_cc" ;;
	gnu*)
          sys_name="LINUX"
	  get_cpp_flags
	  cpp_f90="-DVAR_MFDS $cpp_f90"
          ;;
         *)
          sys_name="AIX"
	  get_cpp_flags
	  cpp_f90="-DVAR_MFDS $cpp_f90"
         esac


         if [ "$localdisks" = "no" ]; then
            cpp_f90="$cpp_f90 -DVAR_PFS"
         fi

      case $os in
         gnu* )
            opt='-g -O3 -qstrict -qextname -q64'
            safe='-g -qextname -q64'
   	    c_opt='-g -O3 -qstrict -q64'
   	    c_safe='-g -q64'
            ldflag='-q64 '
            arflag='rv'
            ;;
         *)
            opt='-g -O3 -qstrict -qextname -q64'
            safe='-g -qextname -q64'
   	    c_opt='-g -O3 -qstrict -qcpluscmt -q64'
   	    c_safe='-g -qcpluscmt -q64'
            ldflag='-q64 -bmaxdata:0x8000000000'
            arflag='-X64 rv'
            ;;
         esac

         if [ "$mod" = "" ]; then
	    mod="-qmoddir=$MODULE_DIR"
         fi
         f90_extraflags="-qfree=f90"
         ;;
#
#  IRIX
#
   mips*-sgi)
      sys_name="IRIX"
      get_cpp_flags
      opt='-g -O2 -G 0 -woff 2290'
      safe='-g -G 0 -woff 2290'
      c_opt='-g -O2 -G 0'
      c_safe='-g -G 0'
      ;;
#
#   Linux on 32 bit machines
#
   i[3-6]86-*)
      sys_name="LINUX"
      get_cpp_flags
      cpp_f90="$cpp_f90 -DVAR_MFDS"
#
# In case we are using mpif*/mpicc check which compiler it uses to make
# sure we use the correct flags
#
      case "$F90real" in
        g95)
         opt="$opt -fno-second-underscore"
         safe="$safe -fno-second-underscore" ;;
      esac

      find_real_cc

      get_cc_flags
      ;;
#
#   Linux on 64 bit machines
#
   x86_64-*)
      sys_name="LINUX"
      get_cpp_flags
      cpp_f90="$cpp_f90 -DVAR_MFDS"
#
# In case we are using mpif*/mpicc check which compiler it uses to make
# sure we use the correct flags
#
      case "$F90real" in
        g95)
         opt="$opt -fno-second-underscore"
         safe="$safe -fno-second-underscore" ;;
      esac

      find_real_cc

      get_cc_flags
      ;;
#
#   Linux on 64 bit Itanium
#
   ia64-unknown-linux)
      sys_name="LINUX"

      get_cpp_flags
      cpp_f90="$cpp_f90 -DVAR_MFDS"

#
# If we are using mpif77/mpif90/mpicc check which compiler it uses to make
# sure we use the correct flags
#

      case "$F90real" in
      pathf90)
         ldflag=i"$ldflag -i8" ;;
      esac

      find_real_cc
      get_cc_flags

   ;;

#
#   Darwin
#
   *apple*)
      sys_name="DARWIN"
      get_cpp_flags
      cpp_f90="-DVAR_MFDS $cpp_f90"

      F90real="$F90_COMP_NAME"
      get_f90_flags
      get_cc_flags

esac

} # END set_compile_flags()

xlfify()
{
    if [ "$IBMMOD" = 1 ]; then
	echo "$@" | sed 's/-D/-WF,-D/g'
    else
	echo "$@"
    fi
}

cpp_is_gcc()
{
     (echo xxx | cpp --version 2>&1 )| grep 'Free Software Foundation' > /dev/null
}

make_Makefile.config ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# We are beginning to see the end of the installation requirements
# We will now dump machine specific things to Makefile.config
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo 'MAKING MAKEFILE.CONFIG'
echo
if [ -f Makefile.config ]; then
   echo 'Makefile.config exists. I will take a backup as Makefile.config.orig'
   if [ -f Makefile.config.orig  ]; then
      echo 'Makefile.config.orig already exists.'
      answer=
      while [ "$answer" != "y" -a "$answer" != "n" ]
      do
         if [ $quick = 0 ]; then
            $echo 'Do you want me to overwrite' \
            'Makefile.config.orig anyway? (Y/n) \c'
            read answer
         else
            answer=
         fi
         if [ -z "$answer" ]; then
            answer="y"
         fi
      done
      if [ "$answer" = "n" ];  then
         echo 'I do not take a backup of Makefile.config.' \
              'This file will be overwritten'
      else
	  mv Makefile.config Makefile.config.orig
      fi
   else
      mv Makefile.config Makefile.config.orig
   fi
fi
#
# Parallel preprocessor directive need to be set
#
INCLUDE_DIR=include
MODULE_DIR=modules
arflag=

set_compile_flags
mpi2check
get_largefiles

# given that all unix clones like linux, *bsd and mac osx have no
# specific preprocessor directives, what comes below allows one
# to fine-tune functionality. for instance, in the code under gp/
# to get traceback and memory information one needs to differentiate
# the os. also, if the gnu loader is used, the -E flag has to be
# passed on to allow the symbols to be generated

case $flavor in
   *linux*)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=LINUX"
      ldflag="$ldflag -Wl,-E"
   ;;
   *darwin*)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=DARWIN"
   ;;
   *freebsd*)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=FREEBSD"
      ldflag="$ldflag -Wl,-E"
   ;;
   *netbsd*|*openbsd)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=OPENBSD"
      ldflag="$ldflag -Wl,-E"
   ;;
   *)
      cpp_cc="$cpp_cc -DSYS_FLAVOR=UNKNOWN"
   ;;
esac


###############################################################################
#
#  Make Makefile.config
#
#  To avoid problems with make depend, substitute all , with spaces
#
##############################################################################
if [ "$mesp" != "dummy" ]; then
   depend_flags=`echo $cpp_f90 $f90_inc | sed -e 's/,/\ /g'`
else
   depend_flags=`echo $cpp_f90 $f90_inc $parinc | sed -e 's/,/\ /g'`
fi
#
#  Check for special C-directives
#
if [ "$c_opt" = "" ]; then
   c_opt="\$(OPTFLAGS)"
   c_safe="\$(SAFEFLAGS)"
fi
if [ "$ldflag" = "" ]; then
   ldflag="\$(OPTFLAGS)"
# mi: linking can be with optimization
fi
#
# Add the modifications that concern the module preprocessor statements
#
case $F90_COMP_NAME in
   xlf*|mpfort|mpxlf_r)
# IBM's xlf should be comma delimited, the others take spaces
     IBMMOD=1
     ;;
   *)
     cpp_f90="$cpp_f90 `getmods`"
esac

##################################################
#  Make Makefile.config
#################################################

#first define the preprocessing flags for the active modules

cat <<EOF >> Makefile.config
include Makefile.moddef
# default memory (in 8 byte words)
WRKMEM=$memsiz
INSTALL_DIR=$INSTALL_DIR

# scratch directory (the same as in pam script)
SCRATCH_DIR=$worksp
EOF

if [ "$mesp" = "mpi" ]; then
   if [ -n "$parinc" ]; then
      f90_inc="$f90_inc $parinc"
   fi
fi

CPP=cpp
# Find out how to preprocess fortran
if cpp_is_gcc; then
    FPP="cpp -traditional"
else
    FPP="cpp"
fi

cat <<EOF >> Makefile.config

# Fortran and C compilers
F77=$F90_COMP
F90=$F90_COMP
CC =$CC_COMP

# Libraries - check them according to your server equipment !
# You may need blas and lapack (if not using the builtin) and
# mpi (if parallel). For mpi you also need the correct -I flag
# in F77FLAGS, CFLAGS and F90FLAGS (and their safe versions).
LIBS      = $LIB

# preprocessing
DEPFPP=$FPP $cpp_f90 $depend_flags $parinc
DEPCPP=$CPP $cpp_cc $parinc $depend_flags

# linker
LD=\$(F90)
LDFLAGS=$ldflag

EOF

##########################################################################
#
#  dump compiler flags into Makefile.config, where you can edit them
#
##########################################################################

# determine whether to flush into Makefile.config safe or optimized flags
if [ $nooptim = 1 ]; then
# ... employ flags with no optimization
  use_flags=$safe
  use_c_flags=$c_safe
else
# ... employ flags with the optimization
  use_flags=$opt
  use_c_flags=$c_opt
fi

cat <<EOF >> Makefile.config
# compiler flags, standard
F77FLAGS=`xlfify $use_flags $f90_inc $mod $cpp_f90`
F90FLAGS=`xlfify $use_flags $f90_inc $mod $f90_extraflags $cpp_f90`
CFLAGS=$use_c_flags $cc_inc $cpp_cc

# compiler flags, safe
F77FLAGS_SAFE=`xlfify $safe $f90_inc $mod $cpp_f90`
F90FLAGS_SAFE=`xlfify $safe $f90_inc $mod $f90_extraflags $cpp_f90`
CFLAGS_SAFE=$c_safe $cc_inc $cpp_cc


EOF

#
# Insert necessary additional features for parallel calculations
#
if [ "$mesp" = "mpi" ]; then
      write_mpi_ini=""
   if [ "$parlib_pwd" != "" ]; then
      write_mpi_ini="yes"
   fi
   if [ "$parinc" != "" ]; then
      write_mpi_ini="yes"
   fi
   if [ "$write_mpi_ini" = "yes" ]; then
      cat <<EOF >> Makefile.config
#
# Parallel initialization
#
EOF
   fi
   if [ ! -z "$parlib_pwd" ]; then
      parlib_pwd=-L$parlib_pwd
   fi
   if [ "$parinc" != "" ]; then
      cat <<EOF >> Makefile.config
MPI_INCLUDE_DIR=$parinc
EOF
   fi 
   if [ "$parlib_pwd" != "" ]; then
      cat <<EOF >> Makefile.config
MPI_LIB_PATH=$parlib_pwd
EOF
   fi 
   if [ "$parlib" != "" ]; then
      cat <<EOF >> Makefile.config
MPI_LIB=$parlib
EOF
   fi 
fi
} # END make_Makefile.config ()


make_pam_runtest ()  {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#     Make pam and runtest shell script
#   bash is preferred - otherwise use sh
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo '#!/bin/bash' > $INSTALL_DIR/pam
echo '#!/bin/bash' > $SRC_DIR/test/runtest
$echo 'Copying pam shell script to '$INSTALL_DIR' : \c'
cat <<EOF>> $INSTALL_DIR/pam
#
SCR_DEFAULT=$worksp
BIN_DIR=$INSTALL_DIR
SRC_DIR=$SRC_DIR
BASDIR=$SRC_DIR/basis/:$SRC_DIR/basis_dalton/
MPIRUN=$mpirun
MACH_FILE=$mach_file
LOCALDISKS=$localdisks
# Passing files to local disks:
RCP=$rcp
RSH=$rsh
#
# debugger - check it on your machine installation
#
DEBUGGER=$debug
#
CLEANUP=
EOF
cat ./pam.in >> $INSTALL_DIR/pam
chmod a+rx $INSTALL_DIR/pam
echo "ok"
echo
$echo 'Preparing runtest shell script  : \c'
cat <<EOF>> $SRC_DIR/test/runtest
#
BIN_DIR=$INSTALL_DIR
EOF
cat $SRC_DIR/test/runtest.in >> $SRC_DIR/test/runtest
chmod a+rx $SRC_DIR/test/runtest
echo "ok"

if [ $IPRINT -ge "5" ]; then
  echo 'make_pam_runtest: done'
fi

} # END make_pam_runtest ()


final_words () {
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#   Final instructions to user
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
echo
echo "Before you run make, please check the Makefile.config and "
echo "pam files and edit them if you wish."
echo
echo "Please make sure that the mathematical libraries used have been "
echo "compiled with the same compiler you are using now, otherwise it "
echo "might be neccasary to link to additional runtime libraries."
echo
echo "Please check 'Known issues and problems' at"
echo "   http://dirac.chem.sdu.dk/"
echo "to see hints or/and problems concerning your platform."
echo
echo "Then run "
echo "   make"
echo "and then Dirac should be ready to run..."
}

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# THIS FINISHED THE DEFINITIONS OF FUNCTIONS
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# MAIN SCRIPT
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
initialize
opt=
echo
echo '   Configuring the DIRAC Makefile.config + pam and runtest scripts'
echo
echo '   Run configure with the --help argument for more options'

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#                        Parse arguments
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
while [ $# != 0 ]; do
   arg="$1"; shift
   echo "Argument: $arg"
   case "${arg}" in
      -*=*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\([^=]*\)=.*$:\1:'`
         val=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*[^=]*=\(.*\)$:\1:'`
         valomitted=no
         ;;
      -*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\(.*\)$:\1:'`
         val="yes"
         valomitted=yes
         ;;
      *)
         usage
         exit
   esac
   optname="${opt}"
   opt="`echo '' ${opt} | sed -e 's:^ ::' | tr - _`"
   case "${opt}" in
      "help")
        usage
         exit
         ;;
      "quick")
         quick=1
         ;;
      "system")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         guess="$val"
         ;;
      "parallel" | "par")
         case "$val" in
         "no" | "yes" )
            par="$val"
            ;;
         *)
            echo 'Syntax error: Value "'${val}'" is not allowed to option' \
                 '"-'${optname}'"'
            echo 'Legal values: [yes,no]'
            exit 1
            ;;
         esac
         ;;
      "noopt")
	 nooptim=1
         ;;
      "libdir" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         dir_list="$val $dir_list"
         ;;
      "mathematical_libraries" | "math_lib" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         userlib="$val"
         ;;
      "memory_size" | "memory" | "mem" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         memdef="$val"
         ;;
      "install_dir" | "inst_dir" | "install" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         INSTALL_DIR="$val"
         ;;
      "scratch_directory" | "scr_dir" | "scratch_dir" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         worksp="$val"
         ;;
      "queuing_system" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         queuesys="$val"
         ;;
      "cc" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         CC_COMP_NAME="$val"
         ;;
      "f90" )
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         F90_COMP_NAME="$val"
         ;;
      "i"  )
         IPRINT=$val
         ;;
      *)
         echo  'Unknown option: '$opt''
         usage
         exit 1
         ;;
   esac
done

if [ $IPRINT -gt "0" ];  then
  echo 'configure print level set to '$IPRINT
fi

getmods > /dev/null # Make sure that pamadm was run before configure
guess_system
parallel_stuff
safeflags_stuff
find_compilers
find_debugger
if [ "$mesp" = "mpi" ]; then
  find_mpi_path
fi
find_mathlib
set_memsize
set_installdir
set_scratchdir
make_Makefile.config
make_pam_runtest
final_words

