
include ../Makefile.config

F77_OBJS = helper.o

F90_OBJS = aoresponse_input.o \
           dirac_matrix_operations.o \
           dirac_interface.o \
           propint.o \
           pertdens.o \
           proptest.o \
           aoresponse_main.o

F90_MODS = aoresponse_input_m.mod \
           dirac_matrix_operations_m.mod \
           dirac_interface_m.mod \
           propint.mod \
           pertdens.mod \
           proptest.mod \
           aoresponse_main_m.mod

F77_CPPS = $(F77_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F90_MODS) $(F77_OBJS) $(F90_OBJS)

clean :
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod  ;\
        $(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

##
##  compile Fortran90 module source files and make symbolic links
## of resulting *.mod files into common linked directory modules
##
mod: $(F90_MODS)

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

depend:
	../utils/f90dep.py $(CPP_FLAGS) $(F90_OBJS:.o=.F90) $(F77_OBJS:.o=.F) > Makefile.depend

include Makefile.depend

