include ../Makefile.config

F77_OBJS = helper.o

F90_OBJS = aoresponse_input.o \
           matrix_oper.o \
           matrix_mod.o \
           dirac_interface.o \
           grid.o \
           scf_density.o \
           aoresponse_visual.o \
           propint.o \
           pertdens.o \
           slater.o \
           vwn.o \
           vwn_derv.o \
           test_derv.o \
           aoresponse_xc.o \
           aoresponse_test.o \
           aoresponse_main.o

F90_MODS = aoresponse_input_m.mod \
           matrix_oper.mod \
           matrix_mod.mod \
           dirac_interface_m.mod \
           grid_m.mod \
           scf_density_m.mod \
           aoresponse_visual_m.mod \
           propint.mod \
           pertdens.mod \
           slater_m.mod \
           vwn_m.mod \
           vwn_derv_m.mod \
           test_derv_m.mod \
           aoresponse_xc_m.mod \
           aoresponse_test_m.mod \
           aoresponse_main_m.mod

C_OBJS =

F77_CPPS = $(F77_OBJS:.o=.i)

pre:       $(F77_CPPS)

ftnchek:   pre
	   ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:       $(F90_MODS) $(F90_OBJS) $(F77_OBJS) $(C_OBJS)

clean:
	   $(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod  ;\
	   $(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

mod:       $(F90_MODS)

dirac.x:
	   cd .. ; $(MAKE) dirac.x

dirmpi.x:
	   cd .. ; $(MAKE) dirmpi.x

matrix_mod.o:
	$(F90) $(F_INCLUDE_DIR) $(CPP_F90) $(F90_SAFEFLAGS) -c $*.F90

matrix_oper.o:
	$(F90) $(F_INCLUDE_DIR) $(CPP_F90) $(F90_SAFEFLAGS) -c $*.F90

include ../Makefile.depend

