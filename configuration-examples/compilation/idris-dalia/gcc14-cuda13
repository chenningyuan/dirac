
# ATTENTION ATTENTION ATTENTION ATTENTION 
#
# DALIA does not have the same architecture on the frontal (x86_64) and compute nodes (aarch64)
# this means that at the time of writing, compilation has to be done on compute nodes
#
# 

module purge
module load gmp/6.3.0 
module load mpc/1.3.1
module load slurm/slurm/24.11 
module load gcc/14.2.0  
module load nvhpc-hpcx-cuda13/26.1 
module load cuda13.1/toolkit

export CUTENSOR_ROOT=/cm/shared/opt/nvidia/hpc_sdk/Linux_aarch64/26.1/math_libs/13.1
export CUDAToolkit_LIBRARY_ROOT=/cm/shared/opt/nvidia/hpc_sdk/Linux_aarch64
#
#export CUDAToolkit_LIBRARY_ROOT=/cm/shared/opt/nvidia/
#

# important note for DALIA:
# in order to compile interest in aarch64 it necessary to enforce fPIC for the whole code, otherwise OpenMP will generate too many statically allocated code
#
# a CMake variable that deals with this is CMAKE_POSITION_INDEPENDENT_CODE=ON
#
# as an example of configuration, use for example (h/t to simplice donfack from idris) : 
#
# ./setup --cmake-options="-DCMAKE_VERBOSE_MAKEFILE=ON -DTAPP_CUTENSOR=ON -DENABLE_PCMSOLVER=OFF -DCMAKE_EXE_LINKER_FLAGS='-L/cm/shared/apps/cuda13.1/toolkit/13.1.0/targets/sbsa-linux/lib -Wl,-rpath,/cm/shared/apps/cuda13.1/toolkit/13.1.0/targets/sbsa-linux/lib -lcudart -lcublas -lcuda' -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DCMAKE_Fortran_FLAGS='-fPIC -ftls-model=global-dynamic' " --fc=gfortran --cc=gcc --cxx=g++ build
#

export LD_LIBRARY_PATH=$CUTENSOR_ROOT/lib64:$LD_LIBRARY_PATH

export EXA_GPU=NVIDIA

# code for GB200 gpus
export CUDA_SM_ARCH=100
