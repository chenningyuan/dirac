include ../Makefile.config

F77_OBJS = amfi.o \
           amfi1.o \
           amfi2.o \
           amfi3.o \
           relscf.o

F90_OBJS =

F90_MODS =

C_OBJS =

F77_CPPS = $(F77_OBJS:.o=.i)

pre:       $(F77_CPPS)

ftnchek:   pre
	   ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

# amfi.F needs safe flags
amfi.o: amfi.F
	$(F90) $(F_INCLUDE_DIR) $(CPP_F90) $(SAFEFLAGS) -c amfi.F

all:       $(F90_MODS) $(F90_OBJS) $(F77_OBJS) $(C_OBJS)

clean:
	   $(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod  ;\
	   $(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

mod:       $(F90_MODS)

dirac.x:
	   cd .. ; $(MAKE) dirac.x

dirmpi.x:
	   cd .. ; $(MAKE) dirmpi.x

### 
###    ...   SAFEFLAGS are defined in Makefile.config  ...
### 
amfi.o:
	$(F90) $(F_INCLUDE_DIR) $(CPP_F90) $(SAFEFLAGS) -c $*.F 

include ../Makefile.depend

