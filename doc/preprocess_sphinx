#!/usr/bin/env python

# previous bash-script translated to this Python form by Ivan Hrasko

import re, sys, os, shutil, fnmatch, fileinput, subprocess

DIR_DOC = os.path.abspath(sys.argv[1])
DIR_BUILD = os.path.abspath(sys.argv[2])

DIR_TEMP = os.path.join(DIR_BUILD,'html_temp')
DIR_FINAL = os.path.join(DIR_BUILD,'html')

shutil.rmtree(DIR_TEMP,ignore_errors=True)
shutil.copytree(DIR_DOC,DIR_TEMP)

for root, dirs, files in os.walk(os.path.join(DIR_TEMP,'manual')):
    for filename in fnmatch.filter(files,'*.rst'):
        for line in fileinput.input(os.path.join(root,filename),inplace=True):
        #! replace:
        #! keyword(RABOOF)
        #! by:
        #! .. index:: .RABOOF
        #! .. _RABOOF:
        #!
        #! .RABOOF
        #! -------
            match_keyword = re.match(r'keyword\(([a-zA-Z 0-9_]+)\)',line)
        #! replace:
        #! starstar(RABOOF)
        #! by:
        #! .. index:: **RABOOF
        #! .. _RABOOF:
        #!
        #! ==========
        #! \*\*RABOOF
        #! ==========
            match_starstar = re.match(r'starstar\(([a-zA-Z 0-9_]+)\)',line)
        #! replace:
        #! star(RABOOF)
        #! by:
        #! .. index:: **RABOOF
        #! .. _RABOOF:
        #!
        #! ========
        #! \*RABOOF
        #! ========
            match_star = re.match(r'star\(([a-zA-Z 0-9_]+)\)',line)
            if match_keyword:
                raboof = match_keyword.group(1)
                print '.. index:: .' + raboof + '\n.. _.' + raboof + ':\n\n.' + raboof + '\n----------'
            elif match_starstar:
                raboof = match_starstar.group(1)
                print '.. index:: **' + raboof + '\n.. _**' + raboof + ':\n\n==========\n\\*\\*' + raboof + '\n=========='
            elif match_star:
                raboof = match_star.group(1)
                print '.. index:: *' + raboof + '\n.. _*' + raboof + ':\n\n==========\n\\*' + raboof + '\n=========='
            else:
                print line[0:len(line)-1]
        

SPHINX_CALL = 'sphinx-build -b html ' + DIR_TEMP + ' ' + DIR_FINAL
subprocess.call(SPHINX_CALL,shell=True)        
shutil.rmtree(DIR_TEMP,ignore_errors=True)

