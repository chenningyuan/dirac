#!/usr/bin/env python

# previous bash-script translated to this Python form by Ivan Hrasko

import re, sys, os, shutil, fnmatch, fileinput, subprocess

DIR_DOC = os.path.abspath(sys.argv[1])
DIR_BUILD = os.path.abspath(sys.argv[2])

DIR_TEMP = os.path.join(DIR_BUILD,'html_temp')
DIR_FINAL = os.path.join(DIR_BUILD,'html')

shutil.rmtree(DIR_TEMP,True)
shutil.copytree(DIR_DOC,DIR_TEMP)

for root, dirs, files in os.walk(os.path.join(DIR_TEMP,'manual')):
    for filename in fnmatch.filter(files,'*.rst'):
        RFILE = os.path.join(root,filename)
        
        #! replace:
        #! keyword(RABOOF)
        #! by:
        #! .. index:: .RABOOF
        #! .. _RABOOF:
        #!
        #! .RABOOF
        #! -------
        for line in fileinput.input(RFILE,inplace=True):
           print re.sub(r'keyword(([a-zA-Z 0-9_]+))','\.\. index:: \.\1\n\.\. _\.\1:\n\n\.\1\n----------',line[0:len(line)-1])

        #! replace:
        #! starstar(RABOOF)
        #! by:
        #! .. index:: **RABOOF
        #! .. _RABOOF:
        #!
        #! ==========
        #! \*\*RABOOF
        #! ==========
        for line in fileinput.input(RFILE,inplace=True):
           print re.sub(r'starstar(([a-zA-Z 0-9_]+))','\.\. index:: \*\*\1\n\.\. _\*\*\1:\n\n==========\n\\\*\\\*\1\n==========',line[0:len(line)-1])
           
        #! replace:
        #! star(RABOOF)
        #! by:
        #! .. index:: **RABOOF
        #! .. _RABOOF:
        #!
        #! ========
        #! \*RABOOF
        #! ========        
        for line in fileinput.input(RFILE,inplace=True):
           print re.sub(r'star(([a-zA-Z 0-9_]+))','\.\. index:: \*\1\n\.\. _\*\1:\n\n==========\n\\\*\1\n==========',line[0:len(line)-1])

SPHINX_CALL = 'sphinx-build -b html ' + DIR_TEMP + ' ' + DIR_FINAL
subprocess.call(SPHINX_CALL,shell=True)        
shutil.rmtree(DIR_TEMP,True)
