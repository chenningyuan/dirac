#!/usr/bin/env python

#
# This script converts macro keyword(SOMEKEYWORD) into proper sphinx directives.
#
# Previous bash-script written by Radovan Bast translated to this Python form by Ivan Hrasko.
# 
# Further changes: Miro Ilias
#

import re, sys, os, shutil, fnmatch, fileinput, subprocess

DIR_DOC = os.path.abspath(sys.argv[1])
DIR_BUILD = os.path.abspath(sys.argv[2])

DIR_TEMP = os.path.join(DIR_BUILD,'html_temp')
DIR_FINAL = os.path.join(DIR_BUILD,'html')

shutil.rmtree(DIR_TEMP,ignore_errors=True)
shutil.copytree(DIR_DOC,DIR_TEMP)

for root, dirs, files in os.walk(os.path.join(DIR_TEMP,'manual')):
    for filename in fnmatch.filter(files,'*.rst'):
        
        #! replace:
        #! keyword(RABOOF)
        #! by:
        #! .. index:: .RABOOF
        #! .. _RABOOF:
        #!
        #! .RABOOF
        #! -------
        for line in fileinput.input(os.path.join(root,filename),inplace=True):
            print re.sub(r'keyword\(([a-zA-Z !0-9_+-]+)\)','.. index:: .\g<1>\n.. _.\g<1>:\n\n.\g<1>\n'+'-'*(line.find(')')-line.find('(')),line[0:len(line)-1])

        #! replace:
        #! starstar(RABOOF)
        #! by:
        #! .. index:: **RABOOF
        #! .. _RABOOF:
        #!
        #! ==========
        #! \*\*RABOOF
        #! ==========
        for line in fileinput.input(os.path.join(root,filename),inplace=True):
            print re.sub(r'starstar\(([a-zA-Z !0-9_+-]+)\)','.. index:: **\g<1>\n.. _**\g<1>:\n\n'+'='*(line.find(')')-line.find('(')+3)+'\n\\*\\*\g<1>\n'+'='*(line.find(')')-line.find('(')+3),line[0:len(line)-1])

        #! replace:
        #! star(RABOOF)
        #! by:
        #! .. index:: **RABOOF
        #! .. _RABOOF:
        #!
        #! ========
        #! \*RABOOF
        #! ========
        for line in fileinput.input(os.path.join(root,filename),inplace=True):
            print re.sub(r'star\(([a-zA-Z !0-9_+-]+)\)','.. index:: *\g<1>\n.. _*\g<1>:\n\n'+'='*(line.find(')')-line.find('(')+1)+'\n\\*\g<1>\n'+'='*(line.find(')')-line.find('(')+1),line[0:len(line)-1])

SPHINX_CALL = 'sphinx-build -b html ' + DIR_TEMP + ' ' + DIR_FINAL
subprocess.call(SPHINX_CALL,shell=True)
# miro: deactivate removing if you want to check resulting preprocessed rst files
shutil.rmtree(DIR_TEMP,ignore_errors=True)
