# This is an example Makefile.config file generated on a linux/gcc
# platform. To use this file copy it to the source tree root and rename
# it Makefile.config.
# Depending on your compiler and operating system you need to define
# certain preprocessor macros (-D), which can be found in the source
# code of the configure script.

include Makefile.moddef
# default memory (in 8 byte words)
WRKMEM=64000000
INSTALL_DIR=.

# scratch directory (the same as in pam script)
SCRATCH_DIR=/tmp

# Fortran and C compilers
F77=gfortran
F90=gfortran
CC =gcc

# Libraries - check them according to your server equipment !
# You may need blas and lapack (if not using the builtin) and
# mpi (if parallel). For mpi you also need the correct -I flag
# in F77FLAGS, CFLAGS and F90FLAGS (and their safe versions).
LIBS      =  -lblas -llapack

# preprocessing
DEPFPP=cpp -traditional  -DGFORTRAN=432 -DPRG_DIRAC -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DVAR_MFDS -DMOD_ERI -DMOD_DFT -DMOD_XPP -DMOD_STEX -DGFORTRAN=432 -DPRG_DIRAC -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DVAR_MFDS -Iinclude
DEPCPP=cpp -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE  -D_LARGEFILE64_SOURCE -DMOD_ERI -DMOD_DFT -DMOD_XPP -DMOD_STEX -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DSYS_FLAVOR=LINUX  -DGFORTRAN=432 -DPRG_DIRAC -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DVAR_MFDS -Iinclude

# linker
LD=$(F90)
LDFLAGS= -Wl,-E

# compiler flags, standard
F77FLAGS=-g -O3 -ffast-math -funroll-loops -ftree-vectorize -Iinclude -Jmodules -DGFORTRAN=432 -DPRG_DIRAC -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DVAR_MFDS -DMOD_ERI -DMOD_DFT -DMOD_XPP -DMOD_STEX
F90FLAGS=-g -O3 -ffast-math -funroll-loops -ftree-vectorize -Iinclude -Jmodules -DGFORTRAN=432 -DPRG_DIRAC -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DVAR_MFDS -DMOD_ERI -DMOD_DFT -DMOD_XPP -DMOD_STEX
CFLAGS=-g -O3 -ffast-math -Iinclude -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE  -D_LARGEFILE64_SOURCE -DMOD_ERI -DMOD_DFT -DMOD_XPP -DMOD_STEX -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DSYS_FLAVOR=LINUX

# compiler flags, safe
F77FLAGS_SAFE=-g -Iinclude -Jmodules -DGFORTRAN=432 -DPRG_DIRAC -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DVAR_MFDS -DMOD_ERI -DMOD_DFT -DMOD_XPP -DMOD_STEX
F90FLAGS_SAFE=-g -Iinclude -Jmodules -DGFORTRAN=432 -DPRG_DIRAC -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DVAR_MFDS -DMOD_ERI -DMOD_DFT -DMOD_XPP -DMOD_STEX
CFLAGS_SAFE=-g -Iinclude -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE  -D_LARGEFILE64_SOURCE -DMOD_ERI -DMOD_DFT -DMOD_XPP -DMOD_STEX -DSYS_LINUX -DINSTALL_WRKMEM=${WRKMEM} -DSYS_FLAVOR=LINUX


