include ../Makefile.config

OBJS =	dircnv.o \
	dirone.o \
	dirout.o \
	dirana.o \
	dirrdn.o \
	dirscf.o \
	dirset.o \
	dirtra.o \
	dirtwo.o \
	dirgp.o  \
	dirgrd.o \
	dirden.o \
	dirsol.o 

all:	$(OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(OBJS:.o=.F)
# DO NOT DELETE THIS LINE -- make depend depends on it.

