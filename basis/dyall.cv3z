$ 
$ invocation: basis_set.py --file=../basis/reference_edited/6p_tz_archive --print_polarization --print_scfbas --uncontracted --equal_exponent_threshold=0.05 --polarization_type=valence correlating,core correlating --output=dyall.6p.tz.bas
$ 
