$ invocation: basis_set.py --file=../basis/reference_edited/7s_dz_archive --print_polarization --print_scfbas --uncontracted --equal_exponent_threshold=0.05 --polarization_type=correlating,4s4p polarizing --output=dyall.7s.dz.bas
