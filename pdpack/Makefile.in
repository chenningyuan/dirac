# VERSION : $Revision$
# DATE    : $Date$
# FILE    : Makefile.in
# SOURCE  : $Source$
#

include ../Makefile.config

#
# Delete the entry libpdlib.a(gpblas.o) if you supply your own BLAS !
#

F_OBJS = libpdlib.a(arhpack.o) libpdlib.a(dge.o) libpdlib.a(dsp.o)\
         libpdlib.a(linextra.o) libpdlib.a(printpkg.o)\
         libpdlib.a(gpblas.o) libpdlib.a(eispack.o) \
         libpdlib.a(gp_zlapack.o) libpdlib.a(gp_dlapack.o) \
         libpdlib.a(gp_zlinpack.o) libpdlib.a(gp_auxlapack.o) \

F77_SRC = arhpack.F dge.F dsp.F linextra.F printpkg.F \
          gpblas.F  eispack.F gp_zlapac.F gp_dlapack.F \
          gp_zlinpack.F gp_auxlapack.F

F77_CPPS = $(F77_SRC:.F=.i)

F90_MODS =

all :	libpdlib.a

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

libpdlib.a: $(F_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i *.a

mod:
	$(MAKE) f90dep  # create list of which file to compile to get the .mod files
	$(MAKE) module_files

module_files: $(F90_MODS)


dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_SRC) 

f90dep: ;\
       ../utils/sfmakedepend.pl -I $(SOURCEDIR)/include -M $(SOURCEDIR)/modules $(F90_OBJS:.o=.F90) $(F90_OBJS:.o=.F) $(F77_OBJS:.o=.F)

# DO NOT DELETE THIS LINE -- make depend depends on it.

