include ../Makefile.config

OBJS=pdlib.a(arhpack.o) pdlib.a(dge.o) pdlib.a(dsp.o)\
     pdlib.a(fastio_g07.o) pdlib.a(linextra.o) pdlib.a(printpkg.o)\
     pdlib.a(gpblas.o) pdlib.a(gp_dblas3.o) pdlib.a(eispack.o) \
     pdlib.a(numrep.o) 

SRC=arhpack.F dge.F dsp.F fastio_g07.F linextra.F printpkg.F \
    gpblas.F gp_dblas3.F eispack.F numrep.F

all :	pdlib.a

pdlib.a: $(OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i *.a

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(SRC)
# DO NOT DELETE THIS LINE -- make depend depends on it.

