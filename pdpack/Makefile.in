include ../Makefile.config

#
# Delete the entry libpdlib.a(gpblas.o) if you supply your own BLAS !
#

OBJS=libpdlib.a(arhpack.o) libpdlib.a(dge.o) libpdlib.a(dsp.o)\
     libpdlib.a(linextra.o) libpdlib.a(printpkg.o)\
     libpdlib.a(gpblas.o) libpdlib.a(eispack.o)

SRC=arhpack.F dge.F dsp.F linextra.F printpkg.F \
    gpblas.F  eispack.F

all :	libpdlib.a

libpdlib.a: $(OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i *.a

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(SRC)
# DO NOT DELETE THIS LINE -- make depend depends on it.

