# VERSION : $Revision$
# DATE    : $Date$
# FILE    : Makefile.in
# SOURCE  : $Source$
#

include ../Makefile.config

F77_OBJS = df_dirac.o df_fck3.o df_utils.o df_vxc.o 
F90_OBJS = 

F90_MODS =

F77_CPPS = $(F77_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F77_OBJS) $(F90_OBJS)

mod: $(F90_MODS)

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i *.L i.*.f v.i.*.f *.a *.mod *.MOD

f90dep: ;\
       ../utils/sfmakedepend.pl -I include -M $(INSTALLDIR)/modules $(F90_OBJS:.o=.F90) $(F90_OBJS:.o=.F) $(F77_OBJS:.o=.F)
 

