include ../Makefile.config

F_OBJS=ciinfo_r.o  density_r.o  diagonal_r.o  diagonalize_r.o  fock_r.o  interface_r.o  \
       io_r.o  memory_r.o  program_r.o  sigden_r.o  sigma_r.o  strings_r.o  transform_r.o  \
       utils_r.o  vecmat_r.o

F_CPPS = $(F_OBJS:.o=.i)

pre:	$(F_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F_CPPS) > ftnchek.out

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

all:	$(F_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i


depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F_OBJS:.o=.F)
# DO NOT DELETE THIS LINE -- make depend depends on it.


