include ../Makefile.config

F_OBJS = fck3aob.o fck3drv.o fck3ftuv.o fck3mom.o fck3odb.o 
#eri2aob.o eri2ave.o eri2car1.o eri2car2.o eri2cft.o eri2dis.o \
#eri2drv.o eri2fck.o eri2her.o eri2odb.o eri2out.o eri2par.o eri2pro.o \
#eri2sph.o eri2sym.o eri2vec.o eriprg.o erisph.o 

F_CPPS = $(F_OBJS:.o=.i)

pre:	$(F_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F_CPPS) > ftnchek.out

all:	$(F_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i


dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F_OBJS:.o=.F)
# DO NOT DELETE THIS LINE -- make depend depends on it.
