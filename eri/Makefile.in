include ../Makefile.config

OBJS = eri2cft.o     eri2her.o     eri2sym.o \
eri2aob.o     eri2dis.o     eri2odb.o     eri2vec.o \
eri2car1.o    eri2drv.o     eri2out.o \
eri2car2.o    eri2fck.o     eri2sph.o     

all:	$(OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i


depend:
	makedepend -- $(DEPEND_FLAGS) -- $(OBJS:.o=.F)
# DO NOT DELETE THIS LINE -- make depend depends on it.
