   #
   # Active modules
   #
   if [ "$DFTTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/dft/{*.c,*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
