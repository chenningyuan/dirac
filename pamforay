#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# MAIN SCRIPT
#
#
#
# Parse arguments
#
if [ -z "$1" ]; then
   usage
   exit 1
fi
####
GENTAR=1
while [ -n "$1" ]; do
   case "$1" in
      -adm|-ad|-a)
         PAMADM=1
         ;;
      -dft)
         DFTMOD=1
         ;;
      -esr|-es)
         ESRMOD=1
         ;;
      -xpp|-xp)
         XPPMOD=1
         ;;
      -fmm|-fm)
         ERIMOD=1
         DNFMOD=1
         FMMMOD=1
	 MODULES=1
         ;;
      -densfit|-dnf)
         DNFMOD=1
         ERIMOD=1
         ;;
      -largemolecules|-lm|-l)
         LARGEMOL=1
         ;;
      -eri|-er|-e)
         ERIMOD=1
         ;;
      -krmc|-krm|-kr|-k)
         KRMCMOD=1
         ;;
      -emb|-embedding)
         EMBMOD=1
	 MODULES=1
         ;;
      -adc)
         ADCMOD=1
         ;;
      -ecp)
         ECPMOD=1
         ;;
      -cdft)
         CDFTMOD=1
         ;;
      -visual)
         VISUALMOD=1
	 MODULES=1
         ;;
      -aoresponse)
         AORESPONSEMOD=1
	 MODULES=1
         ;;
      -cap)
         CAPMOD=1
         OOFMOD=1
	 MODULES=1
         ;;
      -hscc)
         HSCCMOD=1
         OOFMOD=1
	 MODULES=1
         ;;
      -oof)
         OOFMOD=1
	 MODULES=1
         ;;
      -ibm)
         IBMMOD=1
         echo "activating IBM mods..."
         ;;
      -*)
