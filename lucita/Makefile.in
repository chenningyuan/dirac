include ../Makefile.config

F77_OBJS = ciinfo.o \
           density.o \
           diagonal.o \
           lucita_diagonalize.o \
           fock.o \
           interface.o \
           io.o \
           lucia_cc.o \
           lucia_icci.o \
           memory.o \
           program.o \
           property.o \
           sigma.o \
           strings.o \
           transform.o \
           utils.o \
           vecmat.o \
           par_lucia.o \
           par_solver.o

F90_OBJS =

F90_MODS =

C_OBJS =

F77_CPPS = $(F77_OBJS:.o=.i)

pre:       $(F77_CPPS)

ftnchek:   pre
	   ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:       $(F90_MODS) $(F90_OBJS) $(F77_OBJS) $(C_OBJS)

clean:
	   $(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod  ;\
	   $(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

mod:       $(F90_MODS)

dirac.x:
	   cd .. ; $(MAKE) dirac.x

dirmpi.x:
	   cd .. ; $(MAKE) dirmpi.x

include ../Makefile.depend

