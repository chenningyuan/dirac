echo "# file generated by the minions (pamadm) of Dirac - DO NOT EDIT!" > build/Makefile.moddef
echo "MODS="$MODS >> build/Makefile.moddef

$echo "Determining svn URL & revision (with svn info) ... \c"
THIS_DIRAC_SVN_URL=`svn info | grep 'URL' | awk '{ print $2 }'`
THIS_DIRAC_SNAP=`svn info | grep 'Revision' | awk '{ print $2 }'`
$echo $THIS_DIRAC_SVN_URL "...." $THIS_DIRAC_SNAP
echo "DIRAC_SVN_URL='$THIS_DIRAC_SVN_URL'" >> build/Makefile.moddef
echo "DIRAC_SNAP='$THIS_DIRAC_SNAP'" >> build/Makefile.moddef

# Prevent rebuild of Makefile.dep and Makefile.obj if they
# exist and we are doing an export.
if [ -r build/Makefile.obj -a -n "$GENTAR" ]; then
    touch build/Makefile.obj
    touch build/Makefile.dep
fi

## create and distribute Makefile over active directories
install_dir=`pwd`
echo "Linking build/Makefile.dirs as Makefile over local directories."

# create links of Makefile(s) over directories
for thisdir in $dirs
do
  ln -sf $install_dir/build/Makefile.dirs $thisdir/Makefile
done

