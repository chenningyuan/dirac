usage()
{
   echo 'Usage: pamadm [flags] [tarfile]'
   echo '   Flags:'
   echo '     +/-adm             : Include/exclude ALL modules (administrator)'
   echo '     +/-dft             : Include/exclude DFT module'
   echo '     +/-eri             : Include/exclude ERI integral routines'
   echo '     +/-densfit         : Include/exclude density fitting module'
   echo '     +largemolecules    : Increases commom blocks to handle more atoms and basis sets'
   echo '     +/-fmm             : Include/exclude fast multipole method'
   echo '     +/-esr             : Include/exclude ESR property module'
   echo '     +/-xpp             : Include/exclude PP excitation energy and STEX modules'
   echo '     +/-xml             : Include/exclude XML input/output module'
   echo '     +/-krmc            : Include/exclude KR-MCSCF and LUCIAREL modules'
   echo '     +/-emb             : Include/exclude ab initio/DFT-embedding module (with the F90/95 modularity feature)'
   echo '     +/-visual          : Include/exclude visualization module'
   echo '     +/-aoresponse      : Include/exclude AO response module'
   echo '     +/-matrixop        : Include/exclude matrix operations module'
   echo '     +/-autodiff        : Include/exclude autodiff module'
   echo '     +/-cap             : Include/exclude CAP module'
   echo '     +/-hscc            : Include/exclude interface for the (external) HSMRCC code together with its objects'
   echo '     +/-hsfs            : Include/exclude higher external Higher sector FSCC code'
   echo '     +/-hsfsdyn         : Include/exclude higher external Higher sector FSCC code - dynamic allocation version.'
   echo '     +/-qdots           : Include/exclude Quantum Dots functionality (artificial atom)'
   echo '     +/-ihfscc          : Include/exclude Intermediate Hamiltonian functionality to FSCC code'
   echo '     +/-amfi            : Include/exclude the AMFI functionality into DIRAC'
   echo '     +/-london          : Include/exclude London orbitals functionality for magnetic properties'
   echo '     +/-oof             : Include/exclude object oriented modularity of Fotran 90/95'
   echo '     +/-adc             : Include/exclude ADC electron propagator module'
   echo '     +/-ecp             : Include/exclude ARGOS ECP module'
   echo '     +/-log             : Enable/disable matrix logging in Matlab format'
   echo '     tarfile          : Name of export archive to create (if any)'
   echo '     tarfile=export   : Make DIRAC.new.tar.gz'
}
