#
#
# MAKE EXPORT SHELL SCRIPT
#
#
make_export()
{
   echo "*** Making ./export"
   echo
   #
   # Basis files
   #
   cat <<EOF> ./export
#!/bin/sh
   szCurrDir=\`pwd\`
   szCurrDir=\${szCurrDir##*/}
   cd ..
   echo " - adding files to tar-achive..."
   echo
# First add the files that are at the main level or are special.
   tar cvf \$szCurrDir.tar \\
     \$szCurrDir/README \\
     \$szCurrDir/configure \\
     \$szCurrDir/config.sub \\
     \$szCurrDir/config.guess \\
     \$szCurrDir/config.status \\
     \$szCurrDir/C90lib.cld \\
     \$szCurrDir/crilib.cld \\
     \$szCurrDir/pam.in \\
     \$szCurrDir/pamq \\
     \$szCurrDir/Makefile \\
     \$szCurrDir/build/Makefile.obj \\
     \$szCurrDir/build/Makefile.dep \\
     \$szCurrDir/build/Makefile.moddef \\
     \$szCurrDir/build/dontbuild \\
     \$szCurrDir/build/dontbuild.in \\
     \$szCurrDir/build/safebuild \\
     \$szCurrDir/doc/doc.html \\
     \$szCurrDir/doc/pam.1 \\
     \$szCurrDir/doc/Makefile.config.example \\
     \$szCurrDir/include/*.h \\
     \$szCurrDir/main/*.h \\
     \$szCurrDir/main/*.head \\
     \$szCurrDir/main/*.struct \\
     \$szCurrDir/modules/README \\
     \$szCurrDir/test \\
     \$szCurrDir/testlast \\
     \$szCurrDir/basis \\
     \$szCurrDir/basis_dalton \\
     \$szCurrDir/build \\
     \$szCurrDir/utils 2> export.log
echo $dirs
# Now add the standard files from each active directory (module).
   for module in $dirs; do
      MDir=\$szCurrDir/\$module
      tar rvf \$szCurrDir.tar \$MDir/*.c \$MDir/*.F \$MDir/*.F90 \$Mdir/*.f90 \$MDir/*.inc \$MDir/*.h \$MDir/Makefile \$MDir/include 2>> export.log
   done
EOF
   #
   # Active modules
   #
   if [ "$DFTTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/dft/{*.c,*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$DNFTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/densfit/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$FMMTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/fmm/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$XMLTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/gp/xml/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$EMBTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/embedding/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$ADCTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/reladc/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$ECPTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/argosecp/{*.F,*.F90,*.f90,*.h,*.c,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$VISUALTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/visual/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$AORESPONSETAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/aoresponse/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$MATRIX_OPERATIONS_TAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/matrix_operations/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$CAPTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/cap/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$HSCCTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/hsmrcc/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$ERITAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/eri/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$ESRTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/prp/esr/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
   if [ "$XPPTAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/prp/xpp/{*.F,*.F90,*.f90,*.h,Makefile,include} 2>> export.log
EOF
   fi
