   fi
   if [ "$OOF_TAR" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/oof/{*.F,*.F90,*.f90,Makefile.in} 2>> export.log
      tar rvf \$szCurrDir.tar \$szCurrDir/oof/{*.c,*.F,*.F90,*.f90,Makefile.in,*.inc,*.c} 2>> export.log
EOF
   fi
# A DIRAC administrator should have everything
   if [ "$PAMADM" ]; then
      cat <<EOF>> ./export
      tar rvf \$szCurrDir.tar \$szCurrDir/pamadm \$szCurrDir/WHATSNEW 2>> export.log
EOF
   fi
   if [ "$EXPORTTAR" ]; then
      cat <<EOF>> ./export
EOF
   fi
   cat <<EOF >> ./export
      echo " - gzip'ing archive..."
      echo
      gzip -9v \$szCurrDir.tar
      mv \$szCurrDir.tar.gz \$szCurrDir/\$szCurrDir.tar.gz
EOF
   chmod +x ./export
}

rmline()
{
    #Remove the line $2 from file $1
    grep -v -- "$2" <"$1" >"$1.tmp"
    mv "$1.tmp" "$1"
}

#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Determine the active modules (directories)
#
#
#
which_modules()
{
for mod in $ERIFLG $DNFFLG $FMMFLG $DFTFLG $KRMCFLG $ESRFLG $XPPFLG $EMBFLG $ADCFLG $VISUALFLG $AORESPONSEFLG $MATRIX_OPERATIONS_FLG $AUTODIFFFLG $CAPFLG $HSCCFLG $HSFSFLG $QDOTSFLG $LRGMOLFLG $OOF_FLG $XMLFLG $IHFSCCFLG $AMFIFLG $LONDONFLG $LOG_FLG
do
  if [ -n "$MODS" ]; then
    MODS="$MODS $mod"
  else
    MODS="$mod"
  fi
done

cp build/dontbuild.in build/dontbuild
# Some makes cannot cope with nonexisting include files,
# we therefore make dummy includes so that make depend can
# run properly.
if [ ! -r "Makefile.dep" ]; then
    touch -t 198001010000 build/Makefile.dep
fi
if [ ! -r "Makefile.obj" ]; then
    touch -t 198001010000 build/Makefile.obj
fi

dirs="dirac prp abacus gp pdpack main relccsd moltra dirrci lucita utils argosecp"
if [ -n "$ERIFLG" ]; then
    dirs="$dirs eri"
    rmline build/dontbuild "eri/\.\*"
fi
if [ -n "$DNFFLG" ]; then
   dirs="$dirs densfit"
    rmline build/dontbuild "densfit/\.\*"
fi
if [ -n "$FMMFLG" ]; then
   dirs="$dirs fmm"
   rmline build/dontbuild "fmm/\.\*"
fi
if [ -n "$DFTFLG" ]; then
   dirs="$dirs dft"
   rmline build/dontbuild "dft/\.\*"
fi
if [ -n "$XMLFLG" ]; then
   dirs="$dirs gp/xml"
   rmline build/dontbuild "gp/xml/\.\*"
fi
if [ -n "$EMBFLG" ]; then
   dirs="$dirs embedding"
   rmline build/dontbuild "embedding/\.\*"
fi
if [ -n "$ADCFLG" ]; then
   dirs="$dirs reladc"
   rmline build/dontbuild "reladc/\.\*"
fi
if [ -n "$ECPFLG" ]; then
   dirs="$dirs argosecp"
   rmline build/dontbuild "argosecp/\.\*"
fi
if [ -n "$VISUALFLG" ]; then
   dirs="$dirs visual"
   rmline build/dontbuild "visual/\.\*"
fi

if [ -n "$AORESPONSEFLG" ]; then
   dirs="$dirs aoresponse"
   rmline build/dontbuild "aoresponse/\.\*"
fi

if [ -n "$MATRIX_OPERATIONS_FLG" ]; then
   dirs="$dirs matrix_operations"
   rmline build/dontbuild "matrix_operations/\.\*"
fi

if [ -n "$AUTODIFFFLG" ]; then
   dirs="$dirs autodiff"
   rmline build/dontbuild "autodiff/\.\*"
fi

