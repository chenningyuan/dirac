  def distribute_work_dir(self):
  ######################################################################
  #
  #  This routine is called when local disks are selected
  #  for parallel calculations
  #
  #  The list of machines available to dirac.x
  # 
  ######################################################################a
    if (self.iprint>=5):
      print 'distribute_work_dir'
      print 'assigned machine file=',self.machinefile

    # check if this is an enviromental variable with "$" - than get its content
    if (self.machinefile[0]=="$"):
      #print 'enviroment variable:'
      machinefile_temp=self.machinefile[1:len(self.machinefile)]
      machinefile_content=''
      try:
        machinefile_content=os.environ[machinefile_temp]
      except:
        print 'The ',self.machinefile,' enviroment variable for machinefile not active (no batch system).'
      if (self.iprint>=4):
        print 'machinefile enviromental variable points to',machinefile_content
    else:  # true file, no pointing variable
      machinefile_content=self.machinefile 

    # identify nodes in the file
    if ( os.path.isfile(machinefile_content) ) :
      print 'machinefile is a true file, reading its content'
      for line in fileinput.input(machinefile_content):
        line=line[:-1] 
        #print 'read line=',line
        if (line != self.master): # append only nodes different from master
          print 'adding node to the list',line
          self.nodes.append(line)

    # ... distribute master workdir over different nodes, "copying $master:$file onto $node:$WRK/."
    # otherwise print message that all cpus are on one machine
    if self.nodes:
      print 'copying content of master workdir over nodes '
      for node in self.nodes:
        print 'Copying content of ',self.master,' work-directory to the',node
        # create working directories on nodes
        command=self.rsh+' '+node+' "mkdir -p '+self.workdir+' "'
        if (self.iprint>=4):
          print 'create work dir command:',command
        os.system(command)
        for this_file in os.listdir(self.workdir):
          this_file_full=self.workdir+'/'+this_file
          command=self.rcp+' '+this_file_full+' '+node+':'+this_file_full 
          if (self.iprint>=0):
            print 'copying work dir command:',command
          os.system(command)
          if (self.iprint>=4): # control list of directory
            os.system(self.rsh+' '+node+' "ls -l '+self.workdir+' "')
    else:
      print 'All CPUs are on the master, no distribution of workdir over different nodes.'

