    def get_rc_arguments(self):
        """
        Look for possible rc files and return arguments collected from them.
        Inform about finding rc-file.
        Rc-file can not have empty lines, #-serve as comments
        """
        fullargs = []
        paths = [os.path.join(os.path.expanduser('~'),'.diracrc'),
                 '.diracrc','diracrc',os.path.join(install_dir,'.diracrc'),
                 os.path.join(install_dir,'diracrc')]
        for path in paths:
            try:
                f = open(path,'r')
                print 'found diracrc-file with default pam flags:',path
                for l in f.readlines():
                    l = l.strip()
                    if len(l) > 0:
                        if l[0] != '#':
                           for a in shlex.split(l):
                               fullargs.append(a)
            except Exception:
                pass
        if fullargs:
            self.diracrc_args = fullargs 
            print 'all default arguments for pam: ',self.diracrc_args
        return fullargs

    def process_pam_arguments(self):
        ''' the longest method - reading and processing script flags  '''
        global install_dir

        from optparse import OptionParser, OptionGroup

        usage = \
            """%prog [options] --inp=*.inp --mol=*.mol
   or: %prog [options] --inp=*.inp --mol=*.xyz
   or: %prog [options] --fullrestart=ARCHIVE.tgz
Options are also read from the ~/.dirac and .diracrc files."""

        parser = OptionParser(usage)

        group = OptionGroup(parser, 'Input files - mandatory specifications')
        group.add_option('--inp', type='string', action='store',
                         dest='inp_file', help='Dirac input file containing the job directives [*.inp]')
        group.add_option('--mol', type='string', action='store',
                         dest='mol_file',
