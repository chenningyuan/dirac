    def launch_dirac_subprocess(self):
        """
        launch dirac.x subprocess; called from ...
        """

        # open the outhput file
        self.f = open(self.output_file_full, 'w', 0)

        # write something into the output file by pam
        self.write_into_output()

        # process the dirac.x (or mpi-wrapper) as the child subprocess

        # stderr=None means flushing stderr output only into console (red color in trac-webpage)

        # radovan: with shell=True the pid does not necessarily match
        #          the dirac job, it matches the shell command that spawns the dirac job
        #          then timeout terminates the command but not the dirac.x run
        #          but we do need shell=True (painful lesson when testing without)
        # http://mail.python.org/pipermail/python-bugs-list/2009-January/067267.html  
        self.dirac_p = subprocess.Popen(self.dirac_cmd, shell=True, \
                       stdin=subprocess.PIPE, stdout=self.f, stderr=subprocess.PIPE)

        if self.iprint > 0:
            print '  DIRAC command  : %s (PID=%s)' % (self.dirac_cmd,self.dirac_p.pid)

        # get stderr stream to be properly distributed
        self.dirac_stderr = self.dirac_p.communicate()[1] 

        # deal with the error output only if happens
        if len(self.dirac_stderr) > 0 :
            # attach stderr to the pam output
            self.f.write('\n ====  below this line is the stderr stream  ====' + self.dirac_stderr)
            # flush out the entire dirac stderr; useful for non-verbose test runs (to have it on the console)
            if self.iprint > 0: 
                print >> sys.stderr,'\n **** dirac-executable stderr console output : **** '
                print >> sys.stderr,self.dirac_stderr
                print >> sys.stderr,'directory:', self.input_directory
                print >> sys.stderr,'   inputs:', self.input_molecule,\
                                    ' & ', self.input_dirac

        self.dirac_p.wait()
        self.f.close()
        return self.dirac_p.returncode

    def kill_single_process(self,pid):
        """
        kill (or try to kill) single process
        """
        from common import get_pid_label
      
        while True:
            try:
                for stream in [sys.stdout,sys.stderr]:
                    print >> stream,\
                    'Going to kill (SIGTERM) dirac related process with PID=',pid
                    print >> stream,get_pid_label(pid) 
                    stream.flush()

                while True:
                    os.kill(pid,signal.SIGTERM) # or signal.SIGKILL
                    killedpid, stat = os.waitpid(pid, os.WNOHANG)
                    if killedpid == 0:
                        for stream in [sys.stdout,sys.stderr]:
                            print >> stream, "dirac.x process(es),PID=",pid,\
                             ", not killed, going to repeat shoot after 3 seconds"
                        time.sleep(3)
                    else:
                        for stream in [sys.stdout,sys.stderr]:
                            print  >> stream, " Finally ! Process dirac.x killed !"
                    break # leave the while cycle...
            except:
                break

    def kill_dirac_processes(self):
        """
        kill all dirac processes...
        """
        self.get_dirac_pids()
        was_killed=True
      
        i=0
        while was_killed==True or i<=2:
            was_killed=False
            if self.parallel_run:
                if self.dirac_in_pid(self.dirac_p.pid):
                    self.kill_single_process(self.dirac_p.pid)
                    was_killed=True
                    i=0

            for pid in self.all_dirac_pids:
                if self.dirac_in_pid(pid):
                    self.kill_single_process(pid)
                    was_killed=True
                    i=0
            # get fresh load of dirac processes
            self.get_dirac_pids()
            i=i+1

        self.print_all_processes()
        self.print_timeout_message()
        return signal.SIGTERM

