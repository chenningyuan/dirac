        if self.parallel_run:
            os.putenv('DIRPAR', '1')
            os.putenv('DIRNOD', str(int(self.max_memory_work_slave * 1000000)))
            if self.global_scratch_disk:
                os.putenv('GLBSCR', '1')
            else:
                os.putenv('GLBSCR', '0')
