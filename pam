  def execute_dirac(self):
  #############################################################################################
  #
  #            Excecute dirac.x, either in serial or parallel mode
  #
  #############################################################################################
    def signal_handler(signum, frame):
    # ... controling the time of the execution
      #print 'Signal handler called with signal', signum
      print 'DIRAC execution interrupted, because takes longer than the limit of ',self.timeout,' seconds.\n'
      sys.stdout.flush()
      #raise Exception("Timed out!")
      #raise IOError("Take too long !")
      raise Error("Takes too long !")

    # go to the working directory
    os.chdir(self.workdir)

    if (self.nobackup is False):
      from common import backup_file
      backup_file(some_file=self.input_directory+"/"+self.output_file,upto=None,iprint=None)

    if (self.set_timeout_limit) :
      #print 'signal stuff initiated, self.timeout=',self.timeout
      signal.signal(signal.SIGALRM, signal_handler)
      signal.alarm(self.timeout)  # 

    basis_set_directory_list = self.basdir.split(':')
    print '  DIRAC command  : %s' % self.dirac_cmd
    print '  basis set dirs : %s' % basis_set_directory_list[0]
    if len(basis_set_directory_list) > 1:
        for i in range(1, len(basis_set_directory_list)):
            if basis_set_directory_list[i] != '.':
                print '                   %s' % basis_set_directory_list[i]
    try:
      if (not self.debug and not self.vg_debug):
        #print 'executing dirac ...',self.dirac_cmd
        self.f=open(self.output_file_full,'w',0)
        # write something into the output file by pam 
        self.write_into_output()
        # process the pam
        p=subprocess.Popen(self.dirac_cmd,shell=True,stdin=subprocess.PIPE,stdout=self.f)
        print '  pid            : %s ' % p.pid
        p.wait()
        self.exit_function(returncode=p.returncode)
        self.f.close()
      else:
        print 'debugging dirac...',self.dirac_cmd
        rc=os.system(self.dirac_cmd) # 
        #self.exit_function(returncode=rc)
      signal.alarm(0)    
    except:
      print "Dirac run failed. Going to kill (SIGTERM) its executable process of pid=",p.pid
      #TODO: clean of all dirac.x pid's
      os.kill(p.pid, signal.SIGTERM)
      print '****  Alas ! dirac.x was purposely killed ;)  ****'
      self.exit_function(returncode=signal.SIGTERM)

    # do the profiling after the execution
    if self.profile: self.profile_dirac()

