                print 'self.get_files=', self.get_files
                print '  files_to_get=', files_to_get
            for file_name in files_to_get:
                save_single_file(file_name)

    # DFCOEF

        if self.outcmo:
            file_name = 'DFCOEF'
            save_single_file(file_name)

    # DFFCK2

        if self.outfock:
            file_name = 'DFFCK2'
            save_single_file(file_name)

    # take care of individual nodes if parallel run

        if self.nodes:
            for this_node in self.nodes:
                sys.stdout.flush()
                print 'content of the scratch_dir, slave node ', this_node, \
                    ':', self.scratch_dir
                command = self.rsh + ' ' + this_node + ' "ls -l ' \
                    + self.scratch_dir + ' "'
                os.system(command)
                sys.stdout.flush()
                print ' Total size of the slave node scratch directory:\c'
                command = self.rsh + ' ' + this_node + ' "du -h -s ' \
                    + self.scratch_dir + ' "'
                os.system(command)
                sys.stdout.flush()
                print '  Info on the disk space usage on the slave node:'
                command = self.rsh + ' ' + this_node + ' "df -h  ."'
                os.system(command)

        # finally removing node content

                command = self.rsh + ' ' + this_node + ' "rm -fr  ' \
                    + self.scratch_dir + ' "'
                os.system(command)
                print 'scratch directory on slave node', this_node, ':', \
                    self.scratch_dir, ' deleted.'
                sys.stdout.flush()

    def print_header(self):

#   radovan: if self.parallel_build == False,
#            then self.parallel_run should be set to False
#            and only self.parallel_run should be checked
#            no reason to check both several times

        if self.parallel_run and self.parallel_build:
            dirac_run = 'parallel'
        else:
            dirac_run = 'serial'
        print
        print '  output from the dirac python script'
        print
        print '  user           :', self.user_name
        print '  host           :', self.master
        print '  ip             :', self.hostname_ip
        print '  date and time  :', datetime.datetime.now()
        print '  pam command    :', self.pam_command
        print '  pam args       :', ' '.join(sys.argv[1:])
        print '  input dir      :', self.input_directory
        print '  scratch dir    :', self.scratch_dir
        print '  output file    :', self.output_file
        print '  DIRAC run      :', dirac_run

        if self.set_timeout_limit:
            print '  Allowed runtime:', self.timeout, \
                ' seconds. Killing afterwards.'
        print

    # warning message on # of proc >1

        if not self.parallel_build and int(self.nr_proc) >= 1:
            print 'This is serial run (no or wrong MPIRUN assigned), the flag --mpi=', \
                self.nr_proc, ' has no meaning.'
            print

        sys.stdout.flush()
    

class pam_run(pam_enviroment):

    def __init__(self):
        append_dirac_py_modules(install_dir)
        self.pam_variables = pam_enviroment()

    def perform(self):
        self.pam_variables.read_makefile_config()
        self.pam_variables.process_pam_arguments()
        self.pam_variables.set_output_file()
        if self.pam_variables.just_show_settings:
            self.pam_variables.show_settings()
            return 0
        self.pam_variables.print_header()
        self.pam_variables.copy_files()
        if self.pam_variables.parallel_run \
            and self.pam_variables.localdisks:
            self.pam_variables.distribute_scratch_dir()
        self.pam_variables.set_dirac_environment()
        self.pam_variables.set_dirac_cmd()
        return_code = self.pam_variables.execute_dirac()
        self.pam_variables.save_files()
        self.pam_variables.remove_scratch_dir()
        self.exit_function(return_code)

def main(*args):
    dirac_run = pam_run()
    return dirac_run.perform()


if __name__ == '__main__':
    sys.exit(main(*sys.argv))
