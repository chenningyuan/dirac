            '--fullrestart',
            type='string',
            action='store',
            dest='dest_fullrestart',
            help="""restart from files within ARCHIVE.tgz; 
                    no \"--inp\" and \"--mol\" specifications needed.
                 """,
            metavar='ARCHIVE.tgz',
            )
        parser.add_option_group(group)

        group = OptionGroup(parser, 'Output files')
        group.add_option(
            '--suffix',
            type='string',
