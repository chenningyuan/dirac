      # select existing files in self.archive_files for the archive
      existing_archive_files=''
      for archfile in self.archive_files:
        if (os.path.isfile(archfile)):
          existing_archive_files=existing_archive_files+' '+archfile
      if (self.iprint >= 5):
        print 'existing archive files:',existing_archive_files

      # backup 
      if (self.nobackup is False):
         backup_file(some_file=archive_full_name,upto=None,iprint=None)
      #archive_command='tar c '+self.archive_files+' | gzip > '+archive_full_name
      archive_command='tar c '+existing_archive_files+' | gzip > '+archive_full_name
      # own packing (Linux)
      os.system(archive_command)

    # take care of the rest - get files from workdir to home dir
    if (self.get_files is not None):
      files_to_get = self.get_files.split()
      if self.iprint >= 4:
        print 'self.get_files=',self.get_files
        print '  files_to_get=',files_to_get
      for file_name in files_to_get:
        save_single_file(file_name)

    # DFCOEF
    if (self.outcmo):
      file_name="DFCOEF"
      save_single_file(file_name)

    # DFFCK2
    if (self.outfck):
      file_name="DFFCK2"
      save_single_file(file_name)

  def remove_work_dir(self):
  #
  # Remove working directory
  #
    self.remove_workdir()
    # take care of individual nodes if parallel run
    if self.nodes:
      for this_node in self.nodes:
        sys.stdout.flush()
        print 'content of the workdir, slave node ',this_node,':',self.workdir 
        command=self.rsh+' '+this_node+' "ls -l '+self.workdir+' "'
        os.system(command)
        sys.stdout.flush()
        print ' Total size of the slave node work directory:\c'
        command=self.rsh+' '+this_node+' "du -h -s '+self.workdir+' "' 
        os.system(command)
        sys.stdout.flush()
        print '  Info on the disk space usage on the slave node:'
        command=self.rsh+' '+this_node+' "df -h  ."' 
        os.system(command)
        # finally removing node content
        command=self.rsh+' '+this_node+' "rm -fr  '+self.workdir+' "'
        os.system(command)
        print 'Work directory on slave node', this_node,':',self.workdir,' deleted.'
        sys.stdout.flush()

  def print_header(self):
    from common import get_username,get_hostname,get_hostname_ip
    self.master=get_hostname()
    if (self.parallel_run and self.parallel_build):
      dirac_run = "parallel"
    else:
      dirac_run = "serial"
    print 
    print '  output from the dirac python script' 
    print 
    print "  user           :", get_username() 
    print "  host           :", get_hostname() 
    print "  ip             :", get_hostname_ip() 
    print "  date and time  :", datetime.datetime.now() 
    print "  pam command    :", self.pam_command 
    print "  pam args       :", self.pam_args
    print "  input dir      :", self.input_directory 
    print "  scratch dir    :", self.workdir 
    print "  output file    :", self.output_file 
    print "  DIRAC run      :", dirac_run

    if (self.set_timeout_limit):
      print "  Allowed runtime:",self.timeout,' seconds. Killing afterwards.'
    print
    print

    # warning message on # of proc >1 
    if (not self.parallel_build and int(self.nr_proc) >= 1):
      print 'This is serial run (no or wrong MPIRUN assigned), the flag --mpi=',self.nr_proc,' has no meaning.'
      print
    
    ### take care of the slave memory for parallel runs ###
    if (self.parallel_run and self.slavemem_set is False) :
      #print 'self.slavemem_set=',self.slavemem_set
      self.slavemem=self.mem
      print 'Slave memory set to ',self.slavemem, ' megawords.'
      pass

    sys.stdout.flush()

#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
class pam_run(pam_enviroment):
#-----------------------------------------------------
#-----------------------------------------------------
  def __init__(self):
    #print 'pam_run class initialize'
    self.pam_variables=pam_enviroment()
    #################################################################
    # VERY IMPORTANT: append external dirac modules to the path dir
    #################################################################
    append_dirac_py_modules(install_dir)

  def perform(self):
    self.pam_variables.read_makefile_config()
    self.pam_variables.process_pam_arguments()
    self.pam_variables.set_output_file()
    self.pam_variables.print_header()
    self.pam_variables.copy_files()
    if (self.pam_variables.parallel_run and self.pam_variables.localdisks):
      self.pam_variables.distribute_work_dir()
    self.pam_variables.set_dirac_environment()
    self.pam_variables.set_dirac_cmd()
    self.pam_variables.execute_dirac()
    self.pam_variables.save_files()
    self.pam_variables.remove_work_dir()

###########################################################################
###                   process the main function                         ###
###########################################################################
def main(*args):
   #print "pam.py main function..."
   dirac_run = pam_run()
   dirac_run.perform()

if __name__ == '__main__':
   sys.exit(main(*sys.argv))
