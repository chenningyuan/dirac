    # identify nodes in the file

        if os.path.isfile(machinefile_content):
            for line in fileinput.input(machinefile_content):
                line = line[:-1]
                if line != self.master:  # append only slaves different from the master
                    self.nodes.append(line)
            print '  Machinefile read, list of nodes obtained.'
            # make a unique list of nodes - remove all duplicities from the list
            self.nodes=list(set(self.nodes)) 

    # ... distribute master scratch_dir selected files over different nodes, "copying $master:$file onto $node:$WRK/."
    # otherwise print message that all CPUs are on one machine-master

        if self.nodes:
            files_to_nodes=self.core_dirac_files+self.distribute # list of files to be distributed over nodes
            print '  Copying selected content of master scratch directory to nodes :',self.nodes
            for node in self.nodes:
                if self.iprint >= 2:
                    print '  Copying master ', self.master, \
                          ' scratch directory selected files to the node', node,' :'
                # create scratch directories on the nodes; TODO: find pure python replacement
                command = self.rsh + ' ' + node + ' "mkdir -p ' \
                    + self.scratch_dir + ' "'
                if self.iprint >= 4:
                    print 'create scratch dir command:', command
                os.system(command)
                # copies file after file
                for this_file in os.listdir(self.scratch_dir):
                    # distribute only selected files in the list
                    if this_file in files_to_nodes:
                        this_file_full = self.scratch_dir + '/' + this_file
                        # TODO: replace the shell command by some pure python solution
                        command = self.rcp + ' ' + this_file_full + ' ' \
                            + node + ':' + this_file_full
                        if self.iprint >= 0:
                            print '  ', command
                        os.system(command)
                        if self.iprint >= 4:  # control list of directory
                            os.system(self.rsh + ' ' + node + ' "ls -l ' \
