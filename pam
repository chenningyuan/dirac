    def read_makefile_config(self):
        """Read the Makefile.config to get default values of many variables.
        Makefile.config file is the storage place for important variables
        -  debugger, profiler, mpi-launcher... """
        def namval(line):
            """Return (NAME,VALUE) from lines NAME = VALUE, taking 
            #comments into account. Return ('','') if no match"""
            n = line.find("#")
            if n >= 0:
                line = line[:n]
            n = line.find("=")
            if n>=0:
                return (line[:n].strip(),line[n+1:].strip())
            else:
                return ('','')

        makefile_config = install_dir + '/' + 'Makefile.config'
        # if no Makefile.config present, leave with warning message
        if not os.path.isfile(makefile_config):
            return

        # open and read line by line by avoiding #-comments
        for line in fileinput.input([makefile_config]):
            (name,value) = namval(line)
            value = os.path.expandvars(value)
            if name == 'INSTALL_DIR':
                pass
            elif name == 'SCRATCH_DIR':
                self.scratch_path = value
                if not os.path.isdir(self.scratch_path):
                    print 'NB: the scratch_path ', self.scratch_path, \
                        ' does not exist on this machine.'
                    print 'Running on your own risk (might not create scratch_dir).'
            elif name == 'DEBUGGER':
                self.debugger = value
            elif name == 'PROFILER':
                self.profiler = value
            elif name == 'MPIRUN':
                self.parallel_build = True
            elif name == 'LOCALDISKS':
                if value == 'yes':
                    self.localdisks = True
            elif name == 'MPI_PASS_scratch_ARGUMENT':
                if self.localdisks:
                    localdisks_pass_scratch_temp = value
                    self.argument_to_pass_scratch_dir_to_slaves = \
                        localdisks_pass_scratch_temp
            elif name == 'MACH_FILE':
                self.machinefile = value
            elif name == 'RCP':
                self.rcp = value
            elif name == 'RSH':                
                self.rsh = value

