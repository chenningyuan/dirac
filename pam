    def set_output_name(self):
        '''Set the output name string to be used later for naming the
        output file and the scratch directory'''

        if len(self.input_molecule) > 0 and len(self.input_dirac) > 0:
            if '.mol' in self.input_file_molecule:
                mol_file_stripped = \
                    self.input_file_molecule.replace('.mol', '', 1)
            elif '.xyz' in self.input_file_molecule:
                self.xyz_molecule_input = True
                mol_file_stripped = \
                    self.input_file_molecule.replace('.xyz', '', 1)
            else:
                # no suffix, never mind
                mol_file_stripped = self.input_file_molecule

            if '.inp' in self.input_file_dirac:
                inp_file_stripped = self.input_file_dirac.replace('.inp'
                        , '', 1)
            else:
                # no suffix, continuing..
                print 'The dirac input file does not contain recommended suffix, never mind...'
                inp_file_stripped = self.input_file_dirac
            # set proper output file structure
            self.output_name = inp_file_stripped + '_' + mol_file_stripped
        elif self.full_restart:
            # todo: verify *.tgz ?
            self.output_name = self.archive_name.replace('.tgz', '', 1)
        else:
            # assign default name
            self.output_name = 'dirac_output.' + str(self.current_pid)

    def copy_files(self):
        '''copies file from the home directory to the scratch directory'''

        def copy_single_file(file_name_local, file_name_scr):
            full_file_name = os.path.join(self.input_directory,file_name_local)
            if os.path.isfile(full_file_name):
                file_name_scratch = os.path.join(self.scratch_dir, file_name_scr)
                self.copy_file(full_file_name, file_name_scratch)
            else:
                if self.expert_mode:
                    for stream in [sys.stdout,sys.stderr]:
                        print >> stream,'happens in input directory:',self.input_directory
                        print  >> stream,'  Warning: file "', file_name_local, \
                        '" you want to copy to scratch_dir does not exist, continuing at your own risk.'
                else:
                    for stream in [sys.stdout,sys.stderr]:
                        print >> stream,'happens in input directory:',self.input_directory
                        print >> stream,'Error exit: file "', file_name_local, \
                        '" you want to copy to scratch_dir does not exist !  '
                    sys.exit(11)

        self.create_scratch_dir()

    # copy dirac.x executable if wanted
        self.copy_file(self.dirac_exe, os.path.join(self.scratch_dir,self.dirac_exe_file))

    # restarting stuff
        if self.full_restart:
            copy_single_file(self.archive_name, self.archive_name)
            archive_scratch_dir = os.path.join(self.scratch_dir, self.archive_name)
            unpack_command = 'tar --directory ' + self.scratch_dir \
                + ' -xvf ' + archive_scratch_dir
            print 'Unpacking the archive file into the scratch directory, command ', \
                unpack_command
            os.system(unpack_command)

    # the existence of self.input_file molecule,self.input_file_dirac is verified
        if self.input_file_molecule:
            if self.xyz_molecule_input == True:
                self.copy_file(self.input_file_molecule,os.path.join(self.scratch_dir,'MOLECULE.XYZ')) 
            else:
                self.copy_file(self.input_file_molecule, os.path.join(self.scratch_dir,'MOLECULE.MOL'))
        else:
            print '  No molecule input file provided, assuming it is obtained from the restart file.'

        if self.input_file_dirac:
            self.copy_file(self.input_file_dirac, os.path.join(self.scratch_dir,'DIRAC.INP'))
        else:
            print '  No input file provided, assuming it is obtained from the restart file.'

        if self.put_files is not None:
            for file_name in self.put_files:
                for f in glob.glob(file_name):
                    copy_single_file(f,f)

    # copies files to scratch_dir
        if self.incmo:
            file_name = 'DFCOEF'
            copy_single_file(file_name,file_name)
        if self.infock:
            file_name = 'DFFCK2'
            copy_single_file(file_name,file_name)
        if self.inkrmc:
            file_name_loc = 'KRMCSCF'
            file_name_scr = 'KRMCOLD'
            copy_single_file(file_name_loc,file_name_scr)

    def distribute_scratch_dir(self):
        """
        This routine is called when local disks are selected
        for parallel calculations.
        """
        if not self.rcp:
            print_std_out_err('No rcp command specified, use --rcp= on the command line or in ~/.diracrc')
            sys.exit(-1)
        if not self.rsh:
            print_std_out_err('No rsh command specified, use --rsh= on the command line or in ~/.diracrc')
            sys.exit(-1)
        # get the list of nodes
        self.get_nodes()

    # ... distribute master scratch_dir selected files over different nodes 
    # by "copying $master:$file onto $node:$WRK/."
    # otherwise print message that all CPUs are on one machine-master
    #
        if self.nodes:
            files_to_nodes=self.core_dirac_files+self.distribute # list of files to be distributed over nodes
            print '  Copying selected content of master scratch directory to nodes :',self.nodes
            for node in self.nodes:
                # create scratch directories on the nodes; TODO: find pure python replacement
                command = self.rsh + ' ' + node + ' "mkdir -p ' \
                    + self.scratch_dir + ' "'
                os.system(command)
                # copies file after file
                for this_file in os.listdir(self.scratch_dir):
                    # distribute only selected files in the list
                    if this_file in files_to_nodes:
                        this_file_full = os.path.join(self.scratch_dir,this_file)
                        # TODO: replace the shell command by some pure python solution
                        command = self.rcp + ' ' + this_file_full + ' ' \
                            + node + ':' + this_file_full
                        if not self.silent:
                            print '  ', command
                        os.system(command)
        else:
            print '  All CPUs are on the master, no distribution of scratch_dir over different nodes.'

