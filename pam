    def copy_file(self, src, dest):
        """copy file from directory "scr" to "dest"
     for the printout use 'purified' file names"""

        from common import extract_path_file

        epf_dest = extract_path_file()
        epf_dest.get_path_file(dest)

        epf_src = extract_path_file()
        epf_src.get_path_file(src)
      
        # miro: to get clear error message one has to adapt try-except
        try:
            shutil.copy(src, dest)
            if self.iprint > 0:
                print '  Copying file: ', epf_src.pure_file_name, \
                ' (as ', epf_dest.pure_file_name,').'
            if self.iprint >= 3:
                print ' src full path:', src
                print 'dest full path:', dest
        except:
            if os.path.isfile(src):
                src_message="...src exists"
            else:
                src_message="...src does not exist !"
            if os.path.isdir(dest):
                src_message="...dest exists"
            else:
                src_message="...dest does not exist !"
            # ... 
            for stream in [sys.stdout,sys.stderr]:
                print >> stream,\
               'Copying of files - shutil.copy(src, dest) - failed, error exit !'
                print >> stream,' src full path:', src
                print >> stream,'dest full path:', dest
                print >> stream,'  input dir      :', self.input_directory
                sys.exit(13)

    def process_scratch_dir_name(self,scratch_dir_string):
        """ Process scratch_dir name - called from reading --scratch argument """
        self.create_scratch_dir_name = False
        # check for PID substring to be replaced with unique string
        if 'PID' in scratch_dir_string:
            scratch_dir_string=scratch_dir_string.replace('PID',str(self.current_pid),1)
        else:
            pass
        # assign scratch_dir name
        self.scratch_dir = scratch_dir_string

    def list_scratch_dir(self):
        ''' 
        lists the content of the master scratch directory;
        see  http://www.daniweb.com/code/snippet216798.html
        '''
        scratch_id=self.user_name+"@"+self.master_full+":"+self.scratch_dir
        sum_filesize_mb=0
        print
        print '  content of the (master) scratch directory ', scratch_id
        print '  ------------------------------------------------------------------------------'
        print '%25s %10s %s' % ('name', 'size (MB)', 'last accessed')
        print '  ------------------------------------------------------------------------------'
        for filename in os.listdir(self.scratch_dir):
            filesize_mb = float(os.path.getsize(self.scratch_dir + '/'
                                + filename)) / 1024000

            sum_filesize_mb=sum_filesize_mb+filesize_mb

      # create a dictionary to hold file info

            file_name = filename
            file_stats = os.stat(file_name)
            file_info = {
                'fname': file_name,
                'fsize': file_stats[stat.ST_SIZE],
                'f_lm': time.strftime('%m/%d/%Y %I:%M:%S %p',
                        time.localtime(file_stats[stat.ST_MTIME])),
                'f_la': time.strftime('%m/%d/%Y %I:%M:%S %p',
                        time.localtime(file_stats[stat.ST_ATIME])),
                'f_ct': time.strftime('%m/%d/%Y %I:%M:%S %p',
                        time.localtime(file_stats[stat.ST_CTIME])),
                }
            print '%25s %10.3f %s' % (filename, filesize_mb,
                    file_info['f_la'])
            sys.stdout.flush()

            if self.iprint >= 8:
                print
                print 'file name = %(fname)s' % file_info
                print 'file size = %(fsize)s bytes' % file_info
                print 'last modified = %(f_lm)s' % file_info
                print 'last accessed = %(f_la)s' % file_info
                print 'creation time = %(f_ct)s' % file_info
                print
                if stat.S_ISDIR(file_stats[stat.ST_MODE]):
                    print 'This a directory'
                else:
                    print 'This is not a directory'
                print
                print 'A closer look at the os.stat(%s) tuple:' \
                    % file_name
                print file_stats
                print
                print 'The above tuple has the following sequence:'
                print """st_mode (protection bits), st_ino (inode number),
           st_dev (device), st_nlink (number of hard links),
           st_uid (user ID of owner), st_gid (group ID of owner),
           st_size (file size, bytes), st_atime (last access time, seconds since epoch),
           st_mtime (last modification time), st_ctime (time of creation, Windows)"""
                sys.stdout.flush()
        print '  ------------------------------------------------------------------------------'
        print '       Total size of all files :  %10.3f  MB ' % sum_filesize_mb

        from common import disk_space
        disk = disk_space(self.scratch_dir)
        print '      Disk info:  used    available   capacity [GB]'
        print '           %10.3f     %10.3f     %10.3f ' % (disk.used,disk.available,disk.capacity)
        print ''
        sys.stdout.flush()

    def remove_scratch_dir(self):
        ''' remove the scratch directory (if it exists) '''
        if os.path.isdir(self.scratch_dir):
            if self.iprint > 0:
                self.list_scratch_dir()
            if not self.keep_scratch:
                if self.iprint > 0:
                    print '  deleting the scratch directory'
                shutil.rmtree(self.scratch_dir)
            else:
                if self.iprint > 0:
                    print '  keeping the scratch directory'
        else:
             print '  The scratch directory already does not exist. '
        sys.stdout.flush()

    def exit_function(self, returncode):
        '''prints message on the DIRAC executable exit according to the input parameter'''
        print '  exit date      :', datetime.datetime.now()
        print '  exit code      :', returncode
        if returncode == 0:
            print '  exit           : normal'
        else:
            print '  exit           : ABNORMAL (CHECK DIRAC OUTPUT)'
        print
        sys.stdout.flush()

    def process_pam_arguments(self):
        ''' the longest method - reading and processing script flags  '''
        global install_dir

        from optparse import OptionParser, OptionGroup

        usage = \
            """
          %prog [options] --inp=*.inp --mol=*.mol
      or: %prog [options] --inp=*.inp --mol=*.xyz
      or: %prog [options] --fullrestart=ARCHIVE.tgz"""

        parser = OptionParser(usage)

        group = OptionGroup(parser, 'Input files - mandatory specifications')
        group.add_option('--inp', type='string', action='store',
                         dest='inp_file', help='Dirac input file containing the job directives [*.inp]')
        group.add_option('--mol', type='string', action='store',
                         dest='mol_file',
                         help='file containing the basis set and geometry specifications [*.mol or *.xyz]')
        group.add_option(
            '--fullrestart',
            type='string',
            action='store',
            dest='dest_fullrestart',
            help="""restart from files within ARCHIVE.tgz; 
                    no \"--inp\" and \"--mol\" specifications needed.
                 """,
            metavar='ARCHIVE.tgz',
            )
        parser.add_option_group(group)

        group = OptionGroup(parser, 'Output files')
        group.add_option(
            '--suffix',
            type='string',
            action='store',
            dest='dest_suffix',
            default=self.output_suffix,
            help='file suffix for output [default: %default]',
            metavar='STRING',
            )
