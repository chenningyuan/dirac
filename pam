    def execute_dirac(self):
        '''Excecute dirac.x, either in serial or parallel mode'''

        def signal_handler(signum, frame):
            '''Controling the time of the execution'''

            print 'DIRAC execution interrupted, because takes longer than the limit of ', \
                self.timeout, ' seconds.\n'
            sys.stdout.flush()
            raise Error('Takes too long !')

        os.chdir(self.scratch_dir)

        if not self.nobackup:
            from common import backup_file
            backup_file(some_file=self.input_directory + '/'
                        + self.output_file, upto=None,
                        iprint=self.iprint)

        if self.set_timeout_limit:
            signal.signal(signal.SIGALRM, signal_handler)
            signal.alarm(self.timeout)

        if len(self.nice_cmd) > 1:
            print '  Lowest process priority set through ', \
                self.nice_cmd
        print '  DIRAC command  : %s' % self.dirac_cmd

        basis_set_directory_list = self.basdir.split(':')
        print '  basis set dirs : %s' % basis_set_directory_list[0]
        if len(basis_set_directory_list) > 1:
            for i in range(1, len(basis_set_directory_list)):
                if basis_set_directory_list[i] != '.':
                    print '                   %s' \
                        % basis_set_directory_list[i]
        try:
            if not self.debug and not self.vg_debug:
                self.f = open(self.output_file_full, 'w', 0)

        # write something into the output file by pam

                self.write_into_output()

        # process the pam

                p = subprocess.Popen(self.dirac_cmd, shell=True,
                        stdin=subprocess.PIPE, stdout=self.f)
                print '  pid            : %s ' % p.pid
                p.wait()
                return_code = p.returncode
                self.f.close()
            elif self.parallel_run == False:
                print 'debugging dirac in plain serial run...', \
                    self.dirac_cmd
                return_code = os.system(self.dirac_cmd)
            else:
                print '''
...no dirac run ... wrong parallel/debugger combination
'''

      # zero signal alarm

            signal.alarm(0)
        except:
            print 'Dirac run failed. Going to kill (SIGTERM) its executable process of pid=', \
                p.pid

      # TODO: clean of all dirac.x pid's

            os.kill(p.pid, signal.SIGTERM)
            print '****  Alas ! dirac.x was purposely killed ;)  ****'
            return_code = signal.SIGTERM

    # do the profiling after the execution

        if self.profile:
            self.profile_dirac()
        return return_code

