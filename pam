    def kill_dirac_pid(self,pid):
        """
        kill process with the entering pid, which is connected to dirac.x calculations
        repeat until it is 'really killed'
        """
        from common import get_pid_label
        i=0
        while self.dirac_in_pid(pid) and i<=2:
        #while i<=2:
            try:
                for stream in [sys.stdout,sys.stderr]:
                    print >> stream,\
                    'Going to kill (SIGTERM) dirac related process with PID=',pid
                    print >> stream,get_pid_label(pid) 
                    stream.flush()
                os.kill(pid,signal.SIGTERM)
                killedpid, stat = os.waitpid(pid, os.WNOHANG)
                if killedpid == 0:
                    print >> sys.stderr, "ACK! PROCESS NOT KILLED, going to repeat"
                    i=i-1
                    print 'but first applying ',kill_command
                    kill_command="kill -9 "+str(pid)
