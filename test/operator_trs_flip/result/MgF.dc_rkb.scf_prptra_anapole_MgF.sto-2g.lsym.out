**DIRAC                                                                                             
.TITLE                                                                                              
  MgF                                                                                               
.WAVE F ! Activate integral and wave functions modules                                              
#.PROPERTIES ! Activate property module (dipole moment; polarizability...)                          
.ANALYZE                                                                                            
.4INDEX                                                                                             
**GENERAL                                                                                           
.DIRECT                                                                                             
1 1 1                                                                                               
**INTEGRALS                                                                                         
.PRINT                                                                                              
1                                                                                                   
.NUCMOD ! 1-Point nucleus, 2-gaussian                                                               
2                                                                                                   
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONIAN                                                                                       
.PRINT                                                                                              
2                                                                                                   
!.ONESYS                                                                                            
.INTFLG                                                                                             
1 1 0                                                                                               
**WAVE FUNCTIONS ! What method (DHF,MP2,CC..)                                                       
.SCF                                                                                                
*SCF                                                                                                
.CLOSED SHELL                                                                                       
20                                                                                                  
.OPEN SHELL                                                                                         
1                                                                                                   
1/2                                                                                                 
.INTFLG ! Specify what 2-el.integrals to include                                                    
1 1 0                                                                                               
.EVCCNV ! Energy convergence...                                                                     
1.0D-8  1.0D-6                                                                                      
#################################################                                                   
**ANALYZE                                                                                           
.MULPOP                                                                                             
*MULPOP                                                                                             
.VECPOP                                                                                             
all                                                                                                 
**MOLTRA                                                                                            
.SCHEME                                                                                             
6                                                                                                   
.ACTIVE                                                                                             
11                                                                                                  
.PRPTRA                                                                                             
*PRPTRA                                                                                             
.PRINT                                                                                              
3                                                                                                   
.OPERATOR                                                                                           
 'xalpha_fc F'                                                                                      
 XALPHA                                                                                             
 'FC F  01'                                                                                         
 COMFACTOR                                                                                          
 1.00D0                                                                                             
.OPERATOR                                                                                           
 'yalpha_fc F'                                                                                      
 YALPHA                                                                                             
 'FC F  01'                                                                                         
 COMFACTOR                                                                                          
 1.0D00                                                                                             
.OPERATOR                                                                                           
 'zalpha_fc F'                                                                                      
 ZALPHA                                                                                             
 'FC F  01'                                                                                         
 COMFACTOR                                                                                          
 1.0D00                                                                                             
# ...                                                                                               
.OPERATOR                                                                                           
 'xalpha_fc Mg'                                                                                     
 XALPHA                                                                                             
 'FC Mg 02'                                                                                         
 COMFACTOR                                                                                          
 1.00D0                                                                                             
.OPERATOR                                                                                           
 'yalpha_fc Mg'                                                                                     
 YALPHA                                                                                             
 'FC Mg 02'                                                                                         
 COMFACTOR                                                                                          
 1.0D00                                                                                             
.OPERATOR                                                                                           
 'zalpha_fc Mg'                                                                                     
 ZALPHA                                                                                             
 'FC Mg 02'                                                                                         
 COMFACTOR                                                                                          
 1.0D00                                                                                             
*END OF                                                                                             


