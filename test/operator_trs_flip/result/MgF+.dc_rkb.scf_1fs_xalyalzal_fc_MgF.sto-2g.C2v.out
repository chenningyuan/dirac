**DIRAC
.TITLE
  CaF
.WAVE F ! Activate integral and wave functions modules
.PROPERTIES ! Activate property module (dipole moment; polarizability...)
**GENERAL
.DIRECT
1 1 1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
2
*READIN
.UNCONTRACTED
**HAMILTONIAN
!.SPINFREE
!.LEVY-LEBLOND
#.BSS
#999
#.ONESTEP
#.CMPEIG
.PRINT
2
!.ONESYS
.INTFLG
1 1 0
**WAVE FUNCTIONS ! What method (DHF,MP2,CC..)
.DHF
*DHFCAL ! DHF specifications...
.CLOSED SHELL
20
#.OPEN SHELL
#1
#1/2
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-8  1.0D-6
############################################################
**PROPERTIES ! Calculating of properties...
.PRINT
2
#.RHONUC
*EXPECTATION
#.ORBANA
.PRINT
2
.OPERATOR
 'xalpha_fc'
 XALPHA
 'FC F  01'
 COMFACTOR
 1.00D0
.OPERATOR
 'yalpha_fc'
 YALPHA
 'FC F  01'
 COMFACTOR
 1.0D00
.OPERATOR
 'zalpha_fc'
 ZALPHA
 'FC F  01'
 COMFACTOR
 1.0D00
 TRS_FLIP
# ...
.OPERATOR
 'xalpha_fc'
