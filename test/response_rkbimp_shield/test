#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()

f.add(from_string = '@            isotropic shielding',
      num_lines   = 5,
      tolerance   = 0.0002)

test_run.execute(['rkb.inp'], ['He.mol'], f, args='--outcmo')
test_run.execute(['rkbimp.inp'], ['He.mol'], f, args='--incmo')
test_run.execute(['ukb.inp'], ['He.mol'], f)

os.unlink('DFCOEF')

sys.exit(0)
