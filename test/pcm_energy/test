#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(string    = 'Solvation energy',
      tolerance = 1.0e-5)

test_run.execute(['nonrel.inp', 'levy.inp', 'dc.inp'], ['CH4.mol'], f, args='--put @pcmsolver.inp')

sys.exit(0)
