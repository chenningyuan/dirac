#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string  = '   Electronic energy',
      num_lines    = 1,
      tolerance    = 1.0e-10)
f.add(from_string  = '   Solvation energy',
      num_lines    = 1,
      tolerance    = 1.0e-8)
f.add(from_string  = '   Total energy',
      num_lines    = 1,
      tolerance    = 1.0e-10)

test_run.execute(['nonrel.inp', 'levy.inp', 'dc.inp', 'dc-skipss.inp', 'dc-lda.inp', 'levy-lda.inp'], ['CH4.mol'], f, args='--put @pcmsolver.inp')

sys.exit(0)
