#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'no.    eigenvalue (eV)   mean-res.',
      nr_lines    = 4,
      tolerance   = 1.0e-4,
      mask        = [1, 2, 3])

test_run.execute(['adclevel1_real.inp', 'adclevel2_real.inp', 'adclevel3_real.inp'], ['ne_d2h.mol'], f, args='--mw=64 --aw=130')
test_run.execute(['hcn_complex_1.inp', 'hcn_complex_2.inp', 'hcn_complex_3.inp'], ['hcn_cs.mol'], f, args='--mw=64 --aw=130')

sys.exit(0)
