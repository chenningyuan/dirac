#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = ' Energy eigenvalues in atomic units',
      to_re       = 'Relative real eigenvalues in other units;',
      rel_tolerance = 1.0e-5)

# have to incorporate c2h, check why it is crashing
test.run(['eom_ip_dc_inv.inp', 'eom_ea_dc_inv.inp'], ['f2_d2h.mol'], f, args='--mw=110')
test.run(['eom_ip_dc_inv_ci.inp', 'eom_ea_dc_inv_ci.inp'], ['f2_ci.mol'], f, args='--mw=110')

test.run(['eom_ip_dc_noinv.inp', 'eom_ea_dc_noinv.inp'], ['f2_d2.mol', 'f2_c2v.mol', 'f2_c2.mol', 'f2_c2.mol'], f, args='--mw=110')
test.run(['eom_ip_dc_noinv_c1.inp', 'eom_ea_dc_noinv_c1.inp'], ['f2_c1.mol'], f, args='--mw=110')

test.run(['eom_ee_dc_inv.inp'], ['f2_d2h.mol'], f, args='--mw=110')
test.run(['eom_ee_dc_noinv.inp'], ['f2_d2.mol', 'f2_c2v.mol'], f, args='--mw=110')
sys.exit(test.return_code)
