#test.run(['eom_ea_dc_inv_ci.inp'],   ['f2_ci.mol'], f, args='--mw=110')

# at this time only real groups work for eom-ee
test.run(['eom_ee_dc_inv.inp'],      ['f2_d2h.mol'], f, args='--mw=110')


