#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()

f.add(from_string = 'Electronic energy',
      num_lines   = 3,
      tolerance   = 1.0e-9)
f.add(from_string = 'Value of electronic part',
      num_lines   = 3,
      ignore_sign = True,
      tolerance   = 1.0e-6)

test_run.execute(['qrpa1.inp', 'excprp1.inp'], ['LiH.mol'], f)
test_run.execute(['tpa1.inp'], ['He.mol'], f)

sys.exit(0)
