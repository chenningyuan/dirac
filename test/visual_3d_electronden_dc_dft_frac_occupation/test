#!/usr/bin/env python

import os
import sys

#
# prepare environment, define functions
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5

#
# run tests
#

test = TestRun(__file__, sys.argv)

os.symlink(os.path.join(os.path.dirname(__file__), '..', 'testdata', 'grid_visual_3D.h5'), os.path.join(test.work_dir, 'grid.h5'))

test.run(['dc.inp'], ['h2o.mol'], args='--outcmo')
test.run(['vis_total_orbstring.inp'], ['h2o.mol'], args='--incmo --put="grid.h5" --get="*.h5"')
test.run(['vis_1s.inp'], ['h2o.mol'], args='--incmo --put="grid.h5" --get="*.h5"')
test.run(['vis_2s.inp'], ['h2o.mol'], args='--incmo --put="grid.h5" --get="*.h5"')

#
# clean
#

os.remove(os.path.join(test.work_dir, 'CHECKPOINT.h5'))   
os.remove(os.path.join(test.work_dir, 'OPERATORS.h5'))   
os.unlink(os.path.join(test.work_dir, 'grid.h5'))

#
# compare generated data with reference
#

rs = CompareHDF5(test.work_dir)

testset = ['ed_total_orbstring', 'ed_1s', 'ed_2s']
for t in testset:

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='single',\
              gf_label='/result/grid/ndim')

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='single',\
              gf_label='/result/grid/nr_points_total')

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='array',\
              gf_label='/result/grid_function/'+t+'/visualize/values/',
              gf_test_key='t0_icomp_1')


