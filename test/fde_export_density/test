#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = ' Output FDE data to XML file:GRIDOUT',
      num_lines   = 6,
      tolerance   = 1.0e-7)

test_run.execute(['fde_dc_hf_exportdens_short.inp'],  ['water.sto6g.mol'], f, args='--mw=80 --put="vemb.grid GRIDOUT"')
test_run.execute(['fde_dc_lda_exportdens_short.inp'], ['water.sto6g.mol'], f, args='--mw=80 --put="vemb.grid GRIDOUT numerical_grid"')
test_run.execute(['fde_dc_mp2_exportdens_short.inp'], ['water.sto6g.mol'], f, args='--mw=40 --put="vemb.grid GRIDOUT" --aw=90')

sys.exit(0)
