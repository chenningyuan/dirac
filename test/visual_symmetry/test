#!/usr/bin/env python

import os
import sys
import shutil
from pathlib import Path

#
# prepare environment, define functions
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5
test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Final grid_function values in grid points:',
      num_lines = 29,
      rel_tolerance = 1.0e-6)

#
# prepare grid files
#
grid_3d_h5=Path(test.work_dir, 'grid.h5')
grid_3d_h5.unlink(missing_ok=True)
grid_3d_h5=grid_3d_h5.symlink_to(Path(Path(__file__).parents[1].resolve(), 'testdata', 'grid_visual_3D.h5'))


#
# run tests
#

for m in ['ne_c1.mol', 'ne_c2.mol', 'ne_c2v.mol', 'ne_cs.mol', 'ne_d2.mol']:
    test.run(['rspE.inp'], [m], args='--outcmo --get="RESPONSE.h5"')
    test.run(['visR1.inp'], [m], f, args='--incmo --put="grid.h5"')
    test.run(['visE1.inp'], [m], f, args='--incmo --put="grid.h5 RESPONSE.h5"')
    test.run(['rspB.inp'], [m], args='--outcmo --get="RESPONSE.h5"')
    test.run(['visB1.inp'], [m], f, args='--incmo --put="grid.h5 RESPONSE.h5"')
    
for m in ['ne_auto.mol', 'ne_c2h.mol', 'ne_ci.mol', 'ne_d2h.mol']:
    test.run(['rspE.inp'], [m], args='--outcmo --get="RESPONSE.h5"')
    test.run(['visR2.inp'], [m], f, args='--incmo --put="grid.h5"')
    test.run(['visE2.inp'], [m], f, args='--incmo --put="grid.h5 RESPONSE.h5"')
    test.run(['rspB.inp'], [m], args='--outcmo --get="RESPONSE.h5"')
    test.run(['visB2.inp'], [m], f, args='--incmo --put="grid.h5 RESPONSE.h5"')

