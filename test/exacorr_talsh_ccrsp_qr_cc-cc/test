#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f1 = Filter()

f1.add(from_string = '*************CC-CC quadratic response*********',
      num_lines   = 3,
      rel_tolerance   = 1.0e-7)

test.run(['cc_ccpvdz_qr_0.1,0.15.inp'], ['h2o.xyz'], f1)
test.run(['cc_ccpvdz_qr_yxlz_ll_0.065600.inp'], ['ar.xyz'], f1)
test.run(['cc_ccpvdz_qr_yxlz_x2c_0.065600.inp'], ['ar.xyz'], f1)
sys.exit(test.return_code)
