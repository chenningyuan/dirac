#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(string        = ' Final CI energies',
      abs_tolerance = 1.0e-6)

f.add(from_string   = ' REORDERED DESCENDING OCCUPATION',
      num_lines     = 5,
      abs_tolerance = 2.0e-4)

test.run(['krci_gascip.inp'], ['h2o.xyz'], f)

if os.environ.get("ONLY_GASCIP") is None:
  test.run(['krci_luciarel.inp'], ['h2o.xyz'], f)

sys.exit(test.return_code)
