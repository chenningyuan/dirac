 **DIRAC                                                                        
  
 .TITLE                                                                         
  
 Magnesium atom. Fockspace test calculations.                                   
  
 .WAVE F                                                                        
  
 .4INDEX                                                                        
  
 **WAVE FUNCTIONS                                                               
  
 .DHF                                                                           
  
 .RELCCSD                                                                       
  
 *DHFCAL                                                                        
  
 .EVCCNV                                                                        
  
 1.0E-10                                                                        
  
 .CNVINT                                                                        
  
 0.01 0.0001                                                                    
  
 .CLOSED SHELL                                                                  
  
 4 6                                                                            
  
 **MOLTRA                                                                       
  
 .ACTIVE                                                                        
  
 energy -1000.0 1000.0 1.0                                                      
  
 energy -1000.0 1000.0 1.0                                                      
  
 *END OF                                                                        
  
                                                                                
  
  &RELCCSD DOFSPC=T DOENER=F &END                                               
  
  &CCFSPC MAXIT=50, NACTH=0,0,3,3, NACTP=2,2,3,3, FSSECT=1,1,1,1,1,1      &END  
  
                                                                                
  


