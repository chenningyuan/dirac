#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string  = '@   xx',
      num_lines    = 1,
      tolerance    = 1.0e-5)
f.add(from_string  = '@   yy',
      num_lines    = 1,
      tolerance    = 1.0e-5)
f.add(from_string  = '@   zz',
      num_lines    = 1,
      tolerance    = 1.0e-5)
f.add(from_string  = '@   average',
      num_lines    = 1,
      tolerance    = 1.0e-5)
f.add(from_string  = '@   anisotropy',
      num_lines    = 1,
      tolerance    = 1.0e-5)

test_run.execute(['pcm-scf-levy.inp'], ['CH4.mol'], args='--put @pcmsolver.inp --outcmo')
os.unlink('pcm-scf-levy_CH4.out')
test_run.execute(['pcm-levy.inp'], ['CH4.mol'], f, args='--put @pcmsolver.inp --incmo')
test_run.execute(['pcm-levy-skipoit.inp'], ['CH4.mol'], f, args='--put @pcmsolver.inp --incmo')
os.unlink('DFCOEF')

test_run.execute(['pcm-scf-levy.inp'], ['H2O.mol'], args='--put @pcmsolver.inp --outcmo')
os.unlink('pcm-scf-levy_H2O.out')
test_run.execute(['pcm-levy.inp'], ['H2O.mol'], f, args='--put @pcmsolver.inp --incmo')
test_run.execute(['pcm-levy-skipoit.inp'], ['H2O.mol'], f, args='--put @pcmsolver.inp --incmo')
os.unlink('DFCOEF')

test_run.execute(['pcm-scf-dc.inp'], ['CH4.mol'], args='--put @pcmsolver.inp --outcmo')
os.unlink('pcm-scf-dc_CH4.out')
test_run.execute(['pcm-dc.inp'], ['CH4.mol'], args='--put @pcmsolver.inp --incmo')
test_run.execute(['pcm-dc-skipoit.inp'], ['CH4.mol'], f, args='--put @pcmsolver.inp --incmo')
os.unlink('DFCOEF')

test_run.execute(['pcm-scf-dc.inp'], ['H2O.mol'], args='--put @pcmsolver.inp --outcmo')
os.unlink('pcm-scf-dc_H2O.out')
test_run.execute(['pcm-dc.inp'], ['H2O.mol'], args='--put @pcmsolver.inp --incmo')
test_run.execute(['pcm-dc-skipoit.inp'], ['H2O.mol'], f, args='--put @pcmsolver.inp --incmo')
os.unlink('DFCOEF')

sys.exit(0)
