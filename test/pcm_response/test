#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string  = '@   xx',
      nr_lines     = 1,
      tolerance    = 1.0e-5)
f.add(from_string  = '@   yy',
      nr_lines     = 1,
      tolerance    = 1.0e-5)
f.add(from_string  = '@   zz',
      nr_lines     = 1,
      tolerance    = 1.0e-5)
f.add(from_string  = '@   average',
      nr_lines     = 1,
      tolerance    = 1.0e-5)

test_run.execute(['pcm-levy.inp'], ['CH4.mol', 'H2O.mol'], f, args='--put @pcmsolver.inp')
test_run.execute(['pcm-dc.inp'], ['CH4.mol', 'H2O.mol'], args='--put @pcmsolver.inp')
test_run.execute(['pcm-dc-skipoit.inp'], ['CH4.mol', 'H2O.mol'], args='--put @pcmsolver.inp')

sys.exit(0)
