#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(string = 'Final KR-MCSCF energy',
      rel_tolerance = 1.0e-5)

test.run(['mcscf_acmout.inp'], ['c2v.mol'])
test.run(['mcscf_acmoin_noscf.inp'], ['c2.mol'],'--put "mcscf_acmout_c2v.h5=DFACMO.h5"')
test.run(['mcscf_acmoin_noscf.inp'], ['c1.mol'],'--put "mcscf_acmout_c2v.h5=DFACMO.h5"')

sys.exit(test.return_code)
