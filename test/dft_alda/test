#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(string = 'Electronic energy',
      tolerance = 1.0e-7)
f.add(string = ' Nonrel. sym.:',
      tolerance = 1.0e-4)

test_run.execute(['pbe0_alda+.inp', 'pbe0_alda-.inp', 'pbe0_alda.inp', 'pbe0_xalda+.inp', 'pbe0_xalda-.inp', 'pbe0_xalda.inp'], ['zn.mol'], f)

sys.exit(0)
