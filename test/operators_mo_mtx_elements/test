#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()

f.add(from_string = 'Printout of all property elements',
      to_string   = 'End of property elements printout.',
      ignore_sign = True,
      rel_tolerance   = 1.0e-6)

test.run(['Ne.dc_rkb.2fs.scf_prptra_alpha_fc.inp'],           ['Rn_Ne-like.mol'], f, args='')
test.run(['Ne.dc_rkb.2fs.scf_prptra_dsigmadot-nucfield.inp'], ['Rn_Ne-like.mol'], f, args='')
test.run(['Ne.dc_rkb.2fs.scf_prptra_ibetagama_edm.inp'],      ['Rn_Ne-like.mol'], f, args='')
test.run(['Ne.dc_sf.2fs.scf_prptra_x-y-z-dipole.inp'],        ['Rn_Ne-like.mol'], f, args='')
test.run(['Ne.levyle.2fs.scf_prptra_xy2z3.inp'],              ['Rn_Ne-like.mol'], f, args='')


sys.exit(test.return_code)
