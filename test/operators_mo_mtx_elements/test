#!/usr/bin/env python

import os
import sys
sys.path.append(os.path.join(os.path.dirname(__file__), '..'))

from runtest import version_info, get_filter, cli, run
from runtest_config import configure

assert version_info.major == 2

# miro: deactivate checking of numbers due to degeneracy causing them to be place in various places (example: px,py,pz shells)
#f = [
#    get_filter(from_string='Printout of all property elements',
#               to_string   = 'End of property elements printout.',
#               ignore_sign = True,
#               rel_tolerance   = 1.0e-6)
#]

f = [
    get_filter(from_string='Property elements of the',
               to_string  = 'Printout of all property elements'
               )
]


options = cli()

ierr = 0
for inp in ['Ne.dc_rkb.2fs.scf_prptra_alpha_fc.inp', 
            'Ne.dc_rkb.2fs.scf_prptra_dsigmadot-nucfield.inp', 
            'Ne.dc_sf.2fs.scf_prptra_x-y-z-dipole.inp',
            'Ne.levyle.2fs.scf_prptra_xy2z3.inp',
            'Ne.dc_rkb.2fs.scf_prptra_ibetagama_edm.inp']:
    for mol in ['Rn_Ne-like.mol']:
        ierr += run(options,
                    configure,
                    input_files=[inp, mol],
                    filters={'out': f})

sys.exit(ierr)

