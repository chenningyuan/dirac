#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

# empty filter - only passing run
f = Filter()

bas_dirs=['basis','basis_dalton','basis_ecp']
basis_set_files=[]
for bas_dir in bas_dirs:
   basis_set_files=( [os.path.join('..','..',bas_dir,fn) for fn in next(os.walk(os.path.join('..','..',bas_dir)))[2]] ) + basis_set_files

# set the default return code
tests_run=0
tests_crashed=0
tests_passed=0
# read each basis set file content
for bf in basis_set_files:
   infile = open(bf, 'r')
   data=infile.readlines()
   for line in data:
       # basis_dalton/NQvD contains "a 1 2", neglect through line[2:5].count(' ')==0
       if (line.find("A ")==0 or line.find("a ")==0) and line[2:6].isdigit and line[2:5].count(' ')==0:
           Z9Q=int(line[2:6])
           basis_set_file=os.path.basename(bf)
           args_str='--replace basis_set='+basis_set_file+'  --replace Z9Q='+str(Z9Q)
           #miro: needs try-except scheme because first error in test.run ends the loop
           try:
               test.run( ['input_test.inp'], ['element.mol'], f, args=args_str, print_args=True )
               tests_passed=tests_passed+1
           except:
               tests_crashed=tests_crashed+1
               print >> sys.stderr,tests_crashed, '. CRASHED: basis set file=',basis_set_file,' element Z9Q=',str(Z9Q)

if tests_crashed > 0 : print  >> sys.stderr, "\n BASIS INPUT READING TESTS PASSED: ",tests_passed," vs CRASHED: ",tests_crashed,"/",tests_run

sys.exit(tests_crashed)
