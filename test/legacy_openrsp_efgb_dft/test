#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = '           Electric-field-gradient-induced',
      num_lines   = 12,
      tolerance   = 1.0e-6)

test_run.execute(['lda.inp', 'blyp.inp', 'blyp_shifted.inp'], ['mol.mol'], f)

sys.exit(0)
