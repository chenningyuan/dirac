#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()

f.add(from_string = 'All nonzero property elements',
      to_string   = 'End of printout of nonzero property elements',
      ignore_sign = True,
      rel_tolerance   = 1.0e-6)

test.run(['Xe.dc_rkb.2fs.scf_prptra_alpha_fc.inp'], ['Xe.dyall-v2z.lsym.mol'], f, args='--put "DFPCMO.Xe.dcrkb.scf-30-24.dyallv2z.lsym=DFPCMO"')

test.run(['Xe.dc_rkb.2fs.scf_prptra_dsigmadot-nucfield.inp'], ['Xe.dyall-v2z.lsym.mol'], f, args='--put "DFPCMO.Xe.dcrkb.scf-30-24.dyallv2z.lsym=DFPCMO"')

test.run(['Xe.dc_rkb.2fs.scf_prptra_ibetagama_edm.inp'], ['Xe.dyall-v2z.lsym.mol'], f, args='--put "DFPCMO.Xe.dcrkb.scf-30-24.dyallv2z.lsym=DFPCMO"')

sys.exit(test.return_code)
