#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = ' TOTAL ENERGY',
      num_lines   = 11,
      tolerance   = 1.0e-8)

test_run.execute(['he.inp'], ['he.xyz'], f, args='--get="X2CMAT aoo2esoc.002"')
shutil.copy('X2CMAT', 'X2CMAT.002')

test_run.execute(['li.inp'], ['li.xyz'], f, args='--get="X2CMAT aoo2esoc.003"')
shutil.copy('X2CMAT', 'X2CMAT.003')

test_run.execute(['lihe-4c.inp'], ['lihe.xyz'], f, args='--get=X2CMAT')
shutil.copy('X2CMAT', 'X2CMAT.000')

# molecular U matrix (from molecular core h1^{4c}) + AMFI 2e-SO corrections
test_run.execute(['molecular-x2c-amfisoc.inp'], ['lihe.xyz'], f)

# molecular U matrix (from molecular core h1^{4c}) + atomic 2e-SO corrections
test_run.execute(['molecular-x2c-aoosoc.inp'], ['lihe.xyz'], f, args='--put="aoo2esoc*"')

# molecular U matrix (from molecular fock^{4c}) + atomic 2e-SO corrections
test_run.execute(['molecular-fragment-x2c-aoosoc.inp'], ['lihe.xyz'], f, args='--put="aoo2esoc* X2CMAT.000"')

# atomic U matrices + atomic 2e-SO corrections
test_run.execute(['atomic-x2c-aoosoc.inp'], ['lihe.xyz'], f, args='--put="X2CMAT.002 X2CMAT.003 aoo2esoc*"')

test_run.execute(['atoms.inp'], ['atoms.xyz'],
                 args='--replace closed_occ="4" --replace open_e="5" --replace open_orb="6" --replace myatom="F" --get="X2CMAT aoo2esoc.009"')
shutil.copy('X2CMAT', 'X2CMAT.009')

test_run.execute(['atoms.inp'], ['atoms.xyz'],
                 args='--replace closed_occ="12" --replace open_e="4" --replace open_orb="6" --replace myatom="S" --get="X2CMAT aoo2esoc.016"')
shutil.copy('X2CMAT', 'X2CMAT.016')

# molecular U matrix (from molecular core h1^{4c}) + AMFI 2e-SO corrections
test_run.execute(['large-molecular-x2c-amfisoc.inp'], ['sf6.xyz'], f)

# molecular U matrix (from molecular core h1^{4c}) + atomic 2e-SO corrections
test_run.execute(['large-molecular-x2c-aoosoc.inp'], ['sf6.xyz'], f, args='--put="aoo2esoc*"')

# atomic U matrices + AMFI 2e-SO corrections
test_run.execute(['large-atomic-x2c-amfisoc.inp'], ['sf6.xyz'], f, args='--put="X2CMAT.009 X2CMAT.016"')

# atomic U matrices + atomic 2e-SO corrections
test_run.execute(['large-atomic-x2c-aoosoc.inp'], ['sf6.xyz'], f, args='--put="aoo2esoc* X2CMAT.009 X2CMAT.016"')

os.unlink('X2CMAT')
os.unlink('X2CMAT.000')
os.unlink('X2CMAT.002')
os.unlink('X2CMAT.003')
os.unlink('X2CMAT.009')
os.unlink('X2CMAT.016')
os.unlink('aoo2esoc.002')
os.unlink('aoo2esoc.003')
os.unlink('aoo2esoc.009')
os.unlink('aoo2esoc.016')

sys.exit(0)
