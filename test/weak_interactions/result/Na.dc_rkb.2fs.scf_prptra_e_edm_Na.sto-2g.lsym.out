**DIRAC                                                                                             
.TITLE                                                                                              
  Na atom                                                                                           
.WAVE F ! Activate integral and wave functions modules                                              
#.PROPERTIES ! Activate property module (dipole moment; polarizability...)                          
.ANALYZE                                                                                            
.4INDEX                                                                                             
**GENERAL                                                                                           
.DIRECT                                                                                             
1 1 1                                                                                               
# employ Jacobi diagonalization                                                                     
#.DOJACO                                                                                            
.QJACO                                                                                              
**INTEGRALS                                                                                         
.PRINT                                                                                              
0                                                                                                   
.NUCMOD ! 1-Point nucleus, 2-gaussian                                                               
2                                                                                                   
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONIAN                                                                                       
.PRINT                                                                                              
0                                                                                                   
!.ONESYS                                                                                            
.INTFLG                                                                                             
1 1 0                                                                                               
#.URKBAL                                                                                            
**WAVE FUNCTIONS ! What method (DHF,MP2,CC..)                                                       
.SCF                                                                                                
#.RELCCSD                                                                                           
*SCF                                                                                                
# 1s(2) 2s(2) 2p(6)                                                                                 
.CLOSED SHELL                                                                                       
4 6                                                                                                 
# 3s(1)                                                                                             
.OPEN SHELL                                                                                         
1                                                                                                   
1/2,0                                                                                               
.INTFLG ! Specify what 2-el.integrals to include                                                    
1 1 0                                                                                               
.EVCCNV ! Energy convergence...                                                                     
1.0D-9  1.0D-6                                                                                      
#################################################                                                   
**ANALYZE                                                                                           
.MULPOP                                                                                             
*MULPOP                                                                                             
.VECPOP                                                                                             
all                                                                                                 
all                                                                                                 
**MOLTRA                                                                                            
.SCHEME                                                                                             
6                                                                                                   
# all shells                                                                                        
.ACTIVE                                                                                             
3..3                                                                                                
4..6                                                                                                
.PRPTRA                                                                                             
*PRPTRA                                                                                             
# we need this print level to get all operator matrix elements                                      
.PRINT                                                                                              
3                                                                                                   
# eEDM operators                                                                                    
.OPERATOR                                                                                           
 'e_EDM'                                                                                            
 DSIGMADOT                                                                                          
 'XNUCFIEL'                                                                                         
 'YNUCFIEL'                                                                                         
 'ZNUCFIEL'                                                                                         
 COMFACTOR                                                                                          
 1.00D0                                                                                             
*END OF                                                                                             


