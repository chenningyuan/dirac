**DIRAC                                                                                             
.TITLE                                                                                              
  MgF                                                                                               
.WAVE F ! Activate integral and wave functions modules                                              
.ANALYZE                                                                                            
.4INDEX                                                                                             
.PROPERTIES                                                                                         
**GENERAL                                                                                           
.DIRECT                                                                                             
1 1 1                                                                                               
**INTEGRALS                                                                                         
.PRINT                                                                                              
1                                                                                                   
.NUCMOD ! 1-Point nucleus, 2-gaussian                                                               
2                                                                                                   
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONIAN                                                                                       
.PRINT                                                                                              
2                                                                                                   
.INTFLG                                                                                             
1 1 0                                                                                               
**WAVE FUNCTIONS ! What method (DHF,MP2,CC..)                                                       
.SCF                                                                                                
*SCF                                                                                                
.CLOSED SHELL                                                                                       
20                                                                                                  
.OPEN SHELL                                                                                         
1                                                                                                   
1/2                                                                                                 
.INTFLG ! Specify what 2-el.integrals to include                                                    
1 1 0                                                                                               
.EVCCNV ! Energy convergence...                                                                     
1.0D-8  1.0D-6                                                                                      
#################################################                                                   
**ANALYZE                                                                                           
.MULPOP                                                                                             
*MULPOP                                                                                             
.VECPOP                                                                                             
1..28                                                                                               
**PROPERTIES                                                                                        
! density at the nuclei                                                                             
.RHONUC                                                                                             
.EFFDENS                                                                                            
*EXPECTATION                                                                                        
.ORBANA                                                                                             
**MOLTRA                                                                                            
.SCHEME                                                                                             
6                                                                                                   
# pick up only the valence  open-shell spinor of interest                                           
.ACTIVE                                                                                             
11                                                                                                  
.PRPTRA                                                                                             
*PRPTRA                                                                                             
# we need this print level to get matrix elements                                                   
.PRINT                                                                                              
3                                                                                                   
#### first, density from PVC operator                                                               
.OPERATOR                                                                                           
 'xalpha_PV F'                                                                                      
 XALPHA                                                                                             
 'PVCF  01'                                                                                         
 COMFACTOR                                                                                          
 1.00D0                                                                                             
.OPERATOR                                                                                           
 'yalpha_PV F'                                                                                      
 YALPHA                                                                                             
 'PVCF  01'                                                                                         
 COMFACTOR                                                                                          
 1.0D00                                                                                             
.OPERATOR                                                                                           
 'zalpha_PV F'                                                                                      
 ZALPHA                                                                                             
 'PVCF  01'                                                                                         
 COMFACTOR                                                                                          
 1.0D00                                                                                             
# ...                                                                                               
.OPERATOR                                                                                           
 'xalpha_PV Rn'                                                                                     
 XALPHA                                                                                             
 'PVCRn 02'                                                                                         
 COMFACTOR                                                                                          
 1.00D0                                                                                             
.OPERATOR                                                                                           
 'yalpha_PV Rn'                                                                                     
 YALPHA                                                                                             
 'PVCRn 02'                                                                                         
 COMFACTOR                                                                                          
 1.0D00                                                                                             
.OPERATOR                                                                                           
 'zalpha_PV Rn'                                                                                     
 ZALPHA                                                                                             
 'PVCRn 02'                                                                                         
 COMFACTOR                                                                                          
 1.0D00                                                                                             
#                                                                                                   
# density from the FC operator                                                                      
#                                                                                                   
#  comfactor is (3/4*pi*g_e)=1/8.3872954891254192=.11922794437093028553, numerically shortened to 0.
