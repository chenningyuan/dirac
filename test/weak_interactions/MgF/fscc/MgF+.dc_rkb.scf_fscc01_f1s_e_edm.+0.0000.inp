**DIRAC
.TITLE
  MgF, ^2Sigma
.WAVE F 
.ANALYZE
.4INDEX
**GENERAL
.DIRECT
1 1 1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
2
*READIN
.UNCONTRACTED
**HAMILTONIAN
.PRINT
2
.INTFLG
1 1 0
# T- operator - employ it only with the KU wave-function !
# this operator is carrying factor of 2 !
.OPERATOR
 'e_EDM'
 DSIGMADOT
 'XNUCFIEL'
 'YNUCFIEL'
 'ZNUCFIEL'
 COMFACTOR
 0.0000
# TRS_FLIP
**WAVE FUNCTIONS ! What method (DHF,MP2,CC..)
.SCF
.RELCCSD
*SCF
.CLOSED SHELL
20  
#.OPEN SHELL
#1
#1/2
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-10  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
1..28
**MOLTRA
.SCHEME
6
# freeze 1s(2) Mg, 1s(2) F                       
.ACTIVE
energy  -10.0  1000.0  0.1
*END OF

 # 17 MgF electrons in the active space
 &RELCCSD TIMING=T, IPRNT=1, DOFSPC=T, DOENER=F &END
 &CCFSPC MAXIT=50, NACTH=0,0, NACTP=3,3, FSSECT=1,1,0,0,0,0,  &END
 &CCSORT USEOE=T &END


