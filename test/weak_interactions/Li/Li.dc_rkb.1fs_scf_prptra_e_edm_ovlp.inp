**DIRAC
.TITLE
  Li atom
.WAVE F ! Activate integral and wave functions modules
#.PROPERTIES ! Activate property module (dipole moment; polarizability...)
.ANALYZE
.4INDEX
**GENERAL
.DIRECT
1 1 1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
2
*READIN
.UNCONTRACTED
**HAMILTONIAN
.PRINT
2
!.ONESYS
.INTFLG
1 1 0
#.URKBAL
**WAVE FUNCTIONS ! What method (DHF,MP2,CC..)
.SCF
#.RELCCSD
*SCF
# 1s(2) 
.CLOSED SHELL
2 
# 2s(1)
.OPEN SHELL
1
1/2
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-9  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
all
**MOLTRA
.SCHEME
6
# take all occupied shells into consideration
.ACTIVE
all
.PRPTRA
*PRPTRA
# we need this print level to get all operator matrix elements
.PRINT
15
# eEDM operators
.OPERATOR
 'e_EDM x' 
 XSIGMA
 'OVERLAP'
 COMFACTOR
 2.00D0
.OPERATOR
 'e_EDM y' 
 YSIGMA
 'OVERLAP'
 COMFACTOR
 2.00D0
.OPERATOR
 'e_EDM z' 
 ZSIGMA
 'OVERLAP'
 COMFACTOR
 2.00D0
# dipole operators
.OPERATOR
 XDIPLEN
 COMFACTOR
 1.00D0
.OPERATOR
 YDIPLEN
 COMFACTOR
 1.00D0
.OPERATOR
 ZDIPLEN
 COMFACTOR
 1.00D0 
*END OF

 &RELCCSD TIMING=T, IPRNT=1, DOSORT=T, DOENER=F, DOFOPR=F, DOSOPR=T, NELEC=2,1, &END
 &CCSOPR MAXIT=50, NTOL=10, NAOPER=3, NBOPER=3,
   NAMEA='e_EDM x','e_EDM y','e_EDM z',
   NAMEB='XDIPLEN','YDIPLEN','ZDIPLEN',
 &END

