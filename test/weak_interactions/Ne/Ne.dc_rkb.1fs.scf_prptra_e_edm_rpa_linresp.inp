**DIRAC
.TITLE
  Ne atom
.WAVE F ! Activate integral and wave functions modules
.PROPERTIES ! Activate property module (dipole moment; polarizability...)
.ANALYZE
.4INDEX
**GENERAL
.DIRECT
1 1 1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
2
*READIN
#.UNCONTRACTED
**HAMILTONIAN
.PRINT
2
!.ONESYS
.INTFLG
1 1 0
#.URKBAL
**WAVE FUNCTIONS ! What method (DHF,MP2,CC..)
.SCF
.RELCCSD
*SCF
# 1s(2) 2s(2) 2p(6)
.CLOSED SHELL
10  
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-9  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
all   
**PROPERTIES
*LINEAR RESPONSE
.SKIPEP
.CNVINT
0.01 0.0001
.THRESH
1.0E-10
# eEDM operator
.A OPERATOR 
 'e_EDM'
  DSIGMADOT
 'XNUCFIEL'
 'YNUCFIEL'
 'ZNUCFIEL'
 COMFACTOR
 2.00D0
# dipole operators
.B OPERATOR 
 XDIPLEN
 COMFACTOR
 1.00D0
.B OPERATOR
 YDIPLEN
 COMFACTOR
 1.00D0
.B OPERATOR
 ZDIPLEN
 COMFACTOR
 1.00D0 
**MOLTRA
.SCHEME
6
# take all occupied shells into consideration
.ACTIVE
all 
.PRPTRA
*PRPTRA
# we need this print level to get all operator matrix elements
.PRINT
3  
# eEDM operator
.OPERATOR
 'e_EDM '
  DSIGMADOT
 'XNUCFIEL'
 'YNUCFIEL'
 'ZNUCFIEL'
 COMFACTOR
 2.00D0
# dipole operators #
.OPERATOR
 XDIPLEN
 COMFACTOR
 1.00D0
.OPERATOR
 YDIPLEN
 COMFACTOR
 1.00D0
.OPERATOR
 ZDIPLEN
 COMFACTOR
 1.00D0 
*END OF

 &RELCCSD TIMING=T, IPRNT=1, DOSORT=T, DOENER=F, DOFOPR=F, DOSOPR=T, NELEC=5,5  &END
 &CCSOPR MAXIT=50, NTOL=10, NAOPER=1, NBOPER=3,
   NAMEA='e_EDM',
   NAMEB='XDIPLEN','YDIPLEN','ZDIPLEN',
 &END

