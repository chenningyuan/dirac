#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = '   * state  1(0g  )         * state',
      num_lines    = 7,
      ignore_sign = True)
f.add(string = '1        0g',
      ignore_sign = True)
f.add(string = '1        4u',
      ignore_sign = True)

test_run.execute(['h2.inp'], ['H2.mol'], f)

sys.exit(0)
