#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = '   * state  1(0g  )         * state',
      nr_lines    = 7,
      ignore_sign = True)
f.add(from_string = '1        0g',
      nr_lines    = 1,
      ignore_sign = True)
f.add(from_string = '1        4u',
      nr_lines    = 1,
      ignore_sign = True)

test_run.execute(['h2.inp'], ['H2.mol'], f)

sys.exit(0)
