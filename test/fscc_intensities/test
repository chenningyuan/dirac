#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Excitation energies and intensities',
      num_lines   = 10,
      ignore_sign = True,
      tolerance   = 1.0e-5)

test_run.execute(['excitations.inp'], ['H2O.mol'], f)

sys.exit(0)
