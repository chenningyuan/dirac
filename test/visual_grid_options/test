#!/usr/bin/env python

import os
import sys

#
# prepare environment, define functions
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5

#
# run tests: output to HDF5
#

test = TestRun(__file__, sys.argv)

os.symlink(os.path.join(os.path.dirname(__file__), '..', 'testdata', 'grid_visual_3D.h5'), os.path.join(test.work_dir, 'grid_3d.h5'))
os.symlink(os.path.join(os.path.dirname(__file__), '..', 'testdata', 'grid_visual_2D.h5'), os.path.join(test.work_dir, 'grid_2d.h5'))
#os.symlink(os.path.join(os.path.dirname(__file__), '..', 'testdata', 'grid_visual_3D.txt'), os.path.join(test.work_dir, 'grid_3d.txt'))

test.run(['dc.inp'], ['h2o.mol'], args='--outcmo')

#test.run(['vis_2d_hdf5.inp'], ['h2o.mol'], args='--incmo --put="grid_2d.h5" --get="ed_on2Dgrid.h5"')
test.run(['vis_2d.inp'], ['h2o.mol'], args='--incmo --put="grid_2d.h5" --get="ed_on2Dgrid.h5"')

test.run(['vis_3d_hdf5.inp'], ['h2o.mol'], args='--incmo --put="grid_3d.h5" --get="ed_on3Dgrid.h5"')
test.run(['vis_3d.inp'], ['h2o.mol'], args='--incmo --get="ed_on3Dgrid_generated.h5 grid_3d_generated.h5"')
test.run(['vis_3d_old.inp'], ['h2o.mol'], args='--incmo --get="ed_on3Dgrid_generated_old.h5 grid_3d_generated_old.h5"')

test.run(['vis_3d_list.inp'], ['h2o.mol'], args='--incmo --get="ed_on3DgridLIST.h5 grid_3d_fromLIST.h5"')
#test.run(['vis_line.inp'], ['h2o.mol'], args='--incmo --get="ed_onLINE.h5"')
#test.run(['vis_radial.inp'], ['h2o.mol'], args='--incmo --get="ed_onRADIAL.h5"')

#
# compare generated data with reference
#

rs = CompareHDF5(test.work_dir)

# test grid functions
#testset = ["ed_on3Dgrid.h5", "ed_on3DgridTXT.h5", "ed_on3DgridCUBE.h5",  "ed_on3DgridLIST.h5"]
testset = ["ed_on3Dgrid.h5", "ed_on3DgridLIST.h5"]
for t in testset:

    rs.verify(ftest=t,\
              fref='result/ed_3d.h5',\
              typ='array',\
              gf_label='/result/grid_function/ed/visualize/values/',
              gf_test_key='t0_icomp_1')

testset = ["ed_on3Dgrid_generated.h5", "ed_on3Dgrid_generated_old.h5"]
for t in testset:

    rs.verify(ftest=t,\
              fref='result/ed_on3Dgrid_generated.h5',\
              typ='array',\
              gf_label='/result/grid_function/ed/visualize/values/',
              gf_test_key='t0_icomp_1')


# test generated grids
testset = ["grid_3d_fromLIST.h5"]
for t in testset:

    rs.verify(ftest=t,\
              fref='grid_3d.h5',\
              typ='single',\
              gf_label='/result/grid/ndim')

    rs.verify(ftest=t,\
              fref='grid_3d.h5',\
              typ='single',\
              gf_label='/result/grid/nr_points_total')

    for l in ['coor_1', 'coor_2', 'coor_3']:
        rs.verify(ftest=t,\
                  fref='grid_3d.h5',\
                  typ='array',\
                  gf_label='/result/grid/points/',\
                  gf_test_key=l)



testset = ["grid_3d_generated.h5", "grid_3d_generated_old.h5"]
for t in testset:

    rs.verify(ftest=t,\
              fref='result/grid_3d_generated.h5',\
              typ='single',\
              gf_label='/result/grid/ndim')

    rs.verify(ftest=t,\
              fref='result/grid_3d_generated.h5',\
              typ='single',\
              gf_label='/result/grid/nr_points_total')

    for l in ['coor_1', 'coor_2', 'coor_3']:
        rs.verify(ftest=t,\
                  fref='result/grid_3d_generated.h5',\
                  typ='array',\
                  gf_label='/result/grid/points/',\
                  gf_test_key=l)


#WIPtestset = ["ed_on2Dgrid.h5", "ed_onLINE.h5", "ed_onRADIAL.h5"]

#
# clean
#

os.remove(os.path.join(test.work_dir, 'CHECKPOINT.h5'))   
#os.unlink(os.path.join(test.work_dir, 'grid_2d.h5'))
os.unlink(os.path.join(test.work_dir, 'grid_3d.h5'))
