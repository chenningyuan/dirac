#
# clean
#

os.remove(os.path.join(test.work_dir, 'CHECKPOINT.h5'))   
os.remove(os.path.join(test.work_dir, 'OPERATORS.h5'))   
os.unlink(os.path.join(test.work_dir, 'grid_2d.h5'))
os.unlink(os.path.join(test.work_dir, 'grid_3d.h5'))
os.unlink(os.path.join(test.work_dir, 'grid_3d.txt'))

