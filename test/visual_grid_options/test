#test.run(['vis_line.inp'], ['h2o.mol'], args='--incmo --get="ed_onLINE.h5"')
#test.run(['vis_radial.inp'], ['h2o.mol'], args='--incmo --get="ed_onRADIAL.h5"')

#
# compare generated data with reference
#

rs = CompareHDF5(test.work_dir)

testset = ["ed_on3Dgrid.h5", "ed_on3DgridTXT.h5", "ed_on3DgridCUBE.h5",  "ed_on3DgridLIST.h5"]
for t in testset:

    rs.verify(ftest=t+'.h5',\
              fref='result/ed_3d.h5',\
              typ='array',\
              gf_label='/result/grid_function/'+t+'/visualize/values/',
              gf_test_key='t0_icomp_1')


