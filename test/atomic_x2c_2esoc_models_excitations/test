#os.unlink('X2CMAT.016')
#os.unlink('aoo2esoc.002')
#os.unlink('aoo2esoc.003')
#os.unlink('aoo2esoc.009')
#os.unlink('aoo2esoc.016')

sys.exit(test.return_code)
