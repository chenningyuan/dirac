**DIRAC                                                                                             
.TITLE                                                                                              
  atomic test calculations                                                                          
.WAVE FUNCTION                                                                                      
.ANALYZE                                                                                            
.4INDEX                                                                                             
**INTEGRALS                                                                                         
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONIAN                                                                                       
.X2C                                                                                                
*AMFI                                                                                               
.AMFICH                                                                                             
+2                                                                                                  
**WAVE FUNCTION                                                                                     
.SCF                                                                                                
.RELCCSD                                                                                            
*SCF                                                                                                
# Pm-like (Z=61) : ... 4f(14) 5s(0)                                                                 
.CLOSED SHELL                                                                                       
28 32                                                                                               
#.OPEN SHELL                                                                                        
#1                                                                                                  
#1/2,0                                                                                              
.MAXITR                                                                                             
55                                                                                                  
**ANALYZE                                                                                           
.MULPOP                                                                                             
*MULPOP                                                                                             
.VECPOP                                                                                             
1..oo                                                                                               
1..oo                                                                                               
**MOLTRA                                                                                            
# exactly 33 correlated electrons...                                                                
.ACTIVE                                                                                             
energy -50.0  50.0  1.0                                                                             
energy -50.0  50.0  1.0                                                                             
**RELCC                                                                                             
!.ENERGY                                                                                            
.FOCKSP                                                                                             
.TIMING                                                                                             
.PRINT                                                                                              
1                                                                                                   
# 33 correlated electrons, 5s(1) open-shell                                                         
!.NELEC                                                                                             
!6  7  10  10                                                                                       
*CCENER                                                                                             
.NTOL                                                                                               
7                                                                                                   
*CCFSPC                                                                                             
.DOEA                                                                                               
! 5s, 5p12,  5p32 active shells                                                                     
.NACTP                                                                                              
1  1  3  3                                                                                          
.NTOL                                                                                               
8                                                                                                   
*CCSORT                                                                                             
!.USEOE                                                                                             
*END OF                                                                                             


