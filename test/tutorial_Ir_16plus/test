#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

# CCSD(T)
f = Filter()
f.add(from_string = 'Overview of calculated energies',
      num_lines   = 12,
      rel_tolerance   = 1.0e-6)

test.run(['Z61.x2c.2S12.scf_cc33e.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')
test.run(['Z61.x2c.2S12.scf_cc33e_oe.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')

test.run(['Z61.x2c.2P12.scf_cc33e.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120 --get "DFCOEF=DFCOEF.v2z.2P12"')
test.run(['Z61.x2c.2P12.scf_cc33e_oe.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')

test.run(['Z61.x2c.2P32.scf_cc33e.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120 --put "DFCOEF.v2z.2P12=DFCOEF"')
test.run(['Z61.x2c.2P32.scf_cc33e_oe.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120 --put "DFCOEF.v2z.2P12=DFCOEF"')

test.run(['Z61.x2c.2Paver.scf_cc33e.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')
test.run(['Z61.x2c.2Paver.scf_cc33e_oe.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')

test.run(['Z61.x2c.2Paver.scf_cc33e_2P12.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')
test.run(['Z61.x2c.2Paver.scf_cc33e_oe_2P12.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')

test.run(['Z61.x2c.2Paver.scf_cc33e_2P32.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')
test.run(['Z61.x2c.2Paver.scf_cc33e_oe_2P32.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')


# FSCC
f = Filter()
f.add(from_string = ' Energy eigenvalues in atomic units',
      to_re       = 'Relative real eigenvalues in other units;',
      rel_tolerance = 1.0e-5)

test.run(['Z61.x2c.scf_fscc01_33ce_5s5p.2fs.inp'], ['Ir.dyall_v2z.lsym.mol'], f, args='--mw=120')

os.unlink('DFCOEF.v2z.2P12')

sys.exit(test.return_code)
