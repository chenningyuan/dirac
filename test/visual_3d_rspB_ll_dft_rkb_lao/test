#!/usr/bin/env python

import os
import sys
from pathlib import Path

#
# prepare environment, define functions
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5
test = TestRun(__file__, sys.argv)

#
# prepare grid files
#
grid_3d_h5=Path(test.work_dir, 'grid.h5')
grid_3d_h5.unlink(missing_ok=True)
grid_3d_h5=grid_3d_h5.symlink_to(Path(Path(__file__).parents[1].resolve(), 'testdata', 'grid_visual_3D.h5'))

#
# run tests
#

test.run(['ll.inp'], ['h2o.mol'], args='--outcmo')
test.run(['rsp.inp'], ['h2o.mol'], args='--incmo --outcmo --get="*.h5"')

test.run(['vis.inp'], ['h2o.mol'], args='--incmo --put="grid.h5 TBMO.h5 RESPONSE.h5" --get="*.h5"')

#
# compare generated data with reference
#

rs = CompareHDF5(test.work_dir)

testset = ['j', 'ndip']
for t in testset:

    rs.verify(ftest=t+'_Bz_lao_ll_rspvec3_symcon.h5',\
              fref='result/'+t+'_Bz_lao_ll_rspvec3_symcon.h5',\
              typ='single',\
              gf_label='/result/grid/ndim')

    rs.verify(ftest=t+'_Bz_lao_ll_rspvec3_symcon.h5',\
              fref='result/'+t+'_Bz_lao_ll_rspvec3_symcon.h5',\
              typ='single',\
              gf_label='/result/grid/nr_points_total')

    for i in range(1,4):
        rs.verify(ftest=t+'_Bz_lao_ll_rspvec3_symcon.h5',\
                  fref='result/'+t+'_Bz_lao_ll_rspvec3_symcon.h5',\
                  typ='array',\
                  gf_label='/result/grid_function/'+t+'/visualization/values/',
                  gf_test_key='t1_icomp_'+str(i))



testset = ['j']
subtest = ['nodirect_nokappa', 'nodirect_noreorth', 'noreorth_nokappa']
for t in testset:
    for s in subtest:

        rs.verify(ftest=t+'_Bz_lao_ll_rspvec3_symcon_'+s+'.h5',\
                  fref='result/'+t+'_Bz_lao_ll_rspvec3_symcon_'+s+'.h5',\
                  typ='single',\
                  gf_label='/result/grid/ndim')

        rs.verify(ftest=t+'_Bz_lao_ll_rspvec3_symcon_'+s+'.h5',\
                  fref='result/'+t+'_Bz_lao_ll_rspvec3_symcon_'+s+'.h5',\
                  typ='single',\
                  gf_label='/result/grid/nr_points_total')

        for i in range(1,4):
            rs.verify(ftest=t+'_Bz_lao_ll_rspvec3_symcon_'+s+'.h5',\
                      fref='result/'+t+'_Bz_lao_ll_rspvec3_symcon_'+s+'.h5',\
                      typ='array',\
                      gf_label='/result/grid_function/'+t+'/visualization/values/',
                      gf_test_key='t1_icomp_'+str(i))

