#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(string = 'Total energy',
      tolerance = 1.0e-7)

test_run.execute(['hf.inp'], ['ethanol.xyz'], f)
test_run.execute(['emb.inp'], ['methanol.xyz'], f)

sys.exit(0)
