#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(string      = 'Electronic energy',
      rel_tolerance   = 1.0e-7)

test.run(['minimum.inp', 'saddle.inp'], ['ethane_1.mol'], f)
test.run(['constrained.inp'], ['ethane_2.mol'], f)

f = Filter()
f.add(from_string = '                          Redundant internal coordinates',
      num_lines   = 37,
      rel_tolerance   = 1.0e-4)

test.run(['findre.inp'], ['ethane_2.mol'], f)

sys.exit(test.return_code)
