#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(string      = 'Electronic energy',
      tolerance   = 1.0e-7)

test_run.execute(['minimum.inp', 'saddle.inp'], ['ethane_1.mol'], f)
test_run.execute(['constrained.inp'], ['ethane_2.mol'], f)

f = Filter()
f.add(from_string = '                          Redundant internal coordinates',
      num_lines   = 37,
      tolerance   = 1.0e-4)

test_run.execute(['findre.inp'], ['ethane_2.mol'], f)

sys.exit(0)
