#!/usr/bin/env python

import os
import sys

#
# prepare environment, define functions
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5

#
# run tests: output to HDF5
#

test = TestRun(__file__, sys.argv)

os.symlink(os.path.join(os.path.dirname(__file__), '..', 'testdata', 'grid_visual_3D.h5'), os.path.join(test.work_dir, 'grid_3d.h5'))

test.run(['dc.inp'], ['h2o.mol'], args='--outcmo')

test.run(['vis_3d_hdf5out.inp'], ['h2o.mol'], args='--incmo --put="grid.h5" --get="ed.h5"')

#
# compare generated data with reference
#

rs = CompareHDF5(test.work_dir)

testset = ['ed']
for t in testset:

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='array',\
              gf_label='/result/grid_function/'+t+'/visualize/values/',
              gf_test_key='t0_icomp_1')


#
# run tests: output to text files
#

test.run(['vis_3d_txtout.inp'], ['h2o.mol'], args='--incmo --put="grid.h5" --get="plot.3d.scalar"')
test.run(['vis_3d_cubeout.inp'], ['h2o.mol'], args='--incmo --put="grid.h5" --get="plot.3d.cube"')
test.run(['vis_3d_diracout.inp'], ['h2o.mol'], args='--incmo --put="grid.h5"')

#
# compare generated data with reference
#
#WIP

#
# clean
#

os.remove(os.path.join(test.work_dir, 'CHECKPOINT.h5'))   
os.remove(os.path.join(test.work_dir, 'OPERATORS.h5'))   
os.unlink(os.path.join(test.work_dir, 'grid.h5'))

