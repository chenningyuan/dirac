#!/usr/bin/env python

import os
import sys
from pathlib import Path

try:
    import h5py
    h5py_available = True
except:
    h5py_available = False

#
# prepare environment
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5
test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Final grid function values (id=',
      num_lines = 28,
      abs_tolerance = 2.0e-6)
    
#
# run tests
#

test.run(['dc.inp'], ['h2o.mol'], args='--outcmo')

if h5py_available:
    test.run(['vis.inp'], ['h2o.mol'], f, args='--incmo --get="*.h5"')
else:
    test.run(['vis.inp'], ['h2o.mol'], f, args='--incmo')


#
# compare generated data with reference
#

if h5py_available:
    rs = CompareHDF5(test.work_dir)
    
    testset = ['ed', 'rdg', 'ed_sign_lambda2', 'ed_laplacian']
    for t in testset:
    
        rs.verify(ftest=t+'.h5',\
                  fref='result/'+t+'.h5',\
                  typ='single',\
                  gf_label='/result/grid/ndim')
    
        rs.verify(ftest=t+'.h5',\
                  fref='result/'+t+'.h5',\
                  typ='single',\
                  gf_label='/result/grid/nr_points_total')
    
        rs.verify(ftest=t+'.h5',\
                  fref='result/'+t+'.h5',\
                  typ='array',\
                  gf_label='/result/grid_function/'+t+'/visualization/values/',
                  gf_test_key='t0_icomp_1',
                  rel_tolerance=1.e-5)
    
    
    testset = ['ed_gradient']
    for t in testset:
    
        rs.verify(ftest=t+'.h5',\
                  fref='result/'+t+'.h5',\
                  typ='single',\
                  gf_label='/result/grid/ndim')
    
        rs.verify(ftest=t+'.h5',\
                  fref='result/'+t+'.h5',\
                  typ='single',\
                  gf_label='/result/grid/nr_points_total')
    
        for i in range(1,4):
            rs.verify(ftest=t+'.h5',\
                      fref='result/'+t+'.h5',\
                      typ='array',\
                      gf_label='/result/grid_function/'+t+'/visualization/values/',
                      gf_test_key='t1_icomp_'+str(i),
                      rel_tolerance=1.e-5)
    
    testset = ['ed_hessian']
    for t in testset:
    
        rs.verify(ftest=t+'.h5',\
                  fref='result/'+t+'.h5',\
                  typ='single',\
                  gf_label='/result/grid/ndim')
    
        rs.verify(ftest=t+'.h5',\
                  fref='result/'+t+'.h5',\
                  typ='single',\
                  gf_label='/result/grid/nr_points_total')
    
        for i in range(1,10):
            rs.verify(ftest=t+'.h5',\
                      fref='result/'+t+'.h5',\
                      typ='array',\
                      gf_label='/result/grid_function/'+t+'/visualization/values/',
                      gf_test_key='t2_icomp_'+str(i),
                      rel_tolerance=4.e-5)

sys.exit(test.return_code)
