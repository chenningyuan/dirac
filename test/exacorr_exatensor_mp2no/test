#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Orbital           1',
      num_lines   = 9,
      rel_tolerance   = 1.0e-7)

test.run(['hf_get_no_ccpvdz_0.0d.inp'], ['hf.xyz'], f, args='--get="MP2NOs_AO=MP2NOs_AO_all-active_hf-ccpvdz_0.0d_exatensor"')
test.run(['hf_get_no_ccpvdz_1.0d-4.inp'], ['hf.xyz'], f, args='--get="MP2NOs_AO=\
MP2NOs_AO_all-active_hf-ccpvdz_1.0d-4_exatensor"')
test.run(['hcl_get_no_ccpvtz_0.0_subvirtual.inp'], ['hcl.xyz'], f, args='--get="MP2NOs_AO=\
MP2NOs_AO_all-active_hcl-ccpvtz_0.0d_subv_exatensor"')

f = Filter()
f.add(from_string = '    -     Final results from EXACORR     -    ',
      num_lines   = 8,
      rel_tolerance   = 1.0e-8)
f.add(from_string = '* Dipole moment:',
      num_lines   = 9,
      rel_tolerance   = 1.0e-6)
f.add(from_string = '           Total contribution to principal components',
      num_lines   = 15,
      rel_tolerance   = 1.0e-6)

test.run(['hf_canonical_ccpvdz_0.0_test.inp'], ['hf.xyz'], f, args='--put="MP2NOs_AO_all-active_hf-ccpvdz_0.0d_exatensor=\
DFCOEF"')
test.run(['hf_canonical_ccpvdz_16_test.inp'], ['hf.xyz'], f, args='--put="MP2NOs_AO_all-active_hf-ccpvdz_1.0d-4_exatensor=\
DFCOEF"')
test.run(['hcl_fno_ccpvtz_0.0_subvirtual.inp'], ['hcl.xyz'], f, args='--put="MP2NOs_AO_all-active_hcl-ccpvtz_0.0d_subv_exatensor=\
DFCOEF"')

f = Filter()

f.add(from_string = '  The Occupation Number of Natural Orbital',
      num_lines   = 6,
      rel_tolerance   = 1.0e-6)

test.run(['hf_canonical_augccpvtz_25_ana.inp'], ['hf.xyz'], f)
sys.exit(test.return_code)
