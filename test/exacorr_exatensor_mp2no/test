#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Orbital           1',
      num_lines   = 9,
      rel_tolerance   = 5.0e-8)

test.run(['hf_get_no_ccpvtz_0.0d.inp'], ['hf.xyz'], f, args='--get="MP2NOs_AO=MP2NOs_AO_all-active_hf-ccpvtz_0.0d_exatensor"')
test.run(['hf_get_no_ccpvtz_1.0d-3.inp'], ['hf.xyz'], f, args='--get="MP2NOs_AO=\
MP2NOs_AO_all-active_hf-ccpvtz_1.0d-3_exatensor"')

f = Filter()
f.add(from_string = '    -     Final results from EXACORR     -    ',
      num_lines   = 8,
      rel_tolerance   = 5.0e-9)
f.add(from_string = '* Dipole moment:',
      num_lines   = 9,
      rel_tolerance   = 1.0e-6)
f.add(from_string = '* Electric field gradients :',
      num_lines   = 20,
      rel_tolerance   = 1.0e-6)

test.run(['hf_canonical_ccpvtz_0.0_test.inp'], ['hf.xyz'], f, args='--put="MP2NOs_AO_all-active_hf-ccpvtz_0.0d_exatensor=\
DFCOEF"')
test.run(['hf_canonical_ccpvtz_9_test.inp'], ['hf.xyz'], f, args='--put="MP2NOs_AO_all-active_hf-ccpvtz_1.0d-3_exatensor=\
DFCOEF"')

sys.exit(test.return_code)
