#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Overview of calculated energies',
      num_lines   = 4,
      tolerance   = 1.0e-8)

test_run.execute(['srLDA.inp', 'srPBEH.inp', 'srPBES.inp'], ['He2.mol'], f)

sys.exit(0)
