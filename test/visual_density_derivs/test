#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string  = 'Requested density at point(s)',
      num_lines     = 10,
      abs_tolerance = 1.0e-6)

test.run(['response_ez_ez_dc.inp'],               ['ne_d2h.mol'],    args='--get="CHECKPOINT.h5 PAMXVC"')
test.run(['visual_zo_dc_density_gradient.inp'],   ['ne_d2h.mol'], f, args='--copy="CHECKPOINT.h5"')
test.run(['visual_zo_dc_density_hessian.inp'],    ['ne_d2h.mol'], f, args='--copy="CHECKPOINT.h5"')
test.run(['visual_zo_dc_density_laplacian.inp'],  ['ne_d2h.mol'], f, args='--copy="CHECKPOINT.h5"')
test.run(['visual_zo_dc_sign_lambda2.inp'],       ['ne_d2h.mol'], f, args='--copy="CHECKPOINT.h5"')
test.run(['visual_zo_dc_rdg.inp'],                ['ne_d2h.mol'], f, args='--copy="CHECKPOINT.h5"')

os.unlink('CHECKPOINT.h5')
os.unlink('PAMXVC')

sys.exit(test.return_code)
