#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()

f.add(from_string = 'Electronic energy',
      num_lines   = 3,
      rel_tolerance   = 1.0e-9)
f.add(from_string = 'Integrals of operator: CXIKRCCC',
      num_lines   = 20,
      ignore_sign = True,
      rel_tolerance   = 1.0e-9)
f.add(from_string = 'Integrals of operator: CXIKRCCS',
      num_lines   = 20,
      ignore_sign = True,
      rel_tolerance   = 1.0e-9)
f.add(from_string = 'Frequency (real)     Real part              Imaginary part         Convergence',
      num_lines   = 4,
      ignore_sign = True,
      rel_tolerance   = 1.0e-9)

test.run(['bed_cpp.inp'], ['LiH.mol'], f)

sys.exit(test.return_code)
