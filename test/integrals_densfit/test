#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-10)

inp_files = []
inp_files.append('NR_direct_Jengine+df.inp')
inp_files.append('NR_direct_Jengine+LinK+df.inp')
inp_files.append('NR_direct_Jengine+df_LDA.inp')
inp_files.append('NR_direct_Jengine+df_BLYP.inp')
inp_files.append('NR_direct_Jengine+LinK+df_B3LYP.inp')
inp_files.append('NR_direct_Jengine+df_B3LYP.inp')
inp_files.append('2C_SF_direct_Jengine+LinK+df.inp')
inp_files.append('2C_SF_direct_Jengine+df_LDA.inp')
inp_files.append('2C_SF_direct_Jengine+df_BLYP.inp')
inp_files.append('2C_SF_direct_Jengine+df_B3LYP.inp')
inp_files.append('2C_SO_direct_Jengine+df.inp')
inp_files.append('2C_SO_direct_Jengine+LinK+df.inp')
inp_files.append('2C_SO_direct_Jengine+df_LDA.inp')
inp_files.append('2C_SO_direct_Jengine+df_BLYP.inp')
inp_files.append('2C_SO_direct_Jengine+LinK+df_B3LYP.inp')
inp_files.append('2C_SO_direct_Jengine+df_B3LYP.inp')
inp_files.append('2C_GT_direct_Jengine+df.inp')
inp_files.append('2C_GT_direct_Jengine+LinK+df.inp')
inp_files.append('2C_GT_direct_Jengine+df_LDA.inp')
inp_files.append('2C_GT_direct_Jengine+df_BLYP.inp')
inp_files.append('2C_GT_direct_Jengine+LinK+df_B3LYP.inp')
inp_files.append('2C_GT_direct_Jengine+df_B3LYP.inp')

test_run.execute(inp_files, ['Ar.mol'], f)

sys.exit(0)
