#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = '* Dipole moment:',
      num_lines   = 8,
      tolerance   = 1.0e-6)

test_run.execute(['fde_dc_lda_short.inp'],      ['water.sto6g.mol'], f, args='--mw=80 --nw=80 --aw=90 --put=vemb.grid')
test_run.execute(['fde_dc_lda_short.inp'],      ['water.sto6g.c2v'], f, args='--mw=80 --nw=80 --aw=90 --put=vemb.grid')
test_run.execute(['fde_ll_lda_short.inp'],      ['water.sto6g.mol'], f, args='--mw=80 --nw=80 --aw=90 --put=vemb.grid')
test_run.execute(['fde_ll_lda_short.inp'],      ['water.sto6g.c2v'], f, args='--mw=80 --nw=80 --aw=90 --put=vemb.grid')
test_run.execute(['fde_twocomp_lda_short.inp'], ['water.sto6g.mol'], f, args='--mw=80 --nw=80 --aw=90 --put=vemb.grid')
test_run.execute(['fde_twocomp_lda_short.inp'], ['water.sto6g.c2v'], f, args='--mw=80 --nw=80 --aw=90 --put=vemb.grid')
test_run.execute(['fde_dc_cc_short.inp'],       ['water.sto6g.mol'], f, args='--mw=80 --nw=80 --aw=95 --put=vemb.grid')
test_run.execute(['fde_dc_cc_short.inp'],       ['water.sto6g.c2v'], f, args='--mw=80 --nw=80 --aw=95 --put=vemb.grid')

sys.exit(0)
