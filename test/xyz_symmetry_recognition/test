#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'SYMGRP:Point group information', 
      num_lines   = 5)

test.run(['test_xyz.inp'], ['molecule1.xyz'], f)
test.run(['test_xyz.inp'], ['molecule2.xyz'], f)
test.run(['test_xyz.inp'], ['molecule3.xyz'], f)
test.run(['test_xyz.inp'], ['molecule4.xyz'], f)
test.run(['test_xyz.inp'], ['molecule5.xyz'], f)

sys.exit(test.return_code)
