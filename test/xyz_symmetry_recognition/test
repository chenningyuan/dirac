#!/usr/bin/env python

import sys
sys.path.insert(0, '..')

from runtest import version_info, get_filter, cli, run
from runtest_config import configure

assert version_info.major == 2

f = [
    get_filter(from_string='SYMGRP:Point group information',
               num_lines=5,
               rel_tolerance=1.0e-9)
]

options = cli()

ierr = 0
for n in range(1, 19):
    ierr += run(options,
                configure,
                input_files=['test_xyz.inp', 'molecule{0:02}.xyz'.format(n)],
                filters={'out': f})

sys.exit(ierr)
