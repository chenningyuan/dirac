**DIRAC
.TITLE
  Na atom
.WAVE F 
.PROPERTIES 
.ANALYZE
#.4INDEX
**GENERAL
.DIRECT
1 1 1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
2
*READIN
.UNCONTRACTED
**HAMILTONIAN
.PRINT
2
!.ONESYS
.INTFLG
1 1 0
#.URKBAL
**WAVE FUNCTIONS ! What method (DHF,MP2,CC..)
.SCF
.RELCCSD
*SCF
# 1s(2) 2s(2) 2p(6)
.CLOSED SHELL
4 6
# 3s(1)
.OPEN SHELL
1
1/2,0
.EVCCNV ! Energy convergence...
1.0D-9  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
all   
all   
**PROPERTIES 
.PRINT
1
.POLARIZABILITY
*LINEAR RESPONSE
.SKIPEP
.MAXITR
100
.INTFLG
1 1 0
.THRESH
1.0D-9
.PRINT
1
**MOLTRA
.SCHEME
6
# take all shells into transformation for RPA
.ACTIVE
all 
all 
.PRPTRA
.PRINT
1
*PRPTRA
# we need this print level to get all operator matrix elements
.PRINT
1
# dipole operators
.OPERATOR
 XDIPLEN
 COMFACTOR
 1.00D0
.OPERATOR
 YDIPLEN
 COMFACTOR
 1.00D0
.OPERATOR
 ZDIPLEN
 COMFACTOR
 1.00D0 
*END OF

 # RPA (or TDHF) prescription
 &RELCCSD TIMING=T, IPRNT=1, DOSORT=T, DOENER=F, DOFOPR=F, DOSOPR=T, NELEC=3,2,3,3  &END
 &CCSORT USEOE=T, NORECMP=F  &END
 &CCSOPR MAXIT=50, NTOL=10, NAOPER=3, NBOPER=3,
   NAMEA='XDIPLEN','YDIPLEN','ZDIPLEN',
   NAMEB='XDIPLEN','YDIPLEN','ZDIPLEN',
 &END

