**DIRAC
.TITLE
 Mg 
.WAVE F
**INTEGRALS
*READIN
.UNCONTRACTED
**HAMILTONIAN
.INTFLG 
1 1 0
**WAVE FUNCTIONS
.SCF
.RELCCSD
*SCF
.EVCCNV
1.0E-8 1.0E-7
# occupation set automatically 
**MOLTRA
# 1s(2) 2s(2) 2p(6) frozen, 3s(2) correlated, some virtuals deleted
.ACTIVE
energy  -1.00   10.0   0.1D0
.PRPTRA
*PRPTRA
# list here all operators added to the Kramers unrestricted Fock matrix
### y dip.mom.
.OPERATOR
 YDIPLEN
 COMFACTOR
 1.0D0
### z dip.mom.
.OPERATOR
 ZDIPLEN
 COMFACTOR
 1.0D0
### z-dipole velocity operator - imaginary 
.OPERATOR
 ZDIPVEL
 COMFACTOR
 1.0D0
*END OF

 # 3s(2) correl.electrons
 &RELCCSD DOFSPC=F  DOENER=T  IPRNT=1  NELEC=1,1  INTERFACE="DIRAC"  DEBUG=F  &END
 &CCENER  DOMP2=T  DOCCSD=T  DOCCSDT=T  NTOL=10  &END
 # add 3 finite field operators; the third one with i-factor as it's imaginary, antisyymetric 
 &CCSORT  USEOE=F, ADD_FINITE_FIELD=T, NFFOPER=3, FF_PROP_NAMES='YDIPLEN','ZDIPLEN','ZDIPVEL'  FF_PROP_STRENGTHS=0.0020,0.0000, 0.0010,0.0000, 0.0000,0.0005  &END

