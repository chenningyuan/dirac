#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Sum of all contributions to the energy',
      num_lines   = 5,
      rel_tolerance   = 1.0e-9)

test.run(['fsccsd_integrals.inp'], ['Mg.mol'], f, args='--keep_scratch --scratchful=$DIRAC_TMPDIR/fscc_restart')
#test.run(['fsccsd_integrals.inp'], ['Mg.mol'], f, args='--keep_scratch')

f = Filter()
f.add(from_string = ' Energy eigenvalues in atomic units',
      to_re       = 'Relative real eigenvalues in other units;',
      rel_tolerance = 1.0e-5)

inputs = ['fsccsd_restart_s00.inp', 'fsccsd_restart_s00.inp', 
          'fsccsd_restart_s01.inp', 'fsccsd_restart_s01.inp', 
          'fsccsd_restart_s10.inp', 'fsccsd_restart_s10.inp', 
          'fsccsd_restart_s11.inp', 'fsccsd_restart_s11.inp', 
          'fsccsd_restart_s02.inp', 'fsccsd_restart_s02.inp', 
          'fsccsd_restart_s20.inp', 'fsccsd_restart_s20.inp']
test.run(inputs, ['Mg.mol'], f, args='--mw=110 --keep_scratch --scratchful=$DIRAC_TMPDIR/fscc_restart')
#test.run(inputs, ['Mg.mol'], f, args='--mw=110 --keep_scratch')

os.unlink('DFCOEF')

sys.exit(test.return_code)
