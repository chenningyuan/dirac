#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()

f.add(from_re     = 'Energy at final geometry is',
      to_string   = 'Total number of energy calculation steps',
      rel_tolerance   = 1.0e-5)


test.run(['opt_numgra.inp'], ['H2.mol'], f)
test.run(['opt_rankon.inp'], ['H2.mol'], f)
test.run(['opt_psb.inp'], ['H2.mol'], f)
test.run(['opt_dfp.inp'], ['H2.mol'], f)
test.run(['opt_quadsd.inp'], ['H2.mol'], f)
test.run(['opt_bfgsr1.inp'], ['H2.mol'], f)

sys.exit(test.return_code)
