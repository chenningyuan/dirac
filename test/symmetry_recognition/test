#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()

f.add(from_string = 'SYMADD: Detection of molecular symmetry',
      to_string='References for the basis sets',
      rel_tolerance   = 1.0e-8,
      ignore_sign=True)
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      rel_tolerance   = 1.0e-9)
f.add(from_string = '                                   Eigenvalues',
      to_re       = 'Occupation in fermion',
      rel_tolerance   = 1.0e-7)

# hjaaj Nov 2024: removed SF6 from the test, because the degenerate irreps may change
# order depending on compiler, and then it became a false "failure"
#test.run(['lda.inp'], ['H2O.mol', 'CH4.mol', 'SF6.mol', 'transCHFCHF.mol'], f)
test.run(['lda.inp'], ['H2O.mol', 'CH4.mol', 'transCHFCHF.mol'], f)

# Nov 2026: centres are only symmetry-related if they have the same
# (possibly non-integer) charge, not just the same integer atom number.
# CO_MgO_bridge: CO at a bridge site of MgO(100), surface modelled by
#               Mg(2+)/O(2-) point charges, C(s)   (was wrongly C(2v): all
#               point charges have atom number 0, and the C2v symmetry swaps
#               Mg(2+) and O(2-); wrong energy without any warning)
# CO_MgCaO_hollow: CO at a hollow site of a (Mg,Ca)O(100) surface, partial
#               (non-integer) charges Mg +1.6, Ca +1.8, O -1.7, C(s); C(2v)
#               if the charges were rounded to integers. The mirror plane
#               is diagonal: also tests that a Cs molecule is rotated so
#               that the plane is used (was C1 before).
test.run(['lda.inp'], ['CO_MgO_bridge.mol', 'CO_MgCaO_hollow.mol'], f)

# Nov 2026: cubic and icosahedral point groups, symmetry detection only
# (no wave function). Before, T, O, I were reported as T(d), Th as O(h);
# I(h) molecules were represented in C2h (I in C2) instead of D2h (D2),
# and for atoms in general positions the C5 axes were not found.
# The many equivalent axes of these groups may be found (and printed) in a
# different order with different compilers, so we do not compare the axis
# vectors, but only what does not depend on that order:
f_sym = Filter()
# orders of the proper and improper rotation axes (sorted by order)
f_sym.add(re = r'^ +[0-9]+ : +[-0-9.]+ +[-0-9.]+ +[-0-9.]+ +Isotope',
          mask = [1])
# the computational group: number of generators and character table
f_sym.add(string = 'Symmetry operations:')
f_sym.add(from_string = '* Character table',
          to_string = '* Direct product table')
# the molecule itself (independent of orientation)
f_sym.add(string = 'Nuclear repulsion energy',
          rel_tolerance = 1.0e-10)
f_sym.add(string = 'Total number of atoms:')
f_sym.add(from_string = 'total:',
          num_lines = 1)
test.run(['symdetect.inp'], ['T.mol', 'Th.mol', 'O.mol', 'I.mol', 'B12H12.mol'], f_sym)

sys.exit(test.return_code)
