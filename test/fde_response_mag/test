#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = '  Magnetizabilities                     au                       SI                      cgs',
      num_lines   = 9,
      rel_tolerance   = 0.0002)


shutil.copy('numerical_grid.save', 'numerical_grid')

# only embedding potential (v) in property gradient and embedding potential (v) in expectation value
shutil.copy('FROZEN.ll_lda', 'FROZEN')
test.run(['ll_lda_magn_g0_v_v.inp'], ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN"')
test.run(['ll_lda_magn_g1_v_v.inp'], ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN"')

shutil.copy('FROZEN.ll_pbe', 'FROZEN')
test.run(['ll_pbe_magn_g0_v_v.inp'], ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN"')
test.run(['ll_pbe_magn_g1_v_v.inp'], ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN"')

# DC/lda
# ------
shutil.copy('FROZEN.dc_lda', 'FROZEN')
test.run(['dc_lda_updatevemb_scf.inp'], ['h2o-1.xyz'],    args='--put="numerical_grid FROZEN" --outcmo')
test.run(['dc_lda_magn_g0_v_v.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
test.run(['dc_lda_magn_g1_v_v.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
test.run(['dc_lda_magn_g0_vw11_vw11.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
test.run(['dc_lda_magn_g1_vw11_vw11.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')

shutil.copy('pertden_direct_lao.FINAL.lda', 'pertden_direct_lao.FINAL')
shutil.copy('pertden_reorth_lao.FINAL.lda', 'pertden_reorth_lao.FINAL')
test.run(['dc_lda_magn_g0_all_all.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN pertden_direct_lao.FINAL pertden_reorth_lao.FINAL" --incmo')
test.run(['dc_lda_magn_g1_all_all.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN pertden_direct_lao.FINAL pertden_reorth_lao.FINAL" --incmo')



# DC/gga
# ------
shutil.copy('FROZEN.dc_pbe', 'FROZEN')
test.run(['dc_pbe_updatevemb_scf.inp'], ['h2o-1.xyz'],    args='--put="numerical_grid FROZEN" --outcmo')
test.run(['dc_pbe_magn_g0_v_v.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
test.run(['dc_pbe_magn_g1_v_v.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
test.run(['dc_pbe_magn_g0_vw11_vw11.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
test.run(['dc_pbe_magn_g1_vw11_vw11.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')

shutil.copy('pertden_direct_lao.FINAL.pbe', 'pertden_direct_lao.FINAL')
shutil.copy('pertden_reorth_lao.FINAL.pbe', 'pertden_reorth_lao.FINAL')
test.run(['dc_pbe_magn_g0_all_all.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN pertden_direct_lao.FINAL pertden_reorth_lao.FINAL" --incmo')
test.run(['dc_pbe_magn_g1_all_all.inp'],    ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN pertden_direct_lao.FINAL pertden_reorth_lao.FINAL" --incmo')


# cleaning
# --------
os.unlink('FROZEN')
os.unlink('DFCOEF')
os.unlink('numerical_grid')
os.unlink('pertden_direct_lao.FINAL')
os.unlink('pertden_reorth_lao.FINAL')



sys.exit(test.return_code)
