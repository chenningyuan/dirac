#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()

f.add(from_string = '@            isotropic shielding',
      num_lines   = 7,
      rel_tolerance   = 0.002)


# no freeze-thaw
# --------------

# import frozen density and update embedding potential
# ----------------------------------------------------
shutil.copy('FROZEN.save', 'FROZEN')
shutil.copy('numerical_grid.save', 'numerical_grid')

# only embedding potential (v)
test.run(['ll_lda_updatevemb_shield_g0_v.inp'],          ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN"')
test.run(['ll_lda_updatevemb_shield_g1_v.inp'],          ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN"')
# embedding potential (v) and embedding kernel without coupling terms (w11)
test.run(['ll_lda_updatevemb_shield_g0_v_w11.inp'],      ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN"')
test.run(['ll_lda_updatevemb_shield_g1_v_w11.inp'],      ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN"')
# embedding potential (v) and embedding kernel without coupling terms (w11) and with coupling terms (w12)
#test.run(['ll_lda_updatevemb_shield_g0_v_w11_w12.inp'],  ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN EMBPOT"')
#test.run(['ll_lda_updatevemb_shield_g1_v_w11_w12.inp'],  ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN EMBPOT"')

shutil.copy('DFCOEF.dc', 'DFCOEF')
#test.run(['dc_lda_updatevemb_scf.inp'],                  ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --outcmo')
test.run(['dc_lda_updatevemb_shield_g0_v.inp'],          ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
test.run(['dc_lda_updatevemb_shield_g1_v.inp'],          ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
test.run(['dc_lda_updatevemb_shield_g0_v_w11.inp'],      ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
test.run(['dc_lda_updatevemb_shield_g1_v_w11.inp'],      ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN" --incmo')
#test.run(['dc_lda_updatevemb_shield_g0_v_w11_w12.inp'],  ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN EMBPOT"')
#test.run(['dc_lda_updatevemb_shield_g1_v_w11_w12.inp'],  ['h2o-1.xyz'], f, args='--put="numerical_grid FROZEN EMBPOT"')




os.unlink('FROZEN')
os.unlink('numerical_grid')

# do freeze-thaw in DIRAC
# -----------------------

sys.exit(test.return_code)
