#!/usr/bin/env python

import os
import sys
from pathlib import Path

try:
    import h5py
    h5py_available = True
except:
    h5py_available = False

#
# prepare environment, define functions
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5
test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Final grid function values (id=',
      num_lines = 2,
      rel_tolerance = 1.0e-6)
#
# run tests
#

test.run(['dc.inp'], ['c6h6.xyz'], args='--outcmo')

# unperturbed densities
test.run(['vis.inp'], ['c6h6.xyz'], f, args='--incmo --get="*.cube"')

# perturbed densities
test.run(['rspB.inp'], ['c6h6.xyz'], args='--incmo --outcmo --get="*.h5"')
test.run(['vis_rspB.inp'], ['c6h6.xyz'], f, args='--incmo --put="TBMO.h5 RESPONSE.h5" --get="*.csv"')

#Path('CHECKPOINT.h5').unlink()

sys.exit(test.return_code)
