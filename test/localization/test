#!/usr/bin/env python

import os
import sys
import tarfile
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(string = '**** Inverse mean delocalization',
      tolerance = 1.0e-9)

# get input files
tar = tarfile.open('cf.tgz')
tar.extractall()
tar.close()

shutil.copy('cf.H', 'DFH1AT')
shutil.copy('cf.H', 'DFH2AT')
shutil.copy('cf.H', 'DFH3AT')
shutil.copy('cf.H', 'DFH4AT')
shutil.copy('cf.C', 'DFC1AT')
shutil.copy('cf.O', 'DFO1AT')

# CH4
shutil.copy('cf.CH4', 'DFPCMO')
test_run.execute(['CH4locmul_full.inp'], ['CH4.mol'], f, '--copy="DFPCMO"')
test_run.execute(['CH4locprj_full.inp'], ['CH4.mol'], f, '--copy="DFPCMO DFC1AT DFH1AT DFH2AT DFH3AT DFH4AT"')
test_run.execute(['CH4locprj_comb.inp'], ['CH4.mol'], f, '--copy="DFPCMO DFC1AT DFH1AT DFH2AT DFH3AT DFH4AT"')
test_run.execute(['CH4locprj_diag.inp'], ['CH4.mol'], f, '--copy="DFPCMO DFC1AT DFH1AT DFH2AT DFH3AT DFH4AT"')

# H2O
shutil.copy('cf.H2O', 'DFPCMO')
test_run.execute(['H2Olocmul_full.inp'], ['H2O.mol'], f, '--copy="DFPCMO"')
test_run.execute(['H2Olocprj_full.inp'], ['H2O.mol'], f, '--copy="DFPCMO DFO1AT DFH1AT DFH2AT"')
test_run.execute(['H2Olocprj_comb.inp'], ['H2O.mol'], f, '--copy="DFPCMO DFO1AT DFH1AT DFH2AT"')
test_run.execute(['H2Olocprj_diag.inp'], ['H2O.mol'], f, '--copy="DFPCMO DFO1AT DFH1AT DFH2AT"')

# cleanup
os.unlink('cf.H')
os.unlink('cf.C')
os.unlink('cf.O')
os.unlink('cf.CH4')
os.unlink('cf.H2O')
os.unlink('DFC1AT')
os.unlink('DFO1AT')
os.unlink('DFH1AT')
os.unlink('DFH2AT')
os.unlink('DFH3AT')
os.unlink('DFH4AT')
os.unlink('DFPCMO')

sys.exit(0)
