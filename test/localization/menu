# CH4
C.inp C.mol --outcmo  
sh mv DFCOEF cf.C
sh ln -f -s cf.C DFC1AT

H.inp H.mol --outcmo  
sh mv DFCOEF cf.H
sh ln -f -s cf.H DFH1AT
sh ln -f -s cf.H DFH2AT
sh ln -f -s cf.H DFH3AT
sh ln -f -s cf.H DFH4AT

CH4.inp CH4.mol --outcmo  

CH4locprj.inp CH4.mol --incmo --copy="DFC1AT DFH1AT DFH2AT DFH3AT DFH4AT"  

# H2O
O.inp O.mol --outcmo  
sh mv DFCOEF cf.O
sh ln -f -s cf.O DFO1AT

H2O.inp H2O.mol --outcmo

H2Olocprj.inp H2O.mol --incmo --copy="DFO1AT DFH1AT DFH2AT"

# Clean after yourself
sh rm -f cf.C cf.H cf.O DFCOEF DFC1AT DFO1AT DFH1AT DFH2AT DFH3AT DFH4AT 
