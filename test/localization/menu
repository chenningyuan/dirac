C.inp C.mol --outcmo  --timeout=1m
sh mv DFCOEF cf.C
sh ln -f -s cf.C DFC1AT

H.inp H.mol --outcmo  --timeout=40s
sh mv DFCOEF cf.H
sh ln -f -s cf.H DFH1AT
sh ln -f -s cf.H DFH2AT
sh ln -f -s cf.H DFH3AT
sh ln -f -s cf.H DFH4AT

CH4.inp CH4.mol --outcmo  --timeout=3m
CH4locmul.inp CH4.mol --incmo --timeout=30s

CH4locprj.inp CH4.mol --incmo --copy="DFC1AT DFH1AT DFH2AT DFH3AT DFH4AT"  --timeout=40s
sh rm cf.C cf.H DFCOEF DFC1AT DFH1AT DFH2AT DFH3AT DFH4AT
