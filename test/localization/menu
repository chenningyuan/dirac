# CH4
C.inp C.mol --get=DFACMO
sh mv DFACMO cf.C
sh ln -f -s cf.C DFC1AT

H.inp H.mol --get=DFACMO
sh mv DFACMO cf.H
sh ln -f -s cf.H DFH1AT
sh ln -f -s cf.H DFH2AT
sh ln -f -s cf.H DFH3AT
sh ln -f -s cf.H DFH4AT

CH4.inp CH4_D2.mol --get=DFACMO
sh mv DFACMO DFCOEF

CH4locmul_full.inp CH4_C1.mol --incmo
CH4locprj_full.inp CH4_C1.mol --incmo --copy="DFC1AT DFH1AT DFH2AT DFH3AT DFH4AT"  
CH4locprj_comb.inp CH4_C1.mol --incmo --copy="DFC1AT DFH1AT DFH2AT DFH3AT DFH4AT"  
CH4locprj_diag.inp CH4_C1.mol --incmo --copy="DFC1AT DFH1AT DFH2AT DFH3AT DFH4AT"  

# H2O
O.inp O.mol --get=DFACMO
sh mv DFACMO cf.O
sh ln -f -s cf.O DFO1AT

H2O.inp H2O_C2v.mol --get=DFACMO
sh mv DFACMO DFCOEF

H2Olocmul_full.inp H2O_C1.mol --incmo
H2Olocprj_full.inp H2O_C1.mol --incmo --copy="DFO1AT DFH1AT DFH2AT"
H2Olocprj_comb.inp H2O_C1.mol --incmo --copy="DFO1AT DFH1AT DFH2AT"
H2Olocprj_diag.inp H2O_C1.mol --incmo --copy="DFO1AT DFH1AT DFH2AT"

# Clean after yourself
sh rm -f cf.C cf.H cf.O DFCOEF DFC1AT DFO1AT DFH1AT DFH2AT DFH3AT DFH4AT 
