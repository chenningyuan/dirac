#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-9)
f.add(from_string = 'Eigenvalues',
      to_re       = 'HOMO - LUMO',
      tolerance   = 1.0e-5)
f.add(from_string = ' Overview of calculated energies',
      num_lines   = 12,
      tolerance   = 1.0e-6)

test_run.execute(['cc.inp'], ['N2.ccpVDZ.mol'], f, args='--mw=110 --aw=120')

test_run.execute(['cc.inp'], ['N2.ccpVQZ.mol'], f, args='--mw=130 --aw=140')
test_run.execute(['cc.inp'], ['N2.ccpV5Z.mol'], f, args='--mw=140 --aw=150')

sys.exit(0)
