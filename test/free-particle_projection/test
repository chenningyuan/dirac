#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_re     = 'Fermion symmetry E1g',
      num_lines   = 30,
      tolerance   = 1.0e-5)

test_run.execute(['std.inp', 'free.inp'], ['Hg.mol'], f)

sys.exit(0)
