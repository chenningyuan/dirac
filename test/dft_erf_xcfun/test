#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(string    = 'Electronic energy',
      tolerance = 1.0e-7)

test_run.execute(['ldaerf.inp', 'ldaerf_jt.inp'], ['he.mol', 'ne.mol'], f)

sys.exit(0)
