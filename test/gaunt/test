#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-9)
f.add(from_string = 'Eigenvalues',
      to_re       = 'HOMO - LUMO',
      tolerance   = 1.0e-5)
f.add(from_string = 'contribution             contribution             contribution',
      num_lines   = 5,
      tolerance   = 1.0e-5)
f.add(from_string = 'Quadratic Response Functions',
      to_string   = '@   average')
f.add(from_string = '@            isotropic shielding',
      num_lines   = 5,
      tolerance   = 1.0e-5)

test_run.execute(['gaunt.inp'], ['Ne.C2.mol'], f)

sys.exit(0)
