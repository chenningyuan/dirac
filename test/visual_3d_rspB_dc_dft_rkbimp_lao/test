#!/usr/bin/env python

import os
import sys
from pathlib import Path

try:
    import h5py
    h5py_available = True
except:
    h5py_available = False

#
# prepare environment
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5
test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Final grid_function values (grid_function%id=',
      num_lines = 28,
      rel_tolerance = 1.0e-6)
 
#
# run tests
#

test.run(['dc.inp'], ['h2o.mol'], args='--outcmo')
test.run(['rsp.inp'], ['h2o.mol'], args='--incmo --outcmo --get="*.h5"')

if h5py_available:
    test.run(['vis.inp'], ['h2o.mol'], f, args='--incmo --put="TBMO.h5 RESPONSE.h5" --get="*.h5"')
else:
    test.run(['vis.inp'], ['h2o.mol'], f, args='--incmo --put="TBMO.h5 RESPONSE.h5"')


#
# compare generated data with reference
#

if h5py_available:
    rs = CompareHDF5(test.work_dir)
    
    testset = ['divj']
    for t in testset:
    
        rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon.h5',\
                  fref='result/'+t+'_Bz_lao_rspvec6_symcon.h5',\
                  typ='single',\
                  gf_label='/result/grid/ndim')
    
        rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon.h5',\
                  fref='result/'+t+'_Bz_lao_rspvec6_symcon.h5',\
                  typ='single',\
                  gf_label='/result/grid/nr_points_total')
    
        rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon.h5',\
                  fref='result/'+t+'_Bz_lao_rspvec6_symcon.h5',\
                  typ='array',\
                  gf_label='/result/grid_function/'+t+'/visualization/values/',
                  gf_test_key='t0_icomp_1')
    
    
    testset = ['j', 'rotj', 'ndip']
    for t in testset:
    
        rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon.h5',\
                  fref='result/'+t+'_Bz_lao_rspvec6_symcon.h5',\
                  typ='single',\
                  gf_label='/result/grid/ndim')
    
        rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon.h5',\
                  fref='result/'+t+'_Bz_lao_rspvec6_symcon.h5',\
                  typ='single',\
                  gf_label='/result/grid/nr_points_total')
    
        for i in range(1,4):
            rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon.h5',\
                      fref='result/'+t+'_Bz_lao_rspvec6_symcon.h5',\
                      typ='array',\
                      gf_label='/result/grid_function/'+t+'/visualization/values/',
                      gf_test_key='t1_icomp_'+str(i))
    
    
    testset = ['gradj']
    for t in testset:
    
        rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon.h5',\
                  fref='result/'+t+'_Bz_lao_rspvec6_symcon.h5',\
                  typ='single',\
                  gf_label='/result/grid/ndim')
    
        rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon.h5',\
                  fref='result/'+t+'_Bz_lao_rspvec6_symcon.h5',\
                  typ='single',\
                  gf_label='/result/grid/nr_points_total')
    
        for i in range(1,10):
            rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon.h5',\
                      fref='result/'+t+'_Bz_lao_rspvec6_symcon.h5',\
                      typ='array',\
                      gf_label='/result/grid_function/'+t+'/visualization/values/',
                      gf_test_key='t2_icomp_'+str(i))
    
    
    testset = ['j']
    subtest = ['nodirect_nokappa', 'nodirect_noreorth', 'noreorth_nokappa']
    for t in testset:
        for s in subtest:
    
            rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon_'+s+'.h5',\
                      fref='result/'+t+'_Bz_lao_rspvec6_symcon_'+s+'.h5',\
                      typ='single',\
                      gf_label='/result/grid/ndim')
    
            rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon_'+s+'.h5',\
                      fref='result/'+t+'_Bz_lao_rspvec6_symcon_'+s+'.h5',\
                      typ='single',\
                      gf_label='/result/grid/nr_points_total')
    
            for i in range(1,4):
                rs.verify(ftest=t+'_Bz_lao_rspvec6_symcon_'+s+'.h5',\
                          fref='result/'+t+'_Bz_lao_rspvec6_symcon_'+s+'.h5',\
                          typ='array',\
                          gf_label='/result/grid_function/'+t+'/visualization/values/',
                          gf_test_key='t1_icomp_'+str(i))
    

