#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Level   Rel eigenvalue     Abs eigenvalue',
      to_string   = ' =====================',
      tolerance   = 1.0e-6)

test_run.execute(['ci.1.inp'],                   ['O.mol'], f)
test_run.execute(['ci.2.inp'],                   ['O.mol'], f, args='--outcmo')
test_run.execute(['ci.3.inp'],                   ['O.mol'], f, args='--incmo ')
test_run.execute(['ci.4.inp'],                   ['O.mol'], f)
test_run.execute(['O.bss_sfB.scf_ci.inp'],       ['O.mol'], f, args='--outcmo')
test_run.execute(['O.bss+mfsso.postscf.ci.inp'], ['O.mol'], f, args='--incmo ')
test_run.execute(['O.bss+mfsso.scf_ci.inp'],     ['O.mol'], f)
test_run.execute(['O.bss.scf_ci.inp'],           ['O.mol'], f)

os.unlink('DFCOEF')

sys.exit(0)
