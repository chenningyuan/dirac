#!/usr/bin/env python

import os
import sys
from pathlib import Path

#
# prepare environment, define functions
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5
test = TestRun(__file__, sys.argv)

#
# run tests
#

test.run(['Exc.inp'], ['Mg.xyz'], args='--outcmo --get="numerical_grid PAMXVC RESPONSE.h5"')
test.run(['dens.inp'], ['Mg.xyz'], args='--incmo --put="numerical_grid RESPONSE.h5 PAMXVC" --get="dens*.h5"')

#
# compare generated data with reference
#

rs = CompareHDF5(test.work_dir)

testset = ['bedcos', 'bedsin']
for t in testset:

    rs.verify(ftest=t+'_rspvec5.h5',\
              fref='result/'+t+'_rspvec5.h5',\
              typ='single',\
              gf_label='/result/grid/ndim')

    rs.verify(ftest=t+'_rspvec5.h5',\
              fref='result/'+t+'_rspvec5.h5',\
              typ='single',\
              gf_label='/result/grid/nr_points_total')

#   now with low rel_tolerance; data seems to be numerically unstable
    rs.verify(ftest=t+'_rspvec5.h5',\
              fref='result/'+t+'_rspvec5.h5',\
              typ='array',\
              rel_tolerance=1.0e-4,\
              gf_label='/result/grid_function/'+t+'/visualization/values/',
              gf_test_key='t0_icomp_1')


