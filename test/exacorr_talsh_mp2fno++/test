#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from exacorr_environment import set_exacorr_environment

set_exacorr_environment()

test = TestRun(__file__, sys.argv)

f1 = Filter()
f1.add(from_string = 'Recanonized MP2 frozen virtual natural spinors',
      num_lines   = 13, # only lookin at occupation numbers
      abs_tolerance   = 1.0e-6) # /!\ high value because of different NO energies for y and z

# Computing FNO++ with only one perturbation
for i, prop in enumerate(["x", "y", "z"]):

    test.run([f'fno++_{prop}_generation_nr.inp'], ['h2o.xyz'], f1, args='--outcmo')

    f2 = Filter()
    f2.add(
        from_string = f"<<X{i+1};X{i+1}>> = ",
        num_lines   = 1,
        abs_tolerance   = 1.0e-6
    )
    f2.add(
        from_string = "********** Properties for CCSD wave function **********",
        num_lines   = 28,
        abs_tolerance   = 1.0e-6
    )
    test.run([f'fno++_{prop}_alpha_ccsd_v2z.inp'], ['h2o.xyz'], f2, args='--incmo')

# test only orbital generation for FNO++ with a given frequency
test.run(['fno++_x_generation_nr_freq.inp'], ['h2o.xyz'], f1, args='--outcmo')

# testing FNO++ with x,y and z perturbation by averaging density matrix and augmenting space
test.run(['fno++_x_generation_nr_mean.inp'], ['h2o.xyz'], f1, args='--outcmo')
test.run(['fno++_x_generation_nr_aug.inp'], ['h2o.xyz'], f1, args='--outcmo')

sys.exit(test.return_code)
