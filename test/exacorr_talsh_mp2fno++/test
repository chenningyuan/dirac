#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from exacorr_environment import set_exacorr_environment

set_exacorr_environment()

test = TestRun(__file__, sys.argv)

f1 = Filter()
f1.add(from_string = 'Recanonized MP2 frozen virtual natural spinors',
      num_lines   = 26,
      rel_tolerance   = 1.0e-6)


for prop in ["x", "y", "z"]:

    test.run([f'fno++_{prop}_generation_nr.inp'], ['h2o.xyz'], f1, args='--outcmo')

    f2 = Filter()
    f2.add(
        from_string = "<<X1;X1>> = ",
        num_lines   = 1,
        rel_tolerance   = 1.0e-6
    )
    f2.add(
        from_string = "********** Properties for CCSD wave function **********",
        num_lines   = 28,
        rel_tolerance   = 1.0e-6
    )
    test.run([f'fno++_{prop}_alpha_ccsd_v2z.inp'], ['h2o.xyz'], f2, args='--incmo')

sys.exit(test.return_code)
