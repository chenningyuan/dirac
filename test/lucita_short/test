#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Number of determinants/combinations',
      nr_lines    = 1)
f.add(from_string = ' Final energy',
      nr_lines    = 1)

test_run.execute(['He.inp'],
                 ['He.mol'],
                 f,
                 accepted_errors=['FATAL ERROR for LUCITA runs: memory offset (dynamic memory - static memory) is too big for i*4'])

sys.exit(0)
