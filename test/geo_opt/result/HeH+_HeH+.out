.TITLE                                                                                              
HeH+ molecule                                                                                       
.WAVE FUNCTION                                                                                      
.OPTIMIZE                                                                                           
.PROPERTIES                                                                                         
.ANALYZE                                                                                            
*OPTIMIZE                                                                                           
.PRINT                                                                                              
 3                                                                                                  
.MAX IT                                                                                             
60                                                                                                  
.GRADIE                                                                                             
1.0D-7                                                                                              
.ENERGY                                                                                             
1.0D-12                                                                                             
.CONDIT                                                                                             
2                                                                                                   
**GENERAL                                                                                           
.PRINT                                                                                              
0                                                                                                   
.DIRECT                                                                                             
1 1 0                                                                                               
**INTEGRALS                                                                                         
*READIN                                                                                             
.CONTRACT                                                                                           
