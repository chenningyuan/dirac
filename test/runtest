#!/bin/sh
#
#
# VERSION : $Revision$
# DATE    : $Date$
# FILE    : runtest
# SOURCE  : $Source$
#
# (c) 1998 J. Thyssen
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Does 'echo' understand escapes?
#
#
if [ "	" = "`echo '\t'`" ]; then
   echo="echo"
else
   echo="echo -e"
fi
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# CHECK OPTIONS
#
#
usage () {
   $echo 'Usage: '$0
   $echo '--help'
   $echo '\tPrint this'
   $echo '--version'
   $echo '\tPrint version of runtest'
   $echo '--tests="tests to run"'
   $echo '\tChoose which tests to run'
   $echo '--pampath="path to pam script"'
   $echo '\tSet path to pam script'
   $echo '--dirac="executable"'
   $echo '\tSpecify which dirac.x should be used'
   $echo '--run="tag"'
   $echo '\tLabel the output (default out)'
   $echo '--mpi="number of slaves"'
   $echo '\tRun test in parallell under MPI'
   $echo
}

arg_tests=short
arg_pampath=
arg_dirac=
arg_tag=runtest
arg_mpi=

while [ $# != 0 ]; do
   arg="$1"; shift
   case "${arg}" in
      -*=*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\([^=]*\)=.*$:\1:'`
         val=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*[^=]*=\(.*\)$:\1:'`
         valomitted=no
         ;;
      -*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\(.*\)$:\1:'`
         val="yes"
         valomitted=yes
         ;;
      *)
         $echo $usage
         exit
   esac
   optname="${opt}"
   opt="`echo '' ${opt} | sed -e 's:^ ::' | tr - _`"
   case "${opt}" in
      "help")
         usage
         exit
         ;;
      "version")
         echo $0
         echo '$Revision$'
         echo '$Date$'
         exit
         ;;
      "tests")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_tests="$val"
         ;;
      "mpi")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_mpi="-mpi $val"
         ;;
      "dirac")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_dirac="$val"
         ;;
      "run")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_tag="$val"
         ;;
      "pampath")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_pampath="$val"
         ;;
      *)
         echo 'Unknown option: '$opt''
         usage
         exit 1
         ;;
   esac
done
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# FIND ALL POSSIBLE TESTS
#
#
echo
echo 'FINDING TESTS...'
echo
short_test='1.energy+dipole 3.geomopt.dhf 4.levy-leblond.nmr 5.cisd.energy 6.cosci.energy 7.directmp2.energy 8.spinfree.cosci.energy 9.contraction 11.methods.cosci 14.basis.set.input 22.lucita_short'
medium_test='1.energy+dipole 2.nmrspinspin 3.geomopt.dhf 4.levy-leblond.nmr 5.cisd.energy 6.cosci.energy 7.directmp2.energy 8.spinfree.cosci.energy 9.contraction 10.efg 11.methods.cosci 12.zora 14.basis.set.input 19.fockspace 22.lucita_short'
long_test='1.energy+dipole 2.nmrspinspin 3.geomopt.dhf 4.levy-leblond.nmr 5.cisd.energy 6.cosci.energy 7.directmp2.energy 8.spinfree.cosci.energy 9.contraction 10.efg 11.methods.cosci 12.zora 14.basis.set.input 19.fockspace 24.lucita_large'
all_test=
for ff in [0-9]*; do
   if test -d $ff; then
      all_test=$all_test' '$ff
   fi
done
echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
# CREATE HTML HEADER
#
cat <<\eor > logs/${arg_tag}_dif.htm
<HTML>
<TITLE> Error report for DIRAC test runs </TITLE>
<BODY TEXT="#FFFFFF" BGCOLOR="#000000">
<PRE>
<H1>drep output by color</H1>

<p>The colors are determined using relative errors for numbers larger than 0.001, and absolute errors otherwise.</p>
<p>Only those digits that actually differ are yellow or red, the others are white.</p>
<p>The coloring scheme used:</P>
1.23456789  white: difference can be neglected (less than 1e-12)
1.23456<FONT COLOR="#FFFF00">789</FONT> yellow: difference probably neglegible (less than 0.001)
1.2<FONT COLOR="#FF0000">3456789</FONT>    red: probably significant difference (more than 0.001)

eor
#
#
# RUN THE REQUESTED TESTS
#
#
HOSTS=`hostname`
export HOSTS
echo 
echo "Running tests on host : $HOSTS ..."
echo
if [ ! -z "$arg_tests" ]; then
   case "${arg_tests}" in
      "short")
         tests=$short_test;
         RUNTYPE="short"; export RUNTYPE
         ;;
      "medium")
         tests=$medium_test;
         RUNTYPE="medium"; export RUNTYPE
         ;;
      "long")
         tests=$long_test;
         RUNTYPE="long"; export RUNTYPE
         ;;
      "all")
         tests=$all_test
         ;;
      *)
         tests=$arg_tests
         ;;
   esac
else
   tests=$all_test
fi
$echo " Using tests: $tests \c"
echo

if [ -e logs/${arg_tag}_dif.txt ]; then
   rm logs/${arg_tag}_dif.txt
fi

for tt in $tests; do
   if [ ! -d $tt ]; then
      echo 'Test '$tt' not found...'
      exit 1
   fi
   echo
   echo 'Running test '$tt
   echo
   if [ -r $tt/README ]; then
      cat $tt/README
   fi
   echo
   ( cd $tt; \
     PAM_PATH=$arg_pampath; export PAM_PATH; \
     MPIARG=$arg_mpi; export MPIARG; \
     DIRAC=$arg_dirac; export DIRAC; \
     TAG=$arg_tag; export TAG; \
     ./run.sh; \
     cd .. )  
done
#
cat <<\eor >> logs/${arg_tag}_dif.htm

</BODY>
</HTML>
eor
