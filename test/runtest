#
#
# Does 'echo' understand escapes?
#
#
if [ "	" = "`echo '\t'`" ]; then
   echo="echo"
else
   echo="echo -e"
fi
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# CHECK OPTIONS
#
#
usage () {
   $echo 'Usage: '$0
   $echo '--help'
   $echo '\tPrint this'
   $echo '--version'
   $echo '\tPrint version of runtest'
   $echo '--tests="tests to run"'
   $echo '\tChoose which tests to run (default: short)'
   $echo '--runtype="type of tests to run"'
   $echo '\tWhen tests are specified with number,
        choose the type (short,medium...) '
   $echo '--pampath="path to pam script"'
   $echo '\tSet path to pam script'
   $echo '--dirac="executable"'
   $echo '\tSpecify which dirac.x should be used'
   $echo '--run="tag"'
   $echo '\tLabel the output (default: runtest)'
   $echo '--mpi="number of slaves"'
   $echo '\tRun test in parallell under MPI'
   $echo '--nice'
   $echo '\texecute Dirac with nice/npri'
   $echo '--timeout="TIMEOUT"'
   $echo '\tset the time limit for Dirac run'
   $echo '--overwrite=yes'
   $echo '\toverwrite reference outputs (this is for updating tests, use with care)'
   $echo
}

# next line defines default test series
#
arg_tests=short
arg_pampath=
arg_dirac=
arg_tag=runtest
arg_mpi=
arg_nice=
arg_timeout=
arg_overwrite=
RUNTYPE=undefined

while [ $# != 0 ]; do
   arg="$1"; shift
   case "${arg}" in
      -*=*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\([^=]*\)=.*$:\1:'`
         val=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*[^=]*=\(.*\)$:\1:'`
         valomitted=no
         ;;
      -*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\(.*\)$:\1:'`
         val="yes"
         valomitted=yes
         ;;
      *)
         $echo Invalid argument: ${arg}
         $echo $usage
         exit
   esac
   optname="${opt}"
   opt="`echo '' ${opt} | sed -e 's:^ ::' | tr - _`"
   case "${opt}" in
      "help")
         usage
         exit
         ;;
      "version")
         echo $0
         echo '$Revision$'
         echo '$Date$'
         exit
         ;;
      "tests")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_tests="$val"
         ;;
      "runtype")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         RUNTYPE="$val" ; export RUNTYPE
         ;;
      "overwrite")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_overwrite="$val"
         ;;
      "mpi")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_mpi="-mpi $val"
         ;;
      "dirac")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_dirac="$val"
         ;;
      "run")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_tag="$val"
         ;;
      "nice")
         arg_nice="-nice"
         ;;
      "timeout")
         arg_timeout="$val"
         ;;
      "pampath")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_pampath="$val"
         ;;
      *)
         echo 'Unknown option: '$opt''
         usage
         exit 1
         ;;
   esac
done
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# FIND ALL POSSIBLE TESTS
# Create list of tests for this run
#
#
echo
echo 'FINDING TESTS...'
echo

if [ ! -z "$arg_tests" ]; then
   case "${arg_tests}" in
      "short")
         if [ -n "$arg_mpi" ]; then
            echo "Running <<short>> parallel tests ..."
            tests=$short_partest;
         else
            echo "Running <<short>> sequential tests ..."
            tests=$short_test;
         fi
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="short" ; export RUNTYPE; fi
         ;;
      "medium")
         tests=$medium_test;
         if [ -n "$arg_mpi" ]; then
            echo "Running <<medium>> parallel tests ..."
            tests=$medium_partest;
         else
            echo "Running <<medium>> sequential tests ..."
            tests=$medium_test;
         fi
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="medium" ; export RUNTYPE; fi
         ;;
      "long")
         tests=$long_test;
         if [ -n "$arg_mpi" ]; then
            echo "Running <<long>> parallel tests ..."
            tests=$long_partest;
         else
            echo "Running <<long>> sequential tests ..."
            tests=$long_test;
         fi
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="long" ; export RUNTYPE; fi
         ;;
      "release")
         tests=$release_test;
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="release" ; export RUNTYPE; fi
         ;;
      "benchmark")
         tests=$benchmark_test;
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="benchmark" ; export RUNTYPE; fi
         ;;
      "small_benchmark")
         tests=$benchmark_test;
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="small_benchmark" ; export RUNTYPE; fi
         ;;
      "large_benchmark")
         tests=$benchmark_test;
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="large_benchmark" ; export RUNTYPE; fi
         ;;
      "all")
         tests=$all_test;
         ;;
      *)
#        extract and test users list of tests
         tests=
#        the following solution is a bit clumsy
#        could be more compact if we would not allow calling tests by number
         if [ "${arg_tests}" != "${arg_tests/\*/}" ]; then
#           ${arg_tests} contains one or more "*"
#           expand it with find
            tests=`find . -type d -name "${arg_tests}"`
         else
#           ${arg_tests} contains no "*"
            for ff in ${arg_tests}; do
                if test -d $ff; then
#                  hjaaj: OK, user has specified a test directory
                   tests=$tests' '$ff
                else
#                  hjaaj: check if test is specified just by number ?
                   for ff2 in ${ff}\.*; do
                       if test -d $ff2; then
#                         hjaaj: yes, so OK
                          tests=$tests' '$ff2
                       else
                          echo "ERROR: test '$ff' not recognized"
                          exit 1
                       fi
                   done
                fi
            done
         fi
         ;;
   esac
else
   if [ -n "$arg_mpi" ]; then
      echo "Running default: <<short>> parallel tests ..."
      tests=$short_partest;
   else
      echo "Running default: <<short>> sequential tests ..."
      tests=$short_test;
   fi
#  tests=$all_test
fi
#
# default to RUNTYPE="short" /hjaaj 070111
#
if [ $RUNTYPE = "undefined" ]; then
   RUNTYPE="short" ; export RUNTYPE
   echo "RUNTYPE defaults to short"
fi

echo
