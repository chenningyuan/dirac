#radovan: i don't think the all_test option has been used in years
#         maybe we could remove it
#         anyway it won't work with tests that are not numbered
# all_test takes all directories (and will fail if filters or output are absent !)
all_test=
for ff in [1-9]\.* [1-9][0-9]\.*; do
   if test -d $ff; then
      all_test=$all_test' '$ff
   fi
done
#
