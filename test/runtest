     PAM_PATH=$arg_pampath;              export PAM_PATH;            \
     MPIARG=$arg_mpi;                    export MPIARG;              \
     DIRAC=$arg_dirac;                   export DIRAC;               \
     TAG=$arg_tag;                       export TAG;                 \
