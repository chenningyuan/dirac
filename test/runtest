RUNTYPE=undefined

while [ $# != 0 ]; do
   arg="$1"; shift
   case "${arg}" in
      -*=*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\([^=]*\)=.*$:\1:'`
         val=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*[^=]*=\(.*\)$:\1:'`
         valomitted=no
         ;;
      -*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\(.*\)$:\1:'`
         val="yes"
         valomitted=yes
         ;;
      *)
         $echo Invalid argument: ${arg}
         $echo $usage
         exit
   esac
   optname="${opt}"
   opt="`echo '' ${opt} | sed -e 's:^ ::' | tr - _`"
   case "${opt}" in
      "help")
         usage
         exit
         ;;
      "version")
         echo $0
         echo '$Revision: 11216 $'
         echo '$Date: 2010-07-29 23:12:28 +0200 (Thu, 29 Jul 2010) $'
         exit
         ;;
      "tests")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_tests="$val"
         ;;
      "runtype")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         RUNTYPE="$val" ; export RUNTYPE
         ;;
      "overwrite")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_overwrite="$val"
         ;;
      "mpi")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_mpi="-mpi $val"
         ;;
      "dirac")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_dirac="$val"
         ;;
      "run")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_tag="$val"
         ;;
      "nice")
         arg_nice="-nice"
         ;;
      "timeout")
         arg_timeout="$val"
         ;;
      "pampath")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_pampath="$val"
         ;;
      *)
         echo 'Unknown option: '$opt''
         usage
         exit 1
         ;;
   esac
done
