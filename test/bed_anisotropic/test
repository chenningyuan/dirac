#!/usr/bin/env python

import os
import sys
import subprocess

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()

f.add(from_string = 'Exc.     Frequency (au)                           e-e              e-p             Total',
      num_lines   = 4,
      ignore_sign = True,
      abs_tolerance   = 1.0e-11)

f.add(from_string = 'Exc. Frequency (au)',
      num_lines   = 2,
      ignore_sign = True,
      abs_tolerance   = 1.0e-11)

test.run(['AnisotropicKedge.inp'], ['H2O.xyz'], f)

sys.exit(test.return_code)
