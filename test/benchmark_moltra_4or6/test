#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-9)
f.add(from_string = 'Eigenvalues',
      to_re       = 'HOMO - LUMO',
      tolerance   = 1.0e-5)
f.add(from_string = 'Overview of calculated energies',
      num_lines   = 12,
      tolerance   = 1.0e-9)

test_run.execute(['moltra4.inp', 'moltra6.inp'], ['C2H4Cl2_ec1_c2v.mol'], f)

sys.exit(0)
