#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string  = 'scalar              x-component',
      num_lines     = 3)

test_run.execute(['response_ez_ez_dc.inp'], ['ne_d2h.mol'], args='--get="DFCOEF PAMXVC"')
test_run.execute(['visual_zo_dc.inp'], ['ne_d2h.mol'], f, args='--copy="DFCOEF PAMXVC"')
test_run.execute(['visual_ez_ez_dc.inp'], ['ne_d2h.mol'], f, args='--copy="DFCOEF PAMXVC"')

test_run.execute(['response_bz_bz_dc.inp'], ['ne_d2h.mol'], args='--get="DFCOEF PAMXVC"')
test_run.execute(['visual_bz_bz_dc.inp'], ['ne_d2h.mol'], f, args='--copy="DFCOEF PAMXVC"')

test_run.execute(['response_1z_bz_dc.inp '], ['co_c1.mol'], args='--get="DFCOEF PAMXVC"')
test_run.execute(['visual_1z_bz_dc.inp'], ['co_c1.mol'], f, args='--copy="DFCOEF PAMXVC"')
test_run.execute(['visual_1z_bz_only_para_dc.inp'], ['co_c1.mol'], f, args='--copy="DFCOEF PAMXVC"')

test_run.execute(['response_1z_2z_dc.inp'], ['co_c1.mol'], args='--get="DFCOEF PAMXVC"')
test_run.execute(['visual_1z_2z_dc.inp'], ['co_c1.mol'], f, args='--copy="DFCOEF PAMXVC"')

os.unlink('DFCOEF')
os.unlink('PAMXVC')

sys.exit(0)
