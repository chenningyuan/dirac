.TITLE                                                                                              
  LiH                                                                                               
.WAVE F ! Activate integral and wave functions modules                                              
.ANALYZE                                                                                            
.4INDEX                                                                                             
.PROPERTIES                                                                                         
**GENERAL                                                                                           
.DIRECT                                                                                             
1 1 1                                                                                               
.PRINT                                                                                              
1                                                                                                   
**INTEGRALS                                                                                         
.PRINT                                                                                              
1                                                                                                   
.NUCMOD ! 1-Point nucleus, 2-gaussian                                                               
2                                                                                                   
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONIAN                                                                                       
.PRINT                                                                                              
0                                                                                                   
.INTFLG                                                                                             
1 1 0                                                                                               
**WAVE FUNCTIONS                                                                                    
.SCF                                                                                                
*SCF                                                                                                
.CLOSED SHELL                                                                                       
4                                                                                                   
