**DIRAC                                                                                             
.TITLE                                                                                              
  Rn(76+)                                                                                           
.WAVE F ! Activate integral and wave functions modules                                              
.ANALYZE                                                                                            
.4INDEX                                                                                             
.PROPER                                                                                             
**GENERAL                                                                                           
.DIRECT                                                                                             
1 1 1                                                                                               
.PRINT                                                                                              
1                                                                                                   
**INTEGRALS                                                                                         
.PRINT                                                                                              
1                                                                                                   
.NUCMOD ! 1-Point nucleus, 2-gaussian                                                               
2                                                                                                   
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONIAN                                                                                       
.PRINT                                                                                              
0                                                                                                   
.INTFLG                                                                                             
1 1 0                                                                                               
**WAVE FUNCTIONS                                                                                    
.SCF                                                                                                
*SCF                                                                                                
#10 electrons                                                                                       
.CLOSED SHELL                                                                                       
10                                                                                                  
#4 6                                                                                                
.INTFLG ! Specify what 2-el.integrals to include                                                    
1 1 0                                                                                               
.EVCCNV ! Energy convergence...                                                                     
1.0D-9  1.0D-6                                                                                      
#################################################                                                   
**ANALYZE                                                                                           
.MULPOP                                                                                             
*MULPOP                                                                                             
.VECPOP                                                                                             
all                                                                                                 
#all                                                                                                
**MOLTRA                                                                                            
.NO2IND                                                                                             
.NO4IND                                                                                             
.NOMDCI                                                                                             
# 10 occup. electrons in 2 ferm.irreps, 4 and 6                                                     
.ACTIVE                                                                                             
1..5                                                                                                
#1..2                                                                                               
#1..3                                                                                               
.PRPTRA                                                                                             
