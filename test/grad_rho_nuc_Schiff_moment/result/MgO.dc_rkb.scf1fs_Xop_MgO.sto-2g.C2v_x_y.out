**DIRAC                                                                                             
.TITLE                                                                                              
  MgO                                                                                               
.WAVE F ! Activate integral and wave functions modules                                              
.ANALYZE                                                                                            
.4INDEX                                                                                             
.PROPER                                                                                             
**GENERAL                                                                                           
.DIRECT                                                                                             
1 1 1                                                                                               
.PRINT                                                                                              
1                                                                                                   
**INTEGRALS                                                                                         
.PRINT                                                                                              
1                                                                                                   
.NUCMOD ! 1-Point nucleus, 2-gaussian                                                               
2                                                                                                   
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONIAN                                                                                       
.PRINT                                                                                              
1                                                                                                   
.INTFLG                                                                                             
1 1 0                                                                                               
**WAVE FUNCTIONS                                                                                    
.SCF                                                                                                
*SCF                                                                                                
.CLOSED SHELL                                                                                       
20                                                                                                  
.INTFLG ! Specify what 2-el.integrals to include                                                    
1 1 0                                                                                               
.EVCCNV ! Energy convergence...                                                                     
1.0D-9  1.0D-6                                                                                      
#################################################                                                   
