**DIRAC
.TITLE
  LiH
.WAVE F ! Activate integral and wave functions modules
.ANALYZE
.4INDEX
.PROPERTIES
**GENERAL
.DIRECT
1 1 1
.PRINT
1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
2
*READIN
.UNCONTRACTED
**HAMILTONIAN
.PRINT
0
.INTFLG
1 1 0
**WAVE FUNCTIONS
.SCF
*SCF
.CLOSED SHELL
4
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-9  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
all
**MOLTRA
.NO2IND
.NO4IND
.NOMDCI
.ACTIVE
1..2
.PRPTRA
*PRPTRA
# we need this print level to get all MO mtx elements printed
.PRINT
3
#-----------------------------------------------
# grad delta(r-R) operator for given nuclei
#-----------------------------------------------
.OPERATOR
 'd/dx dLi'
 DIAGONAL
 'XGFLi 01'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dy dLi'
 DIAGONAL
 'YGFLi 01'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dz dLi'
 DIAGONAL
 'ZGFLi 01'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dx d H'
 DIAGONAL
 'XGFH  02'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dy d H'
 DIAGONAL
 'YGFH  02'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dz d H'
 DIAGONAL
 'ZGFH  02'
 COMFACTOR
 12.5663706
#-----------------------------------------------
# grad rho(r-R) operator for given nuclei
#-----------------------------------------------
.OPERATOR
 'd/dx pLi'
 DIAGONAL
 'DRHO 001'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dy pLi'
 DIAGONAL
 'DRHO 002'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dz pLi'
 DIAGONAL
 'DRHO 003'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dx pH'
 DIAGONAL
 'DRHO 004'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dy pH'
 DIAGONAL
 'DRHO 005'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dz pH'
 DIAGONAL
 'DRHO 006'
 COMFACTOR
 -12.5663706
**PROPERTIES
.PRINT
3
*EXPECT
