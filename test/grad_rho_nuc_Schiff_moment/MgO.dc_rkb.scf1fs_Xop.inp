**DIRAC
.TITLE
  MgO
.WAVE F ! Activate integral and wave functions modules
.ANALYZE
.4INDEX
.PROPER
**GENERAL
.DIRECT
1 1 1
.PRINT
1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
2
*READIN
.UNCONTRACTED
**HAMILTONIAN
.PRINT
1
.INTFLG
1 1 0
**WAVE FUNCTIONS
.SCF
*SCF
.CLOSED SHELL
20
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-9  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
1..10
**MOLTRA
.NO2IND
.NO4IND
.NOMDCI
.ACTIVE
1..10
.PRPTRA
*PRPTRA
# we need this print level to get all MO mtx elements printed
.PRINT
3
#-----------------------------------------------
# grad delta(r-R) operator for given nuclei
#-----------------------------------------------
.OPERATOR
 'd/dx dMg'
 DIAGONAL
 'XGFMg 02'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dy dMg'
 DIAGONAL
 'YGFMg 02'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dz dMg'
 DIAGONAL
 'ZGFMg 02'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dx d O'
 DIAGONAL
 'XGFO  01'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dy d O'
 DIAGONAL
 'YGFO  01'
 COMFACTOR
 12.5663706
#
.OPERATOR
 'd/dz d O'
 DIAGONAL
 'ZGFO  01'
 COMFACTOR
 12.5663706
#-----------------------------------------------
# grad rho(r-R) operator for given nuclei
#-----------------------------------------------
.OPERATOR
 'd/dx pMg'
 DIAGONAL
 'DRHO 004'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dy pMg'
 DIAGONAL
 'DRHO 005'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dz pMg'
 DIAGONAL
 'DRHO 006'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dx pO'
 DIAGONAL
 'DRHO 001'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dy pO'
 DIAGONAL
 'DRHO 002'
 COMFACTOR
 -12.5663706
#
.OPERATOR
 'd/dz pO'
 DIAGONAL
 'DRHO 003'
 COMFACTOR
 -12.5663706
