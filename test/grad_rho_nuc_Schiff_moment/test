#!/usr/bin/env python

import os
import sys
sys.path.append(os.path.join(os.path.dirname(__file__), '../'))

from runtest import version_info, get_filter, cli, run
from runtest_config import configure

assert version_info.major == 2

f1 = [
    get_filter(from_string='Properties for DHF  wave function',
               to_string='t0 = T : Expectation value zero by time reversal symmetry.',
               abs_tolerance=1.0e-6)
]

f2 = [
    get_filter(from_string='Properties for DHF  wave function',
               to_string='t0 = T : Expectation value zero by time reversal symmetry.',
               rel_tolerance=1.0e-1)
]

options = cli()

ierr = 0
for inp in ['LiH.dc_rkb.scf1fs_operators.inp']:
    for mol in ['LiH.2s1p_1s_C1_hugeexp.mol', 'LiH.2s1p_1s_C1.mol', 'LiH.2s1p_1s_C2v.mol']:
        ierr += run(options,
                    configure,
                    input_files=[inp, mol],
                    extra_args='--mw=100 --aw=128',
                    filters={'out': f1})

for inp in ['MgO.dc_rkb.scf1fs_Xop.inp']:
    for mol in ['MgO.sto-2g.C1.mol','MgO.sto-2g.C2v_x_y.mol','MgO.sto-2g.auto.mol','MgO.sto-2g.C1_hugenucexp.mol']:
        ierr += run(options,
                    configure,
                    input_files=[inp, mol],
                    extra_args='--mw=100 --aw=128',
                    filters={'out': f1})

for inp in ['Ra_cv3z+.inp']:
    for mol in ['Ra_cv3z+2p-d.mol']:
        ierr += run(options,
                    configure,
                    input_files=[inp, mol],
                    extra_args='--mw=100 --aw=128',
                    filters={'out': f2})

sys.exit(ierr)
