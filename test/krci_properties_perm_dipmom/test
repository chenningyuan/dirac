#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = '   * dipole moment for electronic state:   1 (   a)',
      num_lines   = 83,
      ignore_sign = True,
      tolerance   = 1.0e-4)

test_run.execute(['h3.inp'], ['H3.mol'], f)

sys.exit(0)
