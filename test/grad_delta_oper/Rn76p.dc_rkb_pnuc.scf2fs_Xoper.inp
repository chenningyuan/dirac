**DIRAC
.TITLE
  Rn(76+)
.WAVE F ! Activate integral and wave functions modules
.ANALYZE
.4INDEX
**GENERAL
.DIRECT
1 1 1
.PRINT
1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
1
*READIN
.UNCONTRACTED
**HAMILTONIAN
.PRINT
0
.INTFLG
1 1 0
**WAVE FUNCTIONS 
.SCF
*SCF
#10 electrons
.CLOSED SHELL
4 6   
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-9  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
all
all
**MOLTRA
.NO2IND
.NO4IND
.NOMDCI
.ACTIVE
1..2
1..3
.PRPTRA
*PRPTRA
# we need this print level to get all MO mtx elements printed
.PRINT
3
#---------------------------------------
#   DIPVEL integrals for comparison
#---------------------------------------
.OPERATOR
 'd/dx oper'
 DIAGONAL 
 'XDIPVEL '
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dy oper'
 DIAGONAL 
 'YDIPVEL '
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dz oper'
 DIAGONAL 
 'ZDIPVEL '
 COMFACTOR
 1.00D0
#------------------------------------------------------------
#  Fermi-contact integrals for given nuclei for comparison
#------------------------------------------------------------
.OPERATOR
 'FC Rn '
 DIAGONAL 
 'FC Rn 01'
 COMFACTOR
 1.00D0
#
#-----------------------------------------------
# grad delta(r-R) operator for given nuclei
#-----------------------------------------------
.OPERATOR
 'd/dx dRn'
 DIAGONAL 
 'XGFRn 01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dy dRn'
 DIAGONAL 
 'YGFRn 01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dz dRn'
 DIAGONAL
 'ZGFRn 01'
 COMFACTOR
 1.00D0
#
*END OF
