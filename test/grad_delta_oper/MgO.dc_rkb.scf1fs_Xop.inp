**DIRAC
.TITLE
  MgO
.WAVE F ! Activate integral and wave functions modules
.ANALYZE
.4INDEX
.PROPER
**GENERAL
.DIRECT
1 1 1
.PRINT
1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
2
*READIN
.UNCONTRACTED
**HAMILTONIAN
.PRINT
1
.INTFLG
1 1 0
**WAVE FUNCTIONS
.SCF
*SCF
.CLOSED SHELL
20
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-9  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
1..10
**MOLTRA
.NO2IND
.NO4IND
.NOMDCI
.ACTIVE
1..10
.PRPTRA
*PRPTRA
# we need this print level to get all MO mtx elements printed
.PRINT
3
#---------------------------------------
#   DIPLEN integrals for comparison
#---------------------------------------
.OPERATOR
 'x diplen'
 DIAGONAL
 'XDIPLEN '
 COMFACTOR
 1.00D0
#
.OPERATOR
 'y diplen'
 DIAGONAL
 'YDIPLEN '
 COMFACTOR
 1.00D0
#
.OPERATOR
 'z diplen'
 DIAGONAL
 'ZDIPLEN '
 COMFACTOR
 1.00D0
#---------------------------------------
#   DIPVEL integrals for comparison
#---------------------------------------
.OPERATOR
 'd/dx oper'
 DIAGONAL
 'XDIPVEL '
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dy oper'
 DIAGONAL
 'YDIPVEL '
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dz oper'
 DIAGONAL
 'ZDIPVEL '
 COMFACTOR
 1.00D0
#------------------------------------------------------------
#  Fermi-contact integrals for given nuclei for comparison
#------------------------------------------------------------
.OPERATOR
 'FC Mg '
 DIAGONAL
 'FC Mg 02'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'FC O  '
 DIAGONAL
 'FC O  01'
 COMFACTOR
 1.00D0
#-----------------------------------------------
# grad delta(r-R) operator for given nuclei
#-----------------------------------------------
.OPERATOR
 'd/dx dMg'
 DIAGONAL
 'XGFMg 02'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dy dMg'
 DIAGONAL
 'YGFMg 02'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dz dMg'
 DIAGONAL
 'ZGFMg 02'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dx d O'
 DIAGONAL
 'XGFO  01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dy d O'
 DIAGONAL
 'YGFO  01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dz d O'
 DIAGONAL
 'ZGFO  01'
 COMFACTOR
 1.00D0
#-----------------------------------------------
# grad rho(r-R) operator for given nuclei
#-----------------------------------------------
.OPERATOR
 'd/dx pMg'
 DIAGONAL
 'DRHO 004'
 COMFACTOR
 -2.0943951
#
.OPERATOR
 'd/dy pMg'
 DIAGONAL
 'DRHO 005'
 COMFACTOR
 -2.0943951
#
.OPERATOR
 'd/dz pMg'
 DIAGONAL
 'DRHO 006'
 COMFACTOR
 -2.0943951
#
.OPERATOR
 'd/dx pO'
 DIAGONAL
 'DRHO 001'
 COMFACTOR
 -2.0943951
#
.OPERATOR
 'd/dy pO'
 DIAGONAL
 'DRHO 002'
 COMFACTOR
 -2.0943951
#
.OPERATOR
 'd/dz pO'
 DIAGONAL
 'DRHO 003'
 COMFACTOR
 -2.0943951
**PROPERTIES
.PRINT
3
*EXPECT
