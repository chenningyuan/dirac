**DIRAC
.TITLE
  MgO
.WAVE F ! Activate integral and wave functions modules
.ANALYZE
.4INDEX
**GENERAL
.DIRECT
1 1 1
.PRINT
1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
1
*READIN
.UNCONTRACTED
**HAMILTONIAN
.PRINT
1
.INTFLG
1 1 0
**WAVE FUNCTIONS 
.SCF
*SCF
.CLOSED SHELL
20  
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-9  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
1..10
**MOLTRA
.NO2IND
.NO4IND
.NOMDCI
.ACTIVE
1..10
.PRPTRA
*PRPTRA
# we need this print level to get all MO mtx elements printed
.PRINT
3
# grad delta(r-R) operator ...
.OPERATOR
 'd/dx d O'
 DIAGONAL 
 'XGFO  01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dy d O'
 DIAGONAL 
 'YGFO  01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dz d O'
 DIAGONAL
 'ZGFO  01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dx dMg'
 DIAGONAL 
 'XGFMg 02'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dy dMg'
 DIAGONAL 
 'YGFMg 02'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'd/dz dMg'
 DIAGONAL
 'ZGFMg 02'
 COMFACTOR
 1.00D0
*END OF
