**DIRAC
.TITLE
  LiH
.WAVE F ! Activate integral and wave functions modules
.ANALYZE
.4INDEX
**GENERAL
.DIRECT
1 1 1
.PRINT
1
**INTEGRALS
.PRINT
1
.NUCMOD ! 1-Point nucleus, 2-gaussian
2
*READIN
.UNCONTRACTED
**HAMILTONIAN
.PRINT
1
.INTFLG
1 1 0
**WAVE FUNCTIONS 
.SCF
*SCF
.CLOSED SHELL
4   
.INTFLG ! Specify what 2-el.integrals to include
1 1 0
.EVCCNV ! Energy convergence...
1.0D-9  1.0D-6
#################################################
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
all
**MOLTRA
.NO2IND
.NO4IND
.NOMDCI
.ACTIVE
1..2
.PRPTRA
*PRPTRA
# we need this print level to get all MO mtx elements printed
.PRINT
5
# grad delra(r-R) operator ...
.OPERATOR
 'x Li  '
 XALPHA   
 'XGFLi 01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'y Li  '
 YALPHA   
 'YGFLi 01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'z Li  '
 ZALPHA 
 'ZGFLi 01'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'x H   '
 XALPHA   
 'XGFH  02'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'y H   '
 YALPHA   
 'YGFH  02'
 COMFACTOR
 1.00D0
#
.OPERATOR
 'z H   '
 ZALPHA 
 'ZGFH  02'
 COMFACTOR
 1.00D0
*END OF
