import os
import sys
from subprocess import Popen, PIPE

#
# prepare environment, define functions
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = '! Requested density at point(s) !',
      num_lines   = 11,
      rel_tolerance   = 1.0e-5)

def compare_txt(fname, fname_ref):
    p = Popen(["diff", fname, fname_ref], stdin=PIPE)
    p.communicate()
    if p.returncode == 0:
        print('{} and {} are the same'.format(fname, fname_ref))
        sys.stdout.write('{} and {} are the same'.format(fname, fname_ref))
    elif p.returncode == 1:
        print('{} and {} are different'.format(fname, fname_ref))
        sys.stdout.write('{} and {} are different'.format(fname, fname_ref))
        sys.exit(1)
    else:
        print('error %s' % p.returncode)
        sys.stdout.write('error %s' % p.returncode)

#
# run tests
#

# ==========================================
# tests dependent on the unperturbed density
# ==========================================
test.run(['dc.inp'], ['h2o.mol'], args='--outcmo')
test.run(['vis_3d_h5out_unpert.inp'], ['h2o.mol'], args='--incmo --put="grid2.h5" --get="*.h5"')

#
# compare generated data with reference
#

try:
    import h5py
    h5py_available = True
except:
    h5py_available = False

if h5py_available:

    # gosia 19/5/2023
    # alternatively, there is h5diff tool,
    # but this may not always work, e.g.:
    # https://forum.hdfgroup.org/t/identical-hdf5-files-according-to-h5diff-differ-in-comparison-with-diff-unix-command/3285/5
    # so instead, we compare selected datasets

    def test_hdf5_single(fname, gf_name):
        data_file = h5py.File(fname, 'r')
        grid_ndim     = data_file['/result/grid/ndim']
        grid_npoints  = data_file['/result/grid/nr_points_total']
        return grid_ndim[0], grid_npoints[0]
 
    def test_hdf5_array(fname, gf_name, gf_test_key):
        data_file = h5py.File(fname, 'r')
        grid_functions = data_file['/result/grid_function']
        try:
            grid_function_values = data_file['/result/grid_function/'+gf_name+'/visualize/values/']
        except:
            sys.stdout.write(gf_name+' not found in '+fname)
            sys.exit(1)
        return grid_function_values[gf_test_key][()]

    def close_values(this_value, ref_value, rtol=None, atol=None):
      if atol is None:
          #atol = 0.05*ref_value 
          atol = 1.0e-20
      if rtol is None:
          #rtol = 0.05
          rtol = 1.0e-6
      is_close = abs(this_value-ref_value) <= max(rtol * max(abs(this_value), abs(ref_value)), atol)
      return is_close
 
    def compare_with_ref(ftest, fref, typ, gf_name, gf_test_key=None):
        if typ == 'single':
            test = test_hdf5_single(ftest, gf_name)
            ref  = test_hdf5_single(fref,  gf_name)
            res = tuple(i == j for i, j in zip(test, ref))
            if False in res:
                sys.stdout.write('Error! Different data on hdf5')

        elif typ == 'array':
            test = test_hdf5_array(ftest, gf_name, gf_test_key)
            ref  = test_hdf5_array(fref,  gf_name, gf_test_key)
            res = tuple(close_values(i, j) for i, j in zip(test, ref))
            if False in res:
                sys.stdout.write('Error! Different array data on hdf5')


    # test scalar grid functions
    testset = ['elf']

    for t in testset:
        compare_with_ref(ftest=t+'.h5', fref='result/'+t+'.h5', typ='single', gf_name=t)
        compare_with_ref(ftest=t+'.h5', fref='result/'+t+'.h5', typ='array',  gf_name=t, gf_test_key='t0_icomp_1')


