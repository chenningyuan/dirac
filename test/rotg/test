#!/usr/bin/env python

import os
import sys
sys.path.append(os.path.join(os.path.dirname(__file__), '..'))

from runtest import version_info, get_filter, cli, run
from runtest_config import configure

assert version_info.major == 2

f = [
    get_filter(from_string='Molecular g-tensor',
               to_string='E N D   of   D I R A C  output',
               rel_tolerance=1.0e-4)
]

options = cli()

ierr = 0
for inp in ['rotg.inp', 'rotg-LL.inp']:
    for mol in ['H2-sym.mol', 'HF-sym.mol', 'HF.mol', 'OCS-sym.mol', 'CH3F-sym.mol']:
        ierr += run(options,
                    configure,
                    input_files=[inp, mol],
                    extra_args='--mw=100 --aw=128',
                    filters={'out': f})

sys.exit(ierr)
