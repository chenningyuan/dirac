#
#
# VERSION : $Revision: 7753 $
# DATE    : $Date: 2008-09-17 15:03:43 +0200 (Wed, 17 Sep 2008) $
# FILE    : runtest
#
# (c) 1998 J. Thyssen
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# predefined restricted test sequences:
# note that the variable RUNTYPE (with values short, medium and long) is also used to 
# distinguish between different runs residing in one directory.
# The present definition is coarse grain and serves to
# exclude directories without a short run
#
# Some tests do not work in parallel (yet); the "*_partest" are the short, medum
# and long tests for parallel runs.
#
short_partest="1.energy+dipole 3.geomopt.dhf 4.levy-leblond.nmr 5.cisd.energy 6.cosci.energy 7.directmp2.energy 8.spinfree.cosci.energy 9.contraction 11.methods.cosci 14.basis.set.input 22.lucita_short 25.qrpa 30.linear 37.bss.energies  39.gaunt 40.dft_ac 49.xyzinput"
short_test="$short_partest"

medium_partest="2.nmrspinspin 10.efg 12.zora 13.rpa 19.fockspace 31.symmetry_recognition 32.prjana 33.frozen 36.mp2_properties"
medium_test="$short_test $medium_partest  54.stex"
#  is currently not working ! Nov. 2005 hjaaj
medium_partest="$short_partest $medium_partest"

long_partest="24.lucita_large  34.rhonuc 41.pv_nmr 46.dft_response"
long_test="$medium_test $long_partest"
long_partest="$medium_partest $long_partest"

benchmark_test="29.benchmark_cc"
# all_test takes all directories (and will fail if filters or output are absent !)
all_test=
for ff in [1-9]\.* [1-9][0-9]\.*; do
   if test -d $ff; then
      all_test=$all_test' '$ff
   fi
done
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Does 'echo' understand escapes?
#
#
if [ "	" = "`echo '\t'`" ]; then
   echo="echo"
else
   echo="echo -e"
fi
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# CHECK OPTIONS
#
#
usage () {
   $echo 'Usage: '$0
   $echo '--help'
   $echo '\tPrint this'
   $echo '--version'
   $echo '\tPrint version of runtest'
   $echo '--tests="tests to run"'
   $echo '\tChoose which tests to run (default: short)'
   $echo '--runtype="type of tests to run"'
   $echo '\tWhen tests are specified with number,
        choose the type (short,medium...) '
   $echo '--pampath="path to pam script"'
   $echo '\tSet path to pam script'
   $echo '--dirac="executable"'
   $echo '\tSpecify which dirac.x should be used'
   $echo '--run="tag"'
   $echo '\tLabel the output (default: runtest)'
   $echo '--mpi="number of slaves"'
   $echo '\tRun test in parallell under MPI'
   $echo '--nice'
   $echo '\texecute Dirac with nice/npri'
   $echo
}

# next line defines default test series
#
arg_tests=short
arg_pampath=$BIN_DIR
arg_dirac=$BIN_DIR/dirac.x
arg_tag=runtest
arg_mpi=
arg_nice=
RUNTYPE=undefined

while [ $# != 0 ]; do
   arg="$1"; shift
   case "${arg}" in
      -*=*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\([^=]*\)=.*$:\1:'`
         val=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*[^=]*=\(.*\)$:\1:'`
         valomitted=no
         ;;
      -*)
         opt=`echo '' ${arg} | sed -e 's:^ ::' -e 's:^-*\(.*\)$:\1:'`
         val="yes"
         valomitted=yes
         ;;
      *)
         $echo Invalid argument: ${arg}
         $echo $usage
         exit
   esac
   optname="${opt}"
   opt="`echo '' ${opt} | sed -e 's:^ ::' | tr - _`"
   case "${opt}" in
      "help")
         usage
         exit
         ;;
      "version")
         echo $0
         echo '$Revision: 7753 $'
         echo '$Date: 2008-09-17 15:03:43 +0200 (Wed, 17 Sep 2008) $'
         exit
         ;;
      "tests")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_tests="$val"
         ;;
      "runtype")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         RUNTYPE="$val" ; export RUNTYPE
         ;;
      "mpi")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_mpi="-mpi $val"
         ;;
      "dirac")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_dirac="$val"
         ;;
      "run")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_tag="$val"
         ;;
      "nice")
         arg_nice="-nice"
         ;;
      "pampath")
         if [ "${valomitted}" = "yes" ]; then
            echo  'Syntax error: Option "'${optname}'" is not allowed' \
                  'without an argument'
            exit 1
         fi
         arg_pampath="$val"
         ;;
      *)
         echo 'Unknown option: '$opt''
         usage
         exit 1
         ;;
   esac
done
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# FIND ALL POSSIBLE TESTS
# Create list of tests for this run
#
#
echo
echo 'FINDING TESTS...'
echo

if [ ! -z "$arg_tests" ]; then
   case "${arg_tests}" in
      "short")
         if [ -n "$arg_mpi" ]; then
            echo "Running <<short>> parallel tests ..."
            tests=$short_partest;
         else
            echo "Running <<short>> sequential tests ..."
            tests=$short_test;
         fi
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="short" ; export RUNTYPE; fi
         ;;
      "medium")
         tests=$medium_test;
         if [ -n "$arg_mpi" ]; then
            echo "Running <<medium>> parallel tests ..."
            tests=$medium_partest;
         else
            echo "Running <<medium>> sequential tests ..."
            tests=$medium_test;
         fi
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="medium" ; export RUNTYPE; fi
         ;;
      "long")
         tests=$long_test;
         if [ -n "$arg_mpi" ]; then
            echo "Running <<long>> parallel tests ..."
            tests=$long_partest;
         else
            echo "Running <<long>> sequential tests ..."
            tests=$long_test;
         fi
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="long" ; export RUNTYPE; fi
         ;;
      "benchmark")
         tests=$benchmark_test;
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="benchmark" ; export RUNTYPE; fi
         ;;
      "small_benchmark")
         tests=$benchmark_test;
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="small_benchmark" ; export RUNTYPE; fi
         ;;
      "large_benchmark")
         tests=$benchmark_test;
         if [ $RUNTYPE="undefined" ]; then RUNTYPE="large_benchmark" ; export RUNTYPE; fi
         ;;
      "all")
         tests=$all_test;
         ;;
      *)
#        hjaaj: extract and test users list of tests
         tests=
         for ff in ${arg_tests}; do
            if test -d $ff; then
#              hjaaj: OK, user has specified a test directory
               tests=$tests' '$ff
            else
#              hjaaj: check if test is specified just by number ?
               for ff2 in ${ff}\.*; do
                  if test -d $ff2; then
#                    hjaaj: yes, so OK
                     tests=$tests' '$ff2
                  else
                     echo "ERROR: test '$ff' not recognized"
                     exit 1
                  fi
               done
            fi
         done
         ;;
   esac
else
   if [ -n "$arg_mpi" ]; then
      echo "Running default: <<short>> parallel tests ..."
      tests=$short_partest;
   else
      echo "Running default: <<short>> sequential tests ..."
      tests=$short_test;
   fi
#  tests=$all_test
fi
#
# default to RUNTYPE="short" /hjaaj 070111
#
if [ $RUNTYPE = "undefined" ]; then
   RUNTYPE="short" ; export RUNTYPE
   echo "RUNTYPE defaults to short"
fi

echo
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
# CREATE HTML HEADER
#
cat <<\eor > logs/${arg_tag}_dif.htm
<HTML>
<TITLE> Error report for DIRAC test runs </TITLE>
<BODY TEXT="#FFFFFF" BGCOLOR="#000000">
<PRE>
<H1>drep output by color</H1>

<p>The colors are determined using relative errors for numbers larger than 0.001,
and absolute errors otherwise.</p>
<p>Only those digits that actually differ are yellow or red, the others are white.</p>
<p>The coloring scheme used:</p>
1.23456789  white: difference can be neglected (less than 1e-12)
1.23456<FONT COLOR="#FFFF00">789</FONT> yellow: difference probably neglegible (less than 0.001)
1.2<FONT COLOR="#FF0000">3456789</FONT>    red: probably significant difference (more than 0.001)

eor
echo "<p>Date and time for start of test: " `date` "</p>" >> logs/${arg_tag}_dif.htm
echo "<p> </p><hr><p> </p>"                               >> logs/${arg_tag}_dif.htm
#
#
# RUN THE REQUESTED TESTS
#
#
HOSTS=`hostname`
export HOSTS
echo 
echo "Running tests on host : $HOSTS ..."
echo
$echo "Using tests: $tests \c"
echo

if [ -e logs/${arg_tag}_dif.txt ]; then
   rm logs/${arg_tag}_dif.txt
fi

for tt in $tests; do
   if [ ! -d $tt ]; then
      echo 'Test '$tt' not found...'
      exit 1
   fi
   echo
   echo '*****> Running test '$tt
   echo
   if [ -r $tt/README ]; then
      cat $tt/README
   fi
   echo
   ( cd $tt; \
     PAM_PATH=$arg_pampath; export PAM_PATH; \
     MPIARG=$arg_mpi; export MPIARG; \
     DIRAC=$arg_dirac; export DIRAC; \
     TAG=$arg_tag; export TAG; \
     NICE=$arg_nice; export NICE; \
     ./run.sh; \
     cd .. )  
done
#
cat <<\eor >> logs/${arg_tag}_dif.htm

</BODY>
</HTML>
eor
