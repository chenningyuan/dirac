#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f1 = Filter()
f2 = Filter()

f1.add(from_string = 'Final results for EOM-EE',
      num_lines   = 30,
      abs_tolerance = 1.0e-7)

f2.add(from_string = 'Final results for EOM-IP',
      num_lines   = 30,
      abs_tolerance = 1.0e-7)

#test.run(['eom_ee_Be.inp'],                                                        ['Be.mol'], f1, args='--mw=110')

test.run(['eom_ee_Be_nonrel_cont.inp',       'eom_ee_Be_nonrel_cont_p.inp'],       ['Be.mol'], f1, args='--mw=110')
test.run(['eom_ee_Be_nonrel_cont_MBPT2.inp', 'eom_ee_Be_nonrel_cont_p_MBPT2.inp'], ['Be.mol'], f1, args='--mw=110')

test.run(['eom_ip_Be_nonrel_cont.inp',       'eom_ip_Be_nonrel_cont_p.inp'],       ['Be.mol'], f2, args='--mw=110')
test.run(['eom_ip_Be_nonrel_cont_MBPT2.inp', 'eom_ip_Be_nonrel_cont_p_MBPT2.inp'], ['Be.mol'], f2, args='--mw=110')

sys.exit(test.return_code)
