#!/bin/sh
#
# This script was originally written by Olivier Visser
# Scientific Computing & Modelling NV (SCM) 
# Modified and ported to DIRAC by Lucas Visscher, January 2002.
# Modified for $IGNORESIGN by Christoph Jacob, November 2005
#
# Known problem: If numbers have a different sign and the sign
# is ignored, it always colors the whole number, not only the
# digits that differ
# 

SCRIPT=/tmp/$$.pl
cat <<\eor >$SCRIPT



$small = 1e-3;
$verysmall = 1e-12;

$RED="<FONT COLOR=\"#FF0000\">";
$YELLOW="<FONT COLOR=\"#FFFF00\">";
$BLACK="<FONT COLOR=\"#000000\">";
$WHITE="<FONT COLOR=\"#FFFFFF\">";

$CEND="</FONT>";


#------------
sub GetReal {
#------------
#
#---------------------------------------------------------
# parse line to get next real:
# $prereal: all text up to the real
# $real: the real
# $postreal: rest of the line
#
# if no real is found, both $real and $postreal are empty,
# and $prereal contains the complete line
#---------------------------------------------------------

    local ($line) = @_;
    local ($i, $astr);

    # -----------------
    # initialize result
    # -----------------

    $prereal = "";
    $real = "";
    $postreal = $line;

    # ------------------------
    # find first decimal point
    # ------------------------

    $linelength = length ($line);
    for ($i=0; $i<$linelength-1; $i++) {
        $astr = substr ($line, $i, 2);
        if ($astr =~ /\.\d/) {last;}
        }

    if ($astr =~ /\.\d/) {

        # ---------------------------
        # find last decimal backwards
        # ---------------------------
    
        $match = $i;
        for ($j=$i-1; $j>=0; $j--) {
            $astr = substr ($line, $j, 1);
            if ($astr =~ /\d/) {
                $match = $j;
                }
            else {
                last;
                }
            }
        
        # ----------------
        # try to find sign
        # ----------------

        if ($match>0) {
            $astr = substr ($line, $match-1, 1);
            if ($astr =~ /[\+\-]/) {$match = $match-1;}
            }
        }

        # ------------------------------------------
        # extend match until no longer a real number
        # ------------------------------------------

        $maxlen = length ($line) - $match;
        for ($j=$maxlen; $j>=1; $j--) {
            $astr = substr ($line, $match, $j);
            if ($astr =~ /^[\-\+]?\d*\.\d*[edED]?[\-\+]?\d*$/) {last;}
            }
        $real = substr ($line, $match, $j);
        $prereal = substr ($line, 0, $match-1);
        $maxlen = length ($line) - $match - $j;
        $postreal = substr ($line, $match+$j, $maxlen);
    }

# ---------------------------------------
# determine names of the files to compare
# ---------------------------------------

$s1 = $ARGV[0];
$s2 = $ARGV[1];

# --------------
# open the files
# --------------

open (FILE1, "<$s1") || die "Error opening $s1\n";
open (FILE2, "<$s2") || die "Error opening $s2\n";

# -----------------
# start HTML output
# -----------------

print "<HTML>\n";
print "<TITLE> drep $s1 $s2</TITLE>\n";
print "<BODY TEXT=\"#FFFFFF\" BGCOLOR=\"#000000\">\n";
print "<PRE>\n";

print "<H1>drep output by color</H1>\n\n";
print "<p>The colors are determined using relative errors for numbers larger than $small, and ";
print "absolute errors otherwise.</p>\n";
print "<p>Only those digits that actually differ are yellow or red, the others are white.</p>\n";
print "<p>The coloring scheme used:</P>\n";
print "1.23456789  white: difference can be neglected (less than $verysmall)\n";
print "1.23456".$YELLOW."789".$CEND." yellow: difference probably neglegible (less than $small)\n";
print "1.2".$RED."3456789".$CEND."    red: probably significant difference (more than $small)\n";

# ------------
# produce diff
# ------------

$nextheading = 0;

# ----------------------------
# read all numbers from file 2
# ----------------------------

$countline = 0;
$count = 0;
foreach $line (<FILE2>) {
    $countline++;
    if ($countline > 9) {
       chop ($line);
       do GetReal ($line);
       while ($real ne "") {
           $line = $postreal;
           $R2[$count] = $real;
           $count++;
           do GetReal ($line);
           }
       }
    }
close (FILE2);

# ------------------------------
# scan, compare and print file 1
# ------------------------------

$countline = 0;
$count = 0;
$signcheck = 1;
foreach $thisline (<FILE1>) {
 $countline++;
 if ($countline <= 9) {
    print "$thisline";
 }
 if ($countline > 9) {
       chop ($thisline);
       $line = $thisline;
   
       # ------------------------
       # special case: bar of ===
       # ------------------------
   
       if ($line =~ /^ *={20,}[ =]*$/) {
           print "<HR>\n";
           next;
           }
     
       if ($line =~ /^\$ERROR (.*)$/) {
           $small = $1;
       }
       if ($line =~ /^\$IGNORESIGN/) {
           $signcheck = 0;
       }
       if ($line =~ /^\$SIGNCHECK/) {
           $signcheck = 1;
       }

       do GetReal ($line);
       while ($real ne "") {
           $line = $postreal;
           $r1 = $real;
           $r2 = $R2[$count];

        # -------------------------------
        # determine difference in numbers
        # -------------------------------

        $diff = $real - $R2[$count];
        $posreal = $real;
        if ($real < 0) {$posreal = -$real;}
        if ($diff < 0) {$diff = -$diff;}
        if ($posreal > 1.0) {$diff = $diff / $posreal;}

#radovan: posreal is zero if the number is zero
#         so the following line will result in "no error"
#         for results that are zero:
#       if ($posreal < 1.0) {$diff = $diff * $posreal;}
#
#         instead do:
        if ($posreal < 1.0) {
           if ($posreal > 0.0) {$diff = $diff * $posreal;}
           }

        if ($signcheck == 0) {
            
            # ---------------------------------------------- 
            # calculate the difference the other way around
            # ---------------------------------------------- 

            $diff2 = $real + $R2[$count];
            if ($diff2 < 0) {$diff2 = -$diff2;}
            if ($posreal > 1.0) {$diff2 = $diff2 / $posreal;}
            if ($posreal < 1.0) {$diff2 = $diff2 * $posreal;}

            # ---------------------------------------------- 
            # use the smaller of the two differences
            # ---------------------------------------------- 

            if ($diff2 < $diff) {$diff = $diff2;}
        }

        # ---------------------------
        # and the corresponding color
        # ---------------------------

        if ($diff > $small) {
            $color = $RED;
            }
        elsif ($diff > $verysmall) {
            $color = $YELLOW;
            }
        else {
            $color = $WHITE;
            }

        # ------------------------------
        # add leading zero's if required
        # ------------------------------
        
        if ($r1 =~ /^\./) {$r1 =~ s/^\./0\./; $prereal =~ s/^(.*) $/$1/;}
        if ($r2 =~ /^\./) {$r2 =~ s/^\./0\./; $prereal =~ s/^(.*) $/$1/;}
        if ($r1 =~ /^-\./) {$r1 =~ s/^-\./-0\./; $prereal =~ s/^(.*) $/$1/;}
        if ($r2 =~ /^-\./) {$r2 =~ s/^-\./-0\./; $prereal =~ s/^(.*) $/$1/;}

        # ------------
        # print output 
        # ------------

        print "$prereal";

        print $WHITE;
        for ($i = 0; $i<length($r1); $i++) {
            $achar1 = substr ($r1, $i, 1);
            $achar2 = substr ($r2, $i, 1);
            if ($achar1 eq $achar2) {print $achar1;}
            else {last;}
            }
        print $CEND;
        print $color;
        $achar1 = substr ($r1, $i, length ($r1) - $i);
        print $achar1;
        print $CEND;
        
        $count++;
        do GetReal ($line);
        }

    # ---------------------------------------------
    # print rest of line (not containing any reals)
    # ---------------------------------------------

    print "$line";

    if ($nextheading == 1) {print "</H1>"; $nextheading = 0;}
    print "\n";

    # ------------------------------------------
    # Title of run after line containing RunTime
    # ------------------------------------------

    if ($thisline =~ /RunTime/) {$nextheading = 1; print "\n<H1>";}
    }
}


# -----------------
# close HTML output
# -----------------

print "</PRE>";
print "</BODY>\n";
print "</HTML>\n";


eor
perl -s $SCRIPT $@
rm $SCRIPT
