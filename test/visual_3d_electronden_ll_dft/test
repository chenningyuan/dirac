#!/usr/bin/env python

import os
import sys
from pathlib import Path

#
# prepare environment, define functions
#

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun
from runtest_rs import CompareHDF5
test = TestRun(__file__, sys.argv)

#
# prepare grid files
#
grid_3d_h5=Path(test.work_dir, 'grid.h5')
grid_3d_h5.unlink(missing_ok=True)
grid_3d_h5=grid_3d_h5.symlink_to(Path(Path(__file__).parents[1].resolve(), 'testdata', 'grid_visual_3D.h5'))

#
# run tests
#
test.run(['ll.inp'], ['h2o.mol'], args='--outcmo')
test.run(['vis.inp'], ['h2o.mol'], args='--incmo --put="grid.h5" --get="*.h5"')

#
# compare generated data with reference
#

rs = CompareHDF5(test.work_dir)

testset = ['ed', 'rdg', 'ed_sign_lambda2', 'ed_laplacian']
for t in testset:

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='single',\
              gf_label='/result/grid/ndim')

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='single',\
              gf_label='/result/grid/nr_points_total')

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='array',\
              gf_label='/result/grid_function/'+t+'/visualization/values/',
              gf_test_key='t0_icomp_1')


testset = ['ed_gradient']
for t in testset:

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='single',\
              gf_label='/result/grid/ndim')

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='single',\
              gf_label='/result/grid/nr_points_total')

    for i in range(1,4):
        rs.verify(ftest=t+'.h5',\
                  fref='result/'+t+'.h5',\
                  typ='array',\
                  gf_label='/result/grid_function/'+t+'/visualization/values/',
                  gf_test_key='t1_icomp_'+str(i))

testset = ['ed_hessian']
for t in testset:

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='single',\
              gf_label='/result/grid/ndim')

    rs.verify(ftest=t+'.h5',\
              fref='result/'+t+'.h5',\
              typ='single',\
              gf_label='/result/grid/nr_points_total')

    for i in range(1,10):
        rs.verify(ftest=t+'.h5',\
                  fref='result/'+t+'.h5',\
                  typ='array',\
                  gf_label='/result/grid_function/'+t+'/visualization/values/',
                  gf_test_key='t2_icomp_'+str(i))

