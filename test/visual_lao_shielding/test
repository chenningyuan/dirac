#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = '      scalar              x-component         y-component         z-component',
      num_lines   = 3,
      tolerance   = 1.0e-5)

test_run.execute(['rsp_ll_nolao.inp'], ['hf.mol'],    args=' --get="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_ll_nolao.inp'], ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')

test_run.execute(['rsp_ll_lao.inp'], ['hf.mol'],    args=' --get="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_ll_lao.inp'], ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')

test_run.execute(['rsp_dc_nolao.inp'], ['hf.mol'],    args=' --get="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_dc_nolao.inp'], ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')

test_run.execute(['rsp_dc_lao_nc.inp'],            ['hf.mol'],    args=' --get="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_dc_lao_nc.inp'],            ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_dc_lao_none_after_nc.inp'], ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')

test_run.execute(['rsp_dc_lao_sc.inp'],            ['hf.mol'],    args=' --get="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_dc_lao_sc.inp'],            ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_dc_lao_none_after_sc.inp'], ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')

test_run.execute(['rsp_dc_lao_g987.inp'],                   ['hf.mol'],    args=' --get="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_dc_lao_reorth_g987_select_all.inp'], ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_dc_lao_reorth_g987_select_35.inp'],  ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')

test_run.execute(['rsp_dc_lao_g123.inp'],                   ['hf.mol'],    args=' --get="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_dc_lao_reorth_g123_select_all.inp'], ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')
test_run.execute(['vis_dc_lao_reorth_g123_select_35.inp'],  ['hf.mol'], f, args='--copy="DFCOEF PAMXVC TBMO"')

# cleanup
os.unlink('DFCOEF')
os.unlink('PAMXVC')
os.unlink('TBMO')

sys.exit(0)
