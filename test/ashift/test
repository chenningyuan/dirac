#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(string = '* Electronic eigenvalue',
      rel_tolerance = 1.0e-7)

# run calculation for carbon in linear symmetry
test.run(['C.inp'], ['C.xyz'])
#testing if HDF5 or fallback is used; needed for cleanup
if os.path.isfile('C.h5'):
    ext = '.h5'
elif os.path.isfile('C.noh5.tar.gz'):
    ext = '.noh5.tar.gz'
# run calculation for carbon monoxide
test.run(['C1s_shift.inp'], ['CO.xyz'], f, '--put="C.h5=AFCXXX" --noh5')
# cleanup
os.unlink('C'+ext)

sys.exit(test.return_code)
