#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(string = 'Final KR-MCSCF energy',
      rel_tolerance = 1.0e-9)

# symmetric water: real group C2v, coefficients reused in C2 (complex) and C1 (quaternion)
test.run(['acmout.inp'], ['c2v.mol'], f)
test.run(['acmoin.inp'], ['c2.mol'], f, '--put "acmout_c2v.h5=DFACMO.h5"')
test.run(['acmoin.inp'], ['c1.mol'], f, '--put "acmout_c2v.h5=DFACMO.h5"')

# asymmetric (planar) water: complex group Cs, coefficients reused in C1 (quaternion)
test.run(['acmout.inp'], ['cs_asym.mol'], f)
test.run(['acmoin.inp'], ['c1_asym.mol'], f, '--put "acmout_cs_asym.h5=DFACMO.h5"')

sys.exit(test.return_code)
