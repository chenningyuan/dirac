#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(string = '* Electronic eigenvalue',
      tolerance = 1.0e-7)

# run calculation for hydrogen in linear symmetry
test_run.execute(['H_lin.inp'], ['H_lin.mol'], f, '--get=DFACMO')

# export coefficients to cs symmetry
test_run.execute(['H_Cs.inp'], ['H_Cs.mol'], f, '--get=DFCOEF --put=DFACMO')
shutil.copy('DFCOEF', 'DFHAT1')
shutil.copy('DFCOEF', 'DFHAT2')
shutil.copy('DFCOEF', 'DFHAT3')

# run calculation for nitrogen in linear symmetry
test_run.execute(['N_lin.inp'], ['N_lin.mol'], f, '--get="DFCOEF DFACMO"')
shutil.copy('DFCOEF', 'DFCAT')

# export coefficients to cs symmetry
test_run.execute(['N_Cs.inp'], ['N_Cs.mol'], f, '--get=DFCOEF --put=DFACMO')
shutil.copy('DFCOEF', 'DFNNNN')

# run calculation for ammonia; note that it is flat ...
test_run.execute(['NH3.inp'], ['NH3.mol'], f, '--put="DFNNNN DFHAT1 DFHAT2 DFHAT3"')

# cleanup
os.unlink('DFCOEF')
os.unlink('DFACMO')
os.unlink('DFNNNN')
os.unlink('DFCAT')
os.unlink('DFHAT1')
os.unlink('DFHAT2')
os.unlink('DFHAT3')

sys.exit(0)
