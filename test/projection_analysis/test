#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-9)
f.add(from_string = 'Eigenvalues',
      to_re       = 'HOMO - LUMO',
      tolerance   = 1.0e-5)
f.add(from_string = '* Total gross contributions',
      num_lines   = 7,
      tolerance   = 1.0e-4)

test_run.execute(['H.inp'], ['H.mol'], args='--get=DFACMO')
shutil.copy('DFACMO', 'DFHAT1')
shutil.copy('DFACMO', 'DFHAT2')
shutil.copy('DFACMO', 'DFHAT3')
shutil.copy('DFACMO', 'DFHAT4')

test_run.execute(['C.inp'], ['C.mol'], args='--get=DFACMO')
shutil.copy('DFACMO', 'DFCAT')

test_run.execute(['CH4.inp'], ['CH4.mol'], f, args='--copy="DFCAT DFHAT1 DFHAT2 DFHAT3 DFHAT4"')

# cleanup
os.unlink('DFACMO')
os.unlink('DFCAT')
os.unlink('DFHAT1')
os.unlink('DFHAT2')
os.unlink('DFHAT3')
os.unlink('DFHAT4')

sys.exit(0)
