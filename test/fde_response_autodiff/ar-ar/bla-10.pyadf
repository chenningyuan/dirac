import shutil

file_h2o_1 = os.path.join (pyadfenv.outdir, 'Ar3-mol.xyz')
file_mol   = os.path.join (pyadfenv.outdir, 'Ar-mol.xyz')

m_h2o_1 = molecule(file_h2o_1)
m_mol   = molecule(file_mol)

m_tot = m_mol + m_h2o_1 

print m_tot.print_coordinates()

# Prepare first water molecule
r_h2o_1 = adfsinglepointjob(myfiles, m_h2o_1, 'AUG/ATZ2P', options=['NOSYMFIT']).run()

fdesettings = adfsettings()
# save TAPE10 is needed for exporting the FDE potential
fdesettings.set_save_tapes([21,10])
fdesettings.set_unrestricted(False)
fdesettings.set_functional('LDA')
fdesettings.set_integration(accint=6.0)

frags = [fragment(r_h2o_1, [m_h2o_1], isfrozen=True),
	 fragment(None,    [m_mol]  ) ]

fde_res = adffragmentsjob(myfiles, frags, basis="AUG/ATZ2P", settings=fdesettings, options=['NOSYM', 'EXCITATIONS\n LOWEST 50\n END\n', 'RESPONSE\n ALLCOMPONENTS\n  Nfreq 2\n  FrqBeg 0.000000\n  FrqEnd 27.211\nEND\n']).run()

grid = adfgrid(fde_res)

fde_res.export_embedding_potential(os.path.join(pyadfenv.outdir, 'EMBPOT.k.atz2p'), dens_filename=os.path.join(pyadfenv.outdir, 'BLA22.k.atz2p'))

rhob = fde_res.get_frozen_density (grid=grid)
rhob.get_xyzw (os.path.join(pyadfenv.outdir, 'FRZDNS.k.atz2p'))

