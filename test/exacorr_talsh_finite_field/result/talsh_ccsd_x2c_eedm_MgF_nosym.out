 1.0D0                                                                                              
**EXACC                                                                                             
.PRINT                                                                                              
4                                                                                                   
.OCCUPIED                                                                                           
energy -1  0.0 0.001                                                                                
.VIRTUAL                                                                                            
energy 0.0   2 0.001                                                                                
.OCC_BETA                                                                                           
energy -1  -0.2 0.001                                                                               
.VIR_BETA                                                                                           
energy -0.2   2 0.001                                                                               
.FF_PROP                                                                                            
1 2                                                                                                 
Heff_EDM                                                                                            
0.0000,0.00000                                                                                      
0.0000, 0.005                                                                                       
.NCYCLES                                                                                            
60                                                                                                  
.TCONVERG                                                                                           
1.0D-7                                                                                              
*END OF                                                                                             


