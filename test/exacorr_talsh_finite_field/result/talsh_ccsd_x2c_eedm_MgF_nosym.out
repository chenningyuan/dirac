**INTEGRALS                                                                                         
.PRINT                                                                                              
1                                                                                                   
.NUCMOD                                                                                             
2                                                                                                   
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONIAN                                                                                       
.PRINT                                                                                              
1                                                                                                   
.X2C                                                                                                
**WAVE FUNCTIONS                                                                                    
.SCF                                                                                                
.EXACC                                                                                              
*SCF                                                                                                
.CLOSED SHELL                                                                                       
20                                                                                                  
.OPEN SHELL                                                                                         
1                                                                                                   
1 / 2                                                                                               
.EVCCNV                                                                                             
1.0D-9  1.0D-6                                                                                      
**ANALYZE                                                                                           
.MULPOP                                                                                             
*MULPOP                                                                                             
.VECPOP                                                                                             
all                                                                                                 
**MOLTRA                                                                                            
.ACTIVE                                                                                             
energy -1.00   2.0 0.001                                                                            
.NO4IND                                                                                             
.PRPTRA                                                                                             
