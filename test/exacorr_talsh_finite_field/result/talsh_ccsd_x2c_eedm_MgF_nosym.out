**DIRAC                                                                                             
.TITLE                                                                                              
  MgF   -> eEDM                                                                                     
.WAVE F                                                                                             
.4INDEX                                                                                             
#.ANALYZE                                                                                           
**INTEGRALS                                                                                         
.PRINT                                                                                              
1                                                                                                   
.NUCMOD                                                                                             
2                                                                                                   
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONIAN                                                                                       
.PRINT                                                                                              
1                                                                                                   
.X2C                                                                                                
**WAVE FUNCTIONS                                                                                    
.SCF                                                                                                
.EXACC                                                                                              
*SCF                                                                                                
.CLOSED SHELL                                                                                       
20                                                                                                  
.OPEN SHELL                                                                                         
1                                                                                                   
1 / 2                                                                                               
.EVCCNV                                                                                             
1.0D-9  1.0D-6                                                                                      
**ANALYZE                                                                                           
.MULPOP                                                                                             
*MULPOP                                                                                             
.VECPOP                                                                                             
all                                                                                                 
**MOLTRA                                                                                            
.ACTIVE                                                                                             
energy -1000.00   2000.0 0.01                                                                       
.NO4IND                                                                                             
.PRPTRA                                                                                             
*PRPTRA                                                                                             
# eEDM effective operator                                                                           
.OPERATOR                                                                                           
 'Heff_EDM'                                                                                         
 iBETAGAM                                                                                           
 EDM                                                                                                
 COMFACTOR                                                                                          
 1.0D0                                                                                              
**EXACC                                                                                             
.PRINT                                                                                              
4                                                                                                   
.OCCUPIED                                                                                           
energy -1000  0.0 0.01                                                                              
.VIRTUAL                                                                                            
energy 0.0   2000 0.01                                                                              
.OCC_BETA                                                                                           
energy -1000  -0.2 0.01                                                                             
.VIR_BETA                                                                                           
energy -0.2   2000 0.01                                                                             
.FF_PROP                                                                                            
1 3                                                                                                 
Heff_EDM                                                                                            
0.0000,0.00000                                                                                      
0.0000, 0.0001                                                                                      
0.0000,-0.0001                                                                                      
.NCYCLES                                                                                            
99                                                                                                  
.TCONVERG                                                                                           
1.0D-10                                                                                             
*END OF                                                                                             


