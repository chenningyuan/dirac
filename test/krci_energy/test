#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(string    = ' The final eigenvalue',
      tolerance = 1.0e-6)

test_run.execute(['be.d2h.inp'], ['Be.d2h.mol'], f)
test_run.execute(['f.inp'], ['F.mol'], f)

sys.exit(0)
