#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()

f.add(from_string = 'Expectation values',
      to_string   = '    s0 = T : Expectation value zero by point group symmetry.')
f.add(from_string = 'DIRAC  - INDIRECT NUCLEAR SPIN-SPIN-COUPLINGS',
      to_string   = 'DSO contribution to reduced SSCC K (SI)')
f.add(from_string = 'At1  #  iso',
      num_lines   = 4,
      tolerance   = 1.0e-3)

test_run.execute(['bss_rkb+mfsso.spsp.inp'], ['H2O.mol'], f, args='--mw=100 --aw=128')

f.add(from_string = 'RPA results',
      to_string   = 'Timing of routine RPAA')

test_run.execute(['spsp.inp', 'bss.spsp.inp', 'bss+mfsso.spsp.inp'], ['H2O.mol'], f, args='--mw=100 --aw=128')

sys.exit(0)
