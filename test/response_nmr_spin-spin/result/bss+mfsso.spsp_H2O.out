 -1.0D0                                                                                             
.OPERATOR                                                                                           
 'SPI05H'                                                                                           
 XAVECTOR                                                                                           
 'NEF 003'                                                                                          
 'NEF 008'                                                                                          
 CMULT                                                                                              
 COMFACTOR                                                                                          
 -1.0D0                                                                                             
.OPERATOR                                                                                           
 'SPI06H'                                                                                           
 ZAVECTOR                                                                                           
 'NEF 009'                                                                                          
 'NEF 002'                                                                                          
 CMULT                                                                                              
 COMFACTOR                                                                                          
 -1.0D0                                                                                             
.OPERATOR                                                                                           
 'SPI07O'                                                                                           
 ZAVECTOR                                                                                           
 'NEF 007'                                                                                          
 'NEF 004'                                                                                          
 CMULT                                                                                              
