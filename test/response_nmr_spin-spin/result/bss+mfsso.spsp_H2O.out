 -1.0D0                                                                                             
.OPERATOR                                                                                           
 'SPI08H'                                                                                           
 XAVECTOR                                                                                           
 'NEF 006'                                                                                          
 'NEF 009'                                                                                          
 CMULT                                                                                              
 COMFACTOR                                                                                          
 -1.0D0                                                                                             
.OPERATOR                                                                                           
 'SPI09H'                                                                                           
