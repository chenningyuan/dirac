 -1.0D0                                                                                             
.OPERATOR                                                                                           
 'SPI05H'                                                                                           
 XAVECTOR                                                                                           
 'NEF 003'                                                                                          
 'NEF 008'                                                                                          
 CMULT                                                                                              
 COMFACTOR                                                                                          
 -1.0D0                                                                                             
.OPERATOR                                                                                           
 'SPI06H'                                                                                           
 ZAVECTOR                                                                                           
 'NEF 009'                                                                                          
 'NEF 002'                                                                                          
 CMULT                                                                                              
