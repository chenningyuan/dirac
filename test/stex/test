#!/usr/bin/env python

import os
import sys
import shutil

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string  = 'Electronic energy',
      num_lines     = 8,
      rel_tolerance    = 1.0e-10)
f.add(from_string  = ' --------------- STEX Final Output --------------',
      to_string    = '   Sum of oscillator strengths',
      rel_tolerance    = 7.0e-5,
      mask = [1,2,3,4], # miro: compare only first four numbers, avoid comparing components
      ignore_below = 1.0e-9)

test.run(['gs.inp'], ['LiH-c1.mol'])

test.run(['ion.inp'], ['LiH-c1.mol'], args='--put "gs_LiH-c1.h5=CHECKPOINT.h5"')

test.run(['stex.inp'], ['LiH-c1.mol'], f, args='--put "gs_LiH-c1.h5=CHECKPOINT.h5 ion_LiH-c1.h5=ION.h5"')

sys.exit(test.return_code)
