#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f1 = Filter()

f1.add(from_string = '*************CC-CC(LR-CC) linear response*************',
      num_lines   = 3,
      rel_tolerance   = 1.0e-7)

f2 = Filter()

f2.add(from_string = '*************CC-CC(LR-CC) linear response*************',
      num_lines   = 3,
      rel_tolerance   = 1.0e-7)


test.run(['cc-cc_ccpvdz_lr_lz_lz_0.0_nr.inp'], ['lih.xyz'], f1)
test.run(['cc-cc_ccpvdz_lr_lz_lz_0.0_nr_asym.inp'], ['lih.xyz'], f1)
test.run(['cc-cc_ccpvdz_lr_lz_lz_0.0_nr_asym_b.inp'], ['lih.xyz'], f1)
test.run(['cc-cc_ccpvdz_lr_lz_lz_0.0_x2c.inp' ], ['lih.xyz'], f2)
test.run(['cc-cc_ccpvdz_lr_lz_lz_0.0_x2c_asym.inp' ], ['lih.xyz'], f2)
sys.exit(test.return_code)
