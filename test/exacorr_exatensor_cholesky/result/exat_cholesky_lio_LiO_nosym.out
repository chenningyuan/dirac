!                                                                                                   
**DIRAC                                                                                             
.WAVE FUNCTIONS                                                                                     
.TITLE                                                                                              
LiO SCF energies                                                                                    
.4INDEX                                                                                             
**HAMILTONIAN                                                                                       
.X2C                                                                                                
.PRINT                                                                                              
1                                                                                                   
**INTEGRALS                                                                                         
*READIN                                                                                             
.UNCONTRACT                                                                                         
*TWOINT                                                                                             
.SCREEN                                                                                             
1.0D-16                                                                                             
**WAVE FUNCTIONS                                                                                    
.SCF                                                                                                
.EXACC                                                                                              
*SCF                                                                                                
.CLOSED SHELL                                                                                       
10                                                                                                  
.OPEN SHELL                                                                                         
1                                                                                                   
1 / 2                                                                                               
.EVCCNV                                                                                             
1.0E-10 1.0E-7                                                                                      
.MAXITR                                                                                             
50                                                                                                  
**MOLTRA                                                                                            
.ACTIVE                                                                                             
energy -5.0 5.0 0.01                                                                                
.NO4IND                                                                                             
**EXACC                                                                                             
.EXATENSOR                                                                                          
.OCCUPIED                                                                                           
energy -5.0  0.0  0.01                                                                              
