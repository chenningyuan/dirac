!
**DIRAC
.TITLE
  xxx
.WAVE F
.ANALYZE
#.4INDEX
**INTEGRALS
*READIN
.UNCONTRACTED
**HAMILTONAIN
.INTFLG
1 1 0
.PRINT
2
### EDM ###
.OPERATOR
 'Heff_EDM'
 iBETAGAM
 EDM
 COMFACTOR
 0.0001
### z dip.mom ###
.OPERATOR
 ZDIPLEN
 COMFACTOR
 0.002
**WAVE FUNCTIONS
.DHF
.RELCCSD
*DHFCAL
.EVCCNV
1.0E-8 1.0E-6
.CLOSED SHELL
10
.OPEN SHELL
1
1/2
**ANALYZE
.MULPOP
*MULPOP
.VECPOP
all
#.NETPOP
**MOLTRA
.ACTIVE
energy -30.0 3000.0 1.0
*END OF

 &RELCCSD DOFSPC=F  DOENER=T  IPRNT=2  NELEC=4,5  INTERFACE="DIRAC" DEBUG=F &END
 &CCENER  DOMP2=T  DOCCSD=T  DOCCSDT=T  NTOL=7  &END
 &CCSORT  USEOE=F   &END


