!                                                                                                   
**DIRAC                                                                                             
.TITLE                                                                                              
  EDM for Na at CC level                                                                            
.ANALYZE                                                                                            
.WAVE F                                                                                             
**INTEGRALS                                                                                         
*READIN                                                                                             
.UNCONTRACTED                                                                                       
**HAMILTONAIN                                                                                       
.INTFLG                                                                                             
1 1 0                                                                                               
.PRINT                                                                                              
2                                                                                                   
### EDM ###                                                                                         
.OPERATOR                                                                                           
 'Heff_EDM'                                                                                         
 iBETAGAM                                                                                           
 EDM                                                                                                
 COMFACTOR                                                                                          
 0.001                                                                                              
### z dip.mom ###                                                                                   
.OPERATOR                                                                                           
 ZDIPLEN                                                                                            
 COMFACTOR                                                                                          
 0.002                                                                                              
**WAVE FUNCTIONS                                                                                    
#.SCF                                                                                               
.RELCCSD                                                                                            
*SCF                                                                                                
.EVCCNV                                                                                             
1.0E-8 1.0E-6                                                                                       
.CLOSED SHELL                                                                                       
10                                                                                                  
.OPEN SHELL                                                                                         
1                                                                                                   
1/2                                                                                                 
**ANALYZE                                                                                           
.MULPOP                                                                                             
*MULPOP                                                                                             
.VECPOP                                                                                             
all                                                                                                 
**MOLTRA                                                                                            
.ACTIVE                                                                                             
energy -30.0 3000.0 1.0                                                                             
*END OF                                                                                             
                                                                                                    
 &RELCCSD DOFSPC=F  DOENER=T  IPRNT=1  NELEC=4,5  INTERFACE="DIRAC" DEBUG=F  &END                   
 &CCENER  DOMP2=T  DOCCSD=T  DOCCSDT=T  NTOL=11  &END                                               
 &CCSORT  USEOE=F   &END                                                                            


