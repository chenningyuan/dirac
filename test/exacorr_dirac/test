os.environ['QF_MICS_PER_PROCESS'] = "0"           #number of discrete Intel Xeon Phi's per process (optional) 
os.environ['QF_AMDS_PER_PROCESS'] = "0"           #number of dsicrete AMD GPU's per process (optional)        

#OpenMP:
#os.environ['OMP_NUM_THREADS'] = os.getenv('QF_NUM_THREADS')  #initial number of OpenMP threads per MPI process           
