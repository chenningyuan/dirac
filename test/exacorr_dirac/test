#os.environ['MKL_NUM_THREADS=$OMP_NUM_THREADS                #number of Intel MKL threads per process
#os.environ['OFFLOAD_REPORT=2                                #Intel MIC offload reporting level

test.run(['exacc.inp'], ['H2O_nosym.mol'], f)

sys.exit(test.return_code)
