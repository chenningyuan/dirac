os.environ['OMP_MAX_ACTIVE_LEVELS'] = "3"         #max number of OpenMP nesting levels (at least 3)           
os.environ['OMP_THREAD_LIMIT'] = "256"            #max total number of OpenMP threads per process             
os.environ['OMP_DYNAMIC'] = "FALSE"               #no OpenMP dynamic threading                                
os.environ['OMP_NESTED'] = "TRUE"                 #OpenMP nested parallelism is mandatory                     
os.environ['OMP_WAIT_POLICY'] = "PASSIVE"         #idle thread behavior                                       
      
