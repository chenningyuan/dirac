#os.environ['MIC_KMP_PLACE_THREADS="64c,4t"                  #Intel MIC thread placement
#os.environ['MIC_KMP_AFFINITY="granularity=fine,compact"     #Intel MIC thread affinity
#os.environ['MIC_USE_2MB_BUFFERS=64K                         #Intel MIC only
