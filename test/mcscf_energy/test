#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(string = 'Final KR-MCSCF energy')

test_run.execute(['Be.inp'], ['Be.mol'], f)
test_run.execute(['Be.gascip.bss+mfsso.krmc.inp'], ['Be.gascip.mol'], f)

sys.exit(0)
