#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = ' Energy eigenvalues in atomic units',
      to_re       = 'Relative real eigenvalues in other units;',
# tolerance here is for differencees in absolute terms because for the complex
# cases relative changes could be very large for the complex part of the energy
# even though its magnitude is tiny (e.g. 5x10-9 vs 1x10-9)
      abs_tolerance = 1.0e-7)

# 1. tests with the standard options, that is,sorted unit vectors as initial trial vectors and, roots sorted by overlap to the trial vectors
# during the davidson procedure). 

test.run(['eom_ee_dc_noinv.inp'],   ['f2_d2.mol', 'f2_c2v.mol'], f, args='--mw=110')

# this tests is crashing for the u symmetries with ifort15, whereas it passes for gfortran 5.4, needs further checking
#test.run(['eom_ee_dc_inv.inp'],     ['f2_d2h.mol', 'f2_c2h.mol'], f, args='--mw=110')
# because of this, we test only the g symmetries for now
#test.run(['eom_ee_dc_inv_g.inp'],     ['f2_d2h.mol', 'f2_c2h.mol'], f, args='--mw=110')
test.run(['eom_ee_dc_inv_g.inp'],     ['f2_d2h.mol'], f, args='--mw=110')

# in the following runs we don't use the standard approach because of issues in trial vector generation 
#test.run(['eom_ee_dc_inv_ci.inp'],  ['f2_ci.mol'], f, args='--mw=110')
test.run(['eom_ee_dc_inv_ccs_nooverlap_ci.inp'],  ['f2_ci.mol'], f, args='--mw=110')

test.run(['eom_ee_dc_noinv_c1.inp'], ['f2_c1.mol'], f, args='--mw=110')

# these two tests come in last since there appears to be a issue with crash when printing
# the results that is not very reproducible, if the second irreps is asked for
f = Filter()
f.add(from_string = ' Energy eigenvalues in atomic units',
      to_re       = 'Relative real eigenvalues in other units;',
      abs_tolerance = 1.0e-8)
test.run(['eom_ee_dc_noinv_complex.inp'],   ['f2_cs.mol', 'f2_c2.mol'], f, args='--mw=110')

