#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'no-Lon temp.-indep. Jones biref',
      num_lines   = 2,
      tolerance   = 1.0e-7)
f.add(from_string = 'no-Lon temp.-dep. Jones biref',
      num_lines   = 2,
      tolerance   = 1.0e-7)
f.add(from_string = 'London temp.-indep. Jones biref',
      num_lines   = 2,
      tolerance   = 1.0e-7)
f.add(from_string = 'London temp.-dep. Jones biref',
      num_lines   = 2,
      tolerance   = 1.0e-7)

test_run.execute(['nr.inp', 'dc_skipep_cval=800.inp', 'dc_shifted.inp'], ['hf.mol'], f)

sys.exit(0)
