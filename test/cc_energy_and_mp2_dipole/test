#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-9)
f.add(from_string = 'Eigenvalues',
      to_re       = 'HOMO - LUMO',
      tolerance   = 1.0e-5)

test_run.execute(['sf.scf.inp'],     ['H2O.mol'], f, args='--outcmo                 ')

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-9)

test_run.execute(['so-ccsd.inp'],    ['H2O.mol'], f, args='--mw=64 --aw=130  --incmo')

f.add(from_string = ' Overview of calculated energies',
      to_string   = '@ Total CCSD-T  energy',
      tolerance   = 1.0e-7)
f.add(from_string = '* Dipole moment',
      to_string   = '1 a.u =   2.54177000 Debye',
      tolerance   = 1.0e-5)

test_run.execute(['ccsd.small.inp'], ['H2O.mol'], f, args='--mw=64 --aw=130         ')
test_run.execute(['ccsd.inp'],       ['H2O.mol'], f, args='--mw=64 --aw=130         ')

os.unlink('DFCOEF')

sys.exit(0)
