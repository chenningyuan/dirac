#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-9)
f.add(from_string = 'Eigenvalues',
      to_re       = 'HOMO - LUMO',
      tolerance   = 1.0e-5)

test_run.execute(['dhf.inp'], ['H2O.large+small.mol'], f)
test_run.execute(['dhf.inp'], ['H2O.usingfiles.mol'], f, args='--put="O.ccpvdz.bas H.ccpvdz.bas"')

sys.exit(0)
