#
# predefined restricted test sequences:
# note that the variable RUNTYPE (with values short, medium and long) is also used to 
# distinguish between different runs residing in one directory.
# The present definition is coarse grain and serves to
# exclude directories without a short run
#
# Some tests do not work in parallel (yet); the "*_partest" are the short, medum
# and long tests for parallel runs.
#


# short parallel
# ==============

this_testset=""
this_testset="$this_testset 1.energy+dipole"
this_testset="$this_testset 3.geomopt.dhf"
this_testset="$this_testset 4.levy-leblond.nmr"
this_testset="$this_testset 5.cisd.energy"
this_testset="$this_testset 6.cosci.energy"
this_testset="$this_testset 7.directmp2.energy"
this_testset="$this_testset 8.spinfree.cosci.energy"
this_testset="$this_testset basis_contraction"
this_testset="$this_testset basis_input"
this_testset="$this_testset 11.methods.cosci"
this_testset="$this_testset 13.hf_dynamic_polarizability"
this_testset="$this_testset 22.lucita_short"
this_testset="$this_testset 30.linear"
this_testset="$this_testset symmetry_recognition"
this_testset="$this_testset 37.bss.energies"
this_testset="$this_testset 38.london.magn_prop"
this_testset="$this_testset 39.gaunt"
this_testset="$this_testset dft_ac"
this_testset="$this_testset dft_response"
this_testset="$this_testset dft_response_symmetry"
this_testset="$this_testset dft_ao_eval"
this_testset="$this_testset dft_betasigma"
this_testset="$this_testset 47.fde.prop"
this_testset="$this_testset 49.xyzinput"
this_testset="$this_testset visual_elf"
this_testset="$this_testset visual_gamma5"

short_partest="$this_testset"


# short sequential
# ================

short_test="$short_partest fde_response_autodiff"


# medium parallel (including short)
# =================================

this_testset=""
this_testset="$this_testset 2.nmrspinspin"
this_testset="$this_testset 10.efg"
this_testset="$this_testset 12.zora"
this_testset="$this_testset symmetry_scf_energy"
this_testset="$this_testset 19.fockspace"
this_testset="$this_testset projection_analysis"
this_testset="$this_testset 33.frozen"
this_testset="$this_testset 34.rhonuc"
this_testset="$this_testset 36.mp2_properties"
this_testset="$this_testset 25.qrpa"
this_testset="$this_testset visual_general"
this_testset="$this_testset visual_div_rot"

medium_partest="$this_testset $short_partest"


# medium sequential (including short)
# ===================================

this_testset=""
#this_testset="$this_testset 27.krmc_luciarel"     currently blocked
#this_testset="$this_testset 28.luciarel_medium"   currently blocked
this_testset="$this_testset 54.stex"
this_testset="$this_testset 53.reladc"
this_testset="$this_testset fde_response_autodiff"

medium_test="$this_testset $medium_partest"


# long parallel (including short and medium)
# ==========================================

this_testset=""
#this_testset="$this_testset 26.krmc_gosci"   currently blocked
this_testset="$this_testset 41.pv_nmr"
this_testset="$this_testset 24.lucita_large"

long_partest="$this_testset $medium_partest"


# long sequential (including short and medium)
# ============================================

long_test="$this_testset $medium_test"


