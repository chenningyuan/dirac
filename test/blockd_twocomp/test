#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_re     = ' Energy eigenvalues in atomic units',
      to_string   = ' =====================')

test_run.execute(['bss_blockd.ci.inp'], ['F.mol'], f)

f = Filter()
f.add(from_string = 'Number of reference determinants',
      num_lines   = 2)
f.add(from_re     = 'CI Total Energy',
      to_re       = 'Relative to reference')
f.add(from_re     = '.*CI-SD Energy',
      to_re       = '.*CI-SD\+Q energy')

test_run.execute(['F.bss_blockd.cisd.inp'], ['F.1.mol'], f)

sys.exit(0)
