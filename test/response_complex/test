#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = ' Frequency (real)     Real part              Imaginary part         Convergence',
      num_lines   = 16,
      tolerance   = 1.0e-6)

test_run.execute(['cpp.inp'], ['LiH.mol'], f)

sys.exit(0)
