#!/usr/bin/env python

import os
import sys


sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f1 = Filter()
f1.add(from_string = 'Total energy',
      num_lines   = 1,
      rel_tolerance   = 1.0e-9)

f = Filter()
f.add(from_string = 'Final CCSD energy',
      num_lines   = 1,
      rel_tolerance   = 1.0e-9)
f.add(from_string = 'Energy of reference wave function (HF single determinant)',
      num_lines   = 1,
      rel_tolerance   = 1.0e-9)
f.add(from_string = 'Norm of OO part Fock matrix ',
      num_lines   = 1,
      abs_tolerance   = 1.0e-9)
f.add(from_string = 'Norm of OV part Fock matrix ',
      num_lines   = 1,
      abs_tolerance   = 1.0e-9)
f.add(from_string = 'Norm of VV part Fock matrix ',
      num_lines   = 1,
      abs_tolerance   = 1.0e-9)

if (os.getenv('DIRAC_MPI_COMMAND') is None) or (os.getenv('DIRAC_MPI_COMMAND')==''):
    os.environ['DIRAC_MPI_COMMAND'] = "mpiexec -n 4 "

os.system('ulimit -s unlimited')

test.run(['scf_h2o.inp'], ['H2O_nosym.mol'], f1,"--get='X2CMAT AOMOMAT DFCOEF'")

test.run(['cc_h2o.inp'], ['H2O_nosym.mol'], f, "--put='X2CMAT AOMOMAT DFCOEF' --env='OMP_NUM_THREADS=8' ")
test.run(['cc_h2o_core.inp'], ['H2O_nosym.mol'], f, "--put='X2CMAT AOMOMAT DFCOEF' --env='OMP_NUM_THREADS=8' ")

sys.exit(test.return_code)
