    def test_hdf5_rsp_general(fname):
        data_file = h5py.File(fname, 'r')
        n_ee  = data_file['/result/response/ndim_ee_total']
        n_ep  = data_file['/result/response/ndim_ep_total']
        n_fr  = data_file['/result/response/nfreq']
        n_B   = data_file['/result/response/nr_B_operators']
        n_r   = data_file['/result/response/nr_rsp_vectors']
        n_ree = data_file['/result/response/nr_rsp_vectors_ee']
        n_rep = data_file['/result/response/nr_rsp_vectors_ep']
        n_st  = data_file['/result/response/static']
        return (n_ee, n_ep, n_fr, n_B, n_r, n_ree, n_rep, n_st)
 
    def test_hdf5_rspvec_general(fname, rspvec):
        data_file = h5py.File(fname, 'r')
        try:
            nxeq  = data_file['/result/response/vectors/'+rspvec+'/nzxopeq']
            nxpq  = data_file['/result/response/vectors/'+rspvec+'/nzxoppq']
            lab   = data_file['/result/response/vectors/'+rspvec+'/lab']
        except:
            sys.stdout.write(rspvec+' not found in '+fname)
            sys.exit(1)
        return (lab, nxeq, nxpq)
 
    def test_hdf5_rspvec_arrays(fname, rspvec):
        data_file = h5py.File(fname, 'r')
        try:
            orbital_rotation_indices = data_file['/result/response/vectors/'+rspvec+'/orbital_rotation_indices']
        except:
            sys.stdout.write(rspvec+' not found in '+fname)
            sys.exit(1)
        return orbital_rotation_indices

    def close_values(this_value, ref_value, rtol=None, atol=None):
      if atol is None:
          #atol = 0.05*ref_value 
          atol = 1.0e-20
      if rtol is None:
          #rtol = 0.05
          rtol = 1.0e-6
      is_close = abs(this_value-ref_value) <= max(rtol * max(abs(this_value), abs(ref_value)), atol)
      return is_close
 
    def compare_with_ref(ftest, fref, typ, rspvec=None, rspvec_test_key=None):

        if typ == 'rsp':
            test = test_hdf5_rsp_general(ftest)
            ref  = test_hdf5_rsp_general(fref)
            res = tuple(i == j for i, j in zip(test, ref))
            if False in res:
                sys.stdout.write('Error! Different data on hdf5')

        if typ == 'rspvec':
            test = test_hdf5_rspvec_general(ftest,rspvec)
            ref  = test_hdf5_rspvec_general(fref,rspvec)
            res = tuple(i == j for i, j in zip(test, ref))
            if False in res:
                sys.stdout.write('Error! Different data on hdf5')

        elif typ == 'rspvec_arrays':
            test = test_hdf5_rspvec_arrays(ftest,rspvec)
            ref  = test_hdf5_rspvec_arrays(fref,rspvec)
            res = tuple(close_values(i, j) for i, j in zip(test, ref))
            if False in res:
                sys.stdout.write('Error! Different array data on hdf5')


    testset = ['RESPONSE_dc']

    for t in testset:
        compare_with_ref(ftest=t+'.h5', fref='result/'+t+'.h5', typ='rsp')
        for i in range(1,7):
            compare_with_ref(ftest=t+'.h5', fref='result/'+t+'.h5', typ='rspvec', rspvec='vec_'+str(i))
            compare_with_ref(ftest=t+'.h5', fref='result/'+t+'.h5', typ='rspvec_arrays', rspvec='vec_'+str(i))

    testset = ['RESPONSE_ll']

    for t in testset:
        compare_with_ref(ftest=t+'.h5', fref='result/'+t+'.h5', typ='rsp')
        for i in range(1,4):
            compare_with_ref(ftest=t+'.h5', fref='result/'+t+'.h5', typ='rspvec', rspvec='vec_'+str(i))
            compare_with_ref(ftest=t+'.h5', fref='result/'+t+'.h5', typ='rspvec_arrays', rspvec='vec_'+str(i))


