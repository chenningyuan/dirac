#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Total energy',
      nr_lines    = 1,
      tolerance   = 1.0e-7)

test_run.execute(['export.inp'], ['hehe.mol'],    args='--get numerical_grid')
test_run.execute(['import.inp'], ['hegh.mol'], f, args='--put numerical_grid')

os.unlink('numerical_grid')

sys.exit(0)
