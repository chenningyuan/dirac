#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest import Filter
from runtest_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Final geometry (bohr)',
      num_lines   = 5,
      tolerance   = 1.0e-8)
f.add(string      = 'Energy at final geometry is',
      tolerance   = 1.0e-9)

test_run.execute(['lda_numgra.inp', 'lda_numgra_x2c.inp'], ['h2.mol'], f)
test_run.execute(['lda.inp'], ['h2o.mol'], f)

sys.exit(0)
