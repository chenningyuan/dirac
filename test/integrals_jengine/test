#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from beholder import Filter
from beholder_dirac import DiracTestRun

test_run = DiracTestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-10)

test_run.execute(['NR_direct_Jengine+LinK.inp', 'NR_direct_Jengine+LinK_LDA.inp',
                  '2C_SF_direct_Jengine+LinK.inp', '2C_SF_direct_Jengine+LinK_LDA.inp'], ['H2O2.mol'], f)

sys.exit(0)
