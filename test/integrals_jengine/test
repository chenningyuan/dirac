#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = 'Electronic energy',
      num_lines   = 8,
      tolerance   = 1.0e-10)

test.run(['NR_direct_Jengine+LinK.inp', 'NR_direct_Jengine+LinK_LDA.inp',
                  '2C_SF_direct_Jengine+LinK.inp', '2C_SF_direct_Jengine+LinK_LDA.inp'], ['H2O2.mol'], f)

sys.exit(test.return_code)
