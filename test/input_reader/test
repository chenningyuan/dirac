#!/usr/bin/env python

import os
import sys

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))
from runtest_dirac import Filter, TestRun

test = TestRun(__file__, sys.argv)

f = Filter()
f.add(from_string = ' **RELCC: Set-up for Coupled Cluster calculations',
      num_lines   = 4,
      rel_tolerance   = 1.0e-9)

test.run(['AsCl+.x2c.2pi_aver_scf_anal_1fs_39e_relcc_mj_TESTINP.inp'], ['AsCl.v2z.linsym.mol'], f)

sys.exit(test.return_code)
