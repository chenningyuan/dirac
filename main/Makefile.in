include ../../Makefile.config

DIRACMALLOC_SRC  = diracmalloc.c
DIRACMALLOC_OBJS = diracmalloc.o

ALLOC_MEM_SRC  = alloc_mem.c
ALLOC_MEM_OBJS = alloc_mem.o

GET_MEMSIZE_SRC  = get_memsize.c
GET_MEMSIZE_OBJS = get_memsize.o

PRINT_LOGO_SRC   = print_logo.c
PRINT_LOGO_OBJS  = print_logo.o

INI_MPI_SRC      = ini_mpi.c
INI_MPI_OBJS     = ini_mpi.o

END_MPI_SRC      = end_mpi.c
END_MPI_OBJS     = end_mpi.o

CSECTID_SRC      = csectid.c
CSECTID_OBJS     = csectid.o

DIRAC_MAIN_SRC   = main.c
DIRAC_MAIN_OBJS  = main.o

EXEC_DIRAC_SRC   = exec_dirac.c
EXEC_DIRAC_OBJS  = exec_dirac.o

MPI_ERRTRAP_SRC  = mpi_errtrap.c
MPI_ERRTRAP_OBJS = mpi_errtrap.o

PR_TIMING_SRC    = pr_timing.c
PR_TIMING_OBJS   = pr_timing.o

DIRAC_SRC        = dirac.F
DIRAC_OBJS       = dirac.o

MAIN_OBJS        = $(DIRACMALLOC_OBJS) $(ALLOC_MEM_OBJS)  $(GET_MEMSIZE_OBJS) \
                   $(DIRAC_MAIN_OBJS)  $(PRINT_LOGO_OBJS) $(DIRAC_OBJS) \
                   $(INI_MPI_OBJS)     $(END_MPI_OBJS)    $(CSECTID_OBJS) \
                   $(EXEC_DIRAC_OBJS)  $(PR_TIMING_OBJS)  $(MPI_ERRTRAP_OBJS)

MAIN_SRC         = $(DIRACMALLOC_SRC) $(ALLOC_MEM_SRC)  $(GET_MEMSIZE_SRC) \
                   $(DIRAC_MAIN_SRC)  $(PRINT_LOGO_SRC) $(DIRAC_SRC) \
                   $(INI_MPI_SRC)     $(END_MPI_SRC)    $(CSECTID_SRC) \
                   $(EXEC_DIRAC_SRC)  $(PR_TIMING_SRC)  $(MPI_ERRTRAP_SRC)

all:	$(MAIN_OBJS)

depend:
	makedepend -- $(INCLUDE_DIR) $(CCP_FLAGS) -- $(MAIN_SRC)

clean:
	$(RM) -f *.o *~ *.f *.lst *.i

# DO NOT DELETE
