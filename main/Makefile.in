include ../Makefile.config

C_OBJS = 

F77_OBJS = dirac.o

F90_OBJS = main.o mpi_framework.o

F90_MODS = 

F77_CPPS = $(F77_OBJS:.o=.i)

pre: $(F77_CPPS)

ftnchek: pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F77_OBJS) $(F90_OBJS) $(C_OBJS)

clean:
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i

mod: $(F90_MODS)

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirac.x:
	cd .. ; $(MAKE) dirac.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90) $(C_OBJS:.o=.c)

f90dep: ;\
       ../utils/sfmakedepend.pl -I $(SOURCEDIR)/include -M $(SOURCEDIR)/modules $(F90_OBJS:.o=.F90) $(F90_OBJS:.o=.F) $(F77_OBJS:.o=.F)
 
# DO NOT DELETE THIS LINE -- make depend depends on it.

