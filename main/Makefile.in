include ../Makefile.config

C_OBJS = diracmalloc.o alloc_mem.o get_memsize.o print_logo.o ini_mpi.o\
         end_mpi.o csectid.o main.o exec_dirac.o mpi_errtrap.o pr_timing.o\
         get_time.o 

F77_OBJS = dirac.o

F90_OBJS = 

F77_CPPS = $(F77_OBJS:.o=.i)

pre: $(F77_CPPS)

ftnchek: pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F77_OBJS) $(F90_OBJS) $(C_OBJS)

clean:
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirac.x:
	cd .. ; $(MAKE) dirac.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90) $(C_OBJS:.o=.c)
# DO NOT DELETE THIS LINE -- make depend depends on it.

