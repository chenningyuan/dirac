
include ../Makefile.config

OBJS = pamdft.o dftden.o dftdrv.o dftfun.o dftgrd.o dftaux.o \
	functionals.o fun-slater.o fun-becke.o fun-vwn.o fun-lyp.o \
	fun-pw86x.o fun-p86c.o

all:	$(OBJS) 

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(OBJS:.o=.F)
# DO NOT DELETE THIS LINE -- make depend depends on it.

