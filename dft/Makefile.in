
include ../Makefile.config

F_OBJS = pamdft.o dftden.o dftdrv.o dftfun.o dftgrd.o dftaux.o grtest.o \
	Lebedev-Laikov.o

C_OBJS = functionals.o fun-slater.o fun-becke.o fun-vwn.o fun-lyp.o \
	fun-pw86x.o fun-p86c.o

F_CPPS = $(F_OBJS:.o=.i)

pre:	$(F_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F_CPPS) > ftnchek.out

all:	$(F_OBJS) $(C_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F_OBJS:.o=.F) $(C_OBJS:.o=.c)
# DO NOT DELETE THIS LINE -- make depend depends on it.

