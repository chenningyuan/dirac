include ../Makefile.config

F77_OBJS = pamdft.o \
           dftdrv.o \
           dftfun.o \
           dftgrd.o \
           dftaux.o \
           grtest.o \
           Lebedev-Laikov.o \
           dftac.o

F90_OBJS =

F90_MODS =

C_OBJS = general.o \
           functionals.o \
           emb-functional.o \
           fun-kin_tf.o \
           fun-kin_vw.o \
           fun-cam-b3lyp.o \
           fun-becke.o \
           fun-gga.o \
           fun-kt.o \
           fun-lb94.o \
           fun-lbalpha.o \
           fun-gllb_hole.o \
           fun-lyp.o \
           fun-optx.o \
           fun-p86c.o \
           fun-pbec.o \
           fun-pbex.o \
           fun-pw86x.o \
           fun-pw91c.o \
           fun-pw91x.o \
           fun-pz81.o \
           fun-slater.o \
           fun-vwn.o

F77_CPPS = $(F77_OBJS:.o=.i)

pre:       $(F77_CPPS)

ftnchek:   pre
	   ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:       $(F90_MODS) $(F90_OBJS) $(F77_OBJS) $(C_OBJS)

clean:
	   $(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod  ;\
	   $(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

mod:       $(F90_MODS)

dirac.x:
	   cd .. ; $(MAKE) dirac.x

dirmpi.x:
	   cd .. ; $(MAKE) dirmpi.x

include ../Makefile.depend

