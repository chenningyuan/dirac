
include ../Makefile.config

F77_OBJS = pamdft.o dftdrv.o dftfun.o dftgrd.o dftaux.o grtest.o \
	Lebedev-Laikov.o dftac.o

F90_OBJS =

C_OBJS = general.o	\
	functionals.o	\
	emb-functional.o \
	fun-kin_tf.o fun-kin_vw.o\
	fun-cam-b3lyp.o	\
	fun-becke.o	\
	fun-gga.o	\
	fun-kt.o	\
	fun-lb94.o	\
	fun-lbalpha.o	\
	fun-gllb_hole.o	\
	fun-lyp.o	\
	fun-optx.o	\
	fun-p86c.o	\
	fun-pbec.o	\
	fun-pbex.o	\
	fun-pw86x.o	\
	fun-pw91c.o	\
	fun-pw91x.o	\
	fun-pz81.o	\
	fun-slater.o	\
	fun-vwn.o

F77_CPPS = $(F77_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F77_OBJS) $(F90_OBJS) $(C_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

fun-tester: fun-tester.c fun-slater.c fun-vwn.c fun-becke.c fun-lyp.c functionals.c fun-lb94.c \
	fun-lbalpha.c emb-functional.c fun-p86c.c fun-pw86x.c fun-kin_tf.c fun-kin_vw.c
	$(CC) -g -O -I../include -DNO_BACKWARD_COMP $^ -o $@  -lm

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90) $(C_OBJS:.o=.c)

# DO NOT DELETE THIS LINE -- make depend depends on it.

