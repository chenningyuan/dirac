#! /usr/bin/env python

import os
import sys
import string
import subprocess
import time
import signal
from optparse import OptionParser, OptionGroup

max_error = 1.0e-10

if sys.version < '2.4':
    print 'runtest requires python version >= 2.4'
    sys.exit(1)

root_directory = os.path.realpath(__file__)[:-8]
current_directory = os.path.realpath('.')

# define example usage

usage = '''
  typically ./%prog --all
         or ./%prog --test=foo'''

# initialize parser

parser = OptionParser(usage)

# define options

group = OptionGroup(parser, 'Select the test set')
group.add_option('--all',
                 action='store_true',
                 dest='all',
                 default=False,
                 help='run all tests [default: %default]')
group.add_option('--test',
                 type='string',
                 action='store',
                 dest='individual',
                 default=None,
                 help='select individual test',
                 metavar='\"foo\"')
parser.add_option_group(group)

# process input

(options, args) = parser.parse_args()

if len(sys.argv) == 1:
    # user has given no arguments and we are not in a test subdir: print help and exit
    print parser.format_help().strip()
    sys.exit()

if options.all:
    sys.exit('--all not implemented')

# main function
def main(*args):

    test_directory = root_directory + '/test/' + options.individual
    log_file = '%s/log' % test_directory
    
    command = 'cd %s; ../../build/dft.x 1> %s 2> /dev/null' % (test_directory, log_file)
    p = subprocess.Popen(command,
                         shell=True,
                         stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE)
    print p.communicate()[0]
    
    f = open(log_file, 'r')

    exit_code = 0
    for line in f.readlines():
        if 'compare matrices' in line:
           if float(line.split()[-1]) > max_error:
               exit_code += 1
    f.close()
    return exit_code

# launch the main function
if __name__ == '__main__':
    sys.exit(main(*sys.argv))
