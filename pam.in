#
# Shell Script for running Dirac
#
# VERSION : $Revision$
# DATE    : $Date$
# FILE    : pam.in
#
# -- To activate special code for NEC SX systems (in vi): %s/#SX/   /
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# Does 'echo' understand backslash commands
#
if [ "	" != "`echo '\t'`" ]; then
   echo='echo -e'
fi
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Function usage
#    - prints usage to stdout
#
#
usage ()
{
   echo 'Usage: '$0' [flags] mol[.mol] menu[.inp]'
   echo '   Flags:'
   echo '     -copy "file1 file2 .." : Copy files to work area'
   echo '     -debug                 : Run dirac in debugger "'$DEBUGGER'"'
   echo '     -get "file1 file2 .."  : Get files from work area'
   echo '     -incmo                 : Copy DFCOEF to   work area'
   echo '     -utcmo                 : Save DFCOEF from work area'
   echo '     -infck                 : Copy DFFCK2 to   work area'
   echo '     -utfck                 : Save DFFCK2 from work area'
   echo '     -inxvc                 : Copy PAMXV1 to   work area'
   echo '     -utxvc                 : Save PAMXV1 from work area'
   echo '     -mw mem                : Set memory (in megawords) for master'
   echo '     -nw mem                : Set memory (in megawords) for the nodes'
   echo '     -rmscr                 : Remove work area before calculation'
   echo '     -rmwrk                 : Remove work area after calculation'
   echo '     -run name              : File suffix for output; default "'$RUN'"'
   echo '     -scr name              : Directory root for work area; default "'$SCR/$MOL'"'
   echo '     -mpi n                 : Run MPI with n nodes; default sequential'
   echo '     -nice                  : execute Dirac with nice/npri'
   echo '     -notify                : Notify when finished to user starting job'
   echo '     -user e-mail           : Notify when finished using specified e-mail address'
   echo '     -basdir directory      : Prepend basis set directory to search list (may be repeated)'
   echo '     -dirac dirac_cmd       : Use dirac_cmd as executable instead of the default dirac.x'
   echo '                              (path must be included if executable is not in input directory)'
   echo '     -help                  : More help on pam than this'
# only for SYS_SX (NEC SX systems)
#SXecho '     -multi "config file"   : [SX only] Run MPI on MULTI NODEs'
#SXecho '                              and configuration file'
#SXecho '     -mpiconf "mpi.conf"    : [SX only] Change MPI config file name'
#SXecho '     -thread                : [SX only] Run thread parallel execution'
# end only for SYS_SX
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Notify user
#
#
notify_user()
{
   if [ -n "$NOTIFY_USER" ]; then
      TO=$NOTIFY_USER
   else
      if [ -n "$USER" ]; then
         TO="$USER@`hostname`"
      else
         TO="$LOGNAME@`hostname`"
      fi
   fi
   mail $TO <<EOF
   cat <<EOF

Your job has has returned with exit status: $EXIT

Command      : $0 $ARG_SAVE
Hostname     : `hostname`
Input dir    : $LOC
Menu file    : $MENU
Molecule file: $MOL
Output file  : $OUTPUT_FILE

EOF
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SET UP COMMAND TO RUN
#
#
setup_command()
{
   #
   # Execute Dirac "nicely"?
   #
   if [ -n "$NICE" ]; then
      if [ -x /usr/sbin/npri ]; then
         NICE_CMD="npri -h129"
      else
         NICE_CMD="nice -20"
      fi
   else
      NICE_CMD=
   fi
   #
   # Dirac executable
   #
   if [ -n "$ALT_DIRAC" ]; then
      DIRAC=${ALT_DIRAC##*/}
      BIN_DIR=${ALT_DIRAC%/*}
      if [ -z "$BIN_DIR" ]; then
         BIN_DIR=$LOC
      fi
   else
      DIRAC=dirac.x
   fi
   #
   # MPI?
   #
   if [ -n "$PARCAL" ]; then
#SX   if [ -n "$MULTI_NODE" ]; then
#SX      DIRAC_CMD="mpisx -p $MPI_NPROC -e $DIRAC"
#SX   else
         DIRAC_CMD="$MPIRUN -np $MPI_NPROC -machinefile machines $DIRAC"
#SX   fi
   else
      DIRAC_CMD="./$DIRAC"
   fi
   #
   # Debug
   #
   if [ -n "$DEBUG" ]; then
      if [ "$DEBUGGER" = "gdb" ]; then
        DIRAC_CMD="gdb -directory=$SRC_DIR/dirac -directory=$SRC_DIR/abacus  -directory=$SRC_DIR/prp "
        DIRAC_CMD="$DIRAC_CMD -directory=$SRC_DIR/main "
        DIRAC_CMD="$DIRAC_CMD -directory=$SRC_DIR/moltra -directory=$SRC_DIR/relccsd "
        DIRAC_CMD="$DIRAC_CMD -directory=$SRC_DIR/prp/esr -directory=$SRC_DIR/prp/xpp "
        DIRAC_CMD="$DIRAC_CMD -directory=$SRC_DIR/prp/xqr -directory=$SRC_DIR/relccsd/ccfocksp "
        DIRAC_CMD="$DIRAC_CMD -directory=$SRC_DIR/pdpack -directory=$SRC_DIR/gp"
        DIRAC_CMD="$DIRAC_CMD -directory=$SRC_DIR/include $DIRAC"
      else
        DIRAC_CMD="$DEBUGGER -I $SRC_DIR/dirac -I $SRC_DIR/abacus  -I $SRC_DIR/prp "
        DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/main "
        DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/moltra -I $SRC_DIR/relccsd "
        DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/prp/esr -I $SRC_DIR/prp/xpp "
        DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/prp/xqr -I $SRC_DIR/relccsd/ccfocksp "
        DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/pdpack -I $SRC_DIR/gp"
        DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/include $DIRAC"
      fi
   fi

   $echo "   Copying $BIN_DIR/$DIRAC to working directory : \c"

   #
   # Delete $WRK/$DIRAC if the executable is older than the
   # executable in $BIN_DIR. This is useful when you've compiled
   # a new executable, but didn't delete your scratch directory
   # in the previous calculation.
   #

   if [ -f $WRK/$DIRAC ]; then
      if [ $WRK/$DIRAC -ot $BIN_DIR/$DIRAC ]; then
         echo "Old $WKR/$DIRAC deleted because it is older than $BIN_DIR/$DIRAC"
         rm $WRK/$DIRAC
      fi
   fi

   if [ ! -f $WRK/$DIRAC ]; then
      if [ -x $BIN_DIR/$DIRAC ]; then
         cp $BIN_DIR/$DIRAC . || \
            ( \
               echo "   Error copying $BIN_DIR/$DIRAC" ; \
               EXIT=1 ;\
               exitfunc \
            )
         echo "ok"
      else
         echo "not found"
         EXIT=1
         exitfunc
      fi
   else
      echo "was already there"
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# EXECUTE DIRAC
#
#
execute_dirac()
{

#SXif [ -n "$MULTI_NODE" ]; then
#SX   PWD=`pwd`
#SX   export PWD
#SXfi

   echo "   Executing: $NICE_CMD $DIRAC_CMD"
   if [ -n "$DEBUG"  ]; then
      $NICE_CMD $DIRAC_CMD | tee $OUTPUT_FILE
   else
      $NICE_CMD $DIRAC_CMD > $OUTPUT_FILE || \
         ( \
            echo "   $DIRAC returned non-zero exit code" ; \
            EXIT=1 ; export EXIT \
         )
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Print header
#
#
print_header()
{
   echo "   ****************************************"
   echo "   **** OUTPUT FROM DIRAC SHELL SCRIPT ****"
   echo "   ****************************************"
   echo
   echo '   $Revision$'
   echo "   Host        : `hostname`"
   echo "   Date        : `date`"
   echo "   PID         : $$"
   echo "   Input dir   : `pwd`"
   echo "   Work dir    : $WRK"
   echo
   echo
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Exit
#
#
exitfunc()
{
   if [ $EXIT -eq 0 ]; then
      echo
      echo "   Exit date: `date`"
      echo "   *** NORMAL EXIT"
   else
      echo
      echo "   Exit date: `date`"
      echo "   *** ABNORMAL EXIT"
   fi
   if [ -n "$NOTIFY" ]; then
      notify_user
   fi
   exit $EXIT
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# REMOVE WORK DIRECTORY
#
#
remove_work_dir()
{
#
#  We alays delete the work directories on remote machines.
#  These directories are not suited for restart.
#
   master=`hostname`
   for node in ` cat $WRK/machines `; do
       if [ $node != $master ]; then
          rsh $node "rm -fr $WRK"
       fi
   done
#
#  Now delete work directory on primary machine if requested
#
   if [ -n "$RMWRK" ]; then
      if [ $EXIT -eq 0 ]; then
         cd ..
         rm -fr $WRK
      else
         echo '*** DIRAC terminated with an error exit code'
         echo "- THEREFORE scratch directory $WRK is not deleted as requested with -rmwrk"
         echo "  so you may restart the calculation, or debug, if possible"
         echo "  ( $WRK may be deleted by your queueing system )"
         echo "- REMEMBER to delete $WRK yourself !!!"; echo
      fi
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SET WORKING DIRECTORY
#
#
set_work_dir()
{
   if [ -n "$SCR_DIR" ]; then
      WRK=$SCR_DIR
   else
      WRK=$SCR/$MOL.$$
   fi
   #
   # Make $WRK if non-existing
   # The -p switch makes all parent directories first
   #
   mkdir -p $WRK || echo "   MKDIR error\!"
   if [ ! -d $WRK ]; then
      echo "   Could not create work directory: $WRK"
      EXIT=1
      exitfunc
   fi
   #
   # Remove contents of $WRK if requested ( RMSCR )
   #
   if [ -n "$RMSCR" ]; then
      rm -f $WRK/* 2> /dev/null || echo "RM error\!"
   fi
}
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# COPY CONTENTS OF WORKING DIRECTORY TO REMOTE NODES 
#
#
distribute_work_dir()
{
   cd $WRK
#
#  The list of machines depends on the queuing system that is used.
#
   if [ ! -z "$PBS_NODEFILE" ]; then
#     PBS queueing system
      cp $PBS_NODEFILE machines
   else
#    Serial run or shared disk systems
     echo `hostname` > machines 
   fi
#
#  Initialize value of master
#
   master=`hostname` 
#
#  Loop over the remote machines and copy the contents of the work directory.
#
   for node in ` cat machines `; do
       if [ $node != $master ]; then
          echo "copying contents of $master:$WRK to $node:$WRK"
          rsh $node "mkdir -p $WRK"
          if [ -n "$RMSCR" ]; then
             rsh $node rm -f $WRK/*
          fi
          for file in ` ls `; do
              rcp $file $node:$WRK/$file
          done
       fi
   done
   #
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SAVE REQUESTED FILES
#
#
save_files()
{
   #
   # GET REQUESTED FILES FROM WORKING DIRECTORY
   #
   if [ -n "$GET_FILES" ]; then
      for file in $GET_FILES; do
         $echo "   Saving $WRK/$file : \c"
         if [ -a $WRK/$file ]; then
            cp $WRK/$file $LOC || $echo "not \c"
            echo "ok"
         else
            echo "not found"
         fi
      done
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# COPY FILES TO WORKING DIRECTORY
#
#
copy_files()
{
   #
   # COPY MOLECULE AND MENU FILE
   #
   cd $WRK
   $echo "   Copying $LOC/$MOL.mol to working directory : \c"
#   if [ -a $LOC/$MOL.mol ]; then
   if [ -f $LOC/$MOL.mol ]; then
      cp $LOC/$MOL.mol MOLECULE.INP || \
         ( \
            echo "   Error copying $LOC/$MOL.mol" ; \
            EXIT=1 ; \
            exitfunc \
         )
      echo "ok"
   else
      echo "not found"
      EXIT=1
      exitfunc
   fi
   $echo "   Copying $LOC/$MENU.inp to working directory : \c"
#   if [ -a $LOC/$MENU.inp ]; then
   if [ -f $LOC/$MENU.inp ]; then
      cp $LOC/$MENU.inp DIRAC.INP || \
         ( \
            echo "   Error copying $LOC/$MENU.inp" ; \
            EXIT=1 ; \
            exitfunc \
         )
      echo "ok"
   else
      echo "not found"
      EXIT=1
      exitfunc
   fi
   #
   # COPY REQUESTED FILES TO WORKING DIRECTORY
   #
   if [ -n "$COPY_FILES" ]; then
      for file in $COPY_FILES; do
         $echo "   Copying $LOC/$file to working directory : \c"
         if [ -a $LOC/$file ]; then
            cp $LOC/$file . || \
               ( \
                  echo "   Error copying $LOC/$file" ; \
                  EXIT=1 ; \
                  exitfunc \
               )
            echo "ok"
         else
            echo "not found"
         fi
      done
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SAVE OLD OUTPUT FILE
#
#
save_old_output()
{
   if [ "$MOL" = "$MENU" ]; then
      OUTPUT_FILE=${LOC}/${MOL}.${RUN}
   else
      OUTPUT_FILE=${LOC}/${MENU}_${MOL}.${RUN}
   fi
   #
   # Save old output file
   #
#   if [ -a $OUTPUT_FILE ]; then
   if [ -f $OUTPUT_FILE ]; then
      $echo "   Existing file ${OUTPUT_FILE##*/} renamed to ${OUTPUT_FILE##*/}.bak : \c"
      mv $OUTPUT_FILE $OUTPUT_FILE.bak || \
         ( \
            echo "   Error renaming $OUTPUT_FILE" ; \
            EXIT=1 ; \
            exitfunc \
         )
      echo "ok"
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SET WORKING MEMORY FOR MASTER AND NODE
#
#
set_work_memory()
{
   if [ -n "$PARCAL" ]; then
      DIRPAR=1
      export DIRPAR
   fi
   if [ -n "$MEMORY" ]; then
      DIRWRK=$MEMORY
      export DIRWRK
   fi
   if [ -n "$NODE_MEMORY" ]; then
      DIRNOD=$NODE_MEMORY
      export DIRNOD
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# MAKE MPI CONFIGURATION FILE
# for NEC SX systems
#
#
make_mpi_config()
{
    echo
#SX if [ -n "$MULTI_NODE" ]; then
#SXecho " Create configuration file for MPI on MULTI NODEs"
#SXif [ ! -f $MULTI_CONF ]; then
#SX   if [ ! -f $SRC_DIR/$MULTI_CONF ]; then
#SX      if [ ! -f $BIN_DIR/$MULTI_CONF ]; then
#SX         echo "$MULTI_CONF not found"
#SX      else
#SX         MULTI_CONF=$BIN_DIR/$MULTI_CONF
#SX      fi
#SX   else
#SX      MULTI_CONF=$SRC_DIR/$MULTI_CONF
#SX   fi
#SXfi
#SX
#SX. $LOC/makempiconf $MPI_CONF_NAME < $MULTI_CONF
#SX fi
}
#
#  Set working directory, set work memory, print header
#  copy files to working directory, save existing output file,
#  setup command to run, execute dirac, save files, and delete
#  working directory
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Set default values
#
#
initialize()
{
   LOC=`pwd`

   EXIT=0

   RMWRK=
   RMSCR=

   COPY_FILES=

   DEBUG=

   GET_FILES=

   MEMORY=
   NODE_MEMORY=

   RUN='out'

#SXMULTI_CONF=
#SXMULTI_NODE=
#SXMPI_CONF_NAME=

   if [ "$LOGNAME" = "" ]; then
      SCR=$SCR_DEFAULT/$USER
   else
      SCR=$SCR_DEFAULT/$LOGNAME
   fi

   SCR_DIR=

   if [ ! -z "$MPI_NPROC" ]; then
      PARCAL=1
   else
      MPI_NPROC=
      PARCAL=
   fi

   NICE=

   NOTIFY=
   NOTIFY_USER=

   ALT_DIRAC=

#  set default search path for basis sets:
#  1) job directory
#  2) basis set directory in Dirac distribution

   BASDIR="$LOC/:$SRC_DIR/basis/"; export BASDIR
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Parse arguments
#
#
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
initialize
ARG_SAVE="$*"
if [ -z "$1" ]; then
   usage
   exitfunc
fi

while [ -n "$1" ]; do
   case $1 in
      -basdir)
         shift
         BASDIR="$1:${BASDIR}"; export BASDIR
         ;;
      -copy)
         shift
         COPY_FILES="$COPY_FILES $1"
         ;;
      -debug)
         DEBUG=1
         ;;
      -get)
         shift
         GET_FILES="$GET_FILES $1"
         ;;
      -infck)
         COPY_FILES="$COPY_FILES DFFCK2"
         ;;
      -utfck)
         GET_FILES="$GET_FILES DFFCK2"
         ;;
      -incmo)
         COPY_FILES="$COPY_FILES DFCOEF"
         ;;
      -utcmo)
         GET_FILES="$GET_FILES DFCOEF"
         ;;
      -mw|-memory)
         shift
         let MEMORY=$1*1000000
         ;;
      -nw|-nodememory)
         shift
         let NODE_MEMORY=$1*1000000
         ;;
      -rmscr)
         RMSCR=1
         ;;
      -rmwrk)
         RMWRK=1
         ;;
      -run)
         shift
         RUN=$1
         ;;
      -scr|-scratch)
         shift
         SCR_DIR=$1
         ;;
      -mpi)
         shift
# LV : Be ware that the old default was to run also a slave on the master machine
# This is fine for a master-slave HF/RPA algorithm but not for
# parallel I/O intensive procedures (MOLTRA) and the symmetrically 
# parallelized RELCCSD. I therefore changed the default to a lonely master.
#
#        Old default : master + one slave on node
#        let MPI_NPROC=$1+1
#        New default : master by itself on a node
         let MPI_NPROC=$1+1
         MPI_NPROC=$1
         PARCAL=1
         ;;
      -nice)
         NICE=1
         ;;
      -notify)
         NOTIFY=1
         ;;
      -user)
         NOTIFY=1
         shift
         NOTIFY_USER=$1
         ;;
      -dirac)
         shift
         ALT_DIRAC=$1
         ;;
      -t)
         shift
         ;;
      -q)
         shift
         ;;
      -help)
         if [ -z "$PAGER" ]; then
            PAGER=more
         fi
         nroff -man $SRC_DIR/pam.1 | $PAGER
         EXIT=0
         exitfunc
         ;;
# only for SYS_SX (NEC SX systems)
#SX   -multi)
#SX      MULTI_NODE=1
#SX      shift
#SX      MULTI_CONF=$1
#SX      PARCAL=1
#SX      ;;
#SX   -mpiconf)
#SX      shift
#SX      MPI_CONF_NAME=$1
#SX      ;;
#SX   -thread)
#SX      export MULTITASKMIX=ON
#SX      ;;
# end only for SYS_SX
      -*)
         echo "$1 not recognized"
         usage
         EXIT=2
         exitfunc
         ;;
      *)
         MOL=${1%\.mol}
         shift 
         if [ -z "$1" ]; then
            echo "No menu file given"
            EXIT=1
            exitfunc
         fi
         MENU=${1%\.inp}
         ;;
   esac
   shift
done
#
EXIT=0
set_work_dir
set_work_memory
print_header
copy_files
save_old_output
setup_command
distribute_work_dir
make_mpi_config
execute_dirac
save_files
remove_work_dir
#
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Exit 
#
#
exitfunc
