#
# Shell Script for running Dirac
#
# VERSION : $Revision$
# DATE    : $Date$
# FILE    : pam.in
# SOURCE  : $Source$
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Function usage
#    - prints usage to stdout
#
#
usage ()
{
   echo 'Usage: '$0' [flags] mol[.mol] menu[.inp]'
   echo '   Flags:'
   echo '     -copy "file1 file2 .." : Copy files to work area'
   echo '     -debug                 : Run dirac in debugger'
   echo '     -get "file1 file2 .."  : Get files from work area'
   echo '     -incmo                 : Copy DFCOEF to   work area'
   echo '     -utcmo                 : Save DFCOEF from work area'
   echo '     -infck                 : Copy DFFCK2 to   work area'
   echo '     -utfck                 : Save DFFCK2 from work area'
   echo '     -inxvc                 : Copy PAMXV1 to   work area'
   echo '     -utxvc                 : Save PAMXV1 from work area'
   echo '     -mw mem                : Set memory(in megawords) for master '
   echo '     -nw mem                : Set memory(in megawords) for the nodes '
   echo '     -rmscr                 : Remove work area before calculation'
   echo '     -rmwrk                 : Remove work area after calculation'
   echo '     -run name              : File suffix for output    '
   echo '     -scr name              : Directory name for scratch  '
   echo '     -mpi n                 : Run MPI with n nodes'
   echo '     -nonice                : Do not execute with nice'
   echo '     -notify                : Notify user'
   echo '     -user                  : Which user to notify'
   echo '     -dirac dirac_cmd       : Use dirac_cmd instead for default'
   echo '                              dirac'
   echo '     -help                  : Help on pam'
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Notify user
#
#
notify_user()
{
   if [ -n "$NOTIFY_USER" ]; then
      TO=$NOTIFY_USER
   else
      if [ -n "$USER" ]; then
         TO="$USER@`hostname`"
      else
         TO="$LOGNAME@`hostname`"
      fi
   fi
   mail $TO <<EOF
   cat <<EOF

Your job has has returned with exit status: $EXIT

Command      : $0 $ARG_SAVE
Hostname     : `hostname`
Input dir    : $LOC
Menu file    : $MENU
Molecule file: $MOL
Output file  : $OUTPUT_FILE

EOF
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SET UP COMMAND TO RUN
#
#
setup_command()
{
   #
   # Execute Dirac "nicely"?
   #
   if [ -n "$NICE" ]; then
      if [ -x /usr/sbin/npri ]; then
         NICE_CMD="npri -h129"
      else
         NICE_CMD="nice -20"
      fi
   else
      NICE_CMD=
   fi
   #
   # Dirac executable
   #
   if [ -n "$ALT_DIRAC" ]; then
      DIRAC=${ALT_DIRAC##*/}
      BIN_DIR=${ALT_DIRAC%/*}
   else
      DIRAC=dirac.x
   fi
   #
   # MPI?
   #
   if [ -n "$PARCAL" ]; then
      DIRAC_CMD="mpirun -np $MPI_NPROC $DIRAC"
   else
      DIRAC_CMD="$DIRAC"
   fi
   #
   # Debug
   #
   if [ -n "$DEBUG" ]; then
      DIRAC_CMD="dbx -I $SRC_DIR/abacus -I $SRC_DIR/dirac -I $SRC_DIR/prp "
      DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/prp/rsp -I $SRC_DIR/dirac/open "
      DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/gp -I $SRC_DIR/pdpack "
      DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/moltra -I $SRC_DIR/relccsd "
      DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/eri -I $SRC_DIR/dirac/main "
      DIRAC_CMD="$DIRAC_CMD -I $SRC_DIR/include $DIRAC"
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# EXECUTE DIRAC
#
#
execute_dirac()
{
   echo "   Copying $BIN_DIR/$DIRAC to working directory : \c"
   if [ -x $BIN_DIR/$DIRAC ]; then
      cp $BIN_DIR/$DIRAC . || \
         ( \
            echo "   Error copying $BIN_DIR/$DIRAC" ; \
            EXIT=1 ;\
            exitfunc \
         )
      echo "ok"
   else
      echo "not found"
      EXIT=1
      exitfunc
   fi
   echo "   Executing: $NICE_CMD $DIRAC_CMD"
   if [ -n "$DEBUG"  ]; then
      $NICE_CMD $DIRAC_CMD
   else
      $NICE_CMD $DIRAC_CMD > $OUTPUT_FILE || \
         ( \
            echo "   $DIRAC returned non-zero exit code" ; \
            EXIT=1 ;
            export EXIT \
         )
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Print header
#
#
print_header()
{
   echo "   ****************************************"
   echo "   **** OUTPUT FROM DIRAC SHELL SCRIPT ****"
   echo "   ****************************************"
   echo
   echo '   $Revision$'
   echo "   Host        : `hostname`"
   echo "   Date        : `date`"
   echo "   PID         : $$"
   echo "   Input dir   : `pwd`"
   echo "   Work dir    : $WRK"
   echo
   echo
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Exit
#
#
exitfunc()
{
   if [ $EXIT -eq 0 ]; then
      echo
      echo "   Exit date: `date`"
      echo "   *** NORMAL EXIT"
   else
      echo
      echo "   Exit date: `date`"
      echo "   *** ABNORMAL EXIT"
   fi
   if [ -n "$NOTIFY" ]; then
      notify_user
   fi
   exit $EXIT
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# REMOVE WORK DIRECTORY
#
#
remove_work_dir()
{
   if [ -n "$RMWRK" ]; then
      cd ..
      rm -fr $WRK
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SET WORKING DIRECTORY
#
#
set_work_dir()
{
   if [ -n "$SCR_DIR" ]; then
      WRK=$SCR_DIR
   else
      WRK=$SCR/$MOL
   fi
   #
   # Make $WRK if non-existing
   # The -p switch makes all parent directories first
   #
   mkdir -p $WRK || echo "   MKDIR error\!"
   if [ ! -d $WRK ]; then
      echo "   Could not create work directory: $WRK"
      EXIT=1
      exitfunc
   fi
   #
   # Remove contents of $WRK if requested ( RMSCR )
   #
   if [ -n "$RMSCR" ]; then
      rm -f $WRK/* 2> /dev/null || echo "RM error\!"
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SAVE REQUESTED FILES
#
#
save_files()
{
   #
   # GET REQUESTED FILES FROM WORKING DIRECTORY
   #
   if [ -n "$GET_FILES" ]; then
      for file in $GET_FILES; do
         echo "   Saving $WRK/$file : \c"
         if [ -e $WRK/$file ]; then
            cp $WRK/$file $LOC || echo "not \c"
            echo "ok"
         else
            echo "not found"
         fi
      done
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# COPY FILES TO WORKING DIRECTORY
#
#
copy_files()
{
   #
   # COPY MOLECULE AND MENU FILE
   #
   cd $WRK
   echo "   Copying $LOC/$MOL.mol to working directory : \c"
   if [ -e $LOC/$MOL.mol ]; then
      cp $LOC/$MOL.mol MOLECULE.INP || \
         ( \
            echo "   Error copying $LOC/$MOL.mol" ; \
            EXIT=1 ; \
            exitfunc \
         )
      echo "ok"
   else
      echo "not found"
      EXIT=1
      exitfunc
   fi
   echo "   Copying $LOC/$MENU.inp to working directory : \c"
   if [ -e $LOC/$MENU.inp ]; then
      cp $LOC/$MENU.inp DIRAC.INP || \
         ( \
            echo "   Error copying $LOC/$MENU.inp" ; \
            EXIT=1 ; \
            exitfunc \
         )
      echo "ok"
   else
      echo "not found"
      EXIT=1
      exitfunc
   fi
   #
   # COPY REQUESTED FILES TO WORKING DIRECTORY
   #
   if [ -n "$COPY_FILES" ]; then
      for file in $COPY_FILES; do
         echo "   Copying $LOC/$file to working directory : \c"
         if [ -e $LOC/$file ]; then
            cp $LOC/$file . || \
               ( \
                  echo "   Error copying $LOC/$file" ; \
                  EXIT=1 ; \
                  exitfunc \
               )
            echo "ok"
         else
            echo "not found"
         fi
      done
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SAVE OLD OUTPUT FILE
#
#
save_old_output()
{
   if [ "$MOL" = "$MENU" ]; then
      OUTPUT_FILE=${LOC}/${MOL}.${RUN}
   else
      OUTPUT_FILE=${LOC}/${MENU}_${MOL}.${RUN}
   fi
   #
   # Save old output file
   #
   if [ -e $OUTPUT_FILE ]; then
      echo "   Existing file ${OUTPUT_FILE##*/} renamed to ${OUTPUT_FILE##*/}.bak : \c"
      mv $OUTPUT_FILE $OUTPUT_FILE.bak || \
         ( \
            echo "   Error renaming $OUTPUT_FILE" ; \
            EXIT=1 ;\
            exitfunc \
         )
      echo "ok"
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SET WORKING MEMORY FOR MASTER AND NODE
#
#
set_work_memory()
{
   if [ -n "$PARCAL" ]; then
      DIRPAR=1
      export DIRPAR
   fi
   if [ -n "$MEMORY" ]; then
      DIRWRK=$MEMORY
      export DIRWRK
   fi
   if [ -n "$NODE_MEMORY" ]; then
      DIRNOD=$NODE_MEMORY
      export DIRNOD
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Set default values
#
#
initialize()
{
   LOC=`pwd`

   EXIT=0

   RMWRK=
   RMSCR=

   COPY_FILES=

   DEBUG=

   GET_FILES=

   MEMORY=
   NODE_MEMORY=

   RUN='out'

   if [ "$LOGNAME" = "" ]; then
      SCR=$SCR_DEFAULT/$USER
   else
      SCR=$SCR_DEFAULT/$LOGNAME
   fi

   SCR_DIR=

   if [ ! -z "$MPI_NPROC" ]; then
      PARCAL=1
   else
      MPI_NPROC=
      PARCAL=
   fi

   NICE=1

   NOTIFY=
   NOTIFY_USER=

   ALT_DIRAC=
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Parse arguments
#
#
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
initialize
ARG_SAVE="$*"
if [ -z "$1" ]; then
   usage
   exitfunc
fi

while [ -n "$1" ]; do
   case $1 in
      -copy)
         shift
         COPY_FILES="$COPY_FILES $1"
         ;;
      -debug)
         DEBUG=1
         ;;
      -get)
         shift
         GET_FILES="$GET_FILES $1"
         ;;
      -infck)
         COPY_FILES="$COPY_FILES DFFCK2"
         ;;
      -utfck)
         GET_FILES="$GET_FILES DFFCK2"
         ;;
      -incmo)
         COPY_FILES="$COPY_FILES DFCOEF"
         ;;
      -utcmo)
         GET_FILES="$GET_FILES DFCOEF"
         ;;
      -mw|-memory)
         shift
         let MEMORY=$1*1000000
         ;;
      -nw|-nodememory)
         shift
         let NODE_MEMORY=$1*1000000
         ;;
      -rmscr)
         RMSCR=1
         ;;
      -rmwrk)
         RMWRK=1
         ;;
      -run)
         shift
         RUN=$1
         ;;
      -scr|-scratch)
         shift
         SCR_DIR=$1
         ;;
      -mpi)
         shift
         let MPI_NPROC=$1+1
         PARCAL=1
         ;;
      -nonice)
         NICE=
         ;;
      -notify)
         NOTIFY=1
         ;;
      -user)
         NOTIFY=1
         shift
         NOTIFY_USER=$1
         ;;
      -dirac)
         shift
         ALT_DIRAC=$1
         ;;
      -help)
         if [ -z "$PAGER" ]; then
            PAGER=more
         fi
         nroff -man $SRC_DIR/pam.1 | $PAGER
         EXIT=0
         exitfunc
         ;;
      -*)
         echo "$1 not recognized"
         usage
         EXIT=2
         exitfunc
         ;;
      *)
         MOL=${1%\.mol}
         shift 
         if [ -z "$1" ]; then
            echo "No menu file given"
            EXIT=1
            exitfunc
         fi
         MENU=${1%\.inp}
         ;;
   esac
   shift
done

#
#  Set working directory, set work memory, print header
#  copy files to working directory, save existing output file,
#  setup command to run, execute dirac, save files, and delete
#  working directory
#
EXIT=0
set_work_dir
set_work_memory
print_header
copy_files
save_old_output
setup_command
execute_dirac
save_files
remove_work_dir
#
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Exit 
#
#
exitfunc
