#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# Does 'echo' understand backslash commands
#
if [ "	" = "`echo '\t'`" ]; then
   echo="echo"
else
   echo="echo -e"
fi
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Function usage
#    - prints usage to stdout
#
#
shortusage ()
{
   echo
   echo 'Usage: '$0' [Flags] [ARCHIVE.tgz] mol[.mol] menu[.inp]'
   echo '   For information run pam -help'
}
usage ()
{
   echo 'Usage: '$0' [Flags] [ARCHIVE.tgz] mol[.mol] menu[.inp]'
   echo ' Run Dirac with the given molecule and input file. If a .tgz archive'
   echo ' is given the calculation can restart from the contents of this file.'
   echo '   Flags:'

 if [ "$DIRPAR" = "1" ]; then
   echo '     -mpi n                 : Run MPI with n nodes; default parallel with no of cpu='$MPI_NPROC
 else
   echo '     -mpi n                 : Run MPI with n nodes; default: sequential (ie -mpi flag not needed) '
 fi

   echo '     -mw n                  : Set memory (in megawords) for master; default: '$WRKMEM_DEFAULT
   echo '                              (and slave nodes if "-nw mem" not specified)'
   echo '     -nw n                  : Set memory (in megawords) for the slave nodes in parallel run; default: '$WRKMEM_DEFAULT

   let MEM_IN_MB_DEFAULT=$WRKMEM_DEFAULT*8

   echo '     -mem n                 : Set memory (in Mb) for master; default: '$MEM_IN_MB_DEFAULT' Mb'
   echo '                              (and slave nodes if "-mem" not specified)'
   echo '     -slavemem n            : Set memory (in Mb) for the slave nodes in parallel run; default: '$MEM_IN_MB_DEFAULT' Mb'

 if [ -n "$MACH_FILE" ]; then
   echo '     -machinefile filename  : Specify file with list of nodes to be used in MPI run; default: "'$MACH_FILE'" '
   else
   echo '     -machinefile filename  : Specify file with list of nodes to be used in MPI run; default - None '
 fi

   echo '     -wrkdir  directory     : Full directory path for work area; default "'$SCR/$MOL.'$$"'
   echo '     -wrkpath directory     : Directory path (without user login name) for work area; default "'$SCR'"'
   echo '     -put "file1 file2 .."  : Put specified files from job directory to work area'
   echo '     -copy                  : same function as -put'
   echo '     -copymaster "file1 .." : Put specified files from job directory to work area on the master node'
   echo '     -get "file1 file2 .."  : Get specified files to job directory from work area'
   echo '     -save                  : same function as -get'
   echo '     -noarch                : Do not create a .tgz archive of the calculation'
}
extrausage ()
{
   echo '     -mpiarg string         : Any other arguments to be passed on to MPI run'
   echo '     -notify                : Notify when finished to user starting job (requires mail sender working)'
   echo '     -user e-mail           : Notify when finished using specified e-mail address (requires mail sender working)'
   echo '     -basdir directory      : Prepend basis set directory to search list (may be repeated)'
   echo '     -dirac dirac_cmd       : Use dirac_cmd as executable instead of the default '
   echo "                              $BIN_DIR/dirac.x"
   echo '     -no-exe-copy           : Do not copy dirac.x to the working directory (default), run it in place.'
   echo '     -run name              : File suffix for output; default "'$RUN'"'
   echo '     -revision              : Append svn revision number to output file suffix'
   echo '     -nice                  : execute Dirac with nice/npri'
   echo '     -full-restart          : All files from ARCHIVE.tgz are unpacked, not just DFCOEF.'
   echo '                              This allows you to omit the molecule and input files.'
   echo '     -incmo                 : Copy DFCOEF from job directory to   work area (when restarting)'
   echo '     -outcmo                : Save DFCOEF to   job directory from work area (for restart)'
   echo '     -infck                 : Copy DFFCK2 from job directory to   work area'
   echo '     -outfck                : Save DFFCK2 to   job directory from work area'
   echo '     -clean                 : Clean work area before calculation'
   echo '     -keepwrk               : Keep work area after calculation (default: remove)'
   echo '     -aw n                  : Set maximum memory (in megawords) that can be allocated dynamically (per allocation)'
   echo '     -timeout|-to <TIME>    : Set time limit for dirac processes; kill them if time exceeded.'
   echo '     -debug                 : Run DIRAC in debugger:"'$DEBUGGER'"'
   echo '     -vg1 "valgrind_params" : Run DIRAC in valgrind (http://valgrind.org) with parameters of :"'$VALGRIND'"'
   echo '     -vg                    : Run DIRAC in valgrind (http://valgrind.org), no parameters'
   echo '     -vgfull                : Run DIRAC in valgrind (http://valgrind.org)'
   echo '                              with -v --error-limit=no --leak-check=full --track-origins=yes --show-reachable=yes'
   echo '     -prof                  : After finishing dirac executable perform profiling with:"'$PROFILER'"'
   echo '     -nobackup              : Do not backup output files, simply overwrite them'
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Notify user
#
#
notify_user()
{
   if [ -n "$NOTIFY_USER" ]; then
      TO=$NOTIFY_USER
   else
      if [ -n "$USER" ]; then
         TO="$USER@`hostname`"
      else
         TO="$LOGNAME@`hostname`"
      fi
   fi
   mail $TO <<EOF

Your job has has returned with exit status: $EXIT

Command      : $0 $ARG_SAVE
Hostname     : `hostname`
Input dir    : $LOC
Menu file    : $MENU
Molecule file: $MOL.$EXT
Output file  : $OUTPUT_FILE

EOF
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
# Define backup function /hjaaj
#
backup () {
  if [ "$1" = "-v" ]; then ekko=1; shift
     else ekko=0;
  fi
  for i in $* ; do
     if [ -f "${i}" ]; then
        for j in 6 5 4 3 2 1 0 ; do
           let jp=$j+1
           if [ -f "${i}.${j}" ]; then 
              [ $ekko -eq 1 ] && echo "Backup: renaming ${i}.${j} to ${i}.${jp}"
              mv -f "${i}.${j}" "${i}.${jp}"
           fi
        done
        if [ $ekko -eq 1 ]; then echo "Backup: renaming ${i} to ${i}.0"; fi
        mv -f "${i}" "${i}.0"
     fi
  done
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SET UP COMMAND TO RUN
#
#
setup_command()
{
   #
   # Execute Dirac "nicely"?
   #
   if [ -n "$NICE" ]; then
      if [ -x /usr/sbin/npri ]; then
         NICE_CMD="npri -h129"
      else
         NICE_CMD="nice -20"
      fi
   else
      NICE_CMD=
   fi
   #
   # Dirac executable
   #
   if [ -n "$ALT_DIRAC" ]; then
      DIRAC=${ALT_DIRAC##*/}
      BIN_DIR=${ALT_DIRAC%/*}
      if [ -z "$BIN_DIR" ]; then
         BIN_DIR=$LOC
      fi
   else
      DIRAC=dirac.x
   fi
   #
   # MPI?
   #
   if [ "$DIRPAR" = "1" ]; then
#  Parallel run ($MPIARG allows any MPI run argument):
      DIRAC_CMD="$MPIRUN $MPIARG"
#     Set number of processors:      
      if [ "${MPIRUN##*/*/}" = 'mpirun' ]; then
#        DIRAC_CMD="$DIRAC_CMD -np $MPI_NPROC"
#       Include machinefile - if nonempty string
        if [ "$MACH_FILE_MPIRUN" = "yes" ]; then
          # ... if a readable file exist, add it 
          if [ -r "$MACH_FILE" ]; then
            DIRAC_CMD="$DIRAC_CMD -machinefile $MACH_FILE"
          else
            echo "ERROR: Machinefile $MACH_FILE cannot be read"
            exit 1
          fi
        fi
#       ... handle number of processors AFTER taking in machinefile if demanded (MPICH2)...
#        ... together with working directory for master/slaves
        DIRAC_CMD="$DIRAC_CMD -np $MPI_NPROC -wd $WRK"

      # miro: what kind of parallel library is it ?
      elif [ "${MPIRUN##*/*/}" = 'openmpirun' ]; then
        DIRAC_CMD="$DIRAC_CMD -n $MPI_NPROC"
#       Include machinefile
        if [ "$MACH_FILE_MPIRUN" = "yes" ]; then
          if [ -r "$MACH_FILE" ]; then
            DIRAC_CMD="$DIRAC_CMD -machinefile $MACH_FILE"
          else
            echo "ERROR: Machinefile $MACH_FILE cannot be read"
            exit 1
          fi
        fi

      fi
   else
# --------------------
#   Sequential run:
# --------------------
      DIRAC_CMD=
   fi

   ############################################################
   #
   # Debug (will ignore any MPIRUN)
   #
   # TODO: Adapt debugging for the parallel run !
   #
   ############################################################
   if [ -n "$DEBUG" ]; then
      if [ -n "$DIRAC_CMD" ]; then
         echo "WARNING. DEBUG requested, thus these options ignored: $DIRAC_CMD"
      fi

      if [ -n "$DEBUGGER" ]; then
        DIRAC_CMD="$DEBUGGER"
      else
        echo "WARNING. DEBUG requested, but no debugger assigned ! Check your architecture/script."
      fi

   fi

   #
   # Valgrid check (will ignore any MPIRUN)
   #
   if [ -n "$VALGRIND_CHECK" ]; then

      #if [ -n "$DIRAC_CMD" ]; then
      #   echo "WARNING. VALGRID check requested, thus these options are ignored: $DIRAC_CMD"
     # fi

      if [ -n "$VALGRIND" ]; then
        # parallel 
        if [ -n "$MPIRUN" ]; then
          echo "   * VALGRID check in the parallel mode."
          DIRAC_CMD="$DIRAC_CMD $VALGRIND_TOOL --log-fd=1"
        # serial 
        else 
          echo "   * VALGRID check in the serial mode."
          DIRAC_CMD="$VALGRIND_TOOL --log-fd=1" # flush all Valgrind messages to stdout = DIRAC output file
        fi
      else
        echo 'VALGRIND check requested, but "valgrind" not assigned ! Check your architecture/script.Exit.'
        EXIT=1; exitfunc
      fi
   fi

   #
   # Finally append executable
   #
   if [[ -z "$NO_EXE_COPY" ]]; then
      DIRAC_CMD="$DIRAC_CMD ./$DIRAC"
   else
      DIRAC_CMD="$DIRAC_CMD $BIN_DIR/$DIRAC"
   fi

   #
   # Delete $WRK/$DIRAC if the executable is older than the
   # executable in $BIN_DIR. This is useful when you've compiled
   # a new executable, but didn't delete your scratch directory
   # in the previous calculation.
   #


   if [[ -z "$NO_EXE_COPY" ]]; then

   if [ -f $WRK/$DIRAC ]; then
      if [ $WRK/$DIRAC -ot $BIN_DIR/$DIRAC ]; then
         echo "Old $WRK/$DIRAC deleted because it is older than $BIN_DIR/$DIRAC"
         rm $WRK/$DIRAC
      fi
   fi

   $echo "   Copying $BIN_DIR/$DIRAC to working directory : \c"

   if [ ! -f $WRK/$DIRAC ]; then
      if [ -x $BIN_DIR/$DIRAC ]; then
         cp $BIN_DIR/$DIRAC . || \
            ( \
               echo "   Error copying $BIN_DIR/$DIRAC" ; \
               EXIT=1 ;\
               exitfunc \
            )
         echo "ok"
      else
         echo "not found"
         EXIT=1
         exitfunc
      fi
   else
      echo "was already there"
   fi

   fi

########################################################
### take care of timeout, TIMEOUT_LIMIT, TIMEOUT_CMD ###
########################################################
   TIMEOUT_EXEC=`which timeout 2>/dev/null` # check of timeout command exists
   if [ -n "$TIMEOUT_LIMIT" -a -n "$TIMEOUT_EXEC" ]; then
     TIMEOUT_CMD="$TIMEOUT_EXEC --signal=9 $TIMEOUT_LIMIT"
#    update dirac command if timeout is present
     DIRAC_CMD="$TIMEOUT_CMD $DIRAC_CMD"
   fi

}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# EXECUTE DIRAC
#
#
execute_dirac()
{
#  radovan: on IBM p575+ "njord" there is no short option to hostname
#  miro: the same on cygwin
  # master=`hostname -s`
   master=`hostname`
   if test -f dirac_machines; then
      unique_nodes=`grep -v -E "\<$master\>" dirac_machines | sed s/:.// | sort | uniq`
   else
      unique_nodes=""
   fi
   if [ "$DIRPAR" = "1" ]; then 
    if [ -n "$unique_nodes" ]; then
     $echo "   Executing $ILP_DATATYPE, parallel, $MPI_NPROC cores run, on $master and $unique_nodes in working directory, command:"
    else
     $echo "   Executing $ILP_DATATYPE, parallel, $MPI_NPROC cores run, only on $master in working directory, command:"
     if [ `uname` == 'Linux' ]; then
        ncores=`grep -ic ^processor /proc/cpuinfo`
        $echo "     fyi: number of all cores: " $ncores
     fi
    fi
    $echo "         \"$NICE_CMD $DIRAC_CMD\" with BASDIR(S) :"
   else
     $echo "   Executing $ILP_DATATYPE, serial run on $master in working directory, command:"
     $echo "         \"$NICE_CMD $DIRAC_CMD\" with BASDIR(S) :"
   fi

   BDIR=$BASDIR
   while [ -n "`echo $BDIR | grep ':'`" ]; do
      TDIR=`echo $BDIR | cut -d ":" -f 1`
      echo "      $TDIR"
      BDIR=`echo $BDIR | cut -d ":" -f 2-`
   done
      
      # attach useful info into output file
      $echo  "DIRAC launched (pam script) by `whoami`@`hostname` at `date`" > $OUTPUT_FILE
      $echo  "in : $OLDPWD"  >> $OUTPUT_FILE
      $echo  "==========================================================================================="  >> $OUTPUT_FILE
      $echo  "Size of all static allocations (pam script) : \c" >> $OUTPUT_FILE
      size $BIN_DIR/$DIRAC 2> /dev/null | grep $BIN_DIR/$DIRAC 2> /dev/null \
      | awk '{printf $3/(1024*1024)} ' 2> /dev/null >> $OUTPUT_FILE; echo ' MB' >> $OUTPUT_FILE \
      || echo 'can not be determined' >> $OUTPUT_FILE

   $echo "      $BDIR \n"

   if [ -n "$TIMEOUT_LIMIT" -a -n "$TIMEOUT_EXEC" ]; then
     $echo "   Killing of all processes ensured (timeout command) after $TIMEOUT_LIMIT\n"
   fi
   if [ -n "$TIMEOUT_LIMIT" -a -z "$TIMEOUT_EXEC" ]; then
     $echo "   No killing of all processes after $TIMEOUT_LIMIT, timeout command not present!\n"
   fi

   if [ -n "$DEBUG"  ]; then
      # ... dirac run in serial debugging mode - append to pam generated output
       $NICE_CMD $DIRAC_CMD | tee -a $OUTPUT_FILE
   else
      # ... standard serial run 
       $NICE_CMD $DIRAC_CMD >> $OUTPUT_FILE || \
         ( \
            $echo "\n   $DIRAC returned non-zero exit code" ; \
            $CLEANUP ; EXIT=1 ; export EXIT \
         )
   fi
}

##########################################################
###                                                    ###
###                                                    ###
###                 profile dirac                      ###
###                                                    ###
###                                                    ###
##########################################################
profile_dirac()
{

#default output after finishing DIRAC
GMON="gmon.out" 

if [ -n "$PROFILER" ]; then
#
 if [ -r "$GMON" ]; then
   $echo "\n Profiling the code, command:"
   $echo " \"$PROFILER $DIRAC $GMON >> $OUTPUT_FILE\"...\c"
   $PROFILER $DIRAC $GMON >> $OUTPUT_FILE || \
   ( $echo "Error in profiling !"; EXIT=1 ; exitfunc)
   $echo "OK.\n  Flat profile report added to the output file."
 else
  $echo "\nNo profiling, gmon.out not found."
 fi
else
 $echo "\nNo profiler assigned although the profiling wanted. Check your architecture and the script."
fi
}

#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Print header
#
#
print_header()
{
   echo "   ****************************************"
   echo "   **** OUTPUT FROM DIRAC SHELL SCRIPT ****"
   echo "   ****************************************"
   echo
   echo '   $Revision: 11650 $'
   echo "   User@Host   : `whoami`@`hostname`"
   echo "   Date        : `date`"
   echo "   Command     : $0 $ARG_SAVE "
   echo "   PID         : $$"
   echo "   Input dir   : $LOC"
   echo "   Work dir    : $WRK"
   echo
   echo
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Exit
#
#
exitfunc()
{
  # $echo "\nEXIT code="$EXIT

   if [ -r "$OUTPUT_FILE" ]; then
       grep WARNING $OUTPUT_FILE
  	if [ -n "`grep 'SEVERE ERROR' $OUTPUT_FILE`" ]; then
 	     EXIT=1	
	fi
   fi   
#  radovan: this is not always reliable
#  if [ $EXIT -eq 0 ]; then
#  instead check whether $OUTPUT_FILE contains "E N D   of   D I R A C  output"
   if [ `grep -l "E N D   of   D I R A C  output" $OUTPUT_FILE | cat` ]; then
      echo
      echo "   Exit date: `date`"
      echo "   *** NORMAL EXIT"
   else
      echo
      echo "   Exit date: `date`"
      echo "   *** ABNORMAL EXIT"
   fi
   if [ -n "$NOTIFY" ]; then
      notify_user
   fi
   exit $EXIT
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# REMOVE WORK DIRECTORY
#
#
remove_work_dir()
{
#
#  We alays delete the work directories on remote machines.
#  These directories are not suited for restart.
#
#  radovan: on IBM p575+ "njord" there is no short option to hostname
#  miro: the same on cygwin
   #master=`hostname -s`
   master=`hostname`

   if test -f $WRK/dirac_machines; then # check the presence of "dirac_machines" file
     unique_nodes=`grep -v -E "\<$master\>" dirac_machines | sed s/:.// | sort | uniq`
     if [  -n "$unique_nodes" ]; then
       for node in ` uniq $WRK/dirac_machines | sed s/:.//`; do
          if [ $node != $master ]; then
            $echo "\n  Contents of work directory $WRK on slave node $node:"
            $RSH $node "ls -l $WRK" 

            $echo "  Total size of the slave node $node work directory:\c"
            $RSH $node "du -h -s $WRK" || \
            ($echo "...could not be determined, du -h -s command not working...")

            $echo "  Info on the disk space usage on the slave node $node:"
            $RSH $node "df -h ." || \
            ($echo "...could not be determined, df command not working...")

            $RSH $node "rm -fr $WRK" || \
            ($echo "Error exit: work directory $WRK on slave node $node not deleted!"; \ 
             EXIT=1; exitfunc)
            
            $echo "Work directory $WRK on slave node $node deleted."
          fi
       done
     fi
   fi
#
#  Now delete work directory on primary machine if requested
#
   echo
   $echo "\n  Contents of work directory $WRK on main (master) node $master:"
   cd ..
   ls -l $WRK

   $echo "  Total size of the main (master) node $master work directory:\c"
   du -h -s $WRK || \
   ($echo "...could not be determined, du -h -s command not working.")

   $echo "  Info on the disk space usage on the master node $master (df -h .):"
   df -h . || \
   ($echo "...could not be determined, df command not working...")
   
   if [ " $RMWRK" -eq 1 ]; then
      if [ $EXIT -eq 0 ]; then
         rm -fr $WRK || \
         ($echo "Error exit: work directory $WRK on master node $master not deleted!"; \
           EXIT=1; exitfunc)
         echo "Work directory $WRK on main (master) node $master deleted."
      else
         echo '*** DIRAC terminated with an error exit code'
         echo "- THEREFORE (master) scratch work directory $WRK is not deleted as normal"
         echo "  so you may restart the calculation, or debug, if possible"
         echo "  ( $WRK may be deleted by your queueing system )"
         echo "- REMEMBER to delete $WRK yourself !!!"; echo
      fi
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SET WORKING DIRECTORY
#
#
set_work_dir()
{
   if [ -n "$SCR_DIR" ]; then
#   ... full path of work directory given by user
      WRK=$SCR_DIR
   else
      if [ -n "$SCR_PATH" ]; then
        # assign user provided path with user login name
        if [ "$LOGNAME" = "" ]; then
           SCR=$SCR_PATH/$USER
        else
           SCR=$SCR_PATH/$LOGNAME
        fi
      fi
      WRK=$SCR/$MOL.$$
   fi
   #
   # Make $WRK if non-existing
   # The -p switch makes all parent directories first
   #
   mkdir -p $WRK || $echo "\n   MKDIR error!"
   if [ ! -d $WRK ]; then
      $echo "            Error exit !                "
      $echo "   Could not create work directory: $WRK"
      $echo "   while beeing on host:\c";hostname
      $echo "   with disks (df -h):"; df -h 
      EXIT=1
      exitfunc
   fi
   #
   # Remove contents of $WRK if requested ( RMSCR )
   #
   if [ -n "$RMSCR" ]; then
      rm -f $WRK/* 2> /dev/null || \
      ( echo "rm $WRK error\!"; EXIT=1; exitfunc )
   fi
  
   # go the working directory - check if command is properly executed !
   this_node=`hostname`
   this_directory=`pwd`
   cd $WRK || \
      ( $echo "\nWhile beeing on the node $this_node in the current directory $this_directory :"
        $echo "I can not set to the work directory $WRK ! Error exir ! "; \
        EXIT=1 ;  exitfunc )

   this_directory=`pwd`
   if [ "$WRK" != "$this_directory" ]; then
     $echo "\n The pam flag given work directory is : $WRK "
     $echo " Its absolute path (pwd) is : $this_directory"
     WRK=$this_directory
     $echo "  Work directory provided with its full path, WRK=$WRK\n"
   fi

}
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# COPY CONTENTS OF WORKING DIRECTORY TO REMOTE NODES 
#
#
distribute_work_dir()
{
#  This routine is only called when local disks are selected
#  The list of machines available to dirac.x
#
   if [ -z "$MACH_FILE" ]; then
#     Serial run of parallel program
      echo `hostname` > dirac_machines 
   else
      cp $MACH_FILE dirac_machines
   fi
#
#  Initialize value of master (without domain name,
#  since on some installations it is absent in the machine list).
#
#  radovan: on IBM p575+ "njord" there is no short option to hostname
#  miro: the same on cygwin
   #master=`hostname -s` 
   master=`hostname` 
#
#  Loop over the remote machines and copy the contents of the work directory.
#
   if test -f dirac_machines; then

      unique_nodes=`grep -v -E "\<$master\>" dirac_machines | sed s/:.// | sort | uniq`
      echo "   Allocated nodes for parallel $MPI_NPROC cpu run (content of dirac_machines file):"
      cat dirac_machines
      if [ -n "$unique_nodes" ]; then
        $echo "  Distributing files onto local disks of nodes: "
      else
        # empty string $unique_nodes
        $echo "   All cpus are on one machine - $master - therefore no distributing files among other nodes."
      fi
      # if nonempty $unique_nodes, distribution/coying done
      for node in $unique_nodes; do
         echo "copying contents of master $master:$WRK to node $node:$WRK"
         $RSH $node "mkdir -p $WRK" 
         if [ -n "$RMSCR" ]; then
           $echo "first removing existing $node:$WRK"
           $RSH $node rm -f $WRK/* || \
           ($echo "Error exit: existing work directory $WRK on slave node $node not deleted!"; EXIT=1 ; exitfunc)
         fi
         for file in ` ls `; do
           $echo "copying $master:$file onto $node:$WRK/."
           $RCP $file $node:$WRK/$file || \
           ($echo "Error exit: $master:$file not copyied onto $node:$WRK/$file !";EXIT=1;exitfunc)
         done
      done
   fi
   #
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SAVE (GET) REQUESTED FILES
#
#
save_files()
{
   #
   # GET REQUESTED FILES FROM WORKING DIRECTORY
   #
   if [ -n "$GET_FILES" ]; then
      for file in $GET_FILES; do
         if [ -a $WRK/$file ]; then
            if [ $BACKUP_FILES -eq 1 ]; then
              backup -v $LOC/$file
            fi
            $echo "   Saving $WRK/$file : \c"
            cp $WRK/$file $LOC || $echo "not \c"
            echo "ok"
         else
            echo "   Saving $WRK/$file : not found"
         fi
      done
   fi
   if [ -n "$DO_ARCHIVE" ]; then
       FILES=
       for f in $ARCHIVE_FILES; do
         if [ -r "$f" ]; then
             FILES="$FILES $f"
         fi
       done
       if [[ -n "$MENU" && -n "$MOL" ]]; then
	   ARCHNAME=${MENU}_$MOL.tgz
       else
	   #This overwrites the old archive in case of a full restart without .mol/.inp
	   #We might consider a different ARCHNAME
	   ARCHNAME=$RESTART_ARCHIVE 
       fi
       echo "   Creating archive file $ARCHNAME"
       tar c $FILES | gzip > "$LOC/$ARCHNAME"
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# COPY FILES TO WORKING DIRECTORY
#
#
copy_files()
{
   # Have to extract the archive _before_ copying .inp/.mol,
   # since the archive also contains these files.
    if [[ -n "$RESTART_ARCHIVE" ]]; then
	echo "   Extracting files from $RESTART_ARCHIVE"
	# By default only restart from DFCOEF
	if [[ -n "$RESTART_ONLY" ]]; then
	    gzip -d < "$LOC/$RESTART_ARCHIVE" | tar xv $RESTART_ONLY
	else
	    gzip -d < "$LOC/$RESTART_ARCHIVE" | tar xv
	fi
    fi

# Check if we got .mol or .inp from the archive
   if [[ -r MOLECULE.MOL || -r MOLECULE.XYZ ]]; then
       HAS_MOL=yes
   else
       HAS_MOL=
   fi
   if [[ -r DIRAC.INP ]]; then
       HAS_INP=yes
   else
       HAS_MOL=
   fi

   #
   # COPY MOLECULE AND MENU FILE
   #
   if [[ -n $MOL ]]; then
       $echo "   Copying $LOC/$MOL.$EXT to working directory as MOLECULE.$EXTOUT : \c"
       if [ -f $LOC/$MOL.$EXT ]; then
	   cp $LOC/$MOL.$EXT MOLECULE.$EXTOUT || \
	       ( \
	       echo "   Error copying $LOC/$MOL.$EXT" ; \
	       EXIT=1 ; \
	       exitfunc \
	       )
	   echo "ok"
	   if [ "$EXTOUT" = .MOL ]; then
	       ln -s MOLECULE$EXTOUT MOLECULE.INP
	   fi
       else
	   echo "not found"
	   EXIT=1
	   exitfunc
       fi
   else
       if [[ -z $HAS_MOL ]]; then
	   echo
	   echo "ERROR: Molecule file not specified on command line."
	   shortusage
	   EXIT=1
	   exitfunc   
       else
	   echo "   No molecule file specified, using file from archive."
       fi
   fi

   if [[ -n "$MENU" ]]; then
       $echo "   Copying $LOC/$MENU.inp to working directory as DIRAC.INP : \c"
       if [ -f $LOC/$MENU.inp ]; then
	   cp $LOC/$MENU.inp DIRAC.INP || \
	       ( \
	       echo "   Error copying $LOC/$MENU.inp" ; \
	       EXIT=1 ; \
	       exitfunc \
	       )
	   echo "ok"
       else
	   echo "not found"
	   EXIT=1
	   exitfunc
       fi
   else
       if [[ -z $HAS_INP ]]; then
	   echo
	   echo "ERROR: Input file not specified on command line."
	   shortusage
	   EXIT=1
	   exitfunc   
       else
	   echo "   No input file specified, using file from archive."
       fi
   fi
   #
   # COPY REQUESTED FILES TO WORKING DIRECTORY
   #
   if [ -n "$PUT_FILES" ]; then
      for file in $PUT_FILES; do
         $echo "   Copying $LOC/$file to working directory : \c"
         if [ -a $LOC/$file ]; then
            cp $LOC/$file . || \
               ( \
                  echo "   Error copying $LOC/$file" ; \
                  EXIT=1 ; \
                  exitfunc \
               )
            echo "ok"
         else
            echo "not found"
         fi
      done
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# COPY FILES TO WORKING DIRECTORY ON MASTER NODE
#
#
copy_files_master()
{
   #
   # COPY REQUESTED FILES TO WORKING DIRECTORY
   #
   if [ -n "$PUT_FILES_MASTER" ]; then
      for file in $PUT_FILES_MASTER; do
         $echo "   Copying $LOC/$file to working directory on the master node: \c"
         if [ -a $LOC/$file ]; then
            cp $LOC/$file . || \
               ( \
                  echo "   Error copying $LOC/$file" ; \
                  EXIT=1 ; \
                  exitfunc \
               )
            echo "ok"
         else
            echo "not found"
         fi
      done
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# SAVE OLD OUTPUT FILE
#
#
save_old_output()
{
   if [ "$MOL" = "$MENU" ]; then
      OUTPUT_FILE=${LOC}/${MOL}.${RUN}${SUFFIX2}
   else
      OUTPUT_FILE=${LOC}/${MENU}_${MOL}.${RUN}${SUFFIX2}
   fi
   #
   # Save old output file
   #
   if [ -f $OUTPUT_FILE ]; then
     if [ $BACKUP_FILES -eq 1 ]; then
       echo "   Backing up old output files"
       backup $OUTPUT_FILE
       # backup -v $OUTPUT_FILE # for verbose output
     fi
   fi
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# EXPORT ENVIRONMENTAL VARIABLES TO CONTROL DIRAC (BOTH MASTER AND NODES)
#
#
set_dirac_environment()
{
   export DIRPAR # tell dirac.x if it is parallel run or not
   export BASDIR # tell dirac.x which directories to search for basis sets
   if [ -n "$MEMORY" ]; then
      DIRWRK=$MEMORY; export DIRWRK
      DIRNOD=$MEMORY; export DIRNOD
   fi
   if [ -n "$NODE_MEMORY" ]; then
      DIRNOD=$NODE_MEMORY; export DIRNOD
   fi
   if [ -n "$MAX_MEMORY" ]; then
      DIRMAX=$MAX_MEMORY; export DIRMAX
   fi
#  Next line is for IBM only but will not hurt other systems
   XLFRTEOPTS='namelist=old'; export XLFRTEOPTS

}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#  Set working directory, set work memory, print header
#  copy files to working directory, save existing output file,
#  setup command to run, execute dirac, save files, and delete
#  working directory
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Set default values
#
#
initialize()
{
   LOC=`pwd`

   EXIT=0

   RMWRK=1
   RMSCR=

   PUT_FILES=
   PUT_FILES_MASTER=

   DEBUG=
   PROFILE=
   VALGRIND_CHECK=

   BACKUP_FILES=1

   GET_FILES=

   MEMORY=
   NODE_MEMORY=
   MAX_MEMORY=

   RUN='out'
   SUFFIX2=''

# ... SCR_DEFAULT is set and copied into pam by configure
   if [ "$LOGNAME" = "" ]; then
      SCR=$SCR_DEFAULT/$USER
   else
      SCR=$SCR_DEFAULT/$LOGNAME
   fi

   SCR_DIR=
   SCR_PATH=

   MPI_NPROC=

# according to $MPIRUN decide whether this is serial or parallel run
   if [ -n "$MPIRUN" ]; then
     DIRPAR=1 # initialize to parallel
     MPI_NPROC=1
   else
     DIRPAR=0 # initialize to sequential
   fi

   MPIARG=

   NICE=

   NOTIFY=
   NOTIFY_USER=

   ALT_DIRAC=

#  set default search path for basis sets:
#  1) job directory
#  2) basis set directory in Dirac distribution

   BASDIR="$LOC/:$BASDIR"

# Files to include in the .tgz archive file.
   ARCHIVE_FILES="MOLECULE.MOL MOLECULE.XYZ DIRAC.INP DFCOEF *.cube AOPROPER AOMOMAT BSSMAT matexport.m DFCOEF.BEST"
   DO_ARCHIVE=yes

   RESTART_ARCHIVE=
   RESTART_ONLY=DFCOEF

# --- timeout limit
   TIMEOUT_LIMIT=''
   TIMEOUT_EXEC=''
   TIMEOUT_CMD=''
}
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Parse arguments
#
#
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
initialize
ARG_SAVE="$*"
if [ -z "$1" ]; then
   usage
   echo ' Run pam -help to list all options'
   exit 2
fi

while [ -n "$1" ]; do
   case $1 in
      -force-serial)
         MPIRUN=
         ;;
      -basdir)
         shift
         BASDIR="$1:${BASDIR}"
         ;;
      -putmaster|-copymaster)
         shift
         PUT_FILES_MASTER="$PUT_FILES_MASTER $1"
         ;;
      -put|-copy)
         shift
         PUT_FILES="$PUT_FILES $1"
         ;;
      -debug)
         DEBUG=1
         ;;
      -prof)
         PROFILE=1
         ;;
      -vg)
	 VALGRIND_CHECK=1
	 VALGRIND_TOOL="$VALGRIND"
         ;;
      -vg1)
         shift
	 VALGRIND_CHECK=1
	 VALGRIND_TOOL="$VALGRIND $1"
         ;;
      -vgfull)
	 VALGRIND_CHECK=1
	 VALGRIND_TOOL="$VALGRIND -v --error-limit=no --leak-check=full --track-origins=yes --show-reachable=yes"
         ;;
      -get|-save)
         shift
         GET_FILES="$GET_FILES $1"
         ;;
      -infck)
         PUT_FILES="$PUT_FILES DFFCK2"
         ;;
      -outfck|-utfck)
         GET_FILES="$GET_FILES DFFCK2"
         ;;
      -incmo)
         PUT_FILES="$PUT_FILES DFCOEF"
         ;;
      -outcmo|-utcmo)
         GET_FILES="$GET_FILES DFCOEF"
         ;;
      -nobackup)
         BACKUP_FILES=0
         ;;
      -noarch)
         DO_ARCHIVE=
         ;;
      -full-restart)
         # Unpack everything from a given archive file, not only DFCOEF
         RESTART_ONLY=   
         ;;
      -mem)
         shift
         let MEMORY=$1*128000
         ;;
      -slavemem)
         shift
         let NODE_MEMORY=$1*128000
         ;;
      -mw|-memory)
         shift
         let MEMORY=$1*1000000
         ;;
      -nw|-nodememory)
         shift
         let NODE_MEMORY=$1*1000000
         ;;
      -aw)
         shift
         let MAX_MEMORY=$1*1000000
         ;;
      -clean*|-rmscr)
         RMSCR=1
         ;;
      -keepwrk|-keepwork)
         RMWRK=0
         ;;
      -rmwrk)  # for backwards compatibility
         RMWRK=1
         ;;
      -revision)
         SUFFIX2=_`svn info $SRC_DIR | grep 'Revision' | awk '{ print $2 }'`
         ;;
      -run)
         shift
         RUN=$1
         ;;
      -wrkdir|-workdir|-scr|-scratch)
         shift
         SCR_DIR=$1 # set the full path by user
         ;;
      -wrkpath|-workpath)
         shift
         SCR_PATH=$1
         ;;
      -timeout|-to)
         shift
         TIMEOUT_LIMIT=$1
         ;;
      -machinefile|-mf)
         shift
         MACH_FILE=$1
         ;;
      -mpi)
         shift
         MPI_NPROC=$1
       # DIRPAR=1 # set to parallel run
         ;;
      -mpiarg)
         shift
         MPIARG=$1
         ;;
      -nice)
         NICE=1
         ;;
      -notify)
         NOTIFY=1
         ;;
      -user)
         NOTIFY=1
         shift
         NOTIFY_USER=$1
         ;;
      -dirac)
         shift
         ALT_DIRAC=$1
         ;;
      -no-exe-copy)
	 NO_EXE_COPY=1
         ;;
      -help|--help)
#Restore the code below when manpage is up to date.
#         if [ -z "$PAGER" ]; then
#            PAGER=more
#         fi
#         nroff -man $SRC_DIR/pam.1 | $PAGER
         usage
         extrausage
         echo ' For more information see http://dirac.chem.sdu.dk'
	 exit 0
         ;;
      -*)
         echo "ERROR: Flag $1 not recognized. For help run pam -help"
         EXIT=2
         exitfunc
         ;;
      *.tgz)
         RESTART_ARCHIVE="$1"
	 ;;
      *)
#        The last parameters should always be the input file(s)
#        Process the geometry file first, can be either a
#        MOLECULE file (extension .mol) or an xyz file (.xyz)
         MOL=`echo $1 | cut -d'.' -f1`
         EXT=`echo $1 | cut -s -d'.' -f2-`
#        We need to check for input files that have dots in the name
         n=1
         while [ -n "`echo $EXT | cut -s -d'.' -f2`" ]; do
               n=`expr $n + 1`
               MOL=`echo $1 | cut -d'.' -f1-$n`
               EXT=`echo $EXT | cut -s -d'.' -f2-`
         done
#        With no extension given we presume it is a .mol file
         if [ -z "$EXT" ]; then
           EXT='mol'
         fi
#        Capitalize the extension
         EXTOUT=`echo $EXT | tr a-z A-Z`
         shift 
         MENU=${1%\.inp}
         ;;
   esac
   shift
done

EXIT=0
set_work_dir  # set and go to work directory
set_dirac_environment
print_header
copy_files
save_old_output
setup_command
if [ "$DIRPAR" = "1" -a "$LOCALDISKS" = "yes" ]; then
  distribute_work_dir 
fi
copy_files_master
execute_dirac
if [ "$PROFILE" = "1" ]; then
  profile_dirac
fi

save_files
remove_work_dir
#
#
#
#&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#
#
# Exit 
#
#
exitfunc
