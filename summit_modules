#!/bin/bash

# bash script to set up environment on summit for compiling and running

#load required modules:
module load gcc/8.1.1
module load spectrum-mpi
module load essl
module load openblas/0.3.9-omp
module load cuda
module load git
module load cmake
module load python
module load netlib-lapack

#compiling: environment variables for compiling
export WRAP=NOWRAP
export TOOLKIT=GNU
export BUILD_TYPE=OPT
export MPILIB=OPENMPI
export BLASLIB=ESSL
export GPU_CUDA=CUDA
export GPU_SM_ARCH=70
export EXA_OS=LINUX
export WITH_CUTT=NO

#compiling: Paths - Keep up to date with current location!!!!!
export PATH_OPENMPI=/autofs/nccs-svm1_sw/summit/.swci/1-compute/opt/spack/20180914/linux-rhel7-ppc64le/gcc-8.1.1/spectrum-mpi-10.3.1.2-20200121-chae23sgwacfeot7vxkpfboz6wao2c33
export PATH_BLAS_ESSL=/sw/summit/essl/6.1.0-2/essl/6.1/lib64
export PATH_IBM_XL_CPP=/sw/summit/xl/16.1.1-5/xlC/16.1.1/lib
export PATH_IBM_XL_FOR=/sw/summit/xl/16.1.1-5/xlf/16.1.1/lib
export PATH_IBM_XL_SMP=/sw/summit/xl/16.1.1-5/xlsmp/5.1.1/lib
export PATH_CUDA=/sw/summit/cuda/10.1.243
export PATH_CUTT=/ccs/home/div/src/cutt

#running with pam: general environment variables
export PAMI_IBV_DEVICE_NAME="mlx5_0:1,mlx5_3:1"
export PAMI_IBV_DEVICE_NAME_1="mlx5_3:1,mlx5_0:1"
ulimit -s unlimited

#running with script
# ExaTENSOR environment
export QF_PROCS_PER_NODE=2        #number of MPI processes per node
export QF_CORES_PER_PROCESS=21    #number of physical CPU cores per MPI process (no less than 1)
export QF_MEM_PER_PROCESS=140000  #host RAM memory limit per MPI process in MB
export QF_NVMEM_PER_PROCESS=0     #non-volatile memory limit per MPI process in MB
export QF_HOST_BUFFER_SIZE=190000 #host buffer size per MPI process in MB (less than QF_MEM_PER_PROCESS!)
export QF_GPUS_PER_PROCESS=3      #number of discrete NVIDIA GPUs per MPI process (optional)
export QF_MICS_PER_PROCESS=0      #number of discrete Intel Xeon Phis per MPI process (optional)
export QF_AMDS_PER_PROCESS=0      #number of discrete AMD GPUs per MPI process (optional)
export QF_NUM_THREADS=21          #initial number of CPU threads per MPI process (irrelevant)

#running with script
# OpenMP environment
export OMP_NUM_THREADS=$QF_NUM_THREADS #initial number of OpenMP threads per MPI process (=QF_NUM_THREADS)
export OMP_DYNAMIC=false               #no OpenMP dynamic threading
export OMP_NESTED=true                 #OpenMP nested parallelism is mandatory
export OMP_MAX_ACTIVE_LEVELS=3         #max number of OpenMP nesting levels (at least 3)
export OMP_THREAD_LIMIT=256            #max total number of OpenMP threads per process
export OMP_WAIT_POLICY=PASSIVE         #idle thread behavior
export OMP_PROC_BIND="close,spread,spread" #nest1: Functional threads (DSVU)
                                           #nest2: TAVP-WRK: Dispatcher spawns coarse-grain Executors
                                           #nest3: TAVP-WRK: Executor spawns threads in CP-TAL kernels

#running with script
# MKL environment
#export MKL_NUM_THREADS=16              #keep consistent with chosen OMP_PLACES!
#export MKL_DYNAMIC=false

#running with script
# SUMMIT information
export PAMI_IBV_ADAPTER_AFFINITY=1
export PAMI_IBV_ENABLE_OOO_AR=1                   #adaptive routing is default
export PAMI_ENABLE_STRIPING=1                     #increases network bandwidth, also increases latency
export PAMI_IBV_DISABLE_ODP=0                     #ODP (requires CAPI for performance)
export PAMI_IBV_ENABLE_DCT=1                      #reduces MPI_Init() time at large scale
#unset PAMI_IBV_ENABLE_DCT
#export PAMI_IBV_ENABLE_TAG_MATCHING=1            #hardware tag matching
#export PAMI_IBV_QP_SERVICE_LEVEL=8
#export PAMI_PMIX_DATACACHE=1
#export PAMI_IBV_DEBUG_CQE=1                      #CQE error debugging
#export PAMI_IBV_DEBUG_QP_TIMEOUT=22
#export PAMI_IBV_DEBUG_RNR_RETRY=9
