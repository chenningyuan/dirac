####   depends on  ####
include ../../Makefile.config

default: secquant

F77_OBJS =

#  - must be proper order of modules - first independent, then dependent on previous modules
#F90_OBJS =  prnt_mod.o spinor_spec_mod.o indxquant_mod.o kron_delta.o  \

F90_OBJS =  prnt_mod.o indxquant_mod.o kron_delta.o  \
            sq_oper.o operstr_mod.o  eval_mod.o test.o  

#F90_MODS = indexed_quantities.mod spinorsspecification.mod kroneckerdelta.mod  secquantoperator.mod \

F90_MODS = indexed_quantities.mod kroneckerdelta.mod  secquantoperator.mod \
           operators_string.mod  control_print.mod  evaluate_strings.mod

C_OBJS   = 

F_CPPS = $(F77_OBJS:.o=.i)

pre:     $(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:  $(F90_MODS) $(F77_OBJS) $(F90_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod
	$(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

FLAGS=$(DEPEND_FLAGS) $(MODS) $(OPTFLAGS)

#### object files from DIRAC - general purpose routines ####
dirac_objs :=  ../../gp/qpack.o ../../gp/gptrygve.o  ../../gp/gphjj.o \
               ../../oof/string_mod.o ../../gp/tracing.o

## dummy entry to handle the "default:" in Makefile.config:
dirac.x dirmpi.x:

secquant:  $(F90_OBJS) $(F90_MODS)
	$(F77) $(LDFLAGS) -o SecQuant.x $(F90_OBJS) $(dirac_objs) $(LIB_LIST)

mod:       $(F90_MODS)

dirac.x:
	   cd .. ; $(MAKE) dirac.x

dirmpi.x:
	   cd .. ; $(MAKE) dirmpi.x

include ../../Makefile.depend

