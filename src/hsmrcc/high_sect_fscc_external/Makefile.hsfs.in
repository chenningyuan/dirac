#
#
#

# relative position of files
srcdir_hsfs=hsmrcc/high_sect_fscc_external

### compile main program as SUBROUTINE ###
#main_as_subr:
#	$(F90) -DFORTRAN_MAIN_AS_SUBROUTINE $(F90FLAGS) -c -o main/main.o  main/main.F90
	
# basic CCSD, (0,0) sector
hsfs_exec = $(srcdir_hsfs)/bin/hs_fscc.x
hsfs : $(hsfs_exec)

$(hsfs_exec) : $(OBJ)
	make main_as_subr
	$(F90) -DSTANDALONE_HSFS $(F90FLAGS) -c -o $(srcdir_hsfs)/hsfs_main.o  $(srcdir_hsfs)/hsfs_main.F90
	$(LD) $(LDFLAGS) -o $@ $(OBJ) $(LIBS)
	touch $(srcdir_hsfs)/hsfs_main.F90
	touch main/main.F90
	@echo -e "\n Independent executable "$(hsfs_exec)" is ready.\n"

############
# cleaning #
############
hsfs_clean :
	@rm -f $(srcdir_hsfs)/*.o 
	@rm -f $(srcdir_hsfs)/bin/*.x
	@echo "Cleaning of the " $(srcdir_hsfs) "  directory done"

