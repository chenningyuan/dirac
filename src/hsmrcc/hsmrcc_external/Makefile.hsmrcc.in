#
#
#   This file gets included from the main makefile, and
#  make has to be run from the top level directory.
#
#

##################################################################
#
#        Executable name with its relative position
#
# otherwise you would have to specify paths with $(INSTALL_DIR)
#
##################################################################
hscc_exec=hsmrcc/hsmrcc_external/hsmrcc.x

# ... directory with module source files 
moddir=hsmrcc/hsmrcc_external/modules
# ... directory with source files 
srcdir=hsmrcc/hsmrcc_external/source

#================================
### default : executable file ###
#================================
hs : $(hscc_exec)
	@echo -e "\nIndependent executable file "$(INSTALL_DIR)/$(hscc_exec)" is ready." 

##################
###  linking   ###
##################
$(hscc_exec) : $(OBJ)
	$(CC)  -DSTANDALONE_HSMRCC $(CFLAGS) -c -o $(srcdir)/hsmrmain.o  $(srcdir)/hsmrmain.c
	@echo -e "\nGoing to link Dirac-compiled objects (hsmrcc sources, modules): " 
	$(LD) -o $@ $(NO_FORTRAN_MAIN) $(OBJ) $(LIBS)
	touch $(srcdir)/hsmrmain.c


##################
###  cleaning  ###
##################
hs_clean :
	@echo -n "Cleaning up all object files in "$(moddir)" and "$(srcdir)" directories"
#	@rm -f $(srcdir)/*.o  $(moddir)/*.o
	make -C $(srcdir)/. clean 
	make -C $(moddir)/. clean
	@echo "...Done."
	@echo -n "Cleaning up the executable " $(INSTALL_DIR)/$(hscc_exec)
	@rm -f $(hscc_exec) 
	@echo "...Done."

