# VERSION : $Revision$
# DATE    : $Date$
# FILE    : Makefile.in
#

include ../Makefile.config

F77_OBJS =  krmcopt.o \
            krmcvec.o \
            krmcsav.o \
            krmcout.o \
            krmctra.o \
            krmcgosci.o \
            krmc_gradient.o \
            krmccan.o \
            krmcinp.o \
            krmcmlf.o \
            krmcluci.o \
            krmcgp.o

F90_OBJS =

F90_MODS =

C_OBJS = gendet.o

F77_CPPS = $(F77_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F77_OBJS) $(C_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i

mod: $(F90_MODS)

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90) $(C_OBJS:.o=.c)

f90dep: ;\
       ../utils/sfmakedepend.pl -I $(SOURCEDIR)/include -M $(SOURCEDIR)/modules $(F90_OBJS:.o=.F90) $(F90_OBJS:.o=.F) $(F77_OBJS:.o=.F)
 
# DO NOT DELETE THIS LINE -- make depend depends on it.
