include ../Makefile.config

OBJS =	krmcopt.o \
	krmcvec.o \
	krmcsav.o \
	krmcout.o \
	krmctra.o \
	krmcgosci.o \
	krmc_gradient.o \
	krmccan.o \
	krmcinp.o \
	krmcmlf.o \
	krmcluci.o \
	krmcgp.o

C_OBJS = gendet.o

all:	$(OBJS) $(C_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.lst *.i

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(OBJS:.o=.F) $(C_OBJS:.o=.c)
# DO NOT DELETE THIS LINE -- make depend depends on it.
