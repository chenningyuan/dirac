include ../Makefile.config

OBJS =	her1ave.o    her1car.o    her1drv.o    her1int.o\
her1odc.o    her1out.o    her1pro.o    her1sym.o\
her2ave.o    her2dir.o    her2drv.o    her2el1.o\
her2el2.o    her2fck.o    her2her.o    her2odc.o\
her2out.o    her2sup.o    her2sym.o    herbas.o\
herdirect.o  herdrv.o     hergam.o     hergeo.o\
hergp.o      herrdn.o     hersol.o\
hersym.o     hertst.o     her2gab.o    hermem.o\
abanuc.o     abatro.o     

all:	$(OBJS)

clean :	
	$(RM) -f *.o *~ *.f *.lst *.i

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

dirpvm.x:
	cd .. ; $(MAKE) dirpvm.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(OBJS:.o=.F)
# DO NOT DELETE THIS LINE -- make depend depends on it.

