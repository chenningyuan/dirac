include ../Makefile.config

F77_OBJS = her1ave.o    her1car.o    her1drv.o    her1int.o\
           her1odc.o    her1out.o    her1pro.o    her1sym.o     her1cat.o\
           her2ave.o    her2dir.o    her2drv.o    her2el1.o\
           her2el2.o    her2fck.o    her2her.o    her2odc.o\
           her2out.o    her2sym.o    her2gab.o\
           hergroup.o   herrdn_dirac.o herrdn_cap.o herbas.o \
           herdrv.o     hergam.o     hergeo.o     hergp.o \
           hersol.o     hersym.o     hertst.o \
           hermem.o     herdirect.o  herfckcon.o\
           abanuc.o     abatro.o     abaopt.o     abaortvec.o \
           abarint.o    abavrml.o    abawalk.o    abaop2.o

F90_OBJS = herrdn.o     hermodules.o

F90_MODS = conversion.mod \
           file.mod \
           readfile.mod

SLAVE_OBJS = herpar.o

F77_CPPS = $(F77_OBJS:.o=.i) $(SLAVE_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F77_OBJS) $(F90_OBJS)

slave: $(SLAVE_OBJS)

clean :	
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod  ;\
        $(foreach module_file, $(F90_MODS), $(RM) -f modules/$(module_file) ;)

mod:       $(F90_MODS)

dirac.x:
	   cd .. ; $(MAKE) dirac.x

dirmpi.x:
	   cd .. ; $(MAKE) dirmpi.x

include ../Makefile.depend

