#!/bin/bash

if [ "$1" = "" ]; then
    echo "usage: remove_copyright_tags /some/path"
    exit 1
fi

for file in `find $1 -name "*.f90"`; do
    grep -v copyright_start $file | grep -v copyright_end > deleteme
    mv -f deleteme $file
done

for file in `find $1 -name "*.F90"`; do
    grep -v copyright_start $file | grep -v copyright_end > deleteme
    mv -f deleteme $file
done

for file in `find $1 -name "*.F"`; do
    grep -v copyright_start $file | grep -v copyright_end > deleteme
    mv -f deleteme $file
done

for file in `find $1 -name "*.c"`; do
    grep -v copyright_start $file | grep -v copyright_end > deleteme
    mv -f deleteme $file
done

exit 0
