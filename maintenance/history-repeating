#!/bin/bash

# radovan: script to measure the timing of a test
#          while traversing the history

THIS_DIR=$PWD
BUILD_DIR=$THIS_DIR
TMP_DIR=$BUILD_DIR/delete_me
mkdir -p $TMP_DIR

cp -r Makefile.config utils pam runtest test basis* $TMP_DIR
ln -sf $BUILD_DIR/dirac.x $TMP_DIR/dirac.x

#               20 steps
for i in `seq 1 20`; do
    DATE=`git log | head -n 3 | grep Date`
#                     jump by 200 commits
    git checkout HEAD~200
    ./pamadm -a
    cp $TMP_DIR/Makefile.config $BUILD_DIR
    make
    TOTAL_TIME=`$TMP_DIR/runtest --tests=dft_benchmark | grep "total time"`
    echo $DATE $TOTAL_TIME >> $THIS_DIR/summary
done

rm -rf $TMP_DIR

exit 0
