##############################################################
#
#                 ***  gLite script  ***
#
##############################################################

##################
# assign your VO #
##################
#VirtualOrganisation="compchem";
VirtualOrganisation="voce";

Executable = "launch.py --vo=voce";
InputSandbox = {"launch_voce.py"};

##############################################
# stdout,stderr output & other working files
##############################################
StdOutput = "DIRAC_Grid_run_std.out";
StdError = "DIRAC_Grid_run_std.err";
OutputSandbox = {"DIRAC_Grid_run_std.out","DIRAC_Grid_run_std.err","DIRAC_Grid_package_out.tgz"};

#################
# Demands on CE #
#################
Requirements =
 other.GlueCEPolicyMaxWallClockTime > 1200;
