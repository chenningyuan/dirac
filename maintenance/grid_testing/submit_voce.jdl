##############################################################
#
#
#                 ***  gLite script  ***
#
#
##############################################################

#
# store onto vo=voce SE
# p=`pwd`;lcg-cr -v -d se.ui.savba.sk file://$p/dirac_test_suite.tgz  -l lfn://grid/voce/ilias/dirac_test_suite.tgz
# list: lcg-ls lfn://grid/voce/ilias
#
# delete: lcg-del -a lfn://grid/voce/ilias/dirac_test_suite.tgz
#
# Copy file from the current directory onto grid SE:
# lcg-cr -l lfn://grid/voce/ilias/dirac_current.tgz  --vo voce dirac_current.tgz
#

Executable = "launch_voce.sh";
# files with full paths
InputSandbox = {"launch_voce.sh"};
##############################################
# stdout,stderr output & other working files
##############################################
StdOutput = "DIRAC_tests_std.out";
StdError = "DIRAC_tests_std.err";
OutputSandbox = {"DIRAC_tests_std.out", "DIRAC_tests_std.err", "dirac_suite_back.tgz"};

##################
# assign your VO #
##################
#VirtualOrganisation="compchem";
VirtualOrganisation="voce";

#################
# Demands on CE #
#################
Requirements =
 other.GlueCEPolicyMaxWallClockTime > 1200;
#  &&
# RegExp("gridce.iihe.ac.be", other.GlueCEUniqueId) 
# other.GlueCEUniqueID == "ce4.ui.savba.sk:8443/cream-pbs-voce" ||
# other.GlueCEUniqueID == "ce3.ui.savba.sk:8443/cream-pbs-voce"
#;
#
