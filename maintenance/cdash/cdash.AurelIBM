#!/bin/bash

DIRAC=/gpfs/home/ilias/work/qch/software/dirac/trunk

export PATH=/usr/vacpp/bin:/opt/freeware/bin/:/gpfs/home/utils/cmake/bin:$PATH
echo $PATH

cd $DIRAC
pwd

/opt/freeware/bin/git --version
/opt/freeware/bin/git status
/opt/freeware/bin/git pull

ls -l /opt/freeware/bin/


/opt/freeware/bin/python -V
/opt/freeware/bin/python ./setup --help

which xlf90
which python
which gfortran
which git
git --version

export CTEST_PROJECT_NAME="DIRACext"
export DIRTIMEOUT="12m"

BUILD=build_xlf90_xlc_xlC_essl_dbg_nopcm_noxcfun
if [[ -d "$BUILD" ]]; then
  echo "deleting previous build directory $BUILD"
  /bin/rm -rf $BUILD
fi
python ./pamadm -a --builddir=$BUILD
python ./setup --type=debug --fc=xlf90 --cc=xlc --cxx=xlC --cmake-options="-D BUILDNAME='Aurel-IBM_XL_nopcm_nostiel' -D ENABLE_PCMSOLVER=OFF -D ENABLE_STIELTJES=OFF -D ENABLE_XCFUN=ON -D DART_TESTING_TIMEOUT=99999" $BUILD
cd $BUILD
ctest  -D ExperimentalConfigure
ctest -j4 -D ExperimentalBuild
ctest -D ExperimentalSubmit 

exit
