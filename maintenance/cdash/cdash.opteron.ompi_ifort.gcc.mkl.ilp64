#!/bin/bash

# for crontab&queue system you have to set up enviroment !
#export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

echo "Welcome to the DIRAC CDash buildup on opteron.tau.ac.il"

# the directory where your DIRAC sits
DIRAC=/home/miro/qch_software/optimized_codes/svn_dirac/ompi_intel_mkl_opt_ILP64_CDash/trunk

# go to the local DIRAC directory
cd $DIRAC

# radovan: bad idea, use svn co, not svn up
svn --force up

./pamadm -a 

/bin/rm -rf build

# configure step
./setup --fc=/usr/local/openmpi_ilp64/bin/mpif90  --cc=/usr/local/openmpi_ilp64/bin/mpicc --cpp=/usr/local/openmpi_ilp64/bin/mpiCC -D BUILDNAME="opteron_mpi_ifort_gcc.ilp64" --mpi --math="-L/opt/intel/mkl/10.0.3.020/lib/em64t -lmkl_lapack -lguide -lpthread -lmkl_intel_ilp64 -lmkl" --int64 -D RUNTEST_NR_PROC=2 -D RUNTEST_TIMEOUT="00:40:00" -D DART_TESTING_TIMEOUT=99999 --debug

cd $DIRAC/build

make Experimental
# radovan: use Nighly, not Experimental

exit 0
