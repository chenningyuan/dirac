#!/bin/bash

# cron prescription
#15 00 * * 1,2,3,4,5,6,7   . /etc/profile; . /etc/bashrc; . ~/.bashrc; timestamp1=`date +\%F_\%k-\%M-\%S`; timestamp=${timestamp1// /};  echo "running dirac CDash buildup at "$timestamp; DIRAC=/home/miro/qch_software/dirac_git/dirac-git-repo; $DIRAC/maintenance/cdash/cdash.opteron.ompi_ifort.gcc.mkl.ilp64  > $DIRAC/maintenance/CDash_buildup_log_$timestamp 2>&1 || {echo "cront initiated command failed at" $timestamp}


# for cron&queue system you have to set up enviroment !
# own python 2.7.1
export PATH=/home/miro/bin/python/Python-2.7.1:$PATH
# own cmake
export PATH=/usr/local/bin:$PATH
# ifort, ompi compilers
export PATH=/usr/local/openmpi_ilp64/bin/mpif90:/opt/intel/idbe/10.1.015/bin:/opt/intel/fce/10.1.015/bin:$PATH
export LD_LIBRARY_PATH=/usr/local/openmpi_ilp64/lib:/opt/intel/mkl/10.0.3.020/lib/em64t:/opt/intel/fce/10.1.015/lib:$LD_LIBRARY_PATH

echo "Welcome to the DIRAC CDash buildup on opteron.tau.ac.il"

# the directory where your DIRAC sits
DIRAC=/home/miro/qch_software/dirac_git/dirac-git-repo
BUILD=build_opteron_mpi_ifort_gcc_ilp64
# go to the local DIRAC directory
cd $DIRAC

#svn --force up
#svn up
git pull origin master

./pamadm -a --hsfsdyn --auto

/bin/rm -rf $BUILD

# configure step
./setup --fc=/usr/local/openmpi_ilp64/bin/mpif90  --cc=/usr/local/openmpi_ilp64/bin/mpicc --cpp=/usr/local/openmpi_ilp64/bin/mpiCC -D BUILDNAME="opteron_mpi_ifort_gcc.ilp64" --math="-L/opt/intel/mkl/10.0.3.020/lib/em64t -lmkl_lapack -lguide -lpthread -lmkl_intel_ilp64 -lmkl" --int64 -D RUNTEST_NR_PROC=2 -D RUNTEST_TIMEOUT="00:30:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON --build=$BUILD 

cd $DIRAC/$BUILD
make Experimental
make info_ext

exit 0
