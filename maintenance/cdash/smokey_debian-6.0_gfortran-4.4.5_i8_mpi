#!/bin/bash

export MATH_ROOT='/opt/intel/mkl'
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH':/opt/intel/mkl/lib/intel64'

export PATH=$PATH':/home/bast/openmpi/gfortran-i4/bin'
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH':/home/bast/openmpi/gfortran-i4/lib'

TMP_DIR=/scratch/scratch-nightly-compile
SCRATCH_DIR=/scratch/scratch-nightly-run
mkdir -p $TMP_DIR

git clone git@repo.ctcc.no:dirac.git $TMP_DIR

cd $TMP_DIR
./setup --fc=mpif90 --cc=mpicc --enable-i8 -D BUILDNAME="smokey_debian-6.0_gfortran-4.4.5_i8_mpi" -D RUNTEST_NR_PROC=2
cd build
make Nightly

rm -rf $TMP_DIR $SCRATCH_DIR

exit 0
