#!/bin/bash

## crontab prescription ##


# miro: modified to local update&build
source ~/.bashrc

export LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LIBRARY_PATH

# the directory where your DIRAC sits
DIRAC=/home/ilias/Work/qch/qch_software/dirac/dirac-git-repo
#BUILD=build_gfortran_gcc_ownlibs_ILP64_cdash
#BUILD=build_g95_gcc_ownlibs_ILP64_cdash
BUILD=build

# go to the local DIRAC directory
cd $DIRAC
/bin/rm -rf $BUILD
git pull 
#git pull origin master
#./pamadm -a --minus --openrsp
./pamadm -a 
# configure step
./setup  --fc=gfortran  -D BUILDNAME="linux.gfortran.gcc.usr64_libs.i32lp64" -D RUNTEST_TIMEOUT="00:18:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON --build=$BUILD
cd $DIRAC/$BUILD
cmake ..
make dirac.x
make info_ext
make Experimental

###
### now run the Nightly test suite
###
TMP_DIR=/var/tmp/dirac_build
mkdir -p $TMP_DIR
# clone from here
git clone git@repo.ctcc.no:dirac.git  $TMP_DIR
cd $TMP_DIR
#git checkout -b prepare-release-11 origin/prepare-release-11
./pamadm -a 
#./pamadm --release
# configure step
./setup  --fc=gfortran  -D BUILDNAME="linux.gfortran.gcc.usr64_libs.i32lp64" -D RUNTEST_TIMEOUT="00:18:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON
cd $TMP_DIR/build
cmake ..
#make dirac.x
make Nightly
#make info_ext
rm -rf $TMP_DIR

exit 0
