#!/bin/bash

# for crontab&queue system you have to set up enviroment !
export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

echo "Welcome to the DIRAC CDash buildup on miro.pd.uniza.sk."

# the directory where your DIRAC sits
DIRAC=/home/ilias/qch_work/qch_software/dirac/openmpi_gfortran_gcc_opt_atlas_dirlapack_ILP64/trunk

# go to the local DIRAC directory
cd $DIRAC
svn --force up
./pamadm -a 
/bin/rm -rf build
# configure step, without --debug; NOTE: CTest timeout must be higher than runtest's !
./setup --fc=/usr/local/bin/mpif90 --cc=/usr/local/bin/mpicc --cpp=/usr/local/bin/mpiCC -D BUILDNAME="miro_pd_uniza.linux.openmpi_gfortran_gcc_atlas_dirlapack.ilp64.opt" --mpi --math="-L/usr/local/atlas_ilp64/lib -llapack -lcblas -lf77blas -latlas" --int64 -D RUNTEST_NR_PROC=2 -D RUNTEST_TIMEOUT="00:40:00" -D FORCE_DIRAC_LAPACK=ON -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON
cd $DIRAC/build
#make dirac_interfaces
#make -j 2
make Experimental

###
### now run the Nightly test suite
###
TMP_DIR=/tmp/dirac_build
mkdir -p $TMP_DIR
svn co http://dirac.chem.sdu.dk/svnDirac/Dirac/trunk $TMP_DIR
cd $TMP_DIR
./pamadm -a

./setup --fc=/usr/local/bin/mpif90 --cc=/usr/local/bin/mpicc --cpp=/usr/local/bin/mpiCC -D BUILDNAME="miro_pd_uniza.linux.openmpi_gfortran_gcc_atlas_dirlapack.ilp64.opt" --mpi --math="-L/usr/local/atlas_ilp64/lib -llapack -lcblas -lf77blas -latlas" --int64 -D RUNTEST_NR_PROC=2 -D RUNTEST_TIMEOUT="00:40:00" -D FORCE_DIRAC_LAPACK=ON -D DART_TESTING_TIMEOUT=99999  -D VERBOSE_OUTPUT=ON

cd $TMP_DIR/build
make Nightly
rm -rf $TMP_DIR

exit 0
