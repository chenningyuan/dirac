#!/bin/bash

# for crontab&queue system you have to set up enviroment !
export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

echo "Welcome to the DIRAC CDash buildup on miro.pd.uniza.sk."

# the directory where your DIRAC sits
DIRAC=/home/ilias/qch_work/qch_software/dirac/openmpi_gfortran_gcc_opt_atlas_dirlapack_ILP64/trunk

# go to the local DIRAC directory
cd $DIRAC

# radovan: bad idea, use svn co, not svn up
svn up

./pamadm -a --xcfun 

# configure step, without --debug; NOTE: CTest timeout must be higher than runtest's !
./setup --fc=/usr/local/bin/mpif90 --cc=/usr/local/bin/mpicc --cpp=/usr/local/bin/mpiCC -D BUILDNAME="miro_pd_uniza.linux.openmpi_gfortran_gcc_atlas_dirlapack.ilp64.opt" --mpi --math="-L/usr/local/atlas_ilp64/lib -llapack -lcblas -lf77blas -latlas" --int64 -D RUNTEST_NR_PROC=2 -D DART_TESTING_TIMEOUT=1234 --scratch="/tmp" -D RUNTEST_TIMEOUT="00:40:00" -D FORCE_DIRAC_DLAPACK=1 -D FORCE_DIRAC_ZLAPACK=1 -D FORCE_DIRAC_DLAMCH=1 

#./setup --fc=/usr/local/bin/mpif90 --cc=/usr/local/bin/mpicc --cpp=/usr/local/bin/mpiCC -D BUILDNAME="miro_pd_uniza.linux.openmpi_gfortran_gcc_ownlibs.ilp64.opt" --mpi --nomath  --int64 -D RUNTEST_NR_PROC=2 -D DART_TESTING_TIMEOUT=1234 --scratch="/tmp" -D RUNTEST_TIMEOUT="00:40:00"

cd $DIRAC/build
make clean

make Experimental
#make -j 2
# radovan: use Nighly, not Experimental

exit 0
