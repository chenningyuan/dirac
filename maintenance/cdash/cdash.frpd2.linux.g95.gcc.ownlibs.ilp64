#!/bin/bash

## crontab prescription ##


# miro: modified to local update&build
source ~/.bashrc

# the directory where your DIRAC sits
DIRAC=/home/ilias/Work/qch/qch_software/dirac/dirac-git-repo
BUILD=build_g95_gcc_ownlibs_ILP64_cdash

# go to the local DIRAC directory
cd $DIRAC
/bin/rm -rf $BUILD
git pull origin master
./pamadm -a --minus --openrsp
# configure step
./setup  --fc=g95  --cc=gcc-4.2  --int64  --internal-math  -D BUILDNAME="linux.g95.gcc.ilp64.ownlibs" -D RUNTEST_TIMEOUT="00:18:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON --build=$BUILD
cd $DIRAC/$BUILD
make Experimental
make info_ext

###
### now run the Nightly test suite
###
TMP_DIR=/var/tmp/dirac_build
mkdir -p $TMP_DIR
git clone git@repo.ctcc.no:dirac.git  $TMP_DIR
cd $TMP_DIR
./pamadm -a --minus --openrsp
# configure step
./setup  --fc=g95  --cc=gcc-4.2  --int64  --internal-math  -D BUILDNAME="linux.g95.gcc.ilp64.ownlibs" -D RUNTEST_TIMEOUT="00:18:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON
cd $TMP_DIR/build
make Nightly
make info_ext
rm -rf $TMP_DIR

exit 0
