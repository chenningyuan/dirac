#!/bin/bash

TMP_DIR=/scratch/scratch-nightly-compile
SCRATCH_DIR=/scratch/scratch-nightly-run
mkdir -p $TMP_DIR

git clone git@repo.ctcc.no:dirac.git $TMP_DIR

cd $TMP_DIR

mkdir build
cd build
cmake ..
make release
tar xvzf DIRAC-11.0.2-Source.tar.gz
cd DIRAC-11.0.2-Source

./setup --fc=gfortran --cc=gcc --int64 -D BUILDNAME="smokey_debian-6.0_gfortran-4.4.5_i8"
cd build
make Nightly

rm -rf $TMP_DIR $SCRATCH_DIR

exit 0
