#!/bin/bash

TMP_DIR=/tmp/dirac
mkdir -p $TMP_DIR

svn co http://dirac.chem.sdu.dk/svnDirac/Dirac/trunk $TMP_DIR

cd $TMP_DIR
./pamadm -a --xcfun

source /opt/intel/bin/compilervars.sh ia32
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH':/opt/intel/mkl/lib/ia32'

./setup --fc=ifort --cc=icc --math="-L/opt/intel/mkl/lib/ia32 -lmkl_lapack95 -lmkl_intel -lmkl_intel_thread -lmkl_core -liomp5 -lpthread" --buildname="linux.intel12.mkl.debug" --debug

cd $TMP_DIR/cbuild
make Nightly

rm -rf $TMP_DIR

exit 0
