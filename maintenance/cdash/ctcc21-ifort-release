#!/bin/bash

source /opt/intel/bin/compilervars.sh ia32
export PATH=$PATH':/opt/intel/mkl'

TMP_DIR=/tmp/dirac
SCRATCH_DIR=/home/bast/trash/dirac_scratch
mkdir -p $TMP_DIR

svn co http://dirac.chem.sdu.dk/svnDirac/Dirac/trunk $TMP_DIR

cd $TMP_DIR
./pamadm -a
./setup --fc=ifort --cc=icc -D BUILDNAME="linux-ifort-debug"

cd $TMP_DIR/build
make Nightly

rm -rf $TMP_DIR $SCRATCH_DIR

exit 0
