#!/bin/bash

source ~/.bashrc

DIRAC=/home/chemia/ucitelia/milias/work/qch/software/dirac/ompi_ifort_gcc_mkl_ILP64/adm/trunk

cd  $DIRAC
svn up
./pamadm -a --xcfun

./setup --fc=mpif90 --cc=mpicc --cpp=mpiCC --mpi --math="-L/home/chemia/ucitelia/milias/bin/intel_stuff/intel/composerxe-2011.2.137/mkl/lib/intel64 -lmkl_intel_ilp64 -lmkl_sequential -lmkl_core" --buildname="linux.gbb4_UMB.ompi_ifort_gcc_mkl" --runtest_mpi=2 --debug

ln -sf $DIRAC/cbuild/dirac.x  $DIRAC/dirac.x

cd $DIRAC/cbuild
make clean
make -j 4
#make Nightly
#make Experimental

exit 0
