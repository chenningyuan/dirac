#!/bin/bash

# ------------------------ #
# enviroment variables ... #
# ------------------------ #
export PATH=/home/ilias/bin:/home/ilias/bin/openmpi_i32lp64_static/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LD_LIBRARY_PATH=/home/ilias/bin/openmpi_i32lp64_static/lib

# the directory where your DIRAC sits #
DIRAC=/home/ilias/Work/qch/qch_software/dirac/trunk

# go to the local DIRAC directory
cd $DIRAC

BUILD_GNU=build_ompi_gnu_ilp64_static
./pamadm -a --hsfsdyn --hscc --auto --builddir=$BUILD_GNU
# configure step
./setup --fc=mpif90  --cc=mpicc  --cxx=mpiCC  --int64  -D BUILDNAME="frpd2.ompi_gnu_ilp64_static" -D RUNTEST_NR_PROC=2  --mpi --static  -D RUNTEST_TIMEOUT="00:18:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON -D ENABLE_BOUNDS_CHECK=OFF --force $BUILD_GNU 
cd $BUILD_GNU
make clean
cmake ..
make ExperimentalUpdate
make ExperimentalConfigure
make ExperimentalBuild
make ExperimentalTest
make ExperimentalSubmit


####  server's Intel compilers  ####
if [[ -z $PROD_DIR ]]; then
  source /home/ilias/intel/bin/compilervars.sh intel64
  #source /opt/intel/bin/compilervars.sh intel64
  echo "Intel Fortran/C/C++ noncommercial compilers with MKL library activated."
  export MATH_ROOT=/home/ilias/intel/mkl; echo "Activated MATH_ROOT=$MATH_ROOT"
fi

cd $DIRAC
BUILD_INTEL=build_intel_mkl_ilp64_static_check
./pamadm -a --hsfsdyn --hscc --auto --builddir=$BUILD_INTEL
# configure step
./setup --fc=ifort  --cc=icc  --cxx=icpc  --int64  -D BUILDNAME="frpd2.intel_mkl_ilp64_static_CHECK" --static  -D RUNTEST_TIMEOUT="00:18:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON -D ENABLE_BOUNDS_CHECK=ON --force $BUILD_INTEL
cd $BUILD_INTEL
make clean
cmake ..
make ExperimentalUpdate
make ExperimentalConfigure
make ExperimentalBuild
make ExperimentalTest
make ExperimentalSubmit

exit 0
