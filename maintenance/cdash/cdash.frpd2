#!/bin/bash

# the directory where your DIRAC sits #
DIRAC=/home/ilias/Work/qch/qch_software/dirac/trunk

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

export DIRTIMEOUT="14m"

# go to the local DIRAC directory
cd $DIRAC

# clean dir
git clean -f -d -x

git submodule update --init --recursive
git submodule status


BUILD_GNU=build_gnu_i8
./pamadm -a --builddir=$BUILD_GNU
# configure step
./setup.py --run-unit-tests  --int64  -D BUILDNAME="frpd2.gnu_i8-check" -D DART_TESTING_TIMEOUT=99999 -D ENABLE_BOUNDS_CHECK=ON -D PYTHON_EXECUTABLE=/usr/bin/python $BUILD_GNU 
cd $BUILD_GNU
ctest  -D ExperimentalUpdate     --track BoundsCheck
ctest  -D ExperimentalConfigure  --track BoundsCheck
ctest -j3 -D ExperimentalBuild   --track BoundsCheck
ctest -j3 -D ExperimentalTest    --track BoundsCheck
ctest  -D ExperimentalSubmit     --track BoundsCheck

cd $DIRAC
BUILD_GNU1=build_gnu_i4
./pamadm -a --builddir=$BUILD_GNU1
# configure step
./setup.py --run-unit-tests -D BUILDNAME="frpd2.gnu_i4" -D DART_TESTING_TIMEOUT=99999 -D ENABLE_BOUNDS_CHECK=OFF -D PYTHON_EXECUTABLE=/usr/bin/python $BUILD_GNU1
cd $BUILD_GNU1
ctest  -D ExperimentalUpdate --track Miro
ctest -j3 -D Experimental -L short --track Miro


####  server's Intel compilers  ####
if [[ -z $PROD_DIR ]]; then
  source /home/ilias/intel/bin/compilervars.sh intel64
  echo "Intel Fortran/C/C++ noncommercial compilers with MKL library activated."
  export MATH_ROOT=/home/ilias/intel/mkl; echo "Activated MATH_ROOT=$MATH_ROOT"
fi

cd $DIRAC
#BUILD_INTEL=build_intelmkl_i8_nopcm
BUILD_INTEL=build_intelmkl_i8
./pamadm -a --builddir=$BUILD_INTEL
# configure step
#./setup.py --run-unit-tests --fc=ifort  --cc=icc  --cxx=g++  --int64  -D BUILDNAME="frpd2.intel_g++_mkl_i8_nopcm" -D DART_TESTING_TIMEOUT=99999 -D ENABLE_BOUNDS_CHECK=OFF -D ENABLE_PCMSOLVER=OFF -D PYTHON_EXECUTABLE=/usr/bin/python $BUILD_INTEL
./setup.py --run-unit-tests --fc=ifort  --cc=icc  --cxx=g++  --int64  -D BUILDNAME="frpd2.intel_g++_mkl_i8" -D DART_TESTING_TIMEOUT=99999 -D ENABLE_BOUNDS_CHECK=OFF -D ENABLE_PCMSOLVER=ON -D PYTHON_EXECUTABLE=/usr/bin/python $BUILD_INTEL
cd $BUILD_INTEL
export MKL_NUM_THREADS=3
export MKL_DYNAMIC="FALSE"
ctest  -D ExperimentalUpdate --track Miro
ctest -D Experimental --track Miro


############################################
### Now run Nightly buildup with cloning ###
############################################
TMP_DIR=/tmp/ilias/DIRAC_build
if [[ -d "$TMP_DIR" ]]; then
  /bin/rm -rf $TMP_DIR
  mkdir -p $TMP_DIR
else
  mkdir -p $TMP_DIR
fi
git clone --recursive git@repo.ctcc.no:dirac.git  $TMP_DIR
cd $TMP_DIR
git submodule update --init --recursive
BUILD_INTEL=build_ifort_icc_g++_mkl_i8
./pamadm -a --builddir=$BUILD_INTEL
# configure step
./setup.py --run-unit-tests --fc=ifort  --cc=icc  --cxx=g++  --int64  -D BUILDNAME="frpd2.ifort_icc_g++_mkl_i8" -D DART_TESTING_TIMEOUT=99999 -D ENABLE_BOUNDS_CHECK=OFF -D PYTHON_EXECUTABLE=/usr/bin/python $BUILD_INTEL
cd $BUILD_INTEL
export MKL_NUM_THREADS=3
export MKL_DYNAMIC="FALSE"
#python binary_info.py
ctest -D Nightly

exit 0
