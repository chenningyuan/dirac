#!/bin/bash

# cron prescription
#15 00 * * 1,2,3,4,5,6,7   . /etc/profile; . /etc/bashrc; . ~/.bashrc; timestamp1=`date +\%F_\%k-\%M-\%S`; timestamp=${timestamp1// /};  echo "running dirac CDash buildup at "$timestamp; DIRAC=/home/miro/qch_software/dirac_git/dirac-git-repo; $DIRAC/maintenance/cdash/cdash.opteron.ompi_ifort.gcc.mkl.ilp64  > $DIRAC/maintenance/CDash_buildup_log_$timestamp 2>&1 || {echo "cront initiated command failed at" $timestamp}

# for cron&queue system you have to set up enviroment !
# own python 2.7.1
export PATH=/home/miro/bin/python/Python-2.7.1:$PATH
# own cmake
export PATH=/usr/local/bin:$PATH
# ifort, ompi compilers
export PATH=/home/miro/bin/openmpi_ilp64/bin:/opt/intel/idbe/10.1.015/bin:/opt/intel/fce/10.1.015/bin:$PATH
export LD_LIBRARY_PATH=/home/miro/bin//openmpi_ilp64/lib:/opt/intel/mkl/10.0.3.020/lib/em64t:/opt/intel/fce/10.1.015/lib:$LD_LIBRARY_PATH

echo "Welcome to the DIRAC CDash buildup on opteron.tau.ac.il"

# the directory where your DIRAC sits
DIRAC=/home/miro/qch_software/dirac_git/dirac-git-repo
BUILD=build_ompi_ifort_ilp64
# go to the local DIRAC directory
cd $DIRAC

export DIRTIMEOUT="11m"

# configure step
export MATH_ROOT=/opt/intel/mkl/10.0.3.020
if [[ -d "$BUILD" ]]; then
  echo "deleting previous build directory $BUILD"
  /bin/rm -rf $BUILD
fi
#
./setup --fc=/home/miro/bin/openmpi_ilp64/bin/mpif90  --cc=/home/miro/bin/openmpi_ilp64/bin/mpicc --cxx=/home/miro/bin/openmpi_ilp64/bin/mpiCC --mpi -D BUILDNAME="opteron_mpi_ifort_gcc.ilp64" --int64 -D RUNTEST_NR_PROC=2 -D DART_TESTING_TIMEOUT=99999 $BUILD
#
cd $BUILD
make ExperimentalUpdate
make ExperimentalConfigure
make ExperimentalBuild
make ExperimentalTest
make ExperimentalSubmit

exit 0
