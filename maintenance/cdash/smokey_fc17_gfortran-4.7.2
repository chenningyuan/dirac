#!/bin/bash

export MATH_ROOT=/usr/lib64/atlas

TMP_DIR=/home/bast/trash/scratch-nightly-compile
SCRATCH_DIR=/home/bast/trash/scratch-nightly-run
mkdir -p $TMP_DIR

git clone git@repo.ctcc.no:dirac.git $TMP_DIR

cd $TMP_DIR

git checkout release-12
./pamadm --release

mkdir build
cd build
cmake ..
make release
tar xvzf DIRAC-12.0.0-Source.tar.gz
cd DIRAC-12.0.0-Source

./setup --fc=gfortran --cc=gcc -D BUILDNAME="smokey_fc17_gfortran-4.7.2"
cd build
make Nightly

rm -rf $TMP_DIR $SCRATCH_DIR

exit 0
