#!/bin/bash

## crontab prescription ##


# miro: modified to local update&build
source ~/.bashrc

export LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LIBRARY_PATH
export PATH=/home/ilias/bin/openmpi_i32lp64_static/bin:$PATH
export LD_LIBRARY_PATH=/home/ilias/bin/openmpi_i32lp64_static/lib:$LD_LIBRARY_PATH

# the directory where your DIRAC sits
DIRAC=/home/ilias/Work/qch/qch_software/dirac/dirac-git-repo
#BUILD=build_gfortran_gcc_ownlibs_ILP64_cdash
#BUILD=build_g95_gcc_ownlibs_ILP64_cdash
BUILD=build_ompi_static

# go to the local DIRAC directory
cd $DIRAC
/bin/rm -rf $BUILD
git pull 
./pamadm -a 
# setup...
./setup  --fc=/home/ilias/bin/openmpi_i32lp64_static/bin/mpif90 --cc=/home/ilias/bin/openmpi_i32lp64_static/bin/mpicc --cxx=/home/ilias/bin/openmpi_i32lp64_static/bin/mpiCC  -D BUILDNAME="linux.OpenMPI_gfortran.gcc.ownmath.ilp64__full_STATIC" -D RUNTEST_TIMEOUT="00:18:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON --build-dir=$BUILD --static --internal-math --int64 -D RUNTEST_NR_PROC=2  -D RUNTEST_BINARY=$DIRAC/$BUILD/dirac.x
cd $DIRAC/$BUILD
cmake ..
#make dirac.x
#make info_ext
make Experimental

###
### now run the Nightly test suite
###
TMP_DIR=/tmp/dirac_build
mkdir -p $TMP_DIR
# clone from here
git clone git@repo.ctcc.no:dirac.git  $TMP_DIR
cd $TMP_DIR
#git checkout -b prepare-release-11 origin/prepare-release-11
./pamadm -a 
#./pamadm --release
# configure step
./setup  --fc=gfortran  -D BUILDNAME="linux.gfortran.gcc.usr64_libs.i32lp64" -D RUNTEST_TIMEOUT="00:18:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON
cd $TMP_DIR/build
cmake ..
#make dirac.x
make Nightly
#make info_ext
rm -rf $TMP_DIR

exit 0
