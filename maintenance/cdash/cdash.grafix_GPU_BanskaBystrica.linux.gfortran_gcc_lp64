# you can either run this script interactively with "make Experimental" (to calibrate it)
# or execute it as a cron job with "make Nightly"
# make sure cmake is installed before you run it

#FYI: crontab line:
#05 11 * * 1,2,3,4,5,6,7 timestamp=`date +\%F_\%k-\%M-\%S`; DIRAC=/home/milias/work/qch/dirac_git/gfortran_gcc_lib64_i32lp64_cdash/maintenance/cdash;  $DIRAC/cdash.grafix_GPU_BanskaBystrica.linux.gfortran_gcc_lp64  >  $DIRAC/cdash_buildup_log_$timestamp

# the directory where your DIRAC sits
DIRAC=/home/milias/work/qch/dirac_git/gfortran_gcc_lib64_i32lp64_cdash


# go to the local DIRAC directory
cd $DIRAC

# git svn update, pamadm 
git svn rebase

./pamadm -a --xcfun 


# configure step
./setup  --fc=gfortran  --cc=gcc  --buildname="linux.GPU_grafix_Miro_BanskaBystrica.gfortran_gcc_lib64.i32lp64" --scratch="/tmp" --runtest_timeout_flag="00:18:00"

