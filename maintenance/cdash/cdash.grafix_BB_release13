#!/bin/bash

# enviroment variables ...
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/cuda/bin
export LD_LIBRARY_PATH=/usr/local/cuda/cudaprof/bin:/usr/local/cuda/lib64:/usr/local/lib

####  server's Intel compilers  ####
if [[ -z $PROD_DIR ]]; then
  #source /home/ilias/intel/bin/compilervars.sh intel64
  source /opt/intel/bin/compilervars.sh intel64
  echo "Intel Fortran/C/C++ noncommercial compilers with MKL library activated."
fi
alias mkl='export MATH_ROOT=/opt/intel/mkl; echo "Activated MATH_ROOT=$MATH_ROOT"'

# the directory where your DIRAC sits
DIRAC=/home/milias/work/qch/dirac_git/trunk

export DIRTIMEOUT="15m"

# go to the local DIRAC directory
cd $DIRAC
git checkout release-13
git status

unset BUILD_INTEL_CHECK
BUILD_INTEL_CHECK=build_intelmkl_i8_check
if [[ -d "$BUILD_INTEL_CHECK" ]]; then
   echo "Deleting previous build ddirectory $BUILD_INTEL_CHECK."
  /bin/rm -rf $BUILD_INTEL_CHECK
fi
./pamadm -a  --builddir=$BUILD_INTEL_CHECK
export MATH_ROOT=/opt/intel/mkl
unset DIRAC_NUM_MPI_PROCS
./setup --fc=ifort --cc=icc --cxx=icpc --int64  -D BUILDNAME="grafix.Intel_MKL_i8_release13-CHECK" -D DART_TESTING_TIMEOUT=99999 -D ENABLE_BOUNDS_CHECK=ON $BUILD_INTEL_CHECK
cd $BUILD_INTEL_CHECK
make ExperimentalUpdate
make Experimental

cd $DIRAC
unset BUILD_INTEL
BUILD_INTEL=build_intelmkl_i8
if [[ -d "$BUILD_INTEL" ]]; then
   echo "Deleting previous build directory $BUILD_INTEL."
  /bin/rm -rf $BUILD_INTEL
fi
./pamadm -a  --builddir=$BUILD_INTEL
export MATH_ROOT=/opt/intel/mkl
unset DIRAC_NUM_MPI_PROCS
./setup --fc=ifort --cc=icc --cxx=icpc --int64  -D BUILDNAME="grafix.Intel_MKL_i8_release13" -D DART_TESTING_TIMEOUT=99999 -D ENABLE_BOUNDS_CHECK=OFF $BUILD_INTEL
cd $BUILD_INTEL
make ExperimentalUpdate
make Experimental

# clean the working space ...
/bin/rm -rf /tmp/milias/*

exit 0
