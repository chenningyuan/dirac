#!/bin/bash

# example recipe to build and run tests for CDash
# you can either run this script interactively with "make Experimental" (to calibrate it)
# or execute it as a cron job with "make Nightly"
# make sure cmake is installed before you run it

# miro: modified to local update&build
source ~/.bashrc

# the directory where your DIRAC sits
DIRAC=/home/ilias/QCH_Work/qch_softs/dirac_space/svn_operated/openmpi_gfortran_gcc_atlas_ILP64_cdash/adm/trunk

# go to the local DIRAC directory
cd $DIRAC

# svn update, pamadm 
svn up 
./pamadm -a --xcfun


# configure step
./setup --fc=mpif90  --cc=mpicc --cpp=mpiCC --buildname="pd_uniza.linux.openmpi_gfortran_gcc_atlas.ilp64.opt"  --mpi  --math="-L/home/ilias/bin/atlas-lapack-ilp64/ATLAS/atlas_lapack_ILP64/lib -llapack -lcblas -lf77blas -latlas" --int64 --runtest_mpi=2 

cd $DIRAC/cbuild
make clean

# pam expects dirac.x to be in the same directory
# you cannot copy it because it does not exist yet
# make below will create it but same step launches pam (via runtest)
ln -sf $DIRAC/cbuild/dirac.x  $DIRAC/dirac.x

# build and run tests
# use either Experimental or Nightly
#  make -j 2
  make Experimental 
# make Nightly -j 3

exit 0
