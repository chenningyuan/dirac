#!/bin/bash

# example recipe to build and run tests for CDash
# you can either run this script interactively with "make Experimental" (to calibrate it)
# or execute it as a cron job with "make Nightly"
# make sure cmake is installed before you run it

# for crontab&queue system you have to set up enviroment !
export PATH=/home/ilias/bin/openmpi_gfor_gcc_ILP64/bin:$PATH
export LD_LIBRARY_PATH=/home/ilias/bin/openmpi_gfor_gcc_ILP64/lib:$LD_LIBRARY_PATH

echo "Welcome to the DIRAC CDash buildup."

# the directory where your DIRAC sits
DIRAC=/home/ilias/QCH_Work/qch_softs/dirac_space/svn_operated/openmpi_gfortran_gcc_atlas_ILP64_cdash/adm/trunk

# go to the local DIRAC directory
cd $DIRAC

# svn update, pamadm 
svn up 
./pamadm -a --xcfun

# configure step, without --debug; NOTE: CTest timeout must be higher than runtest's !
./setup --fc=mpif90  --cc=mpicc --cpp=mpiCC --buildname="pd_uniza.linux.openmpi_gfortran_gcc_atlas.ilp64.opt"  --mpi  --math="-L/home/ilias/bin/atlas-lapack-ilp64/ATLAS/atlas_lapack_ILP64/lib -llapack -lcblas -lf77blas -latlas" --int64 --runtest_mpi=2  --runtest_timeout=1600 --scratch="/tmp"

cd $DIRAC/cbuild
make clean

# build and run tests
# use either Experimental or Nightly
#  make -j 2

  make Experimental 

#make Nightly 

exit 0
