#!/bin/bash

CTEST_TEMP_DIR=/home/bast/tmp/scratch-nightly
mkdir -p $CTEST_TEMP_DIR

export DIRAC_TMPDIR=$CTEST_TEMP_DIR/run

git clone git@repo.ctcc.no:dirac.git $CTEST_TEMP_DIR/compile

cd $CTEST_TEMP_DIR/compile
./setup --fc=gfortran --cc=gcc --cxx=g++
cd build
make -j12
ctest -D Nightly -j12

rm -rf $CTEST_TEMP_DIR

exit 0
