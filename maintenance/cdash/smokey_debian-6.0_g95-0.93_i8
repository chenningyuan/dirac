#!/bin/bash

export PATH=$PATH':/opt/intel/mkl'

TMP_DIR=/scratch/scratch-nightly-compile
SCRATCH_DIR=/scratch/scratch-nightly-run
mkdir -p $TMP_DIR

git clone git@repo.ctcc.no:dirac.git $TMP_DIR

cd $TMP_DIR

# devel code
# ./pamadm -a

# release
  git checkout -b prepare-release-11 origin/prepare-release-11
  ./pamadm --release
  mkdir build
  cd build
  cmake ..
  make release
  tar xvzf DIRAC-11.0.0-Source.tar.gz
  cd DIRAC-11.0.0-Source

./setup --fc=g95 --cc=gcc --int64 -D BUILDNAME="smokey_debian-6.0_g95-0.93_i8"
cd build
make Nightly

rm -rf $TMP_DIR $SCRATCH_DIR

exit 0
