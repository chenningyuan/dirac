#!/bin/bash

export MKL_NUM_THREADS=N
export MKL_DYNAMIC=FALSE
export OMP_NUM_THREADS=1

export PATH=$PATH':/home/bast/openmpi/gfortran/bin'
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH':/home/bast/openmpi/gfortran/lib'

export MATH_ROOT=/usr/lib64/atlas

TMP_DIR=/home/bast/trash/scratch-nightly-compile
SCRATCH_DIR=/home/bast/trash/scratch-nightly-run
mkdir -p $TMP_DIR

git clone git@repo.ctcc.no:dirac.git $TMP_DIR

cd $TMP_DIR

# this is to test release
# git checkout release-12
# ./pamadm --release

# overkill: testing make release target
mkdir build
cd build
cmake ..
make release
tar xvzf DIRAC-*-Source.tar.gz
cd DIRAC-*-Source

./setup --fc=mpif90 --cc=mpicc -D BUILDNAME="smokey_fc18_gfortran-4.7.2_mpi" -D RUNTEST_NR_PROC=2
cd build
make Nightly

rm -rf $TMP_DIR $SCRATCH_DIR

exit 0
