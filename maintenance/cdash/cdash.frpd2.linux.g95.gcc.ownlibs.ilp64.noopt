#!/bin/bash

# miro: modified to local update&build
source ~/.bashrc

# the directory where your DIRAC sits
DIRAC=/home/ilias/Work/qch/qch_software/dirac/svn_dirac/g95_gcc_noopt_ownlibs_ILP64_cdash/adm/trunk

# go to the local DIRAC directory
cd $DIRAC

# radovan: bad idea, use svn co, not svn up
svn up

./pamadm -a --xcfun --minus --openrsp

# configure step
./setup  --fc=g95  --cc=gcc-4.2  --int64  --nomath  -D BUILDNAME="linux.g95.gcc.ilp64.ownlibs.noopt" --scratch="/var/tmp" -D RUNTEST_TIMEOUT="00:18:00"

cd $DIRAC/build

  make clean
  make Experimental
# radovan: use Nighly, not Experimental

exit 0
