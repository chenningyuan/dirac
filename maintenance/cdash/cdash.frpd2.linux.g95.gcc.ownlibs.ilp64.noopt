#!/bin/bash

# example recipe to build and run tests for CDash
# you can either run this script interactively with "make Experimental" (to calibrate it)
# or execute it as a cron job with "make Nightly"
# make sure cmake is installed before you run it

# miro: modified to local update&build
source ~/.bashrc

# the directory where your DIRAC sits
DIRAC=/home/ilias/Work/qch/qch_software/dirac/svn_dirac/g95_gcc_noopt_ownlibs_ILP64_cdash/adm/trunk

# go to the local DIRAC directory
cd $DIRAC

# svn update, pamadm 
svn up 
# ...
./pamadm -a --xcfun --minus --openrsp

cd $DIRAC/cbuild
make clean
cd $DIRAC

# configure step
./setup  --fc=g95  --cc=gcc-4.2  --int64  --nomath  --buildname="linux.g95.gcc.ilp64.ownlibs.noopt" 

cd $DIRAC/cbuild

# build and run tests
# use either Experimental or Nightly
  make Experimental 

exit 0
