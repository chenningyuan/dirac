#!/bin/bash

#PBS -S /bin/bash
#PBS -N release_cdash_buildup
#PBS -l nodes=2
#PBS -l walltime=6:00:00
#PBS -j oe
#PBS -q workq
##PBS -o release_buildup_log

# intel fortran/MKL stuff
export PATH=/people/disk2/magnus/intel/composerxe-2011.2.137/bin/intel64:$PATH
export PATH=/people/disk2/magnus/intel/composerxe-2011.2.137/mpirt/bin/intel64:$PATH

export LD_LIBRARY_PATH=/people/disk2/magnus/intel/composerxe-2011.2.137/compiler/lib/intel64:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/people/disk2/magnus/intel/composerxe-2011.2.137/mpirt/lib/intel64:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/people/disk2/magnus/intel/composerxe-2011.2.137/mkl/lib/intel64:$LD_LIBRARY_PATH

#licence
export INTEL_LICENSE_FILE=/people/disk2/magnus/intel/licenses:$INTEL_LICENSE_FILE

# OpenMPI stuff
export PATH=/people/disk2/ilias/bin/openmpi_ifort_icc_ilp64/bin:$PATH
export LD_LIBRARY_PATH=/people/disk2/ilias/bin/openmpi_ifort_icc_ilp64/lib:$LD_LIBRARY_PATH
# OpenMPI_valgrind stuff
export PATH=/people/disk2/ilias/bin/openmpi_ifort_icc_ilp64_valgrind/bin:$PATH
export LD_LIBRARY_PATH=/people/disk2/ilias/bin/openmpi_ifort_icc_ilp64_valgrind/lib:$LD_LIBRARY_PATH

# cmake stuff
export PATH=/people/disk2/ilias/bin/cmake_install/bin:$PATH
#  my most recent python 2.7.1 #
export PATH=/people/disk2/ilias/bin/python/Python-2.7.1:$PATH

#export MATH_ROOT=/opt/intel/mkl
export MATH_ROOT=/people/disk2/magnus/intel/mkl/

timestamp1=`date +\%F_\%k-\%M-\%S`; timestamp=${timestamp1// /};
echo "running dirac cdash buildup at "$timestamp

which ifort
which icc

DIRAC=/people/disk2/ilias/QCH_Work/qch_progs/tmp_dirac
BUILD=build

OMPI=/people/disk2/ilias/bin/openmpi_ifort_icc_ilp64/bin

# git clone git@repo.ctcc.no:dirac.git $DIRAC
cd $DIRAC
# git checkout -b prepare-release-11 origin/prepare-release-11
./pamadm --release
./setup --fc=$OMPI/mpif90 --cc=$OMPI/mpicc --cpp=$OMPI/mpiCC --mpi -D BUILDNAME="linux.fe6_Odense.ompi_ifort_icc_mkl_ilp64-RELEASE" -D RUNTEST_NR_PROC=8 --int64 -D RUNTEST_TIMEOUT="00:18:00" -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON --build=$BUILD
cd $DIRAC/$BUILD
#make dirac.x
#make info_ext
#make Experimental
make Nightly

# do not delete - it shall be done by crontab prescription
##/bin/rm -rf $DIRAC

exit 0
