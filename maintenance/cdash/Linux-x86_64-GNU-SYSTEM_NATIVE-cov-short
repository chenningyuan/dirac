#!/bin/bash

BRANCH='master'
PAMADM_FLAGS='--adm'
NUM_CORES=1

while getopts b:p:n: opt; do
  case $opt in
  b)
      BRANCH=$OPTARG
      ;;
  p)
      PAMADM_FLAGS=$OPTARG
      ;;
  n)
      NUM_CORES=$OPTARG
      ;;
  esac
done

shift $((OPTIND - 1))

BUILDNAME="$BRANCH-$(basename $0)"

CTEST_TEMP_DIR=/tmp/cdash-scratch
mkdir -p $CTEST_TEMP_DIR

export DIRAC_TMPDIR=$CTEST_TEMP_DIR/run

git clone git@repo.ctcc.no:dirac $CTEST_TEMP_DIR/compile

cd $CTEST_TEMP_DIR/compile
git checkout $BRANCH &> /dev/null
./pamadm $PAMADM_FLAGS
./setup --fc=gfortran --cc=gcc --cxx=g++ -D BUILDNAME=$BUILDNAME --type=debug --coverage
cd build
make -j$NUM_CORES
ctest -D Nightly -j$NUM_CORES -L short

rm -rf $CTEST_TEMP_DIR

exit 0
