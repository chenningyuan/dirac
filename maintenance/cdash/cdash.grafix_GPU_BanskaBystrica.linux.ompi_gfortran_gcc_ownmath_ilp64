#!/bin/bash

# FYI:  crontab inscription:
#30 00 * * 1,2,3,4,5,6,7 timestamp=`date +\%F_\%k-\%M-\%S`; DIRAC=/home/milias/work/qch/dirac_git/trunk; $DIRAC/maintenance/cdash/cdash.grafix_GPU_BanskaBystrica.linux.ompi_gfortran_gcc_ownmath_ilp64 > $DIRAC/maintenance/cdash_buildup_log_$timestamp


# enviroment variables ...
export PATH=/home/milias/bin/openmpi_ilp64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/cuda/bin
export LD_LIBRARY_PATH=/home/milias/bin/openmpi_ilp64/lib:/usr/local/cuda/cudaprof/bin:/usr/local/cuda/lib64:/usr/local/lib

# the directory where your DIRAC sits
DIRAC=/home/milias/work/qch/dirac_git/trunk
BUILD=build_ompi_gfortran_gcc_ownmath_ilp64
OMPI=/home/milias/bin/openmpi_ilp64/bin

# go to the local DIRAC directory
cd $DIRAC
/bin/rm -rf $BUILD
git pull origin master
./pamadm -a 
# configure step
./setup --mpi --fc=$OMPI/mpif90  --cc=$OMPI/mpicc  --cpp=$OMPI/mpiCC  --int64  --internal-math  -D BUILDNAME="grafix_GPU_BanskaBystrica.linux.ompi_gfortran_gcc_ownmath_ilp64" -D RUNTEST_NR_PROC=2   -D RUNTEST_TIMEOUT="00:18:00"   -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON --build=$BUILD 
cd $DIRAC/$BUILD
make Experimental
make info_ext

#
# now do the nightly build
#
TMP_DIR=/tmp/ilias/dirac_build
mkdir -p $TMP_DIR
git clone git@repo.ctcc.no:dirac.git  $TMP_DIR
cd $TMP_DIR
./pamadm -a 
./setup --mpi --fc=$OMPI/mpif90  --cc=$OMPI/mpicc  --cpp=$OMPI/mpiCC  --int64  --internal-math  -D BUILDNAME="grafix_GPU_BanskaBystrica.linux.ompi_gfortran_gcc_ownmath_ilp64" -D RUNTEST_NR_PROC=2   -D RUNTEST_TIMEOUT="00:18:00"   -D DART_TESTING_TIMEOUT=99999 -D VERBOSE_OUTPUT=ON 
cd $DIRAC/build
make Nightly
make info_ext
rm -rf $TMP_DIR

exit 0
