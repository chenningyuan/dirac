#export LD_LIBRARY_PATH=/usr/local/lib

# the directory where your DIRAC sits
DIRAC=/home/milias/work/qch/dirac_git/ompi_gfortran_gcc_ownlibs_ILP64


# go to the local DIRAC directory
cd $DIRAC

# svn update, pamadm 
