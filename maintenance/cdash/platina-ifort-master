#!/bin/bash

source /opt/intel/bin/compilervars.sh ia32
export PATH=$PATH':/opt/intel/mkl'

TMP_DIR=/tmp/dirac
SCRATCH_DIR=/home/bast/trash/dirac_scratch
mkdir -p $TMP_DIR

git clone git@repo.ctcc.no:dirac.git $TMP_DIR

cd $TMP_DIR
./pamadm -a
./setup --fc=ifort --cc=icc -D BUILDNAME="ubuntu10.04-i686-ifort12.0-int32-master"

cd $TMP_DIR/build
make Nightly

rm -rf $TMP_DIR $SCRATCH_DIR

exit 0
