#!/bin/bash

#PBS -S /bin/bash
#PBS -N DIRACbuild
### Declare myprogram non-rerunable
#PBS -r n
#PBS -l nodes=1:ppn=12
#PBS -l walltime=16:00:00
#PBS -l mem=8g
#PBS -j oe
#PBS -q batch

echo "Working host is: "; hostname -f

source $HOME/intel/bin/compilervars.sh intel64
echo "Intel Fortran/C/C++ noncommercial compilers with MKL library activated."

# My own OpenMPI Intel
#export PATH=/home/milias/bin/openmpi/bin:$PATH
#export LD_LIBRARY_PATH=/home/milias/bin/openmpi/lib:$LD_LIBRARY_PATH
export PATH=/home/milias/bin/openmpi_1.6.4_intel_i32lp64/bin:$PATH
export LD_LIBRARY_PATH=/home/milias/bin/openmpi_1.6.4_intel_i32lp64/lib:$LD_LIBRARY_PATH

# my cmake stuff
export PATH=/home/milias/bin/cmake/bin:$PATH
echo "My own CMake is in PATH."
# my most recent python 2.7.1 #
#export PATH=/people/disk2/ilias/bin/python/Python-2.7.1:$PATH

echo "My PATH=$PATH"
echo "Running on host `hostname`"
echo "Time is `date`"
echo "Directory is `pwd`"
echo "This jobs runs on the following processors:"
echo `cat $PBS_NODEFILE`
# Define number of processors
NPROCS_PBS=`wc -l < $PBS_NODEFILE`
NPROCS=`cat /proc/cpuinfo | grep processor | wc -l`
echo "This node has $NPROCS CPUs."
echo "PBS_SERVER=$PBS_SERVER"
echo "PBS_NODEFILE=$PBS_NODEFILE"
echo "PBS_O_QUEUE=$PBS_O_QUEUE"
echo "PBS_O_WORKDIR=$PBS_O_WORKDIR"

#NPROCS=4 # hard set number of procs for computations

timestamp1=`date +\%F_\%k-\%M-\%S`; timestamp=${timestamp1// /};
echo -e "\n\n Running DIRAC cdash buildups at "$timestamp ; echo -e "\n\n"

DIRAC=/home/milias/Work/qch/software/dirac/trunk
#

export MATH_ROOT=$HOME/intel/mkl; echo "Activated MATH_ROOT=$MATH_ROOT"

cd $DIRAC

export LC_ALL=C

#
#  serial DIRAC buildup, Intel MKL
#
BUILD_SERIAL=build_Intel_MKL_ILP64_serial
cd $DIRAC
echo -e "\n\n Running serial, dynamic DIRAC buildup in $BUILD_SERIAL"
#
export MKL_NUM_THREADS=${NPROCS_PBS}
export MKL_DYNAMIC="FALSE"
export OMP_NUM_THREADS=1
#
export DIRTIMEOUT="12m"
#
if [[ -d "$BUILD_SERIAL" ]]; then
  echo "deleting previous build directory $BUILD_SERIAL"
  /bin/rm -rf $BUILD_SERIAL
fi
./pamadm -a --builddir=$BUILD_SERIAL
./setup --int64 --fc=ifort --cc=icc --cxx=icpc -D BUILDNAME="grid_UMB_Intel_mkl_ilp64_serial"  -D DART_TESTING_TIMEOUT=99999 $BUILD_SERIAL
cd $BUILD_SERIAL
python binary_info.py
make Experimental 
#
#  serial,static DIRAC buildup
#
BUILD_SERIAL_STATIC=build_Intel_MKL_ILP64_serial_static
echo -e "\n\n Running serial, static DIRAC buildup in $BUILD_SERIAL_STATIC"
cd $DIRAC
if [[ -d "$BUILD_SERIAL_STATIC" ]]; then
  echo "deleting previous build directory $BUILD_SERIAL_STATIC"
  /bin/rm -rf $BUILD_SERIAL_STATIC
fi
./pamadm -a --builddir=$BUILD_SERIAL_STATIC
./setup --int64 --fc=ifort --cc=icc --cxx=icpc --static -D BUILDNAME="grid_UMB_Intel_mkl_ilp64_serial_static"  -D DART_TESTING_TIMEOUT=99999 $BUILD_SERIAL_STATIC
cd $BUILD_SERIAL_STATIC
python binary_info.py
make ExperimentalConfigure
sed -i "s/-lcilkrts//g" CMakeFiles/dirac.x.dir/link.txt
`cat CMakeFiles/dirac.x.dir/link.txt` 
make ExperimentalTest
make ExperimentalSubmit
 

BUILD=build_Intel_OpenMPI_MKL_ILP64
if [[ -d "$BUILD" ]]; then
  echo "deleting previous build directory $BUILD"
  /bin/rm -rf $BUILD
fi
echo -e "\n\n Running parallel, dynamic DIRAC buildup in $BUILD "
./pamadm -a --builddir=$BUILD
export DIRAC_NUM_MPI_TASKS=$NPROCS_PBS
export DIRTIMEOUT="00:12:00"
./setup --fc=mpif90 --cc=mpicc --cxx=mpiCC -D BUILDNAME="grid_UMB_ompi_Intel_mkl_ilp64" --int64 -D DART_TESTING_TIMEOUT=99999 $BUILD
cd $BUILD
python binary_info.py
make Experimental

#
# OpenMPI parallel, static
#
BUILD_STATIC=build_Intel_OpenMPI_MKL_ILP64_static
echo -e "\n\n Running OpenMPI parallel, static DIRAC buildup in $BUILD_STATIC"
unset MKL_NUM_THREADS
unset MKL_DYNAMIC
unset OMP_NUM_THREADS
cd $DIRAC
if [[ -d "$BUILD_STATIC" ]]; then
  echo "deleting previous build directory $BUILD_STATIC"
  /bin/rm -rf $BUILD_STATIC
fi
./pamadm -a --builddir=$BUILD_STATIC
./setup --int64 --fc=mpif90 --cc=mpicc --cxx=mpiCC --mpi --static -D BUILDNAME="grid_UMB_ompi_Intel_mkl_ilp64_static"  -D DART_TESTING_TIMEOUT=99999 $BUILD_STATIC
cd $BUILD_STATIC
python binary_info.py
make ExperimentalConfigure
sed -i "s/-lcilkrts//g" CMakeFiles/dirac.x.dir/link.txt
`cat CMakeFiles/dirac.x.dir/link.txt` 
make ExperimentalTest
make ExperimentalSubmit
 

timestamp1=`date +\%F_\%k-\%M-\%S`; timestamp=${timestamp1// /};
echo -e "\n\n All buildups finished at "$timestamp
exit 0
