#!/bin/bash

#PBS -S /bin/bash
#PBS -l nodes=1:ppn=8
#PBS -l walltime=04:00:00
#PBS -l pvmem=1900mb

module load mkl intel-compiler/11.1 openmpi/1.4 git cmake
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

TMP_DIR=/global/work/$USER/$PBS_JOBID
mkdir -p $TMP_DIR

cp -r /home/bast/dirac/svn-fetch/* $TMP_DIR

cd $TMP_DIR
./pamadm -a --xcfun

./setup --fc=mpif90 --cc=mpicc --mpi --math="-L/global/apps/intel/mkl/10.2.0.013/lib/em64t -lmkl_lapack -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -lguide -lpthread" --buildname="linux.intel11.1.mkl.mpi" --runtest_mpi=8 --runtest_timeout=1000

ln -s $TMP_DIR/build/dirac.x $TMP_DIR/dirac.x

cd $TMP_DIR/build

make Nightly

rm -rf $TMP_DIR

exit 0
