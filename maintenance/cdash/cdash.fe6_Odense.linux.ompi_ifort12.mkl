#!/bin/bash

timestamp1=`date +\%F_\%k-\%M-\%S`; timestamp=${timestamp1// /}
echo "running dirac cdash buildup at "$timestamp

#PBS -N cdash_buildup.$timestamp
#PBS -l nodes=1
#PBS -l walltime=6:00:00
#PBS -j oe

source ~/.bashrc

DIRAC=/people/disk2/ilias/QCH_Work/qch_progs/dirac/ompi_ifc_gcc_mkl_ILP64_cdash/adm/trunk

cd $DIRAC
svn up
./pamadm -a --xcfun

./setup --fc=mpif90 --cc=mpicc --cpp=mpiCC --mpi --math="-L/people/disk2/ilias/intel/mkl/lib/intel64 -lmkl_intel_ilp64 -lmkl_sequential -lmkl_core" --buildname="linux.fe6_Odense.ompi_ifort_gcc_mkl" --runtest_mpi=4 --int64 --debug

ln -sf $DIRAC/cbuild/dirac.x  $DIRAC/dirac.x

cd $DIRAC/cbuild
make clean

#make -j 4

#make Nightly

make Experimental

exit 0
