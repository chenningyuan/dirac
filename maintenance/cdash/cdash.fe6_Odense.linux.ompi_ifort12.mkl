#!/bin/bash

#PBS -S /bin/bash
#PBS -N cdash_buildup
#PBS -l nodes=2
#PBS -l walltime=6:00:00
#PBS -j oe
#PBS -q workq
##PBS -o cdash_buildup_log

# intel fortran/MKL stuff
export PATH=/people/disk2/ilias/intel/composerxe-2011.2.137/bin/intel64:$PATH
export PATH=/people/disk2/ilias/intel/composerxe-2011.2.137/mpirt/bin/intel64:$PATH
export LD_LIBRARY_PATH=/people/disk2/ilias/intel/composerxe-2011.2.137/compiler/lib/intel64:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/people/disk2/ilias/intel/composerxe-2011.2.137/mpirt/lib/intel64:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/people/disk2/ilias/intel/composerxe-2011.2.137/mkl/lib/intel64:$LD_LIBRARY_PATH

# own (old) gcc-trunk stuff
export PATH=/people/disk2/ilias/bin/gcc_bin_lib/bin:$PATH
export LD_LIBRARY_PATH=/people/disk2/ilias/bin/gcc_bin_lib/lib64:$LD_LIBRARY_PATH

# OpenMPI stuff
export PATH=/people/disk2/ilias/bin/openmpi_ifort_gcc_ilp64/bin:$PATH
export LD_LIBRARY_PATH=/people/disk2/ilias/bin/openmpi_ifort_gcc_ilp64/lib:$LD_LIBRARY_PATH

# cmake stuff
export PATH=/people/disk2/ilias/bin/cmake_install/bin:$PATH

# my own svn stuff
#export PATH=/people/disk2/ilias/bin/subversion/bin:$PATH
#export INCLUDE=/people/disk2/ilias/bin/subversion/bin:$INCLUDE
#export LD_LIBRARY_PATH=/people/disk2/ilias/bin/subversion/lib:$LD_LIBRARY_PATH

timestamp1=`date +\%F_\%k-\%M-\%S`; timestamp=${timestamp1// /};
echo "running dirac cdash buildup at "$timestamp

DIRAC=/people/disk2/ilias/QCH_Work/qch_progs/dirac/ompi_ifc_gcc_mkl_ILP64_cdash/adm/trunk
cd $DIRAC

#/people/disk2/ilias/bin/subversion/bin/svn up .

./pamadm -a --xcfun

cd $DIRAC/cbuild
make clean

cd $DIRAC

# setup, no --debug
#./setup --fc=mpif90 --cc=mpicc --cpp=mpiCC --mpi --math="-L/people/disk2/ilias/intel/mkl/lib/intel64 -lmkl_intel_ilp64 -lmkl_sequential -lmkl_core" --buildname="linux.fe6_Odense.ompi_ifort_gcc_mkl" --runtest_mpi=8 --int64 --runtest_timeout=1200
./setup --fc=mpif90 --cc=mpicc --cpp=mpiCC --mpi --math="-L/people/disk2/ilias/intel/mkl/lib/intel64 -lmkl_intel_ilp64 -lmkl_sequential -lmkl_core" --buildname="linux.fe6_Odense.ompi_ifort_gcc_mkl" --runtest_mpi=8 --int64 

ln -sf $DIRAC/cbuild/dirac.x  $DIRAC/dirac.x
cd $DIRAC/cbuild

make Experimental 

timestamp1=`date +\%F_\%k-\%M-\%S`; timestamp=${timestamp1// /};
echo "buildup finished at "$timestamp

exit 0
