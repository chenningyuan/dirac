export DIRAC_TMPDIR=/tmpdir/$USER/tmp_dirac

export TOOLKIT=INTEL
export BUILD_TYPE=OPT
export MPILIB=MPICH
export PATH_MPICH=${I_MPI_ROOT}
export PATH_MPICH_INC=${PATH_MPICH}/include64
export PATH_MPICH_LIB=${PATH_MPICH}/lib64
export PATH_MPICH_BIN=${PATH_MPICH}/bin64
export BLASLIB=MKL
export PATH_INTEL=${MKLROOT}
export PATH_BLAS_MKL=${PATH_INTEL}/lib/intel64
export PATH_BLAS_MKL_DEP=${PATH_INTEL}/lib/intel64_lin
export PATH_BLAS_MKL_INC=${PATH_INTEL}/include
