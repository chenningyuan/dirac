#start of .diracrc file
--summit
--noarch
--scratch=/gpfs/alpine/scratch/visscher/chm145
--env='DIRWRK=1424000000'
--env='DIRMAX=2048000000'
--env='DIRNOD=1424000000'
--env='DIRPAR=1'
--env='GLBSCR=1'
--env='BASDIR=/ccs/proj/chm145/basis_sets/basis:/ccs/proj/chm145/basis_sets/basis_dalton:/ccs/proj/chm145/basis_sets/basis_ecp'

#exatensor environment variables (for Summit)
--env='QF_PROCS_PER_NODE=2'             #number of MPI processes per node
--env='QF_CORES_PER_PROCESS=21'         #number of cores per MPI process
--env='QF_MEM_PER_PROCESS=180000'       #host memory limit per MPI process in MB
--env='QF_NVMEM_PER_PROCESS=0'          #non-volatile memory limit per MPI process in MB
--env='QF_HOST_BUFFER_SIZE=180000'      #non-volatile memory limit per MPI process in MB
--env='QF_NUM_THREADS=21'               #number of threads per MPI process (irrelevant, keep it 8)
--env='QF_GPUS_PER_PROCESS=3'           #number of discrete NVIDIA GPUs per MPI process (optional)

#OpenMP:
--env='OMP_NUM_THREADS=21'              #number of OMP threads
--env='OMP_DYNAMIC=false'               #no OpenMP dynamic threading
--env='OMP_NESTED=true'                 #OpenMP nested parallelism is mandatory
--env='OMP_MAX_ACTIVE_LEVELS=3'         #max number of OpenMP nesting levels (at least 3)
--env='OMP_THREAD_LIMIT=256'            #max total number of OpenMP threads per process
--env='OMP_WAIT_POLICY=PASSIVE'         #idle thread behavior

#OpenMP thread binding, OMP_PLACES is set with a special script:
--env='OMP_PROC_BIND=close,spread,spread'  #nest1: Functional threads (DSVU)
                                           #nest2: TAVP-WRK:Dispatcher spawns coarse-grain Executors
#MKL specific:
--env='MKL_NUM_THREADS=1'               #keep consistent with chosen OMP_PLACES!
--env='MKL_DYNAMIC=false'

#Summit specific:
--env='PAMI_IBV_ENABLE_OOO_AR=1'        #adaptive routing is default
--env='PAMI_IBV_DISABLE_ODP=0'          #ODP (requires CAPI for performance)
--env='PAMI_ENABLE_STRIPING=1'          #increases network bandwidth, also increases latency
--env='PAMI_IBV_ENABLE_DCT=1'           #reduces MPI_Init() time at large scale
 
# end of .diracrc file
