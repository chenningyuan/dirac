include ../Makefile.config

F77_OBJS =

F90_OBJS = tests.o mem_mod.o qmtx_mod.o

F90_MODS = qmatrixes.mod memmory.mod

F_CPPS = $(F77_OBJS:.o=.i)

pre:     $(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:  $(F90_MODS) $(F77_OBJS) $(F90_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod
	$(RM) -f ../modules/*.mod

mod : $(F90_MODS) ;\
ln -sf $(PWD)/*.mod ../modules/. 

memmory.mod: mem_mod.F90  ;\
$(F77) $(DEPEND_FLAGS) $(MODS) -c mem_mod.F90  ;\

qmatrixes.mod:  memmory.mod qmtx_mod.F90 ;\
$(F77) $(DEPEND_FLAGS) $(MODS) -c qmtx_mod.F90 ;\


dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90)

#embedding.o: emb_frozen_orbitals.o emb_settings.o
 
