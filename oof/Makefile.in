include ../Makefile.config

F77_OBJS =

F90_OBJS = tests.o routines.o

F_CPPS = $(F77_OBJS:.o=.i)

pre:	$(F77_CPPS)

ftnchek:pre
	ftnchek $(CHEKFLAGS) $(F77_CPPS) > ftnchek.out

all:	$(F77_OBJS) $(F90_OBJS)

clean : 
	$(RM) -f *.o *~ *.f *.f90 *.lst *.i *.mod
	$(RM) ../modules/*.mod

mod : ../modules/memmory.mod ../modules/memmory_handling.mod ../modules/qmatrixes.mod  ;\

../modules/memmory.mod: routines.F90 ;\
$(F77) $(DEPEND_FLAGS) $(MODS) -c routines.F90  ;\
mv memmory.mod ../modules/.

../modules/memmory_handling.mod: routines.F90 ;\
$(F77) $(DEPEND_FLAGS) $(MODS) -c routines.F90 ;\
mv memmory_handling.mod  ../modules/.

../modules/qmatrixes.mod: routines.F90 ;\
$(F77) $(DEPEND_FLAGS) $(MODS) -c routines.F90 ;\
mv qmatrixes.mod ../modules/.

dirac.x:
	cd .. ; $(MAKE) dirac.x

dirmpi.x:
	cd .. ; $(MAKE) dirmpi.x

depend:
	makedepend -- $(DEPEND_FLAGS) -- $(F77_OBJS:.o=.F) $(F90_OBJS:.o=.F90)

#embedding.o: emb_frozen_orbitals.o emb_settings.o
 
